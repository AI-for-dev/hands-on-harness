+
+test('frame: ball bounces off corner (both axes flip)', () => {
+  const state = createState(1);
+  const ctx = { fillRect: () => {}, arc: () => {}, fill: () => {}, beginPath: () => {}, fillText: () => {} };
+  const brick = state.bricks[0];
+
+  // Position ball at the top-left corner of the brick
+  // Brick is at (brick.x, brick.y)
+  // We want overlapL and overlapT to be equal and smallest.
+  // Let's set overlapL = 1 and overlapT = 1.
+  // overlapL = (x + r) - brick.x => x + 7 - brick.x = 1 => x = brick.x - 6
+  // overlapT = (y + r) - brick.y => y + 7 - brick.y = 1 => y = brick.y - 6
+  state.ball = {
+    x: brick.x - 6,
+    y: brick.y - 6,
+    r: BALL_R,
+    vx: 300,
+    vy: 300
+  };
+
+  frame(ctx, state);
+
+  assert.ok(state.ball.vx < 0, 'Should flip vx');
+  assert.ok(state.ball.vy < 0, 'Should flip vy');
+});
