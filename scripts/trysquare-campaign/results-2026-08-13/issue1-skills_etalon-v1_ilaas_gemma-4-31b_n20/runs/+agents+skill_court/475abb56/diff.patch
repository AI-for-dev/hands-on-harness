diff --git a/game/neon.js b/game/neon.js
index 6b4a133..a7cbd75 100644
--- a/game/neon.js
+++ b/game/neon.js
@@ -215,6 +215,9 @@ export function frame(ctx, state) {
   ctx.fillStyle = palette.background;
   ctx.fillRect(0, 0, WIDTH, HEIGHT);

+  let bouncedX = false;
+  let bouncedY = false;
+
   // Bricks: collision + bounce + score + drawing, all in one place.
   for (const brick of state.bricks) {
     if (!brick.alive) continue;
@@ -223,11 +226,33 @@ export function frame(ctx, state) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      // Bounce logic: find the face with the smallest penetration
+      const overlapL = (state.ball.x + state.ball.r) - brick.x;
+      const overlapR = (brick.x + brick.w) - (state.ball.x - state.ball.r);
+      const overlapT = (state.ball.y + state.ball.r) - brick.y;
+      const overlapB = (brick.y + brick.h) - (state.ball.y - state.ball.r);
+      const min = Math.min(overlapL, overlapR, overlapT, overlapB);
+
+      if (min === overlapL && !bouncedX && state.ball.vx > 0) {
+        state.ball.vx = -Math.abs(state.ball.vx);
+        state.ball.x = brick.x - state.ball.r;
+        bouncedX = true;
+      } else if (min === overlapR && !bouncedX && state.ball.vx < 0) {
+        state.ball.vx = Math.abs(state.ball.vx);
+        state.ball.x = brick.x + brick.w + state.ball.r;
+        bouncedX = true;
+      }
+
+      if (min === overlapT && !bouncedY && state.ball.vy > 0) {
+        state.ball.vy = -Math.abs(state.ball.vy);
+        state.ball.y = brick.y - state.ball.r;
+        bouncedY = true;
+      } else if (min === overlapB && !bouncedY && state.ball.vy < 0) {
+        state.ball.vy = Math.abs(state.ball.vy);
+        state.ball.y = brick.y + brick.h + state.ball.r;
+        bouncedY = true;
+      }
     }

     ctx.fillStyle = brickColor(brick.row);
