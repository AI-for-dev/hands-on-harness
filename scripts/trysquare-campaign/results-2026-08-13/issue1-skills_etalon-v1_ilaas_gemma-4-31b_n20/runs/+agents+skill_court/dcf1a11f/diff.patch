+// ... previous tests ...
+
+test('step: ball bounces off brick', () => {
+  const state = createState(1);
+  // Position the ball so it's already colliding with a brick's top face
+  // Brick 0 is at BRICK_TOP = 48, BRICK_H = 20.
+  // Ball at y=48 - 7 + 1 = 42. Bottom edge is at 49.
+  state.ball = { x: 100, y: 42, r: 7, vx: 0, vy: 200 }; 
+  state.bricks = makeBricks(1);
+  
+  step(state, 0);
+  
+  assert.ok(state.ball.vy < 0, 'ball should bounce up after hitting brick');
+});
+
+test('step: brick bounce is not sticky', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 42, r: 7, vx: 0, vy: 200 };
+  state.bricks = makeBricks(1);
+
+  // First hit: flip vy
+  step(state, 0);
+  assert.equal(state.ball.vy, -200);
+
+  // Second hit (still at the same position): should NOT flip back
+  step(state, 0);
+  assert.equal(state.ball.vy, -200, 'ball should not flip back when still overlapping');
+});
+
+test('step: no double inversion at brick seams', () => {
+  const state = createState(1);
+  const offsetX = (WIDTH - (BRICK_COLS * (BRICK_W + BRICK_GAP) - BRICK_GAP)) / 2;
+  // Ball centered on the gap between brick 0 and brick 1
+  state.ball = { x: offsetX + 76, y: 42, r: 7, vx: 0, vy: 200 };
+  state.bricks = makeBricks(1);
+
+  step(state, 0);
+
+  // Should have flipped once (to -200) and stayed there, 
+  // even though it overlapped two bricks.
+  assert.equal(state.ball.vy, -200, 'ball should only flip once per step');
+});
