@@ -158,9 +158,36 @@ export function saveBest(storage, score) {
 
 // --- Physics (movement + wall/paddle bounces) ------------------------------
 
+// Handles collisions between the ball and the brick grid.
+// Flips velocity based on the face hit and updates score/combo.
+function handleBrickCollisions(state) {
+  const { ball } = state;
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+
+    if (collides(ball, brick)) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+
+      const overlapX = Math.min(ball.x + ball.r - brick.x, brick.x + brick.w - (ball.x - ball.r));
+      const overlapY = Math.min(ball.y + ball.r - brick.y, brick.y + brick.h - (ball.y - ball.r));
+
+      if (overlapX < overlapY) {
+        const vxBefore = ball.vx;
+        ball.vx = -ball.vx;
+        ball.x = vxBefore > 0 ? brick.x - ball.r : brick.x + brick.w + ball.r;
+      } else {
+        const vyBefore = ball.vy;
+        ball.vy = -ball.vy;
+        ball.y = vyBefore > 0 ? brick.y - ball.r : brick.y + brick.h + ball.r;
+      }
+    }
+  }
+}
+
 // Advances the ball by a time step `dt` (in seconds) and handles bounces off
