+test('frame: double inversion (seam)', () => {
+  const state = createState(1);
+  const bricks = state.bricks;
+  // Find two adjacent bricks
+  const brick1 = bricks[0];
+  const brick2 = bricks[1]; // adjacent horizontally
+  
+  // Position ball so it overlaps both bricks
+  // brick1.x + brick1.w = brick2.x (approximately, given the gap)
+  // The gap is BRICK_GAP. 
+  // brick1: x=offsetX, w=BRICK_W
+  // brick2: x=offsetX + BRICK_W + BRICK_GAP, w=BRICK_W
+  state.ball = { 
+    x: brick1.x + brick1.w + (BRICK_GAP / 2), 
+    y: brick1.y + brick1.h / 2, 
+    r: 7, 
+    vx: 100, 
+    vy: 0 
+  };
+  
+  const dummyCtx = {
+    fillStyle: '',
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    font: '',
+    fillText: () => {},
+  };
+
+  frame(dummyCtx, state);
+  
+  // It should have hit both bricks (since they are both alive and it overlaps both)
+  // vx should have been flipped twice, which means it's still positive.
+  // But it SHOULD have been flipped only once (or handled so it bounces).
+  assert.ok(state.ball.vx < 0, 'ball should bounce back after hitting the seam of two bricks');
+});
+
 function belowField() {
