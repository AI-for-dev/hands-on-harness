+test('brick collision: ball bounces off the top of a brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  // Ball is moving DOWN, hits the top of the brick
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y - 8, r: 7, vx: 0, vy: 100 };
+
+  // We simulate a few steps. We expect the ball to bounce UP.
+  // Note: brick collision is currently in frame(), so step() won't trigger it.
+  // This test is EXPECTED to fail until the logic is moved to step().
+  for(let i=0; i<10; i++) step(state, 1/60);
+
+  assert.ok(state.ball.vy < 0, 'ball should bounce UP after hitting the top of a brick');
+  assert.ok(!brick.alive, 'brick should be destroyed');
+});
+
+test('brick collision: ball bounces off the left side of a brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  // Ball is moving RIGHT, starts just before the brick
+  state.ball = { x: brick.x - 8, y: brick.y + brick.h / 2, r: 7, vx: 200, vy: 0 };
+
+  for(let i=0; i<10; i++) {
