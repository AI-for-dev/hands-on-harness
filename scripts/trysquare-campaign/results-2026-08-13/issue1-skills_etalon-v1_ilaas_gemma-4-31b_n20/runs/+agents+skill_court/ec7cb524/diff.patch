+test('frame: no tunneling at high speed', () => {
+  const state = createState(5); // High speed level
+  const mockCtx = {
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+  };
+  const brick = state.bricks[0];
+  
+  // Position the ball so that in the next step it will jump over the brick
+  // Brick is at y=[48, 68]. 
+  // Ball starts at y=40, vy=1000.
+  // After step(state, 0.05), ball.y = 40 + 1000 * 0.05 = 90.
+  // Ball at 90 with r=7 is [83, 97]. 
+  // It has completely jumped over the brick [48, 68].
+  state.ball = {
+    x: brick.x + brick.w / 2,
+    y: 40,
+    r: 7,
+    vx: 0,
+    vy: 1000,
+  };
+
+  // The physics step happens first
+  step(state, 0.05);
+  
+  // Then the frame check
+  frame(mockCtx, state);
+
+  assert.ok(state.ball.vy < 0, 'ball should have bounced even if it jumped over the brick');
+});
