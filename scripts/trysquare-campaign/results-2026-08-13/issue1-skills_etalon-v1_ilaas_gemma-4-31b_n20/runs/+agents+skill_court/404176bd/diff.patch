+// Handles brick collisions: marks bricks as dead and bounces the ball.
+export function resolveBricks(state) {
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+
+    if (collides(state.ball, brick)) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+
+      const overlapL = state.ball.x + state.ball.r - brick.x;
+      const overlapR = brick.x + brick.w - (state.ball.x - state.ball.r);
+      const overlapT = state.ball.y + state.ball.r - brick.y;
+      const overlapB = brick.y + brick.h - (state.ball.y - state.ball.r);
+
+      const min = Math.min(overlapL, overlapR, overlapT, overlapB);
+
+      if (min === overlapT && state.ball.vy > 0) {
+        state.ball.vy = -Math.abs(state.ball.vy);
+        state.ball.y = brick.y - state.ball.r;
+      } else if (min === overlapB && state.ball.vy < 0) {
+        state.ball.vy = Math.abs(state.ball.vy);
+        state.ball.y = brick.y + brick.h + state.ball.r;
+      }
+
+      if (min === overlapL && state.ball.vx > 0) {
+        state.ball.vx = -Math.abs(state.ball.vx);
+        state.ball.x = brick.x - state.ball.r;
+      } else if (min === overlapR && state.ball.vx < 0) {
+        state.ball.vx = Math.abs(state.ball.vx);
+        state.ball.x = brick.x + brick.w + state.ball.r;
+      }
+    }
+  }
+}
