-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      // Determine hit face by finding the smallest penetration
+      const dx1 = state.ball.x + state.ball.r - brick.x;
+      const dx2 = brick.x + brick.w - (state.ball.x - state.ball.r);
+      const dy1 = state.ball.y + state.ball.r - brick.y;
+      const dy2 = brick.y + brick.h - (state.ball.y - state.ball.r);
+
+      const minPen = Math.min(dx1, dx2, dy1, dy2);
+
+      if (minPen === dx1 || minPen === dy1) {
+        if (minPen === dx1) {
+          state.ball.vx = LEFT * Math.abs(state.ball.vx);
+          state.ball.x = brick.x - state.ball.r;
+        }
+        if (minPen === dy1) {
+          state.ball.vy = UP * Math.abs(state.ball.vy);
+          state.ball.y = brick.y - state.ball.r;
+        }
+      } else if (minPen === dx2 || minPen === dy2) {
+        if (minPen === dx2) {
+          state.ball.vx = RIGHT * Math.abs(state.ball.vx);
+          state.ball.x = brick.x + brick.w + state.ball.r;
+        }
+        if (minPen === dy2) {
+          state.ball.vy = DOWN * Math.abs(state.ball.vy);
+          state.ball.y = brick.y + brick.h + state.ball.r;
+        }
+      }
     }

     ctx.fillStyle = brickColor(brick.row);
