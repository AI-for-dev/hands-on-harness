+test('frame: ball bounces off the top of a brick', () => {
+  const state = createState(1);
+  state.bricks.forEach(b => b.alive = false); // Only one brick alive
+  const brick = state.bricks[0];
+  brick.alive = true;
+
+  state.ball = {
+    x: brick.x + brick.w / 2,
+    y: brick.y - BALL_R + 1,
+    r: BALL_R,
+    vx: 0,
+    vy: 100,
+  };
+
+  const mockCtx = {
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+  };
+
+  frame(mockCtx, state);
+
+  assert.ok(state.ball.vy < 0, 'vy should be reversed (upward)');
+  assert.ok(state.ball.y + state.ball.r <= brick.y, 'ball should be pushed out of the brick');
+});
+
