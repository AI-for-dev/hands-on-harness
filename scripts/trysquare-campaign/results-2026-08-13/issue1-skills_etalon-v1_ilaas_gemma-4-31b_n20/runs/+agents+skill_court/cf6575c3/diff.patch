+// Resolves the collision between the ball and a brick: flips velocity,
+// repositions the ball to prevent sticking, and destroys the brick.
+export function resolveBrickCollision(state, brick) {
+  const { ball } = state;
+  brick.alive = false;
+  state.combo += 1;
+  state.score += scoreForBrick(brick, state.combo);
+
+  const overlapX = Math.min(ball.x + ball.r - brick.x, brick.x + brick.w - (ball.x - ball.r));
+  const overlapY = Math.min(ball.y + ball.r - brick.y, brick.y + brick.h - (ball.y - ball.r));
+
+  if (overlapX < overlapY) {
+    ball.vx = -ball.vx;
+    ball.x = ball.x + ball.r - brick.x < brick.x + brick.w - (ball.x - ball.r)
+      ? brick.x - ball.r
+      : brick.x + brick.w + ball.r;
+  } else if (overlapY < overlapX) {
+    ball.vy = -ball.vy;
+    ball.y = ball.y + ball.r - brick.y < brick.y + brick.h - (ball.y - ball.r)
+      ? brick.y - ball.r
+      : brick.y + brick.h + ball.r;
+  } else {
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+  }
+}
