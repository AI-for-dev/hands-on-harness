 } from './neon.js';

 test('collides: clear overlap detected', () => {
@@ -67,3 +76,76 @@ function belowField() {

 // TODO (#5): test comboMultiplier / scoreForBrick.
 // TODO      : test level progression and loadBest/saveBest persistence.
+
+test('frame: ball bouncing off top of brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0]; // Top-left brick
+  state.ball = {
+    x: brick.x + brick.w / 2,
+    y: brick.y - 1, // r=7, so y+r = 6 (relative to y). It overlaps.
+    r: 7,
+    vx: 0,
+    vy: 100,
+  };
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+    beginPath: () => {},
+    fillStyle: '',
+    font: '',
+  };
+  frame(ctx, state);
+  assert.equal(Math.sign(state.ball.vy), UP, 'ball should bounce up');
+});
+
+test('frame: ball bouncing off side of brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball = {
+    x: brick.x - 1, // r=7, so x+r = 6. Overlaps with brick.x.
+    y: brick.y + brick.h / 2,
+    r: 7,
+    vx: 100,
+    vy: 0,
+  };
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+    beginPath: () => {},
+    fillStyle: '',
+    font: '',
+  };
+  frame(ctx, state);
+  assert.equal(Math.sign(state.ball.vx), LEFT, 'ball should bounce left');
+});
+
+test('frame: double inversion at brick seam', () => {
+  const state = createState(1);
+
+  const offsetX = (WIDTH - (BRICK_COLS * (BRICK_W + BRICK_GAP) - BRICK_GAP)) / 2;
+  state.ball = {
+    x: offsetX + BRICK_W + BRICK_GAP / 2,
+    y: BRICK_TOP - 7 + 2,
+    r: 7,
+    vx: 0,
+    vy: 100,
+  };
+
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+    beginPath: () => {},
+    fillStyle: '',
+    font: '',
+  };
+
+  frame(ctx, state);
+
+  assert.equal(Math.sign(state.ball.vy), UP, 'ball should still bounce up even when hitting two bricks');
+});
