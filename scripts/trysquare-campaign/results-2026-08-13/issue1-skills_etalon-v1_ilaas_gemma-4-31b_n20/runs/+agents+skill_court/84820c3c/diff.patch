+test('frame: ball should not tunnel through brick at high speed', () => {
+  const state = createState(6); // Level 6: speed = 710 px/s
+  const brick = state.bricks[0];
+
+  // Position ball below the brick such that one step at dt=0.05 jumps over it
+  // Brick y: 48, h: 20 -> [48, 68]
+  // Ball y: 120, r: 7 -> [113, 127]
+  // After step (dt=0.05, vy=-710): y = 120 - 35.5 = 84.5
+  // Ball range: [77.5, 91.5] -> NO overlap with [48, 68]
+  state.ball = {
+    x: brick.x + brick.w / 2,
+    y: 120,
+    r: 7,
+    vx: 0,
+    vy: -ballSpeed(6)
+  };
+
+  // We simulate the loop: step then frame
+  step(state, 0.05);
+
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+    beginPath: () => {}
+  };
+
+  frame(ctx, state);
+
+  assert.ok(!brick.alive, 'brick should be broken even if ball tunnels through it');
+  assert.ok(state.ball.vy > 0, 'ball should have bounced');
+});
