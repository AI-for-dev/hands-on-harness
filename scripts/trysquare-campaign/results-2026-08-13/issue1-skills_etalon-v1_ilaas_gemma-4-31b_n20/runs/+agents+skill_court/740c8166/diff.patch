+test('frame: ball hitting two bricks at a seam => bounce once', () => {
+  const state = createState(1);
+  state.bricks = []; // Clear all bricks
+  // Two bricks side-by-side
+  const b1 = { x: 0, y: 0, w: 10, h: 10, alive: true, row: 0, points: 10 };
+  const b2 = { x: 10, y: 0, w: 10, h: 10, alive: true, row: 0, points: 10 };
+  state.bricks.push(b1, b2);
+  
+  // Ball is moving RIGHT and hits the seam (vertical edge)
+  state.ball = { 
+    x: 10 - BALL_R + 0.1, // just slightly inside b2
+    y: 5, 
+    r: BALL_R, 
+    vx: 100, 
+    vy: 0 
+  };
+  
+  const ctx = {
+    fillRect: () => {},
+    fillText: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+  };
+  
+  frame(ctx, state);
+  
+  assert.equal(state.ball.vx, -100, 'velocity should be inverted once');
+  assert.equal(b1.alive, false);
+  assert.equal(b2.alive, false);
+});
