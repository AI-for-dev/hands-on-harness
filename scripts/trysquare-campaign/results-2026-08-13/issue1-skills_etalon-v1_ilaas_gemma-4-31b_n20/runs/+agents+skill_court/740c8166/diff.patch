+test('frame: ball hitting brick bottom => bounce UP to DOWN', () => {
+  const state = createState(1);
+  state.bricks = []; // Clear all bricks
+  const brick = { x: 4, y: 48, w: 72, h: 20, alive: true, row: 0, points: 10 };
+  state.bricks.push(brick);
+  // Position ball just below the brick, moving UP
+  state.ball = { 
+    x: brick.x + brick.w / 2, 
+    y: brick.y + brick.h + BALL_R - 1, 
+    r: BALL_R, 
+    vx: 0, 
+    vy: 100 * UP 
+  };
+  
+  const ctx = {
+    fillRect: () => {},
+    fillText: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+  };
+  
+  frame(ctx, state);
+  
+  assert.equal(brick.alive, false, 'brick should be destroyed');
+  assert.equal(state.ball.vy, 100 * DOWN, 'velocity should flip to DOWN');
+});
+
 // Small local helper: place the ball below the field without importing the
 // height (coverage intentionally light).
 function belowField() {
   return 500;
 }
 
-// TODO (#5): test comboMultiplier / scoreForBrick.
