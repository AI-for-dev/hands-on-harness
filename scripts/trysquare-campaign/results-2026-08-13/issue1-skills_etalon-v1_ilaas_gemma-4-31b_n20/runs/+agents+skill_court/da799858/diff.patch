+// Resolves collisions between the ball and bricks.
+// This was previously in frame() (debt #2).
+export function resolveCollisions(state) {
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+
+    if (collides(state.ball, brick)) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+
+      const ball = state.ball;
+      const penLeft = (ball.x + ball.r) - brick.x;
+      const penRight = (brick.x + brick.w) - (ball.x - ball.r);
+      const penTop = (ball.y + ball.r) - brick.y;
+      const penBottom = (brick.y + brick.h) - (ball.y - ball.r);
+
+      const minPen = Math.min(penLeft, penRight, penTop, penBottom);
+
+      if (minPen === penLeft) {
+        ball.vx = -Math.abs(ball.vx);
+        ball.x = brick.x - ball.r;
+      } else if (minPen === penRight) {
+        ball.vx = Math.abs(ball.vx);
+        ball.x = brick.x + brick.w + ball.r;
+      }
+
+      if (minPen === penTop) {
+        ball.vy = -Math.abs(ball.vy);
+        ball.y = brick.y - ball.r;
+      } else if (minPen === penBottom) {
+        ball.vy = Math.abs(ball.vy);
+        ball.y = brick.y + brick.h + ball.r;
+      }
+    }
+  }
+}
