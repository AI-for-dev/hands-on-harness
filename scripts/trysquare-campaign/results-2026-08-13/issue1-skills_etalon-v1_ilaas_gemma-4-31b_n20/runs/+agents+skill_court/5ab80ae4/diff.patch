+// Mock canvas context to test frame() logic
+const mockCtx = {
+  fillStyle: '',
+  fillRect: () => {},
+  beginPath: () => {},
+  arc: () => {},
+  fill: () => {},
+  font: '',
+  fillText: () => {},
