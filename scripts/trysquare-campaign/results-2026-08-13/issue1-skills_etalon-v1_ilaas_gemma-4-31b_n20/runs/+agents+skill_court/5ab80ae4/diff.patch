@@ -114,6 +114,22 @@ export function collides(ball, brick) {
   );
 }

+export function sweptCollides(ball, brick) {
+  if (collides(ball, brick)) return true;
+
+  const left = brick.x - ball.r;
+  const right = brick.x + brick.w + ball.r;
+  const top = brick.y - ball.r;
+  const bottom = brick.y + brick.h + ball.r;
+
+  const minX = Math.min(ball.prevX, ball.x);
+  const maxX = Math.max(ball.prevX, ball.x);
+  const minY = Math.min(ball.prevY, ball.y);
+  const maxY = Math.max(ball.prevY, ball.y);
+
+  return !(maxX < left || minX > right || maxY < top || minY > bottom);
+}
