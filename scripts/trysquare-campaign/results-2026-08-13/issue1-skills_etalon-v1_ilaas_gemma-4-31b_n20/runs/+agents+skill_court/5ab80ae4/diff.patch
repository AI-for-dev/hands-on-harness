+
+test('frame: brick collision should flip velocity', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  // Ball coming from top, hitting the top face
+  state.ball = {
+    x: brick.x + brick.w / 2,
+    y: brick.y - 2, // overlap by 5 (y+r = 5, brick.y = 48? no)
+    r: 7,
+    vx: 0,
+    vy: 100, // moving DOWN (per convention)
+  };
+  // Need to make sure it's colliding
+  // brick.y is BRICK_TOP (48). ball.y is 46. ball.y + ball.r = 53. 53 > 48. OK.
+  // ball.y - ball.r = 39. 39 < 48 + 20. OK.
+
+  frame(mockCtx, state);
+
+  assert.ok(state.ball.vy < 0, 'ball should bounce UP after hitting the top of a brick');
+});
+
+test('frame: double inversion (seam) should not cancel out', () => {
+  const state = createState(1);
+  const bricks = state.bricks;
+  // Find two adjacent bricks in the same row
+  const brick0 = bricks[0];
+  const brick1 = bricks[1];
+
+  // Position ball to overlap both
+  // brick0.x + brick0.w = offsetX + 72
+  // brick1.x = offsetX + 80
+  // Center at offsetX + 76, r=7 => [69, 83]
+  state.ball = {
+    x: brick0.x + brick0.w + (brick1.x - (brick0.x + brick0.w)) / 2,
+    y: brick0.y + brick0.h / 2,
+    r: 7,
+    vx: 100, // moving RIGHT
+    vy: 0,
+  };
+
+  frame(mockCtx, state);
+
+  assert.ok(state.ball.vx < 0, 'ball should bounce LEFT after hitting a seam, not continue RIGHT');
+});
+
+test('frame: ball should not tunnel through brick at high speed', () => {
+  const state = createState(10); // High level = high speed
+  const brick = state.bricks[0];
+
+  // Ball is above the brick, and the next step will put it below
+  state.ball = {
+    x: brick.x + brick.w / 2,
+    prevY: brick.y - 10,
+    y: brick.y + brick.h + 10, // completely passed it
+    r: 7,
+    vx: 0,
+    vy: 1000,
+  };
+
+  frame(mockCtx, state);
+
+  assert.ok(!brick.alive, 'brick should be destroyed even if the ball tunneled through it');
+  assert.ok(state.ball.vy < 0, 'ball should have bounced back up');
+});
