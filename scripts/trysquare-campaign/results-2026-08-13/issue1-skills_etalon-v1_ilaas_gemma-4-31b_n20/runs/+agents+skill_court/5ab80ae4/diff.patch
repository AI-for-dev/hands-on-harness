   ball.x += ball.vx * dt;
   ball.y += ball.vy * dt;

@@ -215,19 +234,51 @@ export function frame(ctx, state) {
   ctx.fillStyle = palette.background;
   ctx.fillRect(0, 0, WIDTH, HEIGHT);

+  let bouncedX = false;
+  let bouncedY = false;
+
   // Bricks: collision + bounce + score + drawing, all in one place.
   for (const brick of state.bricks) {
     if (!brick.alive) continue;

-    if (collides(state.ball, brick)) {
+    if (sweptCollides(state.ball, brick)) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      const overlapX = Math.min(state.ball.x + state.ball.r - brick.x,
+                                 brick.x + brick.w - (state.ball.x - state.ball.r));
+      const overlapY = Math.min(state.ball.y + state.ball.r - brick.y,
+                                 brick.y + brick.h - (state.ball.y - state.ball.r));
+
+      if (overlapX < overlapY) {
+        const dir = state.ball.x < brick.x + brick.w / 2 ? -1 : 1;
+        state.ball.x += dir * overlapX;
+        if (!bouncedX) {
+          state.ball.vx *= -1;
+          bouncedX = true;
+        }
+      } else if (overlapY < overlapX) {
+        const dir = state.ball.y < brick.y + brick.h / 2 ? -1 : 1;
+        state.ball.y += dir * overlapY;
+        if (!bouncedY) {
+          state.ball.vy *= -1;
+          bouncedY = true;
+        }
+      } else {
+        const dirX = state.ball.x < brick.x + brick.w / 2 ? -1 : 1;
+        const dirY = state.ball.y < brick.y + brick.h / 2 ? -1 : 1;
+        state.ball.x += dirX * overlapX;
+        state.ball.y += dirY * overlapY;
+        if (!bouncedX) {
+          state.ball.vx *= -1;
+          bouncedX = true;
+        }
+        if (!bouncedY) {
+          state.ball.vy *= -1;
+          bouncedY = true;
+        }
+      }
     }

     ctx.fillStyle = brickColor(brick.row);
