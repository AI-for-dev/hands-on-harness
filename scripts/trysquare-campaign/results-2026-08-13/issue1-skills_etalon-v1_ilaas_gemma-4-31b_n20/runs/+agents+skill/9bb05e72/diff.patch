+/**
+ * Resolves a collision between the ball and a brick.
+ * Handles velocity flip and repositioning to prevent sticking.
+ */
+export function resolveBrickCollision(state, brick) {
+  const { ball } = state;
+
+  const overlapX = Math.min(
+    ball.x + ball.r - brick.x,
+    brick.x + brick.w - (ball.x - ball.r)
+  );
+  const overlapY = Math.min(
+    ball.y + ball.r - brick.y,
+    brick.y + brick.h - (ball.y - ball.r)
+  );
+
+  if (overlapX < overlapY) {
+    ball.vx = -ball.vx;
+    if (ball.x < brick.x + brick.w / 2) {
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+    }
+  } else {
+    ball.vy = -ball.vy;
+    if (ball.y < brick.y + brick.h / 2) {
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  }
+}
+
+/**
+ * Checks and resolves all brick collisions for the current state.
+ */
+export function handleBrickCollisions(state) {
+  let collisionResolved = false;
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+
+    if (collides(state.ball, brick)) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+      if (!collisionResolved) {
+        resolveBrickCollision(state, brick);
+        collisionResolved = true;
+      }
+    }
+  }
+}
