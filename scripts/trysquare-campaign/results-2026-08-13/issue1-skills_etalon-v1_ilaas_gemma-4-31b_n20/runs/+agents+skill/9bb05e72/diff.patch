+/**
+ * Updates the game physics and brick collisions using sub-stepping to prevent tunneling.
+ */
+export function update(state, dt) {
+  const speed = ballSpeed(state.level);
+  const MAX_STEP = 5; // Max pixels per sub-step
+  const subSteps = Math.ceil((speed * dt) / MAX_STEP) || 1;
+  const subDt = dt / subSteps;
+
+  for (let i = 0; i < subSteps; i++) {
+    const lost = step(state, subDt);
+    handleBrickCollisions(state);
+    if (lost) return true;
+  }
+  return false;
+}
