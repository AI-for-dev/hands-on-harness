+test('step: bounce off brick bottom face', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y + brick.h - 1, r: 7, vx: 0, vy: -100 };
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy > 0, 'should bounce DOWN');
+  assert.ok(state.ball.y >= brick.y + brick.h + 7, 'should be repositioned below');
+});
+
+test('step: bounce off brick left face', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball = { x: brick.x - 1, y: brick.y + brick.h / 2, r: 7, vx: 100, vy: 0 };
+  step(state, 1 / 60);
+  assert.ok(state.ball.vx < 0, 'should bounce LEFT');
+  assert.ok(state.ball.x <= brick.x - 7, 'should be repositioned left');
+});
+
+test('step: brick is destroyed on collision', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y + brick.h / 2, r: 7, vx: 0, vy: 0 };
+  step(state, 1 / 60);
+  assert.equal(brick.alive, false);
+});
