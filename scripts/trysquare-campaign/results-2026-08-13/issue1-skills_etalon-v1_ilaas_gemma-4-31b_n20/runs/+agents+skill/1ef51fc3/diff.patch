+import { test } from 'node:test';
+import assert from 'node:assert';
+import { createState, frame, ballSpeed } from '../game/neon.js';
+
+// Mock canvas context
+const ctx = {
+  fillRect: () => {},
+  arc: () => {},
+  fill: () => {},
+  fillText: () => {},
+  beginPath: () => {},
+};
+
+test('D1: Basic Vertical Bounce (Bottom Face)', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+
+  // Ball moving UP, hitting the bottom face
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + brick.h - 1; // overlap
+  state.ball.vy = -100;
+
+  frame(ctx, state);
+
+  assert.ok(state.ball.vy > 0, `Ball should bounce DOWN (vy > 0), but got ${state.ball.vy}`);
+});
+
+test('D1: Basic Horizontal Bounce (Left Face)', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+
+  // Ball moving RIGHT, hitting the left face
+  state.ball.x = brick.x - 1; // overlap
+  state.ball.y = brick.y + brick.h / 2;
+  state.ball.vx = 100;
+
+  frame(ctx, state);
+
+  assert.ok(state.ball.vx < 0, `Ball should bounce LEFT (vx < 0), but got ${state.ball.vx}`);
+});
+
+test('D2: Tunneling at Level 6', () => {
+  const state = createState(6);
+  const brick = state.bricks[0];
+
+  // Ball is just below the brick
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + brick.h + 1;
+  state.ball.vy = -ballSpeed(6); // -710 px/s
+
+  // Simulate one frame with max dt (0.05s)
+  const dt = 0.05;
+  const nextY = state.ball.y + state.ball.vy * dt;
+
+  state.ball.y = nextY;
+  frame(ctx, state);
+
+  assert.ok(brick.alive === false, 'Ball should have hit the brick even when tunneling');
+});
