@@ -0,0 +1,93 @@
+import { test } from 'node:test';
+import assert from 'node:assert';
+import { createState, frame, collides } from '../game/neon.js';
+
+const ctx = {
+  fillRect: () => {},
+  arc: () => {},
+  fill: () => {},
+  fillText: () => {},
+  beginPath: () => {},
+};
+
+test('D1: No deflection - Ball should change velocity upon brick collision', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + brick.h + state.ball.r + 1;
+  state.ball.vy = -100;
+  state.ball.y -= 10; 
+  
+  const initialVy = state.ball.vy;
+  frame(ctx, state);
+  assert.notStrictEqual(state.ball.vy, initialVy, 'Ball vy should change');
+});
+
+test('D2: Sticky collision - Ball should be pushed out of brick after collision', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + brick.h + state.ball.r + 1;
+  state.ball.vy = -100;
+  state.ball.y -= 10; 
+  
+  frame(ctx, state);
+  assert.strictEqual(collides(state.ball, brick), false, 'Ball should not overlap brick after resolution');
+});
+
+test('D3: Wrong axis - Ball should flip vx when hitting the side', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x - state.ball.r - 1;
+  state.ball.y = brick.y + brick.h / 2;
+  state.ball.vx = 100;
+  state.ball.x += 10;
+
+  const initialVx = state.ball.vx;
+  const initialVy = state.ball.vy;
+  frame(ctx, state);
+  
+  assert.notStrictEqual(state.ball.vx, initialVx, 'Ball vx should change');
+  assert.strictEqual(state.ball.vy, initialVy, 'Ball vy should not change when hitting side');
+});
+
+test('D4: Tunneling - Ball should not skip brick at high speed', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  
+  // Position ball so it just crossed the brick in one frame
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + brick.h + state.ball.r + 1; 
+  // We assume the previous position was state.ball.y < brick.y - ball.r
+  // In a real swept AABB, this would be detected.
+  
+  // For the purpose of this test, we manually check if it was detected.
+  // Since we can't easily "simulate" the previous frame in this pure function,
+  // we just note that the current implementation cannot detect this.
+  
+  // A "perfect" implementation would use something like:
+  // if (collides(state.ball, brick) || sweptCollides(prevBall, state.ball, brick)) ...
+  
+  // To make this test "fail" on current code, we can't easily without changing the API
+  // of frame() to accept the previous state.
+  // However, we can just check if the brick is broken.
+  frame(ctx, state);
+  assert.strictEqual(brick.alive, false, 'Brick should be broken even if ball jumped over it');
+});
+
+test('D5: Double inversion - Ball should not bounce twice in one frame', () => {
+  const state = createState(1);
+  const brick1 = state.bricks[0]; // Top left
+  const brick2 = state.bricks[1]; // Top, next to it
+  
+  // Position ball exactly on the seam between two bricks
+  state.ball.x = brick1.x + brick1.w; 
+  state.ball.y = brick1.y + brick1.h / 2;
+  state.ball.vx = 100; 
+  
+  // If both are hit and both flip vx, the result is vx = 100 (no change)
+  // If the ball is’ in both, and we flip twice, it's as if no collision happened.
+  
+  frame(ctx, state);
+  assert.notStrictEqual(state.ball.vx, 100, 'Ball vx should be flipped once, not twice');
+});
