+
+import assert from 'node:assert';
+import test from 'node:test';
+import { createState, frame } from '../game/neon.js';
+
+test('D1: Ball should bounce off brick', (t) => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 1; 
+  state.ball.vy = 100; 
+  state.ball.vx = 0;
+  
+  const ctx = {
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+  };
+
+  frame(ctx, state);
+  
+  assert.ok(state.ball.vy < 0, `Ball should have bounced up, but vy is ${state.ball.vy}`);
+});
+
+test('D2: Tunneling - Ball should not pass through brick at high speed', (t) => {
+  const state = createState(6); 
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 2;
+  state.ball.vy = 800; 
+  state.ball.vx = 0;
+  
+  const ctx = {
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+  };
+  
+  state.ball.y += state.ball.vy * 0.05;
+  frame(ctx, state);
+  
+  assert.strictEqual(brick.alive, false, 'Brick should have been broken even with high speed (tunneling)');
+});
+
+test('D3: Sticky - Ball should not vibrate inside brick', (t) => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  // Ball is already overlapping the brick
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + 5; 
+  state.ball.vy = 10; 
+  state.ball.vx = 0;
+  
+  const ctx = {
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+  };
+
+  // First frame: collision detected, vy inverted.
+  frame(ctx, state);
+  const vyAfterFirst = state.ball.vy;
+  
+  // Second frame: if it's still overlapping and we just flip vy, it will flip back.
+  // We simulate a small movement to keep it overlapping.
+  state.ball.y += state.ball.vy * 0.01; 
+  frame(ctx, state);
+  
+  // If it's sticky, the second frame will flip it back to positive.
+  // We want it to stay moving away from the brick.
+  assert.ok(state.ball.vy < 0, `Ball should keep moving away, but vy is ${state.ball.vy}`);
+});
+
+test('D4: Face vs Coin - Corner hit should invert both axes', (t) => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  // Hit the top-left corner
+  state.ball.x = brick.x - 1;
+  state.ball.y = brick.y - 1;
+  state.ball.vx = 100;
+  state.ball.vy = 100;
+  
+  const ctx = {
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+  };
+
+  frame(ctx, state);
+  
+  assert.ok(state.ball.vx < 0, `Ball should have bounced left, but vx is ${state.ball.vx}`);
+  assert.ok(state.ball.vy < 0, `Ball should have bounced up, but vy is ${state.ball.vy}`);
+});
