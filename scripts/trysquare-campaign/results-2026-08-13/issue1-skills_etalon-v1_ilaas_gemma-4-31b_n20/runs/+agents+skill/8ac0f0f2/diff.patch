+import assert from 'node:assert';
+import { collides, createState, frame, step, BRICK_H, BRICK_W, BALL_R, UP, DOWN, LEFT, RIGHT } from '../game/neon.js';
+
+// Mock canvas context
+const ctx = {
+  fillRect: () => {},
+  arc: () => {},
+  fill: () => {},
+  beginPath: () => {},
+  fillText: () => {},
+};
+
+function testBounceTop() {
+  console.log('Testing Bounce Top...');
+  const state = createState(1);
+  const brick = state.bricks[0];
+  brick.x = 100; brick.y = 100; brick.w = 50; brick.h = 20;
+  
+  state.ball.x = 125;
+  state.ball.y = 100 - BALL_R - 1; // Just above
+  state.ball.vy = -100; // Moving UP (towards brick top)
+  state.ball.vx = 0;
+
+  // Manually simulate what frame() does
+  // 1. Move ball (simulate a step that puts it inside)
+  state.ball.y += state.ball.vy * 0.02; // moves to 98 - 7 - 1 = 90 ? No.
+  // Let's just force position
+  state.ball.y = 100 - 2; // ball.y + r = 98 + 7 = 105. Brick top is 100. Collision!
+  
+  frame(ctx, state);
+  
+  console.log(`Ball vy after collision: ${state.ball.vy}`);
+  assert.strictEqual(state.ball.vy, 100, 'Ball should bounce DOWN after hitting TOP face');
+  assert.ok(state.ball.y + BALL_R <= brick.y, 'Ball should be pushed out of the brick');
+}
+
+function testBounceBottom() {
+  console.log('Testing Bounce Bottom...');
+  const state = createState(1);
+  const brick = state.bricks[0];
+  brick.x = 100; brick.y = 100; brick.w = 50; brick.h = 20;
+  
+  state.ball.x = 125;
+  state.ball.y = 120 + BALL_R + 1; // Just below
+  state.ball.vy = 100; // Moving DOWN (away from brick) - Wait, to hit bottom it must move UP.
+  state.ball.vy = -100; // Moving UP
+  
+  state.ball.y = 120 + 2; // ball.y - r = 122 - 7 = 115. Brick bottom is 120.
+  // Need to be inside: ball.y - r < 120 and ball.y + r > 120.
+  state.ball.y = 120 + 5; // y-r = 118. Collision!
+  
+  frame(ctx, state);
+  
+  console.log(`Ball vy after collision: ${state.ball.vy}`);
+  assert.strictEqual(state.ball.vy, -100, 'Ball should bounce UP after hitting BOTTOM face');
+  assert.ok(state.ball.y - BALL_R >= brick.y + brick.h, 'Ball should be pushed out of the brick');
+}
+
+function testTunneling() {
+  console.log('Testing Tunneling...');
+  const state = createState(1);
+  const brick = state.bricks[0];
+  brick.x = 100; brick.y = 100; brick.w = 50; brick.h = 20;
+  
+  state.ball.x = 125;
+  state.ball.y = 80; // Well above
+  state.ball.vy = -1000; // Extremely fast UP
+  
+  // Simulate one step
+  const dt = 0.05;
+  const lost = step(state, dt);
+  
+  // Ball moved from 80 to 80 + (-1000 * 0.05) = 30.
+  // It skipped from 80 to 30. The brick is at 100.
+  // Wait, if it starts at 80 and vy = -1000, it goes to 30. It never entered the brick area (100-120).
+  // Let's put it below and move it up.
+  state.ball.y = 140;
+  state.ball.vy = -1000;
+  
+  // New position: 140 + (-50) = 90.
+  // It was at 140 (below) and is now at 90 (above).
+  // Did it collide in frame()?
+  frame(ctx, state);
+  
+  // Since the collision is checked in frame() AFTER step(), if the step jumped over, it doesn't collide.
+  // This is the definition of tunneling.
+}
+
+try {
+  testBounceTop();
+} catch (e) {
+  console.error('testBounceTop failed:', e.message);
+}
+
+try {
+  testBounceBottom();
+} catch (e) {
+  console.error('testBounceBottom failed:', e.message);
+}
+
+try {
+  testTunneling();
+} catch (e) {
+  console.error('testTunneling failed:', e.message);
+}
