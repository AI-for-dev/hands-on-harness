+// Handles collision between the ball and all alive bricks.
+// Returns true if any brick was broken.
+export function resolveBrickCollisions(state) {
+  let hit = false;
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+
+    if (collides(state.ball, brick)) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+
+      const closestX = Math.max(brick.x, Math.min(state.ball.x, brick.x + brick.w));
+      const closestY = Math.max(brick.y, Math.min(state.ball.y, brick.y + brick.h));
+
+      const diffX = state.ball.x - closestX;
+      const diffY = state.ball.y - closestY;
+      const distance = Math.sqrt(diffX * diffX + diffY * diffY);
+
+      if (distance > 0) {
+        const nx = diffX / distance;
+        const ny = diffY / distance;
+        const dot = state.ball.vx * nx + state.ball.vy * ny;
+        state.ball.vx -= 2 * dot * nx;
+        state.ball.vy -= 2 * dot * ny;
+        state.ball.x = closestX + nx * state.ball.r;
+        state.ball.y = closestY + ny * state.ball.r;
+      } else {
+        const dx1 = state.ball.x - brick.x;
+        const dx2 = brick.x + brick.w - state.ball.x;
+        const dy1 = state.ball.y - brick.y;
+        const dy2 = brick.y + brick.h - state.ball.y;
+        const min = Math.min(dx1, dx2, dy1, dy2);
+        if (min === dx1) {
+          state.ball.x = brick.x - state.ball.r;
+          state.ball.vx = -Math.abs(state.ball.vx);
+        } else if (min === dx2) {
+          state.ball.x = brick.x + brick.w + state.ball.r;
+          state.ball.vx = Math.abs(state.ball.vx);
+        } else if (min === dy1) {
+          state.ball.y = brick.y - state.ball.r;
+          state.ball.vy = Math.abs(state.ball.vy);
+        } else {
+          state.ball.y = brick.y + brick.h + state.ball.r;
+          state.ball.vy = -Math.abs(state.ball.vy);
+        }
+      }
+      hit = true;
+      break; // Only one brick collision per frame to avoid double-bounce
+    }
+  }
+  return hit;
+}
