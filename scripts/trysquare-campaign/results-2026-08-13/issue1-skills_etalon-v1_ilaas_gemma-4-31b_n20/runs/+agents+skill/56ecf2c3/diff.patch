+export function resolveCollision(state, brick) {
+  if (!collides(state.ball, brick)) return false;
+
+  const ball = state.ball;
+  const r = ball.r;
+
+  // Compute overlaps on each axis
+  const dx1 = ball.x + r - brick.x;
+  const dx2 = brick.x + brick.w - (ball.x - r);
+  const dy1 = ball.y + r - brick.y;
+  const dy2 = brick.y + brick.h - (ball.y - r);
+
+  const overlapX = Math.min(dx1, dx2);
+  const overlapY = Math.min(dy1, dy2);
+
+  const EPSILON = 0.1;
+
+  if (Math.abs(overlapX - overlapY) < EPSILON) {
+    // Corner hit
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    // Reposition on both axes
+    ball.x += (dx1 < dx2) ? -overlapX : overlapX;
+    ball.y += (dy1 < dy2) ? -overlapY : overlapY;
+  } else if (overlapX < overlapY) {
+    // Collision on X axis
+    ball.vx = -ball.vx;
+    ball.x += (dx1 < dx2) ? -overlapX : overlapX;
+  } else {
+    // Collision on Y axis
+    ball.vy = -ball.vy;
+    ball.y += (dy1 < dy2) ? -overlapY : overlapY;
+  }
+
+  brick.alive = false;
+  state.combo += 1;
+  state.score += scoreForBrick(brick, state.combo); // Wait, typo in my thought, let's check function name.
+  return true;
+}
