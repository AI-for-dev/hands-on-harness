+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, collides, resolveCollision } from '../game/neon.js';
+
+test('D1: ball should bounce off brick (currently fails)', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  
+  // Position the ball so it's colliding with the top face of the brick
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 2; // just above the brick
+  state.ball.vy = 100; // moving down
+  
+  const initialVy = state.ball.vy;
+  
+  // Use the new resolveCollision function
+  resolveCollision(state, brick);
+  
+  
+  assert.notStrictEqual(state.ball.vy, initialVy, 'Ball velocity should have changed after collision');
