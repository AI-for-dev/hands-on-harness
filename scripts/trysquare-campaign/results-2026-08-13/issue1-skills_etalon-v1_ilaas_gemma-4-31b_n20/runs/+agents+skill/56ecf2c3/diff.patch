+import { createState, resolveCollision } from '../game/neon.js';
+
+test('D5: ball should not tunnel through brick at high speed', () => {
+  const state = createState(7); // Level 7, high speed
+  const brick = { x: 0, y: 0, w: 100, h: 20, alive: true };
+  
+  // Ball is above the brick
+  state.ball.x = 50;
+  state.ball.y = -10;
+  state.ball.vy = 1000; // Very fast!
+  
+  // Move the ball by one frame (dt = 0.05)
+  // New y = -10 + 1000 * 0.05 = 40.
+  // Ball range: [33, 47].
+  // Brick range: [0, 20].
+  // The ball has jumped OVER the brick.
+  
+  const dt = 0.05;
+  state.ball.y += state.ball.vy * dt;
+  
+  // Current logic in frame():
+  const collided = resolveCollision(state, brick);
+  
+  assert.strictEqual(collided, true, 'Collision should be detected even if the ball jumped over');
+});
