@@ -0,0 +1,26 @@
+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, resolveCollision } from '../game/neon.js';
+
+test('D2: ball should not stick to brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  
+  // Position the ball so it's deeply penetrating the top of the brick
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + 2; // center of ball is INSIDE the brick
+  state.ball.vy = 100;
+  
+  resolveCollision(state, brick);
+  
+  // After resolution, the ball should no longer collide with the SAME brick
+  // (In the real game, the brick is dead, but for this test let's see if it's out of the bounds)
+  const isStillOverlapping = (
+    state.ball.x + state.ball.r > brick.x &&
+    state.ball.x - state.ball.r < brick.x + brick.w &&
+    state.ball.y + state.ball.r > brick.y &&
+    state.ball.y - state.ball.r < brick.y + brick.h
+  );
+  
+  assert.strictEqual(isStillOverlapping, false, 'Ball should be repositioned outside the brick');
+});
