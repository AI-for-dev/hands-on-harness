@@ -0,0 +1,24 @@
+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, resolveCollision } from '../game/neon.js';
+
+test('D3: ball should not double-bounce (ghost collision)', () => {
+  const state = createState(1);
+  // Create two bricks side by side
+  const brick1 = { x: 0, y: 0, w: 10, h: 10, alive: true };
+  const brick2 = { x: 10, y: 0, w: 10, h: 10, alive: true };
+  
+  // Ball is positioned so it overlaps both on the bottom edge
+  state.ball.x = 10;
+  state.ball.y = -2;
+  state.ball.vx = 0;
+  state.ball.vy = 100; // moving down
+  
+  // Simulate frame loop
+  resolveCollision(state, brick1);
+  resolveCollision(state, brick2);
+  
+  // The ball should still be moving UP. 
+  // If it double-bounced, it would be moving DOWN.
+  assert.strictEqual(state.ball.vy, -100, 'Ball should have only bounced once');
+});
