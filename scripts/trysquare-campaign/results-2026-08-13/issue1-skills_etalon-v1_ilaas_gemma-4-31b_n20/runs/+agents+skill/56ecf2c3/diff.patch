+  const state = createState(1);
+  const brick = { x: 0, y: 0, w: 10, h: 10, alive: true };
+  
+  // Position the ball so it hits the top-left corner
+  // Ball radius 7.
+  // We want overlapX and overlapY to be almost equal.
+  state.ball.x = -7 + 0.1; // right edge is at 0.1, barely inside brick
+  state.ball.y = -7 + 0.1; // bottom edge is at 0.1, barely inside brick
+  state.ball.vx = 100;
+  state.ball.vy = 100;
+  
+  resolveCollision(state, brick);
+  
+  assert.strictEqual(state.ball.vx, -100, 'vx should be inverted');
+  assert.strictEqual(state.ball.vy, -100, 'vy should be inverted');
+});
