+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, step, collides } from '../game/neon.js';
+
+test('Ball should bounce off a brick', (t) => {
+  const state = createState(1);
+  // Position ball so it hits the top of the first brick in the first frame
+  // First brick: x=offsetX, y=BRICK_TOP, w=BRICK_W, h=BRICK_H
+  // Let's simplify and use a mock brick.
+  const brick = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  state.ball = { x: 136, y: 90, r: 7, vx: 0, vy: 100 }; // moving DOWN
+
+  // We need to simulate what happens in frame() since that's where collision is handled
+  // But frame() is tied to rendering. Let's see how it's implemented.
+  // Actually, the bug is that frame() DOES NOT deflect.
+  // To test this "logically", we have to simulate the logic inside frame()
+
+  // In neon.js, the collision is checked in frame().
+  // Let's see if we can reproduce the "no bounce" by checking the ball's state
+  // after a simulated collision.
+
+  // Since I can't change neon.js yet, I'll just test the current behavior.
+  // Currently, collides() is true, but the ball's vy doesn't change.
+
+  assert.strictEqual(collides(state.ball, brick), false);
+
+  // Move ball into brick
+  state.ball.y = 100 - 2; // just above the brick
+  state.ball.y += 100 * 0.01; // move it down
+
+  assert.strictEqual(collides(state.ball, brick), true);
+  // Now, if we were in frame(), the brick would be killed but vy would remain 100.
+  // This is the bug.
+});
