+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, frame, UP, DOWN, LEFT, RIGHT } from '../game/neon.js';
+
+const mockCtx = {
+  fillRect: () => {},
+  arc: () => {},
+  fill: () => {},
+  beginPath: () => {},
+  fillText: () => {},
+};
+
+test('D1 - Missing Deflection: Ball should bounce off top face', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+
+  // Position ball hitting the top of the brick
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 2; // Inside the collision zone
+  state.ball.vy = 100; // Moving DOWN
+  state.ball.vx = 0;
+
+  frame(mockCtx, state);
+
+  assert.ok(!brick.alive, 'Brick should be destroyed');
+  assert.strictEqual(state.ball.vy, -100, 'Ball should bounce UP');
+});
+
+test('D4 - Face vs Corner: Ball should bounce off side face', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+
+  // Position ball hitting the left side of the brick
+  state.ball.x = brick.x - 2; // Inside collision zone
+  state.ball.y = brick.y + brick.h / 2;
+  state.ball.vx = 100; // Moving RIGHT
+  state.ball.vy = 0;
+
+  frame(mockCtx, state);
+
+  assert.ok(!brick.alive, 'Brick should be destroyed');
+  assert.strictEqual(state.ball.vx, -100, 'Ball should bounce LEFT');
+  assert.strictEqual(state.ball.vy, 0, 'Ball should not move vertically');
+});
+
+test('D2 - Sticky: Ball should be pushed out of brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+
+  // Position ball deep inside the brick
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + 2;
+  state.ball.vy = 100; // Moving DOWN
+  state.ball.vx = 0;
+
+  frame(mockCtx, state);
+
+  // After resolution, the ball should no longer be colliding with the brick
+  // (or at least be moving away and NOT inside if we were to check again)
+  // For this test, since the brick is now 'dead', collides() still works if we check.
+  // But the goal is that the position is corrected.
+
+  // Correct behavior: if it hit the top, it should be at y = brick.y - ball.r
+  assert.ok(state.ball.y <= brick.y - 7, `Ball should be pushed above brick. Got y=${state.ball.y}`);
+});
+
+test('D3 - Double Inversion: No double bounce on seam', () => {
+  // This one is harder to setup with current frame() because it iterates bricks.
+  // If two bricks are hit, and we just do vy = -vy, it'll flip twice.
+});
