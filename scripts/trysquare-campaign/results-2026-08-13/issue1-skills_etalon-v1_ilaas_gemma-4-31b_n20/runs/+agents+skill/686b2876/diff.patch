+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, frame } from '../game/neon.js';
+
+const mockCtx = {
+  fillRect: () => {},
+  arc: () => {},
+  fill: () => {},
+  beginPath: () => {},
+  fillText: () => {},
+};
+
+test('D5 - Tunneling: Ball should not pass through brick at high speed', () => {
+  const state = createState(6);
+  const brick = state.bricks[0];
+
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 10;
+  state.ball.vy = 1000;
+  state.ball.vx = 0;
+
+  const dt = 0.05;
+  state.ball.x += state.ball.vx * dt;
+  state.ball.y += state.ball.vy * dt;
+
+  frame(mockCtx, state);
+
+  assert.ok(!brick.alive, 'Brick should have been destroyed');
+  assert.ok(state.ball.vy < 0, 'Ball should have bounced UP');
+});
