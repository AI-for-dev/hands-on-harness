+// Resolves collision by flipping velocity and repositioning the ball.
+// Returns true if a collision occurred.
+export function resolveCollision(ball, brick) {
+  const dx = ball.x - (brick.x + brick.w / 2);
+  const dy = ball.y - (brick.y + brick.h / 2);
+  const halfW = brick.w / 2 + ball.r;
+  const halfH = brick.h / 2 + ball.r;
+
+  const overlapX = halfW - Math.abs(dx);
+  const overlapY = halfH - Math.abs(dy);
+
+  if (overlapX <= 0 || overlapY <= 0) return false;
+
+  if (overlapX < overlapY) {
+    ball.vx = dx > 0 ? Math.abs(ball.vx) : -Math.abs(ball.vx);
+    ball.x = dx > 0 ? brick.x + brick.w + ball.r : brick.x - ball.r;
+  } else {
+    ball.vy = dy > 0 ? Math.abs(ball.vy) : -Math.abs(ball.vy);
+    ball.y = dy > 0 ? brick.y + brick.h + ball.r : brick.y - ball.r;
+  }
+  return true;
+}
