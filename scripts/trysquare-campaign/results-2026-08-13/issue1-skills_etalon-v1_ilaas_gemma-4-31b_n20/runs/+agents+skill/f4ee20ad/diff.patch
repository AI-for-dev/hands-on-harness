+  state.ball.vx = 0;
+  
+  step(state, 0.01); 
+  
+  assert.ok(state.ball.vy < 0, 'Ball should bounce up (vy < 0)');
+});
+
+test('D2 - Sticky Collision: ball should be pushed out of the brick', () => {
+  const state = createState(1);
+  state.bricks = [];
+  const brick = { x: 0, y: 100, w: 100, h: 100, alive: true };
+  state.bricks.push(brick);
+  
+  state.ball.x = 50;
+  state.ball.y = 105; // Inside brick
+  state.ball.vy = 100;
+  
+  step(state, 0.01); 
+  
+  const isInside = collides(state.ball, brick);
+  assert.ok(!isInside, 'Ball should be pushed out of the brick');
+});
+
+test('D3 - Tunneling: fast ball should not skip the brick', () => {
+  const state = createState(10);
+  state.bricks = [];
