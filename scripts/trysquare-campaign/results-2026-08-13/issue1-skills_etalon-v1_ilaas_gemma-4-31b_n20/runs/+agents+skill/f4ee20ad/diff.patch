+test('D1 - Missing Bounce: ball should bounce off a brick', () => {
+  const state = createState(1);
+  state.bricks = [];
+  const brick = { x: 0, y: 100, w: 100, h: 100, alive: true };
+  state.bricks.push(brick);
+  
