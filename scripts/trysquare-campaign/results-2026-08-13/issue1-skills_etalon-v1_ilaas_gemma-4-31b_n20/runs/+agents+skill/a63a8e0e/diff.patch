diff --git a/game/neon.test.js b/game/neon.test.js
index 250d6a9..4c435f8 100644
--- a/game/neon.test.js
+++ b/game/neon.test.js
@@ -52,6 +52,48 @@ test('step: ball exiting through the bottom => lost', () => {
   assert.equal(lost, true);
 });
 
+test('step: ball bounces OFF THE TOP of a brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - state.ball.r + 1;
+  state.ball.vy = 100;
+  state.ball.vx = 0;
+
+  step(state, 0.01);
+
+  assert.equal(brick.alive, false);
+  assert.equal(state.ball.vy, -100, 'vy should be flipped');
+  assert.ok(state.ball.y + state.ball.r <= brick.y, 'ball should be pushed out of the brick');
+});
+
+test('step: ball bounces OFF THE SIDE of a brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[1]; // Use a brick not on the left edge
+  state.ball.x = brick.x - state.ball.r + 1;
+  state.ball.y = brick.y + brick.h / 2;
+  state.ball.vx = 100;
+  state.ball.vy = 0;
+
+  step(state, 0.01);
+
+  assert.equal(brick.alive, false);
+  assert.equal(state.ball.vx, -100, 'vx should be flipped');
+  assert.ok(state.ball.x + state.ball.r <= brick.x, 'ball should be pushed out of the brick');
+});
+
+test('step: ball does not tunnel through brick at high speed', () => {
+  const state = createState(6);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - state.ball.r - 10;
+  state.ball.vy = 2000;
+  
+  step(state, 0.05);
+
+  assert.equal(brick.alive, false, 'Brick should be destroyed despite high speed');
+});
