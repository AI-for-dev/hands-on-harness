   );
 }

+export function sweptCollides(ball, brick) {
+  const minX = Math.min(ball.prevX, ball.x) - ball.r;
+  const maxX = Math.max(ball.prevX, ball.x) + ball.r;
+  const minY = Math.min(ball.prevY, ball.y) - ball.r;
+  const maxY = Math.max(ball.prevY, ball.y) + ball.r;
+
+  return (
+    maxX > brick.x &&
+    minX < brick.x + brick.w &&
+    maxY > brick.y &&
+    minY < brick.y + brick.h
+  );
+}
+
 // --- Score & combo (NOT covered by tests — debt #5) ------------------------

 // Combo multiplier. UNBOUNDED today: a long combo makes the score blow up
@@ -165,6 +179,8 @@ export function saveBest(storage, score) {
 export function step(state, dt) {
   const { ball, paddle } = state;

+  ball.prevX = ball.x;
+  ball.prevY = ball.y;
   ball.x += ball.vx * dt;
   ball.y += ball.vy * dt;

@@ -219,15 +235,55 @@ export function frame(ctx, state) {
   for (const brick of state.bricks) {
     if (!brick.alive) continue;

-    if (collides(state.ball, brick)) {
+    if (sweptCollides(state.ball, brick)) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      // Bounce resolution: invert velocity based on the face hit.
+      // If we tunneled, we use the previous position to estimate the hit face.
+      const isTunneling = !collides(state.ball, brick);
+      const bx = isTunneling ? state.ball.prevX : state.ball.x;
+      const by = isTunneling ? state.ball.prevY : state.ball.y;
+
+      const overlapLeft = (bx + state.ball.r) - brick.x;
+      const overlapRight = (brick.x + brick.w) - (bx - state.ball.r);
+      const overlapTop = (by + state.ball.r) - brick.y;
+      const overlapBottom = (brick.y + brick.h) - (by - state.ball.r);
+
+      const minX = Math.min(overlapLeft, overlapRight);
+      const minY = Math.min(overlapTop, overlapBottom);
+
+      if (minX < minY) {
+        if (minX === overlapLeft) {
+          state.ball.vx = -Math.abs(state.ball.vx);
+          state.ball.x = brick.x - state.ball.r;
+        } else {
+          state.ball.vx = Math.abs(state.ball.vx);
+          state.ball.x = brick.x + brick.w + state.ball.r;
+        }
+      } else if (minX > minY) {
+        if (minY === overlapTop) {
+          state.ball.vy = -Math.abs(state.ball.vy);
+          state.ball.y = brick.y - state.ball.r;
+        } else {
+          state.ball.vy = Math.abs(state.ball.vy);
+          state.ball.y = brick.y + brick.h + state.ball.r;
+        }
+      } else {
+        // Corner hit: flip both
+        state.ball.vx = (minX === overlapLeft) ? -Math.abs(state.ball.vx) : Math.abs(state.ball.vx);
+        state.ball.vy = (minY === overlapTop) ? -Math.abs(state.ball.vy) : Math.abs(state.ball.vy);
+
+        if (minX === overlapLeft) state.ball.x = brick.x - state.ball.r;
+        else state.ball.x = brick.x + brick.w + state.ball.r;
+
+        if (minY === overlapTop) state.ball.y = brick.y - state.ball.r;
+        else state.ball.y = brick.y + brick.h + state.ball.r;
+      }
+
+      // Prevent ghost collisions by stopping further checks this frame
+      break;
     }

     ctx.fillStyle = brickColor(brick.row);
