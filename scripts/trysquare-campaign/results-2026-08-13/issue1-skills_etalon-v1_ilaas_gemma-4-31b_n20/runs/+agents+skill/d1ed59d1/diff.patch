@@ -0,0 +1,95 @@
+
+import { test } from 'node:test';
+import assert from 'node:assert';
+import { createState, frame, WIDTH, HEIGHT, BALL_R } from '../game/neon.js';
+
+const ctx = {
+  fillStyle: '',
+  fillRect: () => {},
+  beginPath: () => {},
+  arc: () => {},
+  fill: () => {},
+  fillText: () => {},
+};
+
+test('D1: Missing Bounce - Ball should bounce off a brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + brick.h + 2; // Just below
+  state.ball.vy = -100; // Moving up
+  
+  frame(ctx, state);
+  assert.strictEqual(state.ball.vy, 100, 'Ball should have bounced and now be moving down');
+});
+
+test('D2: Sticky - Ball should be repositioned out of brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  // Position ball so it's deep inside the brick from the bottom
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + brick.h - 1; // Center is 1px above the bottom edge
+  // Ball bottom is at y + 7 = brick.y + brick.h + 6.
+  // Ball top is at y - 7 = brick.y + brick.h - 8.
+  // Since brick.h = 20, brick.y + brick.h - 8 is definitely inside the brick.
+  state.ball.vy = -100;
+
+  frame(ctx, state);
+  
+  // After bounce from bottom, the ball should be at y - 7 = brick.y + brick.h
+  // So y = brick.y + brick.h + 7
+  assert.strictEqual(state.ball.y, brick.y + brick.h + BALL_R, 'Ball should be pushed out of the brick');
+});
+
+test('D3: Face vs Corner - Ball should bounce off the side', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x - 2; // Just to the left
+  state.ball.y = brick.y + brick.h / 2;
+  state.ball.vx = 100; // Moving right
+  
+  frame(ctx, state);
+  assert.strictEqual(state.ball.vx, -100, 'Ball should have bounced off the side');
+});
+
+test('D4: Double Inversion - Ball should not invert twice on a seam', () => {
+  const state = createState(1);
+  const b1 = state.bricks[0];
+  const b2 = state.bricks[1];
+  
+  // Ball is exactly on the seam between b1 and b2
+  state.ball.x = b1.x + b1.w; 
+  state.ball.y = b1.y + b1.h / 2;
+  state.ball.vx = 100;
+
+  frame(ctx, state);
+  assert.strictEqual(state.ball.vx, -100, 'Ball should have inverted once, not twice');
+});
+
+test('D5: Tunneling - Ball should not jump over a brick', () => {
+  const state = createState(5);
+  const brick = state.bricks[0];
+  
+  // For a ball to tunnel, it must be above in one frame and below in the next
+  // without ever being "inside" during the frame() check.
+  // This requires simulating the step.
+  
+  // Current implementation is discrete. Let's prove it.
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 10; // Above
+  state.ball.vy = 1000;
+  
+  // Simulate a step (manual because step is in neon.js)
+  const dt = 0.05;
+  state.ball.y += state.ball.vy * dt; // 1000 * 0.05 = 50. y becomes brick.y + 40.
+  
+  // Now ball.y = brick.y + 40.
+  // Ball top = 40 - 7 = 33.
+  // Brick bottom = brick.y + 20.
+  // 33 > 20. The ball is completely below the brick.
+  
+  frame(ctx, state);
+  
+  // If the ball tunneled, it's still moving down.
+  assert.strictEqual(state.ball.vy, 1000, 'Ball tunneled through the brick');
+});
