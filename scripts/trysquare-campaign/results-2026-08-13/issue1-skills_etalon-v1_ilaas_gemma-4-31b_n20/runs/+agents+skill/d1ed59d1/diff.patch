 }
 
+// Resolves collisions between the ball and all alive bricks.
+// Returns the number of bricks broken in this call.
+export function resolveBricks(state) {
+  let brokenCount = 0;
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+
+    if (collides(state.ball, brick)) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+      brokenCount++;
+
+      const dx = state.ball.x - (brick.x + brick.w / 2);
+      const dy = state.ball.y - (brick.y + brick.h / 2);
+      const px = (brick.w / 2) + state.ball.r - Math.abs(dx);
+      const py = (brick.h / 2) + state.ball.r - Math.abs(dy);
+
+      if (px < py) {
+        if ((dx > 0 && state.ball.vx < 0) || (dx < 0 && state.ball.vx > 0)) {
+          state.ball.vx *= -1;
+        }
+        state.ball.x += (dx > 0 ? 1 : -1) * px;
+      } else {
+        if ((dy > 0 && state.ball.vy < 0) || (dy < 0 && state.ball.vy > 0)) {
+          state.ball.vy *= -1;
+        }
+        state.ball.y += (dy > 0 ? 1 : -1) * py;
+      }
+    }
+  }
+  return brokenCount;
+}
+
