@@ -0,0 +1,141 @@
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { frame, createState, ballSpeed } from '../game/neon.js';
+
+function createMockCtx() {
+  return {
+    fillStyle: '',
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {}
+  };
+}
+
+test('D1: Missing Deflection - Ball should bounce off brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 5;
+  state.ball.vx = 0;
+  state.ball.vy = 100;
+  state.ball.r = 7;
+
+  frame(createMockCtx(), state);
+
+  assert.ok(!brick.alive, 'Brick should be destroyed');
+  assert.ok(state.ball.vy < 0, 'Ball should bounce back up');
+});
+
+test('D2: Sticky Collision - Ball should not get stuck in brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  // Position ball slightly overlapping the brick
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 2;
+  state.ball.vx = 0;
+  state.ball.vy = 10;
+  state.ball.r = 7;
+
+  // First frame: collision detected, vy flipped
+  frame(createMockCtx(), state);
+  const vyAfterFirst = state.ball.vy;
+
+  // Simulate another frame where the ball is still overlapping
+  // In a real game, step() would happen, but we are testing the resolution
+  // If the resolution doesn't push the ball out, it will collide again.
+  // We manually ensure it's still colliding.
+  state.ball.y = brick.y - 2;
+
+  // If we just flip vy, it'll flip back to positive here
+  frame(createMockCtx(), state);
+
+  assert.ok(state.ball.vy < 0, 'Ball should still be moving up after resolution, not stuck');
+});
+
+test('D3: Tunneling - Ball should not pass through bricks at high speed', () => {
+  const level = 6;
+  const state = createState(level);
+  const brick = state.bricks[0];
+
+  // Calculate a position and velocity that causes tunneling
+  // ballSpeed(6) = 710. dt = 0.05. jump = 35.5.
+  // Brick is at BRICK_TOP = 48, BRICK_H = 20. Range [48, 68].
+  // Ball r = 7.
+  // Frame N: y = 35. Bottom = 42. (No collision with 48)
+  // Frame N+1: y = 35 + 35.5 = 70.5. Top = 63.5. (Collision? 63.5 < 68 and 70.5 > 48)
+  // Wait, my previous calculation said it could tunnel.
+  // If y = 30. Bottom = 37. (No)
+  // Frame N+1: y = 30 + 35.5 = 65.5. Top = 58.5. (Collision)
+  // To tunnel, we need the ball to be completely past the brick.
+  // Top > 68.
+  // y - 7 > 68 => y > 75.
+  // If y_N = 39. Bottom = 46. (No collision)
+  // y_{N+1} = 39 + 35.5 = 74.5. Top = 67.5. (Still overlaps 68)
+  // If y_N = 40. Bottom = 47. (No collision)
+  // y_{N+1} = 40 + 35.5 = 75.5. Top = 68.5. (Tunnelled!)
+
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = 40;
+  state.ball.vy = ballSpeed(level); // we assume dt = 1 for this test as we are simulating the jump
+
+  // We simulate one "frame" of movement and then the collision check.
+  // The logic in frame() only checks current position.
+  // To test tunneling, we'd need the ball to be at y=75.5.
+  state.ball.y = 75.5;
+
+  // In a correct implementation (Swept AABB), this would have been detected.
+  // In the current one, it's not.
+  frame(createMockCtx(), state);
+
+  assert.ok(!brick.alive, 'Brick should be destroyed even if ball tunneled');
+});
+
+test('D4: Ghost Collision - Ball should not pass through two bricks', () => {
+  const state = createState(1);
+  const brick1 = state.bricks[0];
+  const brick2 = state.bricks[1]; // Adjacent brick
+
+  // Position ball to overlap both bricks horizontally
+  state.ball.x = brick1.x + brick1.w + 4; // in the gap
+  state.ball.y = brick1.y + brick1.h / 2;
+  state.ball.vx = 100;
+  state.ball.vy = 0;
+  state.ball.r = 7;
+
+  // Both bricks are alive
+  brick1.alive = true;
+  brick2.alive = true;
+
+  frame(createMockCtx(), state);
+
+  // If it just flips vx twice, vx will be positive again.
+  assert.ok(state.ball.vx < 0, 'Ball should bounce back after hitting the seam');
+});
+
+test('D5: Corner Resolution - Ball should flip both axes on corner hit', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+
+  // Position ball to hit the top-right corner of the brick
+  // Brick: [x, x+w] [y, y+h]
+  state.ball.x = brick.x + brick.w + 3;
+  state.ball.y = brick.y - 3;
+  state.ball.vx = -100;
+  state.ball.vy = 100;
+  state.ball.r = 7;
+
+  // Check collision:
+  // x+r = brick.x + brick.w + 10 > brick.x (True)
+  // x-r = brick.x + brick.w - 4 < brick.x + brick.w (True)
+  // y+r = brick.y + 4 > brick.y (True)
+  // y-r = brick.y - 10 < brick.y + brick.h (True)
+  // Collides!
+
+  frame(createMockCtx(), state);
+
+  assert.ok(state.ball.vx > 0, 'VX should be flipped');
+  assert.ok(state.ball.vy < 0, 'VY should be flipped');
+});
