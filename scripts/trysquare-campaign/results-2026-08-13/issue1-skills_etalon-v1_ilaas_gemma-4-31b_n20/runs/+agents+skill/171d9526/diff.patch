+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { frame, createState } from '../game/neon.js';
+
+test('D1: Brick collision should deflect ball', () => {
+  const state = createState(1);
+  // Position ball to collide with the first brick
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 5; // Just above the brick
+  state.ball.vx = 0;
+  state.ball.vy = 100; // Moving down into the brick
+  state.ball.r = 7;
+
+  const ctx = {
+    fillStyle: '',
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {}
+  };
+
+  frame(ctx, state);
+
+  assert.ok(!brick.alive, 'Brick should be destroyed');
+  assert.ok(state.ball.vy < 0, 'Ball should bounce back up');
+});
