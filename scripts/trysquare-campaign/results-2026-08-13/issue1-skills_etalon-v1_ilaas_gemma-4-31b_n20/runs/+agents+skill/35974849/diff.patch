+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { frame, createState, step } from '../game/neon.js';
+
+const mockCtx = {
+  fillStyle: '',
+  fillRect: () => {},
+  arc: () => {},
+  fill: () => {},
+  fillText: () => {},
+  beginPath: () => {},
+};
+
+test('D5: Tunneling at high speed', () => {
+  const state = createState(5); // Speed = 620
+  const brick = state.bricks[0];
+  
+  // Place ball just above the brick
+  state.ball = { 
+    x: brick.x + brick.w / 2, 
+    y: brick.y - 1, 
+    r: 7, 
+    vx: 0, 
+    vy: 620 
+  };
+  
+  // Move the ball by one max-dt step
+  step(state, 0.05); 
+  // ball.y = BRICK_TOP - 1 + 31 = BRICK_TOP + 30
+  // brick.y + brick.h = BRICK_TOP + 20
+  // ball.y - ball.r = BRICK_TOP + 23 > brick.y + brick.h
+  
+  frame(mockCtx, state);
+  
+  assert.ok(!brick.alive, 'Ball should have hit the brick even at high speed');
+});
