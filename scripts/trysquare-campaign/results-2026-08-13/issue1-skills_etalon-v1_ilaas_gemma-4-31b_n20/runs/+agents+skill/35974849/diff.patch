+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { frame, createState, makeBricks } from '../game/neon.js';
+
+const mockCtx = {
+  fillStyle: '',
+  fillRect: () => {},
+  arc: () => {},
+  fill: () => {},
+  fillText: () => {},
+  beginPath: () => {},
+};
+
+test('D4: Double inversion at seam (Ghost collision)', () => {
+  const state = createState(1);
+  // Place ball exactly on the seam between brick 0 and brick 1
+  const b0 = state.bricks[0];
+  const b1 = state.bricks[1];
+  
+  // Ball is overlapping both b0 and b1 horizontally
+  state.ball = { 
+    x: b0.x + b0.w, // exactly on the line
+    y: b0.y + b0.h / 2, 
+    r: 7, 
+    vx: 100, 
+    vy: 0 
+  };
+  
+  frame(mockCtx, state);
