+// --- Brick collision (issue #1: the ball used to plow straight through) ----
+
+const UP = -1;
+const DOWN = 1;
+const LEFT = -1;
+const RIGHT = 1;
+
+// Picks the brick at (row, col) of the level grid.
+function brickAt(state, row, col) {
+  return state.bricks[row * BRICK_COLS + col];
+}
+
+// Keeps a single brick alive, isolates a scenario from the rest of the grid.
+function only(brick, state) {
+  state.bricks.forEach((b) => {
+    if (b !== brick) b.alive = false;
+  });
+  return brick;
+}
+
+test('D1: ball bouncing off the bottom face of a brick ends outside, moving down', () => {
+  const state = createState(1);
+  const brick = only(brickAt(state, 0, 3), state); // x 244..316, y 48..68
+  state.ball = {
+    x: brick.x + brick.w / 2,
+    y: brick.y + brick.h + BALL_R + 4,
+    r: BALL_R,
+    vx: 0,
+    vy: -260,
