+// --- Brick collision (swept AABB, continuous detection) ---------------------
+
+// Time-of-impact epsilon: the ball is parked this many seconds of the step
+// BEFORE the contact, so it never rests inside a brick (no "sticky" ball).
+const TOI_EPS = 1e-8;
+
+// Sweeps the ball (box of half-size `r`) from (x0, y0) to its current
+// position against the inflated rect of `brick` (the brick grown by `r` on
+// every side — the box approximation makes the ball a point in that space).
+//
+// Returns the first contact along the path as { t, face } where `face` is
+// 'x', 'y' or 'corner' (equal penetration on both axes → both flip), or null
+// when the path never touches the brick. `t` is the fraction of the step at
+// which the contact happens (0..1).
+function sweptContact(ball, x0, y0, brick) {
+  const dx = ball.x - x0;
+  const dy = ball.y - y0;
+
+  const l = brick.x - ball.r;
+  const r = brick.x + brick.w + ball.r;
+  const t = brick.y - ball.r;
+  const b = brick.y + brick.h + ball.r;
+
+  // Entry/exit fraction per axis; -Infinity/+Infinity when already inside.
+  let nearX, farX;
+  if (dx === 0) {
+    if (x0 <= l || x0 >= r) return null; // never overlaps on x
+    nearX = -Infinity;
+    farX = Infinity;
+  } else {
+    let t1 = (l - x0) / dx;
+    let t2 = (r - x0) / dx;
+    if (t1 > t2) [t1, t2] = [t2, t1];
+    nearX = t1;
+    farX = t2;
+  }
+
+  let nearY, farY;
+  if (dy === 0) {
+    if (y0 <= t || y0 >= b) return null; // never overlaps on y
+    nearY = -Infinity;
+    farY = Infinity;
+  } else {
+    let t1 = (t - y0) / dy;
+    let t2 = (b - y0) / dy;
+    if (t1 > t2) [t1, t2] = [t2, t1];
+    nearY = t1;
+    farY = t2;
+  }
+
+  const near = Math.max(nearX, nearY);
+  const far = Math.min(farX, farY);
+  if (near > far || near >= 1 || far <= 0) return null;
+
+  let face;
+  if (Math.abs(nearX - nearY) <= TOI_EPS) face = 'corner';
+  else if (nearX > nearY) face = 'x';
+  else face = 'y';
+
+  return { t: Math.max(near, 0), face };
+}
