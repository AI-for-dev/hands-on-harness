+  step(state, 1 / 60); // 4.33px step: the ball ends 0.33px inside the brick
+  assert.equal(brick.alive, false, 'the hit brick must die');
+  assert.equal(Math.sign(state.ball.vy), DOWN, 'the ball must come back down');
+  assert.ok(
+    state.ball.y - state.ball.r >= brick.y + brick.h - 1e-6,
+    'the ball must be outside, below the brick',
