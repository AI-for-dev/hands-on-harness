+// Smallest |hit| a paddle rebound may produce. Without this guard, a contact
+// at the exact center (hit = 0) zeroes vx and traps the ball in a vertical
+// loop that never reaches the rest of the grid.
+const PADDLE_MIN_HIT = 0.15;
+
+// Reflects the ball off the paddle's top surface at horizontal position
+// `hitX`. The rebound angle follows the classic breakout mapping (hit ∈
+// [-1, 1] → horizontal deflection) but both components are recomputed from
+// the level speed, so a rebound always leaves the paddle at ballSpeed(level).
+function reflectOffPaddle(state, hitX) {
+  const { ball, paddle } = state;
+  const speed = ballSpeed(state.level);
+  let hit = (hitX - (paddle.x + paddle.w / 2)) / (paddle.w / 2);
+  hit = Math.max(-1, Math.min(1, hit));
