+// --- Brick collision (swept) -----------------------------------------------
+
+// Rounding tolerance for face comparisons (corner tie detection).
+const EPS = 1e-9;
+
+// Entry/exit times of the point `p` moving with velocity `v` against the
+// interval [lo, hi], over t ∈ [0, 1]. Returns null when the point can never
+// overlap the interval on this axis (parallel and outside).
+function slab(p, v, lo, hi) {
+  if (v === 0) {
+    if (p > lo && p < hi) return { tmin: -Infinity, tmax: Infinity };
+    return null;
+  }
+  const t1 = (lo - p) / v;
+  const t2 = (hi - p) / v;
+  return { tmin: Math.min(t1, t2), tmax: Math.max(t1, t2) };
+}
+
+// Swept circle-vs-brick collision, resolved on the segment the ball travelled
+// this frame: (ball.px, ball.py) → (ball.x, ball.y). In the ball's center
+// space the brick becomes an AABB expanded by ball.r on all four sides, and
+// "the ball touches the brick" becomes "the center reaches the expanded box
+// boundary". Returns true when the ball really bounced off this brick (the
+// caller breaks the brick and scores); a mere push-out of a leftover overlap
+// returns false.
+//
+// Two cases:
+//   1. The segment enters the expanded box mid-flight (tEnter >= 0): the hit
+//      face is the axis whose slab was entered last; a tie is a corner and
+//      flips BOTH axes. The ball is placed on the face and ball.px/py are
+//      moved to that point, so a seam neighbour cannot re-reflect the same
+//      crossing (one bounce per pass per axis).
+//   2. The segment starts inside the expanded box (leftover overlap): push
+//      the center out to the nearest face (minimum translation) and reflect
+//      only the axes whose velocity still points INTO the box; a ball already
+//      leaving is pushed out without reflecting (no vibration, no seam
+//      double-flip).
+export function bounceOnBrick(ball, brick) {
+  const xmin = brick.x - ball.r;
+  const xmax = brick.x + brick.w + ball.r;
+  const ymin = brick.y - ball.r;
+  const ymax = brick.y + brick.h + ball.r;
+
+  const px = ball.px ?? ball.x;
+  const py = ball.py ?? ball.y;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+
+  const sx = slab(px, dx, xmin, xmax);
+  const sy = slab(py, dy, ymin, ymax);
+  if (!sx || !sy) return false;
+
+  const tEnter = Math.max(sx.tmin, sy.tmin);
+  const tExit = Math.min(sx.tmax, sy.tmax);
+  if (tEnter > tExit || tExit < 0 || tEnter > 1) return false;
+
+  if (tEnter >= 0) {
+    // Case 1: the center entered the expanded box during this step.
+    ball.x = px + dx * tEnter;
+    ball.y = py + dy * tEnter;
+    if (Math.abs(sx.tmin - sy.tmin) <= EPS) {
+      ball.vx = -ball.vx;
+      ball.vy = -ball.vy;
+    } else if (sx.tmin > sy.tmin) {
+      ball.vx = -ball.vx; // vertical face (left or right)
+    } else {
+      ball.vy = -ball.vy; // horizontal face (top or bottom)
+    }
+    ball.px = ball.x;
+    ball.py = ball.y;
+    return true;
+  }
+
+  // Case 2: leftover overlap — push the center to the nearest expanded face.
+  const dL = ball.x - xmin;
+  const dR = xmax - ball.x;
+  const dT = ball.y - ymin;
+  const dB = ymax - ball.y;
+  const dMin = Math.min(dL, dR, dT, dB);
+  const xFace = dL === dMin || dR === dMin;
+  const yFace = dT === dMin || dB === dMin;
+
+  let bounced = false;
+  if (xFace) {
+    const left = dL === dMin; // nearest face is the left one → push left
+    ball.x = left ? xmin : xmax;
+    const movingIn = left ? ball.vx > 0 : ball.vx < 0;
+    if (movingIn) {
+      ball.vx = -ball.vx;
+      bounced = true;
+    }
+  }
+  if (yFace) {
+    const top = dT === dMin; // nearest face is the top one → push up
+    ball.y = top ? ymin : ymax;
+    const movingIn = top ? ball.vy > 0 : ball.vy < 0;
+    if (movingIn) {
+      ball.vy = -ball.vy;
+      bounced = true;
+    }
+  }
+  return bounced;
+}
