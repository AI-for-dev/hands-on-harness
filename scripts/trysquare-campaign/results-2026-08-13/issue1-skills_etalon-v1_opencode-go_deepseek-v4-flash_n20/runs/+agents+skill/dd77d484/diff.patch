+// True if the ball's travel segment from (px, py) to its current position
+// crosses the brick grown by the ball's radius (swept AABB, slab method).
+// Returns whether the segment enters the expanded rectangle before its end.
+function sweptCrosses(ball, px, py, brick) {
+  const x0 = brick.x - ball.r;
+  const x1 = brick.x + brick.w + ball.r;
+  const y0 = brick.y - ball.r;
+  const y1 = brick.y + brick.h + ball.r;
+  let tEnter = 0;
+  let tExit = 1;
+  const slabs = [
+    [px, ball.x, x0, x1],
+    [py, ball.y, y0, y1],
+  ];
+  for (const [start, end, lo, hi] of slabs) {
+    const delta = end - start;
+    if (delta === 0) {
+      if (start < lo || start > hi) return false; // parallel and outside
+    } else {
+      let t1 = (lo - start) / delta;
+      let t2 = (hi - start) / delta;
+      if (t1 > t2) [t1, t2] = [t2, t1];
+      tEnter = Math.max(tEnter, t1);
+      tExit = Math.min(tExit, t2);
+      if (tEnter > tExit || tExit < 0) return false;
+    }
+  }
+  return tEnter < 1;
+}
