+// probe.test.js — playtest sonde (step 3 of the playtest skill).
+// Red on today's code. Will be moved into game/neon.test.js during TDD.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { step, createState, collides, BALL_R } from '../game/neon.js';
+
+const DT_CAP = 0.05;
+
+test('D1 — bottom face hit bounces the ball back out below the brick', () => {
+  const state = createState(1);
+  const brick = state.bricks.find((b) => b.row === 0 && b.col === 0);
+  state.ball = { x: 40, y: 75, r: BALL_R, vx: 0, vy: -300 }; // just below row 0, moving up
+  step(state, 1 / 300); // 1 px step: ball box [67,81] overlaps the brick by 1 px
+
+  assert.ok(state.ball.vy > 0, `vy should flip up->down, got ${state.ball.vy}`);
+  assert.ok(state.ball.y - state.ball.r >= brick.y + brick.h, 'ball must be pushed back out below the brick');
+  assert.equal(brick.alive, false, 'the hit brick must be destroyed');
+  assert.equal(state.ball.x, 40, 'x unchanged on a vertical hit');
+});
+
+test('D2 — right face diagonal hit flips vx only and exits on the right', () => {
+  const state = createState(1);
+  const brick = state.bricks.find((b) => b.row === 0 && b.col === 1); // x=84..156
+  state.ball = { x: 167, y: 58, r: BALL_R, vx: -300, vy: -100 }; // right of the brick, moving left-up
+  step(state, 1 / 60); // ball box [155,169]x[49.3,63.3], 1 px penetration on x
+
+  assert.ok(state.ball.vx > 0, `vx should flip right->left, got ${state.ball.vx}`);
+  assert.equal(state.ball.vy, -100, 'vy must stay unchanged on a side hit');
+  assert.ok(state.ball.x - state.ball.r >= brick.x + brick.w, 'ball must be pushed back out on the right');
+  assert.equal(brick.alive, false, 'the hit brick must be destroyed');
+});
+
+test('D2b — equal penetration on both axes (corner) flips both velocities', () => {
+  const state = createState(1);
+  const brick = state.bricks.find((b) => b.row === 0 && b.col === 1);
+  state.ball = { x: 89, y: 53, r: BALL_R, vx: 300, vy: 300 }; // box [82,96]x[46,60], 12 px penetration on both axes
+  step(state, DT_CAP);
+
+  assert.ok(state.ball.vx < 0, `vx should flip right->left, got ${state.ball.vx}`);
+  assert.ok(state.ball.vy < 0, `vy should flip down->up, got ${state.ball.vy}`);
+  assert.equal(collides(state.ball, brick), false, 'ball must be pushed out of the brick');
+});
+
+test('D3 — deep entry: resolved out below and never re-collides next frame', () => {
+  const state = createState(1);
+  const brick = state.bricks.find((b) => b.row === 0 && b.col === 0);
+  state.ball = { x: 40, y: 75, r: BALL_R, vx: 0, vy: -220 };
+  step(state, DT_CAP); // 11 px step: ball box [57,71], 11 px penetration
+
+  assert.ok(state.ball.vy > 0, `pass 1: vy should flip, got ${state.ball.vy}`);
+  assert.ok(state.ball.y - state.ball.r >= brick.y + brick.h, 'pass 1: ball must exit below the brick');
+  assert.equal(collides(state.ball, brick), false, 'pass 1: ball must not overlap the brick');
+
+  step(state, DT_CAP); // next frame, ball flying down away from the brick
+  assert.equal(state.ball.vy, 220, 'pass 2: no ghost re-flip');
+  assert.equal(collides(state.ball, brick), false, 'pass 2: still no overlap');
+});
+
+test('D4 — seam between two bricks: one bounce per axis, both bricks destroyed', () => {
+  const state = createState(1);
+  const b0 = state.bricks.find((b) => b.row === 0 && b.col === 0);
+  const b1 = state.bricks.find((b) => b.row === 0 && b.col === 1);
+  state.ball = { x: 80, y: 75.5, r: BALL_R, vx: 0, vy: -390 }; // box straddles the 8 px gap, moving up
+  step(state, DT_CAP); // 19.5 px step: box [73,87]x[49,63] overlaps both bricks
+
+  assert.ok(state.ball.vy > 0, `vy must flip exactly once (two flips would cancel), got ${state.ball.vy}`);
+  assert.ok(state.ball.y - state.ball.r >= b0.y + b0.h, 'ball must exit below both bricks');
+  assert.equal(b0.alive, false, 'left brick destroyed');
+  assert.equal(b1.alive, false, 'right brick destroyed');
+  assert.equal(collides(state.ball, b0), false, 'no overlap with the left brick');
+  assert.equal(collides(state.ball, b1), false, 'no overlap with the right brick');
+});
+
+test('D5 — tunneling: a 35.5 px step (level 6 @ 50 ms) must still bounce off the brick', () => {
+  const state = createState(6); // ballSpeed(6) = 710
+  const brick = state.bricks.find((b) => b.row === 0 && b.col === 0);
+  state.ball = { x: 40, y: 40, r: BALL_R, vx: 0, vy: 710 }; // box [33,47] just above the brick
+  step(state, DT_CAP); // 35.5 px step: box [68.5,82.5] ends BELOW the brick — no discrete overlap
+
+  assert.ok(state.ball.vy < 0, `vy should flip down->up, got ${state.ball.vy}`);
+  assert.equal(state.ball.y + state.ball.r, brick.y, 'ball must be repositioned exactly above the brick face');
+  assert.equal(brick.alive, false, 'the crossed brick must be destroyed');
+});
+
+test('D6a — paddle full crossing at 31 px (level 5 @ 50 ms) still bounces', () => {
+  const state = createState(5); // ballSpeed(5) = 620
+  const paddle = state.paddle;
+  state.ball = { x: 320, y: 440.9, r: BALL_R, vx: 0, vy: 620 }; // bottom at 447.9, above the paddle
+  const lost = step(state, DT_CAP); // 31 px step: bottom 478.9, box [464.9,478.9] clear of the paddle
+
+  assert.equal(lost, false, 'ball must not be lost through the paddle');
+  assert.ok(state.ball.vy < 0, `vy should flip down->up, got ${state.ball.vy}`);
+  assert.equal(state.ball.y + state.ball.r, paddle.y, 'ball must exit through the top of the paddle');
+});
+
+test('D6b — paddle point-slab skip at 13 px (level 1 @ 50 ms) still bounces', () => {
+  const state = createState(1); // ballSpeed(1) = 260
+  const paddle = state.paddle;
+  state.ball = { x: 320, y: 440.5, r: BALL_R, vx: 0, vy: 260 }; // bottom at 447.5
+  step(state, DT_CAP); // 13 px step: bottom 460.5 > 460 — the point test skips the slab
+
+  assert.ok(state.ball.vy < 0, `vy should flip down->up, got ${state.ball.vy}`);
+  assert.equal(state.ball.y + state.ball.r, paddle.y, 'ball must exit through the top of the paddle');
+});
