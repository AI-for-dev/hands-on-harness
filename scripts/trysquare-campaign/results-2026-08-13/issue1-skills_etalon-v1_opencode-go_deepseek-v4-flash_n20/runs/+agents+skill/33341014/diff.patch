+    const { brick, penX, penY } = stuck;
+    const leftPen = px + r - brick.x;
+    const rightPen = brick.x + brick.w - (px - r);
+    const topPen = py + r - brick.y;
+    const bottomPen = brick.y + brick.h - (py - r);
+    if (penX < penY) nx = leftPen <= rightPen ? LEFT : RIGHT;
+    else if (penY < penX) ny = topPen <= bottomPen ? UP : DOWN;
