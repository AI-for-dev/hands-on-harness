+    } else {
+      entryX = Math.min((xmin - prev.x) / dx, (xmax - prev.x) / dx);
+      exitX = Math.max((xmin - prev.x) / dx, (xmax - prev.x) / dx);
+    }
+    let entryY = 0;
+    let exitY = Infinity;
+    if (dy === 0) {
+      if (prev.y <= ymin || prev.y >= ymax) continue;
+    } else {
