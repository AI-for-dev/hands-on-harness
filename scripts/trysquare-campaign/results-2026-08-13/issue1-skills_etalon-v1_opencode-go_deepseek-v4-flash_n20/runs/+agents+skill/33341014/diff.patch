+  // Bounce: reflect the face axis (or both, on a corner), then push the ball
+  // out of the rectangle — past the face for a swept contact, back to the
+  // nearest face for an overlap.
+  let nx = hit.nx ?? 0;
+  let ny = hit.ny ?? 0;
+  let bx = px;
