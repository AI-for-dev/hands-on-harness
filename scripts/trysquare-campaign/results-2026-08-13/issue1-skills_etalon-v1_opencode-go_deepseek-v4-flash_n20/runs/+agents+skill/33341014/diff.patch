+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    const xmin = brick.x - r;
+    const xmax = brick.x + brick.w + r;
+    const ymin = brick.y - r;
+    const ymax = brick.y + brick.h + r;
+
