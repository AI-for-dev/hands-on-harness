+// Returns the number of bricks broken (0 if none).
+export function resolveBricks(state, prev) {
+  const { ball, bricks } = state;
+  const r = ball.r;
+  const dx = ball.x - prev.x;
+  const dy = ball.y - prev.y;
+
+  let contact = null; // earliest swept contact
+  let stuck = null; // brick overlapped at the start of the step
