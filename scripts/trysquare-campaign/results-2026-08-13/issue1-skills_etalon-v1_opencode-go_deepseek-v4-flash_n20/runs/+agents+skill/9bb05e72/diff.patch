+// --- Brick collision tests (see .scratch/to_fix.md, D1–D5) -----------------
+
+// The grid is row-major: brick at (row, col) of the level.
+const brick = (s, row, col) => s.bricks[row * BRICK_COLS + col];
+
+// D1 — the primary defect: bricks never bounce the ball (frame() destroyed
+// them without deflecting it). A slow head-on descent must bounce, push the
+// ball out, and break the brick — all from step(), pure logic.
+test('D1: ball bounces off a brick top face (level 1, head-on)', () => {
+  const s = createState(1);
+  s.ball = { x: 40, y: 40, r: 7, vx: 0, vy: 260 }; // bottom edge 47, 1px above row 0
+  const lost = step(s, 1 / 60);
+  assert.equal(lost, false);
+  assert.equal(s.ball.vy, -260, 'vy must flip (bounce)');
+  assert.equal(s.ball.y, 41, 'ball pushed out to brick.y - r');
+  assert.equal(brick(s, 0, 0).alive, false, 'brick destroyed');
+  assert.equal(s.combo, 1);
+  assert.equal(s.score, 75, 'row0 points 50 * combo 1.5');
+  assert.equal(collides(s.ball, brick(s, 0, 0)), false, 'ball no longer overlaps');
+});
+
+// D2 — tunneling: at high speed a single step is longer than (brick + ball)
+// and jumps over the brick without ever overlapping it. The resolution must
+// sweep the travelled segment, not test the arrival position only.
