+  // The slab entered LAST is the plane the ball crossed into the box.
+  if (tInX > tInY + EPS) face = dx > 0 ? 'left' : 'right';
+  else if (tInY > tInX + EPS) face = dy > 0 ? 'top' : 'bottom';
+  else face = 'corner';
+  return { t: Math.max(0, tIn), face, inside: tIn < 0 };
