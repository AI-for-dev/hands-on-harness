+// Slab method for a swept AABB: sweeps the ball (a box inflated by its radius)
+// along the segment (x0,y0) -> (x1,y1) against `brick`. Returns the entry time
+// `t` (0..1), the face crossed at entry, and whether the sweep STARTED inside
+// the box (defensive — unreachable once every bounce pushes the ball out).
+// The face is the slab entered LAST: that is the plane the ball actually
+// crossed into the box. Equal entry times = the corner (both axes at once).
+const EPS = 1e-9;
+
+function sweepBall(brick, x0, y0, x1, y1, r) {
+  const minX = brick.x - r;
+  const maxX = brick.x + brick.w + r;
+  const minY = brick.y - r;
+  const maxY = brick.y + brick.h + r;
+  const dx = x1 - x0;
+  const dy = y1 - y0;
+
+  let tInX = -Infinity;
+  let tOutX = Infinity;
+  if (Math.abs(dx) < EPS) {
+    if (x0 <= minX || x0 >= maxX) return null; // parallel, outside the slab
+  } else {
+    tInX = (minX - x0) / dx;
+    tOutX = (maxX - x0) / dx;
+    if (tInX > tOutX) [tInX, tOutX] = [tOutX, tInX];
+  }
+  let tInY = -Infinity;
+  let tOutY = Infinity;
+  if (Math.abs(dy) < EPS) {
+    if (y0 <= minY || y0 >= maxY) return null;
+  } else {
+    tInY = (minY - y0) / dy;
+    tOutY = (maxY - y0) / dy;
+    if (tInY > tOutY) [tInY, tOutY] = [tOutY, tInY];
+  }
+
+  const tIn = Math.max(tInX, tInY);
+  const tOut = Math.min(tOutX, tOutY);
+  // Miss: never inside the box on the segment, box fully behind, or box
+  // beyond the end of the segment. `tOut <= 0` also rejects the degenerate
+  // tangent-at-start case (ball pushed out last frame, moving away).
+  if (tIn > tOut || tOut <= 0 || tIn > 1) return null;
+
