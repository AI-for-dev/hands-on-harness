+// --- Brick bounce (D1-D5) --------------------------------------------------
+// D1: the ball MUST be deflected when it hits a brick (today it plows through).
+// Bricks carry no `col`; locate them by row and x. Col 3 -> x = 4 + 3*80 = 244,
+// row 0 -> y = 48, row 2 -> y = 104 (see makeBricks).
+
+const brickAt = (state, row, x) => state.bricks.find((b) => b.row === row && b.x === x);
+
+test('D1: top-face hit bounces the ball up, kills the brick', () => {
+  const state = createState(1);
+  const brick = brickAt(state, 0, 244);
+  state.ball = { px: 244, py: 35, x: 244, y: 45, r: 7, vx: 0, vy: 200 };
+  bounceBricks(state);
+  assert.equal(brick.alive, false);
+  assert.ok(state.ball.vy < 0, `vy must point up after a top-face bounce, got ${state.ball.vy}`);
+  assert.equal(state.ball.y, 41); // brick.y - BALL_R = 48 - 7
+});
+
+test('D2: after resolution the ball is outside the brick (no stick)', () => {
+  const state = createState(1);
