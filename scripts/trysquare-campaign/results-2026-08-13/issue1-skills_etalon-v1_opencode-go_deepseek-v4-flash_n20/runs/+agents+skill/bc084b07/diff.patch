+// Resolves a single ball/brick overlap: picks the axis of smallest
+// penetration (both axes when the penetrations are equal — a corner), flips
+// the matching velocity component and pushes the ball out until its edge is
+// tangent to the brick face. Returns the ball, guaranteed to no longer
+// overlap the brick.
+//
+// Sign convention (Y grows downward): the ball is ABOVE the brick when
+// ball.y < brick.y and hits the TOP face, so a downward vy flips upward;
+// the ball is to the LEFT when ball.x < brick.x and hits the LEFT face, so
+// a rightward vx flips leftward.
+export function resolveBrickCollision(ball, brick) {
+  const overlapX = Math.min(
+    ball.x + ball.r - brick.x,
+    brick.x + brick.w - (ball.x - ball.r)
+  );
+  const overlapY = Math.min(
+    ball.y + ball.r - brick.y,
+    brick.y + brick.h - (ball.y - ball.r)
+  );
+  if (overlapX <= 0 || overlapY <= 0) return ball; // no overlap
+
+  const hitLeft = ball.x < brick.x;
+  const hitTop = ball.y < brick.y;
+
+  if (overlapX < overlapY) {
+    // side hit: horizontal axis
+    ball.vx = hitLeft ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+    ball.x += hitLeft ? -overlapX : overlapX;
+  } else if (overlapY < overlapX) {
+    // top/bottom hit: vertical axis
+    ball.vy = hitTop ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+    ball.y += hitTop ? -overlapY : overlapY;
+  } else {
+    // corner: equal penetration on both axes — flip both
+    ball.vx = hitLeft ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+    ball.vy = hitTop ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+    ball.x += hitLeft ? -overlapX : overlapX;
+    ball.y += hitTop ? -overlapY : overlapY;
+  }
+  return ball;
+}
+
+// One collision pass over the grid: every brick overlapped by the ball dies,
+// but the ball bounces at most ONCE per pass (off the first overlapped brick
+// in grid order). A seam overlap therefore cannot flip the same axis twice
+// (two `vy = -vy` would cancel and the ball would plow through). Returns the
+// killed bricks in grid order.
+export function bounceOffBricks(ball, bricks) {
+  const killed = [];
+  let bounced = false;
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    if (collides(ball, brick)) {
+      brick.alive = false;
+      killed.push(brick);
+      if (!bounced) {
+        resolveBrickCollision(ball, brick);
+        bounced = true;
+      }
+    }
+  }
+  return killed;
+}
