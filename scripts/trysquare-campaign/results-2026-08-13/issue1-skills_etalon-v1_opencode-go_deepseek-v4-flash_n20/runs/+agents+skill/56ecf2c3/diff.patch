+// --- Brick & paddle collision regression tests (issue 1) --------------------
+//
+// The ball used to pass straight through bricks (no bounce at all). Each test
+// below targets one failure mode of the naive fixes: wrong face, no
+// repositioning, double flip on a grid seam, tunneling at high speed, paddle
+// corner / dead angle / speed drift / dt dependence.
+
+// Bottom row of the brick grid (row 4): y = 160..180.
+const ROW4 = { x: 4, y: 160, w: 72, h: 20 };
+// Right neighbour of ROW4 across the 8 px grid gap: x = 84..156.
+const ROW4B = { x: 84, y: 160, w: 72, h: 20 };
+// A middle brick (col 3, row 4): far from both walls, so a ball can approach
+// its left face from the left without the wall interfering.
+const ROW4M = { x: 244, y: 160, w: 72, h: 20 };
+
+// Builds a state whose ball and bricks are fully controlled (real paddle),
+// so `step` can be exercised without a DOM.
+function stateWith(ball, bricks, level = 1) {
+  const base = createState(level);
+  return {
+    ...base,
+    ball: { ...base.ball, ...ball },
+    bricks: bricks.map((b) => ({ ...b, row: 0, alive: true, points: 10 })),
+  };
+}
+
+test('D1: bottom-face hit bounces the ball and breaks the brick', () => {
+  const s = stateWith({ x: 40, y: 190, r: 7, vx: 0, vy: -ballSpeed(1) }, [ROW4]);
+  step(s, 1 / 60);
+  assert.equal(s.bricks[0].alive, false, 'brick must be destroyed');
+  assert.ok(s.ball.vy > 0, 'vy must flip from up to down');
+  assert.ok(s.ball.y - s.ball.r >= 180, 'ball must end below the brick');
+  assert.equal(collides(s.ball, s.bricks[0]), false, 'no overlap after resolution');
+});
+
+test('D2: side hit pushes the ball out of the brick (sticky)', () => {
+  const s = stateWith({ x: 230, y: 170, r: 7, vx: 600, vy: 0 }, [ROW4M]);
+  step(s, 1 / 60);
+  assert.ok(s.ball.vx < 0, 'horizontal velocity must flip');
+  assert.ok(s.ball.x + s.ball.r <= 244, 'ball must be left of the brick');
+  assert.equal(collides(s.ball, s.bricks[0]), false, 'no overlap after resolution');
+});
+
+test('D3: side hit flips the horizontal axis, not the vertical one', () => {
+  const s = stateWith({ x: 230, y: 170, r: 7, vx: 600, vy: 60 }, [ROW4M]);
+  step(s, 1 / 60);
+  assert.ok(s.ball.vx < 0, 'horizontal velocity must flip');
+  assert.ok(s.ball.vy > 0, 'vertical velocity must stay untouched');
+});
+
+test('D3 corner: equal entry time on both axes flips both', () => {
+  const s = stateWith({ x: 93, y: 93, r: 7, vx: 300, vy: 300 }, [{ x: 100, y: 100, w: 72, h: 20 }]);
+  step(s, 1 / 60);
+  assert.ok(s.ball.vx < 0 && s.ball.vy < 0, 'both components must flip on a corner hit');
+});
+
+test('D4: seam straddle — one bounce per pass, both bricks broken', () => {
+  const s = stateWith({ x: 80, y: 187, r: 7, vx: 0, vy: -ballSpeed(1) }, [ROW4, ROW4B]);
+  step(s, 1 / 60);
+  assert.equal(s.bricks[0].alive, false, 'left brick destroyed');
+  assert.equal(s.bricks[1].alive, false, 'right brick destroyed');
+  assert.ok(s.ball.vy > 0, 'exactly one vy flip (a double flip would cancel)');
+  assert.ok(s.ball.y - s.ball.r >= 180, 'ball must end below the row');
+  assert.ok(!s.bricks.some((b) => b.alive && collides(s.ball, b)), 'no live-brick overlap');
+});
+
+test('D5: no tunneling — level 6 ball jumps the brick in one 50 ms step and still bounces', () => {
+  const s = stateWith({ x: 40, y: 188, r: 7, vx: 0, vy: -ballSpeed(6) }, [ROW4], 6);
+  step(s, 0.05);
+  assert.ok(s.ball.vy > 0, 'the ball must bounce off the brick');
+  assert.ok(s.ball.y - s.ball.r >= 180, 'the ball must end below the brick');
+  assert.equal(s.bricks[0].alive, false);
+});
+
+test('D6: paddle edge — ball clipping the paddle corner still bounces', () => {
+  const s = stateWith({ x: 374, y: 439, r: 7, vx: 0, vy: ballSpeed(1) }, [], 1);
+  step(s, 1 / 60);
+  assert.ok(s.ball.vy < 0, 'the ball must bounce up off the paddle');
+  assert.ok(s.ball.y + s.ball.r <= PADDLE_Y, 'the ball must end above the paddle top');
+});
+
+test('D7: dead angle — a center paddle hit must not zero the horizontal velocity', () => {
+  const s = stateWith({ x: 320, y: 439, r: 7, vx: 0, vy: ballSpeed(1) }, [], 1);
+  step(s, 1 / 60);
+  assert.ok(Math.abs(s.ball.vx) >= ballSpeed(1) * 0.1, '|vx| must stay above the minimum');
+  assert.ok(s.ball.vy < 0, 'the ball must bounce up');
+});
+
+test('D8: speed — a paddle bounce preserves the level speed', () => {
+  const s = stateWith({ x: 344, y: 439, r: 7, vx: 0, vy: ballSpeed(1) }, [], 1);
+  step(s, 1 / 60);
+  const norm = Math.hypot(s.ball.vx, s.ball.vy);
+  assert.ok(Math.abs(norm - ballSpeed(1)) < 1e-9, `norm must be ${ballSpeed(1)}, got ${norm}`);
+  assert.ok(s.ball.vy < 0, 'the ball must bounce up');
+});
+
+test('D9: dt-independence — level-5 ball descending onto the paddle bounces at 60 fps and at the 50 ms cap', () => {
+  for (const dt of [1 / 60, 0.05]) {
+    const s = stateWith({ x: 320, y: 439, r: 7, vx: 0, vy: ballSpeed(5) }, [], 5);
+    step(s, dt);
+    assert.ok(s.ball.vy < 0, `must bounce at dt=${dt}`);
+  }
+});
+
