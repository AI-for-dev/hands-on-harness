 // TODO (#5): test comboMultiplier / scoreForBrick.
 // TODO      : test level progression and loadBest/saveBest persistence.
+
+// --- Brick bounce resolution (D1..D5 of .scratch/to_fix.md) ---------------
+// The ball plows straight through bricks: the resolver below must deflect it
+// per face (D1), sweep fast steps (D2), survive grid seams (D3), handle
+// exact corners (D4) and push the ball out of the rectangle (D5).
+
+test('D1: side hit flips vx, ball pushed out right', () => {
+  const state = {
+    bricks: makeBricks(1),
+    ball: { x: 80, y: 60, px: 80, py: 60, r: 7, vx: -260, vy: 0 },
+  };
+  const brick = state.bricks.find((b) => b.x === 4 && b.y === 48);
+  resolveBricks(state);
+  assert.equal(brick.alive, false);
+  assert.equal(state.ball.vx, 260, 'vx must flip to the right on a right-face hit');
+  assert.equal(state.ball.vy, 0, 'vy unchanged on a side hit');
+  assert.equal(state.ball.x, 83, 'ball pushed out of the brick (76 + 7)');
+});
+
+test('D2: a 35.5 px step at level 6 still bounces', () => {
+  const speed = 260 + 5 * 90; // ballSpeed(6) = 710 — first level where step > BRICK_H + 2*BALL_R = 34
+  const state = {
+    bricks: makeBricks(6),
+    ball: { x: 360, y: 188, px: 360, py: 188, r: 7, vx: 0, vy: -speed },
+  };
+  state.ball.y += state.ball.vy * 0.05; // 152.5 — no overlap at either end
+  const brick = state.bricks.find((b) => b.x === 324 && b.y === 160);
+  resolveBricks(state);
+  assert.equal(brick.alive, false, 'brick must be destroyed even if never overlapped at the end position');
+  assert.equal(state.ball.vy, 710, 'vy flipped back down');
+  assert.ok(state.ball.y >= 187, 'ball ends below the brick, not above it');
+});
+
+test('D3: seam overlap flips vy exactly once, both bricks die', () => {
+  // Climbing the seam between col 0 (x 4..76) and col 1 (x 84..156) from
+  // below the grid: the ball first touches the bottom faces of the two
+  // side-by-side row-4 bricks at the same instant.
+  const state = {
+    bricks: makeBricks(6),
+    ball: { x: 80, y: 188, px: 80, py: 188, r: 7, vx: 0, vy: -710 },
+  };
+  state.ball.y += state.ball.vy * 0.05; // 152.5
+  const b1 = state.bricks.find((b) => b.x === 4 && b.y === 160);
+  const b2 = state.bricks.find((b) => b.x === 84 && b.y === 160);
+  resolveBricks(state);
+  assert.equal(b1.alive, false, 'left seam brick dies');
+  assert.equal(b2.alive, false, 'right seam brick dies');
+  assert.equal(state.ball.vy, 710, 'vy flipped exactly once (two flips would cancel)');
+  assert.equal(state.ball.vx, 0, 'vx untouched');
+});
+
+test('D4: corner hit flips both vx and vy', () => {
+  const state = {
+    bricks: makeBricks(1),
+    ball: { x: 6, y: 50, px: 6, py: 50, r: 7, vx: -260, vy: -260 },
+  };
+  resolveBricks(state);
+  assert.equal(state.ball.vx, 260, 'corner flips vx too');
+  assert.equal(state.ball.vy, 260, 'corner flips vy');
+  assert.ok(state.ball.x + state.ball.r <= 4, 'ball out of the rectangle');
+  assert.ok(state.ball.y + state.ball.r <= 48, 'ball out of the rectangle');
+});
+
+test('D5: after resolution the ball is outside the brick', () => {
+  // Ball 15 px deep in the brick (4, 48, 72, 20) via its bottom face,
+  // moving up: it must be pushed back out below (y = 68 + 7 = 75).
+  const state = {
+    bricks: makeBricks(1),
+    ball: { x: 40, y: 60, px: 40, py: 60, r: 7, vx: 0, vy: -260 },
+  };
+  resolveBricks(state);
+  assert.equal(state.ball.y, 75, 'ball pushed out below the brick (68 + 7)');
+  assert.equal(state.ball.vy, 260, 'vy flipped up');
+});
