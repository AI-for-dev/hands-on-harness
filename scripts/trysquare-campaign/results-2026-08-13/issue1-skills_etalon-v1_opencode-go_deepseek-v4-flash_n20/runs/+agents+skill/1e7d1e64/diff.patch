+// --- Brick bounce resolution (pure, no DOM) --------------------------------
+
+// Maximum travel between two brick-overlap probes, in pixels. The resolver
+// sweeps the ball's path in sub-steps of this size so that no fast step can
+// jump over a whole brick undetected: the vertical distance to cross head-on
+// is BRICK_H + 2*BALL_R = 34 px, and 2 px keeps the detection overshoot small
+// enough that the penetration-based face test stays exact even on the narrow
+// 6 px grid seams (see to_fix.md D2/D3).
+const BRICK_PROBE_STEP = 2;
+
+// Resolves the ball against the brick grid for one tick, after `step()` has
+// moved the ball and recorded its previous position in ball.px/ball.py.
+//
+// The path from (px, py) to (x, y) is probed in sub-steps of at most
+// BRICK_PROBE_STEP px; on the first probe that overlaps a live brick, the
+// contact is resolved once and the tick ends (a single bounce per pass, see
+// to_fix.md D3):
+//   - every overlapped brick is destroyed (a seam contact shatters both),
+//   - the bounce axis is the face with the smallest penetration; an exact
+//     corner (equal penetration) flips both components (to_fix.md D4),
+//   - the ball is pushed back out of the rectangle along that face
+//     (to_fix.md D5).
+// Returns the list of destroyed bricks, so the caller can do the scoring.
+export function resolveBricks(state) {
+  const { ball } = state;
+  const px = ball.px ?? ball.x;
+  const py = ball.py ?? ball.y;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+  const steps = Math.max(1, Math.ceil(Math.hypot(dx, dy) / BRICK_PROBE_STEP));
+
+  for (let i = 0; i <= steps; i++) {
+    const t = i / steps;
+    const probe = { x: px + dx * t, y: py + dy * t, r: ball.r };
+    const hit = state.bricks.filter((b) => b.alive && collides(probe, b));
+    if (hit.length === 0) continue;
+
+    // Contact: destroy every overlapped brick, then bounce once per axis.
+    const destroyed = hit.slice();
+    for (const brick of hit) brick.alive = false;
+
+    // Smallest penetration per axis, and the face (sign) that produced it.
+    let penX = Infinity;
+    let penY = Infinity;
+    let pushX = 0;
+    let pushY = 0;
+    for (const brick of hit) {
+      const dx1 = probe.x + ball.r - brick.x; // overlap on the left side
+      const dx2 = brick.x + brick.w + ball.r - probe.x; // overlap on the right side
+      if (Math.min(dx1, dx2) < penX) {
+        penX = Math.min(dx1, dx2);
+        pushX = dx1 <= dx2 ? -1 : 1;
+      }
+      const dy1 = probe.y + ball.r - brick.y; // overlap on the top side
+      const dy2 = brick.y + brick.h + ball.r - probe.y; // overlap on the bottom side
+      if (Math.min(dy1, dy2) < penY) {
+        penY = Math.min(dy1, dy2);
+        pushY = dy1 <= dy2 ? -1 : 1;
+      }
+    }
+
+    // The face hit is the axis of smallest penetration; on an exact corner
+    // both penetrations are equal and both components are reversed.
+    ball.x = probe.x;
+    ball.y = probe.y;
+    if (penX === penY) {
+      ball.vx = -ball.vx;
+      ball.vy = -ball.vy;
+      ball.x = probe.x + pushX * penX;
+      ball.y = probe.y + pushY * penY;
+    } else if (penX < penY) {
+      ball.vx = -ball.vx;
+      ball.x = probe.x + pushX * penX;
+    } else {
+      ball.vy = -ball.vy;
+      ball.y = probe.y + pushY * penY;
+    }
+    return destroyed;
+  }
+
+  return [];
+}
