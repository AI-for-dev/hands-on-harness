+// Resolves one overlap between the ball and one brick: decides which face (or
+// corner) was hit from the penetration depths, inverts the corresponding
+// velocity component(s) and pushes the ball back out of the rectangle so it
+// cannot re-collide (and re-invert) on the next frame.
+//
+// Axis rule: the touched axis is the one with the SMALLEST penetration; a ball
+// center outside BOTH spans is off a corner, and both components invert. The
+// `flipped` guard caps the resolution at one inversion per axis and per pass:
+// two bricks sharing a seam (gap 8 < ball diameter 14) can both overlap the
+// ball in the same pass, and a double `vy = -vy` would cancel out and let the
+// ball through.
+export function bounceBrick(ball, brick, flipped = { x: false, y: false }) {
+  // Penetration through each of the four faces (all >= 0 while overlapping).
+  const penTop = ball.y + ball.r - brick.y;
+  const penBottom = brick.y + brick.h - (ball.y - ball.r);
+  const penLeft = ball.x + ball.r - brick.x;
+  const penRight = brick.x + brick.w - (ball.x - ball.r);
+
+  const outsideX = ball.x < brick.x || ball.x > brick.x + brick.w;
+  const outsideY = ball.y < brick.y || ball.y > brick.y + brick.h;
+
+  if (outsideX && outsideY) {
+    // Corner hit: both axes invert, push out along the diagonal.
+    if (!flipped.x) {
+      ball.vx = -ball.vx;
+      flipped.x = true;
+    }
+    if (!flipped.y) {
+      ball.vy = -ball.vy;
+      flipped.y = true;
+    }
+    ball.x = ball.x < brick.x ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    ball.y = ball.y < brick.y ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  } else if (Math.min(penLeft, penRight) <= Math.min(penTop, penBottom)) {
+    // Side face: invert vx (once per pass), push out sideways.
+    if (!flipped.x) {
+      ball.vx = -ball.vx;
+      flipped.x = true;
+    }
+    ball.x = penLeft < penRight ? brick.x - ball.r : brick.x + brick.w + ball.r;
+  } else {
+    // Top or bottom face: invert vy (once per pass), push out vertically.
+    if (!flipped.y) {
+      ball.vy = -ball.vy;
+      flipped.y = true;
+    }
+    ball.y = penTop < penBottom ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  }
+}
