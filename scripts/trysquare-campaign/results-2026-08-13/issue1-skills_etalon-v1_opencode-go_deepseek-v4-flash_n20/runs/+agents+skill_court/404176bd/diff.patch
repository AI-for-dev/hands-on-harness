+// --- Brick collisions ------------------------------------------------------
+
+// D1: the reported symptom — a ball plowing into a brick must bounce, not
+// pass through. The brick is destroyed, vy flips UP on a top-face hit and the
+// ball is pushed back out of the rectangle (no sticky re-collision next frame).
+test('step: ball bounces off the top face of a brick and is pushed out', () => {
+  const state = createState(1);
+  const brick = state.bricks[0]; // row 0, col 0: (4,48) 72x20
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y - BALL_R - 1, r: BALL_R, vx: 0, vy: 300 };
+  const lost = step(state, 1 / 60);
+  assert.equal(lost, false);
+  assert.equal(brick.alive, false, 'the hit brick is destroyed');
+  assert.ok(state.ball.vy < 0, 'vy flips UP after a top-face hit');
+  assert.ok(state.ball.y + state.ball.r <= brick.y, 'ball is pushed back out above the brick');
+});
+
+// D1: same on a side face — vx flips LEFT and the ball exits through the side.
+test('step: ball bounces off the side face of a brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[1]; // row 0, col 1: (84,48) 72x20
+  state.ball = { x: brick.x - 3, y: brick.y + 10, r: BALL_R, vx: 300, vy: 0 };
+  const lost = step(state, 1 / 60);
+  assert.equal(lost, false);
+  assert.equal(brick.alive, false, 'the hit brick is destroyed');
+  assert.ok(state.ball.vx < 0, 'vx flips LEFT after a left-face hit');
+  assert.ok(state.ball.x + state.ball.r <= brick.x, 'ball is pushed back out left of the brick');
+});
+
+// D3: a corner hit (ball center outside both spans, equal penetrations)
