+test('step: corner hit inverts both components', () => {
+  const state = createState(1);
+  const brick = state.bricks[1]; // (84,48)
+  state.ball = { x: brick.x - 2, y: brick.y - 2, r: BALL_R, vx: 60, vy: 60 };
+  const lost = step(state, 1 / 60);
+  assert.equal(lost, false);
+  assert.equal(brick.alive, false, 'the hit brick is destroyed');
+  assert.ok(state.ball.vx < 0 && state.ball.vy < 0, 'both components invert at a corner');
