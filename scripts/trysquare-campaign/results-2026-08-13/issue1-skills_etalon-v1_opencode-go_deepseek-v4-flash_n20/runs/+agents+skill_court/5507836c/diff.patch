+// --- Defect #3: seam double inversion --------------------------------------
+// Two bricks sharing a seam can be overlapped in the same pass (grid spacing
+// BRICK_H + BRICK_GAP = 28 px < ball diameter 14 px). Two naive flips of the
+// same axis cancel out and the ball keeps its direction: the invariant is one
+// bounce per pass and per axis.
+
+test('bounceBricks: seam between stacked bricks inverts vy exactly once (ascending ball)', () => {
+  const state = createState(1);
+  state.ball = { x: 136, y: 124, r: 7, vx: 0, vy: -300 }; // straddling the seam, going up
+  state.bricks = [
+    { x: 100, y: 100, w: 72, h: 20, row: 0, alive: true, points: 10 },
+    { x: 100, y: 128, w: 72, h: 20, row: 1, alive: true, points: 10 },
+  ];
+  bounceBricks(state);
+  // Two naive flips of vy would annihilate and the ball would keep going up.
+  assert.equal(state.ball.vy, 300, 'exactly one flip: the ball bounces back down');
+  assert.ok(state.bricks.every((b) => !b.alive), 'both seam bricks are broken');
+});
+
+test('bounceBricks: seam between side-by-side bricks inverts vx exactly once (leftward ball)', () => {
+  const state = createState(1);
+  state.ball = { x: 176, y: 110, r: 7, vx: -300, vy: 0 }; // straddling the seam, going left
+  state.bricks = [
+    { x: 100, y: 100, w: 72, h: 20, row: 0, alive: true, points: 10 },
+    { x: 180, y: 100, w: 72, h: 20, row: 0, alive: true, points: 10 },
+  ];
+  bounceBricks(state);
+  assert.equal(state.ball.vx, 300, 'exactly one flip: the ball bounces back right');
+  assert.ok(state.bricks.every((b) => !b.alive), 'both seam bricks are broken');
+});
+
+// --- Defect #2: tunneling at high speed ------------------------------------
+// A single discrete step longer than the obstacle (BRICK_H + 2*BALL_R = 34 px)
+// jumps over it without ever touching it. Max step = ballSpeed(level) * dt_cap:
+// level 5 → 620*0.05 = 31 px (safe), level 6 → 710*0.05 = 35.5 px (tunnels).
+
+test('step: a full capped frame at level 6 cannot skip through a brick', () => {
+  const level = 6;
+  const state = createState(level);
+  state.ball = { x: 280, y: 152, r: 7, vx: 0, vy: ballSpeed(level) }; // straight down
+  state.bricks = [{ x: 244, y: 160, w: 72, h: 20, row: 4, alive: true, points: 50 }];
+  step(state, 0.05); // one full frame at the dt cap
+  assert.equal(state.ball.vy, -ballSpeed(level), 'the ball bounced back up');
+  assert.ok(state.ball.y + state.ball.r <= 160, 'the ball ends above the brick, not below it');
+  assert.equal(state.bricks[0].alive, false, 'the brick was hit and broken');
+});
