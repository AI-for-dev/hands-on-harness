+// Resolves every ball/brick collision of the current position: bounces the
+// ball off the face it hit (the axis of least penetration; equal penetration
+// is a corner and flips both), pushes it back out of the brick so it cannot
+// re-collide on the next pass, then breaks the brick and scores. Pure logic.
+// Returns the number of bricks broken.
+//
+// Two bricks sharing a seam can both overlap the ball in the same pass (grid
+// spacing BRICK_H + BRICK_GAP is smaller than the ball diameter): the sign to
+// leave a face with is the opposite of the sign the ball arrived with, so the
+// flip is velocity-driven and allowed at most once per axis per pass — two
+// flips of the same axis would cancel out and let the ball plow through.
+export function bounceBricks(state) {
+  const { ball, bricks } = state;
+  let broken = 0;
+  let flippedX = false;
+  let flippedY = false;
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    if (!collides(ball, brick)) continue;
+
+    // Penetration depth on each axis: the smaller one is the face that was
+    // hit. Equal depths = corner.
+    const overlapX = Math.min(
+      ball.x + ball.r - brick.x,
+      brick.x + brick.w - (ball.x - ball.r),
+    );
+    const overlapY = Math.min(
+      ball.y + ball.r - brick.y,
+      brick.y + brick.h - (ball.y - ball.r),
+    );
+
+    if (overlapX < overlapY) {
+      // Side face: the ball leaves with the horizontal sign flipped, once.
+      if (!flippedX) {
+        ball.vx = ball.vx > 0 ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+        flippedX = true;
+      }
+      // Push out horizontally, on the side the ball came from.
+      ball.x = ball.x < brick.x + brick.w / 2 ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    } else if (overlapY < overlapX) {
+      // Top or bottom face: the ball leaves with the vertical sign flipped,
+      // once.
+      if (!flippedY) {
+        ball.vy = ball.vy > 0 ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+        flippedY = true;
+      }
+      ball.y = ball.y < brick.y + brick.h / 2 ? brick.y - ball.r : brick.y + brick.h + ball.r;
+    } else {
+      // Corner: both components invert.
+      if (!flippedX) {
+        ball.vx = -ball.vx;
+        flippedX = true;
+      }
+      if (!flippedY) {
+        ball.vy = -ball.vy;
+        flippedY = true;
+      }
+      ball.x = ball.x < brick.x + brick.w / 2 ? brick.x - ball.r : brick.x + brick.w + ball.r;
+      ball.y = ball.y < brick.y + brick.h / 2 ? brick.y - ball.r : brick.y + brick.h + ball.r;
