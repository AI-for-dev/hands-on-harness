+// The ball arrives on the top face of a brick (vy > 0, y + r > brick.y) and
+// must leave it with vy < 0, having destroyed the brick and scored.
+// Today: frame() only kills the brick; step() never deflects the ball.
+
+test('bricks: ball hitting a top face bounces up, kills the brick, scores', () => {
+  const state = setup({
+    ball: { x: 286, y: 90, vx: 0, vy: ballSpeed(1) },
+    bricks: [brick(250, 100)],
+  });
+  step(state, 1 / 20); // 13 px, slow enough that there is no tunneling
+
+  assert.equal(state.bricks[0].alive, false, 'the brick is destroyed');
+  assert.equal(Math.sign(state.ball.vy), UP, 'vy flips UP after the bounce');
+  assert.ok(
+    state.ball.y + BALL_R < 100,
+    'the ball is pushed back out of the brick',
+  );
+  assert.equal(state.combo, 1, 'the brick counts once');
+  assert.ok(state.score > 0, 'the brick scores');
