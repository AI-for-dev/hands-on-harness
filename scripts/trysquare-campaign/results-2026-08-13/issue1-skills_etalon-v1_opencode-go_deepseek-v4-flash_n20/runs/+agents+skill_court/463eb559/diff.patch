+// --- Helpers for the brick-collision defect suite --------------------------
+
+// A single live brick, 20 pts, at the given top-left corner.
+function brick(x, y) {
+  return { x, y, w: BRICK_W, h: BRICK_H, alive: true, row: 0, points: 20 };
+}
+
+// A state with a controlled ball and a controlled brick list.
+function setup({ level = 1, ball, bricks }) {
+  const state = createState(level);
+  if (ball) Object.assign(state.ball, ball);
+  if (bricks) state.bricks = bricks;
+  return state;
