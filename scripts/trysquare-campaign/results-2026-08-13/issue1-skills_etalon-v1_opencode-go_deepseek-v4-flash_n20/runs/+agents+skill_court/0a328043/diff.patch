+// --- Brick collision: the ball must bounce off bricks, not plow through them.
+
+// Defect 1 (bounce manquant): the brick is destroyed but the ball is never
+// deflected, so it passes straight through. A descending ball that reaches the
+// top face of a brick must come back up, out of the brick's rectangle.
+function topBrick(state, col = 0) {
+  return state.bricks
+    .filter((b) => b.row === 0)
+    .sort((a, b) => a.x - b.x)[col];
+}
+
+test('bricks: descending ball bounces off the top face (no plow-through)', () => {
