+
+// Swept circle-vs-rectangle test. The rect is expanded by the ball radius `r`:
+// the ball CENTER is then a point sliding along the segment
+// (x0,y0)→(x0+dx,y0+dy), and a hit means the segment crosses the expanded
+// rect. Returns the entry time plus, per axis, the entry time and the edge
+// crossed ('min' = left/top, 'max' = right/bottom), or null. The axis entered
+// LAST along the sweep is the face the ball struck; equal entry times mean a
+// corner. A ball that starts the step already inside a slab (e.g. wedged in a
+// seam) has entry time -Infinity on that axis: the other axis decides.
+function sweepHit(x0, y0, dx, dy, r, rect) {
+  const xmin = rect.x - r;
+  const xmax = rect.x + rect.w + r;
+  const ymin = rect.y - r;
+  const ymax = rect.y + rect.h + r;
+
+  let tmin = 0;
+  let tmax = 1;
+  let enterX = -Infinity;
+  let enterY = -Infinity;
+  let edgeX = null;
+  let edgeY = null;
+
+  if (dx === 0) {
+    if (x0 < xmin || x0 > xmax) return null;
+  } else {
+    const t1 = (xmin - x0) / dx;
+    const t2 = (xmax - x0) / dx;
+    const lo = Math.min(t1, t2);
+    const hi = Math.max(t1, t2);
+    if (lo >= 0) {
+      enterX = lo;
+      edgeX = t1 < t2 ? 'min' : 'max';
+      if (lo > tmin) tmin = lo;
+    }
+    if (hi < tmax) tmax = hi;
+    if (tmin > tmax) return null;
+  }
+
+  if (dy === 0) {
+    if (y0 < ymin || y0 > ymax) return null;
+  } else {
+    const t1 = (ymin - y0) / dy;
+    const t2 = (ymax - y0) / dy;
+    const lo = Math.min(t1, t2);
+    const hi = Math.max(t1, t2);
+    if (lo >= 0) {
+      enterY = lo;
+      edgeY = t1 < t2 ? 'min' : 'max';
+      if (lo > tmin) tmin = lo;
+    }
+    if (hi < tmax) tmax = hi;
+    if (tmin > tmax) return null;
+  }
+
+  return { t: tmin, enterX, enterY, edgeX, edgeY };
+}
