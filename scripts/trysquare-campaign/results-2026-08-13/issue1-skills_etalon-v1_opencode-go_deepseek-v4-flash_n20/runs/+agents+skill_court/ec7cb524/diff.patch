+// --- Brick bounce regression tests ----------------------------------------
+//
+// The reported symptom — "the ball goes through the bricks" — decomposes into
+// four defects, each locked by the tests below:
+//   D1  no deflection at all on brick contact (frame() used to kill the brick
+//       and move on) — fixed by `bounceBricks()` with face-vs-corner
+//       resolution and a push-out so the ball never sticks;
+//   D2  tunneling: at level ≥ 6 a capped 50 ms step (ballSpeed(6) × 0.05 =
+//       35.5 px) exceeds brick height + ball diameter (20 + 14 = 34 px) —
+//       fixed by a swept test between the previous and the current position;
+//   D3  double inversion on a seam: the 8 px column gap is narrower than the
+//       14 px ball, two bricks of one seam can be hit in a single pass, and
+//       two flips of the same axis cancel out — fixed by one bounce per axis
+//       per pass;
+//   D4  the paddle band test let a fast ball jump the 12 px paddle height in
+//       one capped step (13 px at level 1) — fixed by a swept paddle test.
+
+const BRICK_W = 72;
+const BRICK_H = 20;
+
+function stateWithBricks(ball, bricks) {
+  const state = createState(1);
+  state.bricks = bricks;
+  state.ball = ball;
+  return state;
+}
+
+test('D1: head-on top-face hit flips vy up, keeps vx, pushes the ball above', () => {
+  const brick = { x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, points: 50, alive: true };
+  const ball = { x: 136, y: 107, r: BALL_R, vx: 0, vy: 260, prevX: 136, prevY: 90 };
+  const state = stateWithBricks(ball, [brick]);
+  bounceBricks(state);
+  assert.equal(Math.sign(ball.vy), UP);
+  assert.equal(ball.vx, 0);
+  assert.ok(ball.y + ball.r < brick.y, 'ball ends above the brick');
+  assert.equal(brick.alive, false);
+  assert.equal(state.score, scoreForBrick(brick, 1), 'brick scored exactly once');
+});
+
+test('D1: bottom-face hit flips vy down and pushes the ball below', () => {
+  const brick = { x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, points: 50, alive: true };
+  const ball = { x: 136, y: 118, r: BALL_R, vx: 0, vy: -260, prevX: 136, prevY: 128 };
+  const state = stateWithBricks(ball, [brick]);
+  bounceBricks(state);
+  assert.equal(Math.sign(ball.vy), DOWN);
+  assert.ok(ball.y - ball.r > brick.y + brick.h, 'ball ends below the brick');
+});
+
+test('D1: left-face hit flips vx left and pushes the ball out to the left', () => {
+  const brick = { x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, points: 50, alive: true };
+  const ball = { x: 107, y: 110, r: BALL_R, vx: 260, vy: 0, prevX: 92, prevY: 110 };
+  const state = stateWithBricks(ball, [brick]);
+  bounceBricks(state);
+  assert.equal(Math.sign(ball.vx), LEFT);
+  assert.equal(ball.vy, 0);
+  assert.ok(ball.x + ball.r < brick.x, 'ball ends left of the brick');
+});
+
+test('D1: right-face hit flips vx right and pushes the ball out to the right', () => {
+  const brick = { x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, points: 50, alive: true };
+  const ball = { x: 165, y: 110, r: BALL_R, vx: -260, vy: 0, prevX: 180, prevY: 110 };
+  const state = stateWithBricks(ball, [brick]);
+  bounceBricks(state);
+  assert.equal(Math.sign(ball.vx), RIGHT);
+  assert.ok(ball.x - ball.r > brick.x + brick.w, 'ball ends right of the brick');
+});
+
+test('D1: equal penetrations are a corner — both components flip', () => {
+  const brick = { x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, points: 50, alive: true };
+  const ball = { x: 105, y: 105, r: BALL_R, vx: 200, vy: 200, prevX: 90, prevY: 90 };
+  const state = stateWithBricks(ball, [brick]);
+  bounceBricks(state);
+  assert.equal(Math.sign(ball.vx), LEFT);
+  assert.equal(Math.sign(ball.vy), UP);
+});
+
+test('D2: a capped 50 ms step longer than the brick still bounces (no tunneling)', () => {
+  const level = 6; // ballSpeed(6) = 710 px/s → 0.05 s step = 35.5 px > 20 + 14
+  const state = createState(level);
+  const brick = { x: 284, y: 100, w: BRICK_W, h: BRICK_H, row: 0, points: 60, alive: true };
+  state.bricks = [brick];
+  state.ball = { x: 320, y: brick.y - BALL_R - 1, r: BALL_R, vx: 0, vy: ballSpeed(level) };
+  step(state, 0.05);
+  assert.ok(!collides(state.ball, brick), 'premise: the step jumps clear past the brick');
+  bounceBricks(state);
+  assert.equal(Math.sign(state.ball.vy), UP, 'the ball must bounce off the top face');
+  assert.ok(state.ball.y + state.ball.r < brick.y, 'ball ends above the brick');
+  assert.equal(brick.alive, false);
+});
+
+test('D3: a vertical seam of two bricks flips vy exactly once', () => {
+  const a = { x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, points: 50, alive: true };
+  const b = { x: 100 + BRICK_W + 8, y: 100, w: BRICK_W, h: BRICK_H, row: 0, points: 50, alive: true };
+  const ball = { x: 100 + BRICK_W + 4, y: 126, r: BALL_R, vx: 0, vy: -260, prevX: 100 + BRICK_W + 4, prevY: 140 };
+  const state = stateWithBricks(ball, [a, b]);
+  bounceBricks(state);
+  assert.equal(Math.sign(ball.vy), DOWN, 'the ball must bounce back down, not climb through');
+  assert.equal(ball.vx, 0, 'a straight-up pass must not touch vx');
+  assert.equal(a.alive, false);
+  assert.equal(b.alive, false);
+  assert.ok(ball.y - ball.r > 100 + BRICK_H, 'ball ends below both bricks');
+});
+
+test('D3: a horizontal seam of two bricks flips vx exactly once', () => {
+  const a = { x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, points: 50, alive: true };
+  const b = { x: 100 + BRICK_W + 8, y: 100, w: BRICK_W, h: BRICK_H, row: 0, points: 50, alive: true };
+  const ball = { x: 100 + BRICK_W + 4, y: 110, r: BALL_R, vx: 260, vy: 0, prevX: 90, prevY: 110 };
+  const state = stateWithBricks(ball, [a, b]);
+  bounceBricks(state);
+  assert.equal(Math.sign(ball.vx), LEFT, 'the ball must bounce left, not pass through');
+  assert.equal(ball.vy, 0);
+  assert.equal(a.alive, false);
+  assert.equal(b.alive, false);
+});
+
+test('D4: a fast ball cannot skip the paddle in one capped step', () => {
+  const state = createState(1);
+  // Bottom starts 0.5 px above the paddle top; a 50 ms step at level 1 speed
+  // (260 px/s → 13 px) carries it 12.5 px past the top, beyond the 12 px band.
+  state.ball = { x: 320, y: PADDLE_Y - BALL_R - 0.5, r: BALL_R, vx: 0, vy: ballSpeed(1) };
+  step(state, 0.05);
+  assert.equal(Math.sign(state.ball.vy), UP, 'the ball must bounce up off the paddle');
+  assert.ok(state.ball.y + state.ball.r <= PADDLE_Y, 'ball ends above the paddle');
+});
+
