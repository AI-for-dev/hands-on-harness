+  const state = createState(1);
+  const speed = ballSpeed(1);
+  state.ball = {
+    x: WIDTH / 2 + 24, // hit = 0.5
+    y: PADDLE_Y - BALL_R - 2,
+    r: BALL_R, vx: 0, vy: 300,
+    px: WIDTH / 2 + 24, py: PADDLE_Y - BALL_R - 2,
+  };
+  step(state, 1 / 60);
+  const norm = Math.hypot(state.ball.vx, state.ball.vy);
+  assert.ok(Math.abs(norm - speed) < 0.01, `speed ${norm} != ${speed}`);
+});
