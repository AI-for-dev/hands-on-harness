+// Defect: dead angle. A center hit (hit = 0) must keep a horizontal component,
+// otherwise the ball loops vertically between paddle and ceiling forever.
+test('paddle: a center hit never produces a vertical dead angle', () => {
+  const state = createState(1);
+  const speed = ballSpeed(1);
+  state.ball = {
+    x: WIDTH / 2,
+    y: PADDLE_Y - BALL_R - 2,
+    r: BALL_R, vx: 0, vy: 300,
+    px: WIDTH / 2, py: PADDLE_Y - BALL_R - 2,
+  };
+  step(state, 1 / 60);
+  assert.equal(Math.sign(state.ball.vy), UP);
+  assert.ok(Math.abs(state.ball.vx) >= speed * 0.2, 'keeps a horizontal component');
+});
+
+// Defect: speed. The norm after a paddle bounce must be the level speed, not
+// sqrt(vy_in^2 + (0.6*speed*hit)^2).
