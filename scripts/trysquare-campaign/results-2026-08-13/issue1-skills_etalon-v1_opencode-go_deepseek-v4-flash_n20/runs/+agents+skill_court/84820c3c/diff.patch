+
+// Brick grid geometry, derived from the same constants as makeBricks().
+const OFFSET_X = (WIDTH - (BRICK_COLS * (BRICK_W + BRICK_GAP) - BRICK_GAP)) / 2;
+const brickX = (col) => OFFSET_X + col * (BRICK_W + BRICK_GAP);
+const brickY = (row) => BRICK_TOP + row * (BRICK_H + BRICK_GAP);
+const brickAt = (state, row, col) =>
+  state.bricks.find((b) => b.x === brickX(col) && b.y === brickY(row));
+
+test('bricks: ball hitting a top face flips vy up and leaves the rectangle', () => {
+  const state = createState(1);
+  const brick = brickAt(state, 0, 3);
+  state.ball = { x: brickX(3) + BRICK_W / 2, y: brickY(0) - BALL_R - 1, r: BALL_R, vx: 0, vy: 200 };
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy < 0, 'vy must point upward after a top-face hit');
+  assert.ok(state.ball.y + BALL_R <= brick.y, 'the ball must end above the brick');
+  assert.equal(brick.alive, false, 'the hit brick is destroyed');
+  assert.equal(Math.hypot(state.ball.vx, state.ball.vy), 200, 'speed is preserved');
+});
+
+test('bricks: ball hitting a bottom face flips vy down and leaves the rectangle', () => {
