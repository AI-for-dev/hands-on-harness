+test('step: a ball hitting a brick head-on bounces back up', () => {
+  const state = createState(1);
+  const brick = state.bricks[0]; // top-left brick: row 0, col 0
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y - BALL_R - 1, r: BALL_R, vx: 0, vy: 200 };
