+// Resolves the ball's overlap with the bricks at its CURRENT position: every
+// overlapping brick is broken and scored, and the ball is deflected. Pure
+// logic (no DOM), so the whole brick-collision path is unit-testable.
+// The bounce is computed against the UNION of the overlapping rectangles:
+// two bricks sharing a seam touched in the same pass produce a single
+// deflection, never two cancelling flips. Returns the number of bricks broken.
+export function collideBricks(state) {
+  const { ball } = state;
+  const hit = state.bricks.filter((b) => b.alive && collides(ball, b));
+  if (hit.length === 0) return 0;
+
+  let minX = Infinity;
+  let minY = Infinity;
+  let maxX = -Infinity;
+  let maxY = -Infinity;
+  for (const brick of hit) {
+    brick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(brick, state.combo);
+    minX = Math.min(minX, brick.x);
+    minY = Math.min(minY, brick.y);
+    maxX = Math.max(maxX, brick.x + brick.w);
+    maxY = Math.max(maxY, brick.y + brick.h);
+  }
+
+  // How deep the ball sits in each side of the union. The face hit is the one
+  // with the SMALLEST penetration; equal penetration means a corner, where
+  // both components flip.
+  const penLeft = ball.x + ball.r - minX;
+  const penRight = maxX - (ball.x - ball.r);
+  const penTop = ball.y + ball.r - minY;
+  const penBottom = maxY - (ball.y - ball.r);
+  const penX = Math.min(penLeft, penRight);
+  const penY = Math.min(penTop, penBottom);
+
+  if (penX <= penY) {
+    ball.vx = -ball.vx;
+    ball.x = penLeft <= penRight ? minX - ball.r : maxX + ball.r;
+  }
+  if (penY <= penX) {
+    ball.vy = -ball.vy;
+    ball.y = penTop <= penBottom ? minY - ball.r : maxY + ball.r;
+  }
+  return hit.length;
+}
