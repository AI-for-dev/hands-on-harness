+function brick(x, y, w = BRICK_W, h = BRICK_H) {
+  return { x, y, w, h, row: 4, alive: true, points: 10 };
+}
+
+function ballState(ball, opts = {}) {
+  const state = createState(opts.level ?? 1);
+  state.ball = { ...ball, r: BALL_R };
+  if (opts.bricks) state.bricks = opts.bricks;
+  return state;
+}
