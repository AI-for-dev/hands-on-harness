+// --- Brick collisions (playtest: the ball plows through bricks) -----------
+
+// One brick, drawn from the field constants, centred around x = 136.
+function makeBrick() {
+  return { x: 100, y: 100, w: 72, h: 20, alive: true, row: 0, points: 50 };
+}
+
+// A state with one brick and a ball with a known travel segment (prev -> now).
+function oneBrickState(ball) {
+  return { score: 0, combo: 0, bricks: [makeBrick()], ball };
+}
+
+test('brick: ball falling onto the top face bounces back up', () => {
+  const state = oneBrickState({
+    x: 136, y: 95, r: BALL_R, vx: 0, vy: 300, prevX: 136, prevY: 90,
+  });
+  resolveBrickCollisions(state);
+  assert.equal(Math.sign(state.ball.vy), UP, 'vy flips upward');
+  assert.equal(state.ball.y, 100 - BALL_R, 'ball pushed out above the brick');
+  assert.equal(state.bricks[0].alive, false, 'brick is destroyed');
+  assert.equal(state.combo, 1, 'combo incremented once');
+  assert.ok(state.score > 0, 'score awarded');
+});
+
+test('brick: ball rising onto the bottom face bounces back down', () => {
+  const state = oneBrickState({
+    x: 136, y: 122, r: BALL_R, vx: 0, vy: -300, prevX: 136, prevY: 131,
+  });
+  resolveBrickCollisions(state);
+  assert.equal(Math.sign(state.ball.vy), DOWN, 'vy flips downward');
+  assert.equal(state.ball.y, 100 + 20 + BALL_R, 'ball pushed out below the brick');
+  assert.equal(state.bricks[0].alive, false);
+});
+
