+// over a brick between two frames (see the level-6 tunneling case).
+// One brick per pass: if the segment enters two bricks of a seam, only the
+// first entry (smallest t) is resolved — a second flip would cancel the first
+// and the ball would tunnel through.
+export function resolveBrickCollisions(state) {
+  const { ball, bricks } = state;
