+
+// --- Brick bounce: the ball must bounce off bricks, not plow through ------
+
+// Defect #1 (root): frame() killed the brick but never deflected the ball, so
+// a head-on hit let it pass straight through. It must bounce back up.
+test('bricks: head-on top face hit bounces the ball back up', () => {
+  const state = createState(1);
+  const brick = brickAt(state, 0, 3); // x: 244..316, y: 48..68
+  const ball = state.ball;
+  ball.x = 280; // centered on the brick
+  ball.y = 29; // ball bottom 12 px above the brick top
+  ball.vx = 0;
+  ball.vy = ballSpeed(1); // heading down
+
+  const lost = step(state, 0.05);
+
+  assert.equal(lost, false);
+  assert.equal(brick.alive, false, 'the touched brick must be destroyed');
+  assert.ok(ball.vy < 0, 'vy must point up after a top-face bounce');
+  assert.ok(ball.y + ball.r <= brick.y, 'the ball must end above the brick');
+});
+
