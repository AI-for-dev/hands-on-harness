+// First-contact test between the ball's swept segment (prev → current) and a
+// brick, treating the ball as a circle of radius `r` (the brick is inflated by
+// `r`). Returns `{ t, face }` with the first contact time `t` in [0, 1] and
+// the face the segment enters (`minX | maxX | minY | maxY`), or `null`. This is
+// the slab (Liang–Barsky) method and is what defeats tunnelling.
+function sweptContact(px, py, dx, dy, r, brick) {
+  const minX = brick.x - r;
+  const maxX = brick.x + brick.w + r;
+  const minY = brick.y - r;
+  const maxY = brick.y + brick.h + r;
+
+  // X slab.
+  let txIn;
+  let txOut;
+  let xFace;
+  if (dx === 0) {
+    if (px < minX || px > maxX) return null;
+    txIn = -Infinity;
+    txOut = Infinity;
+    xFace = null;
+  } else {
+    const t1 = (minX - px) / dx;
+    const t2 = (maxX - px) / dx;
+    xFace = t1 <= t2 ? 'minX' : 'maxX';
+    txIn = Math.min(t1, t2);
+    txOut = Math.max(t1, t2);
+  }
+
+  // Y slab.
+  let tyIn;
+  let tyOut;
+  let yFace;
+  if (dy === 0) {
+    if (py < minY || py > maxY) return null;
+    tyIn = -Infinity;
+    tyOut = Infinity;
+    yFace = null;
+  } else {
+    const t1 = (minY - py) / dy;
+    const t2 = (maxY - py) / dy;
+    yFace = t1 <= t2 ? 'minY' : 'maxY';
+    tyIn = Math.min(t1, t2);
+    tyOut = Math.max(t1, t2);
+  }
+
+  const t0 = Math.max(txIn, tyIn);
+  const tOut = Math.min(txOut, tyOut);
+  if (t0 > tOut || t0 < 0 || t0 > 1) return null;
+
+  // The face crossed LAST is the face actually hit; a tie (corner) is reported
+  // through the x face, which still flips the primary component correctly.
+  if (txIn >= tyIn) return { t: t0, face: xFace };
+  return { t: t0, face: yFace };
+}
+
+// Swept (tunnelling-safe) brick bounce. Detection is discrete — only the
+// position before and after the move is known — so at high speed (`ballSpeed(6)`
+// = 710 px/s on a 50 ms stutter = 35.5 px > the 34 px needed to cross a brick)
+// the ball can jump straight over a brick. This sweeps the segment from `prev`
+// to the ball: if it crosses the brick it repositions the ball at the very
+// first point of contact and reflects the correct velocity component.
+// Returns `true` if the path hit the brick, `false` otherwise.
+export function sweepBounce(prev, ball, brick) {
+  const hit = sweptContact(prev.x, prev.y, ball.x - prev.x, ball.y - prev.y, ball.r, brick);
+  if (!hit) return false;
+
+  switch (hit.face) {
+    case 'minX': // entering through the brick's left edge — bounce back left
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+      break;
+    case 'maxX': // entering through the brick's right edge — bounce back right
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+      break;
+    case 'minY': // entering through the brick's top edge — bounce back up
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+      break;
+    case 'maxY': // entering through the brick's bottom edge — bounce back down
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+      break;
+  }
+  return true;
+}
