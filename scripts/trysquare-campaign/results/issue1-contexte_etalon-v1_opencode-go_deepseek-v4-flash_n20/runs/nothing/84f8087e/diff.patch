+// --- Brick bounce (issue #1) ----------------------------------------------
+
+// Bounces a ball that currently OVERLAPS a brick and pushes it back out of the
+// brick rectangle. Pure — it only mutates `ball`.
+//
+// - per-face: the axis with the *smaller* penetration is the face that was
+//   hit; flip `vy` on a top/bottom hit and `vx` on a side hit, leaving the
+//   other component exactly as it was;
+// - corner: about-equal penetrations mean a diagonal hit — flip both;
+// - push out: the ball is repositioned just outside the brick rectangle, so it
+//   cannot still overlap on the next frame (the sticky re-bounce) and is
+//   automatically cleared from an adjacent brick it shared a seam with in the
+//   same pass, which is how the bounce is guaranteed to apply exactly once.
+export function bounceOffBrick(ball, brick) {
+  const penLeft = ball.x + ball.r - brick.x;
+  const penRight = brick.x + brick.w - (ball.x - ball.r);
+  const penTop = ball.y + ball.r - brick.y;
+  const penBottom = brick.y + brick.h - (ball.y - ball.r);
+
+  const penX = Math.min(penLeft, penRight);
+  const penY = Math.min(penTop, penBottom);
+
+  if (penX < penY) {
+    // Side face: flip only vx.
+    if (penRight <= penLeft) {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x - ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+  } else if (penY < penX) {
+    // Top/bottom face: flip only vy.
+    if (penBottom <= penTop) {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y - ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  } else {
+    // Corner: approximate tie — diagonal hit, flip both components.
+    if (penRight <= penLeft) {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x - ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+    if (penBottom <= penTop) {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y - ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  }
+}
