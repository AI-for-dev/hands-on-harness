+test('#1 neighbours: overlapping two seam bricks bounces exactly once', () => {
+  // Two seam-adjacent bricks with the 8px BRICK_GAP, and a ball wide enough to
+  // overlap BOTH at once. frame() processes bricks sequentially: bouncing the
+  // first brick (a top-face hit here) pushes the ball straight UP, clearing it
+  // from the seam neighbour too, so vy flips exactly once — not twice.
+  // A double `vy = -vy` cancellation (vy net 0 change) is the plow-through bug.
+  const ball = { x: 124, y: 74, r: 7, vx: 10, vy: -260 }; // descending onto the seam
+  // A spans x:[40,120]; B spans x:[128,208]; the 8px seam is the real gap.
+  const brickA = { x: 40, y: 80, w: 80, h: 40 };
+  const brickB = { x: 128, y: 80, w: 80, h: 40 };
+  assert.ok(collides(ball, brickA), 'ball overlaps the LEFT brick');
+  assert.ok(collides(ball, brickB), 'ball overlaps the RIGHT brick too (seam)');
+
+  const vyBefore = ball.vy;
+  const vxBefore = ball.vx;
+  // Process the first brick exactly the way frame() does. The bounce MUST also
+  // clear it from the neighbour so the second brick's collides() is skipped.
+  bounceOffBrick(ball, brickA);
+  assert.ok(!collides(ball, brickA), 'left brick cleared after its bounce');
+  assert.ok(!collides(ball, brickB), 'and the ball is pushed clear of the right brick too');
+  assert.equal(
+    Math.sign(ball.vy),
+    -Math.sign(vyBefore),
+    'bounce applied exactly once (vy flipped, not cancelled)',
+  );
+  assert.equal(ball.vx, vxBefore, 'top-face hit leaves vx exactly untouched');
+});
