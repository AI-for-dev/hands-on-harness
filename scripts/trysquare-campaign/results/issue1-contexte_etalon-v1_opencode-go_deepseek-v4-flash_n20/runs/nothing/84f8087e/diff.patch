+// --- #1 bug: the ball plows through bricks instead of bouncing --------------
+// The tests below drive the documented cases from ISSUES.md #1. The brick
+// occupies x:[40,120] × y:[80,120] (w=80, h=40) so the assertions read well.
+
+test('#1 per-face top hit: vy flips, vx untouched, ball pushed out above', () => {
+  const ball = { x: 80, y: 74, r: 7, vx: 40, vy: -300 }; // descending into brick
+  const brick = { x: 40, y: 80, w: 80, h: 40 };
+  assert.ok(collides(ball, brick), 'ball must overlap the brick');
+  bounceOffBrick(ball, brick);
+  assert.ok(ball.vy > 0, 'descending hit should flip vy downward');
+  assert.equal(ball.vx, 40, 'vx must be left exactly as it was');
+  assert.equal(ball.y, brick.y - ball.r, 'ball pushed out above the brick');
+});
+
+test('#1 per-face side hit (right edge): vx flips, vy untouched', () => {
+  const ball = { x: 124, y: 100, r: 7, vx: 300, vy: -260 }; // centre just past right edge
+  const brick = { x: 40, y: 80, w: 80, h: 40 };
+  assert.ok(collides(ball, brick), 'ball must overlap the brick');
+  bounceOffBrick(ball, brick);
+  assert.ok(ball.vx < 0, 'right-edge hit should flip vx leftward');
+  assert.equal(ball.vy, -260, 'vy must be left exactly as it was');
+  assert.equal(ball.x, brick.x + brick.w + ball.r, 'ball pushed out to the right');
+});
+
+test('#1 corner hit: both components flip', () => {
