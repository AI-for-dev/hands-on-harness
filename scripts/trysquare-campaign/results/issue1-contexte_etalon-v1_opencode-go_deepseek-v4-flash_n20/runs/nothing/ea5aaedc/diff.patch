+// --- Brick collision resolution (fix for #1) -------------------------------
+
+// Returns the first point along the segment (x1,y1)->(x2,y2) at which the
+// moving point enters the axis-aligned rectangle, expressed as a fraction
+// `t` in [0,1] of the way along the segment, plus the axis (0 = x, 1 = y)
+// through which it entered. Returns `null` when the segment misses the rect.
+// Used to catch bricks a fast ball would otherwise jump clean over.
+function segmentEntry(x1, y1, x2, y2, rx, ry, rw, rh) {
+  const dx = x2 - x1;
+  const dy = y2 - y1;
+  let tmin = 0;
+  let tmax = 1;
+  let axis = -1;
+
+  if (Math.abs(dx) < 1e-9) {
+    if (x1 < rx || x1 > rx + rw) return null;
+  } else {
+    let t1 = (rx - x1) / dx;
+    let t2 = (rx + rw - x1) / dx;
+    if (t1 > t2) {
+      const t = t1; t1 = t2; t2 = t;
+    }
+    if (t1 > tmin) { tmin = t1; axis = 0; }
+    if (t2 < tmax) tmax = t2;
+    if (tmin > tmax) return null;
+  }
+
+  if (Math.abs(dy) < 1e-9) {
+    if (y1 < ry || y1 > ry + rh) return null;
+  } else {
+    let t1 = (ry - y1) / dy;
+    let t2 = (ry + rh - y1) / dy;
+    if (t1 > t2) {
+      const t = t1; t1 = t2; t2 = t;
+    }
+    if (t1 > tmin) { tmin = t1; axis = 1; }
+    if (t2 < tmax) tmax = t2;
+    if (tmin > tmax) return null;
+  }
+
+  return { t: tmin, axis };
+}
+
+// Resolves the ball against every brick in one pass.
+//
+// - destroys every brick the ball touches (overlap AND swept/tunnelled),
+// - calls `onDestroy(brick)` once per destroyed brick (for score/combo),
+// - applies a single bounce (never twice) and pushes the ball clear,
+// - returns `true` if anything bounced.
+//
+// Two overlapping bricks share a seam (8 px gap < 14 px ball), so a single
+// frame can overlap several bricks at once: the bounce is therefore computed
+// from the aggregate envelope and minimum-penetration face, never per-brick
+// (which would double-flip `vy` and send the ball straight through).
+export function resolveBrickHit(ball, bricks, onDestroy) {
+  // Phase 1: bricks the ball is currently overlapping.
+  let overlapHit = false;
+  let minPenX = Infinity;
+  let minPenY = Infinity;
+  let minX = Infinity;
+  let maxX = -Infinity;
+  let minY = Infinity;
+  let maxY = -Infinity;
+
+  for (const brick of bricks) {
+    if (!brick.alive || !collides(ball, brick)) continue;
+
+    overlapHit = true;
+    brick.alive = false;
+    if (onDestroy) onDestroy(brick);
+
+    if (brick.x < minX) minX = brick.x;
+    if (brick.x + brick.w > maxX) maxX = brick.x + brick.w;
+    if (brick.y < minY) minY = brick.y;
+    if (brick.y + brick.h > maxY) maxY = brick.y + brick.h;
+
+    const penX = Math.min(ball.x + ball.r - brick.x, brick.x + brick.w - (ball.x - ball.r));
+    const penY = Math.min(ball.y + ball.r - brick.y, brick.y + brick.h - (ball.y - ball.r));
+    if (penX < minPenX) minPenX = penX;
+    if (penY < minPenY) minPenY = penY;
+  }
+
+  if (overlapHit) {
+    // The face hit is the axis with the SMALLER penetration; equal penetration
+    // means a diagonal (corner) hit and flips both components.
+    if (minPenX < minPenY) {
+      ball.vx = -ball.vx;
+      ball.x = ball.vx > 0 ? maxX + ball.r : minX - ball.r;
+    } else if (minPenY < minPenX) {
+      ball.vy = -ball.vy;
+      ball.y = ball.vy > 0 ? maxY + ball.r : minY - ball.r;
+    } else {
+      ball.vx = -ball.vx;
+      ball.vy = -ball.vy;
+      ball.x = ball.vx > 0 ? maxX + ball.r : minX - ball.r;
+      ball.y = ball.vy > 0 ? maxY + ball.r : minY - ball.r;
+    }
+    return true;
+  }
+
+  // Phase 2: tunnelling — no overlap, but the segment swept this step crossed
+  // a brick the ball was moving fast enough to jump clean over.
+  const px = ball.prevX ?? ball.x;
+  const py = ball.prevY ?? ball.y;
+  let earliestT = Infinity;
+  let entryAxis = -1;
+  let bestBrick = null;
