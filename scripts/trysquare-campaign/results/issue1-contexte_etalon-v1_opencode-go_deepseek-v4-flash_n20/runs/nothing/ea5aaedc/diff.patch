+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    const entry = segmentEntry(px, py, ball.x, ball.y,
+      brick.x - ball.r, brick.y - ball.r,
+      brick.w + ball.r * 2, brick.h + ball.r * 2);
+    if (entry && entry.t < earliestT) {
+      earliestT = entry.t;
+      entryAxis = entry.axis;
+      bestBrick = brick;
+    }
+  }
+
+  if (bestBrick) {
+    bestBrick.alive = false;
+    if (onDestroy) onDestroy(bestBrick);
+
+    // Snap the ball back to the contact point, then bounce it clear.
+    ball.x = px + (ball.x - px) * earliestT;
+    ball.y = py + (ball.y - py) * earliestT;
+    if (entryAxis === 0) {
+      ball.vx = -ball.vx;
+      ball.x = ball.vx > 0 ? bestBrick.x + bestBrick.w + ball.r + 0.01
+                           : bestBrick.x - ball.r - 0.01;
+    } else {
+      ball.vy = -ball.vy;
+      ball.y = ball.vy > 0 ? bestBrick.y + bestBrick.h + ball.r + 0.01
+                           : bestBrick.y - ball.r - 0.01;
+    }
+    return true;
+  }
+
+  return false;
+}
