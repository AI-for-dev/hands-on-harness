+// --- Brick bounce (#1) ------------------------------------------------------
+
+// A brick takes a fixed position in the top-left corner of the field.
+const brick = { x: 100, y: 100, w: 40, h: 20 };
+
+// Ball centre + radius overlaps a brick: helper to build a contact.
+function ballAt(x, y, vx = 0, vy = 0) {
+  return { x, y, r: 8, vx, vy, px: x, py: y };
+}
+
+// Overlapping can be arbitrary — use a helper that scatters penetrations.
+test('brickContact: overlapping ball makes contact', () => {
+  const ball = ballAt(120, 112); // centred inside the brick
+  assert.equal(brickContact(ball, brick), true);
+});
+
+// Per-face: the axis with the smaller penetration decides the bounce.
+test('applyBounce: top hit flips vy, preserves vx, pushes up', () => {
+  // Ball arrived from above: centered on x, lightly into the brick top.
+  const ball = ballAt(120, 100 - 8 + 4, 40, 300);
+  applyBounce(ball, brick);
+  assert.ok(ball.vy < 0, 'vy should flip upward');
+  assert.equal(ball.vx, 40, 'vx left untouched');
+  assert.ok(ball.y + ball.r <= brick.y + 0.001, 'ball pushed out above the brick');
+});
+
+test('applyBounce: side hit flips vx, preserves vy, pushes sideways', () => {
+  // Ball arrived from the left: centred vertically, lightly into the left side.
+  const ball = ballAt(100 - 8 + 3, 110, 300, 40);
+  applyBounce(ball, brick);
+  assert.ok(ball.vx < 0, 'vx should flip left');
+  assert.equal(ball.vy, 40, 'vy left untouched');
+  assert.ok(ball.x + ball.r <= brick.x + 0.001, 'ball pushed out to the left');
+});
