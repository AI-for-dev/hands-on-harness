+    if (x0 < box.x || x0 > box.x + box.w) return null;
+  } else {
+    let t1 = (box.x - x0) / dx;
+    let t2 = (box.x + box.w - x0) / dx;
+    if (t1 > t2) [t1, t2] = [t2, t1];
+    tmin = Math.max(tmin, t1);
+    tmax = Math.min(tmax, t2);
