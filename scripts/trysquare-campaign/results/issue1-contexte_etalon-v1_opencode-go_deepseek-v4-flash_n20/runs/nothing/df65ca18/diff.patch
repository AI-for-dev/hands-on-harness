+// Horizontal velocity is always left untouched by a top/bottom hit and
+// vertical velocity untouched by a side hit (ISSUES #1 "per face"). Because we
+// pick a SINGLE primary brick, a seam hit (the ball overlaps two neighbouring
+// bricks at once, gap 8 px vs. a 14 px ball) only flips the velocity once,
+// instead of `vy = -vy` twice cancelling out.
+//
+// `segmentEntry` computes the first contact `t` of the ball's swept path with
+// the brick inflated by the ball's radius, which is what makes discrete steps
+// (ISSUES #1 "tunnelling") unable to skip over a brick at high speed.
+export function resolveBrickCollision(ball, prevX, prevY, bricks) {
+  const candidates = [];
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    const t = segmentEntry(prevX, prevY, ball.x, ball.y, brick, ball.r);
+    if (t !== null) candidates.push({ brick, t });
+  }
+  if (candidates.length === 0) return [];
+
+  // The brick hit first (smallest entry parameter) drives the single bounce.
+  candidates.sort((a, b) => a.t - b.t);
+  const primary = candidates[0];
+
+  // Tunnelled hit: rewind the ball to the point of contact so it truly rests
+  // against the face instead of having skipped past it.
+  if (primary.t > 1e-9) {
