+// First contact of the ball's swept segment with the brick's rect inflated by
+// the ball radius. Returns the entry parameter in [0, 1], or `null` when the
+// path never touches the rect. This is a Liang–Barsky slab test, extended to a
+// zero-length step and to a ball that already overlaps the rect (t = 0).
+function segmentEntry(x0, y0, x1, y1, brick, r) {
+  const rx = brick.x - r;
+  const ry = brick.y - r;
+  const rw = brick.w + 2 * r;
+  const rh = brick.h + 2 * r;
+  const dx = x1 - x0;
+  const dy = y1 - y0;
+
+  let tmin = 0;
+  let tmax = 1;
+
+  if (Math.abs(dx) < 1e-9) {
+    if (x0 < rx || x0 > rx + rw) return null;
+  } else {
+    let t1 = (rx - x0) / dx;
+    let t2 = (rx + rw - x0) / dx;
+    if (t1 > t2) { const tmp = t1; t1 = t2; t2 = tmp; }
+    tmin = Math.max(tmin, t1);
+    tmax = Math.min(tmax, t2);
+    if (tmin > tmax) return null;
+  }
+
+  if (Math.abs(dy) < 1e-9) {
+    if (y0 < ry || y0 > ry + rh) return null;
+  } else {
+    let t1 = (ry - y0) / dy;
+    let t2 = (ry + rh - y0) / dy;
+    if (t1 > t2) { const tmp = t1; t1 = t2; t2 = tmp; }
+    tmin = Math.max(tmin, t1);
+    tmax = Math.min(tmax, t2);
+    if (tmin > tmax) return null;
+  }
