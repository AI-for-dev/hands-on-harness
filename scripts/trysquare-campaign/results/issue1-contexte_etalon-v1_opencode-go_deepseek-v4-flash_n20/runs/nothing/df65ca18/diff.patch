+// --- #1 brick bounce -------------------------------------------------------
+// Each case of ISSUES #1 is exercised here: per-face, corner, push out,
+// neighbour seams (no double flip) and tunnelling at high speed.
+
+function brickAt(x, y) {
+  return { x, y, w: 40, h: 20, alive: true };
+}
+
+function ballAt(x, y, vx, vy) {
+  return { x, y, r: 7, vx, vy };
+}
+
+test('brick hit from the top flips only vy (per face)', () => {
+  const brick = brickAt(100, 100);
+  const ball = ballAt(120, 120, 0, 300); // 120+7 = 127 > 100 => overlaps top
+  const hits = resolveBrickCollision(ball, 120, 80, [brick]);
+  assert.equal(hits.length, 1);
+  assert.ok(ball.vy < 0, 'vertical velocity should bounce upward');
+  assert.equal(ball.vx, 0, 'horizontal velocity untouched by a top hit');
+  assert.ok(ball.y + ball.r <= brick.y, 'ball pushed back above the brick');
+});
+
+test('brick hit from the side flips only vx (per face)', () => {
+  const brick = brickAt(100, 100);
+  // Ball moving right into the brick's LEFT face, vertically fully inside it.
+  const ball = ballAt(105, 110, 80, 0);
+  const hits = resolveBrickCollision(ball, 50, 110, [brick]);
+  assert.equal(hits.length, 1);
+  assert.ok(ball.vx < 0, 'horizontal velocity should bounce back left');
+  assert.equal(ball.vy, 0, 'vertical velocity untouched by a side hit');
+  assert.ok(ball.x + ball.r <= brick.x, 'ball pushed back left of the brick');
+});
+
+test('corner hit flips both components', () => {
+  const brick = brickAt(100, 100);
+  // Centre on the top-left corner so both penetrations are exactly equal.
+  const ball = ballAt(103, 103, 50, 50);
+  const hits = resolveBrickCollision(ball, 96, 96, [brick]);
+  assert.equal(hits.length, 1);
+  assert.equal(ball.vx, -50, 'corner reverses x');
+  assert.equal(ball.vy, -50, 'corner reverses y upward');
+});
+
+test('push out: ball no longer overlaps any destroyed brick', () => {
+  const brick = brickAt(100, 100);
+  const ball = ballAt(120, 120, 0, 300);
+  resolveBrickCollision(ball, 120, 80, [brick]);
+  assert.equal(brick.alive, false);
+  assert.equal(collides(ball, brick), false, 'ball must be outside after bounce');
+});
+
+test('neighbour seam: velocity is NOT cancelled by a double flip', () => {
+  // Two touching bricks; the 14px ball overlaps both at once. Only ONE bounce
+  // applies (the primary brick), so vy is inverted once, not flipped back.
+  const left = brickAt(100, 100);
