+  const rightPen = brick.x + brick.w - (ball.x - ball.r);     // came from the right
+  const topPen = ball.y + ball.r - brick.y;                   // came from the top
+  const bottomPen = brick.y + brick.h - (ball.y - ball.r);    // came from the bottom
