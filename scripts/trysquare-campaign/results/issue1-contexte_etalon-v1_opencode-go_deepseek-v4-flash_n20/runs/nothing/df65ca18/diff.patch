+  const ball = ballAt(140, 110, 0, 250); // coming straight down on the seam
+  const hits = resolveBrickCollision(ball, 140, 90, [left, right]);
+  assert.equal(hits.length, 2, 'both seam bricks are broken');
+  assert.ok(ball.vy < 0, 'vy inverted once, not twice');
+});
+
+test('tunnelling: high-speed step still catches a thin brick', () => {
