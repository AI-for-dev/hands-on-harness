+// --- #1 brick bounce -------------------------------------------------------
+// Each scenario from ISSUES.md #1 is asserted here (red first).
+
+test('brickHit: head-on from below flips vy back down and pushes out', () => {
+  const brick = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  const r = 7;
+  const prevX = 136;
+  const prevY = brick.y + brick.h + r + 30; // well below the brick, moving up
+  const ball = { x: prevX, y: brick.y + brick.h + 2, r, vx: 0, vy: -300 };
+
+  const destroyed = brickHit(ball, [brick], prevX, prevY);
+
+  assert.equal(destroyed.length, 1);
+  assert.equal(brick.alive, false);
+  assert.ok(ball.vy > 0, 'vy should reflect away (down)');
+  assert.ok(ball.y - ball.r >= brick.y + brick.h, 'ball pushed back below the brick');
+  assert.equal(collides(ball, brick), false, 'no residual overlap (no sticky bounce)');
+});
+
