+
+// Swept test: the segment (fromX,fromY)->(toX,toY) crossing the brick means the
+// ball hit it somewhere this frame, even if the ball's discrete position is
+// already past it (high-speed tunnelling, #1). Returns the entry time `t` and
+// the face(s) entered ('x' | 'y' | 'both'), or null when there is no hit.
+//
+// The test runs against the brick expanded by the ball radius (so the circle
+// becomes a moving point) and uses the slab (Cyrus–Beck) method: the axis whose
+// slab becomes active LAST is the face that was actually hit.
+function sweptHit(fromX, fromY, toX, toY, brick, r) {
+  const L = brick.x - r, R = brick.x + brick.w + r;
+  const T = brick.y - r, B = brick.y + brick.h + r;
+  const dx = toX - fromX, dy = toY - fromY;
+
+  // A stationary ball cannot cross a brick this frame; any current overlap is
+  // reported by `collides` and handled as an overlap, not a sweep.
+  if (dx === 0 && dy === 0) return null;
+
+  const tinX = dx === 0 ? -Infinity : Math.min((L - fromX) / dx, (R - fromX) / dx);
+  const toutX = dx === 0 ? Infinity : Math.max((L - fromX) / dx, (R - fromX) / dx);
+  const tinY = dy === 0 ? -Infinity : Math.min((T - fromY) / dy, (B - fromY) / dy);
+  const toutY = dy === 0 ? Infinity : Math.max((T - fromY) / dy, (B - fromY) / dy);
