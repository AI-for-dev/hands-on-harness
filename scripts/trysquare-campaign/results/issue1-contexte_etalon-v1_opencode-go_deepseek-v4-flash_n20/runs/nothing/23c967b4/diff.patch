+  const hit = bounceBricks(ball, [b]);
+  assert.deepEqual(hit, [b]);
+  assert.ok(ball.vx > 0, 'should bounce back to the right: ' + ball.vx);
+  assert.equal(ball.vy, 0, 'vertical component must be left unchanged');
