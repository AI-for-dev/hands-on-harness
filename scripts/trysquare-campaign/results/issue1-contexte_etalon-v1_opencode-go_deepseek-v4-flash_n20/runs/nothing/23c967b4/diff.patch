+// --- issue #1: brick bounce -------------------------------------------------
+
+// Helpers to build a minimal brick and a ball with an explicit previous position.
+function brick(x = 100, y = 200, w = 72, h = 20) {
+  return { x, y, w, h, alive: true, row: 0, points: 10 };
+}
+
+function ballAt(x, y, vx, vy, px = x, py = y) {
+  return { x, y, r: 7, vx, vy, px, py };
+}
+
+test('#1 bounce: head-on top hit flips vy only', () => {
+  const b = brick();
+  // Ball climbs (vy < 0) into the bottom face of the brick.
+  const ball = ballAt(130, 216, 0, -500, 130, 240);
+  const hit = bounceBricks(ball, [b]);
+  assert.deepEqual(hit, [b]);
+  assert.ok(ball.vy > 0, 'should bounce back downward: ' + ball.vy);
+  assert.equal(ball.vx, 0, 'horizontal component must be left unchanged');
+});
+
+test('#1 bounce: side hit flips vx only', () => {
+  const b = brick(); // occupies x 100..172, y 200..220
+  // Ball drives sideways (left) into the right face of the brick.
