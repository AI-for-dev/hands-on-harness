+// --- Issue #1: brick bounce ------------------------------------------------
+
+const BRICK = { x: 100, y: 100, w: 72, h: 20, alive: true };
+
+test('brick bounce: top face hit flips vy and pushes the ball above the brick', () => {
+  // Ball drops almost straight down onto the brick's top face.
+  const prev = { x: 136, y: 92 };
+  const ball = { x: 136, y: 118, r: 7, vx: 0, vy: 300 };
+
+  const hit = sweptHit(prev.x, prev.y, ball, BRICK);
+  assert.ok(hit, 'the swept segment should hit the brick');
+  assert.equal(hit.ny, -1, 'the hit face should be the top (normal up)');
+  assert.equal(hit.nx, 0, 'no sideways face involved');
+
+  applyBounce({ ball }, hit);
+  assert.ok(ball.vy < 0, 'vy reverses to travel upward');
+  assert.equal(ball.vx, 0, 'horizontal velocity untouched');
+  assert.ok(ball.y <= BRICK.y - ball.r, 'ball pushed strictly above the brick');
+});
+
+test('brick bounce: side face hit flips vx and pushes the ball left', () => {
+  // Ball travels right into the brick's left face (starts left of the brick).
+  const prev = { x: 80, y: 110 };
+  const ball = { x: 230, y: 110, r: 7, vx: 300, vy: 0 };
+
+  const hit = sweptHit(prev.x, prev.y, ball, BRICK);
+  assert.ok(hit, 'the swept segment should hit the brick');
+  assert.equal(hit.nx, -1, 'the hit face should be the left (normal pointing left)');
+
+  applyBounce({ ball }, hit);
+  assert.ok(ball.vx < 0, 'vx reverses to travel left');
+  assert.ok(ball.x <= BRICK.x - ball.r, 'ball pushed strictly left of the brick');
+});
+
+test('brick bounce: ball not on course => no hit', () => {
+  const prev = { x: 20, y: 20 };
+  const ball = { x: 20, y: 460, r: 7, vx: 0, vy: 300 };
+  assert.equal(sweptHit(prev.x, prev.y, ball, BRICK), null);
+});
+
