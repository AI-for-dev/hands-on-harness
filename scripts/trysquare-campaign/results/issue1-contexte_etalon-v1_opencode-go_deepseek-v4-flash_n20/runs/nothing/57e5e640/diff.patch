+// --- Brick bounce (issue #1): continuous collision -------------------------
+//
+// The ball travels from (px,py) to (ball.x,ball.y) during one frame. A naive
+// check only against the ball's *final* box lets a fast ball jump clean over a
+// thin brick (tunnelling, see #1). `sweptHit` therefore tests the whole swept
+// segment against the brick's AABB grown by the ball radius, which catches:
+//   * direct overlap (the ball is inside the brick this frame);
+//   * tunnelling (level 6 = 710 px/s, 35.5 px/step, can clear a brick in a frame).
+
+// Returns `{ t, brick, nx, ny }` where `t` is the first time in [0,1] along the
+// segment the ball's circle crosses into the brick, and (nx,ny) is the inward-
+// *outward* normal of the face that was hit. Returns null if no face is crossed.
+// Uses a Liang-Barsky slab test against the radius-expanded box.
+export function sweptHit(px, py, ball, brick) {
+  const r = ball.r;
+  const x0 = brick.x - r;
+  const x1 = brick.x + brick.w + r;
+  const y0 = brick.y - r;
+  const y1 = brick.y + brick.h + r;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+
+  let tmin = 0;
+  let tmax = 1;
+  let entry = -1; // 0:x0  1:x1  2:y0  3:y1  (the face crossed on entry)
+
+  const q = [px - x0, x1 - px, py - y0, y1 - py];
+  const p = [-dx, dx, -dy, dy];
+
+  for (let i = 0; i < 4; i++) {
+    if (p[i] === 0) {
+      // Parallel to that slab: no crossing unless already inside on it.
+      if (q[i] < 0) return null;
+    } else {
+      const t = q[i] / p[i];
+      if (p[i] < 0) {
+        // Entering this face.
+        if (t > tmin) {
+          tmin = t;
+          entry = i;
+        }
+        if (t > tmax) return null; // entry happens after we already exited
+      } else {
+        if (t < tmax) tmax = t; // exiting
+      }
+    }
+  }
+
+  if (entry < 0 || tmin > tmax || tmin < 0 || tmin > 1) return null;
+
+  // Outward normal of the entered face: the direction the ball is pushed back.
+  const normal = {
+    0: { nx: -1, ny: 0 }, // low x  : pushed toward the left
+    1: { nx: 1, ny: 0 },  // high x : pushed toward the right
+    2: { nx: 0, ny: -1 }, // low y  : pushed up
+    3: { nx: 0, ny: 1 },  // high y : pushed down
+  }[entry];
+
+  return { t: tmin, brick, ...normal };
+}
+
+// Sweeps the ball against every live brick. Returns which bricks were hit
+// (in this single pass) and the *single* bounce to apply.
+//
+// The grid gap (8 px) is narrower than the ball's diameter (14 px), so a ball
+// straddling a seam overlaps two bricks in the very same pass. If we reflected
+// per brick, `vy = -vy` twice would cancel out (the second bounce undoes the
+// first) and the ball would keep going. Taking only the *earliest* hit — and
+// pushing the ball out — is what makes the bounce apply exactly once.
+export function brickHits(px, py, ball, bricks) {
+  const hit = [];
+  let bounce = null;
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    const h = sweptHit(px, py, ball, brick);
+    if (h) {
+      hit.push(brick);
+      if (!bounce || h.t < bounce.t) bounce = h;
+    }
+  }
+  return { hit, bounce };
+}
