+// Reflects the ball off the face of the brick it overlapped and pushes it back
+// out so it can never tunnel through. Returns `true` when a bounce happened.
+// Which face was hit is decided by the axis of least penetration: a top/bottom
+// hit flips `vy`, a left/right hit flips `vx`. Correcting the position keeps
+// the ball from getting stuck inside a brick across successive frames.
+export function bounceBall(ball, brick) {
+  // Penetration from each of the four faces, all positive when overlapping.
+  const overlapLeft = (brick.x + brick.w) - (ball.x - ball.r);
+  const overlapRight = (ball.x + ball.r) - brick.x;
+  const overlapTop = (brick.y + brick.h) - (ball.y - ball.r);
+  const overlapBottom = (ball.y + ball.r) - brick.y;
+
+  const minX = Math.min(overlapLeft, overlapRight);
+  const minY = Math.min(overlapTop, overlapBottom);
+
+  // Bounce off the closest face: smallest penetration wins. For a face to the
+  // LEFT of its neighbor, the ball has barely crossed that edge, so the byte
+  // measured from that edge (penetration through it) is the smallest.
+  if (minY < minX) {
+    if (overlapBottom < overlapTop) {
+      // Ball barely crossed the TOP edge: send it back up.
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      // Ball barely crossed the BOTTOM edge: send it back down.
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  } else {
+    if (overlapRight < overlapLeft) {
+      // Ball barely crossed the LEFT edge: send it back left.
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      // Ball barely crossed the RIGHT edge: send it back right.
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+  }
+  return true;
+}
