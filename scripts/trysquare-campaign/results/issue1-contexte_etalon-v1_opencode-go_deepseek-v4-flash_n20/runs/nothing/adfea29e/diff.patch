 // --- Rendering (DOM): brick collision logic STILL mixed in here ------------
 
+// Ejects the ball out of a brick it just hit and flips the velocity component
+// for the face that was struck (top/bottom -> vy, sides -> vx). Which face was
+// hit is decided by comparing how far the ball penetrated the brick along each
+// axis: the shallower penetration is the face it hit. Pushing the ball back out
+// of the brick prevents it from sticking to (or tunneling through) the brick.
+function bounceOffBrick(ball, brick) {
+  // Overlap on each axis (>= 0 whenever collides() is true).
+  const overlapX = Math.min(ball.x + ball.r - brick.x, brick.x + brick.w - (ball.x - ball.r));
+  const overlapY = Math.min(ball.y + ball.r - brick.y, brick.y + brick.h - (ball.y - ball.r));
+
+  const ballCenterY = ball.y;
+  const brickCenterY = brick.y + brick.h / 2;
+
+  if (overlapY < overlapX) {
+    // Top/bottom face: flip vertical velocity and push out vertically.
+    if (ballCenterY < brickCenterY) {
+      ball.y -= overlapY;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y += overlapY;
+      ball.vy = Math.abs(ball.vy);
+    }
+  } else {
+    // Side face: flip horizontal velocity and push out horizontally.
+    if (ball.x < brick.x) {
+      ball.x -= overlapX;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x += overlapX;
+      ball.vx = Math.abs(ball.vx);
+    }
+  }
+}
+
 // Main render loop. For each live brick we test collision AND draw in the same
 // pass: this is where logic and rendering are entangled.
 export function frame(ctx, state) {
