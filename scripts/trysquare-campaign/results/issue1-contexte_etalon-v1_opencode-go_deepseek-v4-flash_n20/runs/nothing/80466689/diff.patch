+// --- brickHit: the issue #1 fix -------------------------------------------
+
+// Builds a state with the ball inside the first brick, approaching from the top.
+function stateWithBallOnFirstBrick(vx) {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball = {
+    x: brick.x + brick.w / 2,
+    y: brick.y + brick.h / 2,
+    r: 7,
+    vx,
+    vy: 200,
+    prev: { x: brick.x + brick.w / 2, y: brick.y - 30 },
+  };
+  return state;
+}
+
+function makeBrick(x, y, w, h) {
+  return { x, y, w, h, row: 0, alive: true, points: 10 };
+}
+
+test('brickHit: destroys the brick it hits', () => {
+  const state = stateWithBallOnFirstBrick(0);
+  const hit = brickHit(state);
+  assert.equal(hit, state.bricks[0]);
+  assert.equal(state.bricks[0].alive, false);
+});
+
+test('brickHit: top/bottom hit flips vy, keeps vx, and pushes the ball out', () => {
+  const state = stateWithBallOnFirstBrick(0);
+  const prevVy = state.ball.vy;
+  const prevVx = state.ball.vx;
+  brickHit(state);
+  assert.equal(state.ball.vy, -prevVy);
+  assert.equal(state.ball.vx, prevVx);
+  assert.ok(
+    state.ball.y + state.ball.r <= state.bricks[0].y,
+    `ball at y=${state.ball.y} should sit above the brick's top (${state.bricks[0].y})`,
+  );
+});
+
