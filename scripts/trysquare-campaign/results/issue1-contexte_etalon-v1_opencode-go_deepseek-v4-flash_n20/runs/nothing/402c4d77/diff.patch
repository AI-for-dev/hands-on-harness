+// --- Issue #1: the ball must BOUNCE off bricks, not plow through them. -------
+// Each scenario targets one edge case from ISSUES.md #1: per-face bounce,
+// push-out, corner, the seam that overlaps two bricks at once, and tunnelling.
+
+// A single brick at (100,100)-(172,120) with a ball already overlapping it and
+// a recorded `prev*` position that simulates the last frame's approach.
+function oneBrick(ball) {
+  return {
+    level: 1,
+    combo: 0,
+    score: 0,
+    bricks: [{ x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 50 }],
+    ball: { r: BALL_R, ...ball },
+  };
+}
+
+test('brick bounce: below brick going up => bounces down and clears the brick', () => {
+  const state = oneBrick({ x: 136, y: 124, prevX: 136, prevY: 132, vx: 0, vy: -300 });
+  assert.equal(resolveBricks(state), true);
+  assert.equal(state.bricks[0].alive, false, 'the brick is broken');
+  assert.ok(state.ball.vy > 0, 'vertical velocity reflects back down');
+  assert.equal(state.ball.vx, 0, 'horizontal velocity untouched');
+  assert.ok(state.ball.y > 100 + BRICK_H, 'ball pushed out below the brick');
+});
+
+test('brick bounce: above brick going down => bounces up and clears the brick', () => {
+  const state = oneBrick({ x: 136, y: 96, prevX: 136, prevY: 92, vx: 0, vy: 300 });
+  resolveBricks(state);
+  assert.ok(state.ball.vy < 0, 'vertical velocity reflects back up');
+  assert.equal(state.ball.vx, 0);
+  assert.ok(state.ball.y < 100, 'ball pushed out above the brick');
+});
+
+test('brick bounce: left of brick going right => bounces left, vy untouched', () => {
+  const state = oneBrick({ x: 94, y: 110, prevX: 91, prevY: 110, vx: 300, vy: 0 });
+  resolveBricks(state);
+  assert.ok(state.ball.vx < 0, 'horizontal velocity reflects back left');
+  assert.equal(state.ball.vy, 0, 'vertical velocity untouched');
+  assert.ok(state.ball.x < 100, 'ball pushed out left of the brick');
+});
+
+test('brick bounce: right of brick going left => bounces right, vy untouched', () => {
+  const state = oneBrick({ x: 176, y: 110, prevX: 179, prevY: 110, vx: -300, vy: 0 });
+  resolveBricks(state);
+  assert.ok(state.ball.vx > 0, 'horizontal velocity reflects back right');
+  assert.equal(state.ball.vy, 0);
+  assert.ok(state.ball.x > 100 + BRICK_W, 'ball pushed out right of the brick');
+});
+
+test('brick bounce: seam overlaps two bricks but flips vx exactly once', () => {
+  // Two bricks side by side (72 wide + 8 px gap): the 14 px ball straddles the
+  // 172..180 seam at once. Both bricks break, but a vx=+300 approach must come
+  // out as vx<0 — if the bounce were applied once per brick the two flips would
+  // cancel and the ball would sail straight through.
+  const state = {
+    level: 1,
+    combo: 0,
+    score: 0,
+    bricks: [
+      { x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 },
+      { x: 100 + BRICK_W + 8, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 },
+    ],
+    ball: { r: BALL_R, x: 176, y: 110, prevX: 173, prevY: 110, vx: 300, vy: 0 },
+  };
+  resolveBricks(state);
+  assert.ok(state.ball.vx < 0, 'seam hit flips vx exactly once');
+  assert.ok(!state.bricks[0].alive && !state.bricks[1].alive, 'both seam bricks break');
+});
+
+test('brick bounce: tunnelled straight through is still caught and bounced', () => {
+  // If detection were point-in-time, the ball jumping from below the row to far
+  // above it (no current overlap) would never touch the brick. The swept test
+  // catches it and bounces the dominant axis back down.
+  const state = oneBrick({ x: 136, y: 60, prevX: 136, prevY: 150, vx: 0, vy: -400 });
+  const hit = resolveBricks(state);
+  assert.equal(hit, true, 'swept collision still detects the crossing');
+  assert.equal(state.bricks[0].alive, false);
+  assert.ok(state.ball.vy > 0, 'ball bounces back down');
+});
