+// True if the ball's path from (x0,y0) to (x1,y1), swept with radius `r`, ever
+// crosses the brick. A point-in-time AABB check misses a ball that jumps the
+// whole brick in one frame (see #1, "tunnelling": at level 6 a stuttered
+// 50 ms frame moves the ball ~35.5 px against a ~34 px barrier).
+export function sweptOverlaps(x0, y0, x1, y1, r, brick) {
+  return (
+    Math.max(x0, x1) + r > brick.x &&
+    Math.min(x0, x1) - r < brick.x + brick.w &&
+    Math.max(y0, y1) + r > brick.y &&
+    Math.min(y0, y1) - r < brick.y + brick.h
+  );
+}
+
+// Kills every brick the ball crossed during the last step and applies exactly
+// ONE bounce whose face is the axis of minimal penetration across the whole
+// group (see #1). This handles all the tricky cases in one place:
+//   * per face  — the smaller penetration axis is the face that was hit;
+//   * corner    — roughly equal penetrations mean a diagonal hit, flip both;
+//   * push out  — the ball is repositioned outside the brick so it cannot
+//                 re-collide on the next frame (sticky bounce);
+//   * neighbours — the 8 px gap overlaps two bricks in one pass; because the
+//                 bounce is applied to the group exactly once, the seams no
+//                 longer double-flip (vy = -vy twice would cancel out).
+//   * tunnelling — sweptOverlaps catches the jump, and we bounce the dominant
+//                 axis of travel for a ball that passed clean through.
+// Returns true if anything was hit.
+export function resolveBricks(state) {
+  const { ball } = state;
+  const x0 = ball.prevX ?? ball.x;
+  const y0 = ball.prevY ?? ball.y;
+
+  const contacts = state.bricks.filter(
+    (b) => b.alive && sweptOverlaps(x0, y0, ball.x, ball.y, ball.r, b),
+  );
+  if (!contacts.length) return false;
+
+  for (const brick of contacts) {
+    brick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(brick, state.combo);
+  }
+
+  // Tunnelled clean through: the ball no longer overlaps anything, so there is
+  // no face or brick edge to push out of. Bounce the dominant travel axis.
+  if (!contacts.some((b) => collides(ball, b))) {
+    if (Math.abs(ball.vx) >= Math.abs(ball.vy)) ball.vx = -ball.vx;
+    else ball.vy = -ball.vy;
+    return true;
+  }
+
+  // Which border did the ball cross? For each brick compute how deep it sits in
+  // on every side; the smallest depth across the group is the face to bounce.
+  // Only the AXIS needs to be disambiguated (the face is ambiguous at a seam,
+  // where a ball straddling the 8 px gap overlaps two borders at equal depth).
+  let minX = Infinity;
+  let minY = Infinity;
+  for (const brick of contacts) {
+    minX = Math.min(
+      minX,
+      ball.x + ball.r - brick.x, // entered through the LEFT border
+      brick.x + brick.w - (ball.x - ball.r), // ...RIGHT border
+    );
+    minY = Math.min(
+      minY,
+      ball.y + ball.r - brick.y, // entered through the TOP border
+      brick.y + brick.h - (ball.y - ball.r), // ...BOTTOM border
+    );
+  }
+  if (!Number.isFinite(minX) || !Number.isFinite(minY)) return true;
+
+  // Bounds of the whole contacted group, so the push-out below clears every
+  // brick at once (not just the shallowest one) and cannot leave a neighbour
+  // overlapping the ball.
+  let minLeft = Infinity;
+  let maxRight = -Infinity;
+  let minTop = Infinity;
+  let maxBottom = -Infinity;
+  for (const brick of contacts) {
+    minLeft = Math.min(minLeft, brick.x);
+    maxRight = Math.max(maxRight, brick.x + brick.w);
+    minTop = Math.min(minTop, brick.y);
+    maxBottom = Math.max(maxBottom, brick.y + brick.h);
+  }
+
+  const corner = Math.abs(minX - minY) <= 2; // diagonal hit: flip both axes
+  if (corner) {
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+  } else if (minX <= minY) {
+    // Side hit: reflect vx (vy stays exactly as it was), pushing in the
+    // direction the ball now travels so it never re-overlaps the group.
+    ball.vx = -ball.vx;
+    ball.x = ball.vx > 0 ? maxRight + ball.r : minLeft - ball.r;
+  } else {
+    // Top/bottom hit: reflect vy (vx stays exactly as it was).
+    ball.vy = -ball.vy;
+    ball.y = ball.vy > 0 ? maxBottom + ball.r : minTop - ball.r;
+  }
+
+  if (corner) {
+    ball.x = ball.vx > 0 ? maxRight + ball.r : minLeft - ball.r;
+    ball.y = ball.vy > 0 ? maxBottom + ball.r : minTop - ball.r;
+  }
+  return true;
+}
