+// Deflects the ball off the top/bottom or left/right face of a brick and
+// pushes it back out so it no longer overlaps. Returned as a pure function
+// operating on the given brick (fixes #1: the ball used to plow straight
+// through bricks, only ever deflected by walls and the paddle in step()).
+//
+// Which face was hit is decided by the axis with the SMALLEST penetration:
+// a head-on vertical hit overlaps mostly in x, so we flip vy; a side hit
+// overlaps mostly in y, so we flip vx. The ball is then nudged out along that
+// same axis by exactly the overlap.
+export function bounceBall(ball, brick) {
+  // Penetration depth on each axis (positive = how far the ball's edge digs in).
+  const overlapLeft = ball.x + ball.r - brick.x;
+  const overlapRight = brick.x + brick.w - (ball.x - ball.r);
+  const overlapTop = ball.y + ball.r - brick.y;
+  const overlapBottom = brick.y + brick.h - (ball.y - ball.r);
+
+  const overlapX = Math.min(overlapLeft, overlapRight);
+  const overlapY = Math.min(overlapTop, overlapBottom);
+
+  if (overlapX <= overlapY) {
+    // Vertical faces (sides of the brick): flip horizontal velocity.
+    const fromLeft = overlapLeft < overlapRight;
+    ball.vx = fromLeft ? Math.abs(ball.vx) : -Math.abs(ball.vx);
+    // Push the ball back out past the side it came from.
+    ball.x = fromLeft ? brick.x - ball.r : brick.x + brick.w + ball.r;
+  } else {
+    // Horizontal faces (top/bottom of the brick): flip vertical velocity.
+    const fromTop = overlapTop < overlapBottom;
+    ball.vy = fromTop ? Math.abs(ball.vy) : -Math.abs(ball.vy);
+    // Push the ball back out past the face it came from.
+    ball.y = fromTop ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  }
+}
