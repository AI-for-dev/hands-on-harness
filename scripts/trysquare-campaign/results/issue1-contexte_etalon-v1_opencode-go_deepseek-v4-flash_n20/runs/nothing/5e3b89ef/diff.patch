+// Sweeps the ball along the segment from (prevX, prevY) to (ball.x, ball.y)
+// and returns the FIRST contact with the brick, or null when there is none.
+// The brick gap is 8 px and the ball 14 px across, so a fast shot at high
+// level can jump a whole brick in one step: a static overlap test would miss
+// it (tunnelling, #1). Treating the brick as an AABB expanded by the ball's
+// radius and solving for when the moving center crosses it catches that.
+// Returns `{ t, x, y, face }` — the entry time in [0,1], the contact position
+// and which face was struck (`top`/`bottom`/`left`/`right`/`corner`).
+export function sweepBrick(ball, prevX, prevY, brick) {
+  // Expanded box: the center may roam within it before the circle touches.
+  const bx1 = brick.x - ball.r;
+  const bx2 = brick.x + brick.w + ball.r;
+  const by1 = brick.y - ball.r;
+  const by2 = brick.y + brick.h + ball.r;
+
+  const dx = ball.x - prevX;
+  const dy = ball.y - prevY;
+
+  // Axis helper -> entry/exit times for the center over the expanded range,
+  // or null when the segment never overlaps on that axis.
+  function slab(v, start, min, max) {
+    if (v === 0) {
+      if (start < min || start > max) return null;
+      return { t0: -Infinity, t1: Infinity };
+    }
+    let t0 = (min - start) / v;
+    let t1 = (max - start) / v;
+    if (t0 > t1) [t0, t1] = [t1, t0];
+    return { t0, t1 };
+  }
+
+  const ex = slab(dx, prevX, bx1, bx2);
+  const ey = slab(dy, prevY, by1, by2);
+  if (!ex || !ey) return null;
+
+  // The axis that enters LAST is the face actually struck.
+  let face = 'corner';
+  if (ex.t0 > ey.t0 + 1e-9) {
+    face = dx > 0 ? 'left' : 'right';
+  } else if (ey.t0 > ex.t0 + 1e-9) {
+    face = dy > 0 ? 'top' : 'bottom';
+  }
+
+  const tEnter = Math.max(ex.t0, ey.t0, 0);
+  const tExit = Math.min(ex.t1, ey.t1, 1);
+  if (tEnter > tExit) return null;
+
+  return { t: tEnter, x: prevX + dx * tEnter, y: prevY + dy * tEnter, face };
+}
+
+// Applies a per-face bounce: only the axis that was hit gets flipped (vy on a
+// top/bottom hit, vx on a side hit, both on a corner), then the ball is pushed
+// OUT to the contact point so it no longer overlaps — an overlapping ball
+// would re-flip for ever (sticky bounce). Returns the ball for chaining.
+export function bounceOffBrick(ball, hit) {
+  if (hit.face === 'corner') {
+    // Equal penetration both ways: reverse both components.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x = hit.x;
+    ball.y = hit.y;
+    return ball;
+  }
+  if (hit.face === 'top' || hit.face === 'bottom') {
+    ball.vy = hit.face === 'top' ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+  } else if (hit.face === 'left' || hit.face === 'right') {
+    ball.vx = hit.face === 'left' ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+  }
+  ball.x = hit.x;
+  ball.y = hit.y;
+  return ball;
+}
