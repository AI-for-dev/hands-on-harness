+// --- #1: brick bounce ------------------------------------------------------
+// The ball must deflect off bricks instead of plowing straight through.
+// Each case below was a red test first, then made green by sweepBrick /
+// bounceOffBrick in neon.js.
+
+test('bounceOffBrick: top face flips vy up and leaves vx untouched', () => {
+  const ball = { x: 100, y: 44, r: 7, vx: 120, vy: 300 };
+  bounceOffBrick(ball, { face: 'top', x: 100, y: 40 });
+  assert.equal(ball.vy, -300, 'vertical component should now head up');
+  assert.equal(ball.vx, 120, 'horizontal component must not change on a top hit');
+});
+
+test('bounceOffBrick: side face flips vx and leaves vy untouched', () => {
+  const ball = { x: 63, y: 100, r: 7, vx: 240, vy: 150 };
+  bounceOffBrick(ball, { face: 'left', x: 63, y: 100 });
+  assert.equal(ball.vx, -240, 'horizontal component should now head left');
+  assert.equal(ball.vy, 150, 'vertical component must not change on a side hit');
+});
+
+test('bounceOffBrick: corner hit flips both components', () => {
+  const ball = { x: 100, y: 100, r: 7, vx: 240, vy: -300 };
+  bounceOffBrick(ball, { face: 'corner', x: 100, y: 100 });
+  assert.equal(ball.vx, -240);
+  assert.equal(ball.vy, 300);
+});
+
+test('bounceOffBrick: pushes the ball back out of the brick (no sticky bounce)', () => {
+  const ball = { x: 100, y: 300, r: 7, vx: 0, vy: 400 };
+  bounceOffBrick(ball, { face: 'top', x: 100, y: 40 });
+  assert.equal(ball.y, 40, 'ball should be repositioned above the brick face');
+});
+
+test('sweepBrick: catches a fast ball tunnelling through a brick in one step', () => {
+  // ballSpeed(6) = 710 px/s * 50 ms = 35.5 px per step, which jumps the brick
+  // (BRICK_H 20 + diameter 14 = 34 px) head-on. A static overlap (`collides`)
+  // sees the ball below the brick and reports a miss.
+  const brick = { x: 100, y: 100, w: 72, h: 20 };
+  const ball = { x: 100, y: 135, r: 7 }; // current: already past the brick
+
+  assert.equal(collides(ball, brick), false, 'static test alone would miss it');
+
+  const hit = sweepBrick(ball, 100, 10, brick); // segment crossed the whole brick
+  assert.ok(hit, 'swept motion must still register the crossing');
+  assert.equal(hit.face, 'top', 'a vertical descent should register as a top hit');
+  assert.ok(hit.t > 0 && hit.t < 1, 'contact should occur mid-segment');
+  assert.ok(hit.y >= 93 && hit.y <= 127, 'contact point should sit on the top face');
+});
+
+test('sweepBrick: a side hit is reported as a side face, not a top one', () => {
+  const brick = { x: 200, y: 100, w: 72, h: 20 };
+  const ball = { x: 290, y: 110, r: 7 }; // current: to the right of the brick
+  const hit = sweepBrick(ball, 180, 110, brick); // segment crossed from the left
+  assert.ok(hit, 'side crossing should be detected');
+  assert.equal(hit.face, 'left');
+});
+
