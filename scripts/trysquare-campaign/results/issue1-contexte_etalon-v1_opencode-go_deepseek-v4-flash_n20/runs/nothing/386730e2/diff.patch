+// Resolves a ball/brick collision for ONE brick: flips the velocity component
+// for the face that was hit (the axis with the smaller penetration; both if it
+// is a corner) and pushes the ball back outside the brick so it cannot overlap
+// again next frame (no sticky bounce).
+//
+// This is IDEMPOTENT by construction: we always *set* a component to the
+// correct sign for the hit face (`vy = -Math.abs(vy)` on a top hit) rather
+// than toggling it (`vy = -vy`). Because the 8px grid gap is smaller than the
+// 14px ball, one ball can legitimately overlap two adjacent bricks in the same
+// pass; flipping a component twice would cancel out and let the ball through.
+// Setting it twice yields the same value, so the bounce applies exactly once.
+//
+// NOTE: the push-out is computed from the ball's current position for each
+// brick. Adjacent bricks share an edge (same row / same column), so the push
+// for one clears the other too, and the idempotent flip below keeps everything
+// consistent even in the rare conflicting overlap.
+function resolveBounce(ball, brick) {
+  // How far each of the four faces of the ball has gone past the brick.
+  const penRight = ball.x + ball.r - brick.x; // ball from the left, moving right
+  const penLeft = brick.x + brick.w - (ball.x - ball.r); // ball from the right
+  const penBottom = ball.y + ball.r - brick.y; // ball from above, moving down
+  const penTop = brick.y + brick.h - (ball.y - ball.r); // ball from below
+
+  const penX = Math.min(penRight, penLeft);
+  const penY = Math.min(penBottom, penTop);
+
+  if (penY < penX) {
+    // Horizontal face (top or bottom): flip vy, push vertically.
+    if (penBottom <= penTop) {
+      ball.vy = -Math.abs(ball.vy); // was heading down
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.vy = Math.abs(ball.vy); // was heading up
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  } else if (penX < penY) {
+    // Vertical face (left or right): flip vx, push horizontally.
+    if (penRight <= penLeft) {
+      ball.vx = -Math.abs(ball.vx); // was heading right
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.vx = Math.abs(ball.vx); // was heading left
+      ball.x = brick.x + brick.w + ball.r;
+    }
+  } else {
+    // Corner: equal penetrations on both axes = diagonal hit, flip both.
+    if (penBottom <= penTop) ball.vy = -Math.abs(ball.vy);
+    else ball.vy = Math.abs(ball.vy);
+    if (penRight <= penLeft) ball.vx = -Math.abs(ball.vx);
+    else ball.vx = Math.abs(ball.vx);
+    // Push out along the axis of greater travel so the ball clears the corner.
+    if (Math.abs(ball.vy) >= Math.abs(ball.vx)) {
+      ball.y = penBottom <= penTop ? brick.y - ball.r : brick.y + brick.h + ball.r;
+    } else {
+      ball.x = penRight <= penLeft ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    }
+  }
+}
+
+// Resolve the ball's collision against ALL live bricks in one call (debt #2's
+// pure, testable replacement for the inline logic that used to live in the
+// draw loop). Destroys every brick the ball overlaps, bounces the ball off them
+// (exactly once per axis, see resolveBounce), and returns the destroyed bricks
+// so the caller can attribute score / combo.
+//
+// All overlaps are detected BEFORE any mutation, so the ball is resolved
+// against a consistent snapshot (no brick is skipped because an earlier one
+// already moved the ball out).
+export function brickHit(ball, bricks) {
+  const victims = [];
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    if (collides(ball, brick)) victims.push(brick);
+  }
+  if (victims.length === 0) return victims;
+
+  for (const brick of victims) {
+    brick.alive = false;
+    resolveBounce(ball, brick);
+  }
+  return victims;
+}
