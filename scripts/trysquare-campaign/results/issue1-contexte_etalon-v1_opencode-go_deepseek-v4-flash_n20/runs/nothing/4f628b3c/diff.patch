+// --- #1: brick bounce resolution -------------------------------------------------
+
+test('brick: top hit flips vy, leaves vx untouched, pushes out above', () => {
+  const brick = brickAt(100, 100); // y in [100,120]
+  const ball = { x: 120, y: 104, r: 7, vx: 30, vy: 200 }; // clipping the top face
+  const vxBefore = ball.vx;
+  const bounced = resolveBrickHit(ball, brick);
+  assert.equal(bounced, true);
+  assert.equal(ball.vy, -200, 'vy should flip from downward to upward');
+  assert.equal(ball.vx, vxBefore, 'vx must be left untouched on a top/bottom hit');
+  assert.equal(ball.y, brick.y - ball.r, 'ball pushed back out above the brick');
+  assert.equal(collides(ball, brick), false, 'ball no longer overlaps the brick');
+});
+
+test('brick: bottom hit flips vy upward pass to downward', () => {
+  const brick = brickAt(100, 100); // y in [100,120]
+  const ball = { x: 120, y: 116, r: 7, vx: -10, vy: -200 }; // clipping the bottom face
+  resolveBrickHit(ball, brick);
+  assert.equal(ball.vy, 200, 'vy should flip from upward to downward');
+  assert.equal(ball.y, brick.y + brick.h + ball.r, 'ball pushed back out below the brick');
+});
+
+test('brick: side hit flips vx, leaves vy untouched', () => {
+  const brick = brickAt(100, 100); // x in [100,140]
+  const ball = { x: 145, y: 110, r: 7, vx: -200, vy: 40 }; // clipping the right face
+  const vyBefore = ball.vy;
+  const bounced = resolveBrickHit(ball, brick);
+  assert.equal(bounced, true);
+  assert.equal(ball.vx, 200, 'vx should flip from leftward to rightward');
+  assert.equal(ball.vy, vyBefore, 'vy must be left untouched on a side hit');
+  assert.equal(ball.x, brick.x + brick.w + ball.r, 'ball pushed back out right of the brick');
+});
+
+test('brick: equal penetrations = corner, flips both components', () => {
