+// --- Brick bounce resolution (#1) ------------------------------------------
+//
+// Resolves a single ball-vs-brick collision: flips the correct velocity
+// component(s) and pushes the ball back OUT of the brick. Returns true if a
+// bounce was applied.
+//
+//   per face : the axis with the SMALLER penetration is the face that was hit;
+//              flip `vy` on a top/bottom hit, `vx` on a side hit, and leave the
+//              other component exactly as it was.
+//   corner   : equal penetrations mean a diagonal hit - flip both components.
+//   push out : the ball is repositioned just outside the brick rectangle, so it
+//              does not still overlap on the next frame (no sticky re-bounce)
+//              nor re-flip against a neighbouring brick in the same pass.
+//   tunnel   : detection is discrete, so at high speed the ball can jump over a
+//              brick in a single *step*. The movement is swept between the
+//              previous and the current position so the bounce still happens.
+export function resolveBrickHit(ball, brick, prevX = ball.prevX ?? ball.x, prevY = ball.prevY ?? ball.y) {
+  if (collides(ball, brick)) {
+    return bounceOverlap(ball, brick);
+  }
+  return bounceSwept(ball, brick, prevX, prevY);
+}
+
+// Ball already overlapping the brick: pick the face by the smaller penetration.
+function bounceOverlap(ball, brick) {
+  const overlapX =
+    Math.min(ball.x + ball.r, brick.x + brick.w) - Math.max(ball.x - ball.r, brick.x);
+  const overlapY =
+    Math.min(ball.y + ball.r, brick.y + brick.h) - Math.max(ball.y - ball.r, brick.y);
+
+  const bounceX = overlapX <= overlapY;
+  const bounceY = overlapY <= overlapX;
+
+  if (bounceX) {
+    ball.x = ball.vx > 0 ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    ball.vx = -ball.vx;
+  }
+  if (bounceY) {
+    ball.y = ball.vy > 0 ? brick.y - ball.r : brick.y + brick.h + ball.r;
+    ball.vy = -ball.vy;
+  }
+  return true;
+}
+
+// Ball jumped over the brick in this step: sweep the previous->current segment
+// against the brick (expanded by the ball radius) and bounce off the face the
+// segment first enters.
+function bounceSwept(ball, brick, prevX, prevY) {
+  const hit = sweptBrickHit(brick, prevX, prevY, ball.x, ball.y, ball.r);
+  if (!hit) return false;
+  if (hit.nx !== 0) {
+    ball.x = hit.nx < 0 ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    ball.vx = -ball.vx;
+  }
+  if (hit.ny !== 0) {
+    ball.y = hit.ny < 0 ? brick.y - ball.r : brick.y + brick.h + ball.r;
+    ball.vy = -ball.vy;
+  }
+  return true;
+}
+
+// Slab sweep of the moving ball center (radius r) from (p0x,p0y) to (p1x,p1y)
+// against the brick AABB expanded by r. Returns the first face hit, or null.
+function sweptBrickHit(brick, p0x, p0y, p1x, p1y, r) {
+  const dx = p1x - p0x;
+  const dy = p1y - p0y;
+  const left = brick.x - r;
+  const right = brick.x + brick.w + r;
+  const top = brick.y - r;
+  const bottom = brick.y + brick.h + r;
+
+  let txEntry = -Infinity;
+  let txExit = Infinity;
+  let nx = 0;
+  if (dx === 0) {
+    if (p0x <= left || p0x >= right) return null;
+  } else {
+    txEntry = Math.min((left - p0x) / dx, (right - p0x) / dx);
+    txExit = Math.max((left - p0x) / dx, (right - p0x) / dx);
+    nx = dx > 0 ? LEFT : RIGHT; // entering from the left (normal -1) or right (+1)
+  }
+
+  let tyEntry = -Infinity;
+  let tyExit = Infinity;
+  let ny = 0;
+  if (dy === 0) {
+    if (p0y <= top || p0y >= bottom) return null;
+  } else {
+    tyEntry = Math.min((top - p0y) / dy, (bottom - p0y) / dy);
+    tyExit = Math.max((top - p0y) / dy, (bottom - p0y) / dy);
+    ny = dy > 0 ? UP : DOWN; // entering from the top (normal -1) or bottom (+1)
+  }
+
+  const entry = Math.max(txEntry, tyEntry);
+  const exit = Math.min(txExit, tyExit);
+  if (entry > exit || exit <= 0 || entry >= 1) return null;
+
+  // The axis whose slab is entered last (the smaller penetration) is the face
+  // hit; equal entry times mean a diagonal (corner) hit - flip both.
+  const hitX = nx !== 0 && txEntry >= tyEntry;
+  const hitY = ny !== 0 && tyEntry >= txEntry;
+  return { t: Math.max(0, entry), nx: hitX ? nx : 0, ny: hitY ? ny : 0 };
+}
+
+// Moves the ball out of a single brick's rectangle along the least-penetrated
+// axis, WITHOUT touching the velocity. Used to clear residual overlap after the
+// one genuine bounce has already flipped the ball's course.
+function pushOutOf(ball, brick) {
+  if (!collides(ball, brick)) return;
+  const overlapX =
+    Math.min(ball.x + ball.r, brick.x + brick.w) - Math.max(ball.x - ball.r, brick.x);
+  const overlapY =
+    Math.min(ball.y + ball.r, brick.y + brick.h) - Math.max(ball.y - ball.r, brick.y);
+  if (overlapX <= overlapY) {
+    ball.x = ball.x <= brick.x + brick.w / 2 ? brick.x - ball.r : brick.x + brick.w + ball.r;
+  } else {
+    ball.y = ball.y <= brick.y + brick.h / 2 ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  }
+}
+
+// Lightweight penetration measure used to pick the brick whose face actually
+// deflected the ball (the one entered the least).
+function minPenetration(ball, brick) {
+  const overlapX =
+    Math.min(ball.x + ball.r, brick.x + brick.w) - Math.max(ball.x - ball.r, brick.x);
+  const overlapY =
+    Math.min(ball.y + ball.r, brick.y + brick.h) - Math.max(ball.y - ball.r, brick.y);
+  return Math.min(overlapX, overlapY);
+}
+
+// Runs brick collision for a whole state: destroys every touched brick, applies
+// score & combo, and lets the ball bounce off the brick it entered most cleanly.
+// The velocity flip is applied EXACTLY ONCE per pass: the 8 px grid seam lets a
+// 14 px ball overlap two neighbouring bricks at once, and `vy = -vy` (or vx)
+// applied twice cancels out - the ball would otherwise plow straight through.
+// After the single bounce the ball is pushed clear of every touched brick.
+export function applyBrickHits(state) {
+  const { ball, bricks } = state;
+  const prevX = ball.prevX ?? ball.x;
+  const prevY = ball.prevY ?? ball.y;
+
+  // Pass 1: find every brick the ball touches (overlap, or a swept tunnel hit),
+  // destroying it and scoring without yet mutating the ball.
+  const touched = [];
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    if (collides(ball, brick) || sweptBrickHit(brick, prevX, prevY, ball.x, ball.y, ball.r)) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+      touched.push(brick);
+    }
+  }
+  if (touched.length === 0) return false;
+
+  // Pass 2: a single bounce. Prefer the cleanest (least-penetrated) overlap; if
+  // the ball only tunnelled, bounce off the first swept contact.
+  const overlaps = touched.filter((b) => collides(ball, b));
+  if (overlaps.length > 0) {
+    let chosen = overlaps[0];
+    for (const b of overlaps) {
+      if (minPenetration(ball, b) < minPenetration(ball, chosen)) chosen = b;
+    }
+    resolveBrickHit(ball, chosen);
+  } else {
+    for (const b of touched) {
+      if (resolveBrickHit(ball, b, prevX, prevY)) break;
+    }
+  }
+
+  // Pass 3: clear the ball out of any brick it still overlaps (no velocity
+  // change) so it does not stick or look inside a brick on the next frame.
+  for (const b of touched) pushOutOf(ball, b);
+
+  return true;
+}
