+// Bounces the ball off the brick it overlaps, flipping the velocity component
+// for the face actually hit (vy on a top/bottom hit, vx on a side hit) and
+// pushing the ball back out so it cannot sink in and tunnel through.
+export function bounceBall(ball, brick) {
+  // How far the ball has penetrated through each face (positive = overlaps).
+  const fromLeft = ball.x + ball.r - brick.x;
+  const fromRight = brick.x + brick.w - (ball.x - ball.r);
+  const fromTop = ball.y + ball.r - brick.y;
+  const fromBottom = brick.y + brick.h - (ball.y - ball.r);
+
+  // The face with the shallowest penetration is the one being hit.
+  const minX = Math.min(fromLeft, fromRight);
+  const minY = Math.min(fromTop, fromBottom);
+
+  if (minX < minY) {
+    // Side hit: flip horizontal travel and push back out sideways.
+    ball.vx = fromLeft < fromRight ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+    if (fromLeft < fromRight) {
+      ball.x = brick.x - ball.r; // hit the left face, push out to the left
+    } else {
+      ball.x = brick.x + brick.w + ball.r; // hit the right face, push out right
+    }
+  } else {
+    // Top/bottom hit: flip vertical travel and push back out vertically.
+    ball.vy = fromTop < fromBottom ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+    if (fromTop < fromBottom) {
+      ball.y = brick.y - ball.r; // hit the top face, push up
+    } else {
+      ball.y = brick.y + brick.h + ball.r; // hit the bottom face, push down
+    }
+  }
+}
