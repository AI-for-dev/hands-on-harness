+// --- Brick collision resolution (Issue #1) ---------------------------------
+
+// Swept collision: does the moving ball (a segment from the previous position
+// to the current one, fattened by the radius r) cross the expanded brick? If
+// so, returns the earliest time of impact t in [0,1] and the face normal
+// (nx, ny). Discrete endpoint checks alone would let a fast ball jump straight
+// over a brick — see the level-6 tunnelling case. Returns null when untouched.
+function sweptBrickHit(prevX, prevY, curX, curY, brick, r) {
+  const dx = curX - prevX;
+  const dy = curY - prevY;
+  // Expand the brick AABB by the ball radius so a circle maps to a rectangle.
+  const minX = brick.x - r;
+  const maxX = brick.x + brick.w + r;
+  const minY = brick.y - r;
+  const maxY = brick.y + brick.h + r;
+
+  let tmin = 0;
+  let tmax = 1;
+  let nx = 0;
+  let ny = 0;
+
+  // X slab.
+  if (Math.abs(dx) < 1e-9) {
+    if (prevX < minX || prevX > maxX) return null;
+  } else {
+    let t1 = (minX - prevX) / dx;
+    let t2 = (maxX - prevX) / dx;
+    let normal = -1;
+    if (t1 > t2) {
+      const tmp = t1;
+      t1 = t2;
+      t2 = tmp;
+      normal = 1;
+    }
+    if (t1 > tmin) {
+      tmin = t1;
+      nx = normal;
+    }
+    if (t2 < tmax) tmax = t2;
+    if (tmin > tmax) return null;
+  }
+
+  // Y slab.
+  if (Math.abs(dy) < 1e-9) {
+    if (prevY < minY || prevY > maxY) return null;
+  } else {
+    let t1 = (minY - prevY) / dy;
+    let t2 = (maxY - prevY) / dy;
+    let normal = -1;
+    if (t1 > t2) {
+      const tmp = t1;
+      t1 = t2;
+      t2 = tmp;
+      normal = 1;
+    }
+    if (t1 > tmin) {
+      tmin = t1;
+      ny = normal;
+    }
+    if (t2 < tmax) tmax = t2;
+    if (tmin > tmax) return null;
+  }
+
+  if (tmin >= 0 && tmin <= 1) return { t: tmin, nx, ny };
+  return null;
+}
+
+// Resolves the ball's bounce against every brick swept during the step, using
+// the previous frame's position for the sweep. Destroys the bricks hit, awards
+// score/combo, and deflects the ball once:
+//
+//   - per face: the axis entered later (the *smaller penetration*) owns the
+//     hit — flip vy on a top/bottom hit, vx on a side hit;
+//   - corner: equal penetrations flip both components;
+//   - push out: the ball is repositioned to the impact point and nudged clear
+//     of the brick so it can't re-trigger next frame (sticky bounce);
+//   - neighbours: only the EARLIEST hit drives the bounce, so the vertical
+//     flip is applied exactly once and never cancelled by an adjacent brick;
+//   - tunnelling: the sweep (above) catches fast shots that would otherwise
+//     skip a brick between two frames.
+//
+// The previous position is passed in so the step() caller owns the dt book-
+// keeping; this function stays a pure, testable brick resolver.
+export function resolveBrickCollision(state, prevX, prevY) {
+  const { ball, bricks } = state;
+
+  let earliest = null;
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    const hit = sweptBrickHit(prevX, prevY, ball.x, ball.y, brick, ball.r);
+    if (!hit) continue;
+
+    brick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(brick, state.combo);
+
+    if (!earliest || hit.t < earliest.t) earliest = hit;
+  }
+
+  if (!earliest) return;
+
+  // Reposition the ball to the impact point, then flip along the hit normal
+  // and push it just clear of the brick rectangle.
+  const hitX = prevX + (ball.x - prevX) * earliest.t;
+  const hitY = prevY + (ball.y - prevY) * earliest.t;
+  ball.x = hitX;
+  ball.y = hitY;
+
+  if (earliest.nx !== 0) {
+    ball.vx = -ball.vx;
+    ball.x += (earliest.nx > 0 ? 1 : -1) * (ball.r + 0.01);
+  }
+  if (earliest.ny !== 0) {
+    ball.vy = -ball.vy;
+    ball.y += (earliest.ny > 0 ? 1 : -1) * (ball.r + 0.01);
+  }
+}
