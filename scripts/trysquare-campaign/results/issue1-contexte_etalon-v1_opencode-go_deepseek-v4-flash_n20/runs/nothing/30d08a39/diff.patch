+// --- Issue #1: brick bounce resolution (see ISSUES.md) ---------------------
+
+test('brick bounce: top/bottom face flips vy, vx untouched', () => {
+  const ball = { x: 120, y: 126, r: 7, vx: 0, vy: -300 };
+  const brick = { x: 100, y: 100, w: 40, h: 20, alive: true };
+  const state = { score: 0, combo: 0, bricks: [brick], ball };
+  // Swept from one step of the current velocity: it rises into the brick.
+  const prevX = ball.x - ball.vx * (1 / 60); // 120
+  const prevY = ball.y - ball.vy * (1 / 60); // 131, below the expanded box
+  resolveBrickCollision(state, prevX, prevY, 1 / 60);
+  assert.equal(brick.alive, false, 'brick should be destroyed');
+  assert.ok(ball.vy > 0, 'vy flips sign (was moving up, now down)');
+  assert.equal(Math.abs(ball.vy), 300, 'speed magnitude is preserved');
+  assert.equal(ball.vx, 0, 'vx untouched on a vertical hit');
+  assert.ok(!collides(ball, brick), 'ball pushed out of the brick');
+});
+
+test('brick bounce: side face flips vx, vy untouched', () => {
+  const ball = { x: 96, y: 110, r: 7, vx: 300, vy: 0 };
+  const brick = { x: 100, y: 100, w: 40, h: 20, alive: true };
+  const state = { score: 0, combo: 0, bricks: [brick], ball };
+  const prevX = ball.x - ball.vx * (1 / 60);
+  const prevY = ball.y - ball.vy * (1 / 60);
+  resolveBrickCollision(state, prevX, prevY, 1 / 60);
+  assert.equal(brick.alive, false);
+  assert.ok(ball.vx < 0, 'vx flips sign (was moving right, now left)');
+  assert.equal(Math.abs(ball.vx), 300);
+  assert.equal(ball.vy, 0, 'vy untouched on a side hit');
+  assert.ok(!collides(ball, brick), 'ball pushed out of the brick');
+});
+
+test('brick bounce: corner (diagonal) flips both vx and vy', () => {
+  const ball = { x: 98, y: 124, r: 7, vx: 480, vy: -480 };
+  const brick = { x: 100, y: 100, w: 40, h: 20, alive: true };
+  const state = { score: 0, combo: 0, bricks: [brick], ball };
+  const prevX = ball.x - ball.vx * (1 / 60); // 90, below-left of the brick
+  const prevY = ball.y - ball.vy * (1 / 60); // 132
+  resolveBrickCollision(state, prevX, prevY, 1 / 60);
+  assert.equal(brick.alive, false);
+  assert.ok(ball.vx < 0, 'vx flips on a corner hit');
+  assert.ok(ball.vy > 0, 'vy flips on a corner hit');
+});
+
+test('brick bounce: two neighbouring bricks => bounce applied exactly once', () => {
+  // Ball rises through the seam between two adjacent bricks; a naive
+  // per-brick flip would reverse vy twice and cancel out (ball passes through).
+  const a = { x: 100, y: 100, w: 40, h: 20, alive: true };
+  const b = { x: 140, y: 100, w: 40, h: 20, alive: true }; // adjacent
+  const ball = { x: 139, y: 127, r: 7, vx: 0, vy: -300 };
+  const state = { score: 0, combo: 0, bricks: [a, b], ball };
+  const prevX = ball.x - ball.vx * (1 / 60);
+  const prevY = ball.y - ball.vy * (1 / 60);
+  resolveBrickCollision(state, prevX, prevY, 1 / 60);
+  assert.equal(a.alive, false);
+  assert.equal(b.alive, false);
+  assert.ok(ball.vy > 0, 'vy flipped exactly once (not cancelled out)');
+});
+
+test('brick bounce: fast shot does not tunnel through', () => {
+  // Level-6 speed with a large dt jumps 40px in one step — a discrete
+  // (endpoint-only) check would miss the brick entirely. The sweep catches it.
+  const brick = { x: 200, y: 200, w: 40, h: 20, alive: true };
+  const ball = { x: 220, y: 190, r: 7, vx: 0, vy: -2000 };
+  const state = { score: 0, combo: 0, bricks: [brick], ball };
+  const prevX = ball.x - ball.vx * 0.05; // 220
+  const prevY = ball.y - ball.vy * 0.05; // 290 (both endpoints outside the brick)
+  resolveBrickCollision(state, prevX, prevY, 0.05);
+  assert.equal(brick.alive, false, 'brick destroyed despite tunneling speed');
+  assert.ok(ball.vy > 0, 'ball bounced off instead of passing through');
+});
