+// Resolves the ball against every brick it currently overlaps (issue #1).
+//
+// All overlapping bricks are collected FIRST, then broken, then a SINGLE
+// bounce is applied to the group. That is what makes the 8 px grid seams
+// safe: the ball (14 px across) overlaps two bricks in one pass, and a
+// per-brick bounce would flip the same axis twice and cancel out.
+//
+// The bounce axis is the one with the smaller penetration (the face that was
+// hit): a side hit flips vx, a top/bottom hit flips vy, and equal
+// penetrations mean a corner hit that flips both. The ball is then pushed
+// back out of the brick, along the axis it came from, so it cannot overlap
+// again on the next frame (sticky bounce).
+//
+// Returns the list of broken bricks.
+export function resolveBricks(ball, bricks) {
+  const hits = bricks.filter((b) => b.alive && collides(ball, b));
+  if (hits.length === 0) return hits;
+
+  // Smallest penetration per axis across the whole group, and the brick
+  // responsible for it (the one the ball is deepest into on that axis).
+  let penX = Infinity;
+  let penY = Infinity;
+  let deepX = hits[0];
+  let deepY = hits[0];
+  for (const b of hits) {
+    const dx = Math.abs(ball.x - (b.x + b.w / 2));
+    const dy = Math.abs(ball.y - (b.y + b.h / 2));
+    const px = b.w / 2 + ball.r - dx;
+    const py = b.h / 2 + ball.r - dy;
+    if (px < penX) {
+      penX = px;
+      deepX = b;
+    }
+    if (py < penY) {
+      penY = py;
+      deepY = b;
+    }
+  }
+
+  // Incoming direction, remembered BEFORE the flip so the push-out sends the
+  // ball back the way it came.
+  const cameX = Math.sign(ball.vx);
+  const cameY = Math.sign(ball.vy);
+
+  for (const b of hits) b.alive = false;
+
+  const corner = Math.abs(penX - penY) <= 1e-6;
+  if (corner) {
+    // Diagonal hit: flip both axes, push out diagonally.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    if (cameX > 0) ball.x = deepX.x - ball.r;
+    else ball.x = deepX.x + deepX.w + ball.r;
+    if (cameY < 0) ball.y = deepY.y + deepY.h + ball.r;
+    else ball.y = deepY.y - ball.r;
+  } else if (penX < penY) {
+    // Side hit: horizontal flip only, push out sideways.
+    ball.vx = -ball.vx;
+    if (cameX > 0) ball.x = deepX.x - ball.r;
+    else ball.x = deepX.x + deepX.w + ball.r;
+  } else {
+    // Top/bottom hit: vertical flip only, push out vertically.
+    ball.vy = -ball.vy;
+    if (cameY < 0) ball.y = deepY.y + deepY.h + ball.r;
+    else ball.y = deepY.y - ball.r;
+  }
+
+  return hits;
