+// --- Issue #1: brick bounces ----------------------------------------------
+// Each case from ISSUES.md #1 gets a red test first: per-face bounce,
+// corner, push-out, neighbours (exactly-once), tunnelling.
+
+// Helper: a pristine level-1 state with every brick except `keep` removed,
+// so a test can aim at a single brick.
+function stateWithOnly(state, keep) {
+  for (const b of state.bricks) if (b !== keep) b.alive = false;
+  return state;
+}
+
+test('#1 bottom face: vy flips, vx untouched, ball pushed below', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  stateWithOnly(state, brick);
+  const vx = 120;
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y + brick.h + 10, r: 7, vx, vy: -ballSpeed(1) };
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy > 0, 'vy should flip from up to down');
+  assert.equal(state.ball.vx, vx, 'vx must be left exactly as it was');
+  assert.ok(
+    state.ball.y - state.ball.r >= brick.y + brick.h,
+    'ball must be pushed out below the brick'
+  );
+  assert.equal(brick.alive, false);
+});
+
