+  assert.equal(state.combo, 1);
+  assert.equal(state.score, scoreForBrick(brick, 1));
+  assert.equal(state.ball.vy, 710, 'bounced back down instead of passing through');
+  assert.equal(state.ball.y, brick.y + brick.h + state.ball.r, 'ball parked below the brick');
+});
