+// --- Issue #1: brick bounces -------------------------------------------------
+
+// Park the ball at a given position/velocity, remembering where it came from
+// this frame (exactly what step() records via ball.prevX / ball.prevY).
+function aim(state, x, y, vx, vy, fromX, fromY) {
+  state.ball.x = x;
+  state.ball.y = y;
+  state.ball.vx = vx;
+  state.ball.vy = vy;
+  state.ball.prevX = fromX ?? x;
+  state.ball.prevY = fromY ?? y;
+  return state.ball;
+}
+
+test('#1 per-face: smaller X penetration is a side hit — flips vx, leaves vy', () => {
+  const brick = { x: 200, y: 100, w: 72, h: 20 };
+  const ball = { x: 205, y: 110, r: 7, vx: 300, vy: 0 }; // 12 px into the left face
+  const face = bounceOffBrick(ball, brick);
+  assert.equal(face, 'left');
+  assert.equal(ball.vx, -300);
+  assert.equal(ball.vy, 0, 'the other component must stay untouched');
+  assert.equal(ball.x, brick.x - ball.r, 'ball pushed out of the left face');
+  assert.equal(ball.y, 110);
+  assert.equal(collides(ball, brick), false, 'push-out clears the brick');
+});
+
+test('#1 per-face: smaller Y penetration is a top hit — flips vy, leaves vx', () => {
+  const brick = { x: 100, y: 100, w: 72, h: 20 };
+  const ball = { x: 136, y: 112, r: 7, vx: 100, vy: 300 }; // falling onto the top face
+  const face = bounceOffBrick(ball, brick);
+  assert.equal(face, 'top');
+  assert.equal(ball.vy, -300);
+  assert.equal(ball.vx, 100, 'the other component must stay untouched');
+  assert.equal(ball.y, brick.y - ball.r, 'ball pushed out of the top face');
+  assert.equal(ball.x, 136);
+  assert.equal(collides(ball, brick), false, 'push-out clears the brick');
+});
+
+test('#1 corner: equal penetration is a diagonal hit — flips both components', () => {
+  const brick = { x: 100, y: 100, w: 72, h: 20 };
+  const ball = { x: 106, y: 106, r: 7, vx: -300, vy: 300 }; // 13 px into each face
+  const face = bounceOffBrick(ball, brick);
+  assert.equal(face, 'corner');
+  assert.equal(ball.vx, 300);
+  assert.equal(ball.vy, -300);
+  assert.equal(collides(ball, brick), false, 'push-out clears the brick');
+});
+
+test('#1 push-out: a bounce never leaves the ball inside the brick', () => {
+  const brick = { x: 100, y: 100, w: 72, h: 20 };
+  const ball = { x: 136, y: 126, r: 7, vx: 0, vy: -300 }; // below the brick, moving up
+  bounceOffBrick(ball, brick);
+  assert.equal(collides(ball, brick), false);
+  assert.equal(ball.y, brick.y + brick.h + ball.r, 'parked tangent below the brick');
+  assert.equal(ball.vy, 300);
