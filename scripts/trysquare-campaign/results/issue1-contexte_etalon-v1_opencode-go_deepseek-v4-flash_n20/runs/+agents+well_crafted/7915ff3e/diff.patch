+
+test('#1 head-on: ball plowing into a column bounces back and scores', () => {
+  const state = createState(1);
+  const brick = state.bricks.find((b) => b.row === BRICK_ROWS - 1);
+  const ball = aim(
+    state,
+    brick.x + brick.w / 2,
+    brick.y + brick.h + state.ball.r - 1, // 1 px into the bottom face
+    0, -260,
+    brick.x + brick.w / 2, 190,
+  );
+  resolveBricks(state);
+  assert.equal(brick.alive, false);
+  assert.equal(state.combo, 1);
+  assert.equal(state.score, scoreForBrick(brick, 1));
+  assert.equal(ball.vy, 260, 'bounced back down, not straight through');
+  assert.equal(ball.y, brick.y + brick.h + state.ball.r, 'pushed back below the brick');
