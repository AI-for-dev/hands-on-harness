+
+test('#1 neighbours: seam overlap bounces exactly once (no double-flip cancel)', () => {
+  const state = createState(1);
+  // Rows are 0-indexed: row 2 spans y 104..124, row 3 y 132..152. The 8 px gap
+  // between them is narrower than the 14 px ball, so one pass can straddle both.
+  const upper = state.bricks.find((b) => b.row === 2);
+  const lower = state.bricks.find((b) => b.row === 3 && b.x === upper.x);
+  const ball = aim(
+    state,
+    upper.x + 4, 128,
+    300, -260,
+    upper.x - 14, 124,
+  );
+  resolveBricks(state);
+  assert.equal(upper.alive, false);
+  assert.equal(lower.alive, false);
+  assert.equal(state.combo, 2);
+  assert.equal(state.score, scoreForBrick(upper, 1) + scoreForBrick(lower, 2));
+  assert.equal(ball.vy, 260, 'vy flipped exactly once');
+  assert.equal(ball.vx, 300, 'horizontal component left untouched');
+});
