+test('#1 tunnelling: a fast ball cannot jump over a brick (swept detection)', () => {
+  const brick = { x: 100, y: 100, w: 72, h: 20, row: 0, alive: true, points: 10 };
+  // Level-6 speed (710 px/s) at the 50 ms frame cap is 35.5 px per step, more
