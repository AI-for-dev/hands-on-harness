+// --- Brick bounce (swept, per-face; see #1) --------------------------------
+
+// The t-interval during which the moving interval [p0, p0+size] → [p1, p1+size]
+// overlaps the static interval [min, max]. Returns [tEnter, tExit], or null
+// when the two never overlap. This is the classic swept-AABB slab test: it
+// finds the contact even when the box jumps over the target in one step
+// (tunnelling).
+function axisOverlap(p0, p1, size, min, max) {
+  const d = p1 - p0;
+  if (d === 0) {
+    if (p0 + size <= min || p0 >= max) return null;
+    return [-Infinity, Infinity];
+  }
+  let tEnter = (min - p0 - size) / d;
+  let tExit = (max - p0) / d;
+  if (tEnter > tExit) [tEnter, tExit] = [tExit, tEnter];
+  return [tEnter, tExit];
+}
+
+// Swept ball-vs-brick test: does the ball, travelling from (prevX, prevY) to
+// its current position, cross the brick? Returns { entry, entryX, entryY } or
+// null. The axis entered LAST is the face with the smaller penetration; equal
+// entry times mean a diagonal corner hit.
+function sweptBrick(ball, brick, prevX, prevY) {
+  const ix = axisOverlap(prevX - ball.r, ball.x - ball.r, ball.r * 2, brick.x, brick.x + brick.w);
+  if (!ix) return null;
+  const iy = axisOverlap(prevY - ball.r, ball.y - ball.r, ball.r * 2, brick.y, brick.y + brick.h);
+  if (!iy) return null;
+  const entry = Math.max(ix[0], iy[0]);
+  const exit = Math.min(ix[1], iy[1]);
+  if (entry > exit || exit < 0 || entry > 1) return null;
+  return { entry, entryX: ix[0], entryY: iy[0] };
+}
+
+// Resolves the ball's collision against the bricks for the sweep between
+// (prevX, prevY) and the ball's current position. Detects every brick crossed
+// during that sweep (a fast ball cannot tunnel through a row) and:
+//   - bounces off the FIRST contact only, so a seam overlapping two bricks in
+//     the same pass still applies the bounce exactly once (`vy = -vy` twice
+//     would cancel out and the ball would plow through);
+//   - per face: the axis entered last (smaller penetration) is the face that
+//     was hit — flip vy on a top/bottom hit, vx on a side hit, and leave the
+//     other component exactly as it was; an exact corner hit flips both;
+//   - pushes the ball back outside the brick, otherwise it still overlaps on
+//     the next frame and re-flips forever (sticky bounce).
+// Bricks crossed later in the same sweep (after the bounce would already have
+// taken place) are left alone. Returns the array of bricks broken, with their
+// `alive` flag cleared.
+export function brickHit(ball, bricks, prevX, prevY) {
+  const candidates = [];
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    const t = sweptBrick(ball, brick, prevX, prevY);
+    if (t) candidates.push({ brick, t });
+  }
+  if (candidates.length === 0) return [];
+
+  let firstEntry = Infinity;
+  for (const c of candidates) if (c.t.entry < firstEntry) firstEntry = c.t.entry;
+
+  const broken = [];
+  let sideBrick = null; // brick whose side face was hit (drives the x push-out)
+  let faceBrick = null; // brick whose top/bottom face was hit (drives the y push-out)
+  for (const c of candidates) {
+    if (Math.abs(c.t.entry - firstEntry) > 1e-9) continue; // not the first contact
