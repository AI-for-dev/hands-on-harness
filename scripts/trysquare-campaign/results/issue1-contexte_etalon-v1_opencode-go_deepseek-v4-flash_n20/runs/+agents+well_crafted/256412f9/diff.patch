+    ball.y = ball.vy > 0 ? faceBrick.y - ball.r : faceBrick.y + faceBrick.h + ball.r;
+    ball.vy = -ball.vy;
+  }
+  for (const brick of broken) brick.alive = false;
+  return broken;
+}
