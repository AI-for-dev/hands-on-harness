+      sideBrick = c.brick;
+    } else if (c.t.entryY > c.t.entryX) {
+      faceBrick = c.brick;
+    } else {
+      sideBrick = c.brick; // exact corner: flip and push out on both axes
+      faceBrick = c.brick;
+    }
+  }
