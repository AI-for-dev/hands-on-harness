+// --- Issue #1: the ball bounces off bricks (was: plows straight through) ---
+// Each behaviour below was first written as a red test, then made green by
+// the sweep + per-face resolution in `brickHit`.
+
+test('brickHit: bottom face hit flips vy only, leaves vx, pushes the ball out', () => {
+  const state = createState(1);
+  const brick = state.bricks[32]; // bottom row (row 4), col 0 → (4, 160, 72, 20)
+  const ball = {
+    x: brick.x + brick.w / 2,
+    y: brick.y + brick.h + 5, // 185: barely overlapping through the bottom face
+    r: 7,
+    vx: 40,
+    vy: -300, // heading up into the brick
+    px: brick.x + brick.w / 2,
+    py: brick.y + brick.h + 22, // 202: started below the brick
+  };
+
+  const broken = brickHit(ball, state.bricks);
+
+  assert.equal(broken.length, 1);
+  assert.equal(brick.alive, false, 'the brick is broken');
+  assert.equal(ball.vy, 300, 'vy flips (bottom face)');
+  assert.equal(ball.vx, 40, 'vx is left exactly as it was');
+  assert.ok(ball.y - ball.r > brick.y + brick.h, 'pushed out below the brick');
+  assert.equal(collides(ball, brick), false, 'no overlap left (no sticky bounce)');
+});
+
