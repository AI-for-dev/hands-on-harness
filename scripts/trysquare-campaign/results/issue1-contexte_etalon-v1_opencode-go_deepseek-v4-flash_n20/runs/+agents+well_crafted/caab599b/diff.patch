+// --- Issue #1: the ball bounces off bricks (per-face, once, no tunnelling) --
+
+// Minimal state around a ball and a brick grid. `px`/`py` default to the ball
+// position so the sweep is inert unless a test deliberately moves the ball.
+function makeBrickState(bricks, ball) {
+  const b = { r: 7, px: ball.x, py: ball.y, ...ball };
+  return { level: 1, combo: 0, score: 0, bricks, ball: b };
+}
+
+function brickAt(x, y) {
+  return { x, y, w: 72, h: 20, alive: true, points: 10 };
+}
+
+test('bounceBricks: top-face hit flips vy and pushes the ball up', () => {
+  const state = makeBrickState([brickAt(100, 100)], { x: 136, y: 105, vx: 50, vy: 300 });
+  assert.equal(bounceBricks(state), true);
+  assert.equal(state.ball.vy, -300); // flipped up
+  assert.equal(state.ball.vx, 50); // untouched
+  assert.equal(state.ball.y, 93); // pushed out above the brick
+  assert.equal(state.bricks[0].alive, false);
+  assert.equal(state.combo, 1);
+});
+
+test('bounceBricks: bottom-face hit flips vy and pushes the ball down', () => {
+  const state = makeBrickState([brickAt(100, 100)], { x: 136, y: 115, vx: -50, vy: -300 });
+  assert.equal(bounceBricks(state), true);
+  assert.equal(state.ball.vy, 300);
+  assert.equal(state.ball.vx, -50);
+  assert.equal(state.ball.y, 127); // brick bottom (120) + r
+});
+
+test('bounceBricks: left-face hit flips vx and pushes the ball out sideways', () => {
+  const state = makeBrickState([brickAt(100, 100)], { x: 105, y: 110, vx: 300, vy: -40 });
+  assert.equal(bounceBricks(state), true);
+  assert.equal(state.ball.vx, -300);
+  assert.equal(state.ball.vy, -40); // untouched
+  assert.equal(state.ball.x, 93);
+});
+
+test('bounceBricks: right-face hit flips vx and pushes the ball out sideways', () => {
+  const state = makeBrickState([brickAt(100, 100)], { x: 165, y: 110, vx: -300, vy: 40 });
+  assert.equal(bounceBricks(state), true);
+  assert.equal(state.ball.vx, 300);
+  assert.equal(state.ball.vy, 40); // untouched
+  assert.equal(state.ball.x, 179); // brick right edge (172) + r
+});
+
+test('bounceBricks: corner hit (equal penetrations) flips both components', () => {
+  const state = makeBrickState([brickAt(100, 100)], { x: 98, y: 98, vx: 300, vy: 300 });
+  assert.equal(bounceBricks(state), true);
+  assert.equal(state.ball.vx, -300);
+  assert.equal(state.ball.vy, -300);
