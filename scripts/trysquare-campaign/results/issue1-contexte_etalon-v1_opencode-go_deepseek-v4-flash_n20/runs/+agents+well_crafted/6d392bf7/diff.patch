+// --- Brick bounce (ISSUES.md #1) -------------------------------------------
+
+// Sweeps the ball's centre path (previous position → current position) against
+// the brick's rectangle expanded by the ball radius. Detection is discrete
+// (position before / after the move), so without the sweep a fast ball jumps
+// over a brick in one step (level 6: 35.5 px/step vs 34 px to cross — see #1).
+//
+// Returns the entry time `t` along the path (0 = the ball already overlapped
+// the brick when the move started), the raw entry times per axis, and the
+// brick — or null when the ball never crosses the expanded rectangle.
+function sweptHit(ball, px, py, brick) {
+  const ex = brick.x - ball.r;
+  const ey = brick.y - ball.r;
+  const ew = brick.w + 2 * ball.r;
+  const eh = brick.h + 2 * ball.r;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+
+  let tInX = 0;
+  let tOutX = 1;
+  if (dx !== 0) {
+    const a = (ex - px) / dx;
+    const b = (ex + ew - px) / dx;
+    tInX = Math.min(a, b);
+    tOutX = Math.max(a, b);
+  } else if (px < ex || px > ex + ew) {
+    return null; // moving parallel to the x faces, never overlapping
+  }
+  let tInY = 0;
+  let tOutY = 1;
+  if (dy !== 0) {
+    const a = (ey - py) / dy;
+    const b = (ey + eh - py) / dy;
+    tInY = Math.min(a, b);
+    tOutY = Math.max(a, b);
+  } else if (py < ey || py > ey + eh) {
+    return null;
+  }
+
+  const tIn = Math.max(tInX, tInY);
+  const tOut = Math.min(tOutX, tOutY);
+  if (tIn > tOut || tOut < 0 || tIn > 1) return null;
+
+  return { brick, t: Math.max(tIn, 0), tIn, tInX, tInY };
+}
+
+// Which face was hit, per #1: the axis with the *smaller* penetration is the
+// face (equal penetrations = a diagonal corner hit = both faces).
+// When the ball really crossed INTO the brick this frame (`tIn > 0`) the last
+// axis entered is the face hit. When it already overlapped at the start of
+// the move (`tIn <= 0`: sticky overlap or motion parallel to a face), fall
+// back to the penetration measured at the previous position.
+function faceOf(ball, info, px, py) {
+  if (info.tIn > 0) {
+    if (Math.abs(info.tInX - info.tInY) < FACE_EPS) return 'both';
+    return info.tInX > info.tInY ? 'x' : 'y';
+  }
+  const overlapX = Math.min(px + ball.r - info.brick.x, info.brick.x + info.brick.w - (px - ball.r));
+  const overlapY = Math.min(py + ball.r - info.brick.y, info.brick.y + info.brick.h - (py - ball.r));
+  if (Math.abs(overlapX - overlapY) < FACE_EPS) return 'both';
+  return overlapX < overlapY ? 'x' : 'y';
+}
+
+// Repositions the ball just outside the brick on the hit axis, so the next
+// frame cannot re-detect the same overlap and re-flip forever (sticky bounce).
+// `d` is the ball's displacement on that axis: the ball is pushed back out
+// through the face it came from (a ball that overshot the brick still exits
+// on the entry side, like a real reflection).
+function pushOut(pos, near, far, d, r) {
+  if (d > 0) return near - r - PUSH_EPS; // approached from the near face
+  if (d < 0) return far + r + PUSH_EPS; // approached from the far face
+  const mid = (near + far) / 2;
+  return pos < mid ? near - r - PUSH_EPS : far + r + PUSH_EPS;
+}
+
+// Applies the bounce for one hit: flips the component(s) of the face that was
+// hit and leaves the other component exactly as it was, then pushes the ball
+// back out of the brick.
+function resolveBall(ball, info, dx, dy, px, py) {
+  const brick = info.brick;
+  const face = faceOf(ball, info, px, py);
+  if (face !== 'y') {
+    ball.vx = -ball.vx;
+    ball.x = pushOut(ball.x, brick.x, brick.x + brick.w, dx, ball.r);
+  }
+  if (face !== 'x') {
+    ball.vy = -ball.vy;
+    ball.y = pushOut(ball.y, brick.y, brick.y + brick.h, dy, ball.r);
+  }
+}
+
+// Resolves the ball against the brick grid for one frame, sweeping the path
+// from the previous position `(px, py)` to the current one. Every brick
+// crossed up to the first impact is broken (seam bricks share the same entry
+// time and break together), but the bounce applies exactly once — flipping
+// twice on a seam cancels out and the ball plows through (see #1).
+// Returns the number of bricks destroyed.
+export function bounceBricks(state, px, py) {
+  const { ball, bricks } = state;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+
+  const hits = [];
+  let first = null;
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    const info = sweptHit(ball, px, py, brick);
+    if (!info) continue;
+    hits.push(info);
+    if (!first || info.t < first.t) first = info;
+  }
+  if (!first) return 0;
+
+  let destroyed = 0;
+  for (const info of hits) {
+    if (info.t > first.t + SEAM_EPS) continue; // behind the bounce point
+    const brick = info.brick;
+    brick.alive = false;
+    destroyed += 1;
+    state.combo += 1;
+    state.score += scoreForBrick(brick, state.combo);
+  }
+
+  resolveBall(ball, first, dx, dy, px, py);
+  return destroyed;
+}
