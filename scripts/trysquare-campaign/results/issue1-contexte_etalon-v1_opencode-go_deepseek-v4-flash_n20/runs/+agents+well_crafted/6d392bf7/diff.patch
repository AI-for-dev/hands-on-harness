+// --- #1: brick bounce (ISSUES.md #1) ---------------------------------------
+
+// One brick at a known place, away from the walls, to isolate the interaction.
+function loneBrick(x = 300, y = 100) {
+  return { x, y, w: 72, h: 20, row: 0, alive: true, points: 100 };
+}
+
+test('brick: bottom hit flips vy and leaves vx untouched', () => {
+  const state = createState(1);
+  const brick = loneBrick();
+  state.bricks = [brick];
+  state.ball = {
+    x: brick.x + brick.w / 2,
+    y: brick.y + brick.h + BALL_R + 1,
+    r: BALL_R,
+    vx: 7,
+    vy: -200,
+  };
+  step(state, 1 / 60);
+  assert.equal(Math.sign(state.ball.vy), DOWN, 'vy flips on a bottom hit');
+  assert.equal(state.ball.vx, 7, 'vx is left exactly as it was');
+  assert.equal(brick.alive, false);
+  assert.ok(!collides(state.ball, brick), 'ball is pushed out of the brick');
+  assert.equal(state.combo, 1);
+  assert.ok(state.score > 0);
+});
+
+test('brick: side hit flips vx and leaves vy untouched', () => {
+  const state = createState(1);
+  const brick = loneBrick();
+  state.bricks = [brick];
+  state.ball = {
+    x: brick.x - BALL_R - 1,
+    y: brick.y + brick.h / 2,
+    r: BALL_R,
+    vx: 200,
+    vy: 7,
+  };
+  step(state, 1 / 60);
+  assert.equal(Math.sign(state.ball.vx), LEFT, 'vx flips on a side hit');
+  assert.equal(state.ball.vy, 7, 'vy is left exactly as it was');
+  assert.equal(brick.alive, false);
+  assert.ok(!collides(state.ball, brick), 'ball is pushed out of the brick');
+});
+
+test('brick: exact corner hit flips both components', () => {
