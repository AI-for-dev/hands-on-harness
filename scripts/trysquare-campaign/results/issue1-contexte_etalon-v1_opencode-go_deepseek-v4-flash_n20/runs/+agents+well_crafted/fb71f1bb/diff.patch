+// --- Issue #1: the ball plows through bricks instead of bouncing -----------
+
+// A minimal canvas context stub: frame() only writes properties and calls
+// drawing methods, none of which need a real DOM.
+function fakeCtx() {
+  return new Proxy(
+    {},
+    {
+      get: () => () => {},
+      set: (target, prop, value) => {
+        target[prop] = value;
+        return true;
+      },
+    },
+  );
+}
+
+const BRICK = { x: 100, y: 100, w: 40, h: 20 };
+
+// A ball that moves 35.5 px per frame at level 6 can jump over a brick that
+// only takes 34 px to cross: a discrete before/after test sees nothing, the
+// sweep must still register the hit (and report the bottom face it entered).
+test('sweptBrickHit: a fast ball that jumps over a brick still registers a hit', () => {
+  const ball = { x: 120, y: 60, r: BALL_R, vx: 0, vy: -100 }; // ended above
+  const hit = sweptBrickHit(120, 200, ball, BRICK); // started below
+  assert.ok(hit, 'the swept path must cross the brick');
+  assert.ok(hit.t > 0 && hit.t < 1, 'contact happens mid-move');
+  assert.equal(hit.x, 120);
+  assert.ok(
+    Math.abs(hit.y - (BRICK.y + BRICK.h + BALL_R)) < 1e-6,
+    `contact must sit on the bottom face, got y=${hit.y}`,
+  );
+});
+
+test('sweptBrickHit: a path that never reaches the brick returns null', () => {
+  const ball = { x: 120, y: 250, r: BALL_R, vx: 0, vy: -100 };
+  assert.equal(sweptBrickHit(120, 300, ball, BRICK), null);
+});
+
+test('#1 side hit: smaller x penetration flips vx only and pushes the ball out', () => {
+  const ball = { x: 95, y: 110, r: BALL_R, vx: 200, vy: -80 };
+  const face = resolveBallBrick(ball, BRICK, 85, 110);
+  assert.equal(face, 'x');
+  assert.ok(ball.vx < 0, 'vx must flip towards the left');
+  assert.equal(ball.vy, -80, 'vy is left exactly as it was');
+  assert.ok(ball.x + ball.r < BRICK.x, 'ball pushed out of the rectangle');
+  assert.equal(collides(ball, BRICK), false, 'no overlap left behind');
+});
+
+test('#1 top/bottom hit: smaller y penetration flips vy only and pushes the ball out', () => {
+  const ball = { x: 120, y: 96, r: BALL_R, vx: -150, vy: 250 };
+  const face = resolveBallBrick(ball, BRICK, 120, 90);
+  assert.equal(face, 'y');
+  assert.ok(ball.vy < 0, 'vy must flip towards the ceiling');
+  assert.equal(ball.vx, -150, 'vx is left exactly as it was');
+  assert.ok(ball.y + ball.r < BRICK.y, 'ball pushed out of the rectangle');
+  assert.equal(collides(ball, BRICK), false, 'no overlap left behind');
+});
+
+test('#1 corner hit: equal penetrations flip both components', () => {
+  const ball = { x: 93, y: 93, r: BALL_R, vx: 200, vy: 250 };
+  const face = resolveBallBrick(ball, BRICK, 85, 85);
+  assert.equal(face, 'corner');
+  assert.ok(ball.vx < 0 && ball.vy < 0, 'both components flip');
+  assert.equal(collides(ball, BRICK), false);
+});
+
+test('#1 push-out: the ball no longer overlaps, so the next frame cannot re-flip', () => {
+  // The ball hits the corner moving IN (vx/vy towards the brick), bounces and
+  // is pushed back out; on the next frame it starts from the pushed-out
+  // position and moves AWAY — the sweep must not re-trigger.
+  const ball = { x: 93, y: 93, r: BALL_R, vx: 200, vy: 250 };
+  resolveBallBrick(ball, BRICK, 85, 85);
+  assert.equal(collides(ball, BRICK), false);
+  const fromX = ball.x;
+  const fromY = ball.y;
+  ball.x += ball.vx * (1 / 60); // move away for one frame
+  ball.y += ball.vy * (1 / 60);
+  const next = sweptBrickHit(fromX, fromY, ball, BRICK);
+  assert.equal(next, null, 'moving away from the pushed-out position must not re-hit');
+});
+
+test('#1 seam: two adjacent bricks hit in one pass break with a single bounce', () => {
+  const ctx = fakeCtx();
+  const state = createState(1);
+  for (const brick of state.bricks) brick.alive = false;
+  const left = state.bricks[BRICK_COLS * 4 + 3]; // row 4, col 3
+  const right = state.bricks[BRICK_COLS * 4 + 4]; // row 4, col 4
+  left.alive = true;
+  right.alive = true;
+  // Ball centred on the 8 px seam, moving straight up onto both faces of the
+  // row (the ball is 14 px across, the gap only 8 px, so it overlaps both).
+  const seamX = left.x + left.w + BRICK_GAP / 2;
+  state.ball = {
+    x: seamX,
+    y: 185,
+    r: BALL_R,
+    vx: 0,
+    vy: -300,
+    px: seamX,
+    py: 200,
+  };
+
+  frame(ctx, state);
+
+  assert.equal(left.alive, false, 'both seam bricks break');
+  assert.equal(right.alive, false, 'both seam bricks break');
+  assert.equal(state.combo, 2, 'both bricks scored in the same pass');
+  // vy = -300 -> +300 proves the flip ran exactly once: no flip or a double
+  // flip would both leave it negative, and the ball would keep going up.
+  assert.equal(state.ball.vy, 300);
+  assert.ok(state.ball.y > left.y + left.h, 'ball pushed back below the row');
+});
+
+test('#1 tunnelling: level-6 speed jumps the brick, the sweep still bounces it', () => {
+  const ctx = fakeCtx();
+  const state = createState(6); // ballSpeed(6) = 710 px/s
+  for (const brick of state.bricks) brick.alive = false;
+  const target = state.bricks[BRICK_COLS * 4 + 3];
+  target.alive = true;
+
+  // Below the brick, moving straight up: 710 * 0.05 = 35.5 px in one step,
+  // more than BRICK_H + 2*BALL_R = 34 px, so the ball ends fully ABOVE the
+  // brick — a discrete test would miss it entirely.
+  state.ball = {
+    x: target.x + target.w / 2,
+    y: target.y + target.h + BALL_R + 1, // 188: below the brick
+    r: BALL_R,
+    vx: 0,
+    vy: -ballSpeed(6),
+  };
+
+  const lost = step(state, 0.05);
+  assert.equal(lost, false);
+  assert.ok(
+    state.ball.y + state.ball.r < target.y,
+    'the move really jumped over the brick (tunnelling setup)',
+  );
+
+  frame(ctx, state);
+
+  assert.equal(target.alive, false, 'the swept detection must still break the brick');
+  assert.ok(state.ball.vy > 0, 'the ball must bounce back down');
+  assert.ok(state.ball.y > target.y + target.h, 'ball pushed back below the brick');
+  assert.equal(collides(state.ball, target), false);
+});
