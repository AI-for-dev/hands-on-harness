+// --- Brick collision resolution (issue #1) ---------------------------------
+
+// Swept AABB test: does the ball's centre, travelling in a straight line from
+// (prevX, prevY) to its current position, touch the brick (expanded by the
+// radius)? A discrete before/after test misses a fast ball: at level 6 the
+// ball moves up to 35.5 px per frame while a brick only takes
+// BRICK_H + 2*BALL_R = 34 px to cross, so the ball can jump over it entirely.
+//
+// Returns the first contact point `{ t, x, y }` (entry time in [0, 1] and the
+// centre position at that instant) or `null`. When the ball is already
+// overlapping the brick at the start of the move, the contact is the current
+// position (t = 0), which keeps the resolution below well-defined.
+export function sweptBrickHit(prevX, prevY, ball, brick) {
+  // The brick, grown by the ball's radius: the ball's centre path crosses
+  // this box exactly when the ball's own box touches the brick.
+  const ex = brick.x - ball.r;
+  const ey = brick.y - ball.r;
+  const ew = brick.w + 2 * ball.r;
+  const eh = brick.h + 2 * ball.r;
+  const dx = ball.x - prevX;
+  const dy = ball.y - prevY;
+
+  // Slab method: clip the move against the box's x and y slabs.
+  let tEnter = 0;
+  let tExit = 1;
+
+  if (dx === 0) {
+    if (prevX < ex || prevX > ex + ew) return null;
+  } else {
+    let t1 = (ex - prevX) / dx;
+    let t2 = (ex + ew - prevX) / dx;
+    if (t1 > t2) { const tmp = t1; t1 = t2; t2 = tmp; }
+    tEnter = Math.max(tEnter, t1);
+    tExit = Math.min(tExit, t2);
+    if (tEnter > tExit) return null;
+  }
+
+  if (dy === 0) {
+    if (prevY < ey || prevY > ey + eh) return null;
+  } else {
+    let t1 = (ey - prevY) / dy;
+    let t2 = (ey + eh - prevY) / dy;
+    if (t1 > t2) { const tmp = t1; t1 = t2; t2 = tmp; }
+    tEnter = Math.max(tEnter, t1);
+    tExit = Math.min(tExit, t2);
+    if (tEnter > tExit) return null;
+  }
+
+  // The contact lies beyond the end of the move: the brick is not on this
+  // frame's path. Fall back to a plain overlap check at the current position
+  // (defensive: catches any float slop at the boundary).
+  if (tEnter > 1) {
+    return collides(ball, brick) ? { t: 1, x: ball.x, y: ball.y } : null;
+  }
+
+  return {
+    t: tEnter,
+    x: prevX + dx * tEnter,
+    y: prevY + dy * tEnter,
+  };
+}
+
+// Deflects the ball off a brick at a known contact point `hit` (as returned
+// by sweptBrickHit). The face that was hit is the axis with the SMALLER
+// penetration of the ball's box into the brick rectangle: side faces flip
+// `vx`, top/bottom faces flip `vy`, and an equal penetration (a corner hit)
+// flips both. The other component is left exactly as it was.
+//
+// The ball is also pushed back out of the rectangle (a hair past the face),
+// otherwise it still overlaps on the next frame and re-flips forever — the
+// sticky bounce. The tiny epsilon keeps the next frame's sweep from starting
+// on the boundary, where a float error could re-trigger the bounce.
+//
+// Returns the face that was hit: 'x' (side), 'y' (top/bottom) or 'corner'.
+export function bounceBall(ball, brick, hit) {
+  const r = ball.r;
+  const penX = Math.min(hit.x + r - brick.x, brick.x + brick.w - (hit.x - r));
+  const penY = Math.min(hit.y + r - brick.y, brick.y + brick.h - (hit.y - r));
+  const hitX = penX <= penY; // side face (or part of a corner hit)
+  const hitY = penY <= penX; // top/bottom face (or part of a corner hit)
+  const leftOf = hit.x < brick.x + brick.w / 2;
+  const above = hit.y < brick.y + brick.h / 2;
+
+  // Flip a component only when it points INTO the brick: the sweep can report
+  // a contact for a ball that is already leaving the rectangle, and flipping
+  // then would drag it back in (sticky).
+  if (hitX && ((ball.vx > 0 && leftOf) || (ball.vx < 0 && !leftOf))) ball.vx = -ball.vx;
+  if (hitY && ((ball.vy > 0 && above) || (ball.vy < 0 && !above))) ball.vy = -ball.vy;
+
+  // Push out of the rectangle, just past the face that was hit.
+  const EPS = 0.01;
+  if (hitX) ball.x = leftOf ? brick.x - r - EPS : brick.x + brick.w + r + EPS;
+  if (hitY) ball.y = above ? brick.y - r - EPS : brick.y + brick.h + r + EPS;
+
+  return hitX && hitY ? 'corner' : hitX ? 'x' : 'y';
+}
+
+// Sweep + deflect in one call. Returns the face ('x' | 'y' | 'corner') when
+// the ball's path from (prevX, prevY) to its current position hits the brick,
+// and `null` when it does not.
+export function resolveBallBrick(ball, brick, prevX, prevY) {
+  const hit = sweptBrickHit(prevX, prevY, ball, brick);
+  return hit ? bounceBall(ball, brick, hit) : null;
+}
