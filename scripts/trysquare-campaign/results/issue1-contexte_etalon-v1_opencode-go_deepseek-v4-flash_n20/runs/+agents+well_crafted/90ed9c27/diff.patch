+
+  const fx = entryX === null ? -Infinity : entryX;
+  const fy = entryY === null ? -Infinity : entryY;
+  let face;
+  if (fx > fy) face = 'x';
+  else if (fy > fx) face = 'y';
+  else face = 'both';
