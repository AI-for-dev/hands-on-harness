+// per frame (35.5 px at level 6 vs the 34 px needed to cross a brick), so
+// checking only the start and end positions misses the brick entirely — the
+// ball tunnels through.
+// Returns null when there is no crossing, otherwise
+//   { face: 'x' | 'y' | 'both', x, y } — the face crossed at first contact
+//   and the ball-centre position where the ball first touches the brick.
+export function sweepHit(px, py, ball, brick) {
+  const r = ball.r;
+  const x0 = brick.x - r;
+  const x1 = brick.x + brick.w + r;
+  const y0 = brick.y - r;
+  const y1 = brick.y + brick.h + r;
+
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+
+  let tIn = 0;
+  let tOut = 1;
+  let entryX = null; // when the segment enters the X slab (null: never)
+  let entryY = null;
+
+  if (dx === 0) {
+    if (ball.x < x0 || ball.x > x1) return null;
+  } else {
+    let t1 = (x0 - px) / dx;
+    let t2 = (x1 - px) / dx;
+    if (t1 > t2) [t1, t2] = [t2, t1];
+    if (t2 < 0 || t1 > 1) return null;
+    entryX = t1;
+    tIn = Math.max(tIn, t1);
+    tOut = Math.min(tOut, t2);
+  }
+
+  if (dy === 0) {
+    if (ball.y < y0 || ball.y > y1) return null;
+  } else {
+    let t1 = (y0 - py) / dy;
+    let t2 = (y1 - py) / dy;
+    if (t1 > t2) [t1, t2] = [t2, t1];
+    if (t2 < 0 || t1 > 1) return null;
+    entryY = t1;
+    tIn = Math.max(tIn, t1);
+    tOut = Math.min(tOut, t2);
+  }
