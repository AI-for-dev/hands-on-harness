+    // the brick, so the bounce cannot re-trigger), then flip the face(s).
+    ball.x = first.swept.x;
+    ball.y = first.swept.y;
+    if (first.swept.face === 'x') ball.vx = -ball.vx;
+    else if (first.swept.face === 'y') ball.vy = -ball.vy;
+    else {
+      ball.vx = -ball.vx;
+      ball.vy = -ball.vy;
+    }
+  } else {
+    bounceOffBrick(ball, first.brick);
+  }
+}
