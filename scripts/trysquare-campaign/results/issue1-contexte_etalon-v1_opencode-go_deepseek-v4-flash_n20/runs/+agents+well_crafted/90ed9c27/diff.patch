+// Resolves a single ball/brick overlap. The axis with the SMALLER penetration
+// is the face that was hit:
+//   - top/bottom hit  -> flip vy, leave vx alone;
+//   - side hit        -> flip vx, leave vy alone;
+//   - equal           -> diagonal hit, flip both components.
+// The ball is then pushed back OUT of the brick along the hit axis so it does
+// not overlap on the next frame (otherwise the bounce re-triggers forever —
+// the sticky bounce). Mutates `ball`; no-op unless the ball really overlaps.
+export function bounceOffBrick(ball, brick) {
+  const penLeft = ball.x + ball.r - brick.x;
+  const penRight = brick.x + brick.w - (ball.x - ball.r);
+  const penTop = ball.y + ball.r - brick.y;
+  const penBottom = brick.y + brick.h - (ball.y - ball.r);
+
+  const penX = Math.min(penLeft, penRight);
+  const penY = Math.min(penTop, penBottom);
+  if (penX <= 0 || penY <= 0) return;
+
+  if (penX < penY) {
+    // Side hit: bounce horizontally, slide along the face.
+    ball.vx = -ball.vx;
+    ball.x += penLeft <= penRight ? -penX : penX;
+  } else if (penY < penX) {
+    // Top/bottom hit: bounce vertically, slide along the face.
+    ball.vy = -ball.vy;
+    ball.y += penTop <= penBottom ? -penY : penY;
+  } else {
+    // Corner: diagonal hit, bounce and push out on both axes.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x += penLeft <= penRight ? -penX : penX;
+    ball.y += penTop <= penBottom ? -penY : penY;
+  }
+}
+
+// Swept collision: does the ball, moving from (px, py) to (ball.x, ball.y),
+// cross the region swept by its body over the brick (the brick inflated by
