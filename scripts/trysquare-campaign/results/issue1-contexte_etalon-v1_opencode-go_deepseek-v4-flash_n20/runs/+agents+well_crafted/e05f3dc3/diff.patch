+// --- Issue #1: the ball bounces off bricks instead of plowing through ---------
+
+const R = 7; // BALL_R
+
+// A brick in the middle of the field, wide enough that the ball never touches
+// a seam when centred on it.
+function brick() {
+  return { x: 100, y: 100, w: 40, h: 20, alive: true };
+}
+
+test('#1 top hit: flips vy, leaves vx untouched, pushes the ball out', () => {
+  const ball = { x: 120, y: 96, r: R, vx: 120, vy: 300, px: 120, py: 80 };
