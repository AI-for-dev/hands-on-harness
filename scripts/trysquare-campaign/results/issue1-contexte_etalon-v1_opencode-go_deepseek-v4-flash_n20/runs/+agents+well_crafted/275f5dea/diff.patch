+// --- #1 — brick bounces ----------------------------------------------------
+
+// Per-face: a ball overlapping a brick's TOP face (smaller penetration on the
+// y axis) flips vy, keeps vx, and is pushed back out above the brick.
+test('resolveBricks: top-face hit flips vy, keeps vx, pushes the ball out', () => {
+  const state = createState(1);
+  const brick = state.bricks.find((b) => b.y === 48 && b.x === 84); // row 0, col 1
+  state.ball = { x: 140, y: 55, r: 7, vx: 60, vy: 240, px: 140, py: 55 };
+  const destroyed = resolveBricks(state);
+
+  assert.equal(destroyed.length, 1);
+  assert.equal(destroyed[0], brick);
+  assert.equal(state.ball.vy, -240, 'vy flipped');
+  assert.equal(state.ball.vx, 60, 'vx left exactly as it was');
+  assert.equal(state.ball.y, 41, 'pushed back out above the brick');
+  assert.equal(state.ball.x, 140);
+  assert.equal(brick.alive, false);
+  assert.ok(state.score > 0, 'the broken brick scores');
+});
+
+// Per-face: a side hit flips vx, keeps vy, and pushes the ball out sideways.
+test('resolveBricks: side hit flips vx, keeps vy, pushes the ball out', () => {
+  const state = createState(1);
+  // Isolate one brick: in the full grid the 8 px gap is smaller than the
+  // 14 px ball, so a side hit always couples to the neighbour (the seam test
+  // below covers that); here we observe the per-face bounce itself.
+  state.bricks = state.bricks.filter((b) => b.y === 48 && b.x === 84);
+  const brick = state.bricks[0];
+  state.ball = { x: 85, y: 58, r: 7, vx: 180, vy: 0, px: 85, py: 58 };
+  const destroyed = resolveBricks(state);
+
+  assert.equal(destroyed.length, 1);
+  assert.equal(destroyed[0], brick);
+  assert.equal(state.ball.vx, -180, 'vx flipped');
+  assert.equal(state.ball.vy, 0, 'vy left exactly as it was');
+  assert.equal(state.ball.x, 77, 'pushed back out to the left of the brick');
+  assert.equal(state.ball.y, 58);
+  assert.equal(brick.alive, false);
+});
+
+// Corner: equal penetrations on both axes = diagonal hit: both components flip.
+test('resolveBricks: corner hit flips both components', () => {
+  const state = createState(1);
+  const brick = state.bricks.find((b) => b.y === 48 && b.x === 84);
+  // Ball centre on the corner diagonal: 6 px past BOTH the top and left face.
+  state.ball = { x: 83, y: 47, r: 7, vx: 100, vy: 100, px: 83, py: 47 };
+  const destroyed = resolveBricks(state);
+
+  assert.equal(destroyed.length, 1);
+  assert.equal(destroyed[0], brick);
+  assert.equal(state.ball.vx, -100, 'vx flipped');
+  assert.equal(state.ball.vy, -100, 'vy flipped');
+  assert.equal(state.ball.x, 77);
+  assert.equal(state.ball.y, 41);
+  assert.equal(brick.alive, false);
+});
+
+// Neighbours: the 8 px grid gap is smaller than the 14 px ball, so a ball on
+// a seam overlaps TWO bricks in the same pass. The bounce must be applied
+// exactly once (vy flips to -200 — not 0, not +200) and both bricks die.
+test('resolveBricks: seam hit bounces exactly once and breaks both bricks', () => {
+  const state = createState(1);
+  const left = state.bricks.find((b) => b.y === 48 && b.x === 4);
+  const right = state.bricks.find((b) => b.y === 48 && b.x === 84);
+  // Ball centred in the 8 px gap between the two bricks, entering the row.
+  state.ball = { x: 80, y: 56, r: 7, vx: 0, vy: 200, px: 80, py: 56 };
+  const destroyed = resolveBricks(state);
+
+  assert.equal(destroyed.length, 2);
+  assert.ok(destroyed.includes(left) && destroyed.includes(right));
+  assert.equal(state.ball.vy, -200, 'vy flipped exactly once');
+  assert.equal(state.ball.vx, 0, 'vx left exactly as it was');
+  assert.equal(state.ball.y, 41, 'pushed back out above the row');
+  assert.equal(left.alive, false);
+  assert.equal(right.alive, false);
