+// --- issue #1: the ball bounces off bricks instead of plowing through ------
+
+// A lone brick with the standard geometry, isolated from the grid so a test
+// only ever sees the bricks it intends to.
+function brick(x, y, row = 0) {
+  return { x, y, w: BRICK_W, h: BRICK_H, row, alive: true, points: 100 };
+}
+
+// Minimal 2D context: frame() only reads/writes the properties below, so a
+// plain stub keeps the DOM out of the pure logic tests.
+function stubCtx() {
+  return {
+    fillStyle: '',
+    font: '',
+    fillRect() {},
+    fillText() {},
+    beginPath() {},
+    arc() {},
+    fill() {},
+  };
+}
+
+test('bounce: head-on upward hit flips vy and leaves vx untouched', () => {
+  const b = brick(100, 100);
+  const ball = { x: 136, y: 126, r: BALL_R, vx: 50, vy: -300 };
+  resolveBrickCollision(ball, [b]);
+  assert.equal(ball.vy, 300);
+  assert.equal(ball.vx, 50); // other component left exactly as it was
+  assert.equal(ball.y, 127); // pushed out below the brick
+  assert.ok(!collides(ball, b));
+});
+
+test('bounce: side hit flips vx and leaves vy untouched', () => {
+  const b = brick(100, 100);
+  const ball = { x: 94, y: 110, r: BALL_R, vx: 300, vy: 20 };
+  resolveBrickCollision(ball, [b]);
+  assert.equal(ball.vx, -300);
+  assert.equal(ball.vy, 20); // other component left exactly as it was
+  assert.equal(ball.x, 93); // pushed out to the left
+  assert.ok(!collides(ball, b));
+});
+
+test('bounce: corner hit (equal penetrations) flips both components', () => {
+  const b = brick(100, 100);
+  const ball = { x: 170, y: 118, r: BALL_R, vx: 300, vy: 300 };
+  resolveBrickCollision(ball, [b]);
+  assert.equal(ball.vx, -300);
+  assert.equal(ball.vy, -300);
+  assert.ok(!collides(ball, b));
+});
+
+test('bounce: seam between two bricks flips vy exactly once', () => {
+  const a = brick(100, 100);
+  const b = brick(180, 100); // 8 px gap, ball is 14 px across: both overlap
+  const ball = { x: 176, y: 126, r: BALL_R, vx: 0, vy: -300 };
+  resolveBrickCollision(ball, [a, b]);
+  assert.equal(ball.vy, 300); // flipped once, not twice (vy = -vy twice cancels)
+  assert.equal(ball.vx, 0);
+  assert.equal(ball.y, 127); // pushed out below both bricks
+  assert.ok(!collides(ball, a) && !collides(ball, b));
+});
+
+test('frame: destroys the brick and bounces the ball', () => {
+  const state = createState(1);
+  const b = brick(100, 100);
+  state.bricks = [b];
+  state.ball = { x: 136, y: 126, r: BALL_R, vx: 0, vy: -300 };
+  frame(stubCtx(), state);
+  assert.equal(b.alive, false);
+  assert.equal(state.ball.vy, 300);
+  assert.equal(state.ball.y, 127);
+  assert.ok(!collides(state.ball, b));
+});
+
+test('frame: swept segment catches a ball that would jump over the brick', () => {
+  const state = createState(6);
+  const b = brick(100, 100);
+  state.bricks = [b];
+  // Level 6: 710 px/s, capped 50 ms step -> 35.5 px, more than the 34 px
+  // (BRICK_H + 2 * BALL_R) needed to cross the brick. A plain overlap test
+  // would never see the hit; the swept segment does.
+  state.ball = {
+    x: 136,
+    y: b.y + b.h + BALL_R + 1, // just below the brick
+    r: BALL_R,
+    vx: 0,
+    vy: -ballSpeed(6),
+  };
+  step(state, 0.05);
+  frame(stubCtx(), state);
+  assert.equal(b.alive, false);
+  assert.equal(state.ball.vy, ballSpeed(6)); // bounced exactly once
+  assert.equal(state.ball.y, b.y + b.h + BALL_R); // pushed back out
+  assert.ok(!collides(state.ball, b));
+});
+
+test('frame: a ball passing beside a brick is left alone', () => {
+  const state = createState(1);
+  const b = brick(100, 100);
+  state.bricks = [b];
+  state.ball = { x: 86, y: 128, r: BALL_R, vx: 0, vy: -300 }; // 7 px left of it
+  step(state, 0.05);
+  frame(stubCtx(), state);
+  assert.equal(b.alive, true);
+  assert.equal(state.ball.vy, -300);
+});
+
