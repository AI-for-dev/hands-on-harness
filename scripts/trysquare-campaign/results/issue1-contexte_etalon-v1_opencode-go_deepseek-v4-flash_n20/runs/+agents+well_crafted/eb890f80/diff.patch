+// Entry parameter of the ball's path into the brick's expanded rectangle
+// (the brick grown by the ball radius — the Minkowski sum of the box and the
+// ball). The path is the segment from the ball's previous position to its
+// current one.
+//
+// Returns the value t in [0, 1] where the segment first enters the expanded
+// rectangle, or null when it never does. Sweeping the whole segment — instead
+// of only testing the final position — is what stops a fast ball from
+// tunnelling straight through a thin brick between two frames (#1): at
+// level 6 a stuttered 50 ms frame moves the ball 35.5 px, more than the
+// 34 px it takes to cross a brick (BRICK_H + 2 * BALL_R).
+function brickEntry(ball, brick) {
+  const px = ball.px ?? ball.x;
+  const py = ball.py ?? ball.y;
+  const { x, y, r } = ball;
+  const x0 = brick.x - r;
+  const x1 = brick.x + brick.w + r;
+  const y0 = brick.y - r;
+  const y1 = brick.y + brick.h + r;
+  const dx = x - px;
+  const dy = y - py;
+
+  let tmin = 0;
+  let tmax = 1;
+  if (dx === 0) {
+    if (px < x0 || px > x1) return null;
+  } else {
+    let t1 = (x0 - px) / dx;
+    let t2 = (x1 - px) / dx;
+    if (t1 > t2) { const t = t1; t1 = t2; t2 = t; }
+    tmin = Math.max(tmin, t1);
+    tmax = Math.min(tmax, t2);
+  }
+  if (dy === 0) {
+    if (py < y0 || py > y1) return null;
+  } else {
+    let t1 = (y0 - py) / dy;
+    let t2 = (y1 - py) / dy;
+    if (t1 > t2) { const t = t1; t1 = t2; t2 = t; }
+    tmin = Math.max(tmin, t1);
+    tmax = Math.min(tmax, t2);
+  }
+  return tmin <= tmax ? tmin : null;
+}
+
+// Tolerance around a null penetration: at the exact entry point the ball is a
+// few ULPs away from first contact, and those floats must still count as 0.
+const PEN_EPS = 1e-6;
+
+// Resolves exactly ONE bounce against the set of bricks the ball hit this
+// frame (all sharing the same entry point — the first-contact group, see
+// frame()). Mutates the ball:
+//
+//   - per face: the axis with the smaller penetration AT THE ENTRY POINT is
+//     the face that was hit. A top/bottom hit flips `vy`, a side hit flips
+//     `vx`, and the other component is left exactly as it was;
+//   - corner: equal penetrations mean a diagonal hit — both flip;
+//   - push out: the ball is repositioned outside the brick(s) along the
+//     flipped axis, otherwise it still overlaps next frame and re-flips
+//     forever (sticky bounce);
+//   - neighbours: several bricks can share the same entry point (the grid gap
+//     is 8 px, the ball 14 px across, so every seam overlaps two bricks in
+//     the same pass), yet the flip happens exactly once — a double `vy = -vy`
+//     would cancel out and let the ball through.
+//
+// `bricks` is the (small) group of bricks sharing the first contact, not the
+// whole grid.
+export function resolveBrickCollision(ball, bricks) {
+  if (bricks.length === 0) return;
+
+  const px = ball.px ?? ball.x;
+  const py = ball.py ?? ball.y;
+  let first = Infinity;
+  for (const brick of bricks) {
+    const t = brickEntry(ball, brick);
+    if (t !== null && t < first) first = t;
+  }
+  // Position where the path first touched the group: the penetrations are
+  // measured there, so a ball that has already dug deep into a brick still
+  // bounces off the face it actually entered through.
+  const ex = px + (ball.x - px) * (first === Infinity ? 0 : first);
+  const ey = py + (ball.y - py) * (first === Infinity ? 0 : first);
+
+  let minX = Infinity;
+  let minY = Infinity;
+  let sideX = 0; // LEFT or RIGHT
+  let sideY = 0; // UP (top face) or DOWN (bottom face)
+  for (const brick of bricks) {
+    const pLeft = ex + ball.r - brick.x;
+    const pRight = brick.x + brick.w - (ex - ball.r);
+    const pTop = ey + ball.r - brick.y;
+    const pBottom = brick.y + brick.h - (ey - ball.r);
+    if (pLeft > -PEN_EPS && pLeft < minX) { minX = pLeft; sideX = LEFT; }
+    if (pRight > -PEN_EPS && pRight < minX) { minX = pRight; sideX = RIGHT; }
+    if (pTop > -PEN_EPS && pTop < minY) { minY = pTop; sideY = UP; }
+    if (pBottom > -PEN_EPS && pBottom < minY) { minY = pBottom; sideY = DOWN; }
+  }
+
+  const flipX = minX <= minY;
+  const flipY = minY <= minX;
+  if (flipX && sideX !== 0) ball.vx = -ball.vx;
+  if (flipY && sideY !== 0) ball.vy = -ball.vy;
+
+  if (sideX !== 0 || sideY !== 0) {
+    // Push out along the flipped axis(es), clear of the whole group.
+    if (flipX) {
+      ball.x = sideX === LEFT
+        ? Math.min(...bricks.map((b) => b.x)) - ball.r
+        : Math.max(...bricks.map((b) => b.x + b.w)) + ball.r;
+    }
+    if (flipY) {
+      ball.y = sideY === UP
+        ? Math.min(...bricks.map((b) => b.y)) - ball.r
+        : Math.max(...bricks.map((b) => b.y + b.h)) + ball.r;
+    }
+  } else {
+    // No face found (pathological input): bounce off the dominant axis of
+    // travel rather than letting the ball plow through.
+    if (Math.abs(ball.vx) > Math.abs(ball.vy)) ball.vx = -ball.vx;
+    else ball.vy = -ball.vy;
+  }
+}
