+// Resolves the ball against every brick in ONE pass (issue #1).
+//
+// Detection is discrete (positions before/after the move) and the ball is
+// 14 px across while the grid gap is 8 px, so a naive per-brick test breaks
+// two ways. This function is frame-consistent instead:
+//
+//   1. SWEEP the segment travelled since the previous step (prevX/prevY ->
+//      x/y) against each brick's box expanded by the ball radius. At high
+//      level the ball can cross an entire brick between two frames (level 6:
+//      710 px/s, 50 ms step = 35.5 px vs 34 px to cross), landing on the far
+//      side without ever *overlapping* it — the sweep catches that jump.
+//   2. Take the EARLIEST contact only. The hit face is the axis with the
+//      smaller penetration at the contact point: a top/bottom hit flips `vy`,
+//      a side hit flips `vx`, an exact corner (equal penetrations) flips both,
+//      and the other component is left exactly as it was.
+//   3. PUSH the ball back out just outside the brick, otherwise it still
+//      overlaps on the next frame and re-flips forever (sticky bounce).
+//   4. Every brick whose expanded box contains the contact point dies — at a
+//      seam (8 px gap vs a 14 px ball) that is both bricks — while the bounce
+//      is still applied exactly once (vy = -vy twice would cancel out).
+//
+// Marks the destroyed bricks dead and returns them (the caller scores them).
+// Pure: no DOM, no rendering.
+export function brickHit(ball, bricks) {
+  const x0 = ball.prevX ?? ball.x;
+  const y0 = ball.prevY ?? ball.y;
+  const dx = ball.x - x0;
+  const dy = ball.y - y0;
+
+  // Earliest contact across all live bricks.
+  let bestBrick = null;
+  let bestT = Infinity;
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    const t = sweptContact(x0, y0, dx, dy, brick, ball.r);
+    if (t !== null && t < bestT) {
+      bestT = t;
+      bestBrick = brick;
+    }
+  }
+  if (bestBrick === null) return [];
+
+  // Contact point: where the ball first touches the brick's expanded box.
+  const t = Math.max(0, bestT);
+  const ex = x0 + dx * t;
+  const ey = y0 + dy * t;
+
+  // Penetration depths of the ball (circle box) into the brick at contact.
+  const penX = Math.min(ex + ball.r - bestBrick.x, bestBrick.x + bestBrick.w - (ex - ball.r));
+  const penY = Math.min(ey + ball.r - bestBrick.y, bestBrick.y + bestBrick.h - (ey - ball.r));
+
+  const EPS = 0.001; // push-out margin: keeps the ball off the boundary
+  const corner = Math.abs(penX - penY) < 1e-6;
+
+  if (corner) {
+    // Diagonal hit on a corner: reflect both components.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x = ex + Math.sign(ball.vx) * EPS;
+    ball.y = ey + Math.sign(ball.vy) * EPS;
+  } else if (penX < penY) {
+    // Side hit: flip vx, leave vy exactly as it was, push out sideways.
+    ball.vx = -ball.vx;
+    if (dx > 0) ball.x = bestBrick.x - ball.r - EPS;
+    else if (dx < 0) ball.x = bestBrick.x + bestBrick.w + ball.r + EPS;
+    else ball.x = ball.x < bestBrick.x + bestBrick.w / 2 ? bestBrick.x - ball.r - EPS : bestBrick.x + bestBrick.w + ball.r + EPS;
+  } else {
+    // Top/bottom hit: flip vy, leave vx exactly as it was, push out vertically.
+    ball.vy = -ball.vy;
+    if (dy > 0) ball.y = bestBrick.y - ball.r - EPS;
+    else if (dy < 0) ball.y = bestBrick.y + bestBrick.h + ball.r + EPS;
+    else ball.y = ball.y < bestBrick.y + bestBrick.h / 2 ? bestBrick.y - ball.r - EPS : bestBrick.y + bestBrick.h + ball.r + EPS;
+  }
+
+  // Destroy every brick the ball touches at the contact point (seams: both).
+  const hits = [];
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    if (
+      ex >= brick.x - ball.r && ex <= brick.x + brick.w + ball.r &&
+      ey >= brick.y - ball.r && ey <= brick.y + brick.h + ball.r
+    ) {
+      brick.alive = false;
+      hits.push(brick);
+    }
+  }
+  return hits;
+}
+
+// Smallest t in [0, 1] at which the segment (x0,y0) -> (x0+dx, y0+dy) enters
+// the brick's box expanded by the ball radius, or null if it never does.
+function sweptContact(x0, y0, dx, dy, brick, r) {
+  const ex0 = brick.x - r;
+  const ex1 = brick.x + brick.w + r;
+  const ey0 = brick.y - r;
+  const ey1 = brick.y + brick.h + r;
+
+  let tx0 = -Infinity;
+  let tx1 = Infinity;
+  if (dx !== 0) {
+    const a = (ex0 - x0) / dx;
+    const b = (ex1 - x0) / dx;
+    tx0 = Math.min(a, b);
+    tx1 = Math.max(a, b);
+  } else if (x0 < ex0 || x0 > ex1) {
+    return null;
+  }
+
+  let ty0 = -Infinity;
+  let ty1 = Infinity;
+  if (dy !== 0) {
+    const a = (ey0 - y0) / dy;
+    const b = (ey1 - y0) / dy;
+    ty0 = Math.min(a, b);
+    ty1 = Math.max(a, b);
+  } else if (y0 < ey0 || y0 > ey1) {
+    return null;
+  }
+
+  const tmin = Math.max(tx0, ty0, 0);
+  const tmax = Math.min(tx1, ty1, 1);
+  return tmin <= tmax ? tmin : null;
+}
