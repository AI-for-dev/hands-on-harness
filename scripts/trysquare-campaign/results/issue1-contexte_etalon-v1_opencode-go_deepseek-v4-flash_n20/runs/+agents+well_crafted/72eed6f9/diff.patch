+// --- Issue #1: brick bounce -------------------------------------------------
+//
+// Brick grid geometry used below (makeBricks(1)): col 3 = x 244, col 4 = x 324,
+// row 2 = y 104 (so the brick spans x [244, 316], y [104, 124]), row 3 = y 132.
+
+function brickAt(bricks, x, y) {
+  return bricks.find((b) => b.x === x && b.y === y);
+}
+
+// Isolate a few bricks from the real grid: the rest are dead, like a
+// mid-game field. The grid pitch (28 px) is smaller than the ball + expansion
+// (brick + 14 px), so a position near one brick always touches its vertical
+// neighbours — isolating keeps each case focused on the faces under test.
+function isolate(bricks, ...keep) {
+  for (const b of bricks) {
+    if (!keep.includes(b)) b.alive = false;
+  }
+  return bricks;
+}
+
+// Ball ready to sweep into a brick: prev position is where the step started.
+function incomingBall({ x, y, prevX, prevY, vx, vy }) {
+  return { r: BALL_R, vx, vy, prevX, prevY, x, y };
+}
+
+test('brickHit: head-on bottom-face hit flips vy once and leaves vx alone', () => {
+  const bricks = makeBricks(1);
+  const brick = brickAt(bricks, 244, 104);
+  isolate(bricks, brick);
+  const ball = incomingBall({ x: 244, y: 130, prevX: 244, prevY: 150, vx: 50, vy: -300 });
+  const hits = brickHit(ball, bricks);
+  assert.equal(hits.length, 1);
+  assert.ok(hits[0] === brick);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vy, 300, 'vy must flip exactly (same magnitude)');
+  assert.equal(ball.vx, 50, 'vx is left exactly as it was');
+  assert.ok(ball.y >= brick.y + brick.h + BALL_R, 'ball pushed back out below the brick');
+  assert.equal(collides(ball, brick), false, 'no residual overlap (no sticky bounce)');
+});
