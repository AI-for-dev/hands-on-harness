+// --- Issue #1: the ball must bounce off bricks, not plow through ----------
+
+// A small helper: one brick, default-ish points, alive.
+function brick(x, y) {
+  return { x, y, w: 72, h: 20, row: 0, alive: true, points: 10 };
+}
+
+test('resolveBrickHit: bottom face hit flips vy, leaves vx, pushes out', () => {
+  // Ball climbing (vy < 0) into the brick's bottom face.
+  const ball = { x: 110, y: 117, r: 7, vx: 50, vy: -200 };
+  resolveBrickHit(ball, brick(100, 100));
+  assert.equal(ball.vy, 200, 'vy flips on a top/bottom hit');
+  assert.equal(ball.vx, 50, 'the other component is left exactly as it was');
+  assert.equal(ball.y, 127, 'ball pushed out below the brick (y = 120 + 7)');
+});
+
+test('resolveBrickHit: side face hit flips vx, leaves vy, pushes out', () => {
+  // Ball moving right into the brick's left face.
+  const ball = { x: 95, y: 110, r: 7, vx: 200, vy: 30 };
+  resolveBrickHit(ball, brick(100, 100));
+  assert.equal(ball.vx, -200, 'vx flips on a side hit');
+  assert.equal(ball.vy, 30, 'the other component is left exactly as it was');
+  assert.equal(ball.x, 93, 'ball pushed out left of the brick (x = 100 - 7)');
+});
+
+test('resolveBrickHit: corner hit (equal penetration) flips both components', () => {
+  // Diagonal overlap: penetration is equal on both axes.
+  const ball = { x: 94, y: 94, r: 7, vx: 200, vy: -200 };
+  resolveBrickHit(ball, brick(100, 100));
+  assert.equal(ball.vx, -200);
+  assert.equal(ball.vy, 200);
+  assert.equal(ball.x, 93, 'pushed out up-left of the brick');
+  assert.equal(ball.y, 93);
+});
