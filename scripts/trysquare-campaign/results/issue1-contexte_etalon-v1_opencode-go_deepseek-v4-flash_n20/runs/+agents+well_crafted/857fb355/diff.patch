+// Resolves a single ball/brick overlap (see #1):
+//   - per face: the axis with the SMALLER penetration is the face that was
+//     hit — flip vy on a top/bottom hit, vx on a side hit, and leave the
+//     other component exactly as it was;
+//   - corner: equal penetrations mean a diagonal hit — flip both components;
+//   - push out: the ball is repositioned just outside the brick along the hit
+//     axis(es), to the nearest face. Without this it still overlaps on the
+//     next frame and the bounce re-triggers forever (sticky bounce).
+// Mutates `ball` in place; returns nothing.
+export function resolveBrickHit(ball, brick) {
+  const overlapX =
+    Math.min(ball.x + ball.r, brick.x + brick.w) - Math.max(ball.x - ball.r, brick.x);
+  const overlapY =
+    Math.min(ball.y + ball.r, brick.y + brick.h) - Math.max(ball.y - ball.r, brick.y);
+
+  // Penetration depth per face, used to pick the nearest outside position.
+  const left = ball.x + ball.r - brick.x;
+  const right = brick.x + brick.w - (ball.x - ball.r);
+  const top = ball.y + ball.r - brick.y;
+  const bottom = brick.y + brick.h - (ball.y - ball.r);
+
+  if (overlapX < overlapY) {
+    // Side hit: the horizontal penetration is the shallowest.
+    ball.vx = -ball.vx;
+    if (left < right) ball.x = brick.x - ball.r;
+    else ball.x = brick.x + brick.w + ball.r;
+  } else if (overlapY < overlapX) {
+    // Top/bottom hit: the vertical penetration is the shallowest.
+    ball.vy = -ball.vy;
+    if (top < bottom) ball.y = brick.y - ball.r;
+    else ball.y = brick.y + brick.h + ball.r;
+  } else {
+    // Corner: equal penetration on both axes — diagonal hit, flip both.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    if (left < right) ball.x = brick.x - ball.r;
+    else ball.x = brick.x + brick.w + ball.r;
+    if (top < bottom) ball.y = brick.y - ball.r;
+    else ball.y = brick.y + brick.h + ball.r;
+  }
