+// --- #1: the ball bounces off bricks --------------------------------------
+
+// A ball with an explicit previous position (px, py): resolveBricks sweeps
+// between (px, py) and (x, y), exactly like step() records it each frame.
+function ballAt(x, y, vx, vy, px = x, py = y) {
+  return { x, y, r: 7, vx, vy, px, py };
+}
+
+function brickAt(x, y, points = 50) {
+  return { x, y, w: 72, h: 20, alive: true, row: 0, points };
+}
+
+function stateWith(ball, bricks) {
+  return { ball, bricks, score: 0, combo: 0, level: 1 };
+}
+
+test('#1 bottom face: vy flips, vx untouched, ball pushed out below', () => {
+  const brick = brickAt(100, 100);
+  const ball = ballAt(136, 120, 40, -300, 136, 140); // moving up into the brick
+  const state = stateWith(ball, [brick]);
+
+  resolveBricks(state);
+
+  assert.equal(ball.vy, 300, 'vy flips (down) on a bottom-face hit');
+  assert.equal(ball.vx, 40, 'vx is left exactly as it was');
+  assert.equal(brick.alive, false, 'the brick is broken');
+  assert.ok(ball.y > brick.y + brick.h + ball.r, 'ball is pushed back below the brick');
+  assert.equal(collides(ball, brick), false, 'no overlap left behind');
+});
+
+test('#1 left face: vx flips, vy untouched, ball pushed out to the left', () => {
+  const brick = brickAt(100, 100);
+  const ball = ballAt(95, 110, 300, -40, 85, 110); // moving right into the brick
+  const state = stateWith(ball, [brick]);
+
+  resolveBricks(state);
+
+  assert.equal(ball.vx, -300, 'vx flips (left) on a side-face hit');
+  assert.equal(ball.vy, -40, 'vy is left exactly as it was');
+  assert.equal(brick.alive, false, 'the brick is broken');
+  assert.ok(ball.x < brick.x - ball.r, 'ball is pushed back out to the left');
+  assert.equal(collides(ball, brick), false, 'no overlap left behind');
+});
+
+test('#1 corner: equal penetration flips both components', () => {
+  const brick = brickAt(100, 100);
+  const ball = ballAt(95, 95, 300, 300, 85, 85); // 45° into the top-left corner
+  const state = stateWith(ball, [brick]);
+
+  resolveBricks(state);
+
+  assert.equal(ball.vx, -300, 'vx flips on a diagonal hit');
+  assert.equal(ball.vy, -300, 'vy flips on a diagonal hit');
+  assert.equal(brick.alive, false, 'the brick is broken');
+  assert.ok(
+    ball.x < brick.x - ball.r && ball.y < brick.y - ball.r,
+    'ball is pushed back out diagonally',
+  );
+});
+
+test('#1 push-out: a ball already inside a brick is ejected, no sticky re-flip', () => {
+  const brick = brickAt(100, 100);
+  const ball = ballAt(136, 110, 0, -300, 136, 110); // deep inside, moving up
+  const state = stateWith(ball, [brick]);
+
+  resolveBricks(state);
+  assert.equal(ball.vy, 300, 'vy flips once');
+  assert.ok(ball.y > brick.y + brick.h + ball.r, 'ejected below the brick');
+  assert.equal(collides(ball, brick), false);
+
+  const vyAfter = ball.vy;
+  resolveBricks(state); // next frame: must not re-flip forever
+  assert.equal(ball.vy, vyAfter, 'no sticky bounce on the next pass');
+});
+
+test('#1 neighbours: vertical seam bounces exactly once and breaks both bricks', () => {
+  const left = brickAt(100, 100);
+  const right = brickAt(180, 100); // 8 px gap
+  const ball = ballAt(176, 120, 0, -300, 176, 140); // up through the seam
+  const state = stateWith(ball, [left, right]);
+
+  resolveBricks(state);
+
+  assert.equal(ball.vy, 300, 'flipped exactly once, not twice');
+  assert.equal(left.alive, false, 'left brick broken');
+  assert.equal(right.alive, false, 'right brick broken');
+  assert.equal(state.combo, 2);
+  assert.equal(state.score, 75 + 100, 'one brick at combo 1, the next at combo 2');
+  assert.equal(collides(ball, left), false);
+  assert.equal(collides(ball, right), false);
+});
+
+test('#1 neighbours: horizontal seam bounces vx exactly once and breaks both bricks', () => {
+  const top = brickAt(100, 100);
+  const bottom = brickAt(100, 128); // 8 px gap
+  const ball = ballAt(100, 124, 300, 0, 80, 124); // right through the row seam
+  const state = stateWith(ball, [top, bottom]);
+
+  resolveBricks(state);
+
+  assert.equal(ball.vx, -300, 'flipped exactly once, not twice');
+  assert.equal(top.alive, false, 'top brick broken');
+  assert.equal(bottom.alive, false, 'bottom brick broken');
+  assert.equal(collides(ball, top), false);
+  assert.equal(collides(ball, bottom), false);
+});
+
+test('#1 tunnelling: level-6 speed skips over a brick, the sweep still catches it', () => {
+  const brick = brickAt(100, 100);
+  // ballSpeed(6) = 710 px/s at the capped 50 ms step = 35.5 px, which is more
+  // than the 34 px (BRICK_H + diameter) needed to cross a brick: the ball ends
+  // the step ABOVE the brick without ever overlapping it.
+  const stepPx = ballSpeed(6) * 0.05;
+  const ball = ballAt(136, 128 - stepPx, 0, -710, 136, 128);
+  const state = stateWith(ball, [brick]);
+
+  assert.equal(collides(ball, brick), false, 'final position alone sees nothing');
+
+  resolveBricks(state);
+
+  assert.equal(brick.alive, false, 'the swept path crossed the brick');
+  assert.equal(ball.vy, 710, 'vy flips once');
+  assert.ok(ball.y > brick.y + brick.h + ball.r, 'pushed back below');
+});
+
