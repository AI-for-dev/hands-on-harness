+// --- Brick bounce (issue #1) -----------------------------------------------
+
+// Resolves a ball/brick overlap: the axis with the SMALLER penetration is the
+// face that was hit — flip `vy` on a top/bottom hit, `vx` on a side hit, and
+// leave the other component exactly as it was. Equal penetrations mean a
+// corner (diagonal) hit: flip both. In every case the ball is pushed back out
+// of the brick rectangle, otherwise it still overlaps on the next frame and
+// re-flips forever (sticky bounce).
+// Mutates the ball in place and returns it.
+export function bounceBrick(ball, brick) {
+  const overlapLeft = ball.x + ball.r - brick.x;
+  const overlapRight = brick.x + brick.w - (ball.x - ball.r);
+  const overlapTop = ball.y + ball.r - brick.y;
+  const overlapBottom = brick.y + brick.h - (ball.y - ball.r);
+
+  const minX = Math.min(overlapLeft, overlapRight);
+  const minY = Math.min(overlapTop, overlapBottom);
+
+  if (minX < minY) {
+    // Side hit: flip vx, leave vy exactly as it was.
+    if (overlapLeft < overlapRight) {
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+  } else if (minY < minX) {
+    // Top/bottom hit: flip vy, leave vx exactly as it was.
+    if (overlapTop < overlapBottom) {
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  } else {
+    // Corner: equal penetration on both axes — a diagonal hit, flip both.
+    if (overlapLeft < overlapRight) {
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+    if (overlapTop < overlapBottom) {
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  }
+  return ball;
+}
+
+// Sweeps the ball along the path it travelled this frame (from its previous
+// position `px,py` to `x,y`) and returns the bricks hit at the FIRST point of
+// contact. Detection is discrete, so a fast ball could otherwise jump over a
+// brick between two samples: at level 6 the ball covers 35.5 px per frame
+// (710 px/s over the 50 ms cap) against 34 px to cross a brick
+// (BRICK_H + diameter). Sub-steps of two radii keep consecutive ball boxes in
+// contact, so nothing can slip between them.
+// A seam hit returns several bricks (gap 8 px < ball 14 px across) — the
+// caller must bounce exactly once (see `brickCollision`).
+// Returns an array of { brick, x, y } (empty when nothing is hit).
+export function sweepBricks(ball, bricks) {
+  const px = ball.px ?? ball.x;
+  const py = ball.py ?? ball.y;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+  const dist = Math.hypot(dx, dy);
+  const steps = Math.max(1, Math.ceil(dist / (2 * ball.r)));
+
+  for (let i = 1; i <= steps; i++) {
+    const t = i / steps;
+    const x = px + dx * t;
+    const y = py + dy * t;
+    const hits = [];
+    for (const brick of bricks) {
+      if (!brick.alive) continue;
+      if (collides({ x, y, r: ball.r }, brick)) {
+        hits.push({ brick, x, y });
+      }
+    }
+    if (hits.length > 0) return hits;
+  }
+  return [];
+}
+
+// One frame of brick interaction: sweep-detect the bricks the ball touched,
+// destroy and score them all, place the ball at the first contact point and
+// bounce it EXACTLY once — a second flip would cancel the first and the ball
+// would sail through the seam (see #1, neighbours).
+// Returns the number of bricks destroyed.
+export function brickCollision(state) {
+  const { ball, bricks } = state;
+  const hits = sweepBricks(ball, bricks);
+  if (hits.length === 0) return 0;
+
+  for (const hit of hits) {
+    hit.brick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(hit.brick, state.combo);
+  }
+
+  // Resolve the bounce against the first brick touched, from the position
+  // where the ball actually made contact (not from its current position,
+  // which may be on the far side of the brick after a fast move).
+  const first = hits[0];
+  ball.x = first.x;
+  ball.y = first.y;
+  bounceBrick(ball, first.brick);
+
+  // Safety net: the push-out can, in rare corner configurations, shove the
+  // ball into a neighbour that was not part of this hit set. Destroy those
+  // too — they were touched — but never bounce twice.
+  for (const brick of bricks) {
+    if (brick.alive && collides(ball, brick)) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+    }
+  }
+
+  return hits.length;
+}
