+// --- Issue #1: the ball must bounce off bricks ------------------------------
+
+// A brick placed at a known spot, 72x20 like the real grid.
+function testBrick(over = {}) {
+  return { x: 90, y: 100, w: 72, h: 20, alive: true, row: 0, points: 100, ...over };
+}
+
+function testBall(over = {}) {
+  return { x: 110, y: 110, r: 7, vx: 0, vy: 0, ...over };
+}
+
+// #1 — per face: a hit on the TOP face flips vy and leaves vx exactly as it was.
+test('bounceBrick: top hit flips vy, leaves vx, pushes the ball out', () => {
+  // Ball above the brick (y+r = 102 > 100), moving down into its top face.
+  const ball = testBall({ y: 95, vx: 120, vy: 300 });
+  const brick = testBrick();
+  bounceBrick(ball, brick);
+  assert.equal(ball.vy, -300, 'vy must flip (down -> up)');
+  assert.equal(ball.vx, 120, 'vx must be left untouched');
+  assert.equal(ball.y, brick.y - ball.r, 'ball must sit on top of the brick');
+  assert.equal(collides(ball, brick), false, 'no residual overlap');
+});
+
+// #1 — per face: a SIDE hit flips vx and leaves vy exactly as it was.
+test('bounceBrick: side hit flips vx, leaves vy, pushes the ball out', () => {
+  // Ball entering the LEFT face (x+r = 92 > 90), moving right.
+  const ball = testBall({ x: 85, y: 110, vx: 300, vy: -120 });
+  const brick = testBrick();
+  bounceBrick(ball, brick);
+  assert.equal(ball.vx, -300, 'vx must flip (right -> left)');
+  assert.equal(ball.vy, -120, 'vy must be left untouched');
+  assert.equal(ball.x, brick.x - ball.r, 'ball must sit left of the brick');
+  assert.equal(collides(ball, brick), false, 'no residual overlap');
+});
+
+// #1 — corner: equal penetration on both axes means a diagonal hit.
+test('bounceBrick: corner hit (equal penetration) flips both components', () => {
+  // Ball straddling the top-left corner: overlapLeft == overlapTop == 10.
+  const ball = testBall({ x: 93, y: 103, vx: 300, vy: 300 });
+  const brick = testBrick();
+  bounceBrick(ball, brick);
+  assert.equal(ball.vx, -300, 'vx must flip on a corner hit');
+  assert.equal(ball.vy, -300, 'vy must flip on a corner hit');
+  assert.equal(collides(ball, brick), false, 'ball must be pushed out of the corner');
+});
+
+// #1 — push out: the ball must never be left overlapping, or the next frame
+// re-flips forever (sticky bounce).
+test('bounceBrick: deep overlap is resolved to a touching position', () => {
+  const ball = testBall({ x: 110, y: 100, vy: 300 }); // box [103,117]x[93,107]
+  const brick = testBrick();
+  bounceBrick(ball, brick);
+  assert.equal(ball.y, brick.y - ball.r);
+  assert.equal(collides(ball, brick), false);
+});
+
+// #1 — neighbours: the ball is 14 px across but the grid gap is 8 px, so a seam
+// overlaps TWO bricks in the same pass. The bounce must apply exactly once:
+// two flips cancel out and the ball sails straight through.
+test('brickCollision: seam hit destroys both bricks but bounces exactly once', () => {
+  const state = createState(1);
+  const left = testBrick({ x: 90, w: 72 });
+  const right = testBrick({ x: 170, w: 72 }); // gap 162..170 = 8 px
+  state.bricks = [left, right];
+  // Ball straddles the seam (box [159,173] spans both bricks) and clips the
+  // top faces (box top 86.5 < 100). Moving straight down.
+  state.ball = testBall({ x: 166, y: 93.5, vx: 0, vy: 300 });
+
+  brickCollision(state);
+
+  assert.equal(left.alive, false, 'left brick destroyed');
+  assert.equal(right.alive, false, 'right brick destroyed');
+  assert.equal(state.ball.vy, -300, 'vy flipped exactly once (not twice)');
+  assert.equal(state.ball.vx, 0, 'vx untouched on a top hit');
+  assert.equal(state.ball.y, 93, 'pushed out above the seam');
+  assert.equal(collides(state.ball, left), false);
+  assert.equal(collides(state.ball, right), false);
+});
+
+// #1 — tunnelling: detection is discrete (position before / after the move).
+// At level 6 the ball can cover 35.5 px per frame (710 px/s * 50 ms cap) while
+// a brick is crossed in 34 px (BRICK_H + diameter) — a naive endpoint test
+// misses it entirely. The sweep must catch it.
+test('sweepBricks: a 35.5 px/frame move cannot jump over a brick', () => {
+  const brick = testBrick();
+  // Endpoint position (y = 128.5, box [121.5,135.5]) is fully BELOW the brick
+  // (top face at 100, bottom at 120): a discrete check finds nothing.
+  const ball = testBall({ x: 110, py: 93, y: 128.5, vx: 0, vy: 710 });
+  assert.equal(collides(ball, brick), false, 'endpoint test alone would miss');
+
+  const hits = sweepBricks(ball, [brick]);
+  assert.equal(hits.length, 1, 'the sweep must find the brick mid-flight');
+  assert.equal(hits[0].brick, brick);
+});
+
+test('brickCollision: fast ball bounces off a brick it would otherwise cross', () => {
+  const state = createState(6);
+  const brick = testBrick();
+  state.bricks = [brick];
+  // One stuttered frame at level 6: 710 px/s over 50 ms = 35.5 px.
+  state.ball = testBall({ x: 110, py: 93, y: 128.5, vx: 0, vy: 710 });
+
+  brickCollision(state);
+
+  assert.equal(brick.alive, false, 'brick destroyed');
+  assert.equal(state.ball.vy, -710, 'bounced back up, not through');
+  assert.ok(state.ball.y + state.ball.r <= brick.y, 'ball ends up above the brick');
+  assert.equal(collides(state.ball, brick), false);
+});
+
+// #1 — the previous position must be recorded so the next frame can sweep.
+test('step: records the previous position before moving', () => {
+  const state = createState(1);
+  state.ball = testBall({ x: 200, y: 200, px: 0, py: 0, vx: 60, vy: 60 });
+  step(state, 1 / 60);
+  assert.equal(state.ball.px, 200, 'px must hold the pre-step x');
+  assert.equal(state.ball.py, 200, 'py must hold the pre-step y');
+});
