+// --- #1: brick bounce (issue #1) -------------------------------------------
+
+// A single live brick at the default grid position.
+function brickAt(x = 90, y = 90) {
+  return { x, y, w: BRICK_W, h: BRICK_H, alive: true, row: 0, points: 50 };
+}
+
+test('#1: top face hit flips vy, leaves vx, pushes the ball above the brick', () => {
+  const brick = brickAt();
+  const ball = { x: 100, y: 85, r: 7, vx: 30, vy: -200 }; // bottom 2 px into the brick
+  brickHit(ball, [brick]);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vy, 200, 'vy should flip to DOWN');
+  assert.equal(ball.vx, 30, 'vx must be left exactly as it was');
+  assert.equal(ball.y, brick.y - ball.r, 'ball pushed out above the brick');
+  assert.equal(collides(ball, brick), false);
+});
+
+test('#1: bottom face hit flips vy, leaves vx, pushes the ball below the brick', () => {
+  const brick = brickAt();
+  const ball = { x: 100, y: 115, r: 7, vx: 25, vy: -300 }; // climbing into the brick
+  brickHit(ball, [brick]);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vy, 300, 'vy should flip to DOWN');
+  assert.equal(ball.vx, 25, 'vx must be left exactly as it was');
+  assert.equal(ball.y, brick.y + brick.h + ball.r, 'ball pushed out below the brick');
+  assert.equal(collides(ball, brick), false);
+});
