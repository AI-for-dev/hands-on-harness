+
+test('brickHit: seam — two bricks in one pass, bounce applied exactly once', () => {
+  const a = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  const b = { x: 180, y: 100, w: 72, h: 20, alive: true };
+  const ball = { x: 176, y: 130, r: 7, vx: 0, vy: 300 };
+  const hits = resolveBrickCollision(ball, [a, b], 176, 60);
+  assert.equal(hits.length, 2);
+  assert.equal(a.alive, false);
+  assert.equal(b.alive, false);
+  assert.equal(ball.vy, -300, 'flipped once: +300 -> -300 (applied twice it would cancel)');
+  assert.equal(ball.vx, 0);
+  assert.equal(ball.y, a.y - 7, 'ball pushed out above the row');
+});
+
+test('brickHit: 2x2 corner — every brick in the way dies, one bounce', () => {
+  const a = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  const b = { x: 180, y: 100, w: 72, h: 20, alive: true };
+  const c = { x: 100, y: 128, w: 72, h: 20, alive: true };
+  const d = { x: 180, y: 128, w: 72, h: 20, alive: true };
+  const bricks = [a, b, c, d];
+  const ball = { x: 176, y: 124, r: 7, vx: 300, vy: 300 };
+  const hits = resolveBrickCollision(ball, bricks, 100, 48);
+  assert.equal(hits.length, 4);
+  assert.ok(bricks.every((br) => !br.alive));
+  assert.equal(ball.vx, -300);
+  assert.equal(ball.vy, -300);
+  assert.equal(ball.y, a.y - 7, 'ball pushed back out above the block');
+});
+
+test('brickHit: tunnelling — a fast ball cannot jump over a brick', () => {
+  const brick = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  // Started BELOW the brick, ended ABOVE it in one step: no overlap at either end.
+  const ball = { x: 120, y: 60, r: 7, vx: 0, vy: -300 };
+  const hits = resolveBrickCollision(ball, [brick], 120, 150);
+  assert.equal(hits.length, 1);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vy, 300, 'sweep catches the crossing and flips vy');
+  assert.equal(ball.y, brick.y + brick.h + 7, 'ball pushed out below the brick');
+  assert.ok(!collides(ball, brick));
+});
+
+test('brickHit: no sticky re-flip after the push-out', () => {
+  const brick = { x: 244, y: 100, w: 72, h: 20, alive: true };
+  const ball = { x: 300, y: 110, r: 7, vx: -300, vy: 0 };
+  resolveBrickCollision(ball, [brick], 330, 110);
+  assert.ok(!collides(ball, brick), 'ball pushed outside the brick');
+  // Next frame the ball flies away from the brick: no second flip, no re-hit.
+  ball.x += 10;
+  ball.vx = 300;
+  const again = resolveBrickCollision(ball, [brick], 323, 110);
+  assert.deepEqual(again, []);
+  assert.equal(ball.vx, 300);
+});
