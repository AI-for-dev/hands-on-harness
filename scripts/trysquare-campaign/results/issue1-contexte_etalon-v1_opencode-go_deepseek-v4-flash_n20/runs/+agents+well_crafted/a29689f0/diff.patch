+
+test('brickHit: diagonal corner — flips both axes', () => {
+  const brick = { x: 100, y: 100, w: 40, h: 20, alive: true };
+  const ball = { x: 160, y: 160, r: 8, vx: 300, vy: 300 };
+  const hits = resolveBrickCollision(ball, [brick], 80, 80);
+  assert.equal(hits.length, 1);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vx, -300);
+  assert.equal(ball.vy, -300);
