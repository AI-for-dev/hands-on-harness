+
+test('brickHit: exact corner via penetration — flips both axes', () => {
+  const brick = { x: 100, y: 100, w: 40, h: 20, alive: true };
+  // Equal 16 px overlap on both axes: diagonal hit, flip both components.
+  const ball = { x: 124, y: 108, r: 8, vx: 300, vy: 300 };
+  resolveBrickCollision(ball, [brick], 124, 108);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vx, -300);
+  assert.equal(ball.vy, -300);
+  assert.equal(ball.x, brick.x + brick.w + 8);
+  assert.equal(ball.y, brick.y - 8);
