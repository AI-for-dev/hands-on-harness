+// --- Brick bounce resolution (#1) ------------------------------------------
+
+// Slab-method test: does the segment (px,py)->(cx,cy) cross the rect
+// (rx,ry,rw,rh)? Returns null when it does not, otherwise the entry parameter
+// `t` (in [0,1]), the per-axis entry parameters tx/ty and the entry point
+// (x,y). The axis with the LARGER entry parameter is the face the segment
+// enters through; tx === ty means it enters exactly on a corner.
+function segmentRectEntry(px, py, cx, cy, rx, ry, rw, rh) {
+  const dx = cx - px;
+  const dy = cy - py;
+  let tmin = 0;
+  let tmax = 1;
+  let tx = 0;
+  let ty = 0;
+
+  if (Math.abs(dx) < 1e-12) {
+    if (px < rx || px > rx + rw) return null;
+  } else {
+    let t1 = (rx - px) / dx;
+    let t2 = (rx + rw - px) / dx;
+    if (t1 > t2) {
+      const t = t1;
+      t1 = t2;
+      t2 = t;
+    }
+    tx = t1;
+    tmin = Math.max(tmin, t1);
+    tmax = Math.min(tmax, t2);
+    if (tmin > tmax) return null;
+  }
+
+  if (Math.abs(dy) < 1e-12) {
+    if (py < ry || py > ry + rh) return null;
+  } else {
+    let t1 = (ry - py) / dy;
+    let t2 = (ry + rh - py) / dy;
+    if (t1 > t2) {
+      const t = t1;
+      t1 = t2;
+      t2 = t;
+    }
+    ty = t1;
+    tmin = Math.max(tmin, t1);
+    tmax = Math.min(tmax, t2);
+    if (tmin > tmax) return null;
+  }
+
+  return { t: tmin, tx, ty, x: px + dx * tmin, y: py + dy * tmin };
+}
+
+// Resolves the ball against every live brick for one frame, sweeping the path
+// from (prevX, prevY) to the ball's current position so that a fast ball
+// cannot tunnel through a brick between two frames (see ISSUES.md #1).
+//
+// Per brick, the face that was hit is the axis with the SMALLER penetration
+// (or the entry axis of the swept segment): vy flips on a top/bottom hit, vx
+// on a side hit, both on an exact corner. The bounce is applied ONCE even when
+// the ball overlaps two neighbours in the same pass (the seam case — flipping
+// twice would cancel out and let the ball through), and the ball is pushed
+// back out to the side it came from so it cannot re-overlap next frame
+// (no sticky bounce).
+//
+// Mutates: marks every hit brick `alive = false`, flips the ball velocity and
+// repositions the ball outside the bricks. Returns the array of hit bricks
+// (empty when nothing was touched).
+export function resolveBrickCollision(ball, bricks, prevX = ball.x, prevY = ball.y) {
+  const r = ball.r;
+  const hits = [];
+  let primary = null;
+  let flipX = false;
+  let flipY = false;
+
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+
+    // The brick grown by the ball radius: the region the ball CENTER must
+    // leave to be free of the brick. Sweeping against this box is what makes
+    // the detection continuous instead of a discrete before/after test.
+    const ex = brick.x - r;
+    const ey = brick.y - r;
+    const ew = brick.w + 2 * r;
+    const eh = brick.h + 2 * r;
+    const entry = segmentRectEntry(prevX, prevY, ball.x, ball.y, ex, ey, ew, eh);
+
+    // A sweep entry with t > 0 is a real face crossing. t === 0 means the ball
+    // already overlapped at the start of the frame (defensive path): fall back
+    // to a penetration test at the current spot.
+    let face = null;
+    if (entry && entry.t > 0) {
+      face = Math.abs(entry.tx - entry.ty) < 1e-9 ? 'both' : entry.tx > entry.ty ? 'x' : 'y';
+    } else if (collides(ball, brick)) {
+      const ox = Math.min(ball.x + r, brick.x + brick.w) - Math.max(ball.x - r, brick.x);
+      const oy = Math.min(ball.y + r, brick.y + brick.h) - Math.max(ball.y - r, brick.y);
+      if (ox <= 0 || oy <= 0) continue;
+      face = ox === oy ? 'both' : ox < oy ? 'x' : 'y';
+    }
+    if (!face) continue;
+
+    brick.alive = false;
+    hits.push(brick);
+
+    if (face === 'x') flipX = true;
+    else if (face === 'y') flipY = true;
+    else {
+      flipX = true;
+      flipY = true;
+    }
+
+    const t = entry ? entry.t : 0;
+    if (!primary || t < primary.t) primary = { brick, face, t };
+  }
+
+  if (!primary) return hits;
+
+  // The bounce, applied exactly once regardless of how many bricks were hit.
+  if (flipX) ball.vx = -ball.vx;
+  if (flipY) ball.vy = -ball.vy;
+
+  // Push the ball back out to the side it came from (the side prev is on,
+  // relative to the brick's center). Exact corner hits move it out on both axes.
+  const { brick, face } = primary;
+  const cx = brick.x + brick.w / 2;
+  const cy = brick.y + brick.h / 2;
+  if (face === 'x' || face === 'both') {
+    ball.x = prevX < cx ? brick.x - r : brick.x + brick.w + r;
+  }
+  if (face === 'y' || face === 'both') {
+    ball.y = prevY < cy ? brick.y - r : brick.y + brick.h + r;
+  }
+
+  return hits;
+}
