+// --- Issue #1: brick bounce -------------------------------------------------
+// Each case from ISSUES.md #1 is covered below: per-face bounce, corner,
+// push-out, neighbours (seam) and tunnelling.
+
+// Minimal 2D context stub: frame() only needs the calls above.
+function mockCtx() {
+  const noop = () => {};
+  return {
+    fillStyle: '',
+    font: '',
+    fillRect: noop,
+    fillText: noop,
+    beginPath: noop,
+    arc: noop,
+    fill: noop,
+  };
+}
+
+test('brickHit: side face — flips vx only and pushes the ball out', () => {
+  const brick = { x: 244, y: 100, w: 72, h: 20, alive: true };
+  const ball = { x: 300, y: 110, r: 7, vx: -300, vy: 0 };
+  const hits = resolveBrickCollision(ball, [brick], 330, 110);
+  assert.equal(hits.length, 1);
+  assert.equal(hits[0], brick);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vx, 300, 'side hit flips vx');
+  assert.equal(ball.vy, 0, 'the other component is left untouched');
+  assert.equal(ball.x, brick.x + brick.w + 7, 'ball pushed out to the right');
+  assert.ok(!collides(ball, brick), 'ball no longer overlaps the brick');
+});
+
+test('brickHit: top/bottom face — flips vy only and pushes the ball out', () => {
+  const brick = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  const ball = { x: 120, y: 96, r: 7, vx: 40, vy: -300 };
+  const hits = resolveBrickCollision(ball, [brick], 120, 150);
+  assert.equal(hits.length, 1);
+  assert.equal(hits[0], brick);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vy, 300, 'top/bottom hit flips vy');
+  assert.equal(ball.vx, 40, 'the other component is left untouched');
+  assert.equal(ball.y, brick.y + brick.h + 7, 'ball pushed out below the brick');
+  assert.ok(!collides(ball, brick));
+});
+
+test('brickHit: side face via penetration — smaller overlap axis wins', () => {
+  const brick = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  // 7 px overlap on x, 14 px on y: the smaller axis (x) is the face hit.
+  const ball = { x: 172, y: 110, r: 7, vx: -300, vy: 0 };
+  resolveBrickCollision(ball, [brick], 172, 110);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vx, 300);
+  assert.equal(ball.vy, 0);
+  assert.equal(ball.x, brick.x + brick.w + 7);
+});
+
+test('brickHit: top/bottom face via penetration — smaller overlap axis wins', () => {
+  const brick = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  // 7 px overlap on y, 14 px on x: the smaller axis (y) is the face hit.
+  const ball = { x: 120, y: 100, r: 7, vx: 0, vy: -300 };
+  resolveBrickCollision(ball, [brick], 120, 100);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vy, 300);
+  assert.equal(ball.vx, 0);
+  assert.equal(ball.y, brick.y - 7);
