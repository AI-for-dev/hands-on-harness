+test('brick bounce: seam — two bricks straddled, bounce applied exactly once', () => {
+  const state = createState(1);
+  const a = state.bricks[0]; // x 4..76
+  const b = state.bricks[1]; // x 84..156 (8 px gap)
+  const gap = (a.x + a.w + b.x) / 2; // 80: the ball (14 px) covers both edges
+  // Level with the row: the horizontal penetration is the smaller one, so the
