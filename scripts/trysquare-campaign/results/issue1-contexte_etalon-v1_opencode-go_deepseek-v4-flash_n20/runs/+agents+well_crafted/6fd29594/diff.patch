+// --- #1: brick bounce (face, corner, push-out, seam, tunnelling) -----------
+
+// Center of a brick: handy to aim the ball at a face.
+function centerOf(brick) {
+  return { x: brick.x + brick.w / 2, y: brick.y + brick.h / 2 };
+}
+
+// A ball just above a brick, heading straight down into its TOP face.
+function ballAbove(brick, vx = 0, vy = 300) {
+  return { x: centerOf(brick).x, y: brick.y - BALL_R - 1, r: BALL_R, vx, vy };
+}
+
+test('brick bounce: top face — vy flips up, vx untouched, ball pushed out', () => {
+  const state = createState(1);
+  const brick = state.bricks[0]; // row 0, col 0: x 4..76, y 48..68
+  state.ball = ballAbove(brick);
+
+  step(state, 1 / 60);
+
+  assert.equal(brick.alive, false, 'brick is broken');
+  assert.ok(state.ball.vy < 0, 'vy should flip upward');
+  assert.equal(state.ball.vx, 0, 'vx must be left exactly as it was');
+  assert.ok(state.ball.y + state.ball.r <= brick.y, 'ball pushed above the brick');
+  assert.equal(collides(state.ball, brick), false, 'no sticky overlap after bounce');
+});
+
+test('brick bounce: bottom face — vy flips down, ball pushed below', () => {
+  const state = createState(1);
+  const brick = state.bricks[BRICK_ROWS * BRICK_COLS - 1]; // last row: y 160..180
+  const c = centerOf(brick);
+  state.ball = { x: c.x, y: brick.y + brick.h + BALL_R + 1, r: BALL_R, vx: 0, vy: -300 };
+
+  step(state, 1 / 60);
+
+  assert.equal(brick.alive, false);
+  assert.ok(state.ball.vy > 0, 'vy should flip downward');
+  assert.equal(state.ball.vx, 0, 'vx untouched on a vertical hit');
+  assert.ok(state.ball.y - state.ball.r >= brick.y + brick.h, 'ball pushed below the brick');
+});
+
+test('brick bounce: left face — vx flips left, vy untouched, ball pushed out', () => {
+  const state = createState(1);
+  const brick = state.bricks[2]; // row 0, col 2: x 164..236
+  const c = centerOf(brick);
+  state.ball = { x: brick.x - BALL_R - 1, y: c.y, r: BALL_R, vx: 300, vy: 0 };
+
+  step(state, 1 / 60);
+
+  assert.equal(brick.alive, false);
+  assert.ok(state.ball.vx < 0, 'vx should flip leftward');
+  assert.equal(state.ball.vy, 0, 'vy untouched on a side hit');
+  assert.ok(state.ball.x + state.ball.r <= brick.x, 'ball pushed left of the brick');
+  assert.equal(collides(state.ball, brick), false, 'no sticky overlap after bounce');
+});
+
+test('brick bounce: right face — vx flips right, ball pushed out', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  const c = centerOf(brick);
+  state.ball = { x: brick.x + brick.w + BALL_R + 1, y: c.y, r: BALL_R, vx: -300, vy: 0 };
+
+  step(state, 1 / 60);
+
