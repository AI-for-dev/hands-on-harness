+
+test('brick bounce: corner — equal penetration flips BOTH components', () => {
+  const state = createState(1);
+  const brick = state.bricks[0]; // x 4..76, y 48..68
+  // Diagonal approach of the top-RIGHT corner from up-right (vx<0, vy>0):
+  // after the 5 px move the ball is 10 px past BOTH faces (equal penetration).
