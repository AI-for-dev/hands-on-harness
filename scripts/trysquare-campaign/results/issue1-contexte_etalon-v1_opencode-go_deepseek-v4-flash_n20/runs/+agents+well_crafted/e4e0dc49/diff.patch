+  if (flipVy) ball.vy = -vy0;
+
+  // Push out: on each flipped axis, snap the ball back just outside the brick
+  // whose face was hit (the smallest penetration on that axis). If that still
+  // overlaps another touched brick (deep seam graze), extend the snap until
