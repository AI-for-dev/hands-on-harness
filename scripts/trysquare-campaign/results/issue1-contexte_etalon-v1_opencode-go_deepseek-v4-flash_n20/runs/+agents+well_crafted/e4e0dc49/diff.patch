+// Resolves one pass of ball/brick collisions: destroys every brick the ball
+// touches and bounces the ball off the FIRST contact along its path.
+//
+// - per-face: the axis with the *smaller* penetration is the face that was
+//   hit — flip `vy` on a top/bottom hit, `vx` on a side hit, and leave the
+//   other component exactly as it was;
+// - corner: equal penetrations mean a diagonal hit — flip both components;
+// - push out: the ball is repositioned outside the brick rectangle, so the
+//   next frame cannot re-trigger the bounce (no sticky bounce);
+// - neighbours: the 8 px grid gap is narrower than the 14 px ball, so every
+//   seam overlaps two bricks in the SAME pass — the aggregate response is
+//   applied exactly once per axis (two `vy` flips would cancel out and let
+//   the ball through);
+// - tunnelling: detection is discrete (position before / after the move), and
+//   at level 6 a capped frame moves 35.5 px against the 34 px needed to cross
+//   a brick — so the path from the previous position (`ball.px`/`ball.py`) to
+//   the current one is swept in sub-steps.
+//
+// Returns the list of destroyed bricks.
+export function brickHit(ball, bricks) {
+  const r = ball.r;
+  const live = bricks.filter((b) => b.alive !== false);
+  if (live.length === 0) return [];
+
+  // Start of the sweep: the previous frame's position when known, otherwise
+  // the current one (single-position detection, no sweep).
+  const x0 = Number.isFinite(ball.px) ? ball.px : ball.x;
+  const y0 = Number.isFinite(ball.py) ? ball.py : ball.y;
+  const dx = ball.x - x0;
+  const dy = ball.y - y0;
+  const dist = Math.hypot(dx, dy);
+  const sub = Math.max(1, Math.ceil(dist / SWEEP_STEP));
+
+  // First sample along the path where the ball touches any brick. This is the
+  // true impact point — everything beyond it is unreachable this frame.
+  let sx = ball.x;
+  let sy = ball.y;
+  let hits = [];
+  for (let i = 0; i <= sub; i++) {
+    const t = i / sub;
+    const px = x0 + dx * t;
+    const py = y0 + dy * t;
+    hits = live.filter((b) => overlapsAt(px, py, r, b));
+    if (hits.length > 0) {
+      sx = px;
+      sy = py;
+      break;
+    }
+  }
+  if (hits.length === 0) return [];
+
+  // Face detection: for each touched brick, the smaller penetration is the
+  // face that was hit. Equal penetration on both axes = diagonal hit. The
+  // response is aggregated over all touched bricks so a seam hit applies the
+  // flip exactly once per axis (two `vy` flips would cancel out and let the
+  // ball through).
