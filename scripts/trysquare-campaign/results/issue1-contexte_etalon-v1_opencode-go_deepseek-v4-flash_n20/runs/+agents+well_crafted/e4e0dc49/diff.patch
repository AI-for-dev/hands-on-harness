+  let flipVy = false;
+  for (const p of pens) {
+    if (p.xPen <= p.yPen) flipVx = true; // side face hit
+    if (p.yPen <= p.xPen) flipVy = true; // top/bottom face hit
+  }
+
+  const vx0 = ball.vx;
+  const vy0 = ball.vy;
