+  const ball = {
+    x: brick.x + brick.w / 2, // straight down the middle of the top face
+    y: brick.y - BALL_R + 4, // bottom edge 4 px inside the face
+    r: BALL_R,
+    vx: 10, // a small drift: must survive untouched
+    vy: 300,
+    px: brick.x + brick.w / 2,
+    py: brick.y - BALL_R - 8, // the ball came from above
