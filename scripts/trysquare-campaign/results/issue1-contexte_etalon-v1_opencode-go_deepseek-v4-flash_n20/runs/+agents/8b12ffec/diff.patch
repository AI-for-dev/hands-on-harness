+// Anti-tunnelling sweep (#1): true if the ball swept from its previous position
+// (recorded by `step` as `prevX`/`prevY`) to its current one crosses the brick
+// at any point. Detection is discrete by default, so a fast ball can jump over
+// a whole brick between two frames (level 6+ can move > a brick height per
+// step). The trajectory is a segment; expanding the brick's AABB by the ball's
+// radius turns the check into segment-vs-expanded-rect.
+export function sweptCollides(ball, brick) {
+  const px = ball.prevX;
+  const py = ball.prevY;
+  // If there is no recorded previous position (e.g. a freshly created ball),
+  // there is nothing to sweep — fall back to the plain overlap test.
+  if (Number.isFinite(px) && Number.isFinite(py)) {
+    if (segmentHitsRect(px, py, ball.x, ball.y, ball.r, brick)) return true;
+  }
+  return collides(ball, brick);
+}
+
+// Li—Barsky style segment-vs-AABB test, with the rectangle grown by `r` on
+// every side so a segment swept by a radius `r` ball counts as a hit. The moved
+// point (x2, y2) is tested as a point into the expanded rect as the t=1 case.
+function segmentHitsRect(x1, y1, x2, y2, r, rect) {
+  const left = rect.x - r;
+  const right = rect.x + rect.w + r;
+  const top = rect.y - r;
+  const bottom = rect.y + rect.h + r;
+
+  const dx = x2 - x1;
+  const dy = y2 - y1;
+
+  let tMin = 0;
+  let tMax = 1;
+
+  const clip = (p, q) => {
+    if (p === 0) return q >= 0;
+    const t = q / p;
+    if (p < 0) {
+      if (t > tMax) return false;
+      if (t > tMin) tMin = t;
+    } else {
+      if (t < tMin) return false;
+      if (t < tMax) tMax = t;
+    }
+    return true;
+  };
+
+  if (!clip(-dx, x1 - left)) return false;
+  if (!clip(dx, right - x1)) return false;
+  if (!clip(-dy, y1 - top)) return false;
+  return clip(dy, bottom - y1);
+}
+
+// Resolves a single ball/brick collision: flips the velocity along the axis of
+// the face that was hit and pushes the ball back outside the brick so it no
+// longer overlaps (avoiding the sticky re-flip on the next frame).
+//
+// Per-face rule: the axis with the SMALLER penetration is the face hit —
+// flip `vy` on a top/bottom hit, `vx` on a side hit. Equal penetrations mean
+// a diagonal (corner) hit — flip both. The untouched component keeps its value.
+//
+// Neighbour rule: brick rows/columns are BRICK_GAP apart but the ball is large
+// enough to overlap two bricks in the same frame. The caller must apply the
+// bounce exactly ONCE per ball state (e.g. bail out of the pass after the
+// first resolved brick) so a second `vy = -vy` does not cancel the first and
+// let the ball through.
+//
+// Mutates `ball` (velocity and position) in place, like `step()`.
+export function resolveBrickHit(ball, brick) {
+  // Penetration through each face of the brick. Naming follows the face the
+  // ball would exit through:
+  //   overlapBottom = ball bottom offset past the brick TOP  (top-face hit)
+  //   overlapTop     = ball top    offset past the brick BOTTOM (bottom-face hit)
+  //   overlapRight  = ball right  offset past the brick LEFT   (left-face hit)
+  //   overlapLeft    = ball left   offset past the brick RIGHT  (right-face hit)
+  const overlapLeft = brick.x + brick.w - (ball.x - ball.r);
+  const overlapRight = ball.x + ball.r - brick.x;
+  const overlapTop = brick.y + brick.h - (ball.y - ball.r);
+  const overlapBottom = ball.y + ball.r - brick.y;
+
+  // Smallest penetration wins: that axis is the face the ball hit.
+  const penetrationX = Math.min(overlapLeft, overlapRight);
+  const penetrationY = Math.min(overlapTop, overlapBottom);
+
+  if (penetrationX < penetrationY) {
+    // Side hit: flip horizontal velocity and push out the face it hit.
+    if (overlapRight < overlapLeft) {
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+  } else if (penetrationY < penetrationX) {
+    // Top/bottom hit: flip vertical velocity and push out the face it hit.
+    if (overlapBottom < overlapTop) {
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  } else {
+    // Corner hit: equal penetration on both axes — flip both.
+    if (overlapRight < overlapLeft) {
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+    if (overlapBottom < overlapTop) {
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  }
+}
+
+// Resolves a hit found by the anti-tunnelling sweep rather than a direct
+// overlap. The ball's CURRENT position is past the brick, so pushing it out
+// along an overlap face makes no sense. Instead we use the travel direction to
+// pick which face the ball crossed, place the ball back just outside that face
+// and flip only the corresponding velocity component (#1, last case).
+// In every other respect (score already applied by the caller) it mirrors
+// `resolveBrickHit`; the single-pass `bounced` guard still applies.
+export function resolveSweptHit(ball, brick) {
+  // The face crossed is the one the velocity drives the ball through.
+  if (ball.vx > 0) {
+    // Moving right: crossed the brick's LEFT face.
+    ball.x = brick.x - ball.r;
+    ball.vx = -Math.abs(ball.vx);
+  } else if (ball.vx < 0) {
+    // Moving left: crossed the brick's RIGHT face.
+    ball.x = brick.x + brick.w + ball.r;
+    ball.vx = Math.abs(ball.vx);
+  }
+
+  if (ball.vy > 0) {
+    // Moving down: crossed the brick's TOP face.
+    ball.y = brick.y - ball.r;
+    ball.vy = -Math.abs(ball.vy);
+  } else if (ball.vy < 0) {
+    // Moving up: crossed the brick's BOTTOM face.
+    ball.y = brick.y + brick.h + ball.r;
+    ball.vy = Math.abs(ball.vy);
+  }
+}
