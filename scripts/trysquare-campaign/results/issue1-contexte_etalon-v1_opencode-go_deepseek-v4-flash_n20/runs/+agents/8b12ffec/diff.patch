+test('resolveBrickHit: top hit flips vy up and pushes ball above the brick', () => {
+  const brick = { x: 100, y: 100, w: 40, h: 20 };
+  const ball = { x: 120, y: 104, r: 8, vx: 0, vy: 300 }; // descending into the top
+  resolveBrickHit(ball, brick);
+  assert.ok(ball.vy < 0, 'vertical velocity should flip to UP');
+  assert.ok(ball.y + ball.r <= brick.y, 'ball must be pushed out above the brick');
+  assert.equal(ball.vx, 0, 'horizontal component untouched');
+});
+
+test('resolveBrickHit: side hit flips vx and pushes ball to the left edge', () => {
+  const brick = { x: 100, y: 100, w: 40, h: 20 };
+  // Moving right, hitting the left face of the brick.
+  const ball = { x: 92, y: 110, r: 8, vx: 300, vy: 0 };
+  resolveBrickHit(ball, brick);
+  assert.ok(ball.vx < 0, 'horizontal velocity should flip to LEFT');
+  assert.ok(ball.x + ball.r <= brick.x, 'ball must be pushed left of the brick');
+  assert.equal(ball.vy, 0, 'vertical component untouched');
+});
