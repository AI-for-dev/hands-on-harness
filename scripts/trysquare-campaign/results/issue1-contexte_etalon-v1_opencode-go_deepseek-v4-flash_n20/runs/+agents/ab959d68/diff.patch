+// True if the ball (circle approximated by its box) overlaps the brick.
+// Simple AABB test: it only says WHETHER the ball and the brick overlap, not
+// WHICH face was hit.
+//
+// Resolve a brick hit with a real per-face bounce. The ball is pushed back out
+// along the axis of least penetration, and that axis's velocity component is
+// flipped. This stops the ball from plowing straight through a column head-on
+// (flips vy) and through the side of a row (flips vx).
+function bounceOffBrick(ball, brick) {
+  // Overlap (penetration) depth on each axis.
+  const overlapX =
+    Math.min(ball.x + ball.r, brick.x + brick.w) - Math.max(ball.x - ball.r, brick.x);
+  const overlapY =
+    Math.min(ball.y + ball.r, brick.y + brick.h) - Math.max(ball.y - ball.r, brick.y);
+
+  if (overlapX < overlapY) {
+    // Hit the left/right face: reflect horizontally.
+    const hitLeft = ball.x < brick.x + brick.w / 2;
+    ball.vx = Math.abs(ball.vx) * (hitLeft ? LEFT : RIGHT);
+    ball.x = hitLeft ? brick.x - ball.r : brick.x + brick.w + ball.r;
+  } else {
+    // Hit the top/bottom face: reflect vertically.
+    const hitTop = ball.y < brick.y + brick.h / 2;
+    ball.vy = Math.abs(ball.vy) * (hitTop ? UP : DOWN);
+    ball.y = hitTop ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  }
+}
+
