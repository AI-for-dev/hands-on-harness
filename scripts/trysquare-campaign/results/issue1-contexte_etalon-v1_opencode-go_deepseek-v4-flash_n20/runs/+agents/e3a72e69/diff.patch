+// Builds a state whose grid holds exactly one brick (the top-left one) and a
+// placeholder ball. Returns the state plus the brick's x/y so a caller can aim
+// a fresh ball at it.
+function singleBrickState() {
+  const state = createState(1);
+  const brick = makeBricks(1)[0]; // row 0, col 0
+  state.bricks = [{ ...brick }];
+  state.ball = { x: 0, y: 0, r: BALL_R(), vx: 0, vy: 0 };
+  return { state, x: brick.x, y: brick.y };
+}
+
+// Ball hits the BOTTOM face of a brick (moving up) -> vy flips to DOWN.
+test('step: bounce up off the bottom of a brick', () => {
+  const { state, x, y } = singleBrickState();
+  state.ball.x = x + BRICK_W / 2;
+  state.ball.y = y + BRICK_H + BALL_R();
+  state.ball.vx = 0;
+  state.ball.vy = -260;
+  step(state, 1 / 60);
+  assert.equal(state.bricks[0].alive, false, 'brick should be destroyed');
+  assert.equal(Math.sign(state.ball.vy), DOWN, 'vy should flip downward');
+  assert.ok(state.score > 0, 'hitting a brick should score');
+});
+
+// Ball hits the LEFT face of a brick (moving right) -> vx flips to LEFT.
+test('step: bounce left off the side of a brick', () => {
+  const { state, x, y } = singleBrickState();
+  state.ball.x = x - BALL_R() - 2; // just left of the brick
+  state.ball.y = y + BRICK_H / 2;
+  state.ball.vx = 260;
+  state.ball.vy = 0;
+  step(state, 1 / 60);
+  assert.equal(Math.sign(state.ball.vx), LEFT, 'vx should flip leftward');
+});
+
+// Ball moving down through the seam between two bricks must NOT have its vy
+// flipped twice (which would cancel) — it must leave exactly once, downward.
+test('step: seam between two bricks bounces exactly once', () => {
+  const state = createState(1);
+  const b1 = makeBricks(1)[0];
+  const b2 = makeBricks(1)[1];
+  state.bricks = [{ ...b1 }, { ...b2 }];
+  // Ball centered on the seam between b1 and b2, moving DOWN into both.
+  const cx = (b1.x + b1.w + b2.x) / 2;
+  state.ball = {
+    x: cx,
+    y: b1.y - BALL_R() - 2,
+    r: 7,
+    vx: 0,
+    vy: 260,
+  };
+  step(state, 1 / 60);
+  assert.equal(Math.sign(state.ball.vy), UP, 'vy flipped exactly once -> bounces back up');
+  assert.ok(
+    state.bricks[0].alive === false || state.bricks[1].alive === false,
+    'seam hit a brick',
+  );
+});
+
+// A high-speed ball must not tunnel through a brick between two detections.
+test('step: fast ball does not tunnel through a brick', () => {
+  const { state, x, y } = singleBrickState();
+  state.ball.x = x + BRICK_W / 2;
+  state.ball.y = y + BRICK_H + BALL_R() + 2;
+  state.ball.vx = 0;
+  state.ball.vy = -710; // level ~6 speed (ballSpeed(6))
+  step(state, 1 / 60);
+  assert.equal(state.bricks[0].alive, false, 'fast ball should still hit the brick');
+  assert.equal(Math.sign(state.ball.vy), DOWN, 'fast ball should bounce back down');
+});
+
+function BALL_R() {
+  return 7;
+}
