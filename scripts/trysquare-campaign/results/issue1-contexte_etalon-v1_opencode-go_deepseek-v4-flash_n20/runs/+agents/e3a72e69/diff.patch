+
+// Resolves collisions of the ball with every live brick: destroys the brick
+// it hits, awards score/combo, and bounces the ball back out.
+//
+// Per-face bounce: the axis with the smaller penetration is the face that was
+// hit — flip `vy` on a top/bottom hit, `vx` on a side hit, and (for an equal
+// penetration = diagonal) flip both. Push-out repositions the ball just outside
+// the brick so it does not stick and re-flip forever. Each axis is flipped at
+// most once per pass so a ball resting on the seam between two adjacent bricks
+// (gap 8px < ball diameter 14px, so it overlaps both in the same pass) does not
+// cancel its own bounce.
+function resolveBricks(state) {
+  const { ball } = state;
+  let flippedX = false;
+  let flippedY = false;
+
+  for (const brick of state.bricks) {
+    if (!brick.alive || !collides(ball, brick)) continue;
+
+    brick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(brick, state.combo);
+
+    // Penetration depth past each inner face of the brick (all positive when overlapping).
+    const fromLeft = ball.x + ball.r - brick.x;
+    const fromRight = brick.x + brick.w - (ball.x - ball.r);
+    const fromAbove = ball.y + ball.r - brick.y;
+    const fromBelow = brick.y + brick.h - (ball.y - ball.r);
+    const penX = Math.min(fromLeft, fromRight);
+    const penY = Math.min(fromAbove, fromBelow);
+
+    if (penX < penY) {
+      // Side hit: bounce horizontally, push out along X.
+      if (!flippedX) ball.vx = -ball.vx;
+      flippedX = true;
+      pushOutX(ball, brick, fromLeft, fromRight);
+    } else if (penY < penX) {
+      // Top/bottom hit: bounce vertically, push out along Y.
+      if (!flippedY) ball.vy = -ball.vy;
+      flippedY = true;
+      pushOutY(ball, brick, fromAbove, fromBelow);
+    } else {
+      // Corner (equal penetration): bounce both axes.
+      if (!flippedX) ball.vx = -ball.vx;
+      if (!flippedY) ball.vy = -ball.vy;
+      flippedX = true;
+      flippedY = true;
+      pushOutX(ball, brick, fromLeft, fromRight);
+      pushOutY(ball, brick, fromAbove, fromBelow);
+    }
+  }
+}

