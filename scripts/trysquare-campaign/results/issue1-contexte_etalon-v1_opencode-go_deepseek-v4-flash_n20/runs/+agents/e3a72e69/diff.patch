+// Pushes the ball out of a brick along X, to whichever side was hit.
+function pushOutX(ball, brick, fromLeft, fromRight) {
+  if (fromLeft <= fromRight) ball.x = brick.x - ball.r;
+  else ball.x = brick.x + brick.w + ball.r;
+}
+
+// Pushes the ball out of a brick along Y, to whichever side was hit.
+function pushOutY(ball, brick, fromAbove, fromBelow) {
+  if (fromAbove <= fromBelow) ball.y = brick.y - ball.r;
+  else ball.y = brick.y + brick.h + ball.r;
