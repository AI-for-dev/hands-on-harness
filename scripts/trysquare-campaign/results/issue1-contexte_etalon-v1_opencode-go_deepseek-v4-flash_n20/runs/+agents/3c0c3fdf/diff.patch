+test('bounceOffBrick: top face hit flips vy and pushes ball up out', () => {
+  const brick = { x: 90, y: 90, w: 40, h: 20 };
+  // Ball rests on the brick's top: overlaps it bottom edge, moving down.
+  const ball = { x: 110, y: 104, r: 8, vx: 0, vy: 300 };
+  bounceOffBrick(ball, brick);
+  assert.ok(ball.vy < 0, 'vy should flip upward');
+  assert.equal(ball.y, brick.y - ball.r, 'ball resting exactly on the brick top');
+});
+
+test('bounceOffBrick: bottom face hit flips vy and pushes ball down out', () => {
+  const brick = { x: 90, y: 90, w: 40, h: 20 };
+  // Ball under the brick's bottom, moving up.
+  const ball = { x: 110, y: 86, r: 8, vx: 0, vy: -300 };
+  bounceOffBrick(ball, brick);
+  assert.ok(ball.vy > 0, 'vy should flip downward');
+  assert.equal(ball.y, brick.y + brick.h + ball.r, 'ball resting exactly under the brick');
+});
+
