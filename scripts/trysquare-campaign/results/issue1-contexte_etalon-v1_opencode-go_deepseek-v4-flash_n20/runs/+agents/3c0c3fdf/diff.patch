+// True if the ball overlaps the brick on the horizontal (side) axis only, i.e.
+// the ball's vertical centre is inside the brick's vertical extent. Used to
+// decide between a left/right bounce (flip vx) and a top/bottom bounce
+// (flip vy).
+export function hitsSide(ball, brick) {
+  return (
+    ball.y > brick.y &&
+    ball.y < brick.y + brick.h
+  );
+}
+
+// Deflects the ball off the brick face it hit and pushes it back out of the
+// brick so it cannot tunnel through on a later frame (see #1). Decides the
+// bounce axis from the sign of the ball's velocity AND whether it overlaps the
+// brick on the side axis: if the ball is moving horizontally into a face that
+// spans the ball's vertical centre, it is a side hit (flip vx); otherwise it is
+// a top/bottom hit (flip vy).
+export function bounceOffBrick(ball, brick) {
+  const overlapsSide = hitsSide(ball, brick);
+
+  // From the side, and moving horizontally into the brick -> side bounce.
+  if (overlapsSide && Math.abs(ball.vx) > Math.abs(ball.vy)) {
+    ball.vx = -ball.vx;
+    if (ball.vx > 0) ball.x = brick.x + brick.w + ball.r;
+    else ball.x = brick.x - ball.r;
+    return;
+  }
+
+  // Otherwise -> top/bottom bounce.
+  ball.vy = -ball.vy;
+  if (ball.vy > 0) ball.y = brick.y + brick.h + ball.r;
+  else ball.y = brick.y - ball.r;
+}
