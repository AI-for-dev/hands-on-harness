+// --- Brick bounce (#1) ------------------------------------------------------
+
+function brickAt(x, y) {
+  return { x, y, w: 40, h: 20, alive: true };
+}
+
+function ballAt(x, y, vx, vy) {
+  return { x, y, r: 8, vx, vy };
+}
+
+test('resolve: bottom-face hit flips vy, keeps vx, pushes out below', () => {
+  // Ball comes from BELOW the brick, moving UP into its bottom face.
+  const ball = ballAt(100, 70, 40, -300);
+  const brick = brickAt(90, 60); // bottom face at y = 80
+  const hit = resolveBrickCollision(ball, [brick], 100, 90);
+  assert.equal(hit, brick);
+  assert.equal(ball.vx, 40, 'vx untouched');
+  assert.ok(ball.vy > 0, 'vy flipped to head away (downward)');
+  assert.equal(ball.y, brick.y + brick.h + ball.r, 'ball pushed out below the brick');
+});
+
+test('resolve: side hit flips vx, keeps vy, pushes out horizontally', () => {
+  // Ball comes from the LEFT, moving RIGHT into the brick's left face.
+  const ball = ballAt(105, 70, 300, 40);
+  const brick = brickAt(90, 60);
+  const hit = resolveBrickCollision(ball, [brick], 70, 70);
+  assert.equal(hit, brick);
+  assert.ok(ball.vx < 0, 'vx flipped to head away (leftward)');
+  assert.equal(ball.vy, 40, 'vy untouched');
+  assert.equal(ball.x, brick.x - ball.r, 'ball pushed out left of the brick');
+});
+
+test('resolve: corner hit reflects BOTH components', () => {
+  // Ball centred on the brick's top-left corner: equal penetration on both
+  // axes means a diagonal hit, so both components reflect.
+  const ball = ballAt(98, 68, -200, -200);
+  const brick = brickAt(90, 60);
+  const hit = resolveBrickCollision(ball, [brick]);
+  assert.equal(hit, brick);
+  assert.ok(ball.vx > 0, 'vx reflected to the right');
+  assert.ok(ball.vy > 0, 'vy reflected downward');
+});
+
+test('resolve: tunnelling ball is caught by the sweep', () => {
+  // Ball starts BELOW the brick and vaults PAST it in one step, ending ABOVE
+  // it. Neither endpoint overlaps the brick (no overlap at y=120 nor y=40
+  // against the 60..80 band), so only the sweep can catch the frame-skip.
+  const brick = brickAt(90, 60); // x 90..130, y 60..80
+  const ball = ballAt(105, 40, 0, -300);
+  const hit = resolveBrickCollision(ball, [brick], 105, 120);
+  assert.equal(hit, brick);
+  assert.ok(ball.vy > 0, 'bounce happened, so the ball is heading back down');
+});
+
+test('resolve: no overlap => no hit, velocity untouched', () => {
+  const brick = brickAt(90, 60);
