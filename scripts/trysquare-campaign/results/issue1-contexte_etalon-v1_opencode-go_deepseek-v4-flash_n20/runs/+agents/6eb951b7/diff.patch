+// True if the ball circle (at cx, cy) overlaps the given brick. Same AABB test
+// as `collides` but for an arbitrary centre, used by the sweep in
+// `resolveBrickCollision`.
+function circleHitsRect(cx, cy, r, brick) {
+  return (
+    cx + r > brick.x &&
+    cx - r < brick.x + brick.w &&
+    cy + r > brick.y &&
+    cy - r < brick.y + brick.h
+  );
+}
+
+//--- Brick bounce (#1) ------------------------------------------------------
+
+// Resolves the ball against the live bricks and returns the brick that was
+// hit (or null if none). It applies a real, per-face bounce — the missing half
+// of bug #1:
+//  - the axis with the smaller penetration is the face hit: flips `vy` on a
+//    top/bottom hit, `vx` on a side hit, leaving the other component alone;
+//  - equal penetrations -> diagonal corner hit -> flips both components;
+//  - the ball is pushed back OUTSIDE the brick (no sticky overlap next frame);
+//  - the bounce is issued ONCE per call (a ball resting on a seam overlaps two
+//    bricks, but flipping `vy` for each of them would cancel out and let it
+//    through again);
+//  - a sweep between the previous centre and the current one catches fast,
+//    frame-skips tunnelling (level 6+ can jump a brick between two frames).
+//
+// `px`/`py` are the previous centre (captured before this frame's move); when
+// not provided the resolution falls back to a plain discrete check at the
+// current centre. The function only mutates `ball`; scoring / brick removal is
+// left to the caller.
+export function resolveBrickCollision(ball, bricks, px, py) {
+  const contact = findFirstContact(ball, bricks, px, py);
+  if (!contact) return null;
+
+  // Reposition the ball where it first touches the brick so integration and
+  // the bounce share one consistent position.
+  if (contact.swept) {
+    ball.x = contact.x;
+    ball.y = contact.y;
+  }
+  bounceBall(ball, contact.brick);
+  return contact.brick;
+}
+
+// Sweeps along the segment [previous centre -> current centre] and returns the
+// earliest live-brick contact, or null when the ball is in the clear.
+function findFirstContact(ball, bricks, px, py) {
+  const hasPrev = Number.isFinite(px) && Number.isFinite(py);
+
+  if (hasPrev) {
+    const dx = ball.x - px;
+    const dy = ball.y - py;
+    const dist = Math.hypot(dx, dy);
+    const ux = dist > 0 ? dx / dist : 0;
+    const uy = dist > 0 ? dy / dist : 0;
+    // Step in sub-pixel increments so a fast ball cannot skip over a brick.
+    for (let d = 0; d <= dist; d += 0.25) {
+      const cx = px + ux * d;
+      const cy = py + uy * d;
+      for (const brick of bricks) {
+        if (!brick.alive) continue;
+        if (circleHitsRect(cx, cy, ball.r, brick)) {
+          return { x: cx, y: cy, brick, swept: true };
+        }
+      }
+    }
+  }
+
+  // Discrete fallback at the current centre (no previous position given).
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    if (collides(ball, brick)) return { x: ball.x, y: ball.y, brick, swept: false };
+  }
+  return null;
+}
+
+// Deflects the ball off a single brick and pushes it back out of that brick.
+function bounceBall(ball, brick) {
+  const penL = ball.x + ball.r - brick.x;
+  const penR = brick.x + brick.w - (ball.x - ball.r);
+  const penT = ball.y + ball.r - brick.y;
+  const penB = brick.y + brick.h - (ball.y - ball.r);
+  const penX = Math.min(penL, penR);
+  const penY = Math.min(penT, penB);
+  const hitTop = penT < penB;
+  const hitLeft = penL < penR;
+
+  const radial = Math.abs(penX - penY) <= 0.5;
+  if (radial) {
+    // Diagonal corner hit: reflect both axes and push out into the free
+    // quadrant beyond the corner.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x = hitLeft ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    ball.y = hitTop ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  } else if (penX < penY) {
+    // Side hit: flip horizontal, push out horizontally.
+    ball.vx = hitLeft ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+    ball.x = hitLeft ? brick.x - ball.r : brick.x + brick.w + ball.r;
+  } else {
+    // Top/bottom hit: flip vertical, push out vertically.
+    ball.vy = hitTop ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+    ball.y = hitTop ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  }
+}
