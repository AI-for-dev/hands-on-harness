+// Whichever face the ball has penetrated least is the one it hit. Used only as
+// a static-position fallback (a corner contact). Drives the per-face bounce.
+function penetrationFace(ball, brick) {
+  const overlapLeft = ball.x + ball.r - brick.x;
+  const overlapRight = brick.x + brick.w - (ball.x - ball.r);
+  const overlapTop = ball.y + ball.r - brick.y;
+  const overlapBottom = brick.y + brick.h - (ball.y - ball.r);
+  const minX = Math.min(overlapLeft, overlapRight);
+  const minY = Math.min(overlapTop, overlapBottom);
+  if (Math.abs(minX - minY) < 1e-6) return 'corner';
+  if (minX < minY) return overlapLeft < overlapRight ? 'left' : 'right';
+  return overlapTop < overlapBottom ? 'top' : 'bottom';
+}
+
+// Sweep test between the ball's previous and current centre against a brick's
+// axis-aligned box expanded by the ball radius (so the disc's edge, not its
+// centre, is what touches). Returns null if the ball never enters the box
+// during this step, otherwise the earliest entry time `t` (in [0,1]) and the
+// face ('top' | 'bottom' | 'left' | 'right' | 'corner') that was hit. This is
+// what defeats tunnelling: the path is checked continuously, not just at the
+// end position.
+function sweptHit(px, py, x, y, r, brick) {
+  const minX = brick.x - r;
+  const maxX = brick.x + brick.w + r;
+  const minY = brick.y - r;
+  const maxY = brick.y + brick.h + r;
+  const dx = x - px;
+  const dy = y - py;
+
+  if (dx === 0 && dy === 0) {
+    if (px < minX || px > maxX || py < minY || py > maxY) return null;
+    return { t: 0, face: penetrationFace({ x: px, y: py, r }, brick) };
+  }
+
+  let tEnter = 0;
+  let tExit = 1;
+  let enterX = -Infinity;
+  let enterY = -Infinity;
+
+  // X slab.
+  if (dx === 0) {
+    if (px < minX || px > maxX) return null;
+  } else {
+    const t1 = (minX - px) / dx;
+    const t2 = (maxX - px) / dx;
+    const lo = Math.min(t1, t2);
+    const hi = Math.max(t1, t2);
+    enterX = lo;
+    tEnter = Math.max(tEnter, lo);
+    tExit = Math.min(tExit, hi);
+    if (tEnter > tExit) return null;
+  }
+
+  // Y slab.
+  if (dy === 0) {
+    if (py < minY || py > maxY) return null;
+  } else {
+    const t1 = (minY - py) / dy;
+    const t2 = (maxY - py) / dy;
+    const lo = Math.min(t1, t2);
+    const hi = Math.max(t1, t2);
+    enterY = lo;
+    tEnter = Math.max(tEnter, lo);
+    tExit = Math.min(tExit, hi);
+    if (tEnter > tExit) return null;
+  }
+
+  if (tEnter > 1) return null;
+  if (tEnter < 0) {
+    // Already overlapping before the move: immediate contact on this face.
+    return { t: 0, face: penetrationFace({ x, y, r }, brick) };
+  }
+
+  // The face hit is the axis whose entry crossing came last. Nearly-equal entry
+  // times mean a diagonal hit into a corner: reflect both axes.
+  if (dx !== 0 && dy !== 0 && Math.abs(enterX - enterY) < 1e-6) {
+    return { t: tEnter, face: 'corner' };
+  }
+  if (dy === 0 || (dx !== 0 && enterX > enterY)) {
+    return { t: tEnter, face: dx > 0 ? 'left' : 'right' };
+  }
+  return { t: tEnter, face: dy > 0 ? 'top' : 'bottom' };
+}
+
+// Finds the single brick the ball hits first on this step (a pure scan, no
+// rendering). Because the ball can straddle a 8px seam (it is 14px across),
+// ambiguous overlaps in the same pass must resolve to ONE brick so the bounce
+// applies exactly once. Returns `{ brick, face }`, or null when nothing is hit.
+export function brickCollision(ball, bricks) {
+  const { px, py, x, y, r } = ball;
+  let earliest = null;
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    const hit = sweptHit(px, py, x, y, r, brick);
+    if (!hit) continue;
+    if (earliest === null || hit.t < earliest.t) {
+      earliest = { brick, face: hit.face, t: hit.t };
+    }
+  }
+  if (earliest) return { brick: earliest.brick, face: earliest.face };
+
+  // Static-position fallback (corner contact) if the sweep found nothing.
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    if (collides(ball, brick)) return { brick, face: penetrationFace(ball, brick) };
+  }
+  return null;
+}
+
+// Applies a brick bounce to the ball: flips the component normal to the hit
+// face (leaving the other exactly as it was — a corner flips both) and pushes
+// the ball back outside the brick rectangle so it cannot overlap on the next
+// frame and re-flip forever (sticky bounce).
+export function resolveCollision(ball, brick, face) {
+  const r = ball.r;
+  switch (face) {
+    case 'top': // approached from above, moving down
+      ball.y = brick.y - r;
+      ball.vy = -Math.abs(ball.vy);
+      break;
+    case 'bottom': // approached from below, moving up
+      ball.y = brick.y + brick.h + r;
+      ball.vy = Math.abs(ball.vy);
+      break;
+    case 'left': // approached from the left, moving right
+      ball.x = brick.x - r;
+      ball.vx = -Math.abs(ball.vx);
+      break;
+    case 'right': // approached from the right, moving left
+      ball.x = brick.x + brick.w + r;
+      ball.vx = Math.abs(ball.vx);
+      break;
+    case 'corner': {
+      // Reflect both, then nudge the ball opposite to its incoming heading so
+      // it exits the corner instead of staying interlocked.
+      const dirX = ball.vx >= 0 ? 1 : -1;
+      const dirY = ball.vy >= 0 ? 1 : -1;
+      ball.x -= dirX * (r + 1);
+      ball.y -= dirY * (r + 1);
+      ball.vx = -ball.vx;
+      ball.vy = -ball.vy;
+      break;
+    }
+  }
+}
