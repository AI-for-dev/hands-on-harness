+// --- Issue #1: brick bounce -------------------------------------------------
+// Each case from ISSUES.md #1 is covered: per-face bounce, corner, push-out
+// (no sticky re-flip), neighbours (bounce exactly once) and tunnelling.
+
+test('brickCollision: top-face hit (ball moving down) flips vy only', () => {
+  const ball = { x: 30, y: 47, r: 7, vx: 0, vy: 300, px: 30, py: 40 };
+  const bricks = [{ x: 10, y: 48, w: 40, h: 20, alive: true }];
+  const hit = brickCollision(ball, bricks);
+  assert.ok(hit, 'expected a hit');
+  assert.equal(hit.face, 'top');
+  resolveCollision(ball, hit.brick, hit.face);
+  assert.equal(Math.sign(ball.vy), -1, 'vy should flip upward');
+  assert.equal(ball.vx, 0, 'vx left untouched');
+  assert.equal(ball.y, 48 - 7, 'ball pushed out above the brick');
+  assert.equal(collides(ball, hit.brick), false, 'no sticky overlap after resolve');
+});
+
+test('brickCollision: side hit (ball moving left into the right face) flips vx only', () => {
+  const ball = { x: 173, y: 20, r: 7, vx: -300, vy: 0, px: 180, py: 20 };
+  const bricks = [{ x: 100, y: 10, w: 72, h: 20, alive: true }];
+  const hit = brickCollision(ball, bricks);
+  assert.ok(hit, 'expected a hit');
+  assert.equal(hit.face, 'right');
+  resolveCollision(ball, hit.brick, hit.face);
+  assert.equal(Math.sign(ball.vx), 1, 'vx should flip rightward');
+  assert.equal(ball.vy, 0, 'vy left untouched');
+  assert.equal(ball.x, 100 + 72 + 7, 'ball pushed out to the right of the brick');
+  assert.equal(collides(ball, hit.brick), false, 'no sticky overlap after resolve');
+});
+
+test('resolveCollision: corner hit flips both velocity components', () => {
+  const ball = { x: 100, y: 100, r: 7, vx: -100, vy: -100 };
+  const brick = { x: 80, y: 80, w: 40, h: 20 };
+  resolveCollision(ball, brick, 'corner');
+  assert.equal(Math.sign(ball.vx), 1, 'vx reflected');
+  assert.equal(Math.sign(ball.vy), 1, 'vy reflected');
+});
+
+test('brickCollision: seam over two bricks yields exactly one bounce', () => {
+  const bricks = [
+    { x: 0, y: 48, w: 72, h: 20, alive: true },
+    { x: 80, y: 48, w: 72, h: 20, alive: true },
+  ];
+  // Ball centered in the 8px gap (diameter 14 > gap) moving straight down.
+  const ball = { x: 76, y: 47, r: 7, vx: 0, vy: 400, px: 76, py: 40 };
+  const hit = brickCollision(ball, bricks);
+  assert.ok(hit, 'expected a hit through the seam');
+  resolveCollision(ball, hit.brick, hit.face);
+  assert.equal(Math.sign(ball.vy), -1, 'vy flipped exactly once (not twice)');
+  assert.equal(collides(ball, bricks[0]), false);
+  assert.equal(collides(ball, bricks[1]), false);
+});
+
+test('brickCollision: sweep catches tunnelling through a brick at speed', () => {
+  const brick = { x: 0, y: 48, w: 72, h: 20, alive: true };
+  // ballSpeed(6) = 710 px/s at a 50 ms stutter => 35.5 px, which crosses the
+  // whole 34 px (BRICK_H + diameter) block in a single step.
+  const ball = { x: 30, y: 75.5, r: 7, vx: 0, vy: 710, px: 30, py: 40 };
+  assert.equal(collides(ball, brick), false, 'discrete check alone would miss it');
+  const hit = brickCollision(ball, [brick]);
+  assert.ok(hit, 'sweep must detect the tunnelled brick');
+  assert.equal(hit.face, 'top');
+  resolveCollision(ball, hit.brick, hit.face);
+  assert.equal(Math.sign(ball.vy), -1, 'vy flipped upward after the tunnel');
+  assert.equal(collides(ball, brick), false, 'ball parked outside the brick');
+});
+
