+// Deflects the ball off a brick face and pushes it back out of the brick.
+// Compares the ball centre against the brick centre to decide which face was
+// hit: a steep entry clears the vertical spans rapidly, so we bounce off the
+// face whose penetration is shallowest.
+// Returns `false` if the ball never overlapped the brick (nothing done).
+export function bounceBall(ball, brick) {
+  if (!collides(ball, brick)) return false;
+
+  // Penetration depths along each axis.
+  const overlapX =
+    ball.r +
+    Math.min(ball.x - brick.x, brick.x + brick.w - ball.x);
+  const overlapY =
+    ball.r +
+    Math.min(ball.y - brick.y, brick.y + brick.h - ball.y);
+
+  if (overlapX < overlapY) {
+    // Side hit: shallowest along X -> flip horizontal velocity and push out.
+    ball.vx = ball.x < brick.x ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+    ball.x = ball.x < brick.x ? brick.x - ball.r : brick.x + brick.w + ball.r;
+  } else {
+    // Top/bottom hit: shallowest along Y -> flip vertical velocity.
+    ball.vy = ball.y < brick.y ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+    ball.y = ball.y < brick.y ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  }
+
+  return true;
+}
