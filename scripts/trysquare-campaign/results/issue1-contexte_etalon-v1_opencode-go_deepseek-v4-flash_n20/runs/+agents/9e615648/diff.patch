+// Bounces the ball off a brick, flipping the correct velocity axis and
+// pushing the ball back out so it does not re-collide on the next frame.
+// A narrow overlap (from below/above) means a top/bottom hit => flip vy;
+// a wide overlap (from the sides) means a side hit => flip vx. In the
+// ambiguous corner case the dominant axis wins.
+export function bounceBall(ball, brick) {
+  // Depth the ball has sunk into the brick, from each side.
+  const overlapLeft = ball.x + ball.r - brick.x;
+  const overlapRight = brick.x + brick.w - (ball.x - ball.r);
+  const overlapTop = ball.y + ball.r - brick.y;
+  const overlapBottom = brick.y + brick.h - (ball.y - ball.r);
+
+  const minX = Math.min(overlapLeft, overlapRight);
+  const minY = Math.min(overlapTop, overlapBottom);
+
+  if (minY < minX) {
+    // Hit a horizontal face: flip vertical velocity.
+    if (overlapTop < overlapBottom) {
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  } else {
+    // Hit a vertical face: flip horizontal velocity.
+    if (overlapLeft < overlapRight) {
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+  }
+}
