+test('bounceBall: head-on top hit flips vy up and keeps it above the brick', () => {
+  const ball = { x: 320, y: 50, r: 7, vx: 0, vy: 300 };
+  const brick = { x: 300, y: 60, w: 72, h: 20 };
+  bounceBall(ball, brick);
+  assert.ok(ball.vy < 0, 'vertical velocity should flip to up');
+  assert.ok(ball.y + ball.r <= brick.y, 'ball pushed out above the brick');
+});
+
+test('bounceBall: side hit flips vx away from the brick', () => {
+  const ball = { x: 378, y: 110, r: 7, vx: -300, vy: 0 };
+  const brick = { x: 300, y: 100, w: 72, h: 20 };
+  bounceBall(ball, brick);
+  assert.ok(ball.vx > 0, 'horizontal velocity should flip to the right');
+  assert.ok(ball.x - ball.r >= brick.x + brick.w, 'ball pushed out right of the brick');
+});
+
+test('bounceBall: upward hit from below flips vy down', () => {
