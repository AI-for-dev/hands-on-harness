+// Penetration of the ball's box into a brick along each axis, as two positive
+// numbers. Larger number = deeper overlap on that axis.
+function penetration(ball, brick) {
+  const penX = Math.min(
+    brick.x + brick.w - (ball.x - ball.r),
+    ball.x + ball.r - brick.x,
+  );
+  const penY = Math.min(
+    brick.y + brick.h - (ball.y - ball.r),
+    ball.y + ball.r - brick.y,
+  );
+  return { penX, penY };
+}
+
+// Resolves a ball striking the bricks (the fix for #1: the ball previously
+// plowed straight through them).
+//
+// Scans every live brick for overlap with the ball. If any are hit it:
+//   - flips the axis with the SMALLER penetration (the face actually struck):
+//     top/bottom -> vy, side -> vx, an equal penetration corner -> both;
+//   - pushes the ball back OUT of the struck brick so it does not still
+//     overlap on the next frame (sticky re-flip);
+//   - flips each velocity component at most ONCE no matter how many bricks
+//     overlap the same pass (a grid seam overlaps two bricks at once;
+//     flipping twice on the same axis would null each other out).
+//
+// The ball is mutated; the bricks it touched are cleared (alive = false). The
+// list of cleared bricks is returned so the caller can award score.
+export function brickBounce(ball, bricks) {
+  const overlapped = bricks.filter((b) => b.alive && collides(ball, b));
+  if (overlapped.length === 0) return overlapped;
+  overlapped.forEach((b) => {
+    b.alive = false;
+  });
+
+  // The face is decided by the brick the ball is in the DEEPEST on the other
+  // axis — i.e. the one with the shallowest minimal penetration is the true
+  // impact point when several bricks share the same seam.
+  let primary = null;
+  for (const b of overlapped) {
+    const { penX, penY } = penetration(ball, b);
+    const m = Math.min(penX, penY);
+    if (!primary || m < primary.m) primary = { b, penX, penY, m };
+  }
+
+  if (primary.penX < primary.penY) {
+    // Side hit: flip horizontal, push out sideways.
+    ball.vx = -ball.vx;
+    ball.x += Math.sign(ball.vx) * primary.penX;
+  } else if (primary.penY < primary.penX) {
+    // Top/bottom hit: flip vertical, push out up/down.
+    ball.vy = -ball.vy;
+    ball.y += Math.sign(ball.vy) * primary.penY;
+  } else {
+    // Corner hit: flip both.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x += Math.sign(ball.vx) * primary.penX;
+    ball.y += Math.sign(ball.vy) * primary.penY;
+  }
+
+  return overlapped;
+}
