+test('brickBounce: no overlap => no hit, velocity untouched', () => {
+  const ball = { x: 320, y: 300, r: 7, vx: -200, vy: 0 };
+  const bricks = [{ x: 100, y: 100, w: 40, h: 20, alive: true }];
+  const hits = brickBounce(ball, bricks);
+  assert.equal(hits.length, 0);
+  assert.equal(ball.vx, -200);
+  assert.equal(ball.vy, 0);
+});
+
+test('brickBounce: top/bottom hit flips vy and clears the brick', () => {
+  // Ball falling onto the brick's TOP face (moving down), barely piercing it.
+  const ball = { x: 120, y: 100, r: 7, vx: 100, vy: 300 };
+  const bricks = [{ x: 100, y: 100, w: 40, h: 20, alive: true }];
+  const hits = brickBounce(ball, bricks);
+  assert.equal(hits.length, 1, 'a hit is reported');
+  assert.equal(hits[0].alive, false, 'the brick is cleared');
+  assert.equal(ball.vy, -300, 'vy flips on a top/bottom hit');
+  assert.equal(ball.vx, 100, 'vx is left alone on a top/bottom hit');
+  assert.ok(!collides(ball, bricks[0]), 'ball is pushed back out of the brick');
+});
+
+test('brickBounce: side hit flips vx and keeps vy', () => {
+  // Ball flying right into the brick's LEFT face.
+  const ball = { x: 97, y: 110, r: 7, vx: 300, vy: -100 };
+  const bricks = [{ x: 100, y: 100, w: 40, h: 20, alive: true }];
+  const hits = brickBounce(ball, bricks);
+  assert.equal(hits.length, 1);
+  assert.equal(ball.vx, -300, 'vx flips on a side hit');
+  assert.equal(ball.vy, -100, 'vy is untouched on a side hit');
+  assert.ok(!collides(ball, bricks[0]), 'ball is pushed back out of the brick');
+});
+
+test('brickBounce: corner hit flips both components', () => {
+  // Ball overlapping the top-left corner with equal penetration on both axes.
+  const ball = { x: 96, y: 96, r: 7, vx: -300, vy: -300 };
+  const bricks = [{ x: 100, y: 100, w: 40, h: 20, alive: true }];
+  brickBounce(ball, bricks);
+  assert.equal(ball.vx, 300);
+  assert.equal(ball.vy, 300);
+});
+
+test('brickBounce: grid seam kills both bricks but flips each axis once', () => {
+  // Two edge-adjacent bricks sharing a seam under a ball straddling that seam
+  // and just entering from below (the 14px ball overlaps both at once).
+  const ball = { x: 120, y: 136, r: 7, vx: 0, vy: -300 };
+  const bricks = [
+    { x: 100, y: 110, w: 20, h: 20, alive: true },
+    { x: 120, y: 110, w: 20, h: 20, alive: true },
+  ];
+  const hits = brickBounce(ball, bricks);
+  assert.equal(hits.length, 2, 'both seam bricks are reported');
+  assert.ok(hits.every((b) => !b.alive), 'both seam bricks are cleared');
+  assert.equal(ball.vy, 300, 'vy flips exactly once across the seam');
+  assert.equal(ball.vx, 0, 'vx untouched for a pure vertical hit');
+});
