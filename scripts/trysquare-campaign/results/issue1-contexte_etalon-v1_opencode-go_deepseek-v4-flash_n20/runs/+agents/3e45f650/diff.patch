diff --git a/game/neon.js b/game/neon.js
index 6b4a133..7608f69 100644
--- a/game/neon.js
+++ b/game/neon.js
@@ -223,11 +223,32 @@ export function frame(ctx, state) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      // Bounce the ball off the face it hit (fix for #1). The ball is
+      // currently overlapping the brick; we resolve on the axis of smallest
+      // penetration so a mostly-vertical attacker bounces vertically and a
+      // mostly-horizontal one horizontally, and push the ball back out of the
+      // brick so it never tunnels straight through.
+      const overlapX = Math.min(
+        state.ball.x + state.ball.r - brick.x,
+        brick.x + brick.w - (state.ball.x - state.ball.r)
+      );
+      const overlapY = Math.min(
+        state.ball.y + state.ball.r - brick.y,
+        brick.y + brick.h - (state.ball.y - state.ball.r)
+      );
+
+      if (overlapY <= overlapX) {
+        // Ball centre is nearer the top face => bounce up, else down.
+        const fromTop = state.ball.y < brick.y + brick.h / 2;
+        state.ball.y = fromTop ? brick.y - state.ball.r : brick.y + brick.h + state.ball.r;
+        state.ball.vy = Math.abs(state.ball.vy) * (fromTop ? -1 : 1);
+      } else {
+        // Ball centre is nearer the left face => bounce left, else right.
+        const fromLeft = state.ball.x < brick.x + brick.w / 2;
+        state.ball.x = fromLeft ? brick.x - state.ball.r : brick.x + brick.w + state.ball.r;
+        state.ball.vx = Math.abs(state.ball.vx) * (fromLeft ? -1 : 1);
+      }
     }
 
     ctx.fillStyle = brickColor(brick.row);
