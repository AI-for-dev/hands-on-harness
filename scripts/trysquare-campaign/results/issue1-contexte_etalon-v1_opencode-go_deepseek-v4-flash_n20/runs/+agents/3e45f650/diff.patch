+test('frame: ball hitting the bottom of a brick head-on bounces down, brick breaks', () => {
+  const state = isolatedState({ x: 200, y: 100, w: 72, h: 20 });
+  const brick = state.bricks[0];
+  // Ball climbs straight up INTO the bottom face: center just inside the brick.
+  state.ball = {
+    x: brick.x + brick.w / 2,
+    y: brick.y + brick.h - 4, // pierces 4px through the bottom face
+    r: BALL_R,
+    vx: 0,
+    vy: -300, // moving up
+  };
+  frame(ctxStub(), state);
+  assert.equal(brick.alive, false, 'brick should be broken');
+  assert.ok(state.ball.vy > 0, 'ball should bounce back down (off the bottom face)');
+  assert.equal(state.ball.vx, 0, 'head-on hit leaves horizontal velocity alone');
+  assert.ok(state.ball.y >= brick.y + brick.h + state.ball.r, 'ball pushed clear of the brick bottom');
+});
+
+test('frame: ball hitting the side of a brick bounces horizontally', () => {
+  const state = isolatedState({ x: 200, y: 100, w: 72, h: 20 });
+  const brick = state.bricks[0];
+  // Ball moving LEFT into the LEFT face from the right.
+  state.ball = {
+    x: brick.x + 2, // just inside the left face (centre near the left edge)
+    y: brick.y + brick.h / 2,
+    r: BALL_R,
+    vx: -300, // moving left
+    vy: 0,
+  };
+  frame(ctxStub(), state);
+  assert.equal(brick.alive, false, 'brick should be broken');
+  assert.ok(state.ball.vx < 0, 'ball should continue left after a left-face hit');
+  assert.equal(state.ball.y, brick.y + brick.h / 2, 'side hit leaves vertical position alone');
+  assert.ok(state.ball.x <= brick.x - state.ball.r, 'ball pushed clear of the brick left side');
+});
+
+// A fresh state with a single, isolated brick so a bounce never cascades into
+// a neighbouring cell (the full grid has no empty cells, which would mask the
+// exact face that was hit).
+function isolatedState(geom) {
+  return {
+    level: 1,
+    lives: 3,
+    score: 0,
+    combo: 0,
+    best: 0,
+    running: false,
+    paddle: { x: 0, y: PADDLE_Y, w: PADDLE_W, h: PADDLE_H },
+    ball: null,
+    bricks: [{ ...geom, row: 0, alive: true, points: 10 }],
+  };
+}
+
+
+// Minimal no-op 2D context so frame() can run headless.
+function ctxStub() {
+  const noop = () => {};
+  return {
+    fillStyle: null,
+    fillRect: noop,
+    fillText: noop,
+    beginPath: noop,
+    arc: noop,
+    fill: noop,
+  };
+}
