+// --- Brick bounce (#1) -----------------------------------------------------
+
+// Liang-Barsky segment intersection against an axis-aligned box, grown to the
+// bounds of the ball. Returns the entry parameter `t` in [0,1] along the
+// segment, plus the face entered ('top'|'bottom'|'left'|'right'|'corner'), or
+// null when the segment never enters the box. Sweeping the segment from the
+// previous to the current position is what defeats tunnelling (#1): at level 6
+// a stuttered frame can move the ball further than the brick is thick, but the
+// straight-line path still crosses it.
+function segmentEntry(px, py, qx, qy, box) {
+  const dx = qx - px;
+  const dy = qy - py;
+  const eps = 1e-9;
+  let tMin = 0;
+  let tMax = 1;
+  let inX = null; // enter-t along the segment, for the x axis
+  let inY = null;
+
+  if (Math.abs(dx) < eps) {
+    if (px < box.left || px > box.right) return null;
+    inX = null;
+  } else {
+    const tx1 = (box.left - px) / dx;
+    const tx2 = (box.right - px) / dx;
+    inX = Math.min(tx1, tx2);
+    tMin = Math.max(tMin, inX);
+    tMax = Math.min(tMax, Math.max(tx1, tx2));
+    if (tMin > tMax) return null;
+  }
+
+  if (Math.abs(dy) < eps) {
+    if (py < box.top || py > box.bottom) return null;
+    inY = null;
+  } else {
+    const ty1 = (box.top - py) / dy;
+    const ty2 = (box.bottom - py) / dy;
+    inY = Math.min(ty1, ty2);
+    tMin = Math.max(tMin, inY);
+    tMax = Math.min(tMax, Math.max(ty1, ty2));
+    if (tMin > tMax) return null;
+  }
+
+  let face;
+  if (inX === null) {
+    face = dy > 0 ? 'top' : 'bottom';
+  } else if (inY === null) {
+    face = dx > 0 ? 'left' : 'right';
+  } else if (Math.abs(inX - inY) < 1e-6) {
+    face = 'corner'; // the path enters through a corner: flip both
+  } else if (inX > inY) {
+    face = dx > 0 ? 'left' : 'right';
+  } else {
+    face = dy > 0 ? 'top' : 'bottom';
+  }
+  return { t: tMin, face };
+}
+
+// Among the live bricks, returns the FIRST one a travelling ball swept over
+// (smallest entry `t`), together with the face entered, or null. Resolving
+// against a single brick guarantees the bounce is applied exactly once even
+// when a seam overlaps two bricks in the same step.
+export function sweepBrick(prevX, prevY, ball, bricks) {
+  let best = null;
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    const box = {
+      left: brick.x - ball.r,
+      right: brick.x + brick.w + ball.r,
+      top: brick.y - ball.r,
+      bottom: brick.y + brick.h + ball.r,
+    };
+    const hit = segmentEntry(prevX, prevY, ball.x, ball.y, box);
+    if (hit && (!best || hit.t < best.t)) {
+      best = { brick, face: hit.face };
+    }
+  }
+  return best;
+}
+
+// Applies one brick bounce: flip the velocity component(s) of the entered
+// face, then push the ball back OUT of the brick rectangle so it no longer
+// overlaps on the next step (no sticky re-flip). A corner hit flips both
+// components. The push uses the freshly-flipped sign of each component so the
+// ball is always placed on the side it is heading away from.
+function applyBounce(ball, brick, face) {
+  if (face === 'corner') {
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x = ball.vx > 0 ? brick.x + brick.w + ball.r : brick.x - ball.r;
+    ball.y = ball.vy > 0 ? brick.y + brick.h + ball.r : brick.y - ball.r;
+  } else if (face === 'left' || face === 'right') {
+    ball.vx = -ball.vx;
+    ball.x = ball.vx > 0 ? brick.x + brick.w + ball.r : brick.x - ball.r;
+  } else {
+    // top / bottom
+    ball.vy = -ball.vy;
+    ball.y = ball.vy > 0 ? brick.y + brick.h + ball.r : brick.y - ball.r;
+  }
+}
