+// --- Brick bounce (#1) -----------------------------------------------------
+
+// Fresh state with only a paddle kept far away and a custom ball, so physics
+// steps never touch the walls or the paddle in these tests.
+function boxedState(ball) {
+  const state = createState(1);
+  state.paddle.y = -1000;
+  state.ball = { ...createState(1).ball, ...ball };
+  return state;
+}
+
+// Replaces the grid with one brick at (100, 100), size BRICK_W x BRICK_H.
+function singleBrick(state, x = 100, y = 100) {
+  state.bricks = [
+    { x, y, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 },
+  ];
+  return state.bricks[0];
+}
+
+test('brick bounce: top face flips vy, destroys the brick and pushes out', () => {
+  const state = boxedState({ x: 136, y: 90, r: 7, vx: 0, vy: 200 });
+  const brick = singleBrick(state);
+  step(state, 0.1); // ball moves y: 90 -> 110, crossing the top face
+  assert.equal(state.ball.vy, -200, 'approaching from above => bounce upward');
+  assert.equal(state.ball.vx, 0, 'horizontal component untouched on a top hit');
+  assert.equal(brick.alive, false);
+  assert.equal(state.ball.y, brick.y - 7, 'pushed out above the brick');
+});
+
+test('brick bounce: side face flips vx and pushes out to the side', () => {
+  const state = boxedState({ x: 70, y: 110, r: 7, vx: 200, vy: 0 });
+  const brick = singleBrick(state); // x: 100..172, y: 100..120
+  step(state, 0.3); // ball moves x: 70 -> 130, crossing the left face
+  assert.equal(state.ball.vx, -200, 'approaching from the left => bounce left');
+  assert.equal(state.ball.vy, 0, 'vertical component untouched on a side hit');
+  assert.equal(brick.alive, false);
+  assert.equal(state.ball.x, brick.x - 7, 'pushed out to the left of the brick');
+});
+
+test('brick bounce: corner hit flips both components', () => {
+  const state = boxedState({ x: 70, y: 70, r: 7, vx: 200, vy: 200 });
+  const brick = singleBrick(state); // corner at top-left (100, 100)
+  step(state, 0.3); // ball moves diagonally into the corner
+  assert.equal(state.ball.vx, -200);
+  assert.equal(state.ball.vy, -200);
+  assert.equal(brick.alive, false);
+});
+
+test('brick bounce: push-out leaves the ball clear so the next step keeps rising', () => {
+  const state = boxedState({ x: 136, y: 90, r: 7, vx: 0, vy: 200 });
+  const brick = singleBrick(state);
+  step(state, 0.1); // first bounce up, brick destroyed
+  assert.equal(state.ball.vy, -200);
+  const before = state.ball.y;
+  step(state, 0.1); // next step must keep climbing, no re-flip / sticky bounce
+  assert.equal(state.ball.vy, -200, 'no double flip');
+  assert.ok(state.ball.y < before, 'kept moving toward the ceiling');
+});
+
+test('brick bounce: a seam touching two bricks applies the bounce exactly once', () => {
+  const state = boxedState({ x: 172, y: 60, r: 7, vx: 0, vy: 300 });
+  const a = { x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 };
+  const b = { x: 172, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 };
+  state.bricks = [a, b]; // b touches a at x = 172; ball straddles the seam
+  step(state, 0.2); // y: 60 -> 120
+  assert.equal(state.ball.vy, -300, 'bounced up exactly once');
+  assert.equal(state.ball.vx, 0);
+  assert.equal(state.bricks.filter((x) => !x.alive).length, 1, 'only one brick destroyed');
+});
+
+test('brick bounce: swept detection still catches a brick tunnelled past at high speed', () => {
+  const state = boxedState({ x: 136, y: 50, r: 7, vx: 0, vy: 2000 });
+  const brick = singleBrick(state); // y: 100..120
+  step(state, 0.05); // y: 50 -> 150, fully past the brick in a single step
+  assert.equal(brick.alive, false, 'brick destroyed even though the ball jumped over it');
+  assert.equal(state.ball.vy, -2000, 'ball bounced back upward');
+});
