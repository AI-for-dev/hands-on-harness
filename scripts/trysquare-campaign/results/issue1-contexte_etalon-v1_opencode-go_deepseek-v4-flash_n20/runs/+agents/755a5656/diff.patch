+// --- Brick bounce (tested, #1) ---------------------------------------------
+
+// How far the ball's box would have to move to fully exit the brick on each
+// of its four sides. Only meaningful while the ball overlaps the brick: the
+// four amounts are all positive, and the SMALLEST of the pair on each axis is
+// the side the ball has pierced the least — i.e. the face it hit.
+function penetrationOf(ball, brick) {
+  const r = ball.r;
+  return Math.min(
+    (ball.x + r) - brick.x, // exit through the left face
+    (brick.x + brick.w) - (ball.x - r), // exit through the right face
+    (ball.y + r) - brick.y, // exit through the top face
+    (brick.y + brick.h) - (ball.y - r), // exit through the bottom face
+  );
+}
+
+// One step outward, past the brick surface, so the ball no longer overlaps it
+// on the next frame (a tangential ping-pong would re-flip forever — sticky).
+const PUSH_OUT = 0.1;
+
+// Resolves a single overlapping ball-vs-brick hit: flips the velocity on the
+// face with the smaller penetration (top/bottom => `vy`, side => `vx`) and
+// pushes the ball back out of the brick rectangle. Equal penetration on both
+// axes is a corner hit and flips both components. Mutates `ball`.
+export function bounceBall(ball, brick) {
+  const r = ball.r;
+  const x0 = brick.x;
+  const x1 = brick.x + brick.w;
+  const y0 = brick.y;
+  const y1 = brick.y + brick.h;
+
+  const outLeft = (ball.x + r) - x0;
+  const outRight = x1 - (ball.x - r);
+  const outUp = (ball.y + r) - y0;
+  const outDown = y1 - (ball.y - r);
+
+  const penX = Math.min(outLeft, outRight);
+  const penY = Math.min(outUp, outDown);
+
+  const EPS = 1e-3;
+  if (Math.abs(penX - penY) < EPS) {
+    // Corner: diagonal hit, flip both and exit through the nearest corner.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x = outLeft < outRight ? x0 - r - PUSH_OUT : x1 + r + PUSH_OUT;
+    ball.y = outUp < outDown ? y0 - r - PUSH_OUT : y1 + r + PUSH_OUT;
+  } else if (penX < penY) {
+    // Side hit: flip the horizontal component, push out horizontally.
+    ball.vx = -ball.vx;
+    ball.x = outLeft < outRight ? x0 - r - PUSH_OUT : x1 + r + PUSH_OUT;
+  } else {
+    // Top/bottom hit: flip the vertical component, push out vertically.
+    ball.vy = -ball.vy;
+    ball.y = outUp < outDown ? y0 - r - PUSH_OUT : y1 + r + PUSH_OUT;
+  }
+}
+
+// Continuous (swept) test for tunnelling: checks whether the segment between
+// the ball's previous and current centers crosses the radius-expanded brick.
+// The discrete `collides` test misses a fast ball that jumps clear over a thin
+// brick between two frames (level 6 can move ~35.5 px against a 34 px brick).
+// Returns `{ t, face }` on impact (t = time of first contact, face in
+// 'x' | 'y', or 'corner'), or `null` when the path misses the brick.
+export function tunnelHit(ball, brick) {
+  const px = Number.isFinite(ball.prevX) ? ball.prevX : ball.x;
+  const py = Number.isFinite(ball.prevY) ? ball.prevY : ball.y;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+  const x0 = brick.x - ball.r;
+  const x1 = brick.x + brick.w + ball.r;
+  const y0 = brick.y - ball.r;
+  const y1 = brick.y + brick.h + ball.r;
+
+  let t0 = 0;
+  let t1 = 1;
+  let enterX = null;
+  let enterY = null;
+
+  if (Math.abs(dx) < 1e-12) {
+    if (px <= x0 || px >= x1) return null;
+  } else {
+    const a = (x0 - px) / dx;
+    const b = (x1 - px) / dx;
+    enterX = Math.min(a, b);
+    t0 = Math.max(t0, enterX);
+    t1 = Math.min(t1, Math.max(a, b));
+  }
+  if (Math.abs(dy) < 1e-12) {
+    if (py <= y0 || py >= y1) return null;
+  } else {
+    const a = (y0 - py) / dy;
+    const b = (y1 - py) / dy;
+    enterY = Math.min(a, b);
+    t0 = Math.max(t0, enterY);
+    t1 = Math.min(t1, Math.max(a, b));
+  }
+
+  if (t0 > t1 + 1e-9 || t0 > 1) return null;
+
+  const EPS = 1e-3;
+  let face;
+  if (enterX === null) face = 'y';
+  else if (enterY === null) face = 'x';
+  else if (Math.abs(enterX - enterY) < EPS) face = 'corner';
+  else face = enterX > enterY ? 'x' : 'y';
+
+  return { t: t0, face };
+}
+
+// Resolves every brick the ball touches in one pass: destroys and scores each
+// one, but applies EXACTLY one bounce (plus push-out) against the shallowest
+// overlap or the earliest tunnelled brick. A seam brick overlaps two bricks in
+// the same pass; bouncing on each would make `vy = -vy` twice and cancel out,
+// letting the ball sail through (see #1). Pure against `state` — rendering is
+// untouched. Returns the number of bricks destroyed.
+export function resolveBricks(state) {
+  const ball = state.ball;
+  const overlap = [];
+  const tunnel = [];
+
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+    if (collides(ball, brick)) {
+      overlap.push(brick);
+    } else {
+      const hit = tunnelHit(ball, brick);
+      if (hit) tunnel.push({ brick, hit });
+    }
+  }
+
+  for (const brick of overlap) {
+    brick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(brick, state.combo);
+  }
+  for (const { brick } of tunnel) {
+    brick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(brick, state.combo);
+  }
+
+  if (overlap.length > 0) {
+    const best = overlap.reduce((a, b) =>
+      penetrationOf(ball, b) < penetrationOf(ball, a) ? b : a,
+    );
+    bounceBall(ball, best);
+  } else if (tunnel.length > 0) {
+    const best = tunnel.reduce((a, b) => (b.hit.t < a.hit.t ? b : a));
+    const { face } = best.hit;
+    if (face === 'x') ball.vx = -ball.vx;
+    else if (face === 'y') ball.vy = -ball.vy;
+    else {
+      ball.vx = -ball.vx;
+      ball.vy = -ball.vy;
+    }
+  }
+
+  return overlap.length + tunnel.length;
+}
