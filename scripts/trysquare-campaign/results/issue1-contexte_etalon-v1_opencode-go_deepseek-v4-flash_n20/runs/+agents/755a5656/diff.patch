+// --- #1 brick bounce -------------------------------------------------------
+
+const BRICK = { x: 200, y: 100, w: 72, h: 20 };
+
+function ballAt(x, y, vx = 0, vy = 0) {
+  return { x, y, vx, vy, r: BALL_R, prevX: x, prevY: y };
+}
+
+test('bounceBall: top hit flips vy and keeps vx, pushes the ball out', () => {
+  const ball = ballAt(236, 108, 50, 200); // just inside the top face
+  bounceBall(ball, BRICK);
+  assert.equal(ball.vx, 50, 'vx must be untouched on a top hit');
+  assert.ok(ball.vy < 0, 'vy must flip upward');
+  assert.ok(ball.y + ball.r <= BRICK.y, 'ball must be pushed above the brick');
+  assert.equal(collides(ball, BRICK), false, 'must no longer overlap the brick');
+});
+
+test('bounceBall: side hit flips vx and keeps vy, pushes the ball out sideways', () => {
+  const ball = ballAt(201, 110, -200, 30); // just inside the left face
+  bounceBall(ball, BRICK);
+  assert.ok(ball.vx > 0, 'vx must flip to the right');
+  assert.equal(ball.vy, 30, 'vy must be untouched on a side hit');
+  assert.ok(ball.x + ball.r <= BRICK.x, 'ball must be pushed to the left of the brick');
+  assert.equal(collides(ball, BRICK), false);
+});
+
+test('bounceBall: corner hit flips both components', () => {
+  const ball = ballAt(BRICK.x + 1, BRICK.y + 1, -200, -200); // into top-left corner
+  bounceBall(ball, BRICK);
+  assert.ok(ball.vx > 0, 'vx must flip on a corner hit');
+  assert.ok(ball.vy > 0, 'vy must flip on a corner hit');
+  assert.equal(collides(ball, BRICK), false);
+});
+
+test('tunnelHit: a fast ball jumping over a brick is still caught, and bounces', () => {
+  // Level-6 worst case: 35.5 px per frame against a 34 px brick (BRICK_H + 2r).
+  // Ball is below the brick before the move and above it after.
+  const brick = { x: 300, y: 200, w: 72, h: BRICK_H };
+  // Below the brick before the move, well above it after: a clean vertical hop
+  // over the whole brick in a single step.
+  const ball = { x: 336, y: 180, r: BALL_R, vx: 0, vy: -1000, prevX: 336, prevY: 230 };
+  const hit = tunnelHit(ball, brick);
+  assert.ok(hit, 'sweep must detect the tunnelling shot');
+  assert.equal(hit.face, 'y', 'vertical crossing must read as a top/bottom hit');
+  // Moving up, the ball first meets the expanded box at its bottom plane.
+  const t = (brick.y + BRICK_H + BALL_R - ball.prevY) / (ball.y - ball.prevY);
+  assert.ok(Math.abs(hit.t - t) < 1e-6, 'contact time must match the bottom face');
+});
+
