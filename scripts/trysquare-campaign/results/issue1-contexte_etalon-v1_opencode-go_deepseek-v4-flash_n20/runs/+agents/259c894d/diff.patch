+// Swept detection for the tunnelling case (issue #1): at level 6+ the ball can
+// cross a whole brick in a single capped frame without ever producing a
+// `collides()` overlap on either side. Detect the crossing on the SEGMENT from
+// the previous to the current position, treating the brick as expanded by the
+// ball radius. Returns the entry parameter t in [0,1] along the segment, or -1
+// if the path clears the brick. Uses Liang-Barsky against the expanded AABB.
+export function sweptHitT(ball, brick) {
+  const bx = ball.px;
+  const by = ball.py;
+  const cx = ball.x;
+  const cy = ball.y;
+  if (bx === undefined || by === undefined) return -1;
+
+  const dx = cx - bx;
+  const dy = cy - by;
+  if (dx === 0 && dy === 0) return -1;
+
+  // Expanded brick: the ball centre may be this close on every side.
+  const rx0 = brick.x - ball.r;
+  const ry0 = brick.y - ball.r;
+  const rx1 = brick.x + brick.w + ball.r;
+  const ry1 = brick.y + brick.h + ball.r;
+
+  let t0 = 0;
+  let t1 = 1;
+  const p = [-dx, dx, -dy, dy];
+  const q = [bx - rx0, rx1 - bx, by - ry0, ry1 - by];
+  for (let i = 0; i < 4; i++) {
+    if (p[i] === 0) {
+      if (q[i] < 0) return -1; // parallel and outside
+    } else {
+      const t = q[i] / p[i];
+      if (p[i] < 0) {
+        if (t > t1) return -1;
+        if (t > t0) t0 = t;
+      } else {
+        if (t < t0) return -1;
+        if (t < t1) t1 = t;
+      }
+    }
+  }
+  return t0 <= t1 ? t0 : -1;
+}
