+// Resolves a head-on collision (issue #1): the ball is currently overlapping a
+// brick, so decide which face was actually hit and bounce it off that face.
+//
+// The axis with the SMALLER penetration is the face that was hit: the side the
+// ball barely slipped past on one axis means the other axis did the crossing.
+// Flip `vy` on a top/bottom hit, `vx` on a side hit, and leave the other
+// component untouched. Two equal minima = a diagonal (corner) hit, where both
+// components flip. Finally the ball is pushed BACK OUT of the brick, otherwise
+// it would still overlap on the next frame and re-flip forever (sticky bounce).
+const EPS = 1e-6;
+export function deflectBall(ball, brick) {
+  // Penetration depth through each of the four faces (all >= 0 while overlapping).
+  const overL = ball.x + ball.r - brick.x;               // crossed the LEFT  face
+  const overR = brick.x + brick.w - (ball.x - ball.r);   // crossed the RIGHT face
+  const overT = ball.y + ball.r - brick.y;               // crossed the TOP    face
+  const overB = brick.y + brick.h - (ball.y - ball.r);   // crossed the BOTTOM face
+  const min = Math.min(overL, overR, overT, overB);
+
+  let flipX = false;
+  let flipY = false;
+
+  if (Math.abs(min - overL) < EPS) { ball.x = brick.x - ball.r; flipX = true; }
+  if (Math.abs(min - overR) < EPS) { ball.x = brick.x + brick.w + ball.r; flipX = true; }
+  if (Math.abs(min - overT) < EPS) { ball.y = brick.y - ball.r; flipY = true; }
+  if (Math.abs(min - overB) < EPS) { ball.y = brick.y + brick.h + ball.r; flipY = true; }
+
+  if (flipX) ball.vx = -ball.vx;
+  if (flipY) ball.vy = -ball.vy;
+}
