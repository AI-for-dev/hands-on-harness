diff --git a/game/neon.js b/game/neon.js
index 6b4a133..50765c1 100644
--- a/game/neon.js
+++ b/game/neon.js
@@ -223,11 +223,28 @@ export function frame(ctx, state) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      // Bounce (BUG #1): deflect the ball off the face that was hit and push it
+      // back out of the brick so it can't overlap again on the next frame.
+      const { ball } = state;
+      // Overlap depth on each axis. The face with the deepest penetration is
+      // the one the ball entered through — reflect that component.
+      const overlapLeft = ball.x + ball.r - brick.x;
+      const overlapRight = brick.x + brick.w - (ball.x - ball.r);
+      const overlapTop = ball.y + ball.r - brick.y;
+      const overlapBottom = brick.y + brick.h - (ball.y - ball.r);
+      const minX = Math.min(overlapLeft, overlapRight);
+      const minY = Math.min(overlapTop, overlapBottom);
+
+      if (minX < minY) {
+        // Side hit: flip horizontal velocity and push horizontally clear.
+        ball.vx = overlapLeft < overlapRight ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+        ball.x = overlapLeft < overlapRight ? brick.x - ball.r : brick.x + brick.w + ball.r;
+      } else {
+        // Top/bottom hit: flip vertical velocity and push vertically clear.
+        ball.vy = overlapTop < overlapBottom ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+        ball.y = overlapTop < overlapBottom ? brick.y - ball.r : brick.y + brick.h + ball.r;
+      }
     }
 
     ctx.fillStyle = brickColor(brick.row);
