+
+// Swept test: does the ball's path from (x0, y0) to (x1, y1) enter the brick
+// (inflated by the ball radius) during this step? Returns the earliest entry
+// time and the face entered ('x' side, 'y' side, or 'corner' when both faces
+// are crossed at the same instant), or null. Testing the path instead of the
+// end position is what stops a step longer than the brick from tunneling
+// through it (BRICK_H + 2*BALL_R = 34px, max step 35.5px at level 6, dt 0.05).
+function sweptHit(ball, brick, x0, y0, x1, y1) {
+  const tx = slab(x0, x1, brick.x - ball.r, brick.x + brick.w + ball.r);
+  const ty = slab(y0, y1, brick.y - ball.r, brick.y + brick.h + ball.r);
+  if (!tx || !ty) return null;
+  const tEntry = Math.max(tx[0], ty[0]);
+  const tExit = Math.min(tx[1], ty[1]);
+  if (tEntry > tExit || tEntry <= 0 || tEntry > 1) return null;
+  if (Math.abs(tx[0] - ty[0]) < 1e-9) return { t: tEntry, face: 'corner' };
