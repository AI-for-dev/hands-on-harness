+// Time window during which the point moving from p0 to p1 stays inside the
+// slab [min, max] on one axis, as a fraction of the step (Liang-Barsky), or
+// null if it never does. Returns [entry, exit].
+function slab(p0, p1, min, max) {
+  const v = p1 - p0;
+  if (Math.abs(v) < 1e-12) {
+    if (p0 < min || p0 > max) return null;
+    return [-Infinity, Infinity];
+  }
+  return [
+    Math.min((min - p0) / v, (max - p0) / v),
+    Math.max((min - p0) / v, (max - p0) / v),
+  ];
