+// ---------------------------------------------------------------------------
+// Brick & paddle collision defects (playtest to_fix.md, D1..D8)
+// ---------------------------------------------------------------------------
+// All of these were RED against the pre-fix code (probe, `ℹ fail 9`): the ball
+// plowed through bricks without ever bouncing, the paddle band let a 13px step
+// skip it, and the paddle bounce rewrote vx without renormalizing. Each case
+// also refuses its naive correction (single-axis flip, flip without
+// repositioning, per-brick double flip, band-only paddle test, norm-less or
+// dead-angle rebound).
+
+const DT = 1 / 60;
+
+// A brick at row 0: y 48..68. `col` 0 => x 4..76, col 3 => x 244..316.
+function rowZeroBrick(state, col) {
+  return state.bricks.find((b) => b.y === 48 && b.x === 4 + col * (72 + 8));
+}
+
+// D1 — the root defect: a brick hit must bounce the ball back up.
+test('D1: ball bouncing off a brick top flips vy and stays above the brick', () => {
+  const state = createState(1);
+  const brick = rowZeroBrick(state, 0);
+  state.ball = { x: 40, y: 38, r: BALL_R, vx: 0, vy: ballSpeed(1) };
+  const lost = step(state, DT);
+  assert.equal(lost, false);
+  assert.equal(brick.alive, false);
+  assert.ok(state.ball.vy < 0, 'ball must bounce up off the brick');
+  assert.ok(
+    state.ball.y + state.ball.r <= brick.y,
+    'ball must end above the brick, not below it'
+  );
+});
+
+// D2 — tunneling: at level 6 the max step (35.5px) is longer than the brick
+// crossing distance (BRICK_H + 2*BALL_R = 34px); an end-position-only AABB
+// test misses the brick entirely.
+test('D2: at level 6 the max step cannot tunnel through a brick (swept)', () => {
+  const state = createState(6);
+  const brick = rowZeroBrick(state, 0);
+  state.ball = {
+    x: 40,
+    y: brick.y - BALL_R - 0.5,
+    r: BALL_R,
+    vx: 0,
+    vy: ballSpeed(6),
+  };
+  const lost = step(state, 0.05);
+  assert.equal(lost, false);
+  assert.ok(state.ball.vy < 0, 'ball must not cross the brick in one 35.5px step');
+  assert.ok(state.ball.y + state.ball.r <= brick.y, 'ball must end above the brick');
+});
+
+// D3 — sticky: flipping the velocity without repositioning leaves the ball
+// inside the brick, so it re-collides next frame.
+test('D3: a ball deep inside a brick is pushed out, not left overlapping', () => {
+  const state = createState(1);
+  const brick = rowZeroBrick(state, 0);
+  state.ball = { x: 40, y: brick.y + 8, r: BALL_R, vx: 0, vy: ballSpeed(1) };
+  step(state, DT);
+  assert.ok(state.ball.vy < 0, 'ball must bounce up');
+  assert.equal(collides(state.ball, brick), false, 'ball must not remain inside the brick');
+});
+
+// D4a — face vs corner: a side hit flips the horizontal axis only.
+test('D4a: a side hit flips vx only, not vy', () => {
+  const state = createState(1);
+  const brick = rowZeroBrick(state, 3);
+  state.ball = { x: 230, y: 58, r: BALL_R, vx: 260, vy: 0 };
+  step(state, 0.05);
+  assert.ok(state.ball.vx < 0, 'horizontal velocity must flip on a side hit');
+  assert.equal(state.ball.vy, 0, 'vertical velocity must be untouched');
+  assert.ok(state.ball.x + state.ball.r <= brick.x, 'ball must end left of the brick');
+  assert.equal(brick.alive, false);
+});
+
+// D4b — face vs corner: equal penetrations on both axes mean a corner and
+// flip BOTH velocities.
+test('D4b: equal penetration on both axes (corner) flips both velocities', () => {
+  const state = createState(1);
+  const brick = rowZeroBrick(state, 3);
+  // Ends at (245, 49): 1px inside the brick on both axes -> penetrations (8, 8).
+  state.ball = { x: 245 - 130 * DT, y: 49 - 260 * DT, r: BALL_R, vx: 130, vy: 260 };
+  step(state, DT);
+  assert.ok(state.ball.vx < 0, 'corner hit must flip vx');
+  assert.ok(state.ball.vy < 0, 'corner hit must flip vy');
+  assert.equal(collides(state.ball, brick), false);
+});
+
+// D5 — ghost collision on a grid seam: BRICK_GAP (8px) is smaller than the
+// ball diameter (14px), so the ball can straddle two bricks; only ONE bounce
+// per pass is allowed (two flips would cancel out).
+test('D5: a ball straddling a brick seam bounces once, not twice', () => {
+  const state = createState(1);
+  const brickA = rowZeroBrick(state, 2);
+  const brickB = rowZeroBrick(state, 3);
+  state.ball = { x: 240, y: 38, r: BALL_R, vx: 0, vy: ballSpeed(1) };
+  step(state, DT);
+  assert.ok(state.ball.vy < 0, 'one bounce per pass: vy must be flipped exactly once');
+  assert.ok(state.ball.y + state.ball.r <= brickA.y, 'must not pass below the seam');
+  assert.equal(collides(state.ball, brickA), false);
+  assert.equal(collides(state.ball, brickB), false);
+});
+
+// D6 — paddle: a step longer than the 12px band (13px at level 1, dt = 0.05)
+// must still bounce; the test is a crossing of the paddle top plane.
+test('D6: a fast ball cannot skip the paddle band (crossing test)', () => {
+  const state = createState(1);
+  state.ball = { x: 320, y: PADDLE_Y - BALL_R - 0.5, r: BALL_R, vx: 0, vy: ballSpeed(1) };
+  step(state, 0.05);
+  assert.ok(state.ball.vy < 0, 'must bounce up off the paddle');
+  assert.ok(state.ball.y + state.ball.r <= PADDLE_Y, 'must end above the paddle');
+});
+
+// D7 — speed: the paddle bounce rewrote vx without renormalizing, so the
+// post-bounce norm drifted (271.45 instead of 260 at hit = 0.5). The rebound
+// must keep the level speed AND the hit-based angle.
+test('D7: paddle bounce keeps the level speed (norm conserved)', () => {
+  const state = createState(1);
+  state.ball = { x: 344, y: PADDLE_Y - BALL_R - 1, r: BALL_R, vx: 0, vy: ballSpeed(1) };
+  step(state, DT);
+  assert.ok(state.ball.vy < 0, 'bounces up');
+  const speed = Math.hypot(state.ball.vx, state.ball.vy);
+  assert.ok(
+    Math.abs(speed - ballSpeed(1)) < 1e-9,
+    `speed must equal the level speed (260), got ${speed}`
+  );
+  // hit = (344 - 320) / 48 = 0.5 -> the rebound angle keeps |vx|/|vy| = 0.6 * 0.5.
+  assert.ok(Math.abs(Math.abs(state.ball.vx / state.ball.vy) - 0.6 * 0.5) < 1e-9);
+});
+
+// D8 — dead angle: a hit at the exact paddle center gave vx = 0 (vertical,
+// unplayable trajectory). A center hit must still gain a horizontal component.
+test('D8: a dead-center paddle hit still gives the ball a horizontal component', () => {
+  const state = createState(1);
+  state.ball = { x: 320, y: PADDLE_Y - BALL_R - 1, r: BALL_R, vx: 0, vy: ballSpeed(1) };
+  step(state, DT);
+  assert.ok(state.ball.vy < 0, 'bounces up');
+  assert.notEqual(state.ball.vx, 0, 'vx must not be zero after a center hit');
+});
