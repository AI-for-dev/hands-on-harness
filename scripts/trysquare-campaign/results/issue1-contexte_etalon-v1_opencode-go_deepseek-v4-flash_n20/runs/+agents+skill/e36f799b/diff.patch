+    const penLeft = ball.x + ball.r - b.x;
+    const penRight = b.x + b.w - (ball.x - ball.r);
+    const penTop = ball.y + ball.r - b.y;
+    const penBottom = b.y + b.h - (ball.y - ball.r);
+    const dx = Math.min(penLeft, penRight);
+    const dy = Math.min(penTop, penBottom);
+    const fromLeft = penLeft < penRight;
+    const fromTop = penTop < penBottom;
+    const wasAbove = prevY + ball.r <= b.y;
+    const wasBelow = prevY - ball.r >= b.y + b.h;
+    const wasLeft = prevX + ball.r <= b.x;
+    const wasRight = prevX - ball.r >= b.x + b.w;
+
+    // Corner: the ball came from two adjacent sides and the penetrations are
+    // equal — both axes flip and the ball is pushed out along both.
+    const corner =
+      ((wasAbove && wasLeft) || (wasAbove && wasRight) ||
+       (wasBelow && wasLeft) || (wasBelow && wasRight)) &&
+      dx === dy;
+
+    if (corner) {
+      actions.push({
+        x: fromLeft ? b.x - ball.r : b.x + b.w + ball.r,
