+// --- Brick collision (pure, tested) ----------------------------------------

-// Main render loop. For each live brick we test collision AND draw in the same
-// pass: this is where logic and rendering are entangled.
+// Resolves the ball against every live brick it overlaps. Destroys each
+// touched brick (counted once via `alive`), awards score/combo, then applies
+// a bounce: the crossed face is read from the previous position (which side
+// the ball was on before the step), and the ball is pushed back out so it
+// only touches the brick (never overlaps it). Equal penetrations on two
+// adjacent sides mean a corner hit: both components flip.
+// Returns `true` if at least one brick was hit.
+//
+// `prevX`/`prevY` (position BEFORE the movement step) make the detection
+// swept-style: a ball that was entirely above the brick before the step
+// crossed the top face, even if the final overlap is deep.
+export function resolveBricks(state, prevX = state.ball.x, prevY = state.ball.y) {
+  const { ball } = state;
+  const hits = state.bricks.filter((b) => b.alive && collides(ball, b));
+  if (hits.length === 0) return false;
+
+  for (const brick of hits) {
+    brick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(brick, state.combo);
+  }
+
+  // One bounce per axis for the whole pass. Decisions are computed against
+  // the ORIGINAL overlap and applied afterwards, so resolving one brick can
+  // never disturb the face test of the next one (two adjacent bricks are
+  // often touched at once across an 8 px grid seam).
+  const actions = [];
