+// --- Brick collision (defect D1: the ball never bounced off bricks) --------
+
+test('D1: ball hitting the bottom face of a brick bounces back down', () => {
+  const state = createState(1);
+  const brick = brickAt(state, 4, 84); // row 4 (bottom): y 160..180, x 84..156
+  state.ball = { x: 100, y: 188, r: BALL_R, vx: 0, vy: -ballSpeed(1) };
+  step(state, 1 / 60);
+  assert.equal(brick.alive, false, 'the brick must be destroyed');
+  assert.ok(state.ball.vy > 0, 'vy flips: the ball bounces down off the brick');
+  assert.equal(collides(state.ball, brick), false, 'the ball leaves the brick');
+});
+
+test('D2: an overlapping ball is separated from the brick, no re-flip', () => {
+  const state = createState(1);
+  const brick = brickAt(state, 4, 4); // x 4..76, y 160..180
+  state.ball = { x: 40, y: 178, r: BALL_R, vx: 0, vy: -ballSpeed(1) }; // deep inside, exiting upward
+  step(state, 1 / 60);
+  assert.equal(collides(state.ball, brick), false, 'the ball is pushed out of the brick');
+  assert.ok(state.ball.vy < 0, 'exiting velocity is not flipped');
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy < 0, 'second step: no re-flip, the ball does not vibrate');
