+  state.ball = { x: 80, y: BRICK_TOP - BALL_R, r: BALL_R, vx: 0, vy: ballSpeed(1) }; // on the seam, above row 0
+  step(state, 1 / 60);
+  assert.equal(a.alive, false, 'left brick destroyed');
