+// segment at which the ball first touches the inflated box: a t > 0 means the
+// discrete check at the end position would have MISSED the collision
+// (tunneling); a t = 0 means the ball already overlaps it.
+function sweptHit(ball, rect) {
+  const left = rect.x - ball.r;
+  const right = rect.x + rect.w + ball.r;
+  const top = rect.y - ball.r;
+  const bottom = rect.y + rect.h + ball.r;
+  const x0 = ball.px ?? ball.x;
+  const y0 = ball.py ?? ball.y;
+  const x1 = ball.x;
+  const y1 = ball.y;
+  const dx = x1 - x0;
+  const dy = y1 - y0;
