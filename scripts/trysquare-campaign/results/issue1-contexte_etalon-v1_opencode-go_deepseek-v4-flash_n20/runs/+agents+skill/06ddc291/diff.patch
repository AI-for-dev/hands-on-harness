+// Which axis of `rect` the ball overlaps, by smallest penetration. Equal
+// penetration on both axes means we are exactly on a corner: both velocities
+// flip (face-vs-corner rule). Returns 'x', 'y' or 'both'.
+function penetrationAxis(ball, rect) {
