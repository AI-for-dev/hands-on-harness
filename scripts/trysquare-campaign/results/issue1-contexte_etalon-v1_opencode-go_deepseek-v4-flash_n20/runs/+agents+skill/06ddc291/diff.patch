+    return inside ? { t: 0, axis: penetrationAxis(ball, rect) } : null;
+  }
+
+  // Liang-Barsky slab test: per-axis entry/exit times into the inflated box.
+  let tmin = 0;
+  let tmax = 1;
+  let entryAxis = null;
+  if (dx === 0) {
+    if (x0 < left || x0 > right) return null;
+  } else {
+    let t1 = (left - x0) / dx;
+    let t2 = (right - x0) / dx;
+    if (t1 > t2) [t1, t2] = [t2, t1];
+    if (t1 > tmin) { tmin = t1; entryAxis = 'x'; }
+    if (t2 < tmax) tmax = t2;
+  }
