@@ -0,0 +1,95 @@
+// Simulates the naive corrections to prove the probe tests refuse them.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createState, collides, ballSpeed } from '../game/neon.js';
+
+const brick = (s, r, c) => s.bricks[r * 8 + c];
+
+// Naive A: flip vy on any collision (no axis choice, no push-out, discrete).
+// Naive B: flip + push per colliding brick (no one-flip-per-axis dedupe).
+function naiveStep(state, dt, variant) {
+  const b = state.ball;
+  b.x += b.vx * dt;
+  b.y += b.vy * dt;
+  for (const br of state.bricks) {
+    if (!br.alive) continue;
+    if (collides(b, br)) {
+      br.alive = false;
+      if (variant === 'A') {
+        b.vy = -b.vy;
+      } else {
+        b.vy = -b.vy;
+        if (b.vy < 0) b.y = br.y - b.r; else b.y = br.y + br.h + b.r;
+      }
+    }
+  }
+}
+
+test('NAIVE-A refused by D2a', () => {
+  const s = createState(1);
+  s.ball = { x: 78, y: 60, r: 7, vx: 100, vy: 0 };
+  naiveStep(s, 1 / 60, 'A');
+  assert.ok(s.ball.vx < 0, 'D2a must stay red on naive A (flip vy only)');
+});
+
+test('NAIVE-B refused by D2a', () => {
+  const s = createState(1);
+  s.ball = { x: 78, y: 60, r: 7, vx: 100, vy: 0 };
+  naiveStep(s, 1 / 60, 'B');
+  assert.ok(s.ball.vx < 0, 'D2a must stay red on naive B (flip+push per brick)');
+});
+
+test('NAIVE-A refused by D2b', () => {
+  const s = createState(1);
+  s.ball = { x: 40, y: 74, r: 7, vx: 60, vy: -260 };
+  naiveStep(s, 1 / 60, 'A');
+  assert.ok(s.ball.vy > 0, 'D2b must stay red on naive A (two vy flips cancel)');
+});
+
+test('NAIVE-B refused by D2b', () => {
+  const s = createState(1);
+  s.ball = { x: 40, y: 74, r: 7, vx: 60, vy: -260 };
+  naiveStep(s, 1 / 60, 'B');
+  assert.ok(s.ball.vy > 0, 'D2b must stay red on naive B (flip+push per brick)');
+});
+
+test('NAIVE-A refused by D3', () => {
+  const s = createState(1);
+  s.ball = { x: 40, y: 170, r: 7, vx: 0, vy: -260 };
+  naiveStep(s, 1 / 60, 'A');
+  assert.equal(collides(s.ball, brick(s, 4, 0)), false, 'D3 must stay red on naive A (no push-out)');
+});
+
+test('NAIVE-A refused by D4a', () => {
+  const s = createState(1);
+  brick(s, 0, 0).alive = false;
+  s.ball = { x: 80, y: 58, r: 7, vx: 260, vy: 100 };
+  naiveStep(s, 1 / 60, 'A');
+  assert.ok(s.ball.vx < 0, 'D4a must stay red on naive A (flips vy, not vx)');
+});
+
+// D5 discrete final-position check (no sweep): misses the crossing entirely.
+test('DISCRETE refused by D5', () => {
+  const s = createState(6);
+  s.ball = { x: 40, y: 187.5, r: 7, vx: 0, vy: -ballSpeed(6) };
+  s.ball.x += 0; s.ball.y += s.ball.vy * 0.05; // final spot only: y = 152
+  for (const br of s.bricks) {
+    if (br.alive && collides(s.ball, br)) { // resolves against row3, not row4
+      br.alive = false;
+      s.ball.vy = -s.ball.vy;
+    }
+  }
+  assert.equal(brick(s, 4, 0).alive, false,
+    'D5 must stay red on discrete: the crossed brick (row4) is skipped');
+  assert.equal(brick(s, 3, 0).alive, true,
+    'D5 must stay red on discrete: the wrong brick (row3) is broken');
+});
+
+// D6a2: widened band [paddle.y - r, paddle.y + h + r] still lets the ball through.
+test('WIDENED-BAND refused by D6a2', () => {
+  const s = createState(6);
+  s.ball = { x: 320, y: 435, r: 7, vx: 0, vy: ballSpeed(6) };
+  s.ball.y += s.ball.vy * 0.05; // final y = 470.5, box below the paddle
+  const inBand = s.ball.y + s.ball.r >= 448 - 7 && s.ball.y + s.ball.r <= 460 + 7;
+  assert.ok(inBand, 'D6a2 must stay red on a widened band test');
+});
diff --git a/.scratch/probe.test.js b/.scratch/probe.test.js
