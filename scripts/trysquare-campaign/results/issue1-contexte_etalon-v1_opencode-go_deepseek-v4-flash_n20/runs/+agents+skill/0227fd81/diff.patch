+// --- Brick bounce defects (see .scratch/to_fix.md) -------------------------
+
+// D1: the ball never bounces off bricks (it plows straight through).
+test('D1a: ball rising into a brick bottom face bounces back down', () => {
+  const state = createState(1);
+  state.ball = { x: 40, y: 187.5, r: 7, vx: 0, vy: -260 };
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy > 0, `vy should be DOWN (+260), got ${state.ball.vy}`);
+  assert.equal(brick(state, 4, 0).alive, false, 'brick must be destroyed');
+});
+
+test('D1b: ball falling onto a brick top face bounces back up', () => {
+  const state = createState(1);
+  state.ball = { x: 40, y: 45, r: 7, vx: 0, vy: +260 };
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy < 0, `vy should be UP (-260), got ${state.ball.vy}`);
+});
+
+// D2: a ball straddling a grid seam overlaps two bricks at once; two flips
+// cancel out and the ball sails through. One bounce per pass per axis.
+test('D2a: crossing the x-seam of a row sideways flips vx exactly once', () => {
+  const state = createState(1);
