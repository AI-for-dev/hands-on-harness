+++ b/.scratch/probe.test.js
@@ -0,0 +1,109 @@
+// Probe — temporary red tests (to be removed). Spec for .scratch/to_fix.md.
+// Geometry: brick rows y=48+28r (row0:48..68 ... row4:160..180), cols x=4+80k.
+// Index in makeBricks(1): row-major, idx = row*8+col.
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createState, collides, step, ballSpeed } from '../game/neon.js';
+
+const brick = (state, row, col) => state.bricks[row * 8 + col];
+
+// --- D1: no bounce at all (root defect) ------------------------------------
+test('D1a: ball bouncing up off a brick bottom face flips vy down', () => {
+  const state = createState(1);
+  state.ball = { x: 40, y: 187.5, r: 7, vx: 0, vy: -260 };
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy > 0, `vy should be DOWN (+260), got ${state.ball.vy}`);
+  assert.equal(brick(state, 4, 0).alive, false, 'brick must be destroyed');
+});
+
+test('D1b: ball falling onto a brick top face flips vy up', () => {
+  const state = createState(1);
+  state.ball = { x: 40, y: 45, r: 7, vx: 0, vy: +260 };
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy < 0, `vy should be UP (-260), got ${state.ball.vy}`);
+});
+
+// --- D2: seam double inversion ---------------------------------------------
+test('D2a: crossing the x-seam of a row sideways flips vx exactly once', () => {
+  const state = createState(1);
+  state.ball = { x: 78, y: 60, r: 7, vx: 100, vy: 0 }; // straddles col0|col1 of row0
+  step(state, 1 / 60);
+  assert.ok(state.ball.vx < 0, `one flip expected: vx<0, got ${state.ball.vx}`);
+  assert.equal(brick(state, 0, 0).alive, false, 'col0 of row0 broken');
+  assert.equal(brick(state, 0, 1).alive, false, 'col1 of row0 broken');
+});
+
+test('D2b: rising through the row seam flips vy exactly once', () => {
+  const state = createState(1);
+  state.ball = { x: 40, y: 74, r: 7, vx: 60, vy: -260 }; // ends inside the y-gap row0|row1
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy > 0, `one flip expected: vy>0, got ${state.ball.vy}`);
+  assert.equal(brick(state, 0, 0).alive, false, 'row0 brick broken');
+  assert.equal(brick(state, 1, 0).alive, false, 'row1 brick broken');
+});
+
+// --- D3: sticky (overlap not resolved) -------------------------------------
+test('D3: after the bounce the ball is pushed out of the brick', () => {
+  const state = createState(1);
+  state.ball = { x: 40, y: 170, r: 7, vx: 0, vy: -260 }; // deep inside row4-col0
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy > 0, `vy should be DOWN, got ${state.ball.vy}`);
+  assert.equal(collides(state.ball, brick(state, 4, 0)), false,
+    `ball must be out of the brick, y=${state.ball.y}`);
+});
+
+// --- D4: face vs corner ----------------------------------------------------
+test('D4a: side hit flips vx only (col0 already broken)', () => {
+  const state = createState(1);
+  brick(state, 0, 0).alive = false;
+  state.ball = { x: 80, y: 58, r: 7, vx: 260, vy: 100 }; // enters col1 left face
+  step(state, 1 / 60);
+  assert.ok(state.ball.vx < 0, `vx should flip LEFT, got ${state.ball.vx}`);
+  assert.ok(state.ball.vy > 0, `vy must stay DOWN, got ${state.ball.vy}`);
+  assert.equal(state.ball.x, 84 - 7, 'pushed out of the left face');
+});
+
+test('D4b: equal penetrations on a corner flip BOTH components', () => {
+  const state = createState(1);
+  // ball center exactly on the bottom-right corner of col2 (164..236 x 48..68):
+  // overlaps 7px on each axis.
+  state.ball = { x: 236, y: 68, r: 7, vx: -100, vy: -100 };
+  step(state, 0);
+  assert.ok(state.ball.vx > 0, `vx should flip RIGHT, got ${state.ball.vx}`);
+  assert.ok(state.ball.vy > 0, `vy should flip DOWN, got ${state.ball.vy}`);
+});
+
+// --- D5: tunneling ----------------------------------------------------------
+test('D5: at level 6 a 50ms step cannot skip a brick (swept)', () => {
+  const state = createState(6);
+  state.ball = { x: 40, y: 187.5, r: 7, vx: 0, vy: -ballSpeed(6) };
+  step(state, 0.05); // step = 710*0.05 = 35.5 > BRICK_H + 2r = 34
+  assert.ok(state.ball.vy > 0, `ball must bounce, vy=${state.ball.vy}`);
+  assert.equal(brick(state, 4, 0).alive, false, 'the crossed brick breaks');
+  assert.equal(brick(state, 3, 0).alive, true, 'the brick beyond the bounce stays intact');
+});
+
+// --- D6: paddle pass-through ------------------------------------------------
+test('D6a: paddle band (12px) skipped on a 50ms frame at level 1', () => {
+  const state = createState(1);
+  state.ball = { x: 320, y: 440.995, r: 7, vx: 0, vy: 260 };
+  step(state, 0.05); // step 13 > paddle.h 12: bottom edge jumps over [448, 460]
+  assert.ok(state.ball.vy < 0, `paddle must bounce, vy=${state.ball.vy}`);
+  assert.equal(state.ball.y, 448 - 7, 'ball repositioned on the paddle top');
+});
+
+test('D6a2: paddle fully tunnelled at level 6 on a 50ms frame (swept)', () => {
+  const state = createState(6);
+  state.ball = { x: 320, y: 435, r: 7, vx: 0, vy: ballSpeed(6) };
+  step(state, 0.05); // step 35.5 > paddle.h + 2r = 26
+  assert.ok(state.ball.vy < 0, `paddle must bounce, vy=${state.ball.vy}`);
+});
+
+test('D6b: ball clipping the paddle corner with center outside its x-range', () => {
+  const state = createState(1);
+  state.ball = { x: 268, y: 451, r: 7, vx: -30, vy: 260 }; // overlaps paddle top-left corner
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy < 0, `paddle must bounce, vy=${state.ball.vy}`);
+  assert.equal(state.ball.y, 448 - 7, 'ball repositioned on the paddle top');
+});
