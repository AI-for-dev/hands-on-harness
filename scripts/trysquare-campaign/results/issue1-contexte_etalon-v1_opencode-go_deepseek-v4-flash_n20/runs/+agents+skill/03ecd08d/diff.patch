+// Detection is a SWEPT test: the segment [prev, ball] is swept against every
+// brick grown by the ball radius (slab method). A ball that crosses a whole
+// brick within one step (per-step travel > BRICK_H + 2×BALL_R, reachable from
+// level 6 at the 50 ms dt cap) still registers a hit at its entry face. This
+// is also what keeps the result independent of dt.
+//
+// Hits are resolved in order of increasing entry time (first contact wins),
+// with at most ONE flip per axis per pass: two same-row bricks overlapped
+// through the 8 px grid seam would otherwise each flip vy and cancel out.
+function resolveBricks(state, prevX, prevY, dt) {
+  const { ball, bricks } = state;
+  let remaining = dt;
+  let flippedX = false;
+  let flippedY = false;
+  let guard = 0;
+
+  while (remaining > 0 && guard++ < 8) {
+    const dx = ball.vx * remaining;
+    const dy = ball.vy * remaining;
+    let best = null;
+
+    for (const brick of bricks) {
+      if (!brick.alive) continue;
+      const hit = sweptHit(prevX, prevY, dx, dy, brick);
+      if (hit && (best === null || hit.t < best.t)) best = hit;
+    }
+    if (!best) break;
+
+    const hitTime = best.t * remaining;
+    ball.x = best.x;
+    ball.y = best.y;
+    if (best.flipX && !flippedX) {
+      ball.vx = -ball.vx;
+      flippedX = true;
+    }
+    if (best.flipY && !flippedY) {
+      ball.vy = -ball.vy;
+      flippedY = true;
+    }
