+  const state = createState(1);
+  const brick = state.bricks.find((b) => b.row === 4 && b.x === 244);
+  assert.ok(brick, 'row 4, col 3 brick exists');
+  state.ball = { x: 280, y: 195, r: BALL_R, vx: 0, vy: -ballSpeed(1) };
