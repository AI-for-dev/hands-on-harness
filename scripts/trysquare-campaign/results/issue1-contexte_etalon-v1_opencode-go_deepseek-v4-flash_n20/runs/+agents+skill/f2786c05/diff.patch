+// Returns the face of `brick` the ball hit: 'top', 'bottom', 'left', 'right',
+// or 'corner' when the entry is ambiguous and BOTH axes must flip.
+// `prevX`/`prevY` is the ball centre at the START of the current substep: the
+// face is the side the ball was on before it entered the brick. Only when the
+// ball was already overlapping before the substep (recovery) do we fall back
+// on the dominant velocity axis.
+function hitFace(prevX, prevY, ball, brick) {
+  const top = prevY - ball.r;
+  const bottom = prevY + ball.r;
+  const left = prevX - ball.r;
+  const right = prevX + ball.r;
+  const fromAbove = bottom <= brick.y; // was above, moving down
+  const fromBelow = top >= brick.y + brick.h; // was below, moving up
+  const fromLeft = right <= brick.x; // was left, moving right
+  const fromRight = left >= brick.x + brick.w; // was right, moving left
+  const outside = fromAbove + fromBelow + fromLeft + fromRight;
+  if (outside >= 2) {
+    // Corner entry: the face is the axis of the smallest penetration; equal
+    // penetrations mean we are exactly on a corner, and both axes flip.
+    const penX = Math.min(ball.x + ball.r, brick.x + brick.w) - Math.max(ball.x - ball.r, brick.x);
+    const penY = Math.min(ball.y + ball.r, brick.y + brick.h) - Math.max(ball.y - ball.r, brick.y);
+    if (penX === penY) return 'corner';
+    return penX < penY ? (fromLeft ? 'left' : 'right') : (fromAbove ? 'top' : 'bottom');
+  }
+  if (fromAbove) return 'top';
+  if (fromBelow) return 'bottom';
+  if (fromLeft) return 'left';
+  if (fromRight) return 'right';
+  // Recovery: already overlapping before the move; resolve along the dominant
+  // velocity axis, i.e. push the ball back out the way it came.
+  if (Math.abs(ball.vx) > Math.abs(ball.vy)) return ball.vx > 0 ? 'left' : 'right';
+  return ball.vy > 0 ? 'top' : 'bottom';
