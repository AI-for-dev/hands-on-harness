+    tNearX = -Infinity;
+    tFarX = Infinity;
+  } else {
+    const t1 = (box.x - px) / dx;
+    const t2 = (box.x + box.w - px) / dx;
+    tNearX = Math.min(t1, t2);
+    tFarX = Math.max(t1, t2);
