+// --- Brick collision (swept, pure) ----------------------------------------
+
+// Numerical tolerance for face/corner comparisons: a difference below it
+// counts as "equal" for floating-point purposes.
+const EPS = 1e-9;
+
+// Per-axis entry/exit times of the ball's box sweeping along `d` against the
+// brick's range [b0, b1]. Returns [entry, exit] — the times, in steps, during
+// which the two overlap on that axis (t = 0 is the frame start, t = 1 the
+// frame end) — or null when they never overlap (parallel and disjoint).
+function axisSweep(c0, r, d, b0, b1) {
+  if (d === 0) {
+    return c0 - r < b1 && c0 + r > b0 ? [-Infinity, Infinity] : null;
+  }
+  if (d > 0) {
+    return [(b0 - (c0 + r)) / d, (b1 - (c0 - r)) / d];
+  }
+  return [(b1 - (c0 - r)) / d, (b0 - (c0 + r)) / d];
+}
+
+// Swept test of the ball (a circle, box-approximated) against one brick over
+// the step that took it from `prev` to its current position. Continuous
+// detection: a fast ball can never jump over a brick without touching it.
+// Returns { t, axis } — the time of first contact in [0, 1] and the face hit
+// ('x' | 'y' | 'corner') — or null when the ball never touches the brick.
+export function sweptBrickHit(ball, prev, brick) {
+  const dx = ball.x - prev.x;
+  const dy = ball.y - prev.y;
+  const sx = axisSweep(prev.x, ball.r, dx, brick.x, brick.x + brick.w);
+  const sy = axisSweep(prev.y, ball.r, dy, brick.y, brick.y + brick.h);
+  if (!sx || !sy) return null;
+  const tFirst = Math.max(sx[0], sy[0]);
+  const tLast = Math.min(sx[1], sy[1]);
+  if (!(tFirst < tLast) || tLast < 0 || tFirst > 1) return null;
+  const t = Math.max(0, tFirst);
+  let axis;
+  if (t === 0) {
+    // Already overlapping at frame start: the smallest penetration decides
+    // the face; equal penetrations mean a corner (both axes flip).
+    const penX = Math.min(ball.x + ball.r - brick.x, brick.x + brick.w - (ball.x - ball.r));
+    const penY = Math.min(ball.y + ball.r - brick.y, brick.y + brick.h - (ball.y - ball.r));
+    axis = Math.abs(penX - penY) < EPS ? 'corner' : penX < penY ? 'x' : 'y';
+  } else {
+    // Crossing during the step: the axis entered last is the face hit.
+    axis = Math.abs(sx[0] - sy[0]) < EPS ? 'corner' : sx[0] > sy[0] ? 'x' : 'y';
+  }
+  return { t, axis };
+}
+
+// Bounces the ball off the brick it just hit: flips the hit axis (both on a
+// corner) and pushes the ball back out of the rectangle, edge against face.
+export function bounceOffBrick(ball, prev, brick, hit) {
+  // Contact point along the swept path: the side of the brick the ball came
+  // from is read there, not at the post-move position (a fast ball may have
+  // crossed the brick entirely by the end of the step).
+  const contact =
+    hit.t > 0
+      ? {
+          x: prev.x + (ball.x - prev.x) * hit.t,
+          y: prev.y + (ball.y - prev.y) * hit.t,
+        }
