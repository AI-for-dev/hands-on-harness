+// Continuous (swept) contact test. Does the segment travelled by the ball
+// center, from (ax, ay) to (bx, by), cross the brick inflated by the ball
+// radius? Returns the time of first contact t in [0, 1] (0 means the ball
+// already overlaps at the start), or null. Slab method; a discrete sample at
+// either end misses a fast ball that crosses the brick mid-step (tunneling).
+function sweptContact(ax, ay, bx, by, brick, r) {
+  const minX = brick.x - r;
+  const maxX = brick.x + brick.w + r;
+  const minY = brick.y - r;
+  const maxY = brick.y + brick.h + r;
+  const dx = bx - ax;
+  const dy = by - ay;
+
+  let tNear = -Infinity;
+  let tFar = Infinity;
+
+  if (Math.abs(dx) < 1e-9) {
+    if (ax < minX || ax > maxX) return null;
+  } else {
+    let t1 = (minX - ax) / dx;
+    let t2 = (maxX - ax) / dx;
+    if (t1 > t2) { const tmp = t1; t1 = t2; t2 = tmp; }
+    tNear = Math.max(tNear, t1);
+    tFar = Math.min(tFar, t2);
+  }
