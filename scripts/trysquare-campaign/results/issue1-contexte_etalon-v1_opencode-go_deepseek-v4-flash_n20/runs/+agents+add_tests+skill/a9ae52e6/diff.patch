+// --- Brick collision (swept, pure logic) ----------------------------------
+
+// Tests the segment travelled by the ball during one step against a brick
+// dilated by the ball radius (slab method: the ball becomes a point and the
+// brick grows by BALL_R). Returns a hit descriptor, or null:
+//   { mode: 'overlap' }           ball already overlaps the brick
+//   { mode: 'approach', nx, ny }  segment enters the dilated box; the non-zero
+//                                 component is the outward normal of the face
+//                                 entered (-1 left/top, +1 right/bottom)
+// The face of the real brick that is hit is the dilated slab entered last;
+// on a corner both slabs are entered at the same time.
+function sweptBrickHit(ball, brick, x0, y0) {
+  const x1 = ball.x;
+  const y1 = ball.y;
+  const dx = x1 - x0;
+  const dy = y1 - y0;
+  const bx0 = brick.x - ball.r;
+  const bx1 = brick.x + brick.w + ball.r;
+  const by0 = brick.y - ball.r;
+  const by1 = brick.y + brick.h + ball.r;
+
+  let txIn = 0;
+  let txOut = 1;
+  let sx = 0;
+  if (Math.abs(dx) < 1e-12) {
+    if (x0 < bx0 || x0 > bx1) return null;
+  } else {
+    let t1 = (bx0 - x0) / dx;
+    let t2 = (bx1 - x0) / dx;
+    let s1 = -1;
+    let s2 = 1;
+    if (t1 > t2) {
+      [t1, t2] = [t2, t1];
+      [s1, s2] = [s2, s1];
+    }
+    txIn = t1;
+    txOut = t2;
+    sx = s1;
+  }
+
+  let tyIn = 0;
+  let tyOut = 1;
+  let sy = 0;
+  if (Math.abs(dy) < 1e-12) {
+    if (y0 < by0 || y0 > by1) return null;
+  } else {
+    let t1 = (by0 - y0) / dy;
+    let t2 = (by1 - y0) / dy;
+    let s1 = -1;
+    let s2 = 1;
