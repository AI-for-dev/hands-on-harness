-// --- Physics (movement + wall/paddle bounces) ------------------------------
+// --- Physics (movement + wall/paddle/brick bounces) ------------------------
+
+// Tolerance for comparing penetrations: two axes within EPS are a corner hit.
+const EPS = 1e-9;
+
+// First contact between the ball box (center (px,py) moving to (cx,cy),
+// half-size r) and the brick rectangle, as a time `t` in [0,1] along the move
+// plus the axis that was crossed first. Returns null when the swept volume
+// never intersects the brick.
+//
+// This is the slab / swept AABB test: the ball is swept along the whole
+// segment it travelled during the step, so a step longer than the obstacle
+// can no longer jump over it (at the dt cap, level 6 moves 35.5 px against a
+// 34 px brick + ball diameter).
+function sweptContact(px, py, cx, cy, r, brick) {
+  const dx = cx - px;
+  const dy = cy - py;
+
+  // Interval of t where the moving box overlaps the brick on each axis.
+  let tx0 = -Infinity;
+  let tx1 = Infinity;
+  if (dx === 0) {
+    if (px + r <= brick.x || px - r >= brick.x + brick.w) return null;
+  } else {
+    let a = (brick.x - (px + r)) / dx;
+    let b = (brick.x + brick.w - (px - r)) / dx;
+    if (a > b) [a, b] = [b, a];
+    tx0 = a;
+    tx1 = b;
+  }
+
+  let ty0 = -Infinity;
+  let ty1 = Infinity;
+  if (dy === 0) {
+    if (py + r <= brick.y || py - r >= brick.y + brick.h) return null;
+  } else {
+    let a = (brick.y - (py + r)) / dy;
+    let b = (brick.y + brick.h - (py - r)) / dy;
+    if (a > b) [a, b] = [b, a];
+    ty0 = a;
+    ty1 = b;
+  }
+
+  const tEnter = Math.max(tx0, ty0);
+  const tExit = Math.min(tx1, ty1);
+  if (tEnter > tExit || tEnter > 1 || tExit < 0) return null;
+
+  // The face crossed is the axis whose slab was entered last. Both at once is
+  // a corner: reflect both velocity components.
+  let axis;
+  if (Math.abs(tx0 - ty0) < EPS) axis = 'both';
+  else if (tx0 > ty0) axis = 'x';
+  else axis = 'y';
+
+  return { t: Math.max(0, tEnter), axis };
+}
+
+// Pushes the ball out of the brick and reflects the velocity on the hit axis.
+//
+// Two situations. The ball ENTERED the brick during the step (`hit.t > 0`, the
+// tunneling case): it is put back at the exact point of first contact and the
+// axis it crossed is reflected. Or it was already overlapping at the start of
+// the step (`hit.t === 0`): it is pushed out along the face of MINIMAL
+// penetration — the face it actually hit. Equal penetrations on both axes mean
+// a corner hit and reflect BOTH components.
+//
+// The push-out is the second half of the bounce: flipping the velocity without
+// repositioning leaves the ball overlapping, and the next step re-inverts it —
+// a sticky, vibrating ball.
+function resolveBounce(brick, ball, hit, px, py) {
+  const r = ball.r;
+
+  if (hit.t > 0) {
+    ball.x = px + hit.t * (ball.x - px);
+    ball.y = py + hit.t * (ball.y - py);
+    if (hit.axis === 'both') {
+      ball.vx = -ball.vx;
+      ball.vy = -ball.vy;
+    } else if (hit.axis === 'x') {
+      ball.vx = -ball.vx;
+    } else {
+      ball.vy = -ball.vy;
+    }
+    return;
+  }
+
+  // Already overlapping at the start of the step. If the ball is leaving the
+  // brick (it only touched it at the exact boundary), there is nothing to
+  // resolve: the brick was already broken above.
+  if (!collides(ball, brick)) return;
