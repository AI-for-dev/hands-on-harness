+// capped 50 ms frame: at level 6 the capped step (35.5 px) jumps over the
+// brick (34 px) that the 60 fps step (11.8 px) still lands inside.
+test('D10: same trajectory, same collision at 60 fps and at the dt cap', () => {
+  const mk = () => {
+    const state = createState(6);
+    state.bricks = [{ x: 100, y: 100, w: 72, h: 20, row: 0, alive: true, points: 10 }];
+    state.ball = { x: 136, y: 128, r: BALL_R, vx: 0, vy: -ballSpeed(6) };
+    return state;
+  };
+
+  const at60 = mk();
+  step(at60, DT);
+  const atCap = mk();
+  step(atCap, DT_MAX);
+
+  assert.equal(at60.bricks[0].alive, atCap.bricks[0].alive, 'brick fate must not depend on dt');
+  assert.equal(Math.sign(at60.ball.vy), Math.sign(atCap.ball.vy), 'bounce must not depend on dt');
+  assert.ok(at60.ball.vy > 0, `must bounce up at 60 fps: ${at60.ball.vy}`);
+  assert.ok(atCap.ball.vy > 0, `must bounce up at the dt cap: ${atCap.ball.vy}`);
+});
