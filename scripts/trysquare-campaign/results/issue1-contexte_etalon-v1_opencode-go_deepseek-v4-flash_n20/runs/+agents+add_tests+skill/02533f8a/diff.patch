+// Resolves the ball against the live bricks for the movement from (prevX,
+// prevY) to the ball's current position. The EARLIEST contact along that
+// movement wins — one brick per pass, so a seam of the grid (BRICK_GAP = 8 <
+// ball diameter = 14) can never invert the same axis twice. The brick is
+// destroyed and scored, the ball bounces on the face it entered through (a
+// corner inverts both axes) and is pushed back out of the brick.
+function resolveBricks(state, prevX, prevY) {
+  const { ball } = state;
+  const vx = ball.x - prevX;
+  const vy = ball.y - prevY;
+
+  let best = null;
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+    const hit = sweptContact(ball, prevX, prevY, vx, vy, brick);
+    if (hit && (best === null || hit.t < best.t)) best = { brick, hit };
+  }
+  if (best === null) return;
+
+  const { brick, hit } = best;
+  brick.alive = false;
+  state.combo += 1;
+  state.score += scoreForBrick(brick, state.combo);
+
+  // Push the ball back to the face it entered through, then invert that
+  // axis. The entered face follows the sign of the velocity component: a
+  // positive vx means the ball came from the left, and so on.
+  if (hit.axis === 'x' || hit.axis === 'both') {
+    if (vx > 0) ball.x = brick.x - ball.r;
+    else if (vx < 0) ball.x = brick.x + brick.w + ball.r;
+  }
+  if (hit.axis === 'y' || hit.axis === 'both') {
+    if (vy > 0) ball.y = brick.y - ball.r;
+    else if (vy < 0) ball.y = brick.y + brick.h + ball.r;
+  }
+  if (hit.axis === 'x') ball.vx = -ball.vx;
+  else if (hit.axis === 'y') ball.vy = -ball.vy;
+  else {
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+  }
+}
