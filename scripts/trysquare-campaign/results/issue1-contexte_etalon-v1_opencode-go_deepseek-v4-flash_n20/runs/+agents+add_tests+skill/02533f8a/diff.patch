+// Swept segment test: does the ball's center, moving from (prevX, prevY) by
+// (vx, vy), touch the brick's AABB inflated by the ball radius? Standard slab
+// test (Gomez, "Swept AABB"): the movement is continuous, so a fast ball can
+// never jump over a brick (tunneling). Returns the entry time t in [0, 1] and
+// the entry axis ('x', 'y' or 'both' for a corner hit), or null.
+function sweptContact(ball, prevX, prevY, vx, vy, brick) {
+  const left = brick.x - ball.r;
+  const right = brick.x + brick.w + ball.r;
+  const top = brick.y - ball.r;
+  const bottom = brick.y + brick.h + ball.r;
+
+  // Entry time per axis; null = the center already sits inside the slab.
+  let tx = null;
+  let ty = null;
+  let tExit = 1;
+
+  if (vx === 0) {
+    if (prevX <= left || prevX >= right) return null;
+  } else {
+    let t1 = (left - prevX) / vx;
+    let t2 = (right - prevX) / vx;
+    if (t1 > t2) [t1, t2] = [t2, t1];
+    if (t1 > 1 || t2 < 0) return null;
+    tx = t1;
+    tExit = Math.min(tExit, t2);
+  }
+
+  if (vy === 0) {
+    if (prevY <= top || prevY >= bottom) return null;
+  } else {
+    let t1 = (top - prevY) / vy;
+    let t2 = (bottom - prevY) / vy;
+    if (t1 > t2) [t1, t2] = [t2, t1];
+    if (t1 > 1 || t2 < 0) return null;
+    ty = t1;
+    tExit = Math.min(tExit, t2);
+  }
+
+  const tEntry = Math.max(0, tx ?? 0, ty ?? 0);
+  if (tEntry > tExit) return null;
+
+  // The face is the axis with the latest entry time (the first face crossed);
+  // equal entry times mean the corner was hit: both axes invert.
+  let axis;
+  if (tx !== null && ty !== null) {
+    axis = Math.abs(tx - ty) <= 1e-9 ? 'both' : tx > ty ? 'x' : 'y';
+  } else {
+    axis = tx !== null ? 'x' : 'y';
+  }
+  return { t: tEntry, axis };
+}
