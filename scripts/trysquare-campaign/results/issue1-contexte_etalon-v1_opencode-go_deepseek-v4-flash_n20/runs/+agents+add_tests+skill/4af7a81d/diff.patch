+// Bounces the ball off the brick it overlaps and pushes it out so it only
+// touches the brick (a velocity flip without repositioning would re-trigger
+// the overlap next frame and re-flip: a sticky, vibrating ball).
+//
+// Hit face = axis of smallest penetration. Equal penetration on both axes is
+// a corner: both velocity components are flipped and the ball is pushed out
+// on both axes. The push direction follows the edge of the ball's box that
+// pokes outside the brick (robust even when the center overshot a face); if
+// the box is fully inside the brick (unreachable in play, the substeps in
+// step() cap the first penetration), the exit follows the direction of motion.
+// Returns true when a bounce was applied.
+export function bounceBall(ball, brick) {
+  const overlapX =
+    Math.min(ball.x + ball.r, brick.x + brick.w) - Math.max(ball.x - ball.r, brick.x);
+  const overlapY =
+    Math.min(ball.y + ball.r, brick.y + brick.h) - Math.max(ball.y - ball.r, brick.y);
+  if (overlapX <= 0 || overlapY <= 0) return false;
+
+  const pushX =
+    ball.x - ball.r < brick.x
+      ? brick.x - ball.r
+      : ball.x + ball.r > brick.x + brick.w
+        ? brick.x + brick.w + ball.r
+        : ball.vx < 0
+          ? brick.x - ball.r
+          : brick.x + brick.w + ball.r;
+  const pushY =
+    ball.y - ball.r < brick.y
+      ? brick.y - ball.r
+      : ball.y + ball.r > brick.y + brick.h
+        ? brick.y + brick.h + ball.r
+        : ball.vy < 0
+          ? brick.y - ball.r
+          : brick.y + brick.h + ball.r;
+
+  if (overlapX < overlapY) {
+    ball.x = pushX;
+    ball.vx = -ball.vx;
+  } else if (overlapY < overlapX) {
+    ball.y = pushY;
+    ball.vy = -ball.vy;
+  } else {
+    // Corner: equal penetration on both axes, both components flip.
+    ball.x = pushX;
+    ball.vx = -ball.vx;
+    ball.y = pushY;
+    ball.vy = -ball.vy;
+  }
+  return true;
+}
