+// --- Brick bounce (swept, per-face, single bounce) -------------------------
+
+// Entry times are expressed in frame fractions (0 = where the step started,
+// 1 = where it ended). Two faces entered within CORNER_EPS of each other mean
+// a diagonal hit: flip both components. Small on purpose — the seam cases
+// (1 px vs 3 px of penetration) must stay clear of the corner threshold.
+const CORNER_EPS = 0.1;
+
+// Time interval [near, far] during which the moving box [a0, a1] (displacing
+// by `da` over the frame) overlaps the static segment [b0, b1].
+// Returns null when the two never overlap.
+function overlapInterval(a0, a1, da, b0, b1) {
+  if (da === 0) {
+    return a1 > b0 && a0 < b1 ? [-Infinity, Infinity] : null;
+  }
+  const t1 = (b1 - a0) / da;
+  const t2 = (b0 - a1) / da;
+  return t1 <= t2 ? [t1, t2] : [t2, t1];
+}
+
+// Sweeps the ball's box along its movement segment (prev -> current) against
+// one brick. Returns null when the brick is not touched, otherwise the entry
+// time of each axis — the axis that entered most recently is the face hit.
+function sweepBall(ball, brick, prevX, prevY) {
+  const dx = ball.x - prevX;
+  const dy = ball.y - prevY;
+  const ix = overlapInterval(prevX - ball.r, prevX + ball.r, dx, brick.x, brick.x + brick.w);
+  if (!ix) return null;
+  const iy = overlapInterval(prevY - ball.r, prevY + ball.r, dy, brick.y, brick.y + brick.h);
+  if (!iy) return null;
+  const near = Math.max(ix[0], iy[0], 0);
+  const far = Math.min(ix[1], iy[1], 1);
+  if (near > far) return null;
+  return { tNearX: ix[0], tNearY: iy[0] };
+}
+
+// Resolves the ball against the first brick it touches along its path:
+// destroys the brick, scores, flips the velocity on the hit face (both axes
+// on a corner) and pushes the ball back OUTSIDE the brick rectangle, so it
+// cannot still overlap on the next frame (sticky bounce).
+//
+// The sweep looks at the whole path, not just the two endpoints: at level 6
+// a stuttered frame moves the ball 35.5 px against a 34 px brick, and the
+// discrete before/after check would tunnel straight through.
+//
+// At most ONE bounce per step: the grid gap is 8 px and the ball 14 px
+// across, so every seam overlaps two bricks in the same pass — a second
+// `vy = -vy` would cancel the first and the ball would go through.
+function resolveBrickCollision(state, prevX, prevY) {
