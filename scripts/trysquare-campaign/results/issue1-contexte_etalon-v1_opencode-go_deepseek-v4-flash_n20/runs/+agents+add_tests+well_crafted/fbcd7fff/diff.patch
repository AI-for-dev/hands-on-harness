+// --- Issue #1 regression tests: the brick bounce ----------------------------
+//
+// Each case starts with the ball already overlapping a brick and checks the
+// velocity after the same frame/step/frame sequence the game loop uses, so
+// the tests stay valid whichever function owns the resolution.
+
+const DT = 1 / 60;
+const DT_MAX = 0.05; // cap boot() applies to a stuttered frame
+const EPS = 1e-9;
+
+function brique(x = 100, y = 100, row = 0) {
+  return { x, y, w: BRICK_W, h: BRICK_H, row, alive: true, points: 10 };
+}
+
+function jouer(state, dt = DT) {
+  const { vx, vy } = state.ball;
+  const bouge = () => state.ball.vx !== vx || state.ball.vy !== vy;
+  frame(contexteFactice(), state);
+  if (bouge()) return;
+  step(state, dt);
+  if (bouge()) return;
+  frame(contexteFactice(), state);
+}
+
+function contexteFactice() {
+  const rien = () => {};
+  return new Proxy({}, {
+    get: (_, nom) => (nom === 'canvas' ? { width: WIDTH, height: 480 } : rien),
+    set: () => true,
+  });
+}
+
+test('issue#1: side hit flips vx and leaves vy alone', () => {
+  const state = createState(1);
+  state.bricks = [brique()];
+  state.ball = { x: 96, y: 110, r: BALL_R, vx: 300, vy: 30 };
+  jouer(state);
+  assert.ok(state.ball.vx < 0, `vx should flip: ${state.ball.vx}`);
+  assert.ok(state.ball.vy > 0, `vy should stay positive: ${state.ball.vy}`);
+  assert.ok(state.ball.x + BALL_R <= 100 + EPS, 'ball pushed out on the left');
+});
+
+test('issue#1: top/bottom hit flips vy and leaves vx alone', () => {
+  const state = createState(1);
+  state.bricks = [brique()];
+  state.ball = { x: 136, y: 96, r: BALL_R, vx: 30, vy: 300 };
+  jouer(state);
+  assert.ok(state.ball.vy < 0, `vy should flip: ${state.ball.vy}`);
+  assert.ok(state.ball.vx > 0, `vx should stay positive: ${state.ball.vx}`);
+  assert.ok(state.ball.y + BALL_R <= 100 + EPS, 'ball pushed out on top');
+});
+
+test('issue#1: corner hit (equal penetrations) flips both components', () => {
+  const state = createState(1);
+  state.bricks = [brique()];
+  state.ball = { x: 96, y: 96, r: BALL_R, vx: 300, vy: 300 };
+  jouer(state);
+  assert.ok(state.ball.vx < 0, `vx should flip: ${state.ball.vx}`);
+  assert.ok(state.ball.vy < 0, `vy should flip: ${state.ball.vy}`);
+});
+
+test('issue#1: seam over two bricks bounces exactly once', () => {
+  const state = createState(1);
+  state.bricks = [
+    brique(100, 100),
+    brique(100 + BRICK_W + 8, 100),
+  ];
+  state.ball = { x: 176, y: 126, r: BALL_R, vx: 6, vy: -60 };
+  jouer(state);
+  assert.ok(state.ball.vy > 0, `vy should flip once: ${state.ball.vy}`);
+  assert.ok(state.ball.vx > 0, `vx should stay positive: ${state.ball.vx}`);
+});
+
+test('issue#1: fast ball does not tunnel through a brick', () => {
+  const state = createState(6);
+  const b = brique();
+  state.bricks = [b];
+  // y 121..135 before the move, 85.5..99.5 after: the discrete before/after
+  // check never sees the overlap; only a sweep does.
+  state.ball = { x: 136, y: 128, r: BALL_R, vx: 0, vy: -ballSpeed(6) };
+  jouer(state, DT_MAX);
+  assert.equal(b.alive, false, 'the brick must be hit');
+  assert.ok(state.ball.vy > 0, `ball should bounce down: ${state.ball.vy}`);
+});
