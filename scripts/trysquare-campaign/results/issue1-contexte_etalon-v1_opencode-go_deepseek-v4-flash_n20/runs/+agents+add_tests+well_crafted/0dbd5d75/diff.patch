+// ---------------------------------------------------------------------------
+// Issue #1: brick bounce. A brick far from any neighbor, so the swept segment
+// of each fixture touches exactly it and nothing else.
+// ---------------------------------------------------------------------------
+
+const brickSeul = (x = 100, y = 100, row = 0) => ({
+  x,
+  y,
+  w: BRICK_W,
+  h: BRICK_H,
+  row,
+  alive: true,
+  points: 10,
+});
+
+// Face basse, en tête: vy s'inverse, vx ne bouge pas, la balle ressort sous la
+// brique (et ne recouvre plus rien au tour suivant).
+test('brickHit: head-on bottom face flips vy, keeps vx, pushes out', () => {
+  const brick = brickSeul();
+  const ball = { x: 136, y: 98, px: 136, py: 128, r: BALL_R, vx: 40, vy: -300 };
+
+  const destroyed = brickHit(ball, [brick]);
+
+  assert.deepEqual(destroyed, [brick]);
+  assert.equal(ball.vy, 300, 'vy doit s\'inverser');
+  assert.equal(ball.vx, 40, 'vx doit rester tel quel');
+  assert.equal(ball.y, 120 + BALL_R, 'la balle doit ressortir sous la brique');
+  assert.equal(collides(ball, brick), false, 'la balle ne doit plus recouvrir la brique');
+});
+
+// Flanc gauche: vx s'inverse, vy ne bouge pas, la balle ressort à gauche.
+test('brickHit: side hit flips vx, keeps vy, pushes out sideways', () => {
+  const brick = brickSeul();
+  // 3 px dans le flanc gauche (17 px sur l'axe vertical) : la face est sans
+  // ambiguïté la plus faible pénétration.
+  const ball = { x: 96, y: 110, px: 96, py: 110, r: BALL_R, vx: 300, vy: 30 };
+
+  const destroyed = brickHit(ball, [brick]);
+
+  assert.deepEqual(destroyed, [brick]);
+  assert.equal(ball.vx, -300, 'vx doit s\'inverser');
+  assert.equal(ball.vy, 30, 'vy doit rester tel quel');
+  assert.equal(ball.x, 100 - BALL_R, 'la balle doit ressortir à gauche de la brique');
+  assert.equal(collides(ball, brick), false);
+});
+
+// Coin: pénétrations égales sur les deux axes => les deux composantes s'inversent.
+test('brickHit: corner hit flips both components', () => {
+  const brick = brickSeul();
+  // Cœur du coin bas-gauche : pénètre de 12 px sur chaque axe.
+  const ball = { x: 105, y: 115, px: 105, py: 115, r: BALL_R, vx: 300, vy: 300 };
+
+  const destroyed = brickHit(ball, [brick]);
+
+  assert.deepEqual(destroyed, [brick]);
+  assert.equal(ball.vx, -300);
+  assert.equal(ball.vy, -300);
+  assert.equal(collides(ball, brick), false);
+});
+
+// Push-out: après un rebond, la balle posée au bord ne re-rebondit pas au tour
+// suivant (le rebond collant qui s'annule et fait traverser la balle).
+test('brickHit: pushed-out ball does not re-bounce next frame', () => {
+  const brick = brickSeul();
+  // Positionnée exactement sur la face basse (brick.y + h + r), comme après un
+  // rebond, sans mouvement entre deux frames : aucun recouvrement, aucun rebond.
+  const ball = { x: 136, y: 120 + BALL_R, px: 136, py: 120 + BALL_R, r: BALL_R, vx: 40, vy: 300 };
+
+  const destroyed = brickHit(ball, [brick]);
+
+  assert.deepEqual(destroyed, []);
+  assert.equal(ball.vy, 300, 'la vitesse ne doit pas être touchée');
+  assert.equal(ball.vx, 40);
+});
+
+// Voisines: deux briques côte à côte, couture horizontale. Le rebond s'applique
+// UNE fois (vy s'inverse), les deux briques sont détruites.
+test('brickHit: seam between two bricks bounces exactly once', () => {
+  const a = brickSeul(100);
+  const b = brickSeul(100 + BRICK_W + BRICK_GAP);
+  // À cheval sur la couture (recouvre 3 px de chaque brique), 1 px sous la face
+  // basse : l'axe vertical gagne pour les deux.
+  const ball = { x: 176, y: 126, px: 176, py: 126, r: BALL_R, vx: 6, vy: -60 };
+
+  const destroyed = brickHit(ball, [a, b]);
+
+  assert.deepEqual(new Set(destroyed), new Set([a, b]));
+  assert.equal(ball.vy, 60, 'vy = -vy appliqué deux fois s\'annulerait et la balle traverserait');
+  assert.equal(ball.vx, 6, 'vx doit rester tel quel');
+});
+
+// Tunneling: une balle plus rapide qu'une brique par frame saute par-dessus le
+// recouvrement discret (avant/après) — le balayage entre les deux positions
+// doit quand même la faire rebondir.
+test('brickHit: fast ball tunnels through without sweep, swept detection catches it', () => {
+  const brick = brickSeul();
+  const ball = { x: 136, y: 92.5, px: 136, py: 128, r: BALL_R, vx: 0, vy: -710 };
+
+  // Preuve que la détection discrète ne voit rien : la position d'arrivée est
+  // entièrement au-dessus de la brique.
+  assert.equal(collides(ball, brick), false);
+
+  const destroyed = brickHit(ball, [brick]);
+
+  assert.deepEqual(destroyed, [brick], 'la brique franchie en une frame doit être touchée');
+  assert.equal(ball.vy, 710, 'la balle doit être renvoyée vers le bas');
+  assert.equal(ball.y, 120 + BALL_R, 'la balle doit s\'arrêter au bord de la brique');
+});
+
+// Rien à toucher: pas de rebond, pas de destruction, pas de plantage.
+test('brickHit: no brick touched => no bounce, nothing destroyed', () => {
+  const brick = brickSeul();
+  const ball = { x: 320, y: 300, px: 320, py: 300, r: BALL_R, vx: -100, vy: 50 };
+
+  const destroyed = brickHit(ball, [brick]);
+
+  assert.deepEqual(destroyed, []);
+  assert.equal(ball.vx, -100);
+  assert.equal(ball.vy, 50);
+});
+
