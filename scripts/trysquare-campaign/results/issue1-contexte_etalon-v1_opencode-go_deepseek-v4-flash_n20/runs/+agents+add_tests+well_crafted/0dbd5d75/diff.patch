+// --- Brick bounce (issue #1) ----------------------------------------------
+
+// Penetrations closer than this (in px) are treated as equal: the ball hit a
+// corner dead-on and both velocity components flip.
+const FACE_EPS = 0.5;
+
+// Continuous (swept) circle-vs-brick detection, slab method.
+// The ball's centre sweeps from (px,py) along (dx,dy) over the frame; the test
+// is the same segment against the brick rectangle expanded by the radius.
+// Returns the earliest t in [0,1] at which the ball *enters* the brick this
+// frame, or null if it never does. A pure touch — grazing a corner, or sitting
+// on a boundary and moving away — is not a hit: it must enter (tEnter >= 0)
+// with a real overlap interval (tEnter < tExit).
+function sweptEntry(ball, px, py, dx, dy, brick) {
+  const left = brick.x - ball.r;
+  const right = brick.x + brick.w + ball.r;
+  const top = brick.y - ball.r;
+  const bottom = brick.y + brick.h + ball.r;
+
+  let t0x = -Infinity;
+  let t1x = Infinity;
+  let t0y = -Infinity;
+  let t1y = Infinity;
+
+  if (dx !== 0) {
+    if (dx > 0) {
+      t0x = (left - px) / dx;
+      t1x = (right - px) / dx;
+    } else {
+      t0x = (right - px) / dx;
+      t1x = (left - px) / dx;
+    }
+  } else if (px < left || px > right) {
+    return null; // moving parallel to the box, outside its span: never enters
+  }
+
+  if (dy !== 0) {
+    if (dy > 0) {
+      t0y = (top - py) / dy;
+      t1y = (bottom - py) / dy;
+    } else {
+      t0y = (bottom - py) / dy;
+      t1y = (top - py) / dy;
+    }
+  } else if (py < top || py > bottom) {
+    return null;
+  }
+
+  const tEnter = Math.max(t0x, t0y);
+  const tExit = Math.min(t1x, t1y);
+
+  // No overlap interval, the box is behind the start, the entry is beyond the
+  // end of this frame, or the segment only grazes a corner (zero-width
+  // touch): no bounce.
+  if (tEnter > tExit || tExit < 0 || tEnter > 1 || tEnter < 0) return null;
+  if (tExit - tEnter < 1e-9) return null;
+  return tEnter;
+}
+
+// Resolves one bounce against a brick at the ball's current position.
+// The axis with the smaller penetration is the face that was hit: flip vy on a
+// top/bottom hit, vx on a side hit, leave the other component alone; equal
+// penetrations mean a diagonal hit on a corner, flip both. The ball is then
+// pushed back out of the rectangle so it cannot re-overlap (and re-flip) on
+// the next frame — the sticky bounce.
+function resolveBounce(ball, brick) {
+  const penLeft = ball.x + ball.r - brick.x;
+  const penRight = brick.x + brick.w - (ball.x - ball.r);
+  const penTop = ball.y + ball.r - brick.y;
+  const penBottom = brick.y + brick.h - (ball.y - ball.r);
+  const penX = Math.min(penLeft, penRight);
+  const penY = Math.min(penTop, penBottom);
+  const fromLeft = ball.vx > 0; // moving right: it entered through the left face
+  const fromTop = ball.vy > 0; // moving down: it entered through the top face
+
+  if (Math.abs(penX - penY) <= FACE_EPS) {
+    // Diagonal hit on a corner: reflect both axes.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    if (penX <= penY) {
+      ball.x = fromLeft ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    } else {
+      ball.y = fromTop ? brick.y - ball.r : brick.y + brick.h + ball.r;
+    }
+  } else if (penX < penY) {
+    // Side face: flip vx, keep vy, push out horizontally.
+    ball.x = fromLeft ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    ball.vx = -ball.vx;
+  } else {
+    // Top/bottom face: flip vy, keep vx, push out vertically.
+    ball.y = fromTop ? brick.y - ball.r : brick.y + brick.h + ball.r;
+    ball.vy = -ball.vy;
+  }
+}
+
+// Bounces the ball off the first brick it touches along its path this frame.
+// Detection is swept (see sweptEntry) so a ball moving faster than one brick
+// height per frame still bounces instead of tunnelling through (#1). At most
+// ONE bounce is applied — when the ball overlaps two bricks in the same pass
+// (every grid seam: 8 px gap vs a 14 px ball) a second flip would cancel the
+// first and let the ball through. Returns the bricks to destroy: every brick
+// actually reached before the bounce (a seam of two bricks shares the same
+// entry time, so both are returned; a brick further along the path than the
+// bounce point is not, the ball never reached it).
+// `ball.px`/`ball.py` are the pre-move position recorded by `step()`.
+export function brickHit(ball, bricks) {
+  const px = ball.px ?? ball.x;
+  const py = ball.py ?? ball.y;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+
+  let first = null;
+  let firstT = Infinity;
+  const touched = [];
+
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+
+    let t = null;
+    if (collides(ball, brick)) {
+      // Already overlapping at the start of the frame: resolve in place. This
+      // also unsticks a ball a previous frame failed to push out.
+      t = 0;
+    } else {
+      t = sweptEntry(ball, px, py, dx, dy, brick);
+    }
+    if (t === null) continue;
+
+    if (t <= firstT) {
+      firstT = t;
+      first = brick;
+    }
+    touched.push({ brick, t });
+  }
+
+  if (first !== null) {
+    if (firstT > 0) {
+      // Park the ball at the exact entry point: there the crossed axis has
+      // zero penetration, so resolveBounce picks the right face even after a
+      // 35 px leap, and the ball ends the frame outside the brick.
+      ball.x = px + dx * firstT;
+      ball.y = py + dy * firstT;
+    }
+    resolveBounce(ball, first);
+  }
+
+  return touched.filter(({ t }) => t <= firstT + 1e-9).map(({ brick }) => brick);
+}
