+// ---------------------------------------------------------------------------
+// Issue #1 — the ball bounces off bricks instead of plowing through them.
+//
+// Each fixture drops the ball already overlapping a brick (3 px deep on the
+// targeted face) and lets `step()` resolve the hit. A no-op canvas swallows
+// the render loop; `frame()` is exercised for the tunnel case only, where the
+// ball is outside the brick at rest and the bounce happens mid-flight.
+// ---------------------------------------------------------------------------
+
+const DT = 1 / 60;
+const DT_MAX = 0.05; // stutter cap applied by boot()
+const EPS = 1e-9;
+
+function brickAt(x, y) {
+  return { x, y, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 };
+}
+
+function noopCtx() {
+  const noop = () => {};
+  return new Proxy(
+    {},
+    {
+      get: (_, prop) => (prop === 'canvas' ? { width: WIDTH, height: HEIGHT } : noop),
+      set: () => true,
+    },
+  );
+}
+
+// Drives one bounce exactly like boot() does: step() integrates + resolves,
+// frame() renders. Returns the state.
+function bounce(state, dt = DT) {
+  step(state, dt);
+  frame(noopCtx(), state);
+  return state;
+}
+
+test('issue #1: side hit flips vx only and pushes the ball out', () => {
+  const state = createState(1);
+  state.bricks = [brickAt(100, 100)];
+  state.ball = { x: 96, y: 110, r: BALL_R, vx: 300, vy: 30 }; // 3 px into the left flank
+
+  bounce(state);
+
+  assert.ok(state.ball.vx < 0, 'vx must flip away from the left flank');
+  assert.equal(state.ball.vy, 30, 'vy must be left untouched');
+  assert.ok(state.ball.x + BALL_R <= 100 + EPS, 'ball must be pushed out of the brick');
+  assert.equal(state.bricks[0].alive, false, 'the brick must be destroyed');
+});
+
+test('issue #1: top/bottom hit flips vy only and pushes the ball out', () => {
+  const state = createState(1);
+  state.bricks = [brickAt(100, 100)];
+  state.ball = { x: 136, y: 124, r: BALL_R, vx: 30, vy: -300 }; // 3 px into the bottom face
+
+  bounce(state);
+
+  assert.ok(state.ball.vy > 0, 'vy must flip away from the bottom face');
+  assert.equal(state.ball.vx, 30, 'vx must be left untouched');
+  assert.ok(state.ball.y - BALL_R >= 120 - EPS, 'ball must be pushed out of the brick');
+});
+
+test('issue #1: corner hit (equal penetrations) flips both components', () => {
+  const state = createState(1);
+  state.bricks = [brickAt(100, 100)];
+  state.ball = { x: 96, y: 96, r: BALL_R, vx: 300, vy: 300 }; // 3 px into both the left and the top
+
+  bounce(state);
+
+  assert.ok(state.ball.vx < 0, 'vx must flip on a corner hit');
+  assert.ok(state.ball.vy < 0, 'vy must flip on a corner hit');
+});
+
+test('issue #1: a seam of two bricks bounces exactly once', () => {
+  const state = createState(1);
+  state.bricks = [
+    brickAt(100, 100),
+    brickAt(100 + BRICK_W + BRICK_GAP, 100), // horizontal seam, 8 px gap
+  ];
+  state.ball = { x: 176, y: 126, r: BALL_R, vx: 6, vy: -60 }; // straddles the seam, 1 px under both
+
+  bounce(state);
+
+  assert.ok(state.ball.vy > 0, 'vy must invert exactly once (not cancel out)');
+  assert.equal(state.ball.vx, 6, 'vx must be left untouched');
+  assert.ok(state.bricks.every((b) => !b.alive), 'both bricks in the seam are broken');
+});
+
+test('issue #1: fast ball sweeps the gap and cannot tunnel through a brick', () => {
+  const state = createState(6);
+  state.bricks = [brickAt(100, 100)];
+  // Before the move the ball is below the brick (y 121..135); after one
+  // stuttered 50 ms frame it is fully above (y 85.5..99.5): discrete sampling
+  // alone would never see the overlap.
+  state.ball = { x: 136, y: 128, r: BALL_R, vx: 0, vy: -ballSpeed(6) };
+
+  bounce(state, DT_MAX);
+
+  assert.equal(state.bricks[0].alive, false, 'the brick must not survive a crossing');
+  assert.ok(state.ball.vy > 0, 'the ball must be sent back down');
+});
+
