+// Two penetrations closer than this count as "equal": a corner hit.
+const CORNER_EPS = 1e-6;
+
+// Deflects the ball off a brick it overlaps (issue #1).
+//
+// Per face: the axis with the *smaller* penetration is the face that was hit —
+// flip `vy` on a top/bottom hit, `vx` on a side hit, and leave the other
+// component exactly as it was. Equal penetrations on both axes mean a
+// diagonal/corner hit: flip both components. In every case the ball is pushed
+// back out of the brick rectangle, otherwise it still overlaps on the next
+// frame and re-flips forever (sticky bounce).
+function bounceOffBrick(ball, brick) {
+  // Penetration depth on each side of the brick.
+  const left = ball.x + ball.r - brick.x;              // entered from the left
+  const right = brick.x + brick.w - (ball.x - ball.r); // entered from the right
+  const top = ball.y + ball.r - brick.y;               // entered from above
+  const bottom = brick.y + brick.h - (ball.y - ball.r); // entered from below
+
+  const penX = Math.min(left, right);
+  const penY = Math.min(top, bottom);
+
+  if (Math.abs(penX - penY) <= CORNER_EPS) {
+    // Corner: flip both components and push out diagonally.
+    if (left <= right) {
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+    if (top <= bottom) {
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  } else if (penX < penY) {
+    // Side hit: only the horizontal component flips.
+    if (left < right) {
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+  } else {
+    // Top/bottom hit: only the vertical component flips.
+    if (top < bottom) {
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  }
