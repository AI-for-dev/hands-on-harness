+    ball.y = penT < penB ? deepest.y - ball.r : deepest.y + deepest.h + ball.r;
+  }
+
+  for (const brick of contact.overlapping) {
+    brick.alive = false;
+    destroyed.push(brick);
+  }
+  return destroyed;
