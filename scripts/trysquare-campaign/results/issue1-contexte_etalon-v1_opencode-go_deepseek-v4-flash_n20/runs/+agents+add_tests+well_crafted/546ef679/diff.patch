+// Resolves the ball against the live bricks in a single pass — the missing
+// bounce from issue #1, with every failure mode of a naive fix covered:
+//
+//   - per face: the axis with the *smaller* penetration is the face that was
+//     hit — flip `vx` on a side hit, `vy` on a top/bottom hit, and leave the
+//     other component exactly as it was;
+//   - corner: equal penetrations mean a diagonal hit — flip both components;
+//   - push out: the ball is repositioned outside the rectangle, otherwise it
+//     still overlaps on the next frame and re-flips forever (sticky bounce);
+//   - neighbours: the grid gap (8 px) is narrower than the ball (14 px), so a
+//     seam overlaps two bricks in the *same* pass — the bounce is computed
+//     once over ALL of them and applied once (`vy = -vy` twice cancels out);
+//   - tunnelling: when (prevX, prevY) is given (recorded by `step()`), the
+//     path from the previous position to the current one is swept in
+//     sub-radius steps, so a fast ball (level 6: 35.5 px/frame against a
+//     34 px crossing) cannot jump over a brick without ever touching it.
+//
+// Returns the bricks that were destroyed (marked dead), for the caller to
+// score. Pure: no DOM, no state beyond `ball` and `bricks`.
+export function brickHit(ball, bricks, prevX = null, prevY = null) {
+  const destroyed = [];
+
+  // Swept collision: sample the path taken since the last `step()`.
+  // Sampling every ≤ ball.r guarantees a 14 px ball can never slip between
+  // two samples through a brick (20 px tall, 72 px wide).
+  const fromX = prevX === null ? ball.x : prevX;
+  const fromY = prevY === null ? ball.y : prevY;
+  const distance = Math.hypot(ball.x - fromX, ball.y - fromY);
+  const segments = Math.max(1, Math.ceil(distance / ball.r));
+  let contact = null;
+
+  for (let i = 0; i <= segments; i++) {
+    const t = i / segments;
+    const x = fromX + (ball.x - fromX) * t;
+    const y = fromY + (ball.y - fromY) * t;
+    const overlapping = bricks.filter(
+      (brick) => brick.alive && collides({ x, y, r: ball.r }, brick),
+    );
+    if (overlapping.length > 0) {
+      contact = { x, y, overlapping };
+      break;
+    }
+  }
+
+  // No previous position recorded yet (fresh ball): judge the current
+  // position only.
+  if (contact === null) {
+    const overlapping = bricks.filter((brick) => brick.alive && collides(ball, brick));
+    if (overlapping.length > 0) contact = { x: ball.x, y: ball.y, overlapping };
+  }
+
+  if (contact === null) return destroyed;
+
+  // Shallowest penetration across every brick touched in this pass: that is
+  // the face that was actually hit. Computed once over all neighbours so the
+  // bounce applies exactly once.
+  let minX = Infinity;
+  let minY = Infinity;
+  let deepest = null; // brick owning the shallowest face (drives the push-out)
+  let shallowest = Infinity;
+  let penL = 0;
+  let penR = 0;
+  let penT = 0;
+  let penB = 0;
+
+  for (const brick of contact.overlapping) {
+    const pL = contact.x + ball.r - brick.x;
+    const pR = brick.x + brick.w - (contact.x - ball.r);
+    const pT = contact.y + ball.r - brick.y;
+    const pB = brick.y + brick.h - (contact.y - ball.r);
+    minX = Math.min(minX, pL, pR);
+    minY = Math.min(minY, pT, pB);
+    const shallow = Math.min(pL, pR, pT, pB);
+    if (shallow < shallowest) {
+      shallowest = shallow;
+      deepest = brick;
+      penL = pL;
+      penR = pR;
+      penT = pT;
+      penB = pB;
+    }
