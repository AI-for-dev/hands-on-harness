+// --- Issue #1: the ball must bounce off bricks ------------------------------
+//
+// Each case mirrors one scenario from ISSUES.md #1: per-face bounce (the axis
+// with the smaller penetration flips, the other component is untouched),
+// corner hit (both components flip), push-out (the ball must leave the brick
+// rectangle, otherwise it re-overlaps and re-flips forever), neighbours (the
+// grid seam overlaps two bricks in the same pass — the bounce must apply
+// exactly once) and tunnelling (a fast ball must be caught by a sweep between
+// the previous and the current position).
+
+const BRICK = { x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 };
+const DT = 1 / 60;
+
+test('brick: left side hit flips vx, keeps vy, pushes the ball out', () => {
+  const state = createState(1);
+  state.bricks = [{ ...BRICK }];
+  state.ball = { x: 96, y: 110, r: BALL_R, vx: 300, vy: 30 };
+
+  step(state, DT);
+
+  assert.ok(state.ball.vx < 0, `vx should flip to the left: ${state.ball.vx}`);
+  assert.equal(state.ball.vy, 30, 'vy must stay exactly as it was');
+  assert.ok(state.ball.x + BALL_R <= 100 + 1e-9, 'ball must be pushed out of the brick');
+  assert.equal(state.bricks[0].alive, false, 'brick must be destroyed');
+});
+
