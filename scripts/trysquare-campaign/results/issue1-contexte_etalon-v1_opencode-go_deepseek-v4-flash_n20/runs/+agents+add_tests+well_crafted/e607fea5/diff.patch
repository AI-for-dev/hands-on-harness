+
+    if (collides(ball, brick)) {
+      resolveBrick(state, brick);
+      continue;
+    }
+
+    const hit = sweptHit(ball, brick, px, py, ball.x, ball.y);
+    if (hit) {
+      ball.x = hit.x;
+      ball.y = hit.y;
+      resolveBrick(state, brick);
+    }
+  }
