+// gap (8 px < ball diameter 14 px) makes the ball overlap two bricks in the
+// same pass: after the first bounce the ball no longer overlaps the second,
+// so `vy = -vy` is never applied twice (which would cancel out).
+function bounceOffBricks(state, px, py) {
+  const { ball, bricks } = state;
