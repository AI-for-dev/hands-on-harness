+// --- Brick bounce (ISSUES.md #1) ------------------------------------------
+
+// A lone brick and a ball that already overlaps it, exactly like the fixtures
+// of the issue: 3 px into the aimed face, fully inside on the other axis.
+function brickAndBall(ball) {
+  const state = createState(1);
+  state.bricks = [{ x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 }];
+  state.ball = ball;
+  return state;
+}
+
+const faceBall = (x, y, vx, vy) => ({ x, y, r: BALL_R, vx, vy });
+
+// Per face: the axis with the smaller penetration flips, the other stays put.
+test('brick bounce: left side hit flips vx only', () => {
+  const state = brickAndBall(faceBall(96, 110, 300, 30));
+  step(state, 1 / 60);
+  assert.ok(state.ball.vx < 0, `vx should flip left: ${state.ball.vx}`);
+  assert.equal(state.ball.vy, 30, 'vy must stay untouched');
+});
+
+test('brick bounce: top face hit flips vy only', () => {
+  const state = brickAndBall(faceBall(136, 96, 30, 300));
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy < 0, `vy should flip up: ${state.ball.vy}`);
+  assert.equal(state.ball.vx, 30, 'vx must stay untouched');
+});
+
+// Corner: equal penetrations flip both components.
+test('brick bounce: corner hit flips both components', () => {
+  const state = brickAndBall(faceBall(96, 96, 300, 300));
+  step(state, 1 / 60);
+  assert.ok(state.ball.vx < 0, `vx should flip left: ${state.ball.vx}`);
+  assert.ok(state.ball.vy < 0, `vy should flip up: ${state.ball.vy}`);
+});
+
+// Push out: after the bounce the ball no longer overlaps the brick, otherwise
+// it would re-flip forever on the next frame (sticky bounce).
+test('brick bounce: ball is pushed back out of the brick', () => {
+  const state = brickAndBall(faceBall(96, 110, 300, 30));
+  step(state, 1 / 60);
+  assert.ok(
+    state.ball.x + BALL_R <= 100,
+    `right edge should clear the brick: ${state.ball.x + BALL_R}`,
+  );
+  assert.equal(collides(state.ball, state.bricks[0]), false);
+});
+
+// Neighbours: the grid gap (8 px) is smaller than the ball diameter (14 px),
+// so a seam overlaps two bricks in the same pass. The bounce applies exactly
+// once — a double `vy = -vy` would cancel out and the ball would go through.
+test('brick bounce: horizontal seam bounces exactly once', () => {
+  const state = createState(1);
+  state.bricks = [
+    { x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 },
+    { x: 100 + BRICK_W + BRICK_GAP, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 },
+  ];
+  state.ball = faceBall(176, 126, 6, -60);
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy > 0, `vy should flip exactly once: ${state.ball.vy}`);
+  assert.ok(state.ball.vx > 0, `vx should stay positive: ${state.ball.vx}`);
+});
+
+// Tunnelling: at level 6 the ball moves 35.5 px per capped frame against 34 px
+// to cross a brick, so a discrete test would never see the overlap. The swept
+// detection between the two positions must catch it.
+test('brick bounce: fast ball does not tunnel through', () => {
+  const state = createState(6);
+  const brick = { x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 };
+  state.bricks = [brick];
+  state.ball = faceBall(136, 128, 0, -ballSpeed(6));
+  step(state, 0.05); // capped stutter frame, like boot()
+  assert.equal(brick.alive, false, 'the brick must be broken');
+  assert.ok(state.ball.vy > 0, `ball should bounce back down: ${state.ball.vy}`);
+});
+
