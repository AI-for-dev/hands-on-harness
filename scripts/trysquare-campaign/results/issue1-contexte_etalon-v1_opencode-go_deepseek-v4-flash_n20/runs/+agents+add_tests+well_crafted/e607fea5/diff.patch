+// Swept test: does the ball cross the brick while travelling from (px, py) to
+// (nx, ny)? The ball is a circle, so the brick is grown by the radius and the
+// segment between the two centers is tested against that box (slab method).
+// Returns the impact point, or null when there is no crossing. A ball that was
+// already overlapping the grown box at the start is NOT a crossing: the
+// discrete test in bounceOffBricks() handles that case.
+function sweptHit(ball, brick, px, py, nx, ny) {
+  const dx = nx - px;
+  const dy = ny - py;
+  if (dx === 0 && dy === 0) return null;
+
+  let t0 = 0;
+  let t1 = 1;
+  const slab = (p, d, lo, hi) => {
+    if (d === 0) return p >= lo && p <= hi;
+    let a = (lo - p) / d;
+    let b = (hi - p) / d;
+    if (a > b) {
+      const t = a;
+      a = b;
+      b = t;
+    }
+    if (a > t0) t0 = a;
+    if (b < t1) t1 = b;
+    return t0 <= t1;
+  };
+
+  if (!slab(px, dx, brick.x - ball.r, brick.x + brick.w + ball.r)) return null;
+  if (!slab(py, dy, brick.y - ball.r, brick.y + brick.h + ball.r)) return null;
+  if (t0 <= 0) return null; // already overlapping at the start, not a crossing
+
+  return { x: px + dx * t0, y: py + dy * t0 };
+}
