+// --- Brick collision resolution (issue #1) ---------------------------------
+//
+// The ball is a circle and a brick an AABB. Inflating the brick by the ball
+// radius turns "does the circle overlap the rectangle?" into the point test
+// "is the centre inside the inflated box?" — used below for both the overlap
+// and the sweep. Every contact is resolved exactly once:
+//
+//  - per face: the axis with the SMALLER penetration is the face that was
+//    hit — flip that component, leave the other one exactly as it was;
+//  - corner: equal penetrations on both axes mean a diagonal hit — flip both;
+//  - push out: the ball is repositioned outside the brick, otherwise it still
+//    overlaps on the next frame and re-flips forever (sticky bounce);
+//  - neighbours: the 8 px grid gap is narrower than the 14 px ball, so every
+//    seam overlaps two bricks in the same pass. Contacts are resolved one at
+//    a time and each resolution pushes the ball out first, so the bounce only
+//    ever applies once (`vy = -vy` twice would cancel and let the ball
+//    through);
+//  - tunnelling: detection is discrete (position before / after the move), so
+//    at level 6 a stuttered 50 ms frame (35.5 px) can jump the ball over a
+//    brick (34 px to cross). The sweep between the previous position (saved
+//    by step() as px/py) and the current one catches the crossing and bounces
+//    the ball at the entry point.
+const EPS = 1e-9;
+
+// Earliest contact of the ball with any live brick, or null. `px/py` is where
+// the ball was before the current step (used by the sweep).
+function earliestContact(ball, bricks, px, py) {
+  let best = null;
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    const contact = brickContact(ball, brick, px, py);
+    if (contact && (!best || contact.t < best.t)) best = contact;
+  }
+  return best;
+}
+
+// Contact of the ball with one brick: overlap first (t = 0), then sweep.
+function brickContact(ball, brick, px, py) {
+  return overlapContact(ball, brick) ?? sweepContact(ball, brick, px, py);
+}
+
+// Overlap at the current position. Returns { brick, t: 0, face, x, y } where
+// x/y is the push-out position (the ball ends exactly touching the face).
+function overlapContact(ball, brick) {
+  const r = ball.r;
+  const x1 = brick.x - r;
+  const x2 = brick.x + brick.w + r;
+  const y1 = brick.y - r;
+  const y2 = brick.y + brick.h + r;
+  if (!(ball.x > x1 && ball.x < x2 && ball.y > y1 && ball.y < y2)) return null;
+
+  // Penetration depth per face: the smaller one is the face that was hit.
+  const pens = [
+    { face: 'left', d: ball.x - x1, x: x1, y: ball.y },
+    { face: 'right', d: x2 - ball.x, x: x2, y: ball.y },
+    { face: 'top', d: ball.y - y1, x: ball.x, y: y1 },
+    { face: 'bottom', d: y2 - ball.y, x: ball.x, y: y2 },
+  ];
+  pens.sort((a, b) => a.d - b.d);
+
+  if (Math.abs(pens[0].d - pens[1].d) < EPS) {
+    // Corner: the two smallest penetrations are two adjacent faces.
+    const horizontal = pens[0].face === 'left' || pens[0].face === 'right' ? pens[0] : pens[1];
+    const vertical = pens[0].face === 'top' || pens[0].face === 'bottom' ? pens[0] : pens[1];
+    return { brick, t: 0, face: 'corner', x: horizontal.x, y: vertical.y };
+  }
+  return { brick, t: 0, face: pens[0].face, x: pens[0].x, y: pens[0].y };
+}
+
+// Sweep between the previous position (px/py) and the current one: does the
+// segment enter the inflated box? If yes, returns the first entry point.
+function sweepContact(ball, brick, px, py) {
+  const r = ball.r;
+  const x1 = brick.x - r;
+  const x2 = brick.x + brick.w + r;
+  const y1 = brick.y - r;
+  const y2 = brick.y + brick.h + r;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+  if (dx === 0 && dy === 0) return null;
+
+  // Slab method: entry/exit time along each axis, intersected over both.
+  let tMinX = -Infinity;
+  let tMaxX = Infinity;
+  let tMinY = -Infinity;
+  let tMaxY = Infinity;
+  if (dx !== 0) {
+    const a = (x1 - px) / dx;
+    const b = (x2 - px) / dx;
+    tMinX = Math.min(a, b);
+    tMaxX = Math.max(a, b);
+  } else if (!(px > x1 && px < x2)) {
+    return null; // path parallel to x, never reaches the box
+  }
+  if (dy !== 0) {
+    const a = (y1 - py) / dy;
+    const b = (y2 - py) / dy;
+    tMinY = Math.min(a, b);
+    tMaxY = Math.max(a, b);
+  } else if (!(py > y1 && py < y2)) {
+    return null;
+  }
+
+  const tIn = Math.max(tMinX, tMinY);
+  const tOut = Math.min(tMaxX, tMaxY);
+  if (tIn > tOut || tIn <= 0 || tIn > 1) return null;
+
+  // The axis whose entry time binds is the face that was hit.
+  let face;
+  if (Math.abs(tMinX - tMinY) < EPS) {
