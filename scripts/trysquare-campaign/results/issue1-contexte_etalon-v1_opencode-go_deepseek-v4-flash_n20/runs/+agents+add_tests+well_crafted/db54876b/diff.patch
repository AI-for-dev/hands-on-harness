+// --- Issue #1: the ball bounces off bricks --------------------------------
+//
+// The five behaviours of the issue, each a red test before the fix landed:
+// per-face bounce, corner hit, push-out, a single bounce on a seam, and a
+// sweep so a fast ball cannot tunnel. They drive the resolution through
+// frame() with a stub context, exactly where the game runs it.
+
+const EPS = 1e-9;
+
+// A canvas context stub: any property read is a no-op function, so frame()
+// can run headless (no DOM needed).
+function fakeCtx() {
+  const noop = () => {};
+  return new Proxy(
+    {},
+    {
+      get: (_, prop) => (prop === 'canvas' ? { width: WIDTH, height: HEIGHT } : noop),
+      set: () => true,
+    },
+  );
+}
+
+// A single brick at a known location, as the fixtures below expect.
+function loneBrick() {
+  return [{ x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 }];
+}
+
+describe('issue #1: brick bounce', () => {
+  test('per-face: left flank flips vx only', () => {
+    const state = createState(1);
+    state.bricks = loneBrick();
+    state.ball = { x: 96, y: 110, r: BALL_R, vx: 300, vy: 30 };
+    frame(fakeCtx(), state);
+    assert.equal(state.ball.vx, -300);
+    assert.equal(state.ball.vy, 30);
+    assert.equal(state.bricks[0].alive, false);
+  });
+
+  test('per-face: right flank flips vx only', () => {
+    const state = createState(1);
+    state.bricks = loneBrick();
