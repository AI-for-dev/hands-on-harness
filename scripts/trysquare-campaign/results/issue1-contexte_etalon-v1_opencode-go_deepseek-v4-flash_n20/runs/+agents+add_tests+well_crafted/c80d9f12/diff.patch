+// the earliest contact, scores them, bounces the ball off the face it entered
+// (flipping exactly that axis — or both on a corner — and nothing else), then
+// pushes the ball back outside the bricks. All bricks entered at the same
+// instant are grouped and bounce once, as a single wall (seam-safe).
+// Returns the array of bricks that were hit.
+export function brickBounce(state) {
+  const { ball, bricks } = state;
