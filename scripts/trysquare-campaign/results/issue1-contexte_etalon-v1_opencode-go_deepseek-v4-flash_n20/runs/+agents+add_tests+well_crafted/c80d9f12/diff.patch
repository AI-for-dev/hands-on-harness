+// Earliest time t in [0, 1] at which the ball's box (radius `r`, centre
+// sweeping from (x0, y0) along (dx, dy)) first touches the brick's expanded
+// box [brick.x - r, brick.x + brick.w + r] x [brick.y - r, brick.y + brick.h + r].
+// Returns null when the swept path misses the brick entirely.
+function sweptEntry(x0, y0, dx, dy, brick, r) {
+  const x1 = brick.x - r;
+  const x2 = brick.x + brick.w + r;
+  const y1 = brick.y - r;
+  const y2 = brick.y + brick.h + r;
+
+  let tEnter = 0;
+  let tExit = 1;
+
+  // X slab.
+  if (dx === 0) {
+    if (x0 < x1 || x0 > x2) return null;
+  } else {
+    let a = (x1 - x0) / dx;
+    let b = (x2 - x0) / dx;
+    if (a > b) {
+      const tmp = a;
+      a = b;
+      b = tmp;
+    }
+    tEnter = Math.max(tEnter, a);
+    tExit = Math.min(tExit, b);
+  }
+
+  // Y slab.
+  if (dy === 0) {
+    if (y0 < y1 || y0 > y2) return null;
+  } else {
+    let a = (y1 - y0) / dy;
+    let b = (y2 - y0) / dy;
+    if (a > b) {
+      const tmp = a;
+      a = b;
+      b = tmp;
+    }
+    tEnter = Math.max(tEnter, a);
+    tExit = Math.min(tExit, b);
+  }
