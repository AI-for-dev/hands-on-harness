+// --- Issue #1: the ball must bounce off bricks, not plow through -----------
+
+// A context stub: every method is a no-op, property writes are accepted.
+// Lets us exercise the render pass (where brick collisions are resolved)
+// without a canvas.
+function noopCtx() {
+  return new Proxy(
+    {},
+    {
+      get(target, prop) {
+        if (!(prop in target)) target[prop] = () => {};
+        return target[prop];
+      },
+      set(target, prop, value) {
+        target[prop] = value;
+        return true;
+      },
+    }
+  );
+}
