+
+// A ball already overlapping a brick is resolved without any movement (dt = 0),
+// so these tests judge the resolution, not the integration.
+
+test('step: side hit flips vx and leaves vy alone', () => {
+  const state = createState(1);
+  state.bricks = [makeBrick()];
+  state.ball = { x: 96, y: 110, r: BALL_R, vx: 300, vy: 30 };
+  step(state, 0);
+  assert.ok(state.ball.vx < 0, 'vx should flip on a left-face hit');
+  assert.equal(state.ball.vy, 30, 'vy must stay untouched');
+});
+
