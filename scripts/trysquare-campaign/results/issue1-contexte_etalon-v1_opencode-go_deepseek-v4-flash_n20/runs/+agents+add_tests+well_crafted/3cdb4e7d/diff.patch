+// `step()` directly, where the resolution now lives.
+
+// Fresh brick per test: `step()` mutates the bricks it destroys.
+const makeBrick = (over = {}) => ({
+  x: 100,
+  y: 100,
+  w: BRICK_W,
+  h: BRICK_H,
+  row: 0,
+  alive: true,
+  points: 10,
