+  // Sub-steps small enough that the ball can never jump over a brick face
+  // (`BALL_R` = 7 px < `BRICK_H` = 20 px). The worst case — level 6, a 50 ms
+  // stuttered frame — is a 35.5 px move, i.e. at most 6 samples.
+  const steps = Math.max(1, Math.ceil(dist / BALL_R));
