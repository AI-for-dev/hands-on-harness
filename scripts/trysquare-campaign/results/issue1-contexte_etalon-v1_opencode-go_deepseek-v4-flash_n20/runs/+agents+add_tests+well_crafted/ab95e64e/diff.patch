+// Penetration of the ball's box into the brick, per face, in pixels.
+function penetration(ball, brick) {
+  return {
+    left: ball.x + ball.r - brick.x,
+    right: brick.x + brick.w - (ball.x - ball.r),
+    top: ball.y + ball.r - brick.y,
+    bottom: brick.y + brick.h - (ball.y - ball.r),
+  };
+}
+
+// Equal-penetration tolerance. Below this, a hit is a diagonal corner hit and
+// BOTH components flip; otherwise only the axis with the smaller penetration
+// bounces (per-face rule).
+const CORNER_EPS = 1e-9;
+
+// Flips the velocity along the face(s) actually hit and pushes the ball just
+// outside the brick, so it cannot still overlap on the next frame (sticky
+// bounce, see #1).
+//   per face: the axis with the smaller penetration is the face hit — flip
+//             `vy` on a top/bottom hit, `vx` on a side hit, leave the other
+//             component exactly as it was;
+//   corner:   equal penetrations mean a diagonal hit — flip both components;
+//   leaving:  a ball already moving away on every candidate axis is not
+//             bounced (it slides out on its own).
+// Returns `true` when a bounce happened.
+function resolveBounce(ball, brick, pen) {
+  const minH = Math.min(pen.left, pen.right);
+  const minV = Math.min(pen.top, pen.bottom);
+  const hFace = pen.left <= pen.right ? 'left' : 'right';
+  const vFace = pen.top <= pen.bottom ? 'top' : 'bottom';
+  const intoX = hFace === 'left' ? ball.vx > 0 : ball.vx < 0;
+  const intoY = vFace === 'top' ? ball.vy > 0 : ball.vy < 0;
+
+  // Corner: diagonal hit, both components flip.
+  if (Math.abs(minH - minV) <= CORNER_EPS && intoX && intoY) {
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    if (minH <= minV) {
+      ball.x = hFace === 'left' ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    } else {
+      ball.y = vFace === 'top' ? brick.y - ball.r : brick.y + brick.h + ball.r;
+    }
+    return true;
+  }
+
+  // Side hit: flip `vx` only, push out horizontally.
+  if (minH <= minV && intoX) {
+    ball.vx = -ball.vx;
+    ball.x = hFace === 'left' ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    return true;
+  }
+
+  // Top/bottom hit: flip `vy` only, push out vertically.
+  if (minV <= minH && intoY) {
+    ball.vy = -ball.vy;
+    ball.y = vFace === 'top' ? brick.y - ball.r : brick.y + brick.h + ball.r;
+    return true;
+  }
+
+  return false;
+}
