+// --- Issue #1: the ball bounces off bricks (per-face, corner, push-out, ---
+// --- seams, tunnelling) instead of plowing through.                    ---
+
+function fakeCtx() {
+  const noop = () => {};
+  return new Proxy({}, { get: () => noop, set: () => true });
+}
+
+function oneBrick(over = {}) {
+  return [{ x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10, ...over }];
+}
+
+const CTX = fakeCtx();
+
+test('frame: side hit flips vx and leaves vy untouched', () => {
+  const state = createState(1);
+  state.bricks = oneBrick();
+  state.ball = { x: 96, y: 110, r: BALL_R, vx: 300, vy: 30 };
+  frame(CTX, state);
+  assert.ok(state.ball.vx < 0, 'vx should flip on a left-face hit');
+  assert.equal(state.ball.vy, 30, 'vy must stay exactly as it was');
+});
+
+test('frame: top/bottom hit flips vy and leaves vx untouched', () => {
+  const state = createState(1);
+  state.bricks = oneBrick();
+  state.ball = { x: 136, y: 124, r: BALL_R, vx: 30, vy: -300 };
+  frame(CTX, state);
+  assert.ok(state.ball.vy > 0, 'vy should flip on a bottom-face hit');
+  assert.equal(state.ball.vx, 30, 'vx must stay exactly as it was');
+});
+
+test('frame: corner hit (equal penetrations) flips both components', () => {
+  const state = createState(1);
+  state.bricks = oneBrick();
+  state.ball = { x: 96, y: 96, r: BALL_R, vx: 300, vy: 300 };
+  frame(CTX, state);
+  assert.ok(state.ball.vx < 0);
+  assert.ok(state.ball.vy < 0);
+});
+
+test('frame: ball is pushed back out of the brick (no sticky bounce)', () => {
+  const state = createState(1);
+  state.bricks = oneBrick();
+  state.ball = { x: 136, y: 124, r: BALL_R, vx: 30, vy: -300 };
+  frame(CTX, state);
+  assert.ok(state.ball.y - BALL_R >= 120, 'ball top should sit at the brick bottom face');
+  // And a second pass must not re-flip: the ball no longer overlaps the brick.
+  const vy = state.ball.vy;
+  frame(CTX, state);
+  assert.equal(state.ball.vy, vy, 'no re-bounce on the frame after push-out');
+});
+
+test('frame: hit brick is destroyed and scored', () => {
+  const state = createState(1);
+  state.bricks = oneBrick();
+  state.ball = { x: 136, y: 124, r: BALL_R, vx: 30, vy: -300 };
+  frame(CTX, state);
+  assert.equal(state.bricks[0].alive, false);
+  assert.ok(state.score > 0);
+  assert.equal(state.combo, 1);
+});
+
+test('frame: seam between two bricks bounces exactly once', () => {
+  const state = createState(1);
+  state.bricks = [
+    { x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 },
+    { x: 100 + BRICK_W + BRICK_GAP, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 },
+  ];
+  // Centred on the seam, 1 px below the bottom faces: vy must flip exactly once.
+  state.ball = { x: 176, y: 126, r: BALL_R, vx: 6, vy: -60 };
+  frame(CTX, state);
+  assert.ok(state.ball.vy > 0, 'vy flipped once, not twice');
+  assert.equal(state.ball.vx, 6, 'vx untouched');
+  assert.ok(state.bricks.every((b) => !b.alive), 'both seam bricks destroyed');
+});
+
+test('step: fast ball does not tunnel through a brick at level 6 speed', () => {
+  const state = createState(6);
+  const brick = { x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 };
+  state.bricks = [brick];
+  // 35.5 px jump on a capped stuttered frame vs 34 px needed to cross a brick.
+  state.ball = { x: 136, y: 128, r: BALL_R, vx: 0, vy: -ballSpeed(6) };
+  step(state, 0.05);
+  assert.equal(brick.alive, false, 'brick must be caught mid-flight');
+  assert.ok(state.ball.vy > 0, 'ball must bounce back down');
+});
+
