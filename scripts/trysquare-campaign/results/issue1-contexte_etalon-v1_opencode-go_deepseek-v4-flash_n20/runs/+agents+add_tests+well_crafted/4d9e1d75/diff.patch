+// --- Brick bounce (issue #1) -----------------------------------------------
+
+// Comparison epsilon for "equal penetrations" (a diagonal/corner hit).
+const EPS = 1e-9;
+
+// Computes which face of `brick` the ball hit, from the penetration depths
+// along each axis: the axis with the SMALLER penetration is the face that was
+// hit. Equal penetrations (within EPS) mean a corner hit and BOTH velocity
+// components flip. The returned position pushes the ball back outside the
+// brick rectangle so it cannot re-overlap on the next frame (sticky bounce).
+function hitFace(ball, brick) {
+  const pLeft = ball.x + ball.r - brick.x; // penetration through the left face
+  const pRight = brick.x + brick.w - (ball.x - ball.r); // ... right face
+  const pTop = ball.y + ball.r - brick.y; // ... top face
+  const pBottom = brick.y + brick.h - (ball.y - ball.r); // ... bottom face
+
+  const px = Math.min(pLeft, pRight);
+  const py = Math.min(pTop, pBottom);
+
+  if (px < py - EPS) {
+    // Side hit: flip vx, leave vy exactly as it was.
+    const left = pLeft < pRight;
+    return {
+      pen: px,
+      flipX: true,
+      flipY: false,
+      x: left ? brick.x - ball.r : brick.x + brick.w + ball.r,
+      y: ball.y,
+    };
+  }
+  if (py < px - EPS) {
+    // Top/bottom hit: flip vy, leave vx exactly as it was.
+    const top = pTop < pBottom;
+    return {
+      pen: py,
+      flipX: false,
+      flipY: true,
+      x: ball.x,
+      y: top ? brick.y - ball.r : brick.y + brick.h + ball.r,
+    };
+  }
+  // Corner hit: equal penetration on both axes — flip both components.
+  return {
+    pen: px,
+    flipX: true,
+    flipY: true,
+    x: pLeft < pRight ? brick.x - ball.r : brick.x + brick.w + ball.r,
+    y: pTop < pBottom ? brick.y - ball.r : brick.y + brick.h + ball.r,
+  };
+}
+
+// Resolves the ball against every live brick it overlaps in a SINGLE bounce
+// event. The 8 px grid gap is smaller than the 14 px ball, so every seam
+// overlaps two bricks in the same pass: bouncing per brick would flip the same
+// component twice and cancel out, letting the ball plow through. The face with
+// the smallest penetration across all touched bricks decides the bounce, and
+// every touched brick is destroyed and scored.
+// Returns true if at least one brick was hit.
+export function bounceBricks(state) {
+  const { ball, bricks } = state;
+  const hit = [];
+  for (const brick of bricks) {
+    if (brick.alive && collides(ball, brick)) hit.push(brick);
+  }
+  if (hit.length === 0) return false;
+
+  // The closest contact wins: the smallest penetration among all bricks.
+  let face = null;
+  for (const brick of hit) {
+    const f = hitFace(ball, brick);
+    if (face === null || f.pen < face.pen) face = f;
+  }
+
+  if (face.flipX) ball.vx = -ball.vx;
+  if (face.flipY) ball.vy = -ball.vy;
+  ball.x = face.x;
+  ball.y = face.y;
+
+  for (const brick of hit) {
+    brick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(brick, state.combo);
+  }
+  return true;
+}
+
+// Tunnelling guard: detection is discrete (position before / after the move)
+// and at level 6 a capped stuttered frame moves the ball 35.5 px against the
+// 34 px needed to cross a brick, so the ball could jump over a brick without
+// ever overlapping it. Re-sample the travelled segment in steps small enough
+// that an overlap cannot be skipped, resolving the first hit and stopping
+// there: the bounce flips the velocity and the ball is pushed back out.
+const SWEEP_STEP = 20; // px per sub-step; crossing a face needs BRICK_H + 2*BALL_R = 34
+function sweepBricks(state, fromX, fromY) {
+  const ball = state.ball;
+  const dx = ball.x - fromX;
+  const dy = ball.y - fromY;
+  const dist = Math.hypot(dx, dy);
+  if (dist === 0) return;
+  const steps = Math.max(1, Math.ceil(dist / SWEEP_STEP));
+  for (let i = 1; i <= steps; i++) {
+    ball.x = fromX + (dx * i) / steps;
+    ball.y = fromY + (dy * i) / steps;
+    if (bounceBricks(state)) return;
+  }
+}
