+// --- Issue #1: the ball bounces off bricks ----------------------------------
+//
+// Each face case places a ball already overlapping a brick by 3 px on the
+// targeted face and far more on the other axis, then plays one step: the hit
+// face (smaller penetration) must flip its own axis only. The corner case uses
+// equal penetrations. The push-out cases check the ball leaves the rectangle.
+// The seam cases place the ball over the 8 px grid gap (two bricks in the same
+// pass): the bounce must apply exactly once. The tunnelling case uses the real
+// level-6 speed and a stuttered frame, where the discrete samples straddle the
+// brick: only a sweep between the two positions catches it.
+
+const DT = 1 / 60;
+const DT_MAX = 0.05;
+
+function brickAt(x = 100, y = 100) {
+  return { x, y, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 };
+}
+
+function oneBrickState(ball, bricks = [brickAt()]) {
+  const state = createState(1);
+  state.bricks = bricks;
+  state.ball = ball;
+  return state;
+}
+
+test('brick: left face flips vx only', () => {
+  const state = oneBrickState({ x: 96, y: 110, r: BALL_R, vx: 300, vy: 30 });
+  step(state, DT);
+  assert.ok(state.ball.vx < 0, `vx should flip to the left: ${state.ball.vx}`);
+  assert.equal(state.ball.vy, 30, 'vy must stay untouched');
+});
+
+test('brick: right face flips vx only', () => {
+  const state = oneBrickState({ x: 176, y: 110, r: BALL_R, vx: -300, vy: 30 });
+  step(state, DT);
+  assert.ok(state.ball.vx > 0, `vx should flip to the right: ${state.ball.vx}`);
+  assert.equal(state.ball.vy, 30, 'vy must stay untouched');
+});
+
+test('brick: top face flips vy only', () => {
+  const state = oneBrickState({ x: 136, y: 96, r: BALL_R, vx: 30, vy: 300 });
+  step(state, DT);
+  assert.ok(state.ball.vy < 0, `vy should flip upward: ${state.ball.vy}`);
+  assert.equal(state.ball.vx, 30, 'vx must stay untouched');
+});
+
+test('brick: bottom face flips vy only', () => {
+  const state = oneBrickState({ x: 136, y: 124, r: BALL_R, vx: 30, vy: -300 });
+  step(state, DT);
+  assert.ok(state.ball.vy > 0, `vy should flip downward: ${state.ball.vy}`);
+  assert.equal(state.ball.vx, 30, 'vx must stay untouched');
+});
+
+test('brick: corner hit flips both components', () => {
+  const state = oneBrickState({ x: 96, y: 96, r: BALL_R, vx: 300, vy: 300 });
+  step(state, DT);
+  assert.ok(state.ball.vx < 0, `vx should flip to the left: ${state.ball.vx}`);
+  assert.ok(state.ball.vy < 0, `vy should flip upward: ${state.ball.vy}`);
+});
+
+test('brick: ball is pushed back out of the rectangle', () => {
+  const state = oneBrickState({ x: 96, y: 110, r: BALL_R, vx: 300, vy: 30 });
+  step(state, DT);
+  assert.ok(
+    state.ball.x + BALL_R <= 100,
+    `right edge should clear the left face: ${state.ball.x + BALL_R}`,
+  );
+});
+
+test('brick: two bricks on a horizontal seam bounce exactly once', () => {
+  const bricks = [brickAt(), brickAt(100 + BRICK_W + 8)];
+  const state = oneBrickState({ x: 176, y: 126, r: BALL_R, vx: 6, vy: -60 }, bricks);
+  step(state, DT);
+  assert.ok(state.ball.vy > 0, `vy should flip once: ${state.ball.vy}`);
+  assert.equal(state.ball.vx, 6, 'vx must stay untouched');
+});
+
+test('brick: two bricks on a vertical seam bounce exactly once', () => {
+  const bricks = [brickAt(), brickAt(100, 100 + BRICK_H + 8)];
+  const state = oneBrickState({ x: 94, y: 124, r: BALL_R, vx: 60, vy: 6 }, bricks);
+  step(state, DT);
+  assert.ok(state.ball.vx < 0, `vx should flip once: ${state.ball.vx}`);
+  assert.equal(state.ball.vy, 6, 'vy must stay untouched');
+});
+
+test('brick: fast ball does not tunnel through a brick', () => {
+  const state = createState(6);
+  const brick = brickAt();
+  state.bricks = [brick];
+  state.ball = { x: 136, y: 128, r: BALL_R, vx: 0, vy: -ballSpeed(6) };
+  step(state, DT_MAX);
+  assert.equal(brick.alive, false, 'the swept ball must destroy the brick');
+  assert.ok(state.ball.vy > 0, `the ball must bounce back down: ${state.ball.vy}`);
+});
+
