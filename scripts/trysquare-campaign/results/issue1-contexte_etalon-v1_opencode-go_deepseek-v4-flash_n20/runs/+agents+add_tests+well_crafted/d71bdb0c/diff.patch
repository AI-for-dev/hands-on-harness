+  const cx = brick.x + brick.w / 2;
+  state.ball = { x: cx, y: brick.y + 5, r: BALL_R, vx: 0, vy: 300, px: cx, py: brick.y - 40 };
+
+  const destroyed = resolveBrickHit(state);
+
+  assert.equal(destroyed, 1);
