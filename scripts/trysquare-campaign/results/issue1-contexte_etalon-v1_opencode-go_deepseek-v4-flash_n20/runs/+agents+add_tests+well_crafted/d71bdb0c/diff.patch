+// --- Issue #1: brick bounce -------------------------------------------------
+//
+// The ball must bounce off bricks like a real arcade game: per-face flips,
+// corner double flips, push-out (no sticky re-flip), exactly one bounce across
+// a seam, and a sweep so a fast ball cannot tunnel through a brick.
+
+// Bottom row / top-left corner of the grid: clean approach lanes with no
+// brick below (bottom row) or above (top row), so a single brick is hit.
+function bottomRowBricks(state, colIndex) {
+  return state.bricks.filter((b) => b.row === 4).sort((a, b) => a.x - b.x)[colIndex];
+}
+
+function topLeftBrick(state) {
+  return state.bricks.filter((b) => b.row === 0).sort((a, b) => a.x - b.x)[0];
+}
+
+test('#1 bottom face: a rising ball bounces down and is pushed below the brick', () => {
+  const state = createState(1);
+  const brick = bottomRowBricks(state, 0);
+  const cx = brick.x + brick.w / 2;
+  state.ball = { x: cx, y: brick.y + brick.h - 5, r: BALL_R, vx: 0, vy: -300, px: cx, py: brick.y + brick.h + 40 };
+
+  const destroyed = resolveBrickHit(state);
+
+  assert.equal(destroyed, 1);
+  assert.equal(brick.alive, false, 'the brick is destroyed');
+  assert.ok(state.ball.vy > 0, 'vy flips toward DOWN on a bottom-face hit');
+  assert.equal(state.ball.vx, 0, 'vx is left untouched');
+  assert.ok(state.ball.y >= brick.y + brick.h + BALL_R - 1e-9, 'the ball is pushed back below the brick');
+  assert.equal(collides(state.ball, brick), false, 'no overlap left for the next frame');
+});
+
+test('#1 top face: a falling ball bounces up and is pushed above the brick', () => {
+  const state = createState(1);
