+// --- Brick collision resolution (issue #1) --------------------------------
+
+// A ball hit is resolved on the axis of the SMALLEST penetration: that is the
+// face the ball actually crossed. A tie between a horizontal and a vertical
+// face means a corner hit — both components flip. Depths within EPS of the
+// minimum count as tied (float noise on an exact diagonal).
+const EPS = 1e-6;
+
+function penetrationFaces(cx, cy, r, brick) {
+  const depths = [
+    ['left', cx + r - brick.x],
+    ['right', brick.x + brick.w - (cx - r)],
+    ['top', cy + r - brick.y],
+    ['bottom', brick.y + brick.h - (cy - r)],
+  ];
+  const min = Math.min(...depths.map(([, d]) => d));
+  return depths.filter(([, d]) => d - min <= EPS).map(([name]) => name);
+}
+
+// Swept test: does the segment travelled by the ball's centre this step
+// (from (px,py) to (ball.x, ball.y)) cross the brick? The brick is inflated by
+// the ball radius (Minkowski sum), so a segment-vs-AABB test (slab method) is
+// enough. Returns the first contact as { t, x, y, face } or null:
+//   t    - contact time in [0,1]; 0 means the ball already overlapped
+//   x, y - ball centre at the contact
+//   face - faces hit (see penetrationFaces)
+// The sweep is what makes the detection tunnelling-proof: a fast ball whose
+// centre jumps OVER a brick still crosses the inflated rectangle.
+function sweptHit(px, py, ball, brick) {
+  const r = ball.r;
+  const minX = brick.x - r;
+  const maxX = brick.x + brick.w + r;
+  const minY = brick.y - r;
+  const maxY = brick.y + brick.h + r;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+
+  let tmin = 0;
+  let tmax = 1;
+
+  if (dx === 0) {
+    if (px < minX || px > maxX) return null;
+  } else {
+    let t1 = (minX - px) / dx;
+    let t2 = (maxX - px) / dx;
+    if (t1 > t2) [t1, t2] = [t2, t1];
+    tmin = Math.max(tmin, t1);
+    tmax = Math.min(tmax, t2);
+    if (tmin > tmax) return null;
+  }
+
+  if (dy === 0) {
+    if (py < minY || py > maxY) return null;
+  } else {
+    let t1 = (minY - py) / dy;
+    let t2 = (maxY - py) / dy;
+    if (t1 > t2) [t1, t2] = [t2, t1];
+    tmin = Math.max(tmin, t1);
+    tmax = Math.min(tmax, t2);
+    if (tmin > tmax) return null;
+  }
