+  const maxX = brick.x + brick.w + r;
+  const minY = brick.y - r;
+  const maxY = brick.y + brick.h + r;
+
+  let tEnterX, tExitX, sideX;
+  if (dx === 0) {
+    if (px <= minX || px >= maxX) return null; // never crosses the X slab
+    tEnterX = -Infinity;
+    tExitX = Infinity;
+    sideX = px - minX < maxX - px ? 'left' : 'right';
+  } else {
+    const t1 = (minX - px) / dx;
+    const t2 = (maxX - px) / dx;
+    tEnterX = Math.min(t1, t2);
+    tExitX = Math.max(t1, t2);
+    sideX = dx > 0 ? 'left' : 'right';
+  }
+
+  let tEnterY, tExitY, sideY;
+  if (dy === 0) {
+    if (py <= minY || py >= maxY) return null; // never crosses the Y slab
+    tEnterY = -Infinity;
+    tExitY = Infinity;
+    sideY = py - minY < maxY - py ? 'top' : 'bottom';
+  } else {
+    const t1 = (minY - py) / dy;
+    const t2 = (maxY - py) / dy;
+    tEnterY = Math.min(t1, t2);
+    tExitY = Math.max(t1, t2);
+    sideY = dy > 0 ? 'top' : 'bottom';
+  }
+
+  const tEnter = Math.max(tEnterX, tEnterY);
+  const tExit = Math.min(tExitX, tExitY);
+  if (tEnter > tExit || tExit <= 0 || tEnter > 1) return null;
+
+  let face;
+  if (tEnterX === -Infinity && tEnterY === -Infinity) {
+    // Ball did not move this step: fall back to the penetration rule.
+    const ox = Math.min(px - minX, maxX - px);
+    const oy = Math.min(py - minY, maxY - py);
+    face = Math.abs(ox - oy) < 1e-6 ? 'corner' : ox < oy ? 'x' : 'y';
+  } else if (Math.abs(tEnterX - tEnterY) < 1e-6) {
