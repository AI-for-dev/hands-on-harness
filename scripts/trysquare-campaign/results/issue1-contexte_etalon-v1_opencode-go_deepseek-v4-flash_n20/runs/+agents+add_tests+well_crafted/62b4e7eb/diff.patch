+// --- Issue #1: brick bounces -------------------------------------------------
+//
+// The ball must bounce off bricks the way it bounces off walls: per face (the
+// axis with the smaller penetration), both components on a corner, pushed back
+// out of the rectangle, exactly once when a grid seam overlaps two bricks, and
+// without tunnelling through a brick at high speed.
+
+function singleBrick() {
+  return [{ x: 100, y: 100, w: BRICK_W, h: BRICK_H, row: 0, alive: true, points: 10 }];
+}
+
+const DT = 1 / 60;
+
+function ballAt(x, y, vx, vy) {
+  return { x, y, r: BALL_R, vx, vy };
+}
+
+function place(state, ball, bricks) {
+  state.ball = ball;
+  state.bricks = bricks;
+  return state;
+}
+
+// Side hit: vx flips, vy untouched, ball pushed out sideways, brick broken.
+test('step: side hit flips vx only, pushes out, breaks the brick', () => {
+  const state = place(createState(1), ballAt(96, 110, 300, 30), singleBrick());
+  step(state, DT);
+  assert.ok(state.ball.vx < 0, `vx should have flipped left: ${state.ball.vx}`);
+  assert.ok(state.ball.vy > 0, `vy should stay untouched: ${state.ball.vy}`);
+  assert.ok(state.ball.x + BALL_R <= 100, `ball should be pushed out left: ${state.ball.x}`);
+  assert.equal(state.bricks[0].alive, false);
+});
+
+// Top-face hit: vy flips, vx untouched, ball pushed out above.
