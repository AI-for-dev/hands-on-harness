+// --- Issue #1: the ball bounces off bricks ----------------------------------
+//
+// The grid gap (8 px) is narrower than the ball (14 px): a seam overlaps two
+// bricks in the same pass, so the bounce must apply exactly once, and at level
+// 6 a stuttered frame jumps a whole brick — the detection must sweep the
+// travelled segment instead of sampling its two ends.
+
+// A canvas context that swallows every draw call: frame() only renders, the
+// assertions below only read `state`.
+function fakeCtx() {
+  const nothing = () => {};
+  return new Proxy(
+    {},
+    {
+      get: (_, key) => (key === 'canvas' ? { width: WIDTH, height: 1 } : nothing),
+      set: () => true,
+    },
+  );
+}
+
+function oneBrick(overrides = {}) {
+  return { x: 100, y: 100, w: 72, h: 20, row: 0, alive: true, points: 10, ...overrides };
+}
+
+test('bricks: side hit flips vx and leaves vy alone', () => {
+  const state = createState(1);
+  state.bricks = [oneBrick()];
+  state.ball = { x: 96, y: 110, r: 7, vx: 300, vy: 30 };
+  frame(fakeCtx(), state);
+  assert.ok(state.ball.vx < 0, 'horizontal velocity should flip to the left');
+  assert.ok(state.ball.vy > 0, 'vertical velocity should be untouched');
+  assert.equal(state.ball.x + state.ball.r, 100, 'ball pushed back out to the left face');
+});
+
+test('bricks: top/bottom hit flips vy and leaves vx alone', () => {
+  const state = createState(1);
+  state.bricks = [oneBrick()];
+  state.ball = { x: 136, y: 124, r: 7, vx: 30, vy: -300 };
+  frame(fakeCtx(), state);
+  assert.ok(state.ball.vy > 0, 'vertical velocity should flip downward');
+  assert.ok(state.ball.vx > 0, 'horizontal velocity should be untouched');
+  assert.equal(state.ball.y - state.ball.r, 120, 'ball pushed back out to the bottom face');
+});
+
+test('bricks: corner hit flips both components', () => {
+  const state = createState(1);
+  state.bricks = [oneBrick()];
+  state.ball = { x: 96, y: 96, r: 7, vx: 300, vy: 300 };
+  frame(fakeCtx(), state);
+  assert.ok(state.ball.vx < 0, 'vx should flip on a diagonal hit');
+  assert.ok(state.ball.vy < 0, 'vy should flip on a diagonal hit');
+});
+
+test('bricks: the ball never stays inside a brick (sticky bounce)', () => {
+  const state = createState(1);
+  state.bricks = [oneBrick()];
+  state.ball = { x: 96, y: 110, r: 7, vx: 300, vy: 30 };
+  frame(fakeCtx(), state);
+  assert.equal(collides(state.ball, state.bricks[0]), false);
+  assert.equal(state.bricks[0].alive, false);
+});
+
+test('bricks: two bricks on a horizontal seam bounce the ball exactly once', () => {
+  const state = createState(1);
+  state.bricks = [oneBrick(), oneBrick({ x: 180 })];
+  state.ball = { x: 176, y: 126, r: 7, vx: 6, vy: -60 };
+  frame(fakeCtx(), state);
+  assert.ok(state.ball.vy > 0, 'a double `vy = -vy` would cancel and plow through');
+  assert.ok(state.ball.vx > 0, 'vx should stay untouched');
+  assert.equal(state.bricks.every((b) => !b.alive), true);
+});
+
+test('bricks: a fast ball does not tunnel through a brick', () => {
+  const state = createState(6);
+  state.bricks = [oneBrick()];
+  // Below the brick before the move, entirely above it after: a position-only
+  // check never sees the overlap. 50 ms at ballSpeed(6) = 710 px/s is a
+  // 35.5 px jump against the 34 px needed to cross a brick.
+  state.ball = { x: 136, y: 128, r: 7, vx: 0, vy: -ballSpeed(6) };
+  step(state, 0.05);
+  frame(fakeCtx(), state);
+  assert.equal(state.bricks[0].alive, false, 'the brick must be destroyed');
+  assert.ok(state.ball.vy > 0, 'the ball must be bounced back downward');
+});
+
