+// --- Brick bounce resolution (issue #1) -------------------------------------
+
+// Liang-Barsky slab clip: the t-interval of the segment p -> p + t*d (t in
+// [0,1]) that lies inside the slab [lo,hi], or null when the segment never
+// enters it. The basis of the anti-tunnelling sweep below.
+function slabRange(p, d, lo, hi) {
+  if (d === 0) return p > lo && p < hi ? [0, 1] : null;
+  let a = (lo - p) / d;
+  let b = (hi - p) / d;
+  if (a > b) {
+    const t = a;
+    a = b;
+    b = t;
+  }
+  if (b < 0 || a > 1) return null;
+  return [Math.max(a, 0), Math.min(b, 1)];
+}
+
+// True when the ball's disc would touch the brick somewhere along the segment
+// its centre travels this frame (from (px,py) to (ball.x, ball.y)).
+// Position-only detection samples the two ends of the move; at level 6 a
+// stuttered frame moves 35.5 px against the 34 px needed to cross a brick, so
+// the ends can both be clear while the middle overlaps (#1, tunnelling).
+function sweepsInto(ball, brick, px, py) {
+  if (ball.x === px && ball.y === py) return false;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+  const tx = slabRange(px, dx, brick.x - ball.r, brick.x + brick.w + ball.r);
+  if (!tx) return false;
+  const ty = slabRange(py, dy, brick.y - ball.r, brick.y + brick.h + ball.r);
+  if (!ty) return false;
+  return tx[0] <= ty[1] && ty[0] <= tx[1];
+}
+
+// Resolves the ball against every live brick it touches this frame (issue #1).
+// Guarantees:
+//   - every touched brick is destroyed and scored;
+//   - the bounce applies exactly once per axis: the face with the smallest
+//     penetration decides the flip (both flip on a corner), aggregated over
+//     the whole overlapping group — the grid gap (8 px) is narrower than the
+//     ball (14 px), so a seam overlaps two bricks in the same pass and a
+//     naive `vy = -vy` per brick would cancel out;
+//   - the ball is pushed back out of the brick rectangle, so the next frame
+//     cannot re-trigger the same bounce (sticky bounce);
+//   - a brick crossed entirely between two positions (tunnelling) is caught
+//     by the sweep and bounces the ball back the way it came.
+function resolveBricks(state) {
+  const { ball, bricks } = state;
+  const prevX = ball.px ?? ball.x;
+  const prevY = ball.py ?? ball.y;
+
+  // One pass over the grid: bricks the ball currently overlaps, and bricks it
+  // crossed at speed this frame.
+  const overlap = [];
+  const swept = [];
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    if (collides(ball, brick)) overlap.push(brick);
+    else if (sweepsInto(ball, brick, prevX, prevY)) swept.push(brick);
+  }
+  const hits = overlap.concat(swept);
+  if (hits.length === 0) return;
+
+  for (const brick of hits) {
+    brick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(brick, state.combo);
+  }
+
+  if (overlap.length > 0) {
+    // The ball stopped inside at least one brick: the hit face is the one
+    // with the smallest penetration over the whole overlapping group.
+    let nearLeft = Infinity;
+    let nearRight = Infinity;
+    let nearTop = Infinity;
+    let nearBottom = Infinity;
+    let boxX0 = Infinity;
+    let boxY0 = Infinity;
+    let boxX1 = -Infinity;
+    let boxY1 = -Infinity;
+    for (const brick of overlap) {
+      nearLeft = Math.min(nearLeft, ball.x + ball.r - brick.x);
+      nearRight = Math.min(nearRight, brick.x + brick.w - (ball.x - ball.r));
+      nearTop = Math.min(nearTop, ball.y + ball.r - brick.y);
+      nearBottom = Math.min(nearBottom, brick.y + brick.h - (ball.y - ball.r));
+      boxX0 = Math.min(boxX0, brick.x);
+      boxY0 = Math.min(boxY0, brick.y);
+      boxX1 = Math.max(boxX1, brick.x + brick.w);
+      boxY1 = Math.max(boxY1, brick.y + brick.h);
+    }
+    const penX = Math.min(nearLeft, nearRight);
+    const penY = Math.min(nearTop, nearBottom);
+
+    if (Math.abs(penX - penY) < 1e-9) {
+      // Equal penetrations: diagonal hit — flip both, push out on both axes.
+      ball.vx = -ball.vx;
+      ball.vy = -ball.vy;
+      ball.x = nearLeft <= nearRight ? boxX0 - ball.r : boxX1 + ball.r;
+      ball.y = nearTop <= nearBottom ? boxY0 - ball.r : boxY1 + ball.r;
+    } else if (penX < penY) {
+      // Side hit: flip vx only, leave vy alone, push out along x.
+      ball.vx = -ball.vx;
+      ball.x = nearLeft <= nearRight ? boxX0 - ball.r : boxX1 + ball.r;
+    } else {
+      // Top/bottom hit: flip vy only, leave vx alone, push out along y.
+      ball.vy = -ball.vy;
+      ball.y = nearTop <= nearBottom ? boxY0 - ball.r : boxY1 + ball.r;
+    }
+    return;
+  }
+
+  // Sweep-only hit: the ball crossed the brick entirely this frame. Bounce
+  // along the dominant travel axis and push it back to the side it came from.
+  let boxX0 = Infinity;
+  let boxY0 = Infinity;
+  let boxX1 = -Infinity;
+  let boxY1 = -Infinity;
+  for (const brick of swept) {
+    boxX0 = Math.min(boxX0, brick.x);
+    boxY0 = Math.min(boxY0, brick.y);
+    boxX1 = Math.max(boxX1, brick.x + brick.w);
+    boxY1 = Math.max(boxY1, brick.y + brick.h);
+  }
+  const dx = ball.x - prevX;
+  const dy = ball.y - prevY;
+  if (Math.abs(dx) > Math.abs(dy)) {
+    ball.vx = -ball.vx;
+    ball.x = prevX < boxX0 ? boxX0 - ball.r : boxX1 + ball.r;
+  } else if (Math.abs(dy) > Math.abs(dx)) {
+    ball.vy = -ball.vy;
+    ball.y = prevY < boxY0 ? boxY0 - ball.r : boxY1 + ball.r;
+  } else {
+    // Perfect diagonal crossing: both axes.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    if (prevX < boxX0) ball.x = boxX0 - ball.r;
+    else ball.x = boxX1 + ball.r;
+    if (prevY < boxY0) ball.y = boxY0 - ball.r;
+    else ball.y = boxY1 + ball.r;
+  }
+}
