+  // The ball is already inside a brick: classic per-face bounce.
+  const overlapping = bricks.filter((b) => b.alive && collides(ball, b));
+  if (overlapping.length > 0) {
+    for (const brick of overlapping) brick.alive = false;
+    resolveOverlap(ball, overlapping);
+    return overlapping;
+  }
+
+  // The ball jumped over a brick between the two samples: sweep the segment.
+  const swept = [];
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    const hit = sweptHit(ball, brick, prevX, prevY);
+    if (hit) swept.push({ brick, ...hit });
+  }
+  if (swept.length === 0) return [];
+  swept.sort((a, b) => a.t - b.t);
+  for (const s of swept) s.brick.alive = false;
+  resolveSweep(ball, swept);
+  return swept.map((s) => s.brick);
+}
