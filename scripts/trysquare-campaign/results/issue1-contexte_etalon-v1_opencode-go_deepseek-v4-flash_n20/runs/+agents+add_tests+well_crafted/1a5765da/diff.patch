+// Pure brick collision. Destroys every brick the ball touched during the step
+// that took it from (prevX, prevY) to its current position and bounces the
+// ball exactly once, either against the face it currently overlaps (smallest
+// penetration wins, both axes on a diagonal corner) or against the face it
+// crossed on the way (tunnelling sweep). `prevX`/`prevY` are read from the
+// ball when present (step() records them); without them the sweep collapses to
+// the current position.
+//
+// Returns the destroyed bricks.
+export function brickHit(ball, bricks) {
+  const prevX = Number.isFinite(ball.prevX) ? ball.prevX : ball.x;
+  const prevY = Number.isFinite(ball.prevY) ? ball.prevY : ball.y;
