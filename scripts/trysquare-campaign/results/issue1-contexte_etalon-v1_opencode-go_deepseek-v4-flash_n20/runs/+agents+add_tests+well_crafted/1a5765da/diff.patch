+// --- Issue #1: brick bounces ------------------------------------------------
+//
+// Per-face bounce (the axis with the smaller penetration is the face hit),
+// diagonal corner (both axes), push-out (no sticky bounce), seam between two
+// bricks (bounce applied exactly once) and tunnelling sweep (fast ball).
+
+function oneBrick(x = 100, y = 100, w = BRICK_W, h = BRICK_H) {
+  return { x, y, w, h, row: 0, alive: true, points: 10 };
+}
+
+test('brickHit: top face flips vy only and pushes the ball out', () => {
+  const ball = { x: 136, y: 96, r: BALL_R, vx: 30, vy: 300 };
+  const brick = oneBrick();
+  brickHit(ball, [brick]);
+  assert.ok(ball.vy < 0, 'vy should flip toward the ceiling');
+  assert.equal(ball.vx, 30, 'vx must be left untouched');
+  assert.ok(ball.y + BALL_R <= brick.y, 'ball pushed back out above the brick');
+  assert.equal(brick.alive, false);
+});
+
+test('brickHit: bottom face flips vy only and pushes the ball out', () => {
+  const ball = { x: 136, y: 124, r: BALL_R, vx: 30, vy: -300 };
+  const brick = oneBrick();
+  brickHit(ball, [brick]);
+  assert.ok(ball.vy > 0, 'vy should flip toward the paddle');
+  assert.equal(ball.vx, 30, 'vx must be left untouched');
+  assert.ok(ball.y - BALL_R >= brick.y + brick.h, 'ball pushed back out below the brick');
+});
+
+test('brickHit: side hit flips vx only and pushes the ball out', () => {
+  const ball = { x: 96, y: 110, r: BALL_R, vx: 300, vy: 30 };
+  const brick = oneBrick();
+  brickHit(ball, [brick]);
+  assert.ok(ball.vx < 0, 'vx should flip to the left');
+  assert.equal(ball.vy, 30, 'vy must be left untouched');
+  assert.ok(ball.x + BALL_R <= brick.x, 'ball pushed back out to the left');
+});
+
+test('brickHit: diagonal corner flips both components', () => {
+  const ball = { x: 96, y: 96, r: BALL_R, vx: 300, vy: 300 };
+  const brick = oneBrick();
+  brickHit(ball, [brick]);
+  assert.ok(ball.vx < 0 && ball.vy < 0, 'both components should flip');
+  assert.ok(ball.x + BALL_R <= brick.x && ball.y + BALL_R <= brick.y, 'ball pushed out of the corner');
+});
+
+test('brickHit: a seam between two bricks bounces exactly once', () => {
+  // Ball centered on the horizontal seam between two side-by-side bricks:
+  // it overlaps both in the same pass and vy must flip a single time.
+  const bricks = [
+    oneBrick(100, 100),
+    oneBrick(100 + BRICK_W + BRICK_GAP, 100),
+  ];
+  const ball = { x: 176, y: 126, r: BALL_R, vx: 6, vy: -60 };
+  brickHit(ball, bricks);
+  assert.ok(ball.vy > 0, 'vy flipped exactly once');
+  assert.ok(ball.vx > 0, 'vx must be left untouched');
+  assert.ok(bricks.every((b) => !b.alive), 'both seam bricks destroyed');
+});
+
+test('brickHit: a fast ball cannot tunnel through a brick', () => {
+  // ballSpeed(6) = 710 px/s over the 50 ms cap: a 35.5 px jump across a
+  // 34 px brick. Only the sweep between the two positions catches it.
+  const state = createState(6);
+  const brick = oneBrick();
+  state.bricks = [brick];
+  state.ball = { x: 136, y: 128, r: BALL_R, vx: 0, vy: -ballSpeed(6) };
+  step(state, 0.05);
+  assert.equal(brick.alive, false, 'the brick must not survive being crossed');
+  assert.ok(state.ball.vy > 0, 'the ball should bounce back down');
+});
