+// --- Brick collision & bounce (issue #1) -----------------------------------
+
+// How deep the ball sits inside each of the brick's four faces. Each value is
+// the penetration of the ball's edge past the opposite face of the brick.
+function penetration(ball, brick) {
+  return {
+    left: ball.x + ball.r - brick.x, // ball right edge past the brick left edge
+    right: brick.x + brick.w - (ball.x - ball.r), // ball left edge past the brick right edge
+    top: ball.y + ball.r - brick.y, // ball bottom edge past the brick top edge
+    bottom: brick.y + brick.h - (ball.y - ball.r), // ball top edge past the brick bottom edge
+  };
+}
+
+// The t-interval over which `prev + delta * t` (t in [0, 1]) stays inside
+// [lo, hi], or null when it never does. Used to sweep the ball's path.
+function axisInterval(prev, delta, lo, hi) {
+  if (delta === 0) {
+    return prev >= lo && prev <= hi ? [0, 1] : null;
+  }
+  let a = (lo - prev) / delta;
+  let b = (hi - prev) / delta;
+  if (a > b) [a, b] = [b, a];
+  return [a, b];
+}
+
+// Sweeps the ball (as its bounding box, like collides) along the segment from
+// (prevX, prevY) to its current position and returns the earliest moment it
+// overlaps `brick`, or null. The `axis` is the one whose range the ball
+// entered last — that's the face it hit. A hit is only real if the ball
+// strictly penetrates somewhere inside the overlap interval: a path that
+// merely grazes the brick's edge (zero-width overlap, e.g. sliding along a
+// face) must not bounce.
+function sweptHit(ball, brick, prevX, prevY) {
+  const dx = ball.x - prevX;
+  const dy = ball.y - prevY;
+  const ix = axisInterval(prevX, dx, brick.x - ball.r, brick.x + brick.w + ball.r);
+  const iy = axisInterval(prevY, dy, brick.y - ball.r, brick.y + brick.h + ball.r);
+  if (!ix || !iy) return null;
+  const tIn = Math.max(ix[0], iy[0]);
+  const tOut = Math.min(ix[1], iy[1]);
+  if (tIn >= tOut || tOut < 0 || tIn > 1) return null;
+
+  // Confirm a strict overlap at the middle of the overlap interval: this
+  // rejects degenerate contacts that stay glued to a face or a corner.
+  const mid = (tIn + tOut) / 2;
+  const x = prevX + dx * mid;
+  const y = prevY + dy * mid;
+  if (!collides({ x, y, r: ball.r }, brick)) return null;
+
+  const axis = Math.abs(ix[0] - iy[0]) < EPS ? 'both' : ix[0] > iy[0] ? 'x' : 'y';
+  return { t: Math.max(0, tIn), axis };
+}
+
+// Bounces a ball that is already inside one or more bricks. The face hit is
+// the one with the smallest penetration; a tie (diagonal arrival) bounces both
+// axes. The ball is pushed back out along the bounce axis beyond EVERY brick
+// it overlaps: the 8 px grid gap is narrower than the 14 px ball, so a seam
+// overlaps two bricks in the same pass and the bounce must apply exactly once.
+function resolveOverlap(ball, bricks) {
+  let chosen = null;
+  let best = Infinity;
+  for (const brick of bricks) {
+    const p = penetration(ball, brick);
+    const penX = Math.min(p.left, p.right);
+    const penY = Math.min(p.top, p.bottom);
+    const min = Math.min(penX, penY);
+    if (min < best) {
+      best = min;
+      chosen = { brick, p, penX, penY };
+    }
+  }
+  const { p, penX, penY } = chosen;
