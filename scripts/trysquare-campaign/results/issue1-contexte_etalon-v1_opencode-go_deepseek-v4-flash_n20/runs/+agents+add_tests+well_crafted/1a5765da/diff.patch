+// brick of the pass so the next frame cannot re-flip.
+function resolveSweep(ball, hits) {
+  const first = hits[0];
+  const xs = hits.map((h) => h.brick.x);
+  const xe = hits.map((h) => h.brick.x + h.brick.w);
+  const ys = hits.map((h) => h.brick.y);
+  const ye = hits.map((h) => h.brick.y + h.brick.h);
+
+  if (first.axis === 'x') {
+    ball.vx = -ball.vx;
+    ball.x = ball.vx > 0 ? Math.max(...xe) + ball.r : Math.min(...xs) - ball.r;
+  } else if (first.axis === 'y') {
+    ball.vy = -ball.vy;
+    ball.y = ball.vy > 0 ? Math.max(...ye) + ball.r : Math.min(...ys) - ball.r;
+  } else {
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x = ball.vx > 0 ? Math.max(...xe) + ball.r : Math.min(...xs) - ball.r;
+    ball.y = ball.vy > 0 ? Math.max(...ye) + ball.r : Math.min(...ys) - ball.r;
+  }
+}
