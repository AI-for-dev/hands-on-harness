+    ball.y = p.top < p.bottom
+      ? Math.min(...bricks.map((b) => b.y)) - ball.r
+      : Math.max(...bricks.map((b) => b.y + b.h)) + ball.r;
+  } else {
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x = p.left <= p.right
+      ? Math.min(...bricks.map((b) => b.x)) - ball.r
+      : Math.max(...bricks.map((b) => b.x + b.w)) + ball.r;
+    ball.y = p.top <= p.bottom
+      ? Math.min(...bricks.map((b) => b.y)) - ball.r
+      : Math.max(...bricks.map((b) => b.y + b.h)) + ball.r;
+  }
+}
+
+// Bounces a fast ball that crossed bricks between two sampled positions.
