+// --- Brick bounce (issue #1) -----------------------------------------------
+
+// Tolerance for comparing penetrations: below this, the two axes are
+// considered equally penetrated (a corner hit).
+const PEN_EPS = 1e-9;
+
+// Overlap depth on the x and y axes (ball box vs brick box). Always >= 0.
+function penetration(ball, brick) {
+  const penX =
+    Math.min(ball.x + ball.r, brick.x + brick.w) - Math.max(ball.x - ball.r, brick.x);
+  const penY =
+    Math.min(ball.y + ball.r, brick.y + brick.h) - Math.max(ball.y - ball.r, brick.y);
+  return { penX: Math.max(0, penX), penY: Math.max(0, penY) };
+}
+
+// Reposition the ball so it no longer overlaps the brick along x.
+// If the centre is inside the brick's span, push it out the nearer side.
+function pushOutX(ball, brick) {
+  if (ball.x < brick.x) ball.x = brick.x - ball.r;
+  else if (ball.x > brick.x + brick.w) ball.x = brick.x + brick.w + ball.r;
+  else ball.x = ball.x < brick.x + brick.w / 2 ? brick.x - ball.r : brick.x + brick.w + ball.r;
+}
+
+// Same as pushOutX, along y.
+function pushOutY(ball, brick) {
+  if (ball.y < brick.y) ball.y = brick.y - ball.r;
+  else if (ball.y > brick.y + brick.h) ball.y = brick.y + brick.h + ball.r;
+  else ball.y = ball.y < brick.y + brick.h / 2 ? brick.y - ball.r : brick.y + brick.h + ball.r;
+}
+
+// Bounce the ball off the brick. The face hit is the axis with the smaller
+// penetration: flip that component only and push the ball back out; equal
+// penetration on both axes means a corner hit, so flip both.
+function bounceBall(ball, brick) {
+  const { penX, penY } = penetration(ball, brick);
+
+  if (Math.abs(penX - penY) <= PEN_EPS) {
+    // Corner: diagonal hit, flip both components.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    pushOutX(ball, brick);
+    pushOutY(ball, brick);
+  } else if (penX < penY) {
+    // Side hit: flip horizontal, leave vertical exactly as it was.
+    ball.vx = -ball.vx;
+    pushOutX(ball, brick);
+  } else {
