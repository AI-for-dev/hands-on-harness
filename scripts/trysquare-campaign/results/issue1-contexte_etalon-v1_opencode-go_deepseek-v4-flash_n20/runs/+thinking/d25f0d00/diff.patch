+// Applies a single bounce against one overlapping brick: the axis with the
+// smaller penetration is the face that was hit (both on a corner hit). The
+// ball is pushed back OUT of the brick, otherwise it still overlaps on the
+// next frame and re-flips forever (sticky bounce). If the ball is moving away
+// from the shallowest face (it is leaving the brick through a seam), fall
+// through to the other axis instead of letting it pass unchecked.
+function bounceOffBrick(ball, brick) {
+  const penLeft = ball.x + ball.r - brick.x;
+  const penRight = brick.x + brick.w - (ball.x - ball.r);
+  const penTop = ball.y + ball.r - brick.y;
+  const penBottom = brick.y + brick.h - (ball.y - ball.r);
+
+  const penX = Math.min(penLeft, penRight);
+  const penY = Math.min(penTop, penBottom);
+
+  let bounced = false;
+  if (penX < penY) {
+    bounced = bounceAxisX(ball, brick, penLeft, penRight);
+    if (!bounced) bounced = bounceAxisY(ball, brick, penTop, penBottom);
+  } else if (penY < penX) {
+    bounced = bounceAxisY(ball, brick, penTop, penBottom);
+    if (!bounced) bounced = bounceAxisX(ball, brick, penLeft, penRight);
+  } else {
+    // Corner: equal penetrations mean a diagonal hit — flip both components.
+    bounced = bounceAxisX(ball, brick, penLeft, penRight);
+    if (bounceAxisY(ball, brick, penTop, penBottom)) bounced = true;
