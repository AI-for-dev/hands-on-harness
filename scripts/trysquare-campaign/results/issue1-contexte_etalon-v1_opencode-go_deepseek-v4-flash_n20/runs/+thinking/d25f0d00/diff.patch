+// True if the ball swept from (prevX, prevY) to its CURRENT position crossed
+// the brick's box grown by the ball radius. Returns { axis, tEnter } (the
+// face axis hit first and when, in 0..1) or null when the path misses.
+// This catches tunnelling: at level 6 the ball moves up to 35.5 px per frame
+// against a 34 px brick+ball thickness, so it can jump over a brick without
+// ever overlapping it (a discrete test at the two endpoints sees nothing).
+export function sweepHitsBrick(prevX, prevY, ball, brick) {
+  const minX = brick.x - ball.r;
+  const maxX = brick.x + brick.w + ball.r;
+  const minY = brick.y - ball.r;
+  const maxY = brick.y + brick.h + ball.r;
+
+  const dx = ball.x - prevX;
+  const dy = ball.y - prevY;
+
+  // Slab method: find the t-interval of the move spent inside each axis
+  // slab; the intersection of both intervals is the time inside the box.
+  let tEnter = 0;
+  let tExit = 1;
+  let axis = null;
+
+  if (dx === 0) {
+    if (prevX <= minX || prevX >= maxX) return null;
+  } else {
+    let t1 = (minX - prevX) / dx;
+    let t2 = (maxX - prevX) / dx;
+    if (t1 > t2) [t1, t2] = [t2, t1];
+    if (t1 > tEnter) {
+      tEnter = t1;
+      axis = 'x';
+    }
+    if (t2 < tExit) tExit = t2;
+    if (tEnter > tExit) return null;
+  }
+
+  if (dy === 0) {
+    if (prevY <= minY || prevY >= maxY) return null;
+  } else {
+    let t1 = (minY - prevY) / dy;
+    let t2 = (maxY - prevY) / dy;
+    if (t1 > t2) [t1, t2] = [t2, t1];
+    if (t1 > tEnter) {
+      tEnter = t1;
+      axis = 'y';
+    }
+    if (t2 < tExit) tExit = t2;
+    if (tEnter > tExit) return null;
+  }
+
+  // The crossing must happen strictly inside the move: a path that only
+  // touches the box at its endpoints, or starts inside it, is the per-frame
+  // overlap case handled by `collides()` instead. Starting inside means the
+  // entry axis was never recorded (axis stays null) — not a clean crossing.
+  if (axis === null || tEnter >= 1 || tExit <= 0) return null;
+  return { axis, tEnter };
+}
+
+// Bounces on X if the ball is moving INTO the face it overlaps. The
+// direction check is what makes the bounce idempotent: a seam overlapping two
+// bricks in the same pass cannot flip the same component twice (vy = -vy
+// twice cancels out and the ball would go straight through). Returns true
+// when a bounce was applied.
+function bounceAxisX(ball, brick, penLeft, penRight) {
+  if (penLeft <= penRight) {
+    // Near the brick's left face.
+    if (ball.vx > 0) {
+      ball.vx = -Math.abs(ball.vx);
+      ball.x = brick.x - ball.r;
+      return true;
+    }
+  } else if (ball.vx < 0) {
+    // Near the brick's right face.
+    ball.vx = Math.abs(ball.vx);
+    ball.x = brick.x + brick.w + ball.r;
+    return true;
+  }
+  return false;
+}
+
+function bounceAxisY(ball, brick, penTop, penBottom) {
+  if (penTop <= penBottom) {
+    // Near the brick's top face.
+    if (ball.vy > 0) {
+      ball.vy = -Math.abs(ball.vy);
+      ball.y = brick.y - ball.r;
+      return true;
+    }
+  } else if (ball.vy < 0) {
+    // Near the brick's bottom face.
+    ball.vy = Math.abs(ball.vy);
