+        broken.push(brick);
+        if (!firstSwept || hit.tEnter < firstSwept.tEnter) {
+          firstSwept = { brick, tEnter: hit.tEnter, axis: hit.axis };
+        }
+      }
+    }
+  }
+
+  if (best) {
+    bounceOffBrick(ball, best);
+  } else if (firstSwept) {
+    bounceSwept(ball, firstSwept.brick, firstSwept.axis);
+  }
+
+  return broken;
+}
