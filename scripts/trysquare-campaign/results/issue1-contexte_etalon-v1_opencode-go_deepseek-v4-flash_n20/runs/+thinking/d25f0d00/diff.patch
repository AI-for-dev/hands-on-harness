+// Resolves the ball against every brick for one frame (pure, tested).
+//  1. Breaks every brick the ball touches, whether by final overlap or by a
+//     sweep across the move (tunnelling).
+//  2. Applies the bounce EXACTLY ONCE, on the brick with the smallest
+//     penetration (the face most decisively hit), so a seam overlapping two
+//     bricks in the same pass cannot flip the same component twice.
+// Returns the bricks broken this pass, in grid order (the caller scores them
+// per brick, as the old per-brick loop did).
+export function brickHit(prevX, prevY, ball, bricks) {
+  const broken = [];
+  let best = null; // overlapping brick with the smallest penetration
+  let bestPen = Infinity;
+  let firstSwept = null; // brick crossed first by the sweep
+
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
