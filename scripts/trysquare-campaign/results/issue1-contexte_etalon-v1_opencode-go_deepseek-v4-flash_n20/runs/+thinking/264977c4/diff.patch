+// --- #1: brick bounce ------------------------------------------------------
+// Each case from ISSUES.md #1: per-face bounce, corner, push-out, neighbours
+// (bounce exactly once) and tunnelling (sweep between two positions).
+
+const brickA = { x: 100, y: 100, w: 72, h: 20, row: 0, alive: true };
+
+test('brickHit: top face — flips vy, leaves vx, pushes the ball out above', () => {
+  const ball = { x: 130, y: 102, r: 7, vx: 40, vy: -300 }; // bottom edge inside the brick top
+  const hit = brickHit(ball, [brickA]);
+  assert.equal(hit, brickA);
+  assert.equal(ball.vy, 300, 'vertical component flips');
+  assert.equal(ball.vx, 40, 'horizontal component untouched');
+  assert.equal(ball.y, 100 - 7, 'pushed out so the bottom edge rests on the brick top');
+});
+
+test('brickHit: bottom face — flips vy, pushes the ball out below', () => {
+  const ball = { x: 130, y: 118, r: 7, vx: -30, vy: -300 }; // top edge inside the brick bottom
+  const hit = brickHit(ball, [brickA]);
+  assert.equal(hit, brickA);
+  assert.equal(ball.vy, 300);
+  assert.equal(ball.vx, -30, 'horizontal component untouched');
+  assert.equal(ball.y, 100 + 20 + 7, 'pushed out below the brick');
