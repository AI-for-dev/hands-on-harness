+// Bounces the ball off ONE brick and pushes it back out (ISSUES.md #1).
+//
+// - per face: the axis with the SMALLER penetration is the face that was hit;
+//   a top/bottom hit flips `vy`, a side hit flips `vx`, and the other
+//   component is left exactly as it was;
+// - corner: equal penetrations mean a diagonal hit — both components flip;
+// - push out: the ball is repositioned outside the brick rectangle, otherwise
+//   it still overlaps on the next frame and re-flips forever (sticky bounce).
+//
+// Must be called at most once per frame (see `brickHit`): a seam overlaps two
+// bricks in the same pass, and flipping `vy` twice cancels out — the ball
+// would sail straight through.
+function bounceOffBrick(ball, brick) {
+  const overlapX = Math.min(
+    ball.x + ball.r - brick.x,
+    brick.x + brick.w - (ball.x - ball.r),
+  );
+  const overlapY = Math.min(
+    ball.y + ball.r - brick.y,
+    brick.y + brick.h - (ball.y - ball.r),
+  );
+
+  if (overlapX < overlapY) {
+    // Side hit: flip vx. Push out on the side the ball came from (its
+    // velocity before the flip), falling back to the nearer face when the
+    // ball has no horizontal motion: pushing "away from the centre" alone is
+    // ambiguous in a seam and would shove the ball into the neighbour.
+    const moving = Math.sign(ball.vx);
+    ball.vx = -ball.vx;
+    if (moving > 0 || (moving === 0 && ball.x < brick.x + brick.w / 2)) {
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+    }
+  } else if (overlapY < overlapX) {
+    // Top or bottom hit: flip vy. Same rule as the side hit, on the y axis.
+    const moving = Math.sign(ball.vy);
+    ball.vy = -ball.vy;
+    if (moving > 0 || (moving === 0 && ball.y < brick.y + brick.h / 2)) {
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  } else {
+    // Corner: equal penetration, flip both and push out diagonally.
+    const moveX = Math.sign(ball.vx);
+    const moveY = Math.sign(ball.vy);
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    if (moveX > 0 || (moveX === 0 && ball.x < brick.x + brick.w / 2)) {
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+    }
+    if (moveY > 0 || (moveY === 0 && ball.y < brick.y + brick.h / 2)) {
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  }
+}
