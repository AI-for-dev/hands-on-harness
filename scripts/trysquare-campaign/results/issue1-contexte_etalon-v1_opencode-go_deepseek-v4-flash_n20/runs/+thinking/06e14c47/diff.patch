+// Finds and resolves the ball's collision with the brick wall (ISSUES.md #1).
+//
+// - tunnelling: the ball's path since the previous frame (recorded as
+//   `px`/`py` by `step()`) is swept in samples small enough that a full-speed
+//   ball cannot jump over a brick between two samples;
+// - neighbours: the bounce is applied to exactly ONE brick (the first one hit
+//   along the path), so a seam that overlaps two bricks cannot double-flip.
+//
+// Returns the brick that was hit (now dead), or `null` when nothing was hit.
+export function brickHit(ball, bricks) {
+  const px = ball.px ?? ball.x;
+  const py = ball.py ?? ball.y;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+  // Max distance between two samples: BRICK_H (20 px) is smaller than the
+  // 34 px a full-speed ball needs to cross a brick (BRICK_H + diameter), so
+  // at least one sample always lands inside a brick the path crosses.
+  const samples = Math.max(1, Math.ceil(Math.hypot(dx, dy) / BRICK_H));
+
+  for (let i = 0; i <= samples; i++) {
+    const t = i / samples;
+    const probe = { x: px + dx * t, y: py + dy * t, r: ball.r };
+    for (const brick of bricks) {
+      if (!brick.alive) continue;
+      if (collides(probe, brick)) {
+        ball.x = probe.x;
+        ball.y = probe.y;
+        bounceOffBrick(ball, brick);
+        brick.alive = false;
+        return brick;
+      }
+    }
+  }
+  return null;
+}
