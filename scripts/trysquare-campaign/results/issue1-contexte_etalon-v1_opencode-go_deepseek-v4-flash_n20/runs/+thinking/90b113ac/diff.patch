+  assert.equal(hits.length, 2, 'both bricks are overlapped in the same pass');
+  assert.equal(ball.vy, 300, 'vy flipped exactly once, not twice');
+  assert.equal(ball.vx, 0);
+  assert.ok(ball.y >= 48 + 20 + ball.r, 'pushed below the whole row');
+  assert.equal(collides(ball, brickA), false);
+  assert.equal(collides(ball, brickB), false);
+});
+
+test('brickHit: fast ball cannot tunnel through a brick', () => {
+  // Level 6 ball speed (710 px/s) on a 50 ms frame covers ~35 px, more than
