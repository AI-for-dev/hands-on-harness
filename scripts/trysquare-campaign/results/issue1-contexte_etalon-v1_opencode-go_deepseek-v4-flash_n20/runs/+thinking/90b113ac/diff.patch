+// --- Issue #1: brick bounce -------------------------------------------------
+// The ball must bounce off bricks (per-face), be pushed out of the brick,
+// bounce exactly once when it straddles a seam, and not tunnel through a
+// brick at high speed (sweep between the previous and current position).
+
+function liveBrick(x, y, w = 40, h = 20) {
+  return { x, y, w, h, alive: true };
+}
+
+// Ball helper: sets the previous position the sweep should start from.
+function ballAt(x, y, vx, vy, px, py) {
+  return { x, y, r: 7, vx, vy, prevX: px, prevY: py };
+}
+
+test('brickHit: bottom hit flips vy, leaves vx, pushes the ball out', () => {
+  // Ball moving straight up into the bottom face of the brick.
+  const ball = ballAt(120, 122, 0, -300, 120, 140);
+  const brick = liveBrick(100, 100);
+  const hits = brickHit(ball, [brick]);
+  assert.equal(hits.length, 1);
+  assert.equal(ball.vy, 300, 'vy should flip from -300 to 300');
+  assert.equal(ball.vx, 0, 'vx must be left exactly as it was');
+  assert.equal(ball.y, brick.y + brick.h + ball.r, 'pushed below the brick');
+  assert.equal(collides(ball, brick), false, 'no sticky overlap after push-out');
+});
+
+test('brickHit: side hit flips vx, leaves vy, pushes the ball out', () => {
+  // Ball moving right into the left face of the brick.
+  const ball = ballAt(100, 110, 300, 0, 80, 110);
+  const brick = liveBrick(100, 100);
+  const hits = brickHit(ball, [brick]);
+  assert.equal(hits.length, 1);
+  assert.equal(ball.vx, -300, 'vx should flip from 300 to -300');
+  assert.equal(ball.vy, 0, 'vy must be left exactly as it was');
+  assert.equal(ball.x, brick.x - ball.r, 'pushed left of the brick');
+  assert.equal(collides(ball, brick), false);
+});
+
+test('brickHit: diagonal corner hit flips both components', () => {
+  // Perfectly diagonal approach: equal penetration on both axes.
+  const ball = ballAt(110, 110, 300, 300, 80, 80);
+  const brick = liveBrick(100, 100);
+  const hits = brickHit(ball, [brick]);
+  assert.equal(hits.length, 1);
+  assert.equal(ball.vx, -300, 'vx should flip');
+  assert.equal(ball.vy, -300, 'vy should flip');
+  assert.equal(collides(ball, brick), false);
+});
+
+test('brickHit: seam between two bricks bounces exactly once', () => {
+  // The ball (14 px across) straddles the 8 px seam between two bricks: both
+  // are overlapped in the same pass, so the bounce must be applied once, not
+  // twice (vy = -vy twice cancels out and the ball goes through).
+  const brickA = liveBrick(0, 48, 72);
