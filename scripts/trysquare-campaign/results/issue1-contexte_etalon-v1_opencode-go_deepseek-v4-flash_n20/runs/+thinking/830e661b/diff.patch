+export function brickHit(ball, bricks) {
+  const hit = [];
+  let bounced = false;
+  for (const brick of bricks) {
+    if (!brick.alive || !collides(ball, brick)) continue;
+    brick.alive = false;
+    hit.push(brick);
+    if (!bounced) {
