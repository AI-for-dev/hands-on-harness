+// Bounces the ball off one brick, per ISSUES.md #1: the face with the smaller
+// penetration is the face that was hit — flip `vy` on a top/bottom hit, `vx`
+// on a side hit, and leave the other component exactly as it was. Equal
+// penetrations on both axes mean a diagonal (corner) hit: flip both. The ball
+// is also pushed back out of the brick so it cannot re-collide on the next
+// frame and re-flip forever (sticky bounce).
+function bounceOff(ball, brick) {
+  // How deep the ball's box sinks past each of the brick's four faces.
+  const left = ball.x + ball.r - brick.x;
+  const right = brick.x + brick.w - (ball.x - ball.r);
+  const top = ball.y + ball.r - brick.y;
+  const bottom = brick.y + brick.h - (ball.y - ball.r);
