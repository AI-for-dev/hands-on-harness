+// --- #1: brick bounce ------------------------------------------------------
+
+// A minimal brick record for collision tests.
+function brick(x, y, w = 72, h = 20) {
+  return { x, y, w, h, row: 0, alive: true, points: 10 };
+}
+
+test('brickHit: bottom face hit flips vy and pushes the ball out', () => {
+  const ball = { x: 110, y: 116, r: 7, vx: 30, vy: -300 }; // coming from below
+  const bricks = [brick(90, 90)];
+  assert.equal(brickHit(ball, bricks).length, 1);
+  assert.equal(bricks[0].alive, false);
+  assert.ok(ball.vy > 0, 'vertical velocity flips away from the brick');
+  assert.equal(ball.vx, 30, 'horizontal velocity untouched on a vertical hit');
+  assert.equal(ball.y, 90 + 20 + 7, 'ball pushed out below the brick');
+  assert.equal(collides(ball, bricks[0]), false, 'no overlap remains');
+});
+
+test('brickHit: side face hit flips vx and pushes the ball out', () => {
+  const ball = { x: 85, y: 100, r: 7, vx: 300, vy: 20 }; // coming from the left
+  const bricks = [brick(90, 90)];
+  assert.equal(brickHit(ball, bricks).length, 1);
+  assert.ok(ball.vx < 0, 'horizontal velocity flips away from the brick');
+  assert.equal(ball.vy, 20, 'vertical velocity untouched on a side hit');
+  assert.equal(ball.x, 90 - 7, 'ball pushed out left of the brick');
+  assert.equal(collides(ball, bricks[0]), false, 'no overlap remains');
+});
+
+test('brickHit: corner hit (equal penetrations) flips both components', () => {
+  const ball = { x: 88, y: 88, r: 7, vx: 300, vy: 300 }; // diagonal approach
+  const bricks = [brick(90, 90)];
+  assert.equal(brickHit(ball, bricks).length, 1);
+  assert.ok(ball.vx < 0 && ball.vy < 0, 'both components flip on a corner hit');
+  assert.equal(ball.x, 90 - 7);
+  assert.equal(ball.y, 90 - 7);
+});
+
+test('brickHit: seam between two bricks bounces exactly once', () => {
+  // Two bricks stacked with the 8 px grid gap; the 14 px ball straddles the
+  // seam and overlaps BOTH in the same pass. A naive flip-per-brick would
+  // cancel itself (vy = -vy twice) and the ball would keep going up.
+  const top = brick(90, 90);
+  const bottom = brick(90, 90 + 20 + 8);
+  const ball = { x: 126, y: 113, r: 7, vx: 0, vy: -300 };
+  assert.equal(brickHit(ball, [top, bottom]).length, 2);
+  assert.equal(top.alive, false);
+  assert.equal(bottom.alive, false);
+  assert.ok(ball.vy > 0, 'single bounce: ball bounces back down');
+});
+
+test('brickHit: dead bricks are ignored', () => {
+  const bricks = [brick(90, 90)];
+  bricks[0].alive = false;
+  const ball = { x: 110, y: 100, r: 7, vx: 0, vy: 0 };
+  assert.equal(brickHit(ball, bricks).length, 0);
+});
+
+test('step: fast ball does not tunnel through a brick (swept)', () => {
+  const state = createState(6); // ballSpeed(6) = 710 px/s
+  const target = brick(90, 90);
+  state.bricks = [target];
+  // Start below the brick, moving straight up. One capped frame (50 ms) moves
+  // 35.5 px and would jump from y = 118 to y = 82.5 without ever overlapping
+  // the brick (ball top edge 111 -> 75.5, brick spans y 90..110): a discrete
+  // check would tunnel. The sub-step sweep must catch it.
+  state.ball = { x: 126, y: 118, r: 7, vx: 0, vy: -710 };
+  step(state, 0.05);
+  assert.equal(target.alive, false, 'brick destroyed thanks to the sweep');
+  assert.ok(state.ball.vy > 0, 'ball bounced down off the brick');
+});
