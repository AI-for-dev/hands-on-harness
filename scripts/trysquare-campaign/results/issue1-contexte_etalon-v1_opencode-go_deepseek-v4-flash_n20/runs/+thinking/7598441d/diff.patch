+    const hit = bounced ? collides(ball, brick) : sweepBrick(ball, brick, px, py);
+    if (hit) {
+      brick.alive = false;
+      destroyed.push(brick);
+      bounced = true;
+    }
+  }
+  return destroyed;
+}
