+// --- Brick bounce (#1) ------------------------------------------------------
+
+// A fixed brick to bounce test balls off: x 90..130, y 100..120.
+const BRICK = { x: 90, y: 100, w: 40, h: 20 };
+
+function newBall(x, y, vx, vy) {
+  return { x, y, r: 7, vx, vy };
+}
+
+test('bounceOffBrick: top-face hit flips vy only and pushes the ball out', () => {
+  const ball = newBall(110, 105, 300, 300); // falling onto the brick's top face
+  bounceOffBrick(ball, BRICK);
+  assert.equal(ball.vy, -300, 'vy should flip upward on a top-face hit');
+  assert.equal(ball.vx, 300, 'vx must be left exactly as it was');
+  assert.equal(ball.y, BRICK.y - ball.r, 'ball pushed out above the brick');
+  assert.equal(collides(ball, BRICK), false, 'no residual overlap');
+});
+
+test('bounceOffBrick: bottom-face hit flips vy only and pushes the ball out', () => {
+  const ball = newBall(110, 115, -300, -300); // rising into the brick's bottom face
+  bounceOffBrick(ball, BRICK);
+  assert.equal(ball.vy, 300, 'vy should flip downward on a bottom-face hit');
+  assert.equal(ball.vx, -300, 'vx must be left exactly as it was');
+  assert.equal(ball.y, BRICK.y + BRICK.h + ball.r, 'ball pushed out below the brick');
+  assert.equal(collides(ball, BRICK), false, 'no residual overlap');
+});
