+// Resolves a single ball/brick overlap (see #1): flips the velocity on the
+// face that was hit and pushes the ball back outside the brick so it cannot
+// re-overlap on the next frame (sticky bounce).
+//
+// - per face: the axis with the SMALLER penetration is the face that was hit;
+//   flip that component (`vy` for top/bottom, `vx` for sides) and leave the
+//   other component exactly as it was;
+// - corner: equal penetration on both axes means a diagonal hit — flip both;
+// - push out: reposition the ball just outside the brick rectangle.
+export function bounceOffBrick(ball, brick) {
+  // Penetration depth into each of the four edges.
+  const left = ball.x + ball.r - brick.x;
+  const right = brick.x + brick.w - (ball.x - ball.r);
+  const top = ball.y + ball.r - brick.y;
+  const bottom = brick.y + brick.h - (ball.y - ball.r);
+
+  const minX = Math.min(left, right);
+  const minY = Math.min(top, bottom);
+
+  if (minX < minY) {
+    // Side hit: flip vx only, push out on the hit side.
+    if (left < right) {
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+  } else if (minY < minX) {
+    // Top/bottom hit: flip vy only, push out on the hit side.
+    if (top < bottom) {
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  } else {
+    // Corner: equal penetration on both axes — diagonal hit, flip both.
+    if (left < right) {
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+    if (top < bottom) {
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  }
+}
+
+// Walks the ball's path between its previous position (`px`, `py`) and its
+// current one in small steps, and resolves the bounce the moment the path
+// first enters the brick (anti-tunnelling: a fast ball must not jump clean
+// over a brick between two frames). On a hit the ball is left at the resolved
+// (pushed-out) position; otherwise it is left exactly where it was.
+// Returns `true` if a bounce happened.
+function sweepBrick(ball, brick, px, py) {
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+  const dist = Math.hypot(dx, dy);
