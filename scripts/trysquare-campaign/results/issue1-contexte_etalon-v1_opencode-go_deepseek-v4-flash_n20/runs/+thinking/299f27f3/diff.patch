+// --- Brick bounce (issue #1) -----------------------------------------------
+
+// Bounces the ball off the brick it overlaps and pushes it back outside.
+// The axis with the SMALLER penetration is the face that was hit: flip `vy`
+// on a top/bottom hit, `vx` on a side hit, and leave the other component
+// exactly as it was. Equal penetrations (a diagonal hit into a corner) flip
+// both components. Repositioning the ball outside the brick rectangle
+// prevents a "sticky" bounce where it re-overlaps on the next frame and
+// flips forever.
+export function bounceOffBrick(ball, brick) {
+  const left = ball.x + ball.r - brick.x;
+  const right = brick.x + brick.w - (ball.x - ball.r);
+  const top = ball.y + ball.r - brick.y;
+  const bottom = brick.y + brick.h - (ball.y - ball.r);
+  const min = Math.min(left, right, top, bottom);
+
+  const EPS = 1e-9; // float ties: exact corner hits count as both faces
+  const hitLeft = Math.abs(left - min) < EPS;
+  const hitRight = Math.abs(right - min) < EPS;
+  const hitTop = Math.abs(top - min) < EPS;
+  const hitBottom = Math.abs(bottom - min) < EPS;
+
+  // Y grows downward, so a top-face hit bounces the ball UP (negative vy) and
+  // a bottom-face hit DOWN; a left-face hit bounces LEFT (negative vx) and a
+  // right-face hit RIGHT. Each face pushes the ball back outside that face.
+  if (hitLeft || hitRight) {
+    ball.vx = hitLeft ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+    ball.x = hitLeft ? brick.x - ball.r : brick.x + brick.w + ball.r;
+  }
+  if (hitTop || hitBottom) {
+    ball.vy = hitTop ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+    ball.y = hitTop ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  }
+}
