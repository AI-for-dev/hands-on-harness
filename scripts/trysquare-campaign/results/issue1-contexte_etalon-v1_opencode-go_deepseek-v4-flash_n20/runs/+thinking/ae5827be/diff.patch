+// corner — and leaves the other component untouched. The ball is then pushed
+// back out of the rectangle, otherwise it still overlaps on the next frame
+// and re-flips forever (sticky bounce). Mutates and returns the ball.
+export function bounceOffBrick(ball, brick) {
