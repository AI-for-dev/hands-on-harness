+// --- Brick collision resolution (issue #1) ---------------------------------
+
+// Earliest fraction t in [0, 1] at which the segment p0 -> p1 enters the box
+// [minX, maxX] x [minY, maxY], or null if it never enters it.
+// Standard slab method. Returning `t` (not just a boolean) lets the caller
+// place the ball exactly at the first contact point, and lets a fast ball be
+// caught mid-flight instead of tunnelling through a brick (issue #1).
+function segmentEntry(p0x, p0y, p1x, p1y, minX, maxX, minY, maxY) {
+  let tmin = 0;
+  let tmax = 1;
+  for (const [start, delta, lo, hi] of [
+    [p0x, p1x - p0x, minX, maxX],
+    [p0y, p1y - p0y, minY, maxY],
+  ]) {
+    if (delta === 0) {
+      if (start < lo || start > hi) return null;
+    } else {
+      let t1 = (lo - start) / delta;
+      let t2 = (hi - start) / delta;
+      if (t1 > t2) [t1, t2] = [t2, t1];
+      tmin = Math.max(tmin, t1);
+      tmax = Math.min(tmax, t2);
+      if (tmin > tmax) return null;
+    }
+  }
+  if (tmax < 0 || tmin > 1) return null;
+  return Math.max(0, tmin);
+}
+
+// Deflects the ball off `brick`, placing it exactly at the point where its
+// path first touched the brick (the entry point) so it can never overlap on
+// the next frame and re-flip forever (sticky bounce).
+// The face hit is the one closest to the entry point: the smaller penetration
+// wins — flip `vy` on a top/bottom hit, `vx` on a side hit, both on a
+// diagonal (corner) hit, and leave the other component untouched.
+function resolveBall(brick, entry, ball, p0x, p0y) {
+  const r = ball.r;
+  const ex = p0x + (ball.x - p0x) * entry;
+  const ey = p0y + (ball.y - p0y) * entry;
+  const dLeft = ex - (brick.x - r);
+  const dRight = brick.x + brick.w + r - ex;
+  const dTop = ey - (brick.y - r);
+  const dBottom = brick.y + brick.h + r - ey;
+  const minX = Math.min(dLeft, dRight);
+  const minY = Math.min(dTop, dBottom);
+  const EPS = 1e-6; // float noise on the touched face
+
+  if (Math.abs(minX - minY) < EPS) {
+    // Corner hit (equal penetration on both axes): bounce off both.
+    ball.x = dLeft <= dRight ? brick.x - r : brick.x + brick.w + r;
+    ball.y = dTop <= dBottom ? brick.y - r : brick.y + brick.h + r;
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+  } else if (minX < minY) {
+    // Side hit: bounce horizontally.
+    ball.x = dLeft <= dRight ? brick.x - r : brick.x + brick.w + r;
+    ball.vx = -ball.vx;
+  } else {
+    // Top/bottom hit: bounce vertically.
+    ball.y = dTop <= dBottom ? brick.y - r : brick.y + brick.h + r;
+    ball.vy = -ball.vy;
+  }
+}
+
+// Resolves the ball against the bricks: destroys every brick whose expanded
+// box (the brick grown by the ball radius) the segment `prev -> ball` crosses,
+// deflects the ball ONCE off the brick it touches first, and pushes it back
+// outside. Returns the array of destroyed bricks (for scoring).
+//
+// - `prev` is the ball position at the start of the frame. Sweeping the
+//   segment between the two positions is what stops a fast ball from jumping
+//   over a brick between frames (tunnelling). When omitted, the segment
+//   collapses to the ball's current position (plain overlap check).
+// - The bounce applies exactly once even when the 14 px ball overlaps two
+//   bricks across an 8 px grid seam in the same pass: flipping twice would
+//   cancel out and the ball would sail through.
+export function brickHit(ball, bricks, prev = null) {
+  const p0x = prev ? prev.x : ball.x;
+  const p0y = prev ? prev.y : ball.y;
+
+  const hits = [];
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    const entry = segmentEntry(
+      p0x,
+      p0y,
+      ball.x,
+      ball.y,
+      brick.x - ball.r,
+      brick.x + brick.w + ball.r,
+      brick.y - ball.r,
+      brick.y + brick.h + ball.r
+    );
+    if (entry !== null) hits.push({ brick, entry });
+  }
+  if (hits.length === 0) return [];
+
+  for (const hit of hits) hit.brick.alive = false;
+
+  // Bounce off the brick touched first (smallest entry time).
+  let first = hits[0];
+  for (const hit of hits) {
+    if (hit.entry < first.entry) first = hit;
+  }
+  resolveBall(first.brick, first.entry, ball, p0x, p0y);
+
+  return hits.map((h) => h.brick);
+}
