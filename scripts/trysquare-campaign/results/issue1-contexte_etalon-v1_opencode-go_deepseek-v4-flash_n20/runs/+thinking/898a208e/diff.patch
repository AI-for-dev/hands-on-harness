+// --- Brick bounce (pure, tested — ISSUES.md #1) -----------------------------
+
+// Penetration of the ball into the brick along each axis, plus which face is
+// the closest. Only meaningful while `collides()` is true (all overlaps > 0).
+function penetrations(ball, brick) {
+  const overlapLeft = ball.x + ball.r - brick.x;
+  const overlapRight = brick.x + brick.w - (ball.x - ball.r);
+  const overlapTop = ball.y + ball.r - brick.y;
+  const overlapBottom = brick.y + brick.h - (ball.y - ball.r);
+  return {
+    penX: Math.min(overlapLeft, overlapRight),
+    penY: Math.min(overlapTop, overlapBottom),
+    left: overlapLeft < overlapRight,
+    top: overlapTop < overlapBottom,
+  };
+}
+
+// Bounces the ball off ONE brick. The axis with the SMALLER penetration is the
+// face that was hit: top/bottom flips `vy`, left/right flips `vx`, and equal
+// penetrations (a corner) flips both. The other component is left exactly as
+// it was. Then pushes the ball back out (tangent to the brick), otherwise it
+// still overlaps on the next frame and re-flips forever (sticky bounce).
+function bounceBall(ball, brick) {
+  const { penX, penY, left, top } = penetrations(ball, brick);
+  if (penX < penY) {
+    // side hit: bounce away along x
+    ball.vx = left ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+    ball.x = left ? brick.x - ball.r : brick.x + brick.w + ball.r;
+  } else if (penY < penX) {
+    // top / bottom hit: bounce away along y
+    ball.vy = top ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+    ball.y = top ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  } else {
+    // corner: equal penetrations on both axes => diagonal hit => flip both
+    ball.vx = left ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+    ball.vy = top ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+    ball.x = left ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    ball.y = top ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  }
+}
+
+// Resolves the ball against the whole grid for one frame step.
+//
+//  - SWEEPS the path from the previous position (prevX, prevY): detection is
+//    discrete, and at high speed the ball can jump over a brick in one step,
+//    so the segment is sub-stepped and each sub-position is tested;
+//  - bounces AT MOST ONCE: at a seam the ball overlaps two bricks in the same
+//    pass, and flipping twice would cancel out (the ball would plow through);
+//  - returns the bricks overlapped at the point of contact (the caller
+//    destroys and scores them), or null when nothing was hit.
+//
+// Mutates the ball (velocity + position, pushed back out of the brick).
+export function bounceOffBricks(ball, bricks, prevX = ball.x, prevY = ball.y) {
+  const dx = ball.x - prevX;
+  const dy = ball.y - prevY;
+  const dist = Math.hypot(dx, dy);
+  // Sub-step small enough that the ball cannot cross a brick in one jump
+  // (BRICK_H 20 + ball diameter 14 = 34 px to cross; BALL_R keeps it safe).
+  const steps = Math.max(1, Math.ceil(dist / BALL_R));
+
+  for (let i = 0; i <= steps; i++) {
+    const t = i / steps;
+    const x = prevX + dx * t;
+    const y = prevY + dy * t;
+
+    const hits = [];
+    for (const brick of bricks) {
+      if (brick.alive && collides({ x, y, r: ball.r }, brick)) hits.push(brick);
+    }
+    if (hits.length === 0) continue;
+
+    // First contact along the path: place the ball there, then bounce it off
+    // the most face-on brick (smallest penetration) — exactly once.
+    ball.x = x;
+    ball.y = y;
+    let best = hits[0];
+    let bestPen = Infinity;
+    for (const brick of hits) {
+      const { penX, penY } = penetrations(ball, brick);
+      const pen = Math.min(penX, penY);
+      if (pen < bestPen) {
+        bestPen = pen;
+        best = brick;
+      }
+    }
+    bounceBall(ball, best);
+    return hits;
+  }
+  return null;
+}
