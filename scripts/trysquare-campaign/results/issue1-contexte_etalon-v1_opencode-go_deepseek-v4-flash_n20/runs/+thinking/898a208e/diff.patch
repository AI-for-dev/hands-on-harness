+// --- Brick bounce (ISSUES.md #1) -------------------------------------------
+// Expected behavior: the axis with the SMALLER penetration is the face that
+// was hit (flip vy on top/bottom, vx on a side hit, both on a corner), the
+// ball is pushed back out of the brick, the bounce applies exactly once per
+// pass (seam between two bricks), and a fast ball is caught by a sweep.
+
+test('bounceOffBricks: head-on bottom-face hit flips vy and pushes the ball out', () => {
+  const brick = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  const ball = { x: 136, y: 126, r: 7, vx: 120, vy: -300 }; // rising into the bottom face
+  const hits = bounceOffBricks(ball, [brick], 136, 145); // swept from below, clear
+  assert.deepEqual(hits, [brick]);
+  assert.equal(ball.vy, 300, 'vy should flip from up to down');
+  assert.equal(ball.vx, 120, 'vx must be left exactly as it was');
+  assert.equal(collides(ball, brick), false, 'ball must be pushed out of the brick');
+  assert.ok(ball.y - ball.r >= brick.y + brick.h, 'ball rests below the brick');
+});
+
+test('bounceOffBricks: side hit flips vx and pushes the ball out', () => {
+  const brick = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  const ball = { x: 95, y: 110, r: 7, vx: 300, vy: 40 }; // moving right into the left face
+  const hits = bounceOffBricks(ball, [brick], 88, 110); // swept from the left, clear
+  assert.deepEqual(hits, [brick]);
+  assert.equal(ball.vx, -300, 'vx should flip from right to left');
+  assert.equal(ball.vy, 40, 'vy must be left exactly as it was');
+  assert.equal(collides(ball, brick), false, 'ball must be pushed out of the brick');
+  assert.ok(ball.x + ball.r <= brick.x, 'ball rests left of the brick');
+});
+
