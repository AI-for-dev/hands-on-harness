+// Resolves the ball against the brick grid for one step. The ball moved from
+// `prev` to its current position, and the sweep between the two catches a
+// fast ball that jumps over a brick in a single frame (tunnelling: at level 6
+// one stuttered 50 ms step moves the ball ~35 px, more than the ~34 px it
+// takes to cross a brick).
+//
+// - Every brick the ball touched (overlapped now, or crossed along the path)
+//   is destroyed.
+// - Exactly ONE bounce is applied:
+//   - if the ball still overlaps a brick, the face is chosen by penetration —
+//     the axis with the smaller total overlap flips (vy on a top/bottom hit,
+//     vx on a side hit, both on a corner) — and the ball is pushed back out
+//     of the overlap, so it cannot re-collide next frame (no sticky bounce);
+//   - otherwise the ball is parked at the first swept contact and deflected
+//     off that face.
+//
+// The single bounce matters at the seams: the grid gap (8 px) is smaller than
+// the ball (14 px), so a seam overlaps two bricks in the same pass, and
+// flipping the same axis twice would cancel out — the ball would sail through.
+//
+// Returns the destroyed bricks (each already marked `alive = false`), for the
+// caller to score.
+export function bounceBricks(ball, bricks, prev = ball) {
+  const contacts = [];
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    if (collides(ball, brick)) {
+      contacts.push({ brick, overlap: true, entry: null });
+      continue;
+    }
+    const entry = segmentEntry(
+      prev.x,
+      prev.y,
+      ball.x,
+      ball.y,
+      brick.x - ball.r,
+      brick.y - ball.r,
+      brick.x + brick.w + ball.r,
+      brick.y + brick.h + ball.r,
+    );
+    if (entry) contacts.push({ brick, overlap: false, entry });
+  }
+  if (contacts.length === 0) return [];
+
+  const touched = contacts.map((c) => c.brick);
+  const overlapped = contacts.filter((c) => c.overlap);
+
+  if (overlapped.length > 0) {
+    // Penetration: the axis with the smaller total overlap is the hit face.
+    let ox = 0;
+    let oy = 0;
+    for (const { brick } of overlapped) {
+      ox += Math.min(ball.x + ball.r, brick.x + brick.w) - Math.max(ball.x - ball.r, brick.x);
+      oy += Math.min(ball.y + ball.r, brick.y + brick.h) - Math.max(ball.y - ball.r, brick.y);
+    }
+    if (ox < oy) {
+      if (ball.vx >= 0) ball.x -= ox;
+      else ball.x += ox;
+      ball.vx = -ball.vx;
+    } else if (oy < ox) {
+      if (ball.vy >= 0) ball.y -= oy;
+      else ball.y += oy;
+      ball.vy = -ball.vy;
+    } else {
+      // Corner: equal penetrations mean a diagonal hit — flip both and push
+      // out along both axes.
+      if (ball.vx >= 0) ball.x -= ox;
+      else ball.x += ox;
+      if (ball.vy >= 0) ball.y -= oy;
+      else ball.y += oy;
+      ball.vx = -ball.vx;
+      ball.vy = -ball.vy;
+    }
+  } else {
+    // No overlap at the final position: the ball crossed a brick between
+    // frames. Bounce off the first contact and park the ball exactly there.
+    let first = contacts[0];
+    for (const c of contacts) {
+      if (c.entry.t < first.entry.t) first = c;
+    }
+    ball.x = first.entry.x;
+    ball.y = first.entry.y;
+    if (first.entry.axis !== 'y') ball.vx = -ball.vx;
+    if (first.entry.axis !== 'x') ball.vy = -ball.vy;
+  }
+
+  for (const brick of touched) brick.alive = false;
+  return touched;
+}
