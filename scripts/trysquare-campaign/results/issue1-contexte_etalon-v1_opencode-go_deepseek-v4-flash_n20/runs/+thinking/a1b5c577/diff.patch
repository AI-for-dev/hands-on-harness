+// Returns the point where the segment (ax,ay)→(bx,by) first enters the
+// axis-aligned rect [x0,x1]×[y0,y1] (edges exclusive), or null when the
+// segment never enters it. `axis` says which boundary was crossed:
+// 'x' (a vertical side), 'y' (a horizontal side) or 'corner' (both at once).
+function segmentEntry(ax, ay, bx, by, x0, y0, x1, y1) {
+  const dx = bx - ax;
+  const dy = by - ay;
+  let tx = 0; // entry parameter into the x slab
+  let ty = 0; // entry parameter into the y slab
+
+  if (Math.abs(dx) < 1e-12) {
+    if (ax <= x0 || ax >= x1) return null; // parallel and outside
+  } else {
+    let t1 = (x0 - ax) / dx;
+    let t2 = (x1 - ax) / dx;
+    if (t1 > t2) {
+      const t = t1;
+      t1 = t2;
+      t2 = t;
+    }
+    if (t2 < 0 || t1 > 1) return null; // slab lies entirely outside the segment
+    tx = t1;
+  }
+  if (Math.abs(dy) < 1e-12) {
+    if (ay <= y0 || ay >= y1) return null;
+  } else {
+    let t1 = (y0 - ay) / dy;
+    let t2 = (y1 - ay) / dy;
+    if (t1 > t2) {
+      const t = t1;
+      t1 = t2;
+      t2 = t;
+    }
+    if (t2 < 0 || t1 > 1) return null;
+    ty = t1;
+  }
+
+  const t = Math.max(tx, ty);
+  if (t < 0 || t > 1) return null;
+
+  const onX = Math.abs(t - tx) < 1e-9;
+  const onY = Math.abs(t - ty) < 1e-9;
+  const axis = onX && onY ? 'corner' : onX ? 'x' : 'y';
+  return { t, x: ax + dx * t, y: ay + dy * t, axis };
+}
 
