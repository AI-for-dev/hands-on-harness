+// --- Brick bounce (ISSUES.md #1) -------------------------------------------
+
+// A plain brick to hit (points/row are only used by scoring, not by the
+// bounce itself).
+function makeBrick(x, y, w = 40, h = 20) {
+  return { x, y, w, h, row: 0, points: 10, alive: true };
+}
+
+test('bounce: top/bottom hit flips vy, leaves vx alone, pushes the ball out', () => {
+  const ball = { x: 120, y: 124, r: 7, vx: 0, vy: -300 }; // climbing into the brick
+  const brick = makeBrick(100, 100);
+  const hit = bounceBricks(ball, [brick], { x: 120, y: 130 });
+
+  assert.deepEqual(hit, [brick]);
+  assert.equal(brick.alive, false, 'hit brick is destroyed');
+  assert.ok(ball.vy > 0, 'vy flips from up to down');
+  assert.equal(ball.vx, 0, 'vx is left exactly as it was');
+  assert.equal(ball.y - ball.r, brick.y + brick.h, 'ball pushed out below the brick');
+  assert.equal(collides(ball, brick), false);
+});
+
+test('bounce: side hit flips vx, leaves vy alone, pushes the ball out', () => {
+  const ball = { x: 96, y: 110, r: 7, vx: 300, vy: 0 }; // driving into the left face
+  const brick = makeBrick(100, 100);
+  const hit = bounceBricks(ball, [brick], { x: 80, y: 110 });
+
+  assert.deepEqual(hit, [brick]);
+  assert.equal(brick.alive, false, 'hit brick is destroyed');
+  assert.ok(ball.vx < 0, 'vx flips from right to left');
+  assert.equal(ball.vy, 0, 'vy is left exactly as it was');
+  assert.equal(ball.x + ball.r, brick.x, 'ball pushed out left of the brick');
+  assert.equal(collides(ball, brick), false);
+});
+
+test('bounce: corner hit (equal penetrations) flips both components', () => {
+  const ball = { x: 96, y: 96, r: 7, vx: 300, vy: -300 }; // square into the top-left corner
+  const brick = makeBrick(100, 100);
+  const hit = bounceBricks(ball, [brick], { x: 80, y: 116 });
+
+  assert.deepEqual(hit, [brick]);
+  assert.equal(brick.alive, false, 'hit brick is destroyed');
+  assert.ok(ball.vx < 0, 'vx flips');
+  assert.ok(ball.vy > 0, 'vy flips');
+});
+
+test('bounce: push-out prevents a sticky re-bounce', () => {
+  const ball = { x: 120, y: 124, r: 7, vx: 0, vy: -300 };
+  const brick = makeBrick(100, 100);
+  bounceBricks(ball, [brick], { x: 120, y: 130 });
+
+  const vyAfter = ball.vy;
+  const hitAgain = bounceBricks(ball, [brick], { x: ball.x, y: ball.y });
+  assert.deepEqual(hitAgain, [], 'second pass finds nothing to bounce on');
+  assert.equal(ball.vy, vyAfter, 'no second flip, so no jitter');
+  assert.equal(collides(ball, brick), false, 'ball rests outside the brick');
+});
+
+test('bounce: a seam between two bricks deflects exactly once', () => {
+  const brickL = makeBrick(100, 100);
+  const brickR = makeBrick(148, 100); // 8 px gap, the ball (14 px) spans both
+  const ball = { x: 144, y: 110, r: 7, vx: 300, vy: 0 };
+  const hit = bounceBricks(ball, [brickL, brickR], { x: 90, y: 110 });
+
+  assert.deepEqual(new Set(hit), new Set([brickL, brickR]));
+  assert.equal(brickL.alive, false);
+  assert.equal(brickR.alive, false);
+  assert.ok(ball.vx < 0, 'vx flips exactly once (a double flip would cancel out)');
+  assert.equal(ball.vy, 0);
+});
+
+test('bounce: swept detection catches a ball that jumps over a brick (tunnelling)', () => {
+  const brick = makeBrick(100, 100);
+  const ball = { x: 120, y: 90, r: 7, vx: 0, vy: -300 }; // already past the brick
+  const prev = { x: 120, y: 135 }; // ...but it crossed the brick between frames
+
+  // Sanity: a frame-by-frame overlap test alone would let the ball pass through.
+  assert.equal(collides(ball, brick), false, 'no overlap at the final position');
+
+  const hit = bounceBricks(ball, [brick], prev);
+  assert.deepEqual(hit, [brick]);
+  assert.equal(brick.alive, false);
+  assert.ok(ball.vy > 0, 'vy flips: the ball bounces back down');
+  assert.equal(ball.y - ball.r, brick.y + brick.h, 'ball parked at the face it hit');
+  assert.equal(collides(ball, brick), false);
+});
