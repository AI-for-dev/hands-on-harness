+// True if the ball CROSSED the brick between its previous position (px, py)
+// and its current position. The brick is inflated by the ball radius, so this
+// is the exact swept volume of the ball over the step: it catches fast shots
+// that would otherwise jump clean over a brick in a single frame (ISSUES.md
+// #1, "tunnelling"). Without a recorded previous position it degrades to the
+// discrete test.
+export function sweptCollides(ball, brick) {
+  const px = ball.px ?? ball.x;
+  const py = ball.py ?? ball.y;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+  if (dx === 0 && dy === 0) return collides(ball, brick);
+
+  const x0 = brick.x - ball.r;
+  const y0 = brick.y - ball.r;
+  const x1 = brick.x + brick.w + ball.r;
+  const y1 = brick.y + brick.h + ball.r;
+
+  // Liang–Barsky: clip the segment [P, P+D] against the inflated rectangle.
+  let t0 = 0;
+  let t1 = 1;
+  const p = [-dx, dx, -dy, dy];
+  const q = [px - x0, x1 - px, py - y0, y1 - py];
+  for (let i = 0; i < 4; i++) {
+    if (p[i] === 0) {
+      if (q[i] < 0) return false; // parallel to this axis, outside the slab
+    } else {
+      const t = q[i] / p[i];
+      if (p[i] < 0) {
+        // entering the slab
+        if (t > t1) return false;
+        if (t > t0) t0 = t;
+      } else {
+        // leaving the slab
+        if (t < t0) return false;
+        if (t < t1) t1 = t;
+      }
+    }
+  }
+  return true;
+}
+
+// Bounces the ball off a brick it just hit (mutates the ball, returns nothing).
+//
+// Face selection prefers the APPROACH DIRECTION: where the ball was last frame
+// decides which face was hit, so the ball is pushed back out through the face
+// it came in through. This is what makes seam hits (ISSUES.md #1, "neighbours")
+// and tunnelled hits resolve correctly even when the penetration heuristic
+// would pick the wrong axis. When the previous position is missing or already
+// overlapping the brick, it falls back to the penetration heuristic — the axis
+// with the smaller overlap is the face that was hit, and equal overlaps mean a
+// diagonal corner hit, flipping both components.
+export function bounceBall(ball, brick) {
+  const px = ball.px ?? ball.x;
+  const py = ball.py ?? ball.y;
+
+  if (py + ball.r <= brick.y) {
+    // approached from above: bounce back up, park just above the brick
+    ball.vy = -Math.abs(ball.vy);
+    ball.y = brick.y - ball.r;
+    return;
+  }
+  if (py - ball.r >= brick.y + brick.h) {
+    // approached from below: bounce back down
+    ball.vy = Math.abs(ball.vy);
+    ball.y = brick.y + brick.h + ball.r;
+    return;
+  }
+  if (px + ball.r <= brick.x) {
+    // approached from the left: bounce back left
+    ball.vx = -Math.abs(ball.vx);
+    ball.x = brick.x - ball.r;
+    return;
+  }
+  if (px - ball.r >= brick.x + brick.w) {
+    // approached from the right: bounce back right
+    ball.vx = Math.abs(ball.vx);
+    ball.x = brick.x + brick.w + ball.r;
+    return;
+  }
+
+  // No clean approach direction (spawned inside a brick, or no previous
+  // position recorded): penetration-depth heuristic.
+  const overlapX = Math.min(
+    ball.x + ball.r - brick.x,
+    brick.x + brick.w - (ball.x - ball.r)
+  );
+  const overlapY = Math.min(
+    ball.y + ball.r - brick.y,
+    brick.y + brick.h - (ball.y - ball.r)
+  );
+  if (overlapX < overlapY) {
+    ball.vx = -ball.vx;
+    ball.x += Math.sign(ball.vx) * overlapX;
+  } else if (overlapY < overlapX) {
+    ball.vy = -ball.vy;
+    ball.y += Math.sign(ball.vy) * overlapY;
+  } else {
+    // Equal penetration on both axes: a diagonal corner hit.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x += Math.sign(ball.vx) * overlapX;
+    ball.y += Math.sign(ball.vy) * overlapY;
+  }
+}
