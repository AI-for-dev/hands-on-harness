+// --- ISSUES.md #1: the ball bounces off bricks ------------------------------
+// Each regression case from the ticket, tested against the pure brickHit()
+// primitive: per-face bounce, corner, push-out, neighbours, tunnelling.
+
+const BRICK = { x: 100, y: 160, w: 72, h: 20, alive: true, row: 4, points: 100 };
+
+test('brick hit: head-on hit from below bounces the ball down (top/bottom face)', () => {
+  const res = brickHit(
+    { x: 136, y: 185, r: 7, vx: 0, vy: -300, prevX: 136, prevY: 190 },
+    [BRICK],
+  );
+  assert.ok(res, 'the brick must be hit');
+  assert.equal(res.brick, BRICK);
+  assert.ok(res.vy > 0, 'vy flips downward');
+  assert.equal(res.vx, 0, 'vx is untouched on a top/bottom hit');
+  assert.equal(res.y, BRICK.y + BRICK.h + 7, 'ball pushed out below the brick');
+});
+
+test('brick hit: side hit flips vx and leaves vy untouched', () => {
+  const res = brickHit(
+    { x: 93, y: 170, r: 7, vx: 300, vy: -50, prevX: 88, prevY: 170 },
+    [BRICK],
+  );
+  assert.ok(res, 'the brick must be hit');
+  assert.equal(res.brick, BRICK);
+  assert.ok(res.vx < 0, 'vx flips leftwards');
+  assert.equal(res.vy, -50, 'vy is untouched on a side hit');
+  assert.equal(res.x, BRICK.x - 7, 'ball pushed out left of the brick');
+});
+
+test('brick hit: corner hit (equal penetration) flips both components', () => {
+  // Ball center on the diagonal through the brick's top-left corner:
+  // the penetration on x equals the penetration on y.
+  const res = brickHit(
+    {
+      x: BRICK.x - 7 / Math.SQRT2,
+      y: BRICK.y - 7 / Math.SQRT2,
+      r: 7,
+      vx: 300,
+      vy: 300,
+      prevX: BRICK.x - 8,
+      prevY: BRICK.y - 8,
+    },
+    [BRICK],
+  );
+  assert.ok(res, 'the corner must be hit');
+  assert.ok(res.vx < 0 && res.vy < 0, 'both components flip on a diagonal hit');
+  assert.equal(res.x, BRICK.x - 7, 'pushed out left');
+  assert.equal(res.y, BRICK.y - 7, 'pushed out above');
+});
+
+test('brick hit: push-out leaves no overlap for the next frame', () => {
+  const res = brickHit(
+    { x: 136, y: 185, r: 7, vx: 0, vy: -300, prevX: 136, prevY: 190 },
+    [BRICK],
+  );
+  assert.ok(res, 'the brick must be hit');
+  const resolved = { x: res.x, y: res.y, r: 7 };
+  assert.equal(collides(resolved, BRICK), false, 'no sticky re-overlap');
+});
+
+test('brick hit: a seam hit crosses two bricks but bounces exactly once', () => {
+  const left = { ...BRICK, x: 4 };
+  const right = { ...BRICK, x: 84 };
+  const res = brickHit(
+    { x: 80, y: 185, r: 7, vx: 0, vy: -300, prevX: 80, prevY: 190 },
+    [left, right],
+  );
+  assert.ok(res, 'the seam must be hit');
+  assert.deepEqual(res.hits, [left, right], 'both seam bricks are crossed');
+  assert.equal(res.vy, 300, 'vy flipped exactly once, not cancelled by a second flip');
+  assert.equal(res.vx, 0);
