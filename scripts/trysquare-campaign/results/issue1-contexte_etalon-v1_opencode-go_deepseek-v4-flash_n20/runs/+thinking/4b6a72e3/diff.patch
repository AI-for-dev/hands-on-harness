+    return {
+      brick: first,
+      hits,
+      x: pushOut(ball, first, 'x'),
+      y: pushOut(ball, first, 'y'),
+      vx: -ball.vx,
+      vy: -ball.vy,
+    };
+  }
+  if (oy < ox) {
+    // Top/bottom face: flip vy, push out vertically, leave vx untouched.
+    return {
+      brick: first,
+      hits,
+      x: ball.x,
+      y: pushOut(ball, first, 'y'),
+      vx: ball.vx,
+      vy: -ball.vy,
+    };
+  }
+  // Side face: flip vx, push out horizontally, leave vy untouched.
+  return {
+    brick: first,
+    hits,
+    x: pushOut(ball, first, 'x'),
+    y: ball.y,
+    vx: -ball.vx,
+    vy: ball.vy,
+  };
+}
