+// --- Brick bounce (#1) ----------------------------------------------------
+// The ball must be deflected by a brick, not plow through it: per-face bounce
+// (flip vy on top/bottom, vx on side), corner hits flip both, the ball is
+// pushed back out, a seam hit bounces exactly once, and a fast ball is caught
+// by a sweep (no tunnelling).
+
+// A minimal state around a single brick: the ball, one live brick, and the
+// score/combo fields brickHit touches.
+function brickState(ball, bricks) {
+  return {
+    ball,
+    bricks: Array.isArray(bricks) ? bricks : [bricks],
+    score: 0,
+    combo: 0,
+  };
+}
+
+function singleBrick(x = 100, y = 100, w = 72, h = 20) {
+  return { x, y, w, h, row: 0, alive: true, points: 100 };
+}
+
+const UP = -1;
+const DOWN = 1;
+const LEFT = -1;
+const RIGHT = 1;
+
+// step: the ball falls onto the top of a brick and bounces back up (#1).
+test('step: ball bounces off the top face of a brick', () => {
+  const state = createState(1);
+  state.ball = { x: 136, y: 80, r: 7, vx: 0, vy: 900 }; // above the brick
+  state.bricks = [singleBrick()]; // top edge at y=100
+
+  step(state, 1 / 60); // 15 px down: the path crosses the brick's top face
+
+  assert.equal(state.bricks[0].alive, false, 'brick should be destroyed');
+  assert.equal(Math.sign(state.ball.vy), UP, 'ball should rebound upward');
+});
+
+// step: a near-horizontal shot into the side of a brick flips vx, not vy.
+test('step: ball bounces off the side face of a brick', () => {
+  const state = createState(1);
+  state.ball = { x: 80, y: 110, r: 7, vx: 900, vy: 0 }; // left of the brick
+  state.bricks = [singleBrick()]; // left edge at x=100
+
+  step(state, 1 / 60);
+
+  assert.equal(state.bricks[0].alive, false);
+  assert.equal(Math.sign(state.ball.vx), LEFT, 'horizontal velocity should flip');
+  assert.equal(Math.sign(state.ball.vy), 0, 'vertical velocity must stay untouched');
+});
+
+// step: the ball comes up from below and is deflected back down.
+test('step: ball bounces off the bottom face of a brick', () => {
+  const state = createState(1);
+  state.ball = { x: 136, y: 140, r: 7, vx: 0, vy: -900 }; // below the brick
+  state.bricks = [singleBrick()]; // bottom edge at y=120
+
+  step(state, 1 / 60);
+
+  assert.equal(state.bricks[0].alive, false);
+  assert.equal(Math.sign(state.ball.vy), DOWN, 'ball should rebound downward');
+});
+
+// brickHit: a diagonal shot into a corner flips BOTH components.
+test('brickHit: corner hit flips both velocity components', () => {
