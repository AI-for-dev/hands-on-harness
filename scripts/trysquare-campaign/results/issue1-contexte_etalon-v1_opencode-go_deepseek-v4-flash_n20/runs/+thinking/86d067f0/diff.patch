+      // Movement parallel to the slab: only a point already inside it counts.
+      if (p0 < lo || p0 > hi) return null;
+    } else {
+      let t1 = (lo - p0) / d;
+      let t2 = (hi - p0) / d;
+      if (t1 > t2) [t1, t2] = [t2, t1];
+      tmin = Math.max(tmin, t1);
+      tmax = Math.min(tmax, t2);
