+function sweptEntry(x0, y0, x1, y1, brick, pad) {
+  const minX = brick.x - pad;
+  const maxX = brick.x + brick.w + pad;
+  const minY = brick.y - pad;
+  const maxY = brick.y + brick.h + pad;
+  const dx = x1 - x0;
+  const dy = y1 - y0;
