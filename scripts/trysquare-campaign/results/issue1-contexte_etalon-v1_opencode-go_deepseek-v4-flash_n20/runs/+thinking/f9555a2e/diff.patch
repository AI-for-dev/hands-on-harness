+  assert.deepEqual(destroyed, [brick]);
+  assert.equal(ball.vx, -50, 'horizontal flipped');
+  assert.equal(ball.vy, 50, 'vertical flipped');
+  assert.equal(ball.x, 83, 'pushed out left of the brick');
