+// --- brickHit: the missing brick bounce (issue #1) -------------------------
+// Each case from ISSUES.md #1: per-face, corner, push-out, neighbours, sweep.
+
+function makeBrick(over = {}) {
+  return { x: 90, y: 90, w: 72, h: 20, row: 0, alive: true, points: 100, ...over };
+}
+
+test('brickHit: bottom-face hit flips vy and pushes the ball out below', () => {
+  const brick = makeBrick();
+  const ball = { x: 126, y: 108, r: 7, vx: 0, vy: -100 };
+  const destroyed = brickHit(ball, [brick], 126, 140);
+  assert.deepEqual(destroyed, [brick]);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vy, 100, 'moving up (negative vy) bounces back DOWN');
+  assert.equal(ball.vx, 0, 'side component untouched');
+  assert.equal(ball.y, 117, 'pushed out below the brick (90 + 20 + r)');
+  assert.equal(ball.x, 126);
+});
+
+test('brickHit: side-face hit flips vx and pushes the ball out sideways', () => {
+  const brick = makeBrick();
+  const ball = { x: 100, y: 100, r: 7, vx: 50, vy: 0 };
+  const destroyed = brickHit(ball, [brick], 60, 100);
+  assert.deepEqual(destroyed, [brick]);
+  assert.equal(ball.vx, -50, 'moving right (positive vx) bounces back LEFT');
+  assert.equal(ball.vy, 0, 'vertical component untouched');
+  assert.equal(ball.x, 83, 'pushed out to the left of the brick (90 - r)');
+  assert.equal(ball.y, 100);
+});
+
+test('brickHit: corner hit (equal penetration) flips both components', () => {
+  const brick = makeBrick();
+  const ball = { x: 110, y: 90, r: 7, vx: 50, vy: -50 };
