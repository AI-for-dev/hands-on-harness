+test('resolveBrickCollisions: sweeping catches a tunnelling fast ball', () => {
+  const brick = { x: 300, y: 200, w: 72, h: 20, alive: true };
+  const ball = { x: 336, y: 300, r: 7, vx: 0, vy: 600 }; // end far below the brick
+  const state = { combo: 0, score: 0 };
+  const bounced = resolveBrickCollisions(ball, 336, 140, [brick], state);
+  assert.equal(brick.alive, false, 'leap over the brick still destroyed it');
