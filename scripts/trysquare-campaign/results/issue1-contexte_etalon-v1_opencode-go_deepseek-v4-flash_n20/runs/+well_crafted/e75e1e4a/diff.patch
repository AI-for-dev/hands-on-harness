+// --- #1: brick bounce ------------------------------------------------------
+
+// A ball dropping onto the TOP of a brick (small vertical penetration) must
+// reflect the vertical component and leave vx untouched.
+test('hitBrick: top hit flips vy and keeps vx', () => {
+  const brick = { x: 80, y: 80, w: 72, h: 20 };
+  const ball = { x: 100, y: 74, r: 7, vx: 30, vy: 100 };
+  hitBrick(ball, brick);
+  assert.ok(Math.sign(ball.vy) === UP, 'vy should point back up');
+  assert.equal(ball.vx, 30, 'horizontal component is left exactly as it was');
+  assert.equal(ball.y, brick.y - ball.r, 'pushed back out above the brick');
+  assert.ok(!collides(ball, brick), 'no residual overlap (no sticky bounce)');
+});
+
+// A ball hitting the SIDE of a brick must reflect vx and leave vy untouched.
+test('hitBrick: side hit flips vx and keeps vy', () => {
+  const brick = { x: 80, y: 80, w: 72, h: 20 };
+  const ball = { x: 74, y: 90, r: 7, vx: 100, vy: -40 };
+  hitBrick(ball, brick);
+  assert.equal(ball.vx, -100, 'vx reflected left');
+  assert.equal(ball.vy, -40, 'vertical component is left exactly as it was');
+  assert.equal(ball.x, brick.x - ball.r, 'pushed back out to the left');
+  assert.ok(!collides(ball, brick), 'no residual overlap');
+});
+
+// Equal penetration on both axes means a diagonal corner hit: flip both.
+test('hitBrick: corner (equal penetration) flips both components', () => {
+  const brick = { x: 100, y: 100, w: 50, h: 20 };
+  const ball = { x: 106, y: 106, r: 7, vx: 100, vy: 100 };
+  hitBrick(ball, brick);
+  assert.equal(ball.vx, -100);
+  assert.equal(ball.vy, -100);
+  assert.ok(!collides(ball, brick), 'corner bounce pushes the ball clear');
+});
+
+// Two side-adjacent bricks share a seam (8 px gap < 14 px ball): the ball
+// overlaps BOTH in one pass. They must all break, yet the bounce must be
+// applied exactly once (a double `vy = -vy` would cancel and plow through).
+test('resolveBrickCollisions: seam overlaps both bricks but bounces once', () => {
+  const left = { x: 100, y: 200, w: 72, h: 20, alive: true };
+  const right = { x: 180, y: 200, w: 72, h: 20, alive: true };
+  const ball = { x: 176, y: 196, r: 7, vx: 0, vy: 100 }; // falling onto the seam
+  const state = { combo: 0, score: 0 };
+  resolveBrickCollisions(ball, 176, 186, [left, right], state);
+  assert.equal(left.alive, false);
+  assert.equal(right.alive, false);
+  assert.ok(Math.sign(ball.vy) === UP, 'reflected away after exactly one bounce');
+  assert.equal(state.combo, 2, 'both bricks scored');
+});
+
+// A fast ball whose travelled segment jumps clean over a brick must still find
