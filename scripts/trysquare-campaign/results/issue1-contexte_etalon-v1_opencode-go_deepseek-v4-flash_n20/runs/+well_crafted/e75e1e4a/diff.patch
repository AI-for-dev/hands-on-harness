+// Bounce a ball off a single brick it currently overlaps (see #1).
+//
+// Decides WHICH face was hit from the two axis penetrations: the axis with the
+// *smaller* penetration is the face the ball crossed (a ball merely dipping
+// into a top face has a tiny vertical penetration next to a large horizontal
+// one). We flip that axis' velocity and leave the other component exactly as
+// it was. Equal penetrations mean a diagonal corner hit — flip both axes.
+//
+// The ball is then pushed back OUTSIDE the brick rectangle so it does not stay
+// overlapping on the next frame (which would re-flip forever = sticky bounce).
+// Mutates `ball` in place and returns `true`.
+export function hitBrick(ball, brick) {
+  const penX = Math.min(
+    ball.x + ball.r - brick.x,
+    brick.x + brick.w - (ball.x - ball.r),
+  );
+  const penY = Math.min(
+    ball.y + ball.r - brick.y,
+    brick.y + brick.h - (ball.y - ball.r),
+  );
+
+  if (Math.abs(penX - penY) <= 1e-6) {
+    // Corner: equal penetration = diagonal hit, flip both components and slide
+    // the ball into the mirrored exterior corner so it escapes cleanly.
+    const sideX = ball.x >= brick.x + brick.w / 2 ? 1 : -1;
+    const sideY = ball.y >= brick.y + brick.h / 2 ? 1 : -1;
+    ball.x = sideX > 0 ? brick.x + brick.w + ball.r : brick.x - ball.r;
+    ball.y = sideY > 0 ? brick.y + brick.h + ball.r : brick.y - ball.r;
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+  } else if (penX < penY) {
+    // Side hit: flip vx, keep vy, push out horizontally.
+    if (ball.x < brick.x + brick.w / 2) {
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+  } else {
+    // Top/bottom hit: flip vy, keep vx, push out vertically.
+    if (ball.y < brick.y + brick.h / 2) {
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  }
+  return true;
+}
+
+// Resolves ball-vs-bricks for one frame: destroys every brick the ball crosses
+// and applies the bounce EXACTLY once (see #1).
+//
+// Detection is discrete — position before / after the move — so a fast ball can
+// jump clean over a brick (35.5 px per 50 ms step at level 6 against 34 px to
+// cross). We therefore SWEEP the segment from (prevX, prevY) to the ball's
+// current position in sub-steps no larger than the ball's own diameter, so the
+// ball cannot skip a brick. Because the sweeping ball may overlap two bricks at
+// a seam (8 px gap vs a 14 px ball) we destroy all of them but bounce only once —
+// applying `vy = -vy` twice would cancel out and let the ball plow through.
+// Returns `true` if the ball bounced.
+export function resolveBrickCollisions(ball, prevX, prevY, bricks, state = null) {
+  const dx = ball.x - prevX;
+  const dy = ball.y - prevY;
+  const dist = Math.hypot(dx, dy);
+  // Sub-step so the centre never moves more than one ball diameter per sample;
+  // consecutive samples then always overlap a brick of any meaningful size.
+  const maxStep = Math.max(ball.r * 2, 1e-3);
+  const steps = Math.max(1, Math.ceil(dist / maxStep));
+
+  let bounced = false;
+  for (let i = 0; i <= steps && !bounced; i++) {
+    const t = i / steps;
+    ball.x = prevX + dx * t;
+    ball.y = prevY + dy * t;
+
+    // Sweep the sample: destroy every brick the ball overlaps here. The first
+    // overlapping brick doubles as the reference face for the single bounce.
+    let ref = null;
+    for (const brick of bricks) {
+      if (!brick.alive) continue;
+      if (collides(ball, brick)) {
+        brick.alive = false;
+        if (state) {
+          state.combo += 1;
+          state.score += scoreForBrick(brick, state.combo);
+        }
+        if (!ref) ref = brick;
+      }
+    }
+    if (ref) {
+      hitBrick(ball, ref);
+      bounced = true;
+      break;
+    }
+  }
+  return bounced;
+}
