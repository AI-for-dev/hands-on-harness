+// --- Issue #1: the ball bounces off bricks ---------------------------------
+
+// A single live brick centred at (0,0) --- convenient geometry for tests.
+function oneBrick() {
+  return [{ x: 0, y: 0, w: 100, h: 20, alive: true, row: 0, points: 10 }];
+}
+
+// A ball helper that mixes the current position with a starting (prev) point.
+function movingBall(cx, cy, px, py, vx, vy) {
+  return { x: cx, y: cy, r: 7, vx, vy, prevX: px, prevY: py };
+}
+
+// --- per face -------------------------------------------------------------
+
+test('brickHit: top-face hit flips vy and pushes the ball above the brick', () => {
+  // Ball falling straight down onto the brick's top face.
+  const ball = movingBall(50, 0, 50, -20, 0, 300);
+  const bricks = oneBrick();
+  brickHit(ball, bricks);
+  assert.equal(ball.vy, -300, 'vy should flip to UP (-300)');
+  assert.equal(ball.vx, 0, 'vx must be left exactly as it was');
+  assert.equal(bricks[0].alive, false, 'brick should be destroyed');
+  assert.ok(!collides(ball, bricks[0]), 'ball pushed out, no longer overlapping');
+});
+
+test('brickHit: bottom-face hit flips vy and pushes the ball below the brick', () => {
+  // Ball rising from below into the brick's bottom face.
+  const ball = movingBall(50, 20, 50, 40, 0, -300);
+  const bricks = oneBrick();
+  brickHit(ball, bricks);
+  assert.equal(ball.vy, 300, 'vy should flip to DOWN (+300)');
+  assert.equal(ball.vx, 0, 'vx must be left exactly as it was');
+  assert.ok(!collides(ball, bricks[0]), 'ball pushed out below the brick');
+});
+
+test('brickHit: left-side hit flips vx and leaves vy unchanged', () => {
+  // Ball travelling right into the brick's left face (vy > 0 preserved).
+  const ball = movingBall(0, 10, -20, 10, 200, 50);
+  const bricks = oneBrick();
+  brickHit(ball, bricks);
+  assert.equal(ball.vx, -200, 'vx should flip to LEFT (-200)');
+  assert.equal(ball.vy, 50, 'vy must be left exactly as it was');
+  assert.equal(bricks[0].alive, false);
+  assert.ok(!collides(ball, bricks[0]), 'ball pushed out to the left');
+});
+
+// --- corner ---------------------------------------------------------------
+
+test('brickHit: corner hit (equal penetrations) flips both components', () => {
+  // Ball lands exactly on the brick's top-left corner, diagonal approach.
+  const ball = movingBall(0, 0, 0.1, 0.1, 100, 100);
+  const bricks = oneBrick();
+  brickHit(ball, bricks);
+  assert.equal(ball.vx, -100, 'vx flipped by the diagonal hit');
+  assert.equal(ball.vy, -100, 'vy flipped by the diagonal hit');
+  assert.equal(bricks[0].alive, false);
+});
+
+// --- push out -------------------------------------------------------------
+
+test('brickHit: bounce happens only once at a seam (neighbours overlap)', () => {
+  // Two bricks separated by the 8 px grid gap; the 14 px ball overlaps BOTH at
+  // once while coming down through the seam. The bounce must apply exactly
+  // once (a double `vy = -vy` would cancel out and the ball would sail on).
+  const bricks = [
+    { x: 0, y: 0, w: 50, h: 20, alive: true, row: 0, points: 10 },
+    { x: 58, y: 0, w: 50, h: 20, alive: true, row: 0, points: 10 },
+  ];
+  const ball = movingBall(54, 0, 54, -30, 0, 300);
+  brickHit(ball, bricks);
+  assert.equal(bricks[0].alive, false, 'left brick destroyed');
+  assert.equal(bricks[1].alive, false, 'right brick destroyed');
+  assert.equal(ball.vy, -300, 'vy flipped exactly once (UP = -300), not cancelling');
+});
+
+// --- tunnelling -----------------------------------------------------------
+
+test('brickHit: high-speed step that would tunnel is caught by the sweep', () => {
+  // A single huge step: the ball starts above the brick and finishes fully
+  // below it (past the whole 20 px brick), so a discrete end-position check
+  // would never touch the brick. The sweep must still register the hit.
+  const ball = { x: 50, y: 30, r: 7, vx: 0, vy: 600, prevX: -20, prevY: -30 };
+  const bricks = oneBrick();
+  brickHit(ball, bricks);
+  assert.equal(bricks[0].alive, false, 'brick destroyed despite tunnelling step');
+  assert.equal(ball.vy, -600, 'vy flipped (bounced upward)');
+});
+
