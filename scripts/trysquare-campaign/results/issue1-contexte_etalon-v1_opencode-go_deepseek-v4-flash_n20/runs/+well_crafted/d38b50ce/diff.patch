+// --- Brick bounce & swept collision (issue #1) ------------------------------
+
+// Pushes the ball out of `brick` and flips the velocity component(s) for the
+// face(s) actually hit.
+//
+// By convention the axis with the SMALLER penetration is the face that was
+// hit: a top/bottom penetration flips `vy`, a left/right one flips `vx`, and
+// the other component is left EXACTLY as it was. A (near) tie across both axes
+// means a diagonal/corner hit, in which case BOTH components are flipped.
+//
+// The ball is always repacked just outside the hit face (push out), otherwise
+// it still overlaps on the next frame and the bounce would re-fire forever
+// (the "sticky bounce"). Mutates `ball` in place.
+function resolveBounce(ball, brick) {
+  const top = ball.y + ball.r - brick.y; // ball overlaps the brick's TOP face
+  const bottom = brick.y + brick.h - (ball.y - ball.r);
+  const left = ball.x + ball.r - brick.x;
+  const right = brick.x + brick.w - (ball.x - ball.r);
+
+  const minV = Math.min(top, bottom);
+  const minH = Math.min(left, right);
+  const corner = Math.abs(minV - minH) <= 1e-6;
+
+  if (corner || minV <= minH) {
+    const fromTop = top < bottom;
+    ball.vy = fromTop ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+    ball.y = fromTop ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  }
+  if (corner || minH < minV) {
+    const fromLeft = left < right;
+    ball.vx = fromLeft ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+    ball.x = fromLeft ? brick.x - ball.r : brick.x + brick.w + ball.r;
+  }
+}
+
+// Resolves the ball against the brick grid for one frame.
+//
+// The ball sweeps the segment from `ball.prevX/prevY` (where `step()` left it
+// before the move) to its current position, so a fast / stuttered frame cannot
+// tunnel through a brick without ever touching it (#1). On the FIRST sample at
+// which the sweep overlaps a live brick it destroys every brick overlapped
+// there (the ball is 14 px across while the grid gap is 8 px, so a seam
+// overlaps two bricks in the same pass) and applies the bounce EXACTLY once —
+// a naive `vy = -vy` per brick would double-flip and the ball would sail
+// through. Returns the array of destroyed bricks (scoring is the caller's job).
+export function brickHit(ball, bricks) {
+  const p0x = ball.prevX ?? ball.x;
+  const p0y = ball.prevY ?? ball.y;
+  const dx = ball.x - p0x;
+  const dy = ball.y - p0y;
+  const dist = Math.hypot(dx, dy);
+  // Sample at least every `BALL_R` px so a 20 px-thick brick is never skipped.
+  const segments = Math.max(1, Math.ceil(dist / BALL_R));
+
+  const destroyed = [];
+  let bounced = false;
+
+  for (let s = 1; s <= segments; s++) {
+    const t = s / segments;
+    const cx = p0x + dx * t;
+    const cy = p0y + dy * t;
+
+    let hitArea = false;
+    let best = null;
+    let bestDepth = Infinity;
+    for (const brick of bricks) {
+      if (!brick.alive) continue;
+      if (!collides({ x: cx, y: cy, r: ball.r }, brick)) continue;
+
+      brick.alive = false;
+      hitArea = true;
+      destroyed.push(brick);
+
+      // pick the brick with the smallest piercing face as the bounce surface.
+      const depth = Math.min(
+        cy + ball.r - brick.y,
+        brick.y + brick.h - (cy - ball.r),
+        cx + ball.r - brick.x,
+        brick.x + brick.w - (cx - ball.r)
+      );
+      if (depth < bestDepth) {
+        bestDepth = depth;
+        best = brick;
+      }
+    }
+
+    // First contact along the path: park the ball there, bounce once, and stop
+    // sweeping — the ball reflects, it no longer travels the rest of the arc.
+    if (hitArea && !bounced) {
+      ball.x = cx;
+      ball.y = cy;
+      resolveBounce(ball, best);
+      bounced = true;
+      break;
+    }
+  }
+
+  return destroyed;
+}
