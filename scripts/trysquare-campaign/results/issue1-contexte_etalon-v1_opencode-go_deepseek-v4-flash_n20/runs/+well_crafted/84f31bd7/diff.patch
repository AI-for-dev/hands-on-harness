+// Circle/AABB overlap test at an explicit centre. `collides` reads the ball's
+// live x/y, but brickHit sweeps the path and needs to ask about intermediate
+// positions, so the centre is passed in.
+function overlaps(x, y, r, brick) {
+  return (
+    x + r > brick.x &&
+    x - r < brick.x + brick.w &&
+    y + r > brick.y &&
+    y - r < brick.y + brick.h
+  );
+}
+
+// Resolve a single bounce against one brick, honouring the per-face rule:
+// the axis with the *smaller* penetration is the face that was hit (corner: the
+// two smallest penetrations are equal and both components are flipped), and the
+// ball is pushed back OUT of the rectangle so it cannot re-overlap next frame
+// (the sticky-bounce trap).
+function resolveBounce(ball, brick) {
+  const r = ball.r;
+
+  // Penetration depth through each of the four faces.
+  const penLeft = ball.x + r - brick.x;
+  const penRight = brick.x + brick.w - (ball.x - r);
+  const penTop = ball.y + r - brick.y;
+  const penBottom = brick.y + brick.h - (ball.y - r);
+  const minPen = Math.min(penLeft, penRight, penTop, penBottom);
+
+  // Faces sitting on the smallest penetration are the ones actually hit.
+  const faces = [];
+  if (penLeft === minPen) faces.push('left');
+  if (penRight === minPen) faces.push('right');
+  if (penTop === minPen) faces.push('top');
+  if (penBottom === minPen) faces.push('bottom');
+
+  const horizontal = faces.includes('left') || faces.includes('right');
+  const vertical = faces.includes('top') || faces.includes('bottom');
+
+  if (horizontal && vertical) {
+    // Corner / diagonal hit: flip both components.
+    ball.vx = faces.includes('left') ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+    ball.vy = faces.includes('top') ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+    ball.x = faces.includes('left') ? brick.x - r : brick.x + brick.w + r;
+    ball.y = faces.includes('top') ? brick.y - r : brick.y + brick.h + r;
+  } else if (horizontal) {
+    if (faces.includes('left')) {
+      ball.vx = -Math.abs(ball.vx);
+      ball.x = brick.x - r;
+    } else {
+      ball.vx = Math.abs(ball.vx);
+      ball.x = brick.x + brick.w + r;
+    }
+  } else {
+    if (faces.includes('top')) {
+      ball.vy = -Math.abs(ball.vy);
+      ball.y = brick.y - r;
+    } else {
+      ball.vy = Math.abs(ball.vy);
+      ball.y = brick.y + brick.h + r;
+    }
+  }
+}
+
+// Pure brick collision resolution (issue #1/#2). Given the ball and the brick
+// grid, it:
+//   - sweeps the ball's path from its PREVIOUS position (px/py) to its current
+//     one, so a fast ball cannot tunnel straight over a brick;
+//   - bounces the ball exactly ONCE against the first face it meets, even when
+//     a seam (8 px gap < 14 px ball) overlaps several bricks in the same pass;
+//   - pushes the ball out of the rectangle to avoid a sticky re-flip;
+//   - marks every brick overlapped at that instant dead.
+// Returns the destroyed bricks so the caller can credit the score/combo. It
+// leaves the rendering and scoring entirely to the caller.
+export function brickHit(ball, bricks) {
+  const r = ball.r;
+  const x0 = ball.px !== undefined ? ball.px : ball.x;
+  const y0 = ball.py !== undefined ? ball.py : ball.y;
+  const dx = ball.x - x0;
+  const dy = ball.y - y0;
+  // Sub-step finely enough (<= 5 px) that the circle, of diameter 14, cannot
+  // skip over a 20 px tall brick even at max speed (35.5 px per capped frame).
+  const steps = Math.max(1, Math.ceil(Math.hypot(dx, dy) / 5));
+
+  const destroyed = [];
+  let bounced = false;
+
+  for (let i = 0; i <= steps && !bounced; i++) {
+    const cx = x0 + (dx * i) / steps;
+    const cy = y0 + (dy * i) / steps;
+
+    for (const brick of bricks) {
+      if (!brick.alive) continue;
+      if (!overlaps(cx, cy, r, brick)) continue;
+
+      if (!bounced) {
+        // Snap the ball to the first contact point, then resolve the bounce.
+        ball.x = cx;
+        ball.y = cy;
+        resolveBounce(ball, brick);
+        bounced = true;
+      }
+      if (brick.alive) {
+        brick.alive = false;
+        destroyed.push(brick);
+      }
+    }
+  }
+
+  return destroyed;
+}
