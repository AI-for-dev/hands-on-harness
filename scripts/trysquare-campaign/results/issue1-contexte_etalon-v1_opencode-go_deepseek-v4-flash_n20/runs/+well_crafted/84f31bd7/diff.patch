+// --- #1: brick bounce ---------------------------------------------
+// Issue #1 asked for every case to land as a (red) test first, then go green:
+// per-face, corner, push-out, neighbours (bounce exactly once), tunnelling.
+
+function brick(x, y, w = 72, h = 20) {
+  return { x, y, w, h, alive: true };
+}
+
+// A ball with a previous position (px, py) and a current position. step()
+// records px/py for real play; tests that want to focus on geometry set them
+// directly so brickHit() can sweep the right segment.
+function sweptBall(x, y, px, py, r = 7, vx = 0, vy = 0) {
+  return { x, y, px, py, r, vx, vy };
+}
+
+test('brickHit: top face flips vy, pushes ball out above the brick', () => {
+  const b = brick(100, 100);
+  // Ball moving down, its leading edge reaches the brick's top.
+  const ball = sweptBall(136, 120, 136, 90, 7, 0, 300);
+  const destroyed = brickHit(ball, [b]);
+
+  assert.equal(destroyed.length, 1);
+  assert.ok(ball.vy < 0, 'vertical velocity should flip upward');
+  assert.equal(ball.vx, 0, 'side component is untouched on a top hit');
+  assert.equal(Math.round(ball.y), b.y - ball.r, 'ball pushed out above the brick');
+});
+
+test('brickHit: bottom face flips vy, pushes ball out below the brick', () => {
+  const b = brick(100, 100);
+  // Ball moving up toward the brick's bottom edge.
+  const ball = sweptBall(136, 96, 136, 124, 7, 0, -300);
+  const destroyed = brickHit(ball, [b]);
+
+  assert.equal(destroyed.length, 1);
+  assert.ok(ball.vy > 0, 'vertical velocity should flip downward');
+  assert.equal(ball.vx, 0, 'side component is untouched on a bottom hit');
+  assert.equal(Math.round(ball.y), b.y + b.h + ball.r, 'ball pushed out below the brick');
+});
+
+test('brickHit: left face flips vx, ball pushed out to the left', () => {
+  const b = brick(100, 100);
+  // Ball moving right into the brick's left face.
+  const ball = sweptBall(95, 110, 80, 110, 7, 300, 0);
+  const destroyed = brickHit(ball, [b]);
+
+  assert.equal(destroyed.length, 1);
+  assert.ok(ball.vx < 0, 'horizontal velocity should flip to the left');
+  assert.equal(ball.vy, 0, 'vertical component is untouched on a side hit');
+  assert.equal(Math.round(ball.x), b.x - ball.r, 'ball pushed out to the left');
+});
+
+test('brickHit: right face flips vx, ball pushed out to the right', () => {
+  const b = brick(100, 100);
+  // Ball moving left into the brick's right face.
+  const ball = sweptBall(170, 110, 200, 110, 7, -300, 0);
+  const destroyed = brickHit(ball, [b]);
+
+  assert.equal(destroyed.length, 1);
+  assert.ok(ball.vx > 0, 'horizontal velocity should flip to the right');
+  assert.equal(ball.vx > 0, true);
+  assert.equal(ball.x, b.x + b.w + ball.r, 'ball pushed out to the right');
+});
+
+test('brickHit: corner with equal penetrations flips both components', () => {
+  const b = brick(100, 100);
+  // Ball centred near the upper-left corner: penLeft === penTop, both smallest.
+  const ball = sweptBall(103, 103, 90, 90, 7, 50, 50);
+  const destroyed = brickHit(ball, [b]);
+
+  assert.equal(destroyed.length, 1);
+  assert.ok(ball.vx < 0, 'corner hit flips the horizontal component');
+  assert.ok(ball.vy < 0, 'corner hit flips the vertical component');
+});
+
+test('brickHit: one bounce when the disc straddles a seam of two bricks', () => {
+  const left = brick(100, 100);   // x: 100..172
+  const right = brick(180, 100);  // x: 180..252 (8 px gap between 172 and 180)
+  // 14 px ball sitting in the 8 px seam overlaps BOTH bricks at once; the
+  // bounce must apply exactly once, not cancel out by flipping back and forth.
+  const ball = sweptBall(176, 110, 176, 110, 7, -400, 0);
+  const destroyed = brickHit(ball, [left, right]);
+
+  assert.equal(destroyed.length, 2, 'both seam bricks are broken');
+  assert.equal(left.alive, false);
+  assert.equal(right.alive, false);
+  assert.ok(ball.vx > 0, 'vx flipped once (back toward the right), not twice (which would leave it negative)');
+  assert.equal(ball.vy, 0, 'vertical component untouched on a lateral seam hit');
+});
+
+test('brickHit: high-speed sweep catches a tunnelling pass', () => {
+  // Level 6 speed is 710 px/s and a capped frame moves ~35.5 px — more than the
+  // ~34 px (BRICK_H + diameter) needed to jump a brick. A discrete check at the
+  // final position would miss it; the sweep must not.
+  const b = brick(100, 100);
+  // From above the brick (80) to just past its bottom (140) in one step.
+  const ball = sweptBall(136, 140, 136, 80, 7, 0, 1000);
+  const destroyed = brickHit(ball, [b]);
+
+  assert.equal(destroyed.length, 1, 'tunnelling ball still hits the brick');
+  assert.ok(ball.vy < 0, 'ball rebounds upward after the swept hit');
+});
