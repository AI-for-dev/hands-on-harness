+// --- Brick collision (issue #1, #2) ----------------------------------------
+
+// Sweeps the ball (a circle of radius `r`) along the segment from (px,py) to
+// (x,y) against a brick's AABB inflated by the ball radius. Returns the time of
+// entry `t` in [0,1] along that segment plus the face that was struck, or null
+// when the segment never touches the brick. This gives us tunnelling for free:
+// even if the ball's *final* position is beyond the brick, we still see the
+// crossing at `t` (a level-6 ball at ~35.5 px/step can clear a row's 34 px).
+function sweepBall(px, py, x, y, r, brick) {
+  const dx = x - px;
+  const dy = y - py;
+  const minX = brick.x - r;
+  const maxX = brick.x + brick.w + r;
+  const minY = brick.y - r;
+  const maxY = brick.y + brick.h + r;
+
+  let tExit = 1;
+  let tX = null;
+  let tY = null;
+
+  if (dx !== 0) {
+    let t1 = (minX - px) / dx;
+    let t2 = (maxX - px) / dx;
+    if (t1 > t2) {
+      const tmp = t1; t1 = t2; t2 = tmp;
+    }
+    tX = Math.max(0, t1);
+    tExit = Math.min(tExit, t2);
+  } else if (px < minX || px > maxX) {
+    return null; // x is constant and outside the slab: the ball never enters
+  } else {
+    tX = 0;
+  }
+
+  if (dy !== 0) {
+    let t1 = (minY - py) / dy;
+    let t2 = (maxY - py) / dy;
+    if (t1 > t2) {
+      const tmp = t1; t1 = t2; t2 = tmp;
+    }
+    tY = Math.max(0, t1);
+    tExit = Math.min(tExit, t2);
+  } else if (py < minY || py > maxY) {
+    return null; // y constant and outside the slab
+  } else {
+    tY = 0;
+  }
+
+  const tEnter = Math.max(tX, tY);
+  if (tEnter < 0 || tEnter > 1 || tEnter > tExit) return null;
+
+  const hitX = tEnter === tX;
+  const hitY = tEnter === tY;
+  const face = hitX && hitY ? 'both' : hitX ? 'x' : 'y';
+  return { t: tEnter, face };
+}
+
+// Resolves the ball against a grid of bricks for one frame step: it sweeps the
+// ball from its previous position (ball.px / ball.py, recorded by step()) to
+// its current one, finds the *nearest* brick hit, reflects the velocity on the
+// struck face(s) and pushes the ball back outside the brick so it cannot
+// re-collide on the following frame (no sticky bounce).
+//
+// Only the single nearest brick is resolved. That is what prevents a seam
+// double-bounce: the 8 px gap and the 14 px ball overlap two bricks in the same
+// pass, and flipping vy once per brick would cancel out and let the ball pass
+// straight through. Resolving exactly one brick keeps the rebound.
+//
+// * per face: the struck axis is flipped, the other component is left untouched
+// * corner (equal penetration => both t equal): both components flip
+//
+// Returns the index of the destroyed brick, or -1 if nothing was hit.
+export function brickHit(ball, bricks) {
+  const px = ball.px != null ? ball.px : ball.x;
+  const py = ball.py != null ? ball.py : ball.y;
+
+  let bestIndex = -1;
+  let bestT = Infinity;
+  let bestFace = null;
+
+  for (let i = 0; i < bricks.length; i++) {
+    const brick = bricks[i];
+    if (!brick.alive) continue;
+    const hit = sweepBall(px, py, ball.x, ball.y, ball.r, brick);
+    if (hit && hit.t >= 0 && hit.t < bestT) {
+      bestT = hit.t;
+      bestIndex = i;
+      bestFace = hit.face;
+    }
+  }
+
+  if (bestIndex === -1) return -1;
+
+  const brick = bricks[bestIndex];
+
+  // Land the ball exactly at the contact point, then reflect & push out.
+  const ex = px + (ball.x - px) * bestT;
+  const ey = py + (ball.y - py) * bestT;
+  ball.x = ex;
+  ball.y = ey;
+
+  if (bestFace !== 'y') {
+    // side face (or corner): horizontal component flips
+    ball.vx = -ball.vx;
+    if (ball.vx > 0) ball.x = brick.x + brick.w + ball.r + 0.01;
+    else ball.x = brick.x - ball.r - 0.01;
+  }
+  if (bestFace !== 'x') {
+    // top/bottom face (or corner): vertical component flips
+    ball.vy = -ball.vy;
+    if (ball.vy > 0) ball.y = brick.y + brick.h + ball.r + 0.01;
+    else ball.y = brick.y - ball.r - 0.01;
+  }
+
+  return bestIndex;
+}
