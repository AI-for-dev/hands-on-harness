+// --- Issue #1: brick bounce ------------------------------------------------
+
+// A helper brick with a fixed, predictable position for the collision cases.
+const b = () => ({ x: 100, y: 100, w: 40, h: 20, alive: true });
+
+function hitBall(px, py, x, y, vx, vy, bricks) {
+  const ball = { px, py, x, y, vx, vy, r: 7 };
+  const idx = brickHit(ball, bricks);
+  return { ball, idx };
+}
+
+test('brickHit: horizontal side hit flips vx, leaves vy alone', () => {
+  const brick = b();
+  const { ball, idx } = hitBall(50, 110, 95, 110, 600, 0, [brick]);
+  assert.equal(idx, 0, 'the brick must be the one struck');
+  assert.equal(ball.vx, -600, 'vx flips on a side hit');
+  assert.equal(ball.vy, 0, 'vy is left exactly as it was on a side hit');
+});
+
+test('brickHit: vertical top/bottom hit flips vy, leaves vx alone', () => {
+  const brick = b();
+  const { ball, idx } = hitBall(120, 140, 120, 120, 0, -600, [brick]);
+  assert.equal(idx, 0);
+  assert.equal(ball.vy, 600, 'vy flips on a top/bottom hit');
+  assert.equal(ball.vx, 0, 'vx is left exactly as it was on a top/bottom hit');
+});
+
+test('brickHit: corner hit (equal penetration) flips both axes', () => {
+  const brick = b();
+  const { ball, idx } = hitBall(53, 53, 93, 93, 500, 500, [brick]);
+  assert.equal(idx, 0);
+  assert.equal(ball.vx, -500, 'vx flips at the corner');
+  assert.equal(ball.vy, -500, 'vy flips at the corner');
+});
+
+test('brickHit: ball is pushed back outside the brick (no sticky bounce)', () => {
+  const brick = b();
+  const { ball } = hitBall(50, 110, 95, 110, 600, 0, [brick]);
+  assert.equal(collides(ball, brick), false, 'after resolution the ball must not overlap');
+  // pushed out on the left face (the one it entered), just clearing the radius
+  assert.ok(ball.x + ball.r <= brick.x + 0.01, 'ball sits outside the left face');
+});
+
+test('brickHit: neighbours hitting the same seam bounce exactly once', () => {
+  // Two bricks side by side separated by the 8 px grid gap; the 14 px ball
+  // spans the gap and overlaps both at the same time.
+  const left = { x: 100, y: 100, w: 40, h: 20, alive: true }; // right edge 140
+  const right = { x: 148, y: 100, w: 40, h: 20, alive: true }; // left edge 148
+  const bricks = [left, right];
+  const { ball, idx } = hitBall(144, 130, 144, 124, 0, -600, bricks);
+  assert.ok(idx === 0 || idx === 1, 'one of the two seam bricks is struck');
+  // vy must flip exactly once, not twice (which would cancel and plow through)
+  assert.equal(ball.vy, 600, 'a seam hit reflects once');
+});
+
+test('brickHit: fast ball that tunnels right through still bounces', () => {
+  // The ball jumps from below a row to above it in one step (final position no
+  // longer overlaps), but the sweep catches the crossing.
+  const brick = b();
+  const { ball, idx } = hitBall(120, 140, 120, 70, 0, -700, [brick]);
+  assert.equal(idx, 0, 'tunnelling ball still registers a hit');
+  assert.equal(ball.vy, 700, 'and it bounces back downward');
+});
+
+test('brickHit: clear miss for a ball moving away', () => {
+  const brick = b();
+  const { idx } = hitBall(300, 300, 320, 310, 200, 50, [brick]);
+  assert.equal(idx, -1, 'a ball far away hits nothing');
+});
+
+test('brickHit: a destroyed (dead) brick is never struck', () => {
+  const dead = { x: 100, y: 100, w: 40, h: 20, alive: false };
+  const { idx } = hitBall(50, 110, 95, 110, 600, 0, [dead]);
+  assert.equal(idx, -1);
+});
+
