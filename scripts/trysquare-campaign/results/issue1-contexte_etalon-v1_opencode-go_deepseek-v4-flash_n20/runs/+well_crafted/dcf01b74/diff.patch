+  // Previous position fully to the left; current position fully to the right:
+  // a naive position-only collision would MISS the brick entirely.
+  const b = { x: 160, y: 110, r: 7, vx: 300, vy: 0, px: 30, py: 110 };
+  const broken = brickHit(b, [brick]);
+  assert.equal(broken.length, 1, 'swept detection still hits the brick');
+  assert.equal(brick.alive, false);
+  assert.ok(b.vx < 0, 'side bounce flips the ball back to the left');
+});
+
+// No overlap anywhere: nothing destroyed, nothing mutated.
