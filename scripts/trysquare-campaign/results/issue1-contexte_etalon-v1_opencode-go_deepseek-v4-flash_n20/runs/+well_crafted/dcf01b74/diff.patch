+// --- Brick bounce (#1) ------------------------------------------------------
+
+// A single 40x20 brick sitting at (100,100), plus a helper that builds a ball.
+function oneBrick(x = 100, y = 100, w = 40, h = 20) {
+  return { x, y, w, h, row: 0, alive: true, points: 50 };
+}
+function ball(over, vx, vy) {
+  return { x: over.x, y: over.y, r: 7, vx, vy, px: over.px, py: over.py };
+}
+
+// Top/bottom hit: the ball climbs into the bottom face of a brick and must
+// bounce DOWN. The horizontal component must be left untouched.
+test('brickHit: bottom face -> vy flips, vx untouched, ball pushed out', () => {
+  const brick = oneBrick(); // occupies y in [100,120]
+  const b = ball(
+    { x: 120, y: 113, px: 120, py: 130 }, // moving up (vy < 0) into the bottom face
+    -300,
+    -300,
+  );
+  const broken = brickHit(b, [brick]);
+  assert.equal(broken.length, 1);
+  assert.equal(brick.alive, false);
+  assert.ok(b.vy > 0, 'vertical velocity should flip to downwards');
+  assert.equal(b.vx, -300, 'horizontal velocity stays exactly as before');
+  // Push out below the brick and no longer overlapping.
+  assert.ok(b.y + b.r >= 120, 'ball sits right below the brick');
+  assert.equal(collides(b, brick), false);
+});
+
+// Side hit: the ball enters from the left into the side face of a brick and
+// must bounce LEFT. The vertical component must be left untouched.
+test('brickHit: side face -> vx flips, vy untouched, ball pushed out', () => {
+  const brick = oneBrick(); // occupies x in [100,140]
+  const b = ball(
+    { x: 103, y: 110, px: 50, py: 110 }, // moving right (vx > 0) into the left face
+    300,
+    55,
+  );
+  const broken = brickHit(b, [brick]);
+  assert.equal(broken.length, 1);
+  assert.equal(brick.alive, false);
+  assert.ok(b.vx < 0, 'horizontal velocity should flip to the left');
+  assert.equal(b.vy, 55, 'vertical velocity stays exactly as before');
+  assert.ok(b.x + b.r <= 100, 'ball sits right to the left of the brick');
+  assert.equal(collides(b, brick), false);
+});
+
+// Corner hit: equal penetration on both axes means a diagonal hit, so BOTH
+// components flip and the ball is pushed out diagonally.
+test('brickHit: corner hit -> both components flip', () => {
+  const brick = oneBrick();
+  const b = ball(
+    { x: 95, y: 95, px: 88, py: 88 }, // enters the top-left corner
+    300,
+    -300,
+  );
+  const broken = brickHit(b, [brick]);
+  assert.equal(broken.length, 1);
+  assert.equal(brick.alive, false);
+  assert.equal(b.vx, -300, 'vx should flip to the left');
+  assert.equal(b.vy, 300, 'vy should flip to downwards');
+  assert.ok(b.x + b.r <= 100 && b.y + b.r <= 100, 'pushed out to the top-left');
+  assert.equal(collides(b, brick), false);
+});
+
+// Push out: whichever face is hit, the ball must end up NOT overlapping the
+// brick, otherwise it would re-collide next frame and bounce forever.
+test('brickHit: never leaves the ball overlapping (no sticky bounce)', () => {
+  for (const spec of [
+    { x: 120, y: 113, px: 120, py: 130, vx: -300, vy: -300 }, // bottom
+    { x: 103, y: 110, px: 50, py: 110, vx: 300, vy: 55 }, // left
+  ]) {
+    const brick = oneBrick();
+    const b = ball(spec, spec.vx, spec.vy);
+    const broken = brickHit(b, [brick]);
+    assert.equal(broken.length, 1);
+    assert.equal(collides(b, brick), false, 'ball must be fully pushed out');
+  }
+});
+
+// Neighbours: a ball straddling the vertical seam between two side-by-side
+// bricks overlaps BOTH in the same pass. The bounce must be applied exactly
+// once (no double-flip cancellation: vy = -vy twice would send the ball straight
+// through), and both bricks must break.
+test('brickHit: seam between two bricks bounces once, destroys both', () => {
+  const a = oneBrick(100, 100); // right edge 140
+  const bB = oneBrick(148, 100); // left edge 148, 8px gap
+  const b = { x: 144, y: 110, r: 7, vx: 300, vy: -100, px: 144, py: 110 };
+  const broken = brickHit(b, [a, bB]);
+  assert.equal(broken.length, 2, 'both bricks broken in one pass');
+  assert.equal(a.alive, false);
+  assert.equal(bB.alive, false);
+  // The merged bounce flips the vertical component exactly ONCE (from -100 to
+  // +100); double-flip cancellation would leave it unchanged at -100.
+  assert.equal(b.vy, 100);
+  assert.equal(b.vx, 300, 'horizontal component left untouched by the bounce');
+});
