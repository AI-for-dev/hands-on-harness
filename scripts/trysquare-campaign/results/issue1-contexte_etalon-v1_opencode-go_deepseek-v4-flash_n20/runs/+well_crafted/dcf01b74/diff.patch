+// Same AABB overlap test as collides(), but evaluated with the ball CENTERED at
+// an arbitrary (x, y) instead of its stored position. Used by brickHit() while
+// sweeping along the ball's path (see tunnelling, ISSUES.md #1).
+function collidesAt(ball, brick, x, y) {
+  return (
+    x + ball.r > brick.x &&
+    x - ball.r < brick.x + brick.w &&
+    y + ball.r > brick.y &&
+    y - ball.r < brick.y + brick.h
+  );
+}
+
+// Resolves every brick the ball touches during this step (pure, testable — see
+// #1 and #2). Mutates `ball` (position + velocity) and marks the touched bricks
+// dead. Returns the array of destroyed bricks so the caller can score them.
+//
+// Robustness matters here and is what makes the ball feel "arcade-worthy":
+//   - per face: the axis with the SMALLER penetration is the face that was hit;
+//     flip vy on a top/bottom hit, vx on a side hit, both on a corner;
+//   - push out: the ball is repositioned so it no longer overlaps, preventing a
+//     sticky bounce (re-flip forever);
+//   - neighbours: all bricks overlapped in the same pass are merged into one
+//     bounding box, so a ball straddling a seam bounces EXACTLY once (a naive
+//     per-brick flip would apply vy = -vy twice and send the ball straight
+//     through);
+//   - tunnelling: the path from the previous to the current position is
+//     sub-sampled, so a fast ball can never skip over a brick between frames.
+//
+// `ball.px` / `ball.py` are the ball's position at the start of the step
+// (recorded by step()); when absent they default to the current position.
+export function brickHit(ball, bricks) {
+  const px = Number.isFinite(ball.px) ? ball.px : ball.x;
+  const py = Number.isFinite(ball.py) ? ball.py : ball.y;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+
+  // Tunnelling guard: break the motion up into sub-steps small enough that the
+  // ball cannot clear a brick in a single jump.
+  const substeps = Math.max(1, Math.ceil((Math.abs(dx) + Math.abs(dy)) / 6));
+  const STEP_X = dx / substeps;
+  const STEP_Y = dy / substeps;
+
+  // Find the first point along the path that touches a live brick.
+  let cx = px;
+  let cy = py;
+  for (let s = 1; s <= substeps; s++) {
+    cx = px + STEP_X * s;
+    cy = py + STEP_Y * s;
+    if (bricks.some((b) => b.alive && collidesAt(ball, b, cx, cy))) break;
+  }
+
+  // Every brick overlapped at that point of first contact. Because each seam
+  // overlaps two bricks, they must all be resolved together.
+  const hit = bricks.filter((b) => b.alive && collidesAt(ball, b, cx, cy));
+  if (hit.length === 0) return [];
+
+  // Stop the ball at the point of first contact, then push it out.
+  ball.x = cx;
+  ball.y = cy;
+
+  // Merged bounding box of every brick being hit (handles the seams above).
+  let minX = Infinity;
+  let minY = Infinity;
+  let maxX = -Infinity;
+  let maxY = -Infinity;
+  for (const b of hit) {
+    if (b.x < minX) minX = b.x;
+    if (b.y < minY) minY = b.y;
+    if (b.x + b.w > maxX) maxX = b.x + b.w;
+    if (b.y + b.h > maxY) maxY = b.y + b.h;
+  }
+
+  const r = ball.r;
+  const leftPen = ball.x + r - minX;
+  const rightPen = maxX - (ball.x - r);
+  const topPen = ball.y + r - minY;
+  const bottomPen = maxY - (ball.y - r);
+  const overlapX = Math.min(leftPen, rightPen);
+  const overlapY = Math.min(topPen, bottomPen);
+  const corner = Math.abs(overlapX - overlapY) < 1e-6;
+
+  if (corner) {
+    // Diagonal hit: flip both components, push out on both axes.
+    ball.x = leftPen < rightPen ? minX - r : maxX + r;
+    ball.y = topPen < bottomPen ? minY - r : maxY + r;
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+  } else if (overlapX < overlapY) {
+    // Side hit: flip horizontal, leave vertical exactly as it was.
+    ball.x = leftPen < rightPen ? minX - r : maxX + r;
+    ball.vx = -ball.vx;
+  } else {
+    // Top/bottom hit: flip vertical, leave horizontal exactly as it was.
+    ball.y = topPen < bottomPen ? minY - r : maxY + r;
+    ball.vy = -ball.vy;
+  }
+
+  for (const b of hit) b.alive = false;
+  return hit;
+}
