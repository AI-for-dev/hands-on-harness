+  const brick = oneBrick();
+  const b = { x: 300, y: 300, r: 7, vx: 300, vy: 300, px: 280, py: 280 };
+  const broken = brickHit(b, [brick]);
+  assert.equal(broken.length, 0);
+  assert.equal(brick.alive, true);
+  assert.equal(b.vx, 300);
+  assert.equal(b.vy, 300);
+});
