+// --- Brick bounce: issue #1 -------------------------------------------------
+
+// A ball falling onto a brick from above must lose its downward speed and come
+// to rest just above the brick's top face (per-face vy flip + push-out).
+
+test('bounceBricks: ball bounced off the TOP face of a brick', () => {
+  const brickObj = brick(200, 100);
+  const ball = { x: 236, y: 140, r: 7, vx: 0, vy: 300 }; // center just over the brick
+  const prevX = ball.x, prevY = ball.y - 40; // coming straight down
+  bounceBricks(ball, [brickObj], prevX, prevY);
+  assert.ok(ball.vy < 0, 'vertical velocity should flip up');
+  assert.equal(ball.vx, 0, 'horizontal component must survive untouched');
+  assert.ok(ball.y + ball.r <= brickObj.y, 'ball should be pushed above the brick');
+  assert.equal(brickObj.alive, false, 'brick should be broken');
+});
+
+test('bounceBricks: ball bounced off the BOTTOM face of a brick', () => {
+  const brickObj = brick(200, 100);
+  // Ball below the brick (brick spans y 100..120), moving up into its bottom.
+  const ball = { x: 236, y: 126, r: 7, vx: 0, vy: -300 };
+  const prevX = ball.x, prevY = ball.y + 40;
+  bounceBricks(ball, [brickObj], prevX, prevY);
