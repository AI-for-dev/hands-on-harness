+// True if a circle centred on (x, y) with radius r overlaps the brick.
+// Same AABB test as `collides`, but position is passed explicitly so we can
+// test intermediate sweep positions without mutating the ball (see #1).
+function overlaps(x, y, r, brick) {
+  return (
+    x + r > brick.x &&
+    x - r < brick.x + brick.w &&
+    y + r > brick.y &&
+    y - r < brick.y + brick.h
+  );
+}
+
+// Treat two penetrations as a genuine diagonal corner hit instead of a clean
+// side or top/bottom hit (see #1 "corner").
+const CORNER_EPS = 0.5;
+
+// --- Brick bounce (pure, tested) ------------------------------------------
+//
+// Resolves the ball's movement from its previous position (`prevX`,`prevY`) to
+// its current position against the live bricks. Returns the list of bricks that
+// were broken as a result.
+//
+// Every requirement of issue #1 is handled here:
+//   * per-face    — the axis with the smaller penetration selects the face that
+//                   was hit; only that velocity component is flipped;
+//   * corner      — equal penetration flips both components;
+//   * push out    — the ball is repositioned just outside the brick so it never
+//                   overlaps on the next frame (no sticky bounce);
+//   * neighbours  — a seam lets the ball touch two bricks at once; each velocity
+//                   axis is flipped at most once per resolution, so a seam bounce
+//                   can't double-negate and cancel out;
+//   * tunnelling  — the path from prev to current is swept in fine substeps (each
+//                   shorter than the ball's radius) so a fast ball can never jump
+//                   clear across a brick between two frames.
+//
+export function bounceBricks(ball, bricks, prevX, prevY) {
+  // No previous position recorded (e.g. direct test call): nothing to sweep
+  // against, fall back to the current resting spot.
+  if (!Number.isFinite(prevX) || !Number.isFinite(prevY)) {
+    prevX = ball.x;
+    prevY = ball.y;
+  }
+
+  const dx = ball.x - prevX;
+  const dy = ball.y - prevY;
+  const dist = Math.hypot(dx, dy);
+
+  // Sweep resolution: each substep moves the ball at most one radius, which is
+  // far smaller than the thinnest crossing (BRICK_H + diameter = 34 px).
+  const steps = Math.max(1, Math.ceil(dist / Math.max(ball.r, 0.5)));
+  let sx = dx / steps;
+  let sy = dy / steps;
+
+  let wx = prevX;
+  let wy = prevY;
+  const broken = [];
+
+  for (let i = 0; i < steps; i++) {
+    wx += sx;
+    wy += sy;
+    const [rx, ry, bounced] = resolveStep(wx, wy, ball, bricks, broken);
+    wx = rx;
+    wy = ry;
+    // Only after an actual bounce does the velocity change, so we reposition
+    // the remaining substeps along the NEW heading. This stops the ball from
+    // re-entering a brick along its original incoming direction.
+    if (bounced) {
+      const mag = Math.hypot(sx, sy);
+      const nMag = Math.hypot(ball.vx, ball.vy);
+      if (mag > 0 && nMag > 0) {
+        sx = (ball.vx / nMag) * mag;
+        sy = (ball.vy / nMag) * mag;
+      }
+    }
+  }
+
+  ball.x = wx;
+  ball.y = wy;
+  return broken;
+}
+
+// Resolves contacts at position (x, y), pushing the ball out and flipping the
+// correct velocity component(s). Broken bricks are appended to `broken`.
+// Returns the corrected ball position (the push-out).
+function resolveStep(wx, wy, ball, bricks, broken) {
+  let flippedX = false;
+  let flippedY = false;
+  let guard = 0;
+  let bounced = false;
+
+  // Resolve the shallowest contact first and keep going until the ball rests
+  // free of every brick (or we hit a safeguard) so multi-brick overlaps at a
+  // seam settle correctly.
+  while (guard++ < 8) {
+    let brick = null;
+    let axis = null; // 'x' | 'y' | 'both'
+    let pen = Infinity;
+
+    for (const b of bricks) {
+      if (!b.alive || !overlaps(wx, wy, ball.r, b)) continue;
+      const penL = wx + ball.r - b.x;
+      const penR = b.x + b.w - (wx - ball.r);
+      const penT = wy + ball.r - b.y;
+      const penB = b.y + b.h - (wy - ball.r);
+      const dxm = Math.min(penL, penR);
+      const dym = Math.min(penT, penB);
+      const d = Math.min(dxm, dym);
+      if (d < pen) {
+        pen = d;
+        brick = b;
+        if (dxm < dym - CORNER_EPS) axis = 'x';
+        else if (dym < dxm - CORNER_EPS) axis = 'y';
+        else axis = 'both';
+      }
+    }
+
+    if (!brick) break;
+
+    if (brick.alive) {
+      brick.alive = false;
+      broken.push(brick);
+    }
+
+    if (axis === 'x' || axis === 'both') {
+      bounced = true;
+      if (!flippedX) {
+        flippedX = true;
+        ball.vx = -ball.vx;
+      }
+      // Push the ball out along x, away from the shallower side.
+      const penL = wx + ball.r - brick.x;
+      const penR = brick.x + brick.w - (wx - ball.r);
+      wx = penL < penR ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    }
+
+    if (axis === 'y' || axis === 'both') {
+      bounced = true;
+      if (!flippedY) {
+        flippedY = true;
+        ball.vy = -ball.vy;
+      }
+      const penT = wy + ball.r - brick.y;
+      const penB = brick.y + brick.h - (wy - ball.r);
+      wy = penT < penB ? brick.y - ball.r : brick.y + brick.h + ball.r;
+    }
+  }
+
+  // Surface the corrected position (and whether a bounce happened) to the
+  // caller's sweep.
+  return [wx, wy, bounced];
+}
