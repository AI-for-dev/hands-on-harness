+// ---------------------------------------------------------------------------
+// Brick bounce (#1)
+// ---------------------------------------------------------------------------
+
+function brick(x, y) {
+  return { x, y, w: 72, h: 20, row: 0, points: 10, alive: true };
+}
+
+// Ball moving DOWN (vy > 0) into the TOP face of a brick: bounces back UP.
+test('brickHit: top/bottom hit flips vy and pushes the ball out', () => {
+  const bricks = [brick(100, 100)];
+  const ball = { x: 120, y: 106, r: 7, vx: 0, vy: 300, px: 120, py: 90 };
+  const broken = brickHit(ball, bricks);
+  assert.equal(broken.length, 1);
+  assert.equal(bricks[0].alive, false);
+  assert.ok(ball.vy < 0, 'vertical velocity should flip back upward');
+  assert.equal(ball.vx, 0, 'horizontal velocity untouched');
+  assert.ok(ball.y <= 100 - ball.r, 'ball pushed out above the brick');
+  assert.equal(collides(ball, bricks[0]), false, 'no residual overlap');
+});
+
+// Ball moving RIGHT (vx > 0) into the LEFT face of a brick: bounces LEFT.
+test('brickHit: side hit flips vx and pushes the ball out', () => {
+  const bricks = [brick(100, 100)];
+  const ball = { x: 103, y: 110, r: 7, vx: 300, vy: 0, px: 90, py: 110 };
+  const broken = brickHit(ball, bricks);
+  assert.equal(broken.length, 1);
+  assert.equal(bricks[0].alive, false);
+  assert.ok(ball.vx < 0, 'horizontal velocity should flip back left');
+  assert.equal(ball.vy, 0, 'vertical velocity untouched');
+  assert.ok(ball.x <= 100 - ball.r, 'ball pushed out left of the brick');
+  assert.equal(collides(ball, bricks[0]), false);
+});
+
+// Diagonal entry with equal penetration on both axes => corner hit flips both.
+test('brickHit: corner hit flips both velocity components', () => {
+  const bricks = [brick(100, 100)];
+  // Penetrates the top and left faces equally (penX == penY).
+  const ball = { x: 97, y: 97, r: 7, vx: 300, vy: 300, px: 90, py: 90 };
+  const broken = brickHit(ball, bricks);
+  assert.equal(broken.length, 1);
+  assert.ok(ball.vx < 0 && ball.vy < 0, 'both components should flip on a corner hit');
+  assert.equal(collides(ball, bricks[0]), false);
+});
+
+// Two bricks sharing a seam are struck at the same instant: the bounce must be
+// applied exactly ONCE (per-brick resolution would flip vx twice and cancel).
+test('brickHit: neighbour seam bounces only once', () => {
+  const bricks = [brick(100, 100), brick(100 + 72 + 8, 100)]; // 8 px gap
+  const ball = { x: 176, y: 110, r: 7, vx: 200, vy: 0, px: 175, py: 110 };
+  const broken = brickHit(ball, bricks);
+  assert.equal(broken.length, 2, 'both bricks sharing the seam are struck');
+  assert.ok(bricks.every((b) => !b.alive));
+  assert.ok(ball.vx < 0, 'vx flipped exactly once (not twice/zilch)');
+  assert.equal(ball.vy, 0, 'vertical untouched by a horizontal seam hit');
+});
+
+// A fast ball that jumps clean over a brick in a single frame (position before
+// and after both outside the brick) must still be caught by the sweep.
