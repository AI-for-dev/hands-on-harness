+// --- Brick bounce ----------------------------------------------------------
+
+// Sub-step length for swept brick collision (px). The fastest ball covers ~35 px
+// in a capped 50 ms frame (level 6), and a brick is only 20 px thick, so a
+// single discrete per-frame test could jump clean through it. A 4 px step keeps
+// the sweep conservative: the ball can never skip a brick (see ISSUES.md #1,
+// "tunnelling").
+const SWEEP_STEP = 4;
+
+// AABB penetration depths of the ball's box into a brick on each axis. Only
+// meaningful while the two overlap; the caller guarantees that.
+function penetration(ball, brick) {
+  const penX = Math.min(
+    ball.x + ball.r - brick.x,
+    brick.x + brick.w - (ball.x - ball.r),
+  );
+  const penY = Math.min(
+    ball.y + ball.r - brick.y,
+    brick.y + brick.h - (ball.y - ball.r),
+  );
+  return [penX, penY];
+}
+
+// Resolves a bounce against one or more bricks the ball overlaps at the same
+// instant. Neighbouring bricks share seams (gap is 8 px, ball is 14 px across),
+// so every brick involved is treated as a single wall and the velocity is
+// flipped exactly once; resolving each brick separately would apply a flip
+// twice and let the ball slip through (see ISSUES.md #1, "neighbours").
+//
+// The axis with the smaller penetration is the face that was hit: a top/bottom
+// hit flips `vy`, a side hit flips `vx`, and equal penetrations mean a corner
+// (diagonal) hit which flips both. The ball is also pushed back out so it no
+// longer overlaps on the next frame ("push out"".
+function resolveBounce(ball, overlapping) {
+  let penX = Infinity;
+  let penY = Infinity;
+  for (const brick of overlapping) {
+    const [bx, by] = penetration(ball, brick);
+    if (bx < penX) penX = bx;
+    if (by < penY) penY = by;
+  }
+
+  // The ball entered from the side opposite its travel; push it back out that
+  // way (and flip the sign so the bounce is correct).
+  const outX = ball.vx >= 0 ? -1 : 1;
+  const outY = ball.vy >= 0 ? -1 : 1;
+  const EPS = 1e-6;
+
+  if (penX < penY - EPS) {
+    ball.x += outX * penX;
+    ball.vx = -ball.vx;
+  } else if (penY < penX - EPS) {
+    ball.y += outY * penY;
+    ball.vy = -ball.vy;
+  } else {
+    // corner: diagonal hit
+    ball.x += outX * penX;
+    ball.y += outY * penY;
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+  }
+}
+
+// Pure, testable swept brick collision. Walks the ball along the segment from
+// its position at the previous `step()` (`ball.px` / `ball.py`) to its current
+// position, testing at fine sub-steps so a fast ball cannot tunnel clean
+// through a brick. On the first contact it resolves a single per-face bounce,
+// pushes the ball back out, destroys every brick involved, and returns the
+// struck bricks so the caller can award score/combo (#1).
+export function brickHit(ball, bricks) {
+  const startX = ball.px;
+  const startY = ball.py;
+  const dx = ball.x - startX;
+  const dy = ball.y - startY;
+  const dist = Math.hypot(dx, dy);
+  const steps = Math.max(1, Math.ceil(dist / SWEEP_STEP));
+  const incX = dx / steps;
+  const incY = dy / steps;
+
+  // Rewind to the start of the frame's travel, then walk forward in sub-steps.
+  ball.x = startX;
+  ball.y = startY;
+
+  const broken = [];
+  for (let i = 0; i < steps; i++) {
+    ball.x += incX;
+    ball.y += incY;
+
+    const overlapping = [];
+    for (const brick of bricks) {
+      if (brick.alive && collides(ball, brick)) overlapping.push(brick);
+    }
+    if (overlapping.length > 0) {
+      resolveBounce(ball, overlapping);
+      for (const brick of overlapping) {
+        brick.alive = false;
+        broken.push(brick);
+      }
+      break;
+    }
+  }
+  return broken;
+}
