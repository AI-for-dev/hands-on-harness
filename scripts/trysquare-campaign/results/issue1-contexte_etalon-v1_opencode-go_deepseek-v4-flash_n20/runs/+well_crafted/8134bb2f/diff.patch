+// --- Brick collision resolution (pure, tested) -----------------------------
+
+// Detects every brick the ball hits along its path from the previous position
+// (ball.px/ball.py, if present) to its current one, and resolves the bounce.
+//
+// Returns the array of bricks destroyed (already flagged `alive: false`).
+// Resolves exactly once per call, so a ball straddling a seam touches two
+// bricks in the same pass but still flips each axis only once (see #1).
+export function brickHit(ball, bricks) {
+  const px = ball.px ?? ball.x;
+  const py = ball.py ?? ball.y;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+  const dist = Math.hypot(dx, dy);
+
+  // Sub-step the movement so a fast ball cannot jump over a brick: at level 6
+  // a stuttered frame moves ~35 px against a 20 px brick. Stepping by at most
+  // the ball's own radius keeps every crossing detectable.
+  const steps = Math.max(1, Math.ceil(dist / BALL_R));
+
+  for (let i = 0; i < steps; i += 1) {
+    const t = (i + 1) / steps;
+    ball.x = px + dx * t;
+    ball.y = py + dy * t;
+
+    const hitting = bricks.filter((b) => b.alive && collides(ball, b));
+    if (hitting.length === 0) continue;
+    return resolveBricks(ball, hitting);
+  }
+
+  return [];
+}
+
+// Resolves a single contact between the ball and a set of overlapping bricks.
+// The axis with the *smaller* penetration is the face that was hit (equal
+// penetrations = diagonal corner hit, flip both). Flips are aggregated across
+// all bricks of the contact so nothing cancels out, then the ball is pushed
+// back out of the whole cluster so it cannot overlap on the next frame.
+function resolveBricks(ball, hitting) {
+  let flipVX = false;
+  let flipVY = false;
+  let minX = Infinity;
+  let maxRight = -Infinity;
+  let minY = Infinity;
+  let maxBottom = -Infinity;
+
+  for (const brick of hitting) {
+    brick.alive = false;
+    const cx = brick.x + brick.w / 2;
+    const cy = brick.y + brick.h / 2;
+    const penX = brick.w / 2 + ball.r - Math.abs(ball.x - cx);
+    const penY = brick.h / 2 + ball.r - Math.abs(ball.y - cy);
+
+    if (Math.abs(penX - penY) <= 1) {
+      flipVX = true;
+      flipVY = true;
+    } else if (penX < penY) {
+      flipVX = true;
+    } else {
+      flipVY = true;
+    }
+
+    minX = Math.min(minX, brick.x);
+    maxRight = Math.max(maxRight, brick.x + brick.w);
+    minY = Math.min(minY, brick.y);
+    maxBottom = Math.max(maxBottom, brick.y + brick.h);
+  }
+
+  const vx = ball.vx;
+  const vy = ball.vy;
+  if (flipVX) ball.vx = -vx;
+  if (flipVY) ball.vy = -vy;
+
+  // Push the ball out of the cluster, back toward the side it came from.
+  if (flipVY) {
+    ball.y = vy >= 0 ? minY - ball.r : maxBottom + ball.r;
+  }
+  if (flipVX) {
+    ball.x = vx >= 0 ? minX - ball.r : maxRight + ball.r;
+  }
+
+  return hitting;
+}
