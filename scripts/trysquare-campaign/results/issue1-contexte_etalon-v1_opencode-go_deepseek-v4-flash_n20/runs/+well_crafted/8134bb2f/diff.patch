+// --- ISSUE #1: brick bounce -------------------------------------------------
+// The ball must bounce off bricks (not plow through), past the seam, and past
+// a fast frame — per-face, at corners, pushed out, exactly once.
+
+function aBall(over) {
+  return { x: 120, y: 125, r: 7, vx: 0, vy: -100, ...over };
+}
+
+// Brick spanning x=100..140, y=100..120.
+const A_BRICK = { x: 100, y: 100, w: 40, h: 20, alive: true, points: 10 };
+
+function make(complex) {
+  return complex.map((c) => ({ ...c, alive: true }));
+}
+
+test('brickHit: bottom face hit flips vy (ball bounces back down)', () => {
+  // Ball just below the brick, moving up, overlapping its bottom edge.
+  const ball = aBall({ y: 125, py: 135, vy: -100 });
+  const bricks = make([A_BRICK]);
+  const hit = brickHit(ball, bricks);
+  assert.equal(hit.length, 1);
+  assert.ok(ball.vy > 0, 'vy should flip so the ball bounces downward');
+  assert.equal(bricks[0].alive, false, 'hit brick is destroyed');
+  // Pushed out below the brick, not still overlapping.
+  assert.ok(ball.y - ball.r >= bricks[0].y + bricks[0].h, 'ball pushed out of the brick');
+});
+
+test('brickHit: side face hit flips vx (ball bounces sideways)', () => {
+  // Ball to the left of the brick, moving right, overlapping its left face.
+  const ball = { x: 96, y: 110, r: 7, vx: 100, vy: 0, px: 80, py: 110 };
+  const bricks = make([A_BRICK]);
+  brickHit(ball, bricks);
+  assert.ok(ball.vx < 0, 'vx should flip so the ball bounces left');
+  assert.ok(ball.x + ball.r <= bricks[0].x, 'ball pushed out to the left of the brick');
+});
+
+test('brickHit: corner hit (equal penetration) flips both vx and vy', () => {
+  // Ball centered exactly on the top-left corner => equal penetrations.
+  const ball = { x: 100, y: 100, r: 7, vx: -100, vy: -100, px: 60, py: 60 };
+  const bricks = make([A_BRICK]);
+  brickHit(ball, bricks);
+  assert.equal(ball.vx, 100, 'vx should flip on a corner hit');
+  assert.equal(ball.vy, 100, 'vy should flip on a corner hit');
+});
+
+test('brickHit: vertical seam of two bricks flips vx exactly once', () => {
+  // Two bricks side by side with an 8px gap; the ball straddles the seam
+  // moving up, touching both neighbours in the same pass. The bounce must
+  // apply once — if it applied twice, vx would return to its original sign.
+  const left = { x: 100, y: 100, w: 40, h: 20, alive: true, points: 10 }; // 100..140
+  const right = { x: 148, y: 100, w: 40, h: 20, alive: true, points: 10 }; // 148..188
+  const ball = { x: 144, y: 108, r: 7, vx: 50, vy: -100, px: 144, py: 160 };
+  const hit = brickHit(ball, [left, right]);
+  assert.equal(hit.length, 2, 'both seam neighbours are broken in one pass');
+  assert.equal(ball.vx, -50, 'vx flipped exactly once along the vertical seam');
+  assert.equal(ball.vy, -100, 'vy untouched by a side-face seam hit');
+});
+
+test('brickHit: fast ball does not tunnel through a brick', () => {
+  // Level-6 speed, stutter-sized move: the ball jumps from below to above the
+  // brick in one step, but the swept path must still register the hit.
+  const ball = { x: 120, y: 50, r: 7, vx: 0, vy: -300, px: 120, py: 160 };
+  const bricks = make([A_BRICK]);
+  const hit = brickHit(ball, bricks);
+  assert.equal(hit.length, 1, 'a sweeping ball still catches the brick');
+  assert.ok(ball.vy > 0, 'vy flipped after catching the tunneled brick');
+});
+
+test('brickHit: no overlap => no hit, no mutation', () => {
+  const ball = aBall({ x: 400, y: 400, px: 400, py: 400, vx: -100, vy: -100 });
+  const bricks = make([A_BRICK]);
+  const hit = brickHit(ball, bricks);
+  assert.equal(hit.length, 0);
+  assert.equal(bricks[0].alive, true);
+  assert.equal(ball.vx, -100);
+  assert.equal(ball.vy, -100);
+});
