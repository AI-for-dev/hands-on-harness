+// --- Brick collision & bounce (swept, per-face) -------------------------
+
+// Swept AABB test. The ball is treated as a moving point and the brick rect is
+// inflated by the ball radius. Instead of sampling a single discrete position
+// we walk the ball's ENTIRE path from the previous frame (px, py) to the
+// current one, so a fast ball can never jump over a brick between two frames
+// (tunnelling, see #1). Returns { axis, t } for the face entered — 'x' (side),
+// 'y' (top/bottom) or 'corner' (both at once) — with the entry time t, or null
+// when the path never clips the brick.
+function sweptHitFace(px, py, dx, dy, r, brick) {
+  const L = brick.x - r;
+  const R = brick.x + brick.w + r;
+  const T = brick.y - r;
+  const B = brick.y + brick.h + r;
+
+  let tmin = 0;
+  let tmax = 1;
+  let tX = -Infinity;
+  let tY = -Infinity;
+  let valid = true;
+
+  if (Math.abs(dx) < 1e-9) {
+    if (px < L || px > R) valid = false;
+  } else {
+    let t1 = (L - px) / dx;
+    let t2 = (R - px) / dx;
+    if (t1 > t2) [t1, t2] = [t2, t1];
+    tX = t1;
+    tmin = Math.max(tmin, t1);
+    tmax = Math.min(tmax, t2);
+  }
+
+  if (Math.abs(dy) < 1e-9) {
+    if (py < T || py > B) valid = false;
+  } else {
+    let t1 = (T - py) / dy;
+    let t2 = (B - py) / dy;
+    if (t1 > t2) [t1, t2] = [t2, t1];
+    tY = t1;
+    tmin = Math.max(tmin, t1);
+    tmax = Math.min(tmax, t2);
+  }
+
+  if (!valid || tmin > tmax || tmin > 1 || tmin < 0) return null;
+
+  // Equal timing on both axes means we hit a corner: flip both components;
+  // otherwise the face entered last is the one actually hit.
+  if (tX !== -Infinity && tY !== -Infinity && Math.abs(tX - tY) < 1e-6) {
+    return { axis: 'corner', t: Math.max(tX, tY) };
+  }
+  const axis = tY === -Infinity || (tX !== -Infinity && tX > tY) ? 'x' : 'y';
+  return { axis, t: tY === -Infinity ? tX : Math.max(tX, tY) };
+}
+
+// Repositions the ball just outside the brick (push-out) and flips the
+// velocity along the face hit (both components for a corner), leaving the
+// other component untouched. Without the push-out the ball would still overlap
+// on the next frame and re-flip forever (sticky bounce).
+function resolveBounce(ball, brick, axis) {
+  const L = brick.x;
+  const R = brick.x + brick.w;
+  const T = brick.y;
+  const B = brick.y + brick.h;
+
+  if (axis === 'corner') {
+    if (ball.vx > 0) ball.x = L - ball.r;
+    else ball.x = R + ball.r;
+    if (ball.vy > 0) ball.y = T - ball.r;
+    else ball.y = B + ball.r;
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+  } else if (axis === 'x') {
+    if (ball.vx > 0) ball.x = L - ball.r;
+    else ball.x = R + ball.r;
+    ball.vx = -ball.vx;
+  } else {
+    if (ball.vy > 0) ball.y = T - ball.r;
+    else ball.y = B + ball.r;
+    ball.vy = -ball.vy;
+  }
+}
+
+// Sweeps the ball's whole path against every live brick. Destroys all bricks
+// on that path and applies exactly ONE bounce for the pass (corner takes
+// precedence, otherwise the face hit first). The single bounce is what keeps a
+// seam from double-flipping: `vy = -vy` applied twice cancels out and the ball
+// would sail through a row of bricks. Returns the destroyed bricks.
+//
+// `ball.px` / `ball.py` must hold the position at the start of the step, set by
+// step() before any movement.
+export function brickHit(ball, bricks) {
+  const px = ball.px ?? ball.x;
+  const py = ball.py ?? ball.y;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+
+  const hits = [];
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    const res = sweptHitFace(px, py, dx, dy, ball.r, brick);
+    if (res) hits.push({ brick, ...res });
+  }
+  if (hits.length === 0) return [];
+
+  for (const h of hits) h.brick.alive = false;
+
+  const corner = hits.find((h) => h.axis === 'corner');
+  const chosen = corner || hits.reduce((acc, h) => (h.t < acc.t ? h : acc), hits[0]);
+  resolveBounce(ball, chosen.brick, chosen.axis);
+
+  return hits.map((h) => h.brick);
+}
