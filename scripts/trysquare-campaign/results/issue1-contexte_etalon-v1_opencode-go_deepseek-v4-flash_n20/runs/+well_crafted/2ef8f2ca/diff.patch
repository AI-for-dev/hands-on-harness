+// --- #1 brick bounce: per-face, corner, push-out, neighbours, tunnelling ----
+
+const BRICK = () => ({ x: 100, y: 100, w: 72, h: 20, points: 10, alive: true });
+
+// Forward to swept resolution through the pure primitive, with px/py set to
+// the pre-move position as step() would (the ball must have MOVED from px/py
+// to its current x/y for the sweep to see a path).
+function work(ball, px, py, bricks) {
+  ball.px = px;
+  ball.py = py;
+  brickHit(ball, bricks);
+  return ball;
+}
+
+test('brickHit: bottom face hit flips vy and pushes the ball out (no overlap)', () => {
+  // Ball coming up from BELOW hits the brick's bottom face: bounce back down.
+  const brick = BRICK();
+  const ball = work({ x: 136, y: 126, r: 7, vx: 0, vy: -120 }, 136, 130, [brick]);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vy, 120); // flipped down
+  assert.equal(ball.vx, 0); // untouched
+  assert.ok(ball.y >= brick.y + brick.h + ball.r, 'pushed back below the brick');
+});
+
+test('brickHit: top face hit flips vy up and pushes the ball out', () => {
+  // Ball coming down from ABOVE hits the brick's top face: bounce back up.
+  const brick = BRICK();
+  const ball = work({ x: 136, y: 94, r: 7, vx: 0, vy: 120 }, 136, 90, [brick]);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vy, -120); // flipped up
+  assert.ok(ball.y <= brick.y - ball.r, 'pushed back above the brick');
+});
+
+test('brickHit: side (near-horizontal) hit flips vx, never vy', () => {
+  // Near-horizontal shot into the left face: the lateral face is hit, so only
+  // vx flips (this is the case the fixed #1 made obvious).
+  const brick = BRICK();
+  const ball = work({ x: 106, y: 110, r: 7, vx: 150, vy: -5 }, 95, 110, [brick]);
+  assert.equal(brick.alive, false);
+  assert.ok(ball.vx < 0, `vx should flip, got ${ball.vx}`);
+  assert.equal(ball.vy, -5, 'vy left exactly as it was');
+  assert.ok(ball.x <= brick.x - ball.r, 'pushed back out the left face');
+});
+
+test('brickHit: corner hit flips BOTH components', () => {
+  // Path aimed straight at the bottom-left corner (equal x/y penetration).
+  const brick = BRICK();
+  const ball = { x: 93, y: 127, r: 7, vx: 150, vy: -150 };
+  ball.px = 83;
+  ball.py = 137;
+  brickHit(ball, [brick]);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vx, -150);
+  assert.equal(ball.vy, 150);
+});
+
+test('brickHit: seam between neighbours bounces ONCE (no double-cancel)', () => {
+  // Ball hits a seam shared by two same-row bricks from below. Both must break,
+  // but vy must be flipped a single time (flipping twice would cancel out and
+  // the ball would continue upward).
+  const a = BRICK();
+  const b = { ...BRICK(), x: a.x + a.w + BRICK_GAP };
+  // Ball (r=7) centred on the 8px gap spans x 169..183: it overlaps BOTH bricks.
+  const ball = { x: a.x + a.w + BRICK_GAP / 2, y: 126, r: 7, vx: 0, vy: -120 };
+  ball.px = ball.x;
+  ball.py = 140;
+  const destroyed = brickHit(ball, [a, b]);
+  assert.equal(a.alive, false);
+  assert.equal(b.alive, false);
+  assert.equal(destroyed.length, 2);
+  assert.equal(ball.vy, 120); // flipped exactly once
+});
+
+test('brickHit: ball cannot tunnel through a brick at high speed', () => {
+  // Level-6 speed with a stuttered frame is ~35px/step; here the ball jumps
+  // ~240px straight through the brick. The sweep must still catch it.
+  const brick = BRICK();
+  // Level-6 speed with a stuttered frame is ~35px/step; here the ball jumps
+  // ~240px straight through the brick. The sweep must still catch it.
+  const ball = { x: 136, y: 60, r: 7, vx: 0, vy: -710 };
+  ball.px = 136;
+  ball.py = 300;
+  brickHit(ball, [brick]);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vy, 710); // bounced back down, did not sail through
+});
+
+test('step: brick collision is engaged and updates score', () => {
+  // Drive the real step() so a straight upward shot breaks its brick.
+  const state = createState(3);
+  state.bricks = [{ x: 320, y: 100, w: 72, h: 20, alive: true, points: 50 }];
+  // Ball starts just below the brick and flies up into it within the single
+  // step (dt large enough to carry it past the brick's bottom face).
+  state.ball = { x: 356, y: 160, r: 7, vx: 0, vy: -800 };
+  const lost = step(state, 0.05);
+  assert.equal(lost, false);
+  assert.equal(state.bricks[0].alive, false);
+  assert.ok(state.score > 0, 'breaking a brick scores points');
+  assert.equal(state.combo, 1);
+});
+
