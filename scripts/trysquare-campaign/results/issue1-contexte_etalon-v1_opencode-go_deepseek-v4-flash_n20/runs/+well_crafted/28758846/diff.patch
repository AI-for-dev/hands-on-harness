+// --- brickHit (#1): the ball must bounce, not plow through ----------------
+
+// A brick fully covering a bottom-face hit. The ball comes from below, moving
+// UP into the brick's bottom edge.
+function bottomHitBall() {
+  return { x: 136, y: 158, r: 7, vx: 0, vy: -300, prevX: 136, prevY: 175 };
+}
+
+function oneBrick() {
+  return [{ x: 100, y: 140, w: 72, h: 20, row: 0, alive: true, points: 50 }];
+}
+
+test('brickHit: head-on bottom hit flips vy and keeps vx, pushed below the brick', () => {
+  const bricks = oneBrick();
+  const ball = bottomHitBall();
+  const destroyed = brickHit(ball, bricks);
+
+  assert.equal(destroyed.length, 1);
+  assert.equal(bricks[0].alive, false);
+  assert.ok(ball.vy > 0, 'vy should flip from up to down');
+  assert.equal(ball.vx, 0, 'vx must stay unchanged on a vertical hit');
+  assert.ok(ball.y >= bricks[0].y + bricks[0].h + ball.r, 'ball pushed below the brick');
+});
+
+test('brickHit: side hit flips vx and keeps vy, pushed to the side', () => {
+  const bricks = oneBrick();
+  const ball = { x: 105, y: 150, r: 7, vx: 300, vy: 0, prevX: 92, prevY: 150 };
+  const destroyed = brickHit(ball, bricks);
+
+  assert.equal(destroyed.length, 1);
+  assert.ok(ball.vx < 0, 'vx should flip back from right to left');
+  assert.equal(ball.vy, 0, 'vy must stay unchanged on a side hit');
+  assert.ok(ball.x <= bricks[0].x - ball.r, 'ball pushed to the side of the brick');
+});
+
+test('brickHit: neighbours at a seam are both destroyed but bounce applies once', () => {
+  // Two bricks side by side at x:100..172 and x:180..252 (8px gap). The 14px
+  // ball centred on the seam overlaps both in the same pass. A naive
+  // vy = -vy applied for EACH brick would cancel out and send the ball back
+  // through -> it must flip exactly once.
+  const bricks = [
+    { x: 100, y: 140, w: 72, h: 20, row: 0, alive: true, points: 50 },
+    { x: 180, y: 140, w: 72, h: 20, row: 0, alive: true, points: 50 },
+  ];
+  const ball = { x: 176, y: 158, r: 7, vx: 0, vy: -300, prevX: 176, prevY: 175 };
+  const destroyed = brickHit(ball, bricks);
+
+  assert.equal(destroyed.length, 2, 'both seam bricks are broken');
+  assert.ok(ball.vy, 'vertical velocity must be non-zero');
+  assert.equal(ball.vy, 300, 'vy flipped exactly once, not twice');
+});
+
+test('brickHit: fast ball that jumps over a brick is still caught (sweep)', () => {
+  // Level 6 speed: ballSpeed(6) = 710px/s. On a stuttered 50ms frame that is
+  // 35.5px. The brick is 20px tall, so a discrete check at the current
+  // position would MISS it entirely (the ball sits above the brick). The
+  // sweep must still detect the crossing.
+  const bricks = [{ x: 100, y: 140, w: 72, h: 20, row: 0, alive: true, points: 50 }];
+  const ball = { x: 136, y: 120, r: 7, vx: 0, vy: -710, prevX: 136, prevY: 200 };
+
+  // Sanity: at its resting position the ball does NOT overlap the brick.
