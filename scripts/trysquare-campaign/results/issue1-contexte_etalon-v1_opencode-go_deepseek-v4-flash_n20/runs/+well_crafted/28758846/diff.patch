+// --- Brick collision resolution (#1) --------------------------------------
+
+// A pure, testable collision-and-bounce step for the ball against a wall of
+// bricks. Given the ball's POST-move position and size, and the brick grid,
+// it:
+//
+//   * sweeps the segment between the ball's previous (`ball.prevX/prevY`) and
+//     current position so a fast ball cannot tunnel through a brick in one
+//     frame (discrete position checks would jump over the brick);
+//   * destroys every brick crossed along the path;
+//   * applies the bounce EXACTLY ONCE against the first brick it touches, so a
+//     neighbour-overlap (the 8px grid gap is narrower than the 14px ball)
+//     cannot flip the ball back and forth in the same pass; and
+//   * pushes the ball back outside the brick so it cannot re-trigger next
+//     frame (sticky-bounce protection).
+//
+// Returns the array of destroyed bricks (empty when nothing was hit). The ball
+// and the bricks are mutated in place.
+export function brickHit(ball, bricks) {
+  const px = Number.isFinite(ball.prevX) ? ball.prevX : ball.x;
+  const py = Number.isFinite(ball.prevY) ? ball.prevY : ball.y;
+
+  const sx = ball.x - px;
+  const sy = ball.y - py;
+  const dist = Math.hypot(sx, sy);
+  // Sample the travel path at most every ~8px. Both BRICK_W and BRICK_H are
+  // far larger, so at least one sample is guaranteed to fall inside a brick we
+  // cross, even at max speed (level 6 caps a stutter frame at ~35px).
+  const steps = Math.max(1, Math.ceil(dist / 8));
+
+  const destroyed = [];
+  let entryBricks = []; // bricks overlapping at the very first point of contact
+  let entryX = px;
+  let entryY = py;
+
+  for (let i = 1; i <= steps; i++) {
+    const t = i / steps;
+    const bx = px + sx * t;
+    const by = py + sy * t;
+    const matched = [];
+    for (const brick of bricks) {
+      if (!brick.alive) continue;
+      if (brickContains(bx, by, ball.r, brick)) {
+        brick.alive = false;
+        destroyed.push(brick);
+        matched.push(brick);
+      }
+    }
+    // Remember the sample where the ball FIRST touches anything: that sample
+    // defines the contact surface that steers the bounce. Later samples may
+    // keep breaking bricks along the path, but only this first group matters
+    // for the deflection.
+    if (matched.length > 0 && entryBricks.length === 0) {
+      entryBricks = matched;
+      entryX = bx;
+      entryY = by;
+    }
+  }
+
+  if (entryBricks.length > 0) {
+    bounceBall(ball, entryBricks, entryX, entryY);
+  }
+  return destroyed;
+}
+
+// Does a ball centred at (bx, by) overlap `brick`? (AABB test on the ball's
+// bounding box, divorced from any ball state so we can sweep along the path.)
+function brickContains(bx, by, r, brick) {
+  return (
+    bx + r > brick.x &&
+    bx - r < brick.x + brick.w &&
+    by + r > brick.y &&
+    by - r < brick.y + brick.h
+  );
+}
+
+// Resolves a single bounce at the entry sample (bx, by), against the UNION of
+// the bricks that were touching at that first point of contact. Treating the
+// whole contacted surface as one shape is what keeps a ball landing on a seam
+// (it straddles two bricks, so each individual brick would report a fake
+// horizontal penetration) from being mis-directed sideways — it bounces off
+// the true face instead.
+//
+// The face with the smaller penetration is the one hit: flip the matching
+// velocity component and leave the other intact (per-face), push the ball back
+// outside the box along that axis, or flip both and push out on both axes when
+// the penetrations tie (a diagonal / corner hit).
+function bounceBall(ball, group, bx, by) {
+  const minX = Math.min(...group.map((b) => b.x));
+  const maxX = Math.max(...group.map((b) => b.x + b.w));
+  const minY = Math.min(...group.map((b) => b.y));
+  const maxY = Math.max(...group.map((b) => b.y + b.h));
+
+  // Penetration depth on the left/right edges and the top/bottom edges of the
+  // union box.
+  const overlapXLeft = bx + ball.r - minX;
+  const overlapXRight = maxX - (bx - ball.r);
+  const overlapYTop = by + ball.r - minY;
+  const overlapYBottom = maxY - (by - ball.r);
+
+  const penX = Math.min(overlapXLeft, overlapXRight);
+  const penY = Math.min(overlapYTop, overlapYBottom);
+
+  if (penX < penY) {
+    // Side hit: flip horizontal velocity, push out horizontally.
+    ball.vx = -ball.vx;
+    ball.x = overlapXLeft < overlapXRight ? minX - ball.r : maxX + ball.r;
+  } else if (penY < penX) {
+    // Top/bottom hit: flip vertical velocity, push out vertically.
+    ball.vy = -ball.vy;
+    ball.y = overlapYTop < overlapYBottom ? minY - ball.r : maxY + ball.r;
+  } else {
+    // Corner (diagonal) hit: flip both, push out on both axes.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x = overlapXLeft < overlapXRight ? minX - ball.r : maxX + ball.r;
+    ball.y = overlapYTop < overlapYBottom ? minY - ball.r : maxY + ball.r;
+  }
+}
