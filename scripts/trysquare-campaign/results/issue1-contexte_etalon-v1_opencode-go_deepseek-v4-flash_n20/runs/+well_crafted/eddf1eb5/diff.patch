+// --- Brick bounce (issue #1) ----------------------------------------------
+
+// Earliest parameter t in [0, 1] at which the ball-centre segment
+// (prevX, prevY)->(currX, currY) first enters the brick inflated by the ball
+// radius. Returns null if the path never touches the brick. Sweeping the whole
+// path fixes #1's tunnelling: with a stuttered frame the ball can leap across a
+// whole brick in one step, and a discrete end-position test would never see it.
+function sweptEntry(prevX, prevY, currX, currY, brick, r) {
+  const minX = brick.x - r;
+  const maxX = brick.x + brick.w + r;
+  const minY = brick.y - r;
+  const maxY = brick.y + brick.h + r;
+  const dx = currX - prevX;
+  const dy = currY - prevY;
+  let tEnter = 0;
+  let tExit = 1;
+
+  // Slab test for one axis: tighten the entry/exit interval, bail on miss.
+  const slab = (prev, d, lo, hi) => {
+    if (d === 0) return prev >= lo && prev <= hi;
+    let t1 = (lo - prev) / d;
+    let t2 = (hi - prev) / d;
+    if (t1 > t2) {
+      const tmp = t1;
+      t1 = t2;
+      t2 = tmp;
+    }
+    tEnter = Math.max(tEnter, t1);
+    tExit = Math.min(tExit, t2);
+    return tEnter <= tExit;
+  };
+
+  if (!slab(prevX, dx, minX, maxX)) return null;
+  if (!slab(prevY, dy, minY, maxY)) return null;
+  if (tEnter < 0) tEnter = 0; // segment starts inside the inflated rect
+  return tEnter <= 1 ? tEnter : null;
+}
+
+// Flips the velocity component(s) that face the brick and pushes the ball back
+// out on the same axis, given the ball positioned at its contact point.
+// The axis of *smaller* penetration is the face hit (#1 per face): flip vy on a
+// top/bottom hit, vx on a side hit, leaving the other component untouched; equal
+// penetrations mean a corner and flip both (#1 corner). Pushing the ball out
+// avoids the sticky bounce where it re-overlaps on the next frame (#1 push out).
+export function bounceOff(ball, brick) {
+  const cx = brick.x + brick.w / 2;
+  const cy = brick.y + brick.h / 2;
+  const r = ball.r;
+
+  const overlapX = Math.min(ball.x + r - brick.x, brick.x + brick.w - (ball.x - r));
+  const overlapY = Math.min(ball.y + r - brick.y, brick.y + brick.h - (ball.y - r));
+  const EPS = 1e-6;
+
+  if (Math.abs(overlapX - overlapY) < EPS) {
+    // Corner: diagonal hit, flip both components.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+  } else if (overlapX < overlapY) {
+    // Side face.
+    ball.vx = -ball.vx;
+    ball.x = ball.x < cx ? brick.x - r : brick.x + brick.w + r;
+  } else {
+    // Top / bottom face.
+    ball.vy = -ball.vy;
+    ball.y = ball.y < cy ? brick.y - r : brick.y + brick.h + r;
+  }
+}
+
+// Resolves the ball-vs-bricks collision for one step. `prevX/prevY` are the
+// ball position at the START of the move, so the path is swept (#1 tunnelling)
+// rather than only checked at the end position. Returns the earliest brick hit
+// along the path, or null. Mutates the ball (velocity flip + push-out). Only
+// ONE brick is handled per call on purpose (#1 neighbours): the 8 px seam is
+// narrower than the 14 px ball, so two bricks overlap in the same pass and a
+// double `vy = -vy` would cancel out and let the ball through.
+export function resolveBallBrick(ball, prevX, prevY, bricks) {
+  let hit = null;
+  let bestT = Infinity;
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    const t = sweptEntry(prevX, prevY, ball.x, ball.y, brick, ball.r);
+    if (t === null || t > bestT) continue;
+    bestT = t;
+    hit = brick;
+  }
+  if (!hit) return null;
+
+  // Reposition the ball to the very first contact point (push-out), then bounce.
+  ball.x = prevX + (ball.x - prevX) * bestT;
+  ball.y = prevY + (ball.y - prevY) * bestT;
+  bounceOff(ball, hit);
+  return hit;
+}
