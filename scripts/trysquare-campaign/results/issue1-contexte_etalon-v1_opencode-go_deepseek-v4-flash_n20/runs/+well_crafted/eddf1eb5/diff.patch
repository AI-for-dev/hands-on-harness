+// --- Issue #1: brick bounce -----------------------------------------------
+
+const brickRect = (x = 100, y = 100, w = 40, h = 20) => ({ x, y, w, h, alive: true });
+
+// Per face: the axis with the *smaller* penetration is the face that was hit.
+// A side hit flips vx and leaves vy exactly as it was.
+test('bounce: side hit flips vx, leaves vy untouched', () => {
+  const brick = brickRect();
+  const ball = { x: 96, y: 110, r: 7, vx: 300, vy: 35, px: 60, py: 110 };
+  const hit = resolveBallBrick(ball, 60, 110, [brick]);
+  assert.equal(hit, brick);
+  assert.equal(ball.vx, -300); // flipped
+  assert.equal(ball.vy, 35); // untouched
+});
+
+// A top/bottom hit flips vy and leaves vx untouched.
+test('bounce: horizontal face hit flips vy, leaves vx untouched', () => {
+  const brick = brickRect();
+  const ball = { x: 120, y: 110, r: 7, vx: 55, vy: -300, px: 120, py: 140 };
+  const hit = resolveBallBrick(ball, 120, 140, [brick]);
+  assert.equal(hit, brick);
+  assert.equal(ball.vy, 300); // flipped from -300
+  assert.equal(ball.vx, 55); // untouched
+});
+
+// Corner: equal penetrations mean a diagonal hit, flip both components.
+test('bounce: equal penetrations = corner, flips both', () => {
+  const brick = brickRect();
+  const ball = { x: 97, y: 97, r: 7, vx: 120, vy: 80 };
+  bounceOff(ball, brick);
+  assert.equal(ball.vx, -120);
+  assert.equal(ball.vy, -80);
+});
+
+// Push out: the ball must be repositioned outside the brick so it does not
+// re-overlap on the next frame and re-flip forever (sticky bounce).
+test('bounce: ball is pushed outside the brick (no sticky re-flip)', () => {
+  const brick = brickRect();
+  const ball = { x: 96, y: 110, r: 7, vx: 300, vy: 30, px: 60, py: 110 };
+  resolveBallBrick(ball, 60, 110, [brick]);
+  assert.equal(collides(ball, brick), false);
+});
+
+// Neighbours: the 8 px gap is smaller than the 14 px ball, so a seam overlaps
+// two bricks in the same pass. The bounce must apply exactly once (a doubled
+// `vy = -vy` would cancel out and let the ball through).
+test('bounce: a seam between two bricks flips vy exactly once', () => {
+  const b1 = brickRect(100, 100);
+  const b2 = brickRect(148, 100); // 8 px gap between b1 and b2
+  const ball = { x: 144, y: 115, r: 7, vx: 0, vy: 300, px: 144, py: 90 };
+  const hit = resolveBallBrick(ball, 144, 90, [b1, b2]);
+  assert.ok(hit === b1 || hit === b2, 'one of the seam bricks is hit');
+  assert.equal(ball.vy, -300, 'vy flips exactly once (would be +300 if doubled)');
+  // Only the chosen brick bounces; the neighbour is untouched and stays alive.
+  assert.equal(b1.alive, true);
+  assert.equal(b2.alive, true);
+});
+
+// Tunnelling: detection is discrete position-before/after, so a stuttered frame
+// can jump the ball over a whole brick. Sweeping the path catches that leap.
+test('bounce: a ball that leaps over a brick is swept back', () => {
+  const brick = brickRect(); // covers y 100..120
+  const ball = { x: 120, y: 140, r: 7, vx: 0, vy: 300, px: 120, py: 60 };
+  // prev top edge 67 < 93 (above), current bottom edge 133 > 127 (below): skipped.
+  const hit = resolveBallBrick(ball, 120, 60, [brick]);
+  assert.equal(hit, brick, 'tunnelled path still counts as a hit');
+  assert.equal(ball.vy, -300, 'velocity deflected back');
+  assert.equal(collides(ball, brick), false, 'ball ends outside the brick');
+});
+
