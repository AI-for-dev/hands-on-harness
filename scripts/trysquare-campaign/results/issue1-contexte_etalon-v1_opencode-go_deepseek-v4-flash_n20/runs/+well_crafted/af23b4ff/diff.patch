+// --- Issue #1: brick bounce -------------------------------------------------
+
+function brickState(ball, bricks) {
+  return { ball, bricks, score: 0, combo: 0 };
+}
+
+// A single brick conveniently placed at a known rectangle.
+const B = { x: 100, y: 100, w: 72, h: 20, row: 0, points: 100, alive: true };
+
+// Face hit by the ball from below -> bounce UP (vy flips to negative) and the
+// ball is pushed OUT below the brick.
+test('brick bounce: bottom face flips vy, pushes ball out, leaves vx alone', () => {
+  // Ball climbs toward the bottom edge of the brick.
+  const ball = { x: 136, y: 112, r: BALL_R, vx: 40, vy: -300 };
+  const state = brickState(ball, [{ ...B }]);
+  resolveBrickCollisions(state, 136, 140);
+
+  assert.equal(state.ball.vy > 0, true, 'vy should flip to downward (bounce off bottom)');
+  assert.equal(state.ball.vx, 40, 'vx must stay unchanged on a vertical hit');
+  assert.equal(state.ball.y, B.y + B.h + BALL_R, 'ball must be pushed out below the brick');
+  assert.equal(state.bricks[0].alive, false, 'brick should be destroyed');
+});
+
+// Side hit from the left -> bounce RIGHT (vx flips to positive), vy untouched.
+test('brick bounce: side face flips vx, pushes ball out, leaves vy alone', () => {
+  const ball = { x: 120, y: 110, r: BALL_R, vx: 300, vy: 0 };
+  const state = brickState(ball, [{ ...B }]);
+  resolveBrickCollisions(state, 50, 110);
+
+  assert.equal(state.ball.vx < 0, true, 'vx should flip to leftward (bounce off the left face)');
+  assert.equal(state.ball.vy, 0, 'vy must stay unchanged on a side hit');
+  assert.equal(state.ball.x, B.x - BALL_R, 'ball must be pushed out to the left of the brick');
+});
+
+// Corner / diagonal hit -> both components flip and the ball is pushed to the
+// corner diagonal outside the brick.
+test('brick bounce: corner (equal penetrations) flips both components', () => {
+  const ball = { x: 104, y: 104, r: BALL_R, vx: 100, vy: -100 };
+  const state = brickState(ball, [{ ...B }]);
+  // Ball at the top-left corner: both X and Y penetrations are equal (10 px),
+  // so the hit is treated as a diagonal — both components flip.
+  resolveBrickCollisions(state, 103, 103);
+
+  assert.equal(state.ball.vx, -100, 'corner hit flips vx');
+  assert.equal(state.ball.vy, 100, 'corner hit flips vy');
+  assert.equal(state.ball.x, B.x - BALL_R, 'pushed out to the top-left corner');
+  assert.equal(state.ball.y, B.y - BALL_R, 'pushed out to the top-left corner');
+});
+
+// Two side-by-side bricks sharing a seam: the ball (14px across) overlaps both
+// at once. The bounce must apply EXACTLY once (vy flipped once, not twice) and
+// both bricks must be destroyed.
+test('brick bounce: seam overlap bounces once and destroys both neighbours', () => {
+  const left = { x: 100, y: 100, w: 72, h: 20, row: 0, points: 100, alive: true };
+  const right = { x: 180, y: 100, w: 72, h: 20, row: 1, points: 100, alive: true };
+  // Ball centred on the 8px gap: its box (14px across) overlaps BOTH bricks in
+  // the SAME pass. The bounce must be applied EXACTLY ONCE — had it been
+  // applied twice (once per neighbour) the flip would cancel out and the ball
+  // would plough straight through (the issue's pass-through bug).
+  const ball = { x: 176, y: 112, r: BALL_R, vx: 100, vy: 300 };
+  const state = brickState(ball, [left, right]);
+  resolveBrickCollisions(state, 176, 55);
+
+  // velx flipped exactly once (100 -> -100). A double flip would leave it back
+  // at +100 (cancelled out) — the exact failure mode described in the issue.
+  assert.equal(state.ball.vx, -100, 'horizontal velocity flipped exactly once (not cancelled)');
+  assert.equal(state.ball.vy, 300, 'vy untouched on a seam-side hit');
+  assert.equal(state.bricks[0].alive, false, 'left neighbour destroyed');
+  assert.equal(state.bricks[1].alive, false, 'right neighbour destroyed');
+  assert.equal(state.score, 350, 'both bricks scored with the combo applied');
+});
+
+// Tunnelling: prev and current straddle the brick with NO overlap at either
+// endpoint. The sweep must still catch the brick in between.
+test('brick bounce: high speed sweep catches a brick the ball would tunnel through', () => {
+  const ball = { x: 190, y: 110, r: BALL_R, vx: 400, vy: 0 }; // already past the brick
+  const state = brickState(ball, [{ ...B, x: 100, w: 72 }]);
+  // prev is on the far left of the brick: neither endpoint overlaps it.
+  resolveBrickCollisions(state, 70, 110);
+
+  assert.equal(state.bricks[0].alive, false, 'brick hit during the sweep is destroyed');
+  assert.ok(state.ball.vx < 0, 'vx flipped by the swept hit');
+});
