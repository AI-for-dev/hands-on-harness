+// --- Brick bounce (issue #1) ----------------------------------------------
+
+// Applies an exactly-once bounce against a brick that the ball overlaps.
+//
+//   * per-face : the axis with the *smaller* penetration is the face hit — we
+//     flip `vy` on a top/bottom hit, `vx` on a side hit and leave the other
+//     component untouched;
+//   * corner   : equal penetrations on both axes mean a diagonal hit — flip
+//     both components;
+//   * push-out : the ball is repositioned *outside* the brick rectangle
+//     (plus its radius), otherwise it would still overlap on the next frame
+//     and re-flip forever (sticky bounce).
+function bounceBall(ball, brick, cx, cy) {
+  // Penetration depth measured from each face (positive only while inside).
+  const fromLeft = cx + ball.r - brick.x;
+  const fromRight = brick.x + brick.w - cx + ball.r;
+  const fromTop = cy + ball.r - brick.y;
+  const fromBottom = brick.y + brick.h - cy + ball.r;
+
+  const overlapX = Math.min(fromLeft, fromRight);
+  const overlapY = Math.min(fromTop, fromBottom);
+  const EPS = 1e-3;
+
+  if (Math.abs(overlapX - overlapY) <= EPS) {
+    // Corner / diagonal hit: flip both components and push out to the corner.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    const toLeft = cx < brick.x + brick.w / 2;
+    const toTop = cy < brick.y + brick.h / 2;
+    ball.x = toLeft ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    ball.y = toTop ? brick.y - ball.r : brick.y + brick.h + ball.r;
+    return;
+  }
+
+  if (overlapX < overlapY) {
+    // Side face hit: flip `vx`, leave `vy` alone. Push out sideways.
+    if (fromLeft < fromRight) ball.x = brick.x - ball.r;
+    else ball.x = brick.x + brick.w + ball.r;
+    ball.vx = -ball.vx;
+  } else {
+    // Top/bottom face hit: flip `vy`, leave `vx` alone. Push out vertically.
+    if (fromTop < fromBottom) ball.y = brick.y - ball.r;
+    else ball.y = brick.y + brick.h + ball.r;
+    ball.vy = -ball.vy;
+  }
+}
+
+// Resolves the ball against every alive brick for this frame.
+//
+// `prevX/prevY` are the ball's position *before* the move, so we can SWEEP
+// the whole trajectory: detection is discrete (position before/after the
+// move) and at high speed the ball can jump over a brick in a single step
+// (tunnelling). Sub-stepping the segment at < ball-diameter granularity
+// catches every brick the ball crosses.
+//
+// The grid gap is 8 px and the ball is 14 px across, so a seam overlaps two
+// bricks in the *same* pass. To avoid `vy = -vy` twice cancelling out (the
+// ball passes straight through), the bounce is applied EXACTLY ONCE — the
+// first brick encountered determines the face — and then every brick that
+// the ball touched at that point is destroyed.
+// Returns `true` if any brick was hit this pass.
+export function resolveBrickCollisions(state, prevX, prevY) {
+  const ball = state.ball;
+  const px = prevX ?? ball.x;
+  const py = prevY ?? ball.y;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+  const dist = Math.hypot(dx, dy);
+  // Sub-steps never exceed a ball radius, so no brick can be tunnelled.
+  const steps = Math.max(1, Math.ceil(dist / BALL_R));
+
+  for (let i = 0; i <= steps; i++) {
+    const t = i / steps;
+    const cx = px + dx * t;
+    const cy = py + dy * t;
+
+    let hit = null;
+    for (const brick of state.bricks) {
+      if (brick.alive && collides({ x: cx, y: cy, r: ball.r }, brick)) {
+        hit = brick;
+        break;
+      }
+    }
+    if (!hit) continue;
+
+    // Exact-once bounce against the first brick hit.
+    bounceBall(ball, hit, cx, cy);
+
+    // Destroy every brick touched at this point (covers seam neighbours too).
+    for (const brick of state.bricks) {
+      const touched =
+        brick.alive &&
+        (collides({ x: cx, y: cy, r: ball.r }, brick) || collides(ball, brick));
+      if (touched) {
+        brick.alive = false;
+        state.combo += 1;
+        state.score += scoreForBrick(brick, state.combo);
+      }
+    }
+    return true;
+  }
+  return false;
+}
