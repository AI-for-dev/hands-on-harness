+// --- Issue #1: the ball must bounce off bricks -----------------------------
+
+// Minimal state wired to reach a single, isolated brick without other
+// interference.
+function stateWith(ball, bricks) {
+  return {
+    level: 1,
+    combo: 0,
+    score: 0,
+    paddle: { x: 1000, y: 2000, w: 96, h: 12 }, // far away, never hit
+    ball,
+    bricks,
+  };
+}
+
+function brickAt(x, y, opts = {}) {
+  return { x, y, w: 72, h: 20, alive: true, row: 0, points: 100, ...opts };
+}
+
+// #1 — a ball hitting the underside (bottom face) of a brick bounces DOWN
+// instead of continuing up through the row.
+test('brick: bounce off the bottom face (approach from below)', () => {
+  const bricks = [brickAt(290, 50)]; // spans x 290..362, y 50..70
+  const ball = { x: 320, y: 90, r: 7, vx: 0, vy: -300 };
+  const state = stateWith(ball, bricks);
+
+  const lost = step(state, 0.1);
+
+  assert.equal(lost, false);
+  assert.equal(bricks[0].alive, false, 'the brick should be destroyed');
+  assert.ok(ball.vy > 0, 'vertical velocity should flip to DOWN');
+  assert.equal(ball.vx, 0, 'the untouched component stays exactly as it was');
+  assert.ok(ball.y > 70, 'the ball should be pushed back below the brick');
+});
+
+// #1 — a ball hitting a brick sideways is sent back the way it came.
+test('brick: bounce off the left face (approach from the side)', () => {
+  const bricks = [brickAt(290, 50)]; // left face at x = 290
+  const ball = { x: 250, y: 60, r: 7, vx: 400, vy: 0 };
+  const state = stateWith(ball, bricks);
+
+  step(state, 0.2);
+
+  assert.equal(bricks[0].alive, false, 'the brick should be destroyed');
+  assert.ok(ball.vx < 0, 'horizontal velocity should flip to the left');
+  assert.equal(ball.vy, 0, 'the untouched component stays exactly as it was');
+  assert.ok(ball.x + ball.r < 290, 'the ball should be pushed back to the left');
+});
+
+// #1 — an untouched brick is left alone (no false positives).
+test('brick: a brick that is not hit is untouched', () => {
+  const bricks = [brickAt(290, 50), brickAt(100, 100)];
+  const ball = { x: 320, y: 90, r: 7, vx: 0, vy: -300 };
+  const state = stateWith(ball, bricks);
+
+  step(state, 0.1);
+
+  assert.equal(bricks[0].alive, false);
+  assert.equal(bricks[1].alive, true, 'the far brick must remain intact');
+});
+
+// #1 + #5 — tunnelling: a fast ball must not leap over a row of bricks.
+test('brick: fast head-on shot bounces off, does NOT tunnel through the row', () => {
+  const bricks = makeBricks(1); // full row at y = 48..68
+  const ball = { x: 320, y: 100, r: 7, vx: 0, vy: -1000 };
+  const state = stateWith(ball, bricks);
+
+  step(state, 0.05); // 50 px this frame, > brick thickness
+
+  assert.ok(ball.vy > 0, 'the ball should bounce back DOWN, not keep going up');
+  assert.ok(
+    bricks.some((b) => b.alive === false),
+    'at least one brick in the path is broken',
+  );
+  // ball has been sent back to the side it came from (below the row)
+  assert.ok(ball.y > 30, 'the ball stays on the entry side of the row');
+});
+
+// #1 — neighbours: two bricks overlapping the ball in the same pass must not
+// cancel a bounce (that is what let the ball plow straight through a seam).
+// The consolidated resolution flips vx exactly once.
+test('brick: seam between two bricks applies the bounce exactly once', () => {
+  // A and B sit side by side (8 px gap at x 140..148); the ball spans both.
+  const a = brickAt(100, 80);
+  const b = brickAt(148, 80, { row: 0 });
+  const ball = { x: 144, y: 90, r: 7, vx: 200, vy: 0 }; // moving right
+  const state = stateWith(ball, [a, b]);
