+// --- Issue #1: the ball bounces off bricks instead of plowing through ---------
+
+// Build a bare state with a single brick at the given box, so each bounce case
+// is isolated from the rest of the field.
+function stateWithBrick(brick) {
+  const state = createState(1);
+  state.bricks = [{ ...brick, alive: true, points: 10 }];
+  return state;
+}
+
+test('brick: ball moving down flips vy on a top-face hit, vx untouched', () => {
+  const state = stateWithBrick({ x: 100, y: 100, w: 72, h: 20 });
+  state.ball = { x: 150, y: 92, r: 7, vx: 0, vy: 200 };
+  step(state, 0.05); // ball drops to y=102, overlapping the top of the brick
+  assert.equal(state.ball.vy, -200, 'top hit must flip vy exactly once');
+  assert.equal(state.ball.vx, 0, 'horizontal velocity must be untouched');
+  assert.ok(state.ball.y < 100, 'ball must be pushed out above the brick');
+  assert.equal(state.bricks[0].alive, false);
+  assert.ok(state.score > 0, 'breaking the brick must score');
+});
+
+test('brick: ball moving right flips vx on a side-face hit, vy untouched', () => {
+  const state = stateWithBrick({ x: 100, y: 100, w: 72, h: 20 });
+  state.ball = { x: 86, y: 110, r: 7, vx: 200, vy: 0 };
+  step(state, 0.05); // ball moves to x=96, overlapping the left face
+  assert.equal(state.ball.vx, -200, 'side hit must flip vx exactly once');
+  assert.equal(state.ball.vy, 0, 'vertical velocity must be untouched');
+  assert.ok(state.ball.x < 100, 'ball must be pushed out left of the brick');
+  assert.equal(state.bricks[0].alive, false);
+});
+
+test('brick: diagonal corner hit flips both components', () => {
+  const state = stateWithBrick({ x: 100, y: 100, w: 72, h: 20 });
+  state.ball = { x: 102, y: 118, r: 7, vx: 200, vy: -200 }; // ox === oy
+  step(state, 0);
+  assert.equal(state.ball.vx, -200);
+  assert.equal(state.ball.vy, 200);
+  assert.equal(state.bricks[0].alive, false);
+});
+
