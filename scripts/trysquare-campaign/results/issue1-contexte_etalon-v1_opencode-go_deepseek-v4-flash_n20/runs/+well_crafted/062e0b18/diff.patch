+// Minimal stand-in for a canvas 2D context: `frame()` draws, so a plain object
+// with no-op drawing methods is enough to exercise the collision logic.
+function mockCtx() {
+  return {
+    fillStyle: '',
+    font: '',
+    fillRect() {},
+    fillText() {},
+    beginPath() {},
+    arc() {},
+    fill() {},
+  };
+}
+
+// Runs one `frame()` with the given ball placed at `x,y`, having arrived there
+// in this frame from `prevX,prevY` (i.e. the sweep ends at `x,y`). There is a
+// single live brick at the given rect.
+function bounceBall({ x, y, prevX, prevY, vx, vy, brick }) {
+  const state = createState(1);
+  state.bricks = [{ ...brick, alive: true, row: 1 }];
+  state.ball.prevX = prevX;
+  state.ball.prevY = prevY;
+  state.ball = {
+    ...state.ball,
+    x,
+    y,
+    vx,
+    vy,
+    prevX,
+    prevY,
+  };
+  frame(mockCtx(), state);
+  return state;
+}
