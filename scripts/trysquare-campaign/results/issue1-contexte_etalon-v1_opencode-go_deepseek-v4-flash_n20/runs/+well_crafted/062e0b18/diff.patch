+// --- #1: brick bounce ------------------------------------------------------
+
+const BRICK = { x: 100, y: 100, w: 72, h: 20, row: 1, points: 100 };
+
+// 1. Per face — a ball climbing into the brick from below hits the BOTTOM face:
+//    the ball is pushed out below the brick and `vy` is reflected (becomes
+//    DOWN / positive). `vx` is left exactly as it was.
+test('bounce: head-on from below flips vy only, vx unchanged', () => {
+  const s = bounceBall({
+    x: 136, y: 124, prevX: 136, prevY: 126,
+    vx: 0, vy: -100, brick: BRICK,
+  });
+  assert.equal(s.ball.vy, 100, 'vy reflected from UP to DOWN');
+  assert.equal(s.ball.vx, 0, 'vx left untouched');
+});
+
+// 1b. Side hit — ball approaching from the RIGHT hits the RIGHT face: it
+//     bounces back to the right (`vx` flips sign) while `vy` is untouched.
+test('bounce: side hit flips vx only, vy unchanged', () => {
+  const s = bounceBall({
+    x: 178, y: 110, prevX: 180, prevY: 110,
+    vx: -50, vy: 42, brick: BRICK,
+  });
+  assert.equal(s.ball.vx, 50, 'vx reflected back to the right (away from brick)');
+  assert.equal(s.ball.vy, 42, 'vy left untouched');
+  assert.equal(s.ball.x, BRICK.x + BRICK.w + 7, 'pushed out to the right');
+});
+
+// 1c. Corner — equal penetration on both axes flips BOTH components.
+test('bounce: corner (equal penetration) flips both components', () => {
+  const s = bounceBall({
+    x: 103, y: 103, prevX: 103, prevY: 103,
+    vx: 50, vy: 50, brick: BRICK,
