+// Reflects the ball off the brick face it actually struck and pushes it just
+// outside the brick so it cannot overlap it on the next step/frame (a leftover
+// overlap would trigger the bounce again forever — the sticky bounce).
+//
+// The face is decided by the axis of SMALLER penetration: that axis carries the
+// shallowest overlap, hence the face the ball is really hitting. `vy` flips on
+// a top/bottom hit, `vx` on a side hit, and the other component is left exactly
+// as it was. Equal penetration on both axes is a diagonal (corner) hit and
+// flips both components. Y grows downward (see the axis convention above), so
+// UP is a negative `vy` and DOWN a positive one.
+function resolveBounce(ball, brick) {
+  const overlapX = Math.min(
+    ball.x + ball.r - brick.x,
+    brick.x + brick.w - (ball.x - ball.r)
+  );
+  const overlapY = Math.min(
+    ball.y + ball.r - brick.y,
+    brick.y + brick.h - (ball.y - ball.r)
+  );
+
+  if (overlapY < overlapX) {
+    // Top / bottom face.
+    if (ball.y <= brick.y + brick.h / 2) {
+      ball.y = brick.y - ball.r; // push just above the brick
+      ball.vy = -Math.abs(ball.vy); // reflect back UP
+    } else {
+      ball.y = brick.y + brick.h + ball.r; // push just below the brick
+      ball.vy = Math.abs(ball.vy); // reflect back DOWN
+    }
+  } else if (overlapX < overlapY) {
+    // Side face.
+    if (ball.x <= brick.x + brick.w / 2) {
+      ball.x = brick.x - ball.r; // push just left of the brick
+      ball.vx = -Math.abs(ball.vx); // reflect back LEFT
+    } else {
+      ball.x = brick.x + brick.w + ball.r; // push just right of the brick
+      ball.vx = Math.abs(ball.vx); // reflect back RIGHT
+    }
+  } else {
+    // Corner: equal penetration means a diagonal hit — flip BOTH components.
+    if (ball.x <= brick.x + brick.w / 2) ball.vx = -Math.abs(ball.vx);
+    else ball.vx = Math.abs(ball.vx);
+    if (ball.y <= brick.y + brick.h / 2) ball.vy = -Math.abs(ball.vy);
+    else ball.vy = Math.abs(ball.vy);
+    ball.x =
+      ball.x <= brick.x + brick.w / 2 ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    ball.y =
+      ball.y <= brick.y + brick.h / 2 ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  }
+}
+
+// Sweeps the ball from where it was before the last `step()` to where it now
+// is, in sub-steps no larger than a ball diameter. A single frame can move the
+// ball far enough (35.5 px at level 6) to jump clean over the 34 px a brick
+// takes to cross (BRICK_H + diameter) in one discrete hop — sub-stepping the
+// sweep catches it, so the ball can never tunnel through a brick.
+//
+// Bricks overlap at the seams (grid gap 8 px < ball diameter 14 px), so one
+// ball can straddle two bricks in the same pass. Every touched brick is broken
+// and scored, but the velocity bounce is applied EXACTLY ONCE — a naive per-
+// brick `vy = -vy` would flip twice and cancel out, letting the ball through.
+// The bounce targets the face the ball has penetrated least.
+//
+// Mutates `state` (bricks, combo, score, ball). Returns nothing.
+function resolveBricks(state, prevX, prevY) {
+  const { ball } = state;
+  const dx = ball.x - prevX;
+  const dy = ball.y - prevY;
+  const total = Math.hypot(dx, dy);
+  const dirX = total > 0 ? dx / total : 0;
+  const dirY = total > 0 ? dy / total : 0;
+  const subLen = 2 * ball.r;
+
+  // Re-trace the segment actually travelled this frame: begin at the previous
+  // position and step toward the current one, so the path BETWEEN the two
+  // positions is swept (that is where a fast ball would otherwise skip a brick).
+  ball.x = prevX;
+  ball.y = prevY;
+  let remaining = total;
+
+  do {
+    // Advance one sub-step along the swept segment.
+    const sub = Math.min(remaining, subLen);
+    if (total > 0) {
+      ball.x += dirX * sub;
+      ball.y += dirY * sub;
+    }
+    remaining -= sub;
+
+    // Collect every live brick the ball touches at this sub-step.
+    const hit = [];
+    for (const brick of state.bricks) {
+      if (brick.alive && collides(ball, brick)) hit.push(brick);
+    }
+    if (hit.length === 0) continue;
+
+    // Break and score each touched brick...
+    for (const brick of hit) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+    }
+
+    // ...but bounce exactly once, off the face the ball penetrated least.
+    let primary = hit[0];
+    let bestPen = Infinity;
+    for (const brick of hit) {
+      const pen = Math.min(
+        ball.x + ball.r - brick.x,
+        brick.x + brick.w - (ball.x - ball.r),
+        ball.y + ball.r - brick.y,
+        brick.y + brick.h - (ball.y - ball.r)
+      );
+      if (pen < bestPen) {
+        bestPen = pen;
+        primary = brick;
+      }
+    }
+    resolveBounce(ball, primary);
+    return; // the ball is now pushed clear; one bounce per frame is enough
+  } while (remaining > 0);
+}
