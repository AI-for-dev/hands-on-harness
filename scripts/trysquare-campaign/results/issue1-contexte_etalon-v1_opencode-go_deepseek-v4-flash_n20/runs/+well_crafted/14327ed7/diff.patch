+// Resolves a single ball-vs-brick collision (#1): flips the velocity
+// component of the face that was hit and pushes the ball back out so it never
+// sticks on the next frame. Returns nothing; mutates `ball` in place.
+//
+// The axis with the smaller penetration is the face actually struck:
+//   - top / bottom hit  -> flip vy, leave vx untouched
+//   - left / right hit  -> flip vx, leave vy untouched
+//   - equal penetration -> diagonal (corner) hit, flip both
+//
+// Each flip uses Math.abs / -Math.abs so the new sign is chosen from the hit
+// face, not from whatever sign the ball happened to carry (robust to bounces
+// applied once during a seam pass).
+export function bounceOff(ball, brick) {
+  const rightPen = ball.x + ball.r - brick.x; // ball right edge vs brick left
+  const leftPen = brick.x + brick.w - (ball.x - ball.r); // brick right vs ball left
+  const dx = Math.min(rightPen, leftPen);
+
+  const topPen = ball.y + ball.r - brick.y; // ball bottom vs brick top
+  const bottomPen = brick.y + brick.h - (ball.y - ball.r); // brick bottom vs ball top
+  const dy = Math.min(topPen, bottomPen);
+
+  // The face whose penetration is smallest is the face the ball hit, and the
+  // ball must bounce away from it (up on a top hit, down on a bottom hit, left
+  // on a left hit, right on a right hit).
+  if (dx < dy) {
+    // Side hit: smaller penetration on the horizontal axis.
+    if (rightPen < leftPen) {
+      ball.vx = -Math.abs(ball.vx); // left face -> bounce left
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.vx = Math.abs(ball.vx); // right face -> bounce right
+      ball.x = brick.x + brick.w + ball.r;
+    }
+  } else if (dy < dx) {
+    // Top / bottom hit: smaller penetration on the vertical axis.
+    if (topPen < bottomPen) {
+      ball.vy = -Math.abs(ball.vy); // top face -> bounce up
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.vy = Math.abs(ball.vy); // bottom face -> bounce down
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  } else {
+    // Corner (equal penetration): diagonal hit -> reverse both components.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x = rightPen < leftPen ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    ball.y = topPen < bottomPen ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  }
+}
+
+// Smallest penetration of the ball into a brick, across all four faces.
+// Used to pick which overlapping brick to resolve against during a seam.
+function penetration(ball, brick) {
+  const rightPen = ball.x + ball.r - brick.x;
+  const leftPen = brick.x + brick.w - (ball.x - ball.r);
+  const topPen = ball.y + ball.r - brick.y;
+  const bottomPen = brick.y + brick.h - (ball.y - ball.r);
+  const min = Math.min(rightPen, leftPen, topPen, bottomPen);
+  return min;
+}
+
+// Scans the live bricks and, if the ball overlaps any, bounces it off the one
+// it is deepest inside. Picking a single brick and pushing the ball fully out
+// of it also clears its seam neighbours (they share the pushed-back face), so
+// the bounce is applied exactly once per pass instead of twice cancelling out.
+// Also destroys the smashed brick and awards its score.
+function resolveBricks(state) {
+  const { ball, bricks } = state;
+  let target = null;
+  let deepest = Infinity;
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    if (!collides(ball, brick)) continue;
+    const pen = penetration(ball, brick);
+    if (pen < deepest) {
+      deepest = pen;
+      target = brick;
+    }
+  }
+  if (target) {
+    bounceOff(ball, target);
+    target.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(target, state.combo);
+  }
+}
