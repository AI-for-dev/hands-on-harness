+// --- Issue #1: brick bounce -----------------------------------------------
+
+test('bounce off the top face: flips vy UP, keeps vx untouched', () => {
+  const ball = { x: 100, y: 55, r: 7, vx: 30, vy: -200 };
+  const brick = { x: 90, y: 60, w: 40, h: 20 };
+  bounceOff(ball, brick);
+  assert.equal(ball.vy, -200, 'top hit must send the ball upward');
+  assert.equal(ball.vx, 30, 'vx must be left exactly as it was');
+  assert.equal(collides(ball, brick), false, 'ball pushed out of the brick');
+});
+
+test('bounce off the bottom face: flips vy DOWN, keeps vx untouched', () => {
+  const ball = { x: 100, y: 100, r: 7, vx: -20, vy: 200 };
+  const brick = { x: 90, y: 60, w: 40, h: 20 };
+  bounceOff(ball, brick);
+  assert.equal(ball.vy, 200, 'bottom hit must send the ball downward');
+  assert.equal(ball.vx, -20, 'vx must be left exactly as it was');
+  assert.equal(collides(ball, brick), false);
+});
+
+test('bounce off the left face: flips vx, keeps vy untouched', () => {
+  const ball = { x: 80, y: 70, r: 7, vx: 300, vy: -20 };
+  const brick = { x: 90, y: 60, w: 40, h: 20 };
+  bounceOff(ball, brick);
+  assert.equal(ball.vx, -300, 'vx should flip LEFT');
+  assert.equal(ball.vy, -20, 'vy must be left exactly as it was');
+  assert.equal(collides(ball, brick), false);
+});
+
+test('bounce off the right face: flips vx, keeps vy untouched', () => {
+  const ball = { x: 145, y: 70, r: 7, vx: -300, vy: -20 };
+  const brick = { x: 90, y: 60, w: 40, h: 20 };
+  bounceOff(ball, brick);
+  assert.equal(ball.vx, 300, 'vx should flip RIGHT');
+  assert.equal(ball.vy, -20, 'vy must be left exactly as it was');
+  assert.equal(collides(ball, brick), false);
+});
+
+test('corner hit (equal penetration): flips both components', () => {
+  const ball = { x: 96, y: 66, r: 7, vx: 300, vy: 200 };
+  const brick = { x: 90, y: 60, w: 40, h: 20 };
+  bounceOff(ball, brick);
+  assert.equal(ball.vx, -300);
+  assert.equal(ball.vy, -200);
+  assert.equal(collides(ball, brick), false);
