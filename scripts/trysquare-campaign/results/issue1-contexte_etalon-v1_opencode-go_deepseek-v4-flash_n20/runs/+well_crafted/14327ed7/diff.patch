+
+test('step: smashes a brick and bounces the ball upward', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 40, r: 7, vx: 0, vy: 200 };
+  state.bricks = [{ x: 90, y: 60, w: 40, h: 20, alive: true, points: 10 }];
+  const lost = step(state, 1 / 5);
+  assert.equal(lost, false);
+  assert.equal(state.bricks[0].alive, false, 'brick should be destroyed');
+  assert.ok(state.ball.vy < 0, 'ball should bounce upward after a top hit');
+  assert.ok(state.score > 0, 'score should be awarded');
