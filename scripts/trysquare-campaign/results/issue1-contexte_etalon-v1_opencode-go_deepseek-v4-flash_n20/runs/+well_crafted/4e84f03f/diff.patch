+// --- Brick collision resolution (#1) -------------------------------------
+
+// True if the ball's travel from its previous position (px, py) to its
+// current one overlaps the brick at any moment. This sweeps the segment the
+// ball covers in a single physics step, so a fast ball (level 6 can move
+// ~35 px while a brick is only 20 px tall) can never jump clean over a brick.
+// The ball is treated as the box enclosing its circle, expanded by `r`.
+function sweeps(ball, px, py, brick) {
+  const L = brick.x - ball.r;
+  const R = brick.x + brick.w + ball.r;
+  const T = brick.y - ball.r;
+  const B = brick.y + brick.h + ball.r;
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+
+  let tx0 = 0;
+  let tx1 = 1;
+  if (dx === 0) {
+    if (px < L || px > R) return false;
+  } else {
+    tx0 = (L - px) / dx;
+    tx1 = (R - px) / dx;
+    if (tx0 > tx1) [tx0, tx1] = [tx1, tx0];
+  }
+
+  let ty0 = 0;
+  let ty1 = 1;
+  if (dy === 0) {
+    if (py < T || py > B) return false;
+  } else {
+    ty0 = (T - py) / dy;
+    ty1 = (B - py) / dy;
+    if (ty0 > ty1) [ty0, ty1] = [ty1, ty0];
+  }
+
+  const t0 = Math.max(tx0, ty0);
+  const t1 = Math.min(tx1, ty1);
+  return t0 <= t1 && t1 >= 0 && t0 <= 1;
+}
+
+// Length of the ball's overlap with a rect along one axis. `center` is the
+// ball's coordinate on that axis, `lo`/`hi` the rect's bounds on that axis.
+function overlap(center, lo, hi, r) {
+  return Math.min(center + r, hi) - Math.max(center - r, lo);
+}
+
+// Resolve the ball against a brick. Caller must have already verified the
+// ball actually overlaps it. Decides which face was hit from the axis with
+// the SMALLER penetration (the leading edge), reflects the matching velocity
+// component(s) and pushes the ball back outside the brick's rectangle.
+function resolveBall(ball, prevX, prevY, brick) {
+  const ox = overlap(ball.x, brick.x, brick.x + brick.w, ball.r);
+  const oy = overlap(ball.y, brick.y, brick.y + brick.h, ball.r);
+
+  const top = brick.y;
+  const bottom = brick.y + brick.h;
+  const left = brick.x;
+  const right = brick.x + brick.w;
+
+  // Per-face: the axis with the smaller penetration is the face hit. On that
+  // axis the face itself is the one the ball is moving TOWARD (or came from),
+  // so we reflect away from it and place the ball just outside it.
+  if (ox < oy) {
+    // Side hit: flip vx, keep vy.
+    if (ball.vx >= 0) {
+      ball.vx = -Math.abs(ball.vx);
+      ball.x = left - ball.r;
+    } else {
+      ball.vx = Math.abs(ball.vx);
+      ball.x = right + ball.r;
+    }
+  } else if (oy < ox) {
+    // Top/bottom hit: flip vy, keep vx.
+    if (ball.vy >= 0) {
+      ball.vy = -Math.abs(ball.vy);
+      ball.y = top - ball.r;
+    } else {
+      ball.vy = Math.abs(ball.vy);
+      ball.y = bottom + ball.r;
+    }
+  } else {
+    // Corner: equal penetration on both axes => a diagonal hit, flip both.
+    if (ball.vx >= 0) {
+      ball.vx = -Math.abs(ball.vx);
+      ball.x = left - ball.r;
+    } else {
+      ball.vx = Math.abs(ball.vx);
+      ball.x = right + ball.r;
+    }
+    if (ball.vy >= 0) {
+      ball.vy = -Math.abs(ball.vy);
+      ball.y = top - ball.r;
+    } else {
+      ball.vy = Math.abs(ball.vy);
+      ball.y = bottom + ball.r;
+    }
+  }
+}
+
+// Resolves every brick collision for the ball in one pass and returns the
+// bricks that were broken (already marked `alive: false`). Pure: no rendering,
+// no state mutation beyond the bricks and the ball. See `frame()`.
+//
+// The neighbours / seam problem: the grid gap is 8 px and the ball is 14 px
+// across, so at a seam TWO bricks can be overlapped in the same pass. If each
+// brick independently flipped e.g. `vy`, two flips would cancel out and the
+// ball would slip through. We therefore treat all simultaneously-hit bricks
+// as one blob (their bounding box) and apply a single bounce from it.
+export function brickHit(ball, bricks) {
+  const prevX = ball.prevX ?? ball.x;
+  const prevY = ball.prevY ?? ball.y;
+
+  // 1. Sweep-detection: which live bricks does the ball (from previous to
+  //    current position) touch? This also catches tunnelling.
+  const hits = [];
+  for (const brick of bricks) {
+    if (brick.alive && sweeps(ball, prevX, prevY, brick)) hits.push(brick);
+  }
+  if (hits.length === 0) return hits;
+
+  // 2. Break every brick we hit and fold them into a single bounding box so a
+  //    seam bounce is applied exactly once.
+  let minX = Infinity;
+  let minY = Infinity;
+  let maxX = -Infinity;
+  let maxY = -Infinity;
+  for (const brick of hits) {
+    brick.alive = false;
+    minX = Math.min(minX, brick.x);
+    minY = Math.min(minY, brick.y);
+    maxX = Math.max(maxX, brick.x + brick.w);
+    maxY = Math.max(maxY, brick.y + brick.h);
+  }
+  const blob = { x: minX, y: minY, w: maxX - minX, h: maxY - minY };
+
+  // 3. Bounce the ball off the blob and push it back outside.
+  resolveBall(ball, prevX, prevY, blob);
+  return hits;
+}
