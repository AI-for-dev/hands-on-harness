+// --- #1 brick bounce ------------------------------------------------------
+
+// A brick with friendly numbers for the collision math.
+function brick() {
+  return { x: 100, y: 100, w: 72, h: 20, alive: true, points: 10 };
+}
+
+// A ball with a previous frame position (prevX/prevY) set as `step()` records
+// them, so that `brickHit()` can sweep the travelled segment.
+function ball(x, y, px, py, vx, vy, r = 7) {
+  return { x, y, r, vx, vy, prevX: px, prevY: py };
+}
+
+// #1 per-face: ball below a brick, moving up => it hits the BOTTOM face,
+// vy flips sign, vx is untouched and the ball is pushed out (no longer
+// overlapping the brick).
+test('brickHit: bottom-face hit flips vy up, keeps vx, pushes out', () => {
+  const b = brick();
+  const ballState = ball(136, 115, 136, 140, 0, -100);
+  const hits = brickHit(ballState, [b]);
+
+  assert.equal(hits.length, 1);
+  assert.equal(b.alive, false);
+  assert.equal(Math.sign(ballState.vy), DOWN, 'vy should bounce downward');
+  assert.equal(ballState.vx, 0, 'vx must be untouched on a y hit');
+  assert.equal(collides(ballState, b), false, 'ball must be pushed out');
+});
+
+// #1 per-face: ball to the left of a brick, moving right => SIDE (left-face)
+// hit: vx flips, vy left as-is, ball pushed out.
+test('brickHit: side hit flips vx, keeps vy, pushes out', () => {
+  const b = brick();
+  const ballState = ball(95, 110, 80, 110, 50, 0);
+  const hits = brickHit(ballState, [b]);
+
+  assert.equal(hits.length, 1);
+  assert.equal(b.alive, false);
+  assert.equal(Math.sign(ballState.vx), -1, 'vx should flip to the left');
+  assert.equal(ballState.vy, 0, 'vy must be untouched on an x hit');
+  assert.equal(collides(ballState, b), false, 'ball must be pushed out');
+});
+
+// #1 corner: a diagonal hit into a corner flips BOTH components and pushes
+// the ball out of overlap.
+test('brickHit: diagonal corner hit flips both components', () => {
+  const b = brick();
+  // centred exactly on the brick's top-left corner => equal penetration on
+  // both axes.
+  const ballState = ball(100, 100, 90, 130, 40, -40);
+  const hits = brickHit(ballState, [b]);
+
+  assert.equal(hits.length, 1);
+  assert.equal(b.alive, false);
+  assert.equal(ballState.vx, -40, 'vx should flip');
+  assert.equal(ballState.vy, 40, 'vy should flip');
+  assert.equal(collides(ballState, b), false, 'ball must be pushed out');
+});
+
+// #1 neighbours: two bricks sharing a seam (the 8 px gap) overlap the SAME
+// 14 px ball in a single pass. The bounce must be applied exactly once: if
+// vy changed twice it would cancel out and the ball would travel through.
+test('brickHit: seam between two bricks bounces exactly once', () => {
+  const a = { x: 100, y: 100, w: 72, h: 20, alive: true, points: 10 };
+  const b = { x: 180, y: 100, w: 72, h: 20, alive: true, points: 10 };
+  // Ball centred over the 8 px gap (x 172..180), moving up into both bricks.
+  const ballState = ball(176, 113, 176, 125, 0, -100);
+  const hits = brickHit(ballState, [a, b]);
+
+  assert.equal(hits.length, 2, 'both seam neighbours are hit');
+  assert.equal(a.alive, false);
+  assert.equal(b.alive, false);
+  // Exactly one bounce: vy must have flipped sign once (it went in at UP and
+  // must come back DOWN), not be cancelled back to UP.
+  assert.equal(Math.sign(ballState.vy), DOWN, 'vy flipped exactly once');
+  assert.equal(collides(ballState, a) || collides(ballState, b), false, 'pushed out');
