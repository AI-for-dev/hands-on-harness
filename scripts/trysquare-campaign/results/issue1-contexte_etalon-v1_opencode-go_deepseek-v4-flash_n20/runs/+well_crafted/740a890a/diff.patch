+// --- #1 brick bounce --------------------------------------------------------
+// The ball must bounce off bricks with a real per-face deflection and be pushed
+// back out (no sticky re-flip), every overlapped brick at a seam must break but
+// the bounce applied only once, and a fast ball must not tunnel through.
+
+function brickAt(x, y, w = 40, h = 20) {
+  return { x, y, w, h, row: 0, alive: true, points: 10 };
+}
+
+function stateWithBrick(bricks, ball) {
+  const s = createState(1);
+  s.ball = { x: 0, y: 0, r: 7, vx: 0, vy: 0, ...ball };
+  s.bricks = bricks;
+  return s;
+}
+
+test('brick: hit from below flips vy down and pushes the ball out', () => {
+  const brick = brickAt(0, 100); // spans y 100..120
+  const s = stateWithBrick([brick], { x: 20, y: 126, vx: 0, vy: -300 });
+  step(s, 1 / 60);
+  assert.equal(brick.alive, false, 'brick destroyed');
+  assert.ok(s.ball.vy > 0, 'vy flips downward after a top/bottom hit');
+  assert.ok(s.ball.y >= 127, 'ball pushed below the brick (no sticky overlap)');
+});
+
+test('brick: side hit flips vx and pushes the ball out', () => {
+  const brick = brickAt(100, 50); // spans x 100..140
+  const s = stateWithBrick([brick], { x: 95, y: 60, vx: 120, vy: 0 });
+  step(s, 1 / 60);
+  assert.equal(brick.alive, false, 'brick destroyed');
+  assert.ok(s.ball.vx < 0, 'vx flips left after a side hit');
+  assert.ok(s.ball.x <= 93, 'ball pushed left of the brick');
+});
+
+test('brick: corner hit flips both components (diagonal)', () => {
+  const brick = brickAt(100, 50); // top-left corner at (100,50)
+  const s = stateWithBrick([brick], { x: 100, y: 50, vx: 200, vy: 200 });
+  step(s, 1 / 60);
+  assert.equal(brick.alive, false, 'brick destroyed');
+  assert.ok(s.ball.vx < 0, 'vx flipped by the corner');
+  assert.ok(s.ball.vy < 0, 'vy flipped by the corner');
+});
+
+test('brick: seam straddling two neighbours breaks both, bounces once', () => {
+  const a = brickAt(100, 50, 72, 20); // spans x 100..172
+  const b = brickAt(180, 50, 72, 20); // spans x 180..252 (gap of 8)
+  const s = stateWithBrick([a, b], { x: 176, y: 90, vx: 0, vy: -800 });
+  step(s, 1 / 60);
+  assert.equal(a.alive, false, 'left neighbour broken');
+  assert.equal(b.alive, false, 'right neighbour broken');
+  assert.ok(s.ball.vy > 0, 'a single bounce: vy flipped exactly once');
+});
+
+test('brick: fast ball does not tunnel through a brick', () => {
+  const brick = brickAt(0, 50, 40, 20);
+  const s = stateWithBrick([brick], { x: 20, y: 30, vx: 0, vy: 10000 });
+  step(s, 1 / 60);
+  // A fast ball that jumped the brick entirely would leave it alive. It must be
+  // caught and destroyed even though it crosses many times its own size in a
+  // single frame (the substep sweep).
+  assert.equal(brick.alive, false, 'fast ball caught the brick instead of tunnelling');
+});
