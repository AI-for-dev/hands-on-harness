+// How far the ball overlaps the brick along each axis, in pixels.
+// These measure the shortest escape on each axis; the smallest of the two
+// tells us which face was actually struck (see reflectBall).
+function penetrateX(ball, brick) {
+  return Math.min(ball.x + ball.r - brick.x, brick.x + brick.w - (ball.x - ball.r));
+}
+
+function penetrateY(ball, brick) {
+  return Math.min(ball.y + ball.r - brick.y, brick.y + brick.h - (ball.y - ball.r));
+}
+
+// Tolerance used to decide whether both penetrations are "equal" (a corner
+// hit). The overlap values are floats; comparing them with a bare < would send
+// a true corner hit into one of the face branches depending on rounding.
+const CORNER_EPS = 0.5;
+
+// Resolves a single ball/brick overlap: flips the correct velocity component(s)
+// for the face that was hit and pushes the ball back OUTSIDE the brick so it
+// cannot re-overlap (and re-flip) on the next frame — the "sticky bounce".
+//
+//  * top/bottom face  -> the smaller penetration is on Y -> flip vy
+//  * side face        -> the smaller penetration is on X -> flip vx
+//  * corner           -> equal penetrations, a diagonal hit -> flip both
+function reflectBall(ball, brick) {
+  const px = penetrateX(ball, brick);
+  const py = penetrateY(ball, brick);
+
+  if (Math.abs(px - py) <= CORNER_EPS) {
+    // Corner: a diagonal hit. Push the ball back outside the corner it
+    // approached from, then reflect both components.
+    const right = ball.vx > 0;
+    const down = ball.vy > 0;
+    if (right && down) {
+      ball.x = brick.x - ball.r;
+      ball.y = brick.y - ball.r;
+    } else if (!right && down) {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.y = brick.y - ball.r;
+    } else if (right && !down) {
+      ball.x = brick.x - ball.r;
+      ball.y = brick.y + brick.h + ball.r;
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.y = brick.y + brick.h + ball.r;
+    }
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+  } else if (py < px) {
+    // Top/bottom face.
+    if (ball.vy > 0) ball.y = brick.y - ball.r;
+    else ball.y = brick.y + brick.h + ball.r;
+    ball.vy = -ball.vy;
+  } else {
+    // Side face.
+    if (ball.vx > 0) ball.x = brick.x - ball.r;
+    else ball.x = brick.x + brick.w + ball.r;
+    ball.vx = -ball.vx;
+  }
+}
