+// ---- Ball / brick bounce (#1) ---------------------------------------------
+
+// A minimal state with bricks and a real paddle (never reached in these tests).
+function stateWithBrick(bricks, ball, level = 1) {
+  return {
+    level,
+    score: 0,
+    combo: 0,
+    ball,
+    bricks,
+    paddle: { x: 272, y: 448, w: 96, h: 12 },
+  };
+}
+
+// Each test needs its OWN brick: the solver flips `alive` in place.
+function singleBrick() {
+  return [{ x: 100, y: 100, w: 40, h: 20, alive: true, points: 10 }];
+}
+
+// A real bounce must flip the component on the hit face, leave the other one
+// untouched, push the ball clear (no sticky re-bounce) and destroy the brick.
+test('brick bounce: top face flips vy up and clears the ball', () => {
+  // Ball resting on the top edge, driving straight down into the brick top.
+  const state = stateWithBrick(singleBrick(), { x: 120, y: 93, r: 7, vx: 0, vy: 400 });
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy < 0, 'vy should flip to UP after a top hit');
+  assert.equal(state.ball.vx, 0, 'vx must be untouched on a top hit');
+  assert.ok(state.ball.y + state.ball.r <= 100, 'ball pushed above the brick top');
+  assert.equal(state.bricks[0].alive, false, 'brick destroyed');
+});
+
+test('brick bounce: bottom face flips vy down', () => {
+  // Ball resting just under the brick, driving straight up into its bottom.
+  const state = stateWithBrick(singleBrick(), { x: 120, y: 127, r: 7, vx: 0, vy: -400 });
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy > 0, 'vy should flip to DOWN after a bottom hit');
+  assert.ok(state.ball.y - state.ball.r >= 120, 'ball pushed below the brick bottom');
+});
+
+test('brick bounce: left face flips vx and leaves the side untouched', () => {
+  // Ball centred vertically in the brick span, driving straight right.
+  const state = stateWithBrick(singleBrick(), { x: 93, y: 110, r: 7, vx: 400, vy: 0 });
+  step(state, 1 / 60);
+  assert.ok(state.ball.vx < 0, 'vx should flip to LEFT after a side hit');
+  assert.equal(state.ball.vy, 0, 'vy must be untouched on a side hit');
+  assert.ok(state.ball.x + state.ball.r <= 100, 'ball pushed out to the left of the brick');
+  assert.equal(state.bricks[0].alive, false, 'brick destroyed');
+});
+
+test('brick bounce: two seam neighbours bounce exactly once', () => {
+  // Side-by-side bricks with an 8 px gap; the 14 px ball overlaps both, but the
+  // combined surface must flip vy ONCE (twice would cancel and punch through).
+  const state = stateWithBrick(
+    [
+      { x: 200, y: 100, w: 40, h: 20, alive: true, points: 10 },
+      { x: 248, y: 100, w: 40, h: 20, alive: true, points: 10 },
+    ],
+    { x: 244, y: 93, r: 7, vx: 0, vy: 400 } // 14 px ball spans the 8 px seam
+  );
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy < 0, 'should bounce UP once, not cancel out');
+  assert.ok(state.ball.y + state.ball.r <= 100, 'ball cleared above both bricks');
+  assert.ok(state.bricks.every((b) => !b.alive), 'both bricks destroyed');
+});
+
+test('brick bounce: tunnelling is prevented for a fast, stuttered ball', () => {
+  // ballSpeed(6)=710 px/s and a stutter-capped 50 ms frame = 35.5 px of travel,
+  // enough to cross BRICK_H + diameter (34 px) in one discrete leap. The sweep
+  // inside step must still catch the brick.
+  const state = stateWithBrick(singleBrick(), { x: 120, y: 93, r: 7, vx: 0, vy: 710 }, 6);
+  step(state, 0.05); // stutter-capped frame
+  assert.ok(state.ball.vy < 0, 'fast ball must still bounce off the top face');
+  assert.equal(state.bricks[0].alive, false, 'brick destroyed despite the leap');
+});
+
