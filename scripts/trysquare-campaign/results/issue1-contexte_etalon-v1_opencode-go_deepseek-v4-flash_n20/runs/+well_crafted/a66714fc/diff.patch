+// ----------------------- Brick collision (#1) ------------------------------
+
+// The ball only ever touches bricks that share an edge (its diameter is 14 px
+// against an 8 px gap), so a set of overlapping bricks is always a contiguous
+// blob. Resolving that blob as a SINGLE solid surface makes the bounce apply
+// exactly once: flipping vy twice (once per neighbour) would cancel out and
+// the ball would punch straight through the seam.
+function resolveBricks(state) {
+  const { ball } = state;
+
+  const hit = [];
+  let minX = Infinity;
+  let minY = Infinity;
+  let maxX = -Infinity;
+  let maxY = -Infinity;
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+    if (collides(ball, brick)) {
+      hit.push(brick);
+      if (brick.x < minX) minX = brick.x;
+      if (brick.y < minY) minY = brick.y;
+      if (brick.x + brick.w > maxX) maxX = brick.x + brick.w;
+      if (brick.y + brick.h > maxY) maxY = brick.y + brick.h;
+    }
+  }
+  if (hit.length === 0) return;
+
+  // The combined bounding surface of every brick touched this sub-step.
+  const box = { x: minX, y: minY, w: maxX - minX, h: maxY - minY };
+
+  // Penetration depth on each axis (how deep the ball is inside the surface).
+  const rightOverlap = ball.x + ball.r - box.x;
+  const leftOverlap = box.x + box.w - (ball.x - ball.r);
+  const topOverlap = ball.y + ball.r - box.y;
+  const bottomOverlap = box.y + box.h - (ball.y - ball.r);
+  const penX = Math.min(rightOverlap, leftOverlap);
+  const penY = Math.min(topOverlap, bottomOverlap);
+
+  // Which side of the surface the ball is travelling out of.
+  const fromLeft = rightOverlap <= leftOverlap; // ball center left of box
+  const fromTop = topOverlap <= bottomOverlap; // ball center above box
+
+  if (Math.abs(penX - penY) < 0.0001) {
+    // Diagonal / corner hit: equal penetrations -> flip BOTH components and
+    // push the ball out toward the corner.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x = fromLeft ? box.x - ball.r : box.x + box.w + ball.r;
+    ball.y = fromTop ? box.y - ball.r : box.y + box.h + ball.r;
+  } else if (penY < penX) {
+    // Vertical (top/bottom) hit: flip vy, leave vx exactly as it was, push out.
+    ball.vy = -ball.vy;
+    ball.y = fromTop ? box.y - ball.r : box.y + box.h + ball.r;
+  } else {
+    // Horizontal (left/right) hit: flip vx, leave vy exactly as it was, push out.
+    ball.vx = -ball.vx;
+    ball.x = fromLeft ? box.x - ball.r : box.x + box.w + ball.r;
+  }
+
+  // Destroy every brick we hit and credit the score / combo.
+  for (const brick of hit) {
+    if (!brick.alive) continue;
+    brick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(brick, state.combo);
