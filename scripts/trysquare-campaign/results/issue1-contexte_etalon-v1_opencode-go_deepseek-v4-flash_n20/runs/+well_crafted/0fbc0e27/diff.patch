+// --- Brick bounce (issue #1) ---------------------------------------------
+
+// Liang–Barsky clipped segment test: does the segment (x0,y0)-(x1,y1) touch
+// the axis-aligned rectangle (rx,ry,rw,rh)? Used to sweep the ball's radius-
+// expanded path for a brick it jumped over in a single (possibly stuttered)
+// step — the tunnelling case.
+function segmentHitsRect(x0, y0, x1, y1, rx, ry, rw, rh) {
+  let t0 = 0;
+  let t1 = 1;
+  const dx = x1 - x0;
+  const dy = y1 - y0;
+  const p = [-dx, dx, -dy, dy];
+  const q = [x0 - rx, rx + rw - x0, y0 - ry, ry + rh - y0];
+  for (let i = 0; i < 4; i++) {
+    if (p[i] === 0) {
+      if (q[i] < 0) return false; // parallel and outside
+    } else {
+      const t = q[i] / p[i];
+      if (p[i] < 0) {
+        if (t > t1) return false;
+        if (t > t0) t0 = t;
+      } else {
+        if (t < t0) return false;
+        if (t < t1) t1 = t;
+      }
+    }
+  }
+  return true;
+}
+
+// Resolves the ball against every live brick in one pass. Handles all five
+// cases from ISSUES.md #1:
+//   - per face: the axis with the smaller penetration is the face hit — flip
+//     vy on a top/bottom hit, vx on a side hit, leave the other component alone;
+//   - corner: equal penetrations mean a diagonal hit — flip both;
+//   - push out: reposition the ball fully outside the bricks it touched,
+//     otherwise it overlaps again next frame and re-flips forever (sticky);
+//   - neighbours: the grid gap is 8 px and the ball 14 px across, so a seam can
+//     overlap two bricks in the same pass. The flip is decided once per axis
+//     from the whole hit set, so "vy = -vy" never cancels out;
+//   - tunnelling: position before/after the move is swept (segment test) so a
+//     fast ball crossing a brick within one step still counts as a hit.
+// Returns the list of bricks hit (they remain alive here; frame() destroys
+// them and awards points).
+export function brickBounce(state) {
+  const ball = state.ball;
+  const prev = state.ballPrev;
+  const hits = [];
+
+  // Smallest penetration per axis across every colliding brick. The smaller
+  // value names the blocked axis (the face that was hit).
+  let minDx = Infinity;
+  let minDy = Infinity;
+
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+
+    const overlap = collides(ball, brick);
+    if (overlap) {
+      const dx = Math.min(
+        ball.x + ball.r - brick.x,
+        brick.x + brick.w - (ball.x - ball.r),
+      );
+      const dy = Math.min(
+        ball.y + ball.r - brick.y,
+        brick.y + brick.h - (ball.y - ball.r),
+      );
+      if (dx < minDx) minDx = dx;
+      if (dy < minDy) minDy = dy;
+      hits.push(brick);
+    } else if (
+      prev &&
+      segmentHitsRect(
+        prev.x,
+        prev.y,
+        ball.x,
+        ball.y,
+        brick.x - ball.r,
+        brick.y - ball.r,
+        brick.w + 2 * ball.r,
+        brick.h + 2 * ball.r,
+      )
+    ) {
+      // Tunnelling: the ball cleared the gap between steps. Classify the face
+      // by the axis that mostly carried the movement.
+      const mvx = Math.abs(ball.vx);
+      const mvy = Math.abs(ball.vy);
+      if (mvx > mvy) {
+        if (mvx < minDx) minDx = mvx;
+      } else if (mvy > mvx) {
+        if (mvy < minDy) minDy = mvy;
+      } else {
+        if (mvx < minDx) minDx = mvx;
+        if (mvy < minDy) minDy = mvy;
+      }
+      hits.push(brick);
+    }
+  }
+
+  if (hits.length === 0) return hits;
+
+  // Decide the face (and thus the flip) exactly once for the whole hit set.
+  let flipX = false;
+  let flipY = false;
+  if (minDy < minDx) {
+    flipY = true; // top/bottom hit
+  } else if (minDx < minDy) {
+    flipX = true; // side hit
+  } else {
+    flipX = true;
+    flipY = true; // corner / diagonal hit
+  }
+
+  // Push the ball fully out, on the side it came from (trailing side). If we
+  // instead let it keep overlapping, the next frame would re-flip forever.
+  if (flipY) {
+    if (ball.vy < 0) {
+      // moving up, came from below → settle below the deepest brick
+      let bottom = -Infinity;
+      for (const b of hits) bottom = Math.max(bottom, b.y + b.h);
+      ball.y = bottom + ball.r;
+    } else {
+      // moving down, came from above → settle above the highest brick
+      let top = Infinity;
+      for (const b of hits) top = Math.min(top, b.y);
+      ball.y = top - ball.r;
+    }
+  }
+  if (flipX) {
+    if (ball.vx > 0) {
+      // moving right, came from the left → settle to the left of the bricks
+      let left = Infinity;
+      for (const b of hits) left = Math.min(left, b.x);
+      ball.x = left - ball.r;
+    } else {
+      // moving left, came from the right → settle to the right of the bricks
+      let right = -Infinity;
+      for (const b of hits) right = Math.max(right, b.x + b.w);
+      ball.x = right + ball.r;
+    }
+  }
+
+  // Apply each flip once; the untouched component keeps its exact value.
+  if (flipX) ball.vx = -ball.vx;
+  if (flipY) ball.vy = -ball.vy;
+
+  return hits;
+}
