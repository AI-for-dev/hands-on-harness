+// --- Brick bounce (issue #1) ----------------------------------------------
+
+// Build a minimal live brick for collision tests.
+function brick(x, y, w = 72, h = 20) {
+  return { x, y, w, h, row: 0, alive: true, points: 10 };
+}
+
+// Create a state with a single brick and the ball placed so it just overlaps
+// that brick (penetration given by the offset vector from the brick's corner).
+function stateAtBrick(
+  brickPos = { x: 100, y: 100 },
+  ball = { x: 95, y: 110, r: 7, vx: -20, vy: 0 },
+  prev = null,
+) {
+  const state = createState(1);
+  state.bricks = [brick(brickPos.x, brickPos.y)];
+  state.ballPrev = prev;
+  state.ball = { ...ball };
+  return state;
+}
+
+test('brickBounce: side hit flips vx only and pushes the ball out to the left', () => {
+  // The ball is just inside the brick's left face (penetration in x is tiny),
+  // vertically centred (penetration in y is large). This must read as a side
+  // hit: flip vx, leave vy alone, push out to the side it came from.
+  const state = stateAtBrick({ x: 100, y: 100 }, { x: 95, y: 110, r: 7, vx: 20, vy: 0 });
+  const hits = brickBounce(state);
+  assert.equal(hits.length, 1, 'one brick is hit');
+  assert.ok(state.ball.vx < 0, 'vx should flip on a side hit');
+  assert.equal(state.ball.vy, 0, 'vy must stay exactly as it was');
+  assert.equal(state.ball.x + state.ball.r, 100, 'pushed fully outside the left face');
+});
+
+test('brickBounce: top/bottom hit flips vy only and pushes the ball out', () => {
+  // The ball is just inside the brick's top face (penetration in y is tiny),
+  // horizontally centred (large x penetration). That is a top/bottom hit.
+  const state = stateAtBrick({ x: 100, y: 100 }, { x: 120, y: 96, r: 7, vx: 0, vy: 10 });
+  const hits = brickBounce(state);
+  assert.equal(hits.length, 1);
+  assert.ok(state.ball.vy < 0, 'vy should flip on a top hit');
+  assert.equal(state.ball.vx, 0, 'vx must stay exactly as it was');
+  assert.equal(state.ball.y + state.ball.r, 100, 'pushed fully outside the top face');
+});
+
+test('brickBounce: equal penetration is a corner hit and flips both axes', () => {
+  // Overlap of 2 px on both axes from the brick's top-left corner.
+  const state = stateAtBrick({ x: 100, y: 100 }, { x: 95, y: 95, r: 7, vx: 10, vy: 10 });
+  const hits = brickBounce(state);
+  assert.equal(hits.length, 1);
+  assert.ok(state.ball.vx < 0 && state.ball.vy < 0, 'both components flip on a corner hit');
+});
+
+test('brickBounce: a seam overlapping two neighbours bounces exactly once', () => {
+  // Two adjacent bricks of a row (gap 8). A 14 px ball sits in the seam and
+  // overlaps both. Flipping vx per brick would cancel out (plows through); a
+  // single resolution pass must flip it exactly once.
+  const state = createState(1);
+  state.bricks = [brick(100, 100), brick(180, 100)];
+  state.ballPrev = { x: 176, y: 110 };
+  state.ball = { x: 176, y: 110, r: 7, vx: 20, vy: 0 };
+  const hits = brickBounce(state);
+  assert.equal(hits.length, 2, 'both neighbours are hit in the same pass');
+  assert.ok(state.ball.vx < 0, 'vx is flipped exactly once (not cancelled)');
+  assert.equal(state.ball.vy, 0, 'vy untouched on a purely horizontal hit');
+});
+
+test('brickBounce: fast ball that tunnels over a brick is still caught', () => {
+  // Level 6 speed, stuttered frame: the ball jumps from above the brick to
+  // below it in one step, so neither endpoint overlaps — only the swept path
+  // crosses the brick. It must still be detected and bounced.
+  const state = stateAtBrick(
+    { x: 100, y: 100 },
+    { x: 160, y: 135, r: 7, vx: 30, vy: 710 },
+    { x: 160, y: 80 },
+  );
+  const hits = brickBounce(state);
+  assert.equal(hits.length, 1, 'swept tunnel is detected as a hit');
+  assert.ok(state.ball.vy < 0, 'vy flips so the ball bounces back down');
+});
+
+test('brickBounce: no collision leaves the ball untouched', () => {
+  const state = stateAtBrick({ x: 100, y: 100 }, { x: 300, y: 300, r: 7, vx: 40, vy: 25 });
+  const hits = brickBounce(state);
+  assert.equal(hits.length, 0);
+  assert.equal(state.ball.vx, 40);
+  assert.equal(state.ball.vy, 25);
+});
+
