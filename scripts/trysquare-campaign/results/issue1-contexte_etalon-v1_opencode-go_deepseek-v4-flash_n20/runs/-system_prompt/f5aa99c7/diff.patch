+// Which axis(es) of `brick` the ball hit, inferred from the penetration depth
+// on each side. Returns an outward normal { x, y } giving the bounce direction:
+// `x` is ±1 for a left/right (side) hit, `y` is ±1 for a top/bottom hit. On a
+// near-diagonal shot the two deepest penetrations tie, so BOTH components are
+// set — frame() flips both to make the ball glance off a corner.
+export function collisionNormal(ball, brick) {
+  // Distance each projected edge has gone past its facing side (smaller = the
+  // ball came through that face).
+  const fromLeft = Math.abs(ball.x + ball.r - brick.x);
+  const fromRight = Math.abs(ball.x - ball.r - (brick.x + brick.w));
+  const fromTop = Math.abs(ball.y + ball.r - brick.y);
+  const fromBottom = Math.abs(ball.y - ball.r - (brick.y + brick.h));
+
+  const horizontal = Math.min(fromLeft, fromRight);
+  const vertical = Math.min(fromTop, fromBottom);
+  const min = Math.min(horizontal, vertical);
+
+  let x = 0;
+  let y = 0;
+  // Keep the resolution on the axis with the deepest cut; on a diagonal tie
+  // (within FP tolerance) resolve both axes so the ball glances off a corner.
+  if (horizontal === min && Math.abs(horizontal - vertical) < 0.001) {
+    x = fromLeft <= fromRight ? LEFT : RIGHT;
+    y = fromTop <= fromBottom ? UP : DOWN;
+  } else if (horizontal === min) {
+    x = fromLeft <= fromRight ? LEFT : RIGHT;
+  } else {
+    y = fromTop <= fromBottom ? UP : DOWN;
+  }
+  return { x, y };
+}
