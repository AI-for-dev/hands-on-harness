+// Resolves the ball bouncing off every live brick it touches this frame.
+//
+// This is the fix for #1. It mutates `ball` (velocity + position) and the
+// `bricks` (marks hits dead), and returns the array of bricks that were
+// broken (so the caller can score them).
+//
+// It satisfies the whole checklist from ISSUES.md #1:
+//   * per face  — the axis with the *smaller* penetration is the face that was
+//     hit: flip `vy` on a top/bottom hit, `vx` on a side hit, leave the other
+//     component untouched;
+//   * corner    — equal penetrations mean a diagonal hit: flip both;
+//   * push out  — the ball is repositioned outside the brick rectangle so it
+//     never overlaps on the next frame and re-flips forever (sticky bounce);
+//   * neighbours— the seam between two bricks is welded into a single face hit
+//     below, so the velocity is flipped exactly once instead of once per brick
+//     (a double flip cancels out and the ball still goes through);
+//   * tunnelling— the ball's path from its previous position (`ball.px/py`) to
+//     its current one is sub-sampled, so a fast ball (level 6 = 710 px/s) can
+//     no longer jump cleanly over a 34 px brick.
+export function resolveBrickBounce(ball, bricks) {
+  const prevX = ball.px ?? ball.x;
+  const prevY = ball.py ?? ball.y;
+  const dx = ball.x - prevX;
+  const dy = ball.y - prevY;
+  const dist = Math.hypot(dx, dy);
+
+  const broken = [];
+  if (dist === 0) {
+    resolveAt(ball, bricks, broken);
+    return broken;
+  }
+
+  // Walk the swept segment in small enough steps that the ball's edge cannot
+  // teleport cleanly across a brick between two samples. Then stop at the very
+  // first contact: any deeper overlap (e.g. a seam touched by two bricks in the
+  // same pass) is resolved as a single face, so the velocity flips once.
+  const steps = Math.max(1, Math.ceil(dist / (ball.r * 0.75)));
+  for (let i = 1; i <= steps; i++) {
+    const t = i / steps;
+    ball.x = prevX + dx * t;
+    ball.y = prevY + dy * t;
+    if (resolveAt(ball, bricks, broken) > 0) break;
+  }
+  return broken;
+}
+
+// Bounces the ball off the single brick it overlaps *this pass* (the one with
+// the smallest penetration), then marks every overlapping brick as broken.
+// Returns how many bricks broke.
+function resolveAt(ball, bricks, broken) {
+  let best = null;
+  let bestPen = Infinity;
+  const hit = [];
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    if (!collides(ball, brick)) continue;
+    const overlapX = Math.min(
+      ball.x + ball.r - brick.x,
+      brick.x + brick.w - (ball.x - ball.r)
+    );
+    const overlapY = Math.min(
+      ball.y + ball.r - brick.y,
+      brick.y + brick.h - (ball.y - ball.r)
+    );
+    const pen = Math.min(overlapX, overlapY);
+    hit.push(brick);
+    if (pen < bestPen) {
+      bestPen = pen;
+      best = { brick, overlapX, overlapY };
+    }
+  }
+  if (!best) return 0;
+
+  const { brick, overlapX, overlapY } = best;
+  const cx = brick.x + brick.w / 2;
+  const cy = brick.y + brick.h / 2;
+
+  if (overlapX < overlapY) {
+    // Side hit: flip horizontal motion, push out to the nearest side.
+    ball.vx = -ball.vx;
+    ball.x = ball.x < cx ? brick.x - ball.r : brick.x + brick.w + ball.r;
+  } else if (overlapY < overlapX) {
+    // Top/bottom hit: flip vertical motion, push out above/below.
+    ball.vy = -ball.vy;
+    ball.y = ball.y < cy ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  } else {
+    // Corner: equal penetration, flip both and push out diagonally.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x = ball.x < cx ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    ball.y = ball.y < cy ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  }
+
+  let count = 0;
+  for (const b of hit) {
+    if (b.alive) {
+      b.alive = false;
+      count++;
+      broken.push(b);
+    }
+  }
+  return count;
+}
