+// A single, isolated brick we can aim a ball at. grid bricks are 72x20 with an
+// 8 px gap; a lone brick reproduces those metrics for a clean bounce test.
+function singleBrick(x = 100, y = 100) {
+  return [{ x, y, w: 72, h: 20, alive: true }];
+}
+
+// --- ISSUES.md #1: the ball must bounce off bricks, not plow through --------
+
+test('brick: top-face hit flips vy and pushes the ball out above the brick', () => {
+  const bricks = singleBrick(); // span y = 100..120
+  const ball = { x: 130, y: 96, r: 7, vx: 0, vy: 100, px: 130, py: 90 };
+
+  const broken = resolveBrickBounce(ball, bricks);
+
+  assert.equal(ball.vy, -100, 'vertical velocity should flip up');
+  assert.equal(ball.vx, 0, 'horizontal velocity untouched');
+  assert.equal(ball.y, 93, 'ball pushed clear above the brick');
+  assert.equal(broken.length, 1);
+  assert.equal(bricks[0].alive, false);
+});
+
+test('brick: side-face hit flips vx and pushes the ball out to the side', () => {
+  const bricks = singleBrick(); // brick.x = 100
+  const ball = { x: 95, y: 110, r: 7, vx: 100, vy: 0, px: 90, py: 110 };
+
+  resolveBrickBounce(ball, bricks);
+
+  assert.equal(ball.vx, -100, 'horizontal velocity should flip left');
+  assert.equal(ball.vy, 0, 'vertical velocity untouched');
+  assert.equal(ball.x, 93, 'ball pushed clear to the left of the brick');
+});
+
+test('brick: corner hit with equal penetrations flips both components', () => {
