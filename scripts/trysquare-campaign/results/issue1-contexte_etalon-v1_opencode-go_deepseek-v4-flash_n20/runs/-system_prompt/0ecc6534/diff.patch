+// A helper brick we can drop anywhere.
+function aBrick(x, y) {
+  return { x, y, w: 72, h: 20, alive: true, row: 0, points: 50 };
+}
+
+test('brick: head-on hit from above bounces the ball back up and destroys it', () => {
+  const state = createState(1);
+  state.bricks = [aBrick(300, 200)];
+  // Ball already overlapping the brick's top face, moving straight down.
+  state.ball = { x: 336, y: 194, r: 7, vx: 0, vy: 300 };
+  step(state, 1 / 120);
+  assert.ok(state.ball.vy < 0, 'vy should flip to bounce the ball upward');
+  assert.equal(state.bricks[0].alive, false, 'the hit brick should be destroyed');
+  assert.ok(state.ball.y + state.ball.r <= 200, 'ball should have been pushed out of the brick');
+});
+
+test('brick: side hit from the right flips horizontal velocity and pushes out', () => {
+  const ball = { x: 379, y: 210, r: 7, vx: -300, vy: 0 }; // touching brick's right face, moving left
+  const brick = aBrick(300, 200);
+  brickBounce(ball, brick);
+  assert.ok(ball.vx > 0, 'vx should flip and send the ball right');
+  assert.ok(ball.x - ball.r >= 372, 'ball should be pushed to the right of the brick');
+});
+
