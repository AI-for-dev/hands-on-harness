+// Pushes the ball out of the hit bricks and flips its velocity exactly once.
+// `hits` is the (non-empty) set of bricks the ball overlaps in this pass.
+// They are unified into a single bounding box so a ball crossing a seam of two
+// adjacent bricks (the 8 px gap vs a 14 px ball) produces ONE deflection, not
+// two that cancel out. The axis with the smaller penetration is the face that
+// was hit: flip `vy` on a top/bottom hit, `vx` on a side hit; equal
+// penetration (a diagonal corner) flips both. The ball is always pushed fully
+// outside, otherwise it would overlap again next frame and re-flip forever
+// (sticky bounce).
+function bounceBall(ball, hits) {
+  let minX = Infinity;
+  let minY = Infinity;
+  let maxX = -Infinity;
+  let maxY = -Infinity;
+  for (const b of hits) {
+    if (b.x < minX) minX = b.x;
+    if (b.y < minY) minY = b.y;
+    if (b.x + b.w > maxX) maxX = b.x + b.w;
+    if (b.y + b.h > maxY) maxY = b.y + b.h;
+  }
+
+  const penLeft = ball.x + ball.r - minX;
+  const penRight = maxX - (ball.x - ball.r);
+  const penTop = ball.y + ball.r - minY;
+  const penBottom = maxY - (ball.y - ball.r);
+  const dx = Math.min(penLeft, penRight);
+  const dy = Math.min(penTop, penBottom);
