+// --- Issue #1: the ball must bounce off bricks, not plow through them -----
+
+function makeBrick(x, y, w = 40, h = 20) {
+  return { x, y, w, h, row: 0, alive: true, points: 10 };
+}
+
+function makeBall(x, y, vx, vy, r = 7) {
+  return { x, y, r, vx, vy };
+}
+
+test('brickHit #1: ball hits the TOP of a brick => bounce up (flip vy)', () => {
+  const ball = makeBall(100, 85, 0, 40); // moving down, just overlapping the top
+  const brick = makeBrick(80, 90);
+  brickHit(ball, [brick]);
+  assert.equal(brick.alive, false, 'the brick is destroyed');
+  assert.equal(ball.vy, -40, 'vy flips from +40 to -40 after a top hit');
+  assert.ok(ball.y < 90, 'ball is pushed back above the brick');
+});
+
+test('brickHit #1: ball hits the LEFT side of a brick => bounce back left (flip vx)', () => {
+  const ball = makeBall(79, 100, 40, 0); // moving right into the left edge
+  const brick = makeBrick(80, 90);
+  brickHit(ball, [brick]);
+  assert.equal(brick.alive, false, 'the brick is destroyed');
+  assert.ok(ball.vx < 0, 'vx flips from +40 to negative after a left-side hit');
+  assert.ok(ball.x + ball.r <= 80, 'ball is pushed out to the left of the brick');
+});
+
+test('brickHit #1: diagonal corner hit flips BOTH components', () => {
+  const brick = makeBrick(80, 90);
