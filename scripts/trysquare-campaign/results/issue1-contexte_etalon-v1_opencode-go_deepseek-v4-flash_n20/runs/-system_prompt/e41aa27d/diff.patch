+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = maxX + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+    return;
+  }
+
+  if (dy < dx) {
+    // Top/bottom hit: flip the vertical component and push out up/down.
+    if (penTop < penBottom) {
