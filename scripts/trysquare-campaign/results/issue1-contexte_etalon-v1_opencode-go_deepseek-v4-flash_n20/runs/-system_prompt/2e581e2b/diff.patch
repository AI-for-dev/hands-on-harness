+// Resolves a single ball/brick overlap: flips the velocity on the face that
+// was actually hit and pushes the ball back outside the brick. The face with
+// the SMALLER penetration is the one the ball hit:
+//   - top/bottom hit  -> flip vy (leave vx untouched)
+//   - left/right hit  -> flip vx (leave vy untouched)
+//   - equal penetration (corner) -> flip both components
+// The push-out step is what keeps the ball from staying stuck inside the
+// brick and re-flipping forever on the next frame (sticky bounce). Because the
+// ball is pushed out in-place, a seam where the ball spans two bricks in the
+// same pass only ever bounces once (vy = -vy applied twice would cancel out).
+export function resolveBrickBounce(ball, brick) {
+  // Penetration depth of the ball into each of the four faces.
+  const pl = ball.x + ball.r - brick.x; // into the left face
+  const pr = brick.x + brick.w - (ball.x - ball.r); // into the right face
+  const pt = ball.y + ball.r - brick.y; // into the top face
+  const pb = brick.y + brick.h - (ball.y - ball.r); // into the bottom face
+
+  const overlapX = Math.min(pl, pr);
+  const overlapY = Math.min(pt, pb);
+
+  // Side hit: flip horizontal, push out along x. Which side? The face we are
+  // penetrating more is where the ball came from, so we push it back that way.
+  const dirX = pl <= pr ? -1 : 1;
+  const dirY = pt <= pb ? -1 : 1;
+
+  if (overlapX < overlapY) {
+    ball.vx = -ball.vx;
+    ball.x += dirX * overlapX;
+  } else if (overlapY < overlapX) {
+    ball.vy = -ball.vy;
+    ball.y += dirY * overlapY;
+  } else {
+    // Diagonal / corner hit: flip both and push out on both axes.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x += dirX * overlapX;
+    ball.y += dirY * overlapY;
+  }
+}
