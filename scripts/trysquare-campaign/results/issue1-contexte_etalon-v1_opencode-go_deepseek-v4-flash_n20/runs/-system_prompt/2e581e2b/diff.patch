+test('resolveBrickBounce: top hit flips vy and pushes the ball out', () => {
+  // Ball moving down onto the top face of a brick.
+  const ball = { x: 100, y: 95, r: 7, vx: 0, vy: 260 };
+  const brick = { x: 80, y: 100, w: 40, h: 20 };
+  resolveBrickBounce(ball, brick);
+  assert.equal(ball.vy, -260, 'vertical velocity should flip');
+  assert.equal(ball.vx, 0, 'horizontal velocity must stay untouched');
+  assert.ok(ball.y + ball.r <= brick.y, 'ball pushed out above the brick');
+});
+
+test('resolveBrickBounce: side hit flips vx and pushes the ball out', () => {
+  // Ball moving right onto the left face of a brick.
+  const ball = { x: 78, y: 110, r: 7, vx: 300, vy: 0 };
+  const brick = { x: 80, y: 100, w: 40, h: 20 };
+  resolveBrickBounce(ball, brick);
+  assert.equal(ball.vx, -300, 'horizontal velocity should flip');
+  assert.equal(ball.vy, 0, 'vertical velocity must stay untouched');
+  assert.ok(ball.x + ball.r <= brick.x, 'ball pushed out to the left of the brick');
+});
+
+test('resolveBrickBounce: corner hit flips both components', () => {
+  // Ball centred so the penetration into the left and top faces is equal
+  // (true diagonal hit), e.g. 17px into each.
+  const ball = { x: 90, y: 110, r: 7, vx: 300, vy: 260 };
+  const brick = { x: 80, y: 100, w: 40, h: 20 };
+  resolveBrickBounce(ball, brick);
+  assert.equal(ball.vx, -300);
+  assert.equal(ball.vy, -260, 'corner hit should flip both components');
+  assert.equal(collides(ball, brick), false, 'ball pushed out of the brick');
+});
+
+test('resolveBrickBounce: push-out prevents re-overlap (no sticky bounce)', () => {
+  // After a top hit the farthest point of the ball must sit above the brick.
+  const ball = { x: 90, y: 90, r: 7, vx: 30, vy: 200 };
+  const brick = { x: 80, y: 100, w: 40, h: 20 };
+  resolveBrickBounce(ball, brick);
+  assert.equal(collides(ball, brick), false, 'ball no longer overlaps after bounce');
+});
