+// --- brickHit (#1): per-face bounce, push-out, neighbours, tunnelling ---------
+
+test('brickHit: no overlap => nothing destroyed', () => {
+  const ball = { x: 300, y: 300, r: 7, px: 300, py: 300, vx: 0, vy: 0 };
+  const bricks = [{ x: 90, y: 90, w: 40, h: 20, alive: true }];
+  const destroyed = brickHit(ball, bricks);
+  assert.equal(destroyed.length, 0);
+  assert.equal(bricks[0].alive, true);
+});
+
+test('brickHit: bottom hit flips vy (not vx) and pushes the ball back below', () => {
+  // Ball just below the brick, moving up into its bottom edge.
+  const ball = { x: 120, y: 126, r: 7, px: 120, py: 200, vx: 0, vy: -100 };
+  const bricks = [{ x: 100, y: 100, w: 40, h: 20, alive: true }];
+
+  const destroyed = brickHit(ball, bricks);
+
+  assert.equal(destroyed.length, 1);
+  assert.equal(bricks[0].alive, false);
+  // vy flips to +; vx (unchanged) stays 0.
+  assert.ok(ball.vy > 0, 'vy should bounce away from the brick');
+  assert.equal(ball.vx, 0);
+  // Pushed out so it no longer overlaps (no sticky bounce).
+  assert.equal(collides(ball, bricks[0]), false);
+  assert.ok(ball.y > 120, 'ball pushed below the brick bottom');
+});
+
+test('brickHit: side hit flips vx (not vy) and pushes the ball back to the side', () => {
+  // Ball to the left of the brick, moving right into its left face.
+  const ball = { x: 96, y: 110, r: 7, px: 60, py: 110, vx: 100, vy: 0 };
+  const bricks = [{ x: 100, y: 100, w: 40, h: 20, alive: true }];
+
+  const destroyed = brickHit(ball, bricks);
+
+  assert.equal(destroyed.length, 1);
+  assert.equal(bricks[0].alive, false);
+  assert.ok(ball.vx < 0, 'vx should bounce back to the left');
+  assert.equal(ball.vy, 0, 'vy must be left untouched on a side hit');
+  assert.equal(collides(ball, bricks[0]), false);
+  assert.ok(ball.x < 100, 'ball pushed left of the brick');
+});
+
+test('brickHit: neighbour seam in a row bounces vy exactly once', () => {
+  // Ball straddles the seam of two bricks in the same row, coming from below.
+  // A naive per-brick double flip would cancel out and let it plow through.
+  const a = { x: 100, y: 100, w: 40, h: 20, alive: true };
+  const b = { x: 140, y: 100, w: 40, h: 20, alive: true };
+  const ball = { x: 135, y: 124, r: 7, px: 135, py: 200, vx: 0, vy: -100 };
+
+  const destroyed = brickHit(ball, [a, b]);
+
+  assert.equal(destroyed.length, 2, 'both seam neighbours should be destroyed');
+  assert.equal(a.alive, false);
