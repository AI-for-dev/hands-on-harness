+// True if the ball's swept path from (px, py) to (x, y) touches `brick`. This
+// closes the tunnelling gap: a stuttered frame at a high level moves the ball
+// further than a brick is thick (35.5 px vs 34 px at level 6), so a discrete
+// test alone would let it jump clean through. `step()` records px/py before it
+// moves the ball, so `frame()` can sweep afterwards.
+function sweepHits(ball, brick) {
+  const dx = ball.x - ball.px;
+  const dy = ball.y - ball.py;
+  const dist = Math.hypot(dx, dy);
+  if (dist === 0) return false;
+
+  // Sample the path finely enough that a brick can never slip between two
+  // consecutive samples (never more than ~4 px apart).
+  const stepLen = Math.min(4, Math.min(brick.w, brick.h) * 0.25);
+  const steps = Math.max(1, Math.ceil(dist / stepLen));
+  for (let i = 1; i <= steps; i++) {
+    const t = i / steps;
+    const sx = ball.px + dx * t;
+    const sy = ball.py + dy * t;
+    if (
+      sx + ball.r > brick.x &&
+      sx - ball.r < brick.x + brick.w &&
+      sy + ball.r > brick.y &&
