+  const contacts = [];
+  const tunnels = [];
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+    if (collides(ball, brick)) {
+      contacts.push(brick);
+    } else if (sweptHit(px, py, ball, brick)) {
+      tunnels.push(brick);
+    }
+  }
+
+  if (contacts.length === 0 && tunnels.length === 0) {
+    return [];
+  }
+
+  if (contacts.length > 0) {
+    // The shallowest contact is the face actually struck; resolve against it
+    // once and push out — that clears a shared row seam and prevents double
+    // flips on the neighbouring brick.
+    let face = contacts[0];
+    let best = Infinity;
+    for (const b of contacts) {
+      const p = penetration(ball, b);
+      const d = Math.min(p.penX, p.penY);
+      if (d < best) {
+        best = d;
+        face = b;
+      }
+    }
+    resolveBounce(ball, face);
+  } else {
+    resolveTunnel(ball, tunnels[0]);
+  }
+
+  // The ball is now moving away; collect the union of touched bricks so the
+  // caller breaks every one of them (and awards score) but never bounces twice.
+  return contacts.concat(tunnels);
+}
