+
+// The integrated brick pass: sweep + contact detection, resolve the bounce
+// EXACTLY ONCE even when a seam overlaps two bricks in the same pass (a naive
+// per-brick loop would flip vy for brick 1 then undo it on brick 2 and the
+// ball would sail through). Returns the array of bricks that were hit so the
+// caller can destroy them and award score.
+export function brickBounce(ball, bricks) {
+  const px = ball._px != null ? ball._px : ball.x;
+  const py = ball._py != null ? ball._py : ball.y;
