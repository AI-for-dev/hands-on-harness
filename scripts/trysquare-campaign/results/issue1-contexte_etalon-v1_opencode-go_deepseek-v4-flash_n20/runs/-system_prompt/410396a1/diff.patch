+// --- Issue #1: brick bounce -------------------------------------------------
+// The ball used to plow straight through bricks: frame() destroyed the hit
+// brick but never deflected the ball. These tests lock in the per-face bounce,
+// the corner case, push-out, the single-bounce seam rule and tunnelling.
+
+test('bounce: top face hit flips vy only (vx untouched)', () => {
+  const ball = { x: 110, y: 105, r: 7, vx: 30, vy: 100 };
+  const brick = { x: 90, y: 110, w: 40, h: 20 };
+  resolveBounce(ball, brick);
+  assert.equal(Math.sign(ball.vy), UP, 'vy should flip to climb back up');
+  assert.equal(ball.vx, 30, 'vx must be left exactly as it was');
+  assert.equal(ball.y, brick.y - ball.r, 'ball pushed above the brick');
+});
+
+test('bounce: side face hit flips vx only (vy untouched)', () => {
+  const ball = { x: 85, y: 100, r: 7, vx: 50, vy: -20 };
+  const brick = { x: 90, y: 90, w: 40, h: 20 };
+  resolveBounce(ball, brick);
+  assert.equal(Math.sign(ball.vx), LEFT, 'vx should flip to the left');
+  assert.equal(ball.vy, -20, 'vy must be left exactly as it was');
