+  return true;
+}
+
+// Does the ball's sweep (previous -> current position) cross the brick, even
+// though the ball is not inside it NOW? Samples the path; catches the discrete
+// tunnelling jump at high speed (issue #1).
+function sweptHit(px, py, ball, brick) {
+  const dx = ball.x - px;
+  const dy = ball.y - py;
+  const dist = Math.hypot(dx, dy);
+  const n = Math.max(1, Math.ceil(dist / ball.r));
+  for (let i = 1; i <= n; i++) {
+    const t = i / n;
+    if (
+      px + dx * t + ball.r > brick.x &&
+      px + dx * t - ball.r < brick.x + brick.w &&
+      py + dy * t + ball.r > brick.y &&
+      py + dy * t - ball.r < brick.y + brick.h
+    ) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// When the ball has tunnelled clean through a brick, bounce it back off the
