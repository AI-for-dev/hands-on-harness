+  const approachedFromRight = p - ball.r >= brick.x + brick.w;
+  const approachedFromTop = q + ball.r <= brick.y;
+  const approachedFromBottom = q - ball.r >= brick.y + brick.h;
+
+  if (approachedFromBottom) {
