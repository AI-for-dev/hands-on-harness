+// --- Issue #1: brick bounce ------------------------------------------------
+//
+// The bounce is a per-face resolution, not a blanket velocity flip:
+//   * the axis with the SMALLER penetration is the face that was hit;
+//   * flip `vy` on a top/bottom hit, `vx` on a side hit, and leave the other
+//     component exactly as it was;
+//   * equal penetrations mean a diagonal/corner hit — flip both;
+//   * push the ball back OUT of the brick, otherwise it still overlaps next
+//     frame and re-flips forever (sticky bounce).
+
+// How far the ball pokes into the brick along each axis, plus the side of each
+// entry (so we know which direction to push the ball back out).
+function penetration(ball, brick) {
+  const fromLeft = ball.x + ball.r - brick.x; // push the ball left to clear
+  const fromRight = brick.x + brick.w - (ball.x - ball.r); // push right
+  const fromTop = ball.y + ball.r - brick.y; // push up to clear
+  const fromBottom = brick.y + brick.h - (ball.y - ball.r); // push down
+  return {
+    penX: Math.min(fromLeft, fromRight),
+    penY: Math.min(fromTop, fromBottom),
+    fromLeft,
+    fromRight,
+    fromTop,
+    fromBottom,
+  };
+}
+
+// Deflect a ball that overlaps a single brick, pushing it out along the face.
+// Returns `true` (the ball has bounced) for convenience. Mutates `ball`.
+export function resolveBounce(ball, brick) {
+  const p = penetration(ball, brick);
+
+  if (p.penX < p.penY) {
+    // Side hit: flip vx, leave vy untouched.
+    if (p.fromLeft < p.fromRight) {
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+  } else if (p.penY < p.penX) {
+    // Top/bottom hit: flip vy, leave vx untouched.
+    if (p.fromTop < p.fromBottom) {
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  } else {
+    // Corner: equal penetrations mean a diagonal hit — flip both.
+    if (p.fromLeft < p.fromRight) {
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+    if (p.fromTop < p.fromBottom) {
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  }
