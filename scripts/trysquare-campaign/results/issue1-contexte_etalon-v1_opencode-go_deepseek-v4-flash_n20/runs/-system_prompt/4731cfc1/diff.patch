+// Depth with which the ball overlaps the brick, on the axis that is being hit.
+// Used to pick the single brick to bounce off when several overlap at a seam
+// (the grid gap is 8 px but the ball is 14 px across, so seams are common).
+export function penetration(ball, brick) {
+  const overLeft = ball.x + ball.r - brick.x;
+  const overRight = brick.x + brick.w - (ball.x - ball.r);
+  const overTop = ball.y + ball.r - brick.y;
+  const overBottom = brick.y + brick.h - (ball.y - ball.r);
+  return Math.min(
+    Math.min(overLeft, overRight),
+    Math.min(overTop, overBottom),
+  );
+}
+
+// Resolves a single brick collision: bounces the ball off the face whose
+// penetration is smallest (per face), and pushes the ball back OUTSIDE the
+// brick on the bounce axis so it cannot re-trigger on the next frame (sticky
+// bounce). This is what was missing: only the walls and the paddle bounced, so
+// bricks simply let the ball plow straight through them (#1).
+export function bounceOffBrick(ball, brick) {
+  const overLeft = ball.x + ball.r - brick.x;
+  const overRight = brick.x + brick.w - (ball.x - ball.r);
+  const overTop = ball.y + ball.r - brick.y;
+  const overBottom = brick.y + brick.h - (ball.y - ball.r);
+
+  const penX = Math.min(overLeft, overRight);
+  const penY = Math.min(overTop, overBottom);
+
+  if (penX < penY) {
+    // Side hit — bounce on the horizontal axis.
+    if (overLeft < overRight) {
+      ball.x = brick.x - ball.r; // push out to the left
+      ball.vx = -Math.abs(ball.vx); // now heading left
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+  } else if (penY < penX) {
+    // Top/bottom hit — bounce on the vertical axis.
+    if (overTop < overBottom) {
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  } else {
+    // Exact corner — equal penetration on both axes, flip both.
+    if (overLeft < overRight) {
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+    if (overTop < overBottom) {
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  }
+}
