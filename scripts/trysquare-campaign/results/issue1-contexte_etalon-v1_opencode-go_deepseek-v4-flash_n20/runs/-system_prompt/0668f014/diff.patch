+
+// Swept (anti-tunnelling) brick collision for the ball between its previous
+// position (prevX, prevY) and its current one. Returns `true` if at least one
+// brick was hit this pass.
+//
+// Rules implemented (see ISSUES.md #1):
+//   per face      : the face with the smallest penetration is the one hit —
+//                   flip `vy` on a top/bottom hit, `vx` on a left/right hit,
+//                   and leave the other component untouched;
+//   corner        : equal penetrations mean a diagonal hit — flip both;
+//   push out      : the ball is pushed back outside the brick rectangle so it
+//                   never sticks (a sticky overlap would re-flip every frame);
+//   neighbours    : the sweep resolves only the FIRST brick it reaches, so a
+//                   seam that overlaps two bricks bounces exactly once (a
+//                   doubled flip would cancel out and let the ball through);
+//   tunnelling    : the path is sampled so the ball cannot jump over a brick
+//                   in a single fast frame.
+//
+// Score & combo are updated here, once per brick destroyed.
+export function brickHit(state, prevX = state.ball.x, prevY = state.ball.y) {
+  const { ball, bricks } = state;
+  let hit = false;
+
+  // Coarse sweep between the two positions. Sampling every BALL_R pixels keeps
+  // a sample inside a brick region even at max speed (level 6: ~35.5 px/step
+  // against a 34 px brick and an 8 px seam), so no brick is jumped over.
+  const dist = Math.hypot(ball.x - prevX, ball.y - prevY);
+  const steps = Math.max(1, Math.ceil(dist / BALL_R));
+
+  for (let i = 1; i <= steps && !hit; i++) {
+    const t = i / steps;
+    const sx = prevX + (ball.x - prevX) * t;
+    const sy = prevY + (ball.y - prevY) * t;
+
+    for (const brick of bricks) {
+      if (!brick.alive) continue;
+      if (collides({ ...ball, x: sx, y: sy }, brick)) {
+        resolveBrickBounce(ball, brick, sx, sy);
+        brick.alive = false;
+        state.combo += 1;
+        state.score += scoreForBrick(brick, state.combo);
+        hit = true;
+        break;
+      }
+    }
+  }
+  return hit;
+}
+
+// Flips the ball out of `brick`: the face with the smallest penetration is the
+// one hit (top/bottom -> flip `vy`, left/right -> flip `vx`; equal -> flip
+// both), then pushes the ball back outside the brick.
+function resolveBrickBounce(ball, brick, sx, sy) {
+  const r = ball.r;
+  const penLeft = sx + r - brick.x;                 // crossed through the left face
+  const penRight = brick.x + brick.w - (sx - r);    // through the right face
+  const penTop = sy + r - brick.y;                  // through the top face
+  const penBottom = brick.y + brick.h - (sy - r);   // through the bottom face
+  const pens = [penLeft, penRight, penTop, penBottom];
+  const min = Math.min(...pens);
+  const eps = 1e-6;
+
+  // Faces within epsilon of the minimum were struck (one or a corner pair).
+  const faces = pens
+    .map((p, i) => ({ p, i }))
+    .filter(({ p }) => p - min <= eps)
+    .map(({ i }) => i);
+
+  for (const i of faces) {
+    if (i === 0 || i === 1) ball.vx = -ball.vx; // left/right
+    if (i === 2 || i === 3) ball.vy = -ball.vy; // top/bottom
+  }
+
+  // Push the ball back outside the brick along the dominant struck face.
+  switch (faces[0]) {
+    case 0: ball.x = brick.x - r; break;                 // out the left
+    case 1: ball.x = brick.x + brick.w + r; break;       // out the right
+    case 2: ball.y = brick.y - r; break;                 // out the top
+    default: ball.y = brick.y + brick.h + r; break;      // out the bottom
+  }
+}
