+// --- #1 — brick bounce ------------------------------------------------------
+
+function makeBrick(x, y, w = 72, h = 20) {
+  return { x, y, w, h, alive: true, points: 10, row: 0 };
+}
+
+function makeBrickState(ball, bricks) {
+  return { ball, bricks, combo: 0, score: 0 };
+}
+
+test('brickHit: ball hitting the TOP of a brick bounces back up', () => {
+  const brick = makeBrick(0, 100);
+  const ball = { x: 36, y: 105, r: 7, vx: 0, vy: 200 }; // coming from above
+  const state = makeBrickState(ball, [brick]);
+  brickHit(state, ball.x, ball.y - 30);
+  assert.ok(ball.vy < 0, 'vy should flip upward');
+  assert.equal(ball.vx, 0, 'vx must be left untouched by a top hit');
+  assert.equal(brick.alive, false);
+  assert.equal(collides(ball, brick), false, 'ball must be pushed out of the brick');
+});
+
+test('brickHit: ball hitting the LEFT side bounces left and stays clear', () => {
+  const brick = makeBrick(150, 100);
+  const ball = { x: 150, y: 110, r: 7, vx: 200, vy: 0 }; // coming from the left
+  const state = makeBrickState(ball, [brick]);
+  brickHit(state, ball.x - 25, ball.y);
+  assert.ok(ball.vx < 0, 'horizontal velocity should flip left');
+  assert.equal(ball.vy, 0, 'vy must be left untouched by a side hit');
+  assert.equal(brick.alive, false);
+  assert.ok(ball.x < brick.x, 'ball must be pushed out to the left');
+  assert.equal(collides(ball, brick), false);
+});
+
+test('brickHit: equal penetration (corner) flips BOTH axes', () => {
+  const brick = makeBrick(100, 100);
+  // Ball sits where penTop === penLeft (its bottom-left corner at the seam).
+  const ball = { x: 103, y: 103, r: 7, vx: 150, vy: 150 };
+  const state = makeBrickState(ball, [brick]);
+  brickHit(state, ball.x - 20, ball.y - 20);
+  assert.equal(ball.vx, -150, 'vx flipped by the corner hit');
+  assert.equal(ball.vy, -150, 'vy flipped by the corner hit');
+});
+
+test('brickHit: seam between two bricks bounces exactly once (no double flip)', () => {
+  const b1 = makeBrick(100, 100);
+  const b2 = makeBrick(100 + 72 + 8, 100); // 8 px gap as in the real grid
+  const ball = { x: 143, y: 105, r: 7, vx: 0, vy: 200 }; // centered on the seam
+  const state = makeBrickState(ball, [b1, b2]);
+  brickHit(state, ball.x, ball.y - 30);
+  assert.equal(Math.abs(ball.vy), 200, 'vy magnitude unchanged => flipped exactly once');
+  assert.ok(ball.vy < 0, 'the seam bounces the ball back up');
+  assert.ok(b1.alive === false || b2.alive === false, 'a brick was destroyed');
+});
+
+test('brickHit: high-speed ball is caught (no tunnelling through a brick)', () => {
+  const brick = makeBrick(100, 100); // spans y in [100, 120]
+  const ball = { x: 136, y: 140, r: 7, vx: 0, vy: 600 }; // final pos BELOW the brick
+  const state = makeBrickState(ball, [brick]);
+  // Previous position is above the brick; a naive discrete test would see
+  // overlap at neither endpoint and let the ball pass straight through.
+  brickHit(state, ball.x, 90);
+  assert.equal(brick.alive, false, 'the swept ball still hits the brick');
+  assert.ok(ball.vy < 0, 'the ball bounced back up after the sweep');
+});
+
+test('brickHit: no brick touched => no bounce, brick stays alive', () => {
+  const brick = makeBrick(300, 300);
+  const ball = { x: 30, y: 30, r: 7, vx: 50, vy: 50 };
+  const state = makeBrickState(ball, [brick]);
+  const hit = brickHit(state, ball.x - 10, ball.y - 10);
+  assert.equal(hit, false);
+  assert.equal(brick.alive, true);
+  assert.equal(ball.vx, 50);
+  assert.equal(ball.vy, 50);
+});
+
