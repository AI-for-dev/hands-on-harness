+// --- Brick bounce (issue #1) -----------------------------------------------
+
+// A state holding a single brick for precise bounce scenarios.
+function oneBrick(x = 100, y = 100) {
+  const state = createState(1);
+  state.bricks = [
+    { x, y, w: 72, h: 20, alive: true, row: 0, points: 100 },
+  ];
+  return state;
+}
+
+// Drives the ball from its previous position to the target, then resolves.
+function run(resolve, state, prev, target) {
+  const prevX = prev[0], prevY = prev[1];
+  state.ball.x = target[0];
+  state.ball.y = target[1];
+  resolve(state, prevX, prevY);
+}
+
+test('bounce: top-face hit flips vy up and breaks the brick', () => {
+  const state = oneBrick();
+  state.ball = { x: 136, y: 90, r: BALL_R, vx: 0, vy: 200 };
+  run(resolveBricks, state, [136, 90], [136, 130]);
+  assert.ok(state.ball.vy < 0, 'vy should flip upward on a top hit');
+  assert.ok(state.ball.vx === 0, 'vx must be left untouched');
+  assert.equal(state.bricks[0].alive, false);
+});
+
+test('bounce: ball is pushed out and no longer overlaps the brick', () => {
+  const state = oneBrick();
+  state.ball = { x: 136, y: 90, r: BALL_R, vx: 0, vy: 200 };
+  run(resolveBricks, state, [136, 90], [136, 130]);
+  assert.equal(collides(state.ball, state.bricks[0]), false,
+    'the pushed-out ball must not overlap the (dead) brick');
+});
+
+test('bounce: corner hit flips both components', () => {
+  const state = oneBrick();
+  state.ball = { x: 90, y: 90, r: BALL_R, vx: 300, vy: 300 };
+  run(resolveBricks, state, [90, 90], [93, 93]); // touches the top-left corner
+  assert.ok(state.ball.vx < 0 && state.ball.vy < 0,
+    'diagonal corner hit should flip both components');
+  assert.equal(state.bricks[0].alive, false);
+});
+
