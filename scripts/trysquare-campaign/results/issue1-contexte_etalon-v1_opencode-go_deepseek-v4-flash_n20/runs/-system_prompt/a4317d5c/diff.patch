+  const state = oneBrick(100);
+  state.bricks.push({ x: 180, y: 100, w: 72, h: 20, alive: true, row: 0, points: 100 });
+  state.ball = { x: 176, y: 90, r: BALL_R, vx: 0, vy: 200 };
