+// Deflects the ball off a brick it just collided with and pushes it back out.
+// Determines which face was hit by comparing how far the ball's center sits
+// past each face; bounces the dominant axis (treating a corner, equal on both
+// axes, as a two-axis slap) and nudges the center back outside the brick so the
+// next frame cannot re-trigger the same brick (sticky bounce).
+export function bounceOff(ball, brick) {
+  // Center of the brick.
+  const cx = brick.x + brick.w / 2;
+  const cy = brick.y + brick.h / 2;
+
+  // Signed overlap ratio per axis from the ball centre to the brick faces.
+  const dx = (ball.x - cx) / (brick.w / 2 + ball.r);
+  const dy = (ball.y - cy) / (brick.h / 2 + ball.r);
+
+  const ax = Math.abs(dx);
+  const ay = Math.abs(dy);
+
+  // Corner: both faces are hit about as deeply, so slap both components.
+  if (Math.abs(ax - ay) < 0.15) {
+    ball.vx = dx > 0 ? Math.abs(ball.vx) : -Math.abs(ball.vx);
+    ball.vy = dy > 0 ? Math.abs(ball.vy) : -Math.abs(ball.vy);
+    // Push out along the axis that needs the least travel; prefer the
+    // horizontal when it is the deeper one, else push vertically.
+    if (ax >= ay) {
+      ball.x = dx > 0 ? brick.x + brick.w + ball.r : brick.x - ball.r;
+    } else {
+      ball.y = dy > 0 ? brick.y + brick.h + ball.r : brick.y - ball.r;
+    }
+    return;
+  }
+
+  // Otherwise bounce the deeper axis only and leave the other component as-is.
+  if (ax > ay) {
+    ball.vx = dx > 0 ? Math.abs(ball.vx) : -Math.abs(ball.vx);
+    ball.x = dx > 0 ? brick.x + brick.w + ball.r : brick.x - ball.r;
+  } else {
+    ball.vy = dy > 0 ? Math.abs(ball.vy) : -Math.abs(ball.vy);
+    ball.y = dy > 0 ? brick.y + brick.h + ball.r : brick.y - ball.r;
+  }
+}
