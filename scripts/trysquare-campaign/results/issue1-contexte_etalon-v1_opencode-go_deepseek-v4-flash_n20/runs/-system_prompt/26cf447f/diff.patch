+// Bounce a ball off a single brick. Determines which face was hit (the axis
+// with the *smaller* penetration), flips the matching velocity component(s),
+// and pushes the ball back OUTSIDE the brick so it does not stay overlapped on
+// the next frame (which would otherwise re-flip forever = sticky bounce).
+//
+//   side hit   -> smaller penetration on X: flip vx, push out along X
+//   top/bottom -> smaller penetration on Y: flip vy, push out along Y
+//   corner     -> equal penetration: flip BOTH components
+//
+// Call this once per frame: after the push-out the ball has a single new
+// velocity — the neighbour handling in frame() (break after the first hit)
+// guarantees vy is never flipped twice in the same pass.
+function bounceOffBrick(ball, brick) {
+  // Overlap distance on each side of the brick.
+  const dxLeft = ball.x + ball.r - brick.x;
+  const dxRight = brick.x + brick.w - (ball.x - ball.r);
+  const dyTop = ball.y + ball.r - brick.y;
+  const dyBottom = brick.y + brick.h - (ball.y - ball.r);
+
+  // Penetration per axis = the smallest overlap on that axis.
+  const penX = Math.min(dxLeft, dxRight);
+  const penY = Math.min(dyTop, dyBottom);
+
+  if (penX < penY) {
+    // Side hit: flip vx, push out along X.
+    if (dxLeft < dxRight) {
+      ball.x = brick.x - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+      ball.vx = Math.abs(ball.vx);
+    }
+  } else if (penY < penX) {
+    // Top/bottom hit: flip vy, push out along Y.
+    if (dyTop < dyBottom) {
+      ball.y = brick.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+  } else {
+    // Corner hit (equal penetration): flip both components.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    if (dxLeft < dxRight) {
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+    }
+    if (dyTop < dyBottom) {
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  }
+}
+
