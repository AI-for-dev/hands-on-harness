+// --- brickHit (bounce off bricks, ISSUES.md #1) ----------------------------
+
+// Dries up the brick fixtures used by the brick-break tests.
+function brickFixture() {
+  return {
+    x: 300,
+    y: 100,
+    w: 40,
+    h: 20,
+    row: 0,
+    points: 10,
+    alive: true,
+  };
+}
+
+// Per face: hitting a brick from below (bottom face) flips vy, leaves vx alone.
+test('brickHit: bottom-face hit flips vy only (vx untouched)', () => {
+  const brick = brickFixture();
+  const ball = { x: 320, y: 120, r: 7, vx: 0, vy: -300, prevX: 320, prevY: 200 };
+  const destroyed = brickHit(ball, [brick]);
+  assert.equal(destroyed.length, 1);
+  assert.ok(ball.vy > 0, 'vy should flip to bounce downward');
+  assert.equal(ball.vx, 0, 'vx must be left exactly as it was');
+  assert.equal(brick.alive, false, 'brick is destroyed');
+});
+
+// Per face: hitting a side face flips vx, leaves vy alone.
+test('brickHit: side-face hit flips vx only (vy untouched)', () => {
+  const brick = brickFixture();
+  const ball = { x: 345, y: 110, r: 7, vx: -300, vy: 0, prevX: 400, prevY: 110 };
+  const destroyed = brickHit(ball, [brick]);
+  assert.equal(destroyed.length, 1);
+  assert.ok(ball.vx > 0, 'vx should flip to the right');
+  assert.equal(ball.vy, 0, 'vy must be left exactly as it was');
+});
+
+// Corner: a diagonal entry flips both components.
+test('brickHit: corner hit flips both vx and vy', () => {
+  const brick = brickFixture();
+  const ball = { x: 296, y: 97, r: 7, vx: 300, vy: 300, prevX: 290, prevY: 90 };
+  const destroyed = brickHit(ball, [brick]);
+  assert.equal(destroyed.length, 1);
+  assert.equal(ball.vx, -300, 'vx should flip');
+  assert.equal(ball.vy, -300, 'vy should flip');
+});
+
+// Push out: after the bounce the ball no longer overlaps the brick.
