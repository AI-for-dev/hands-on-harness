+// --- Brick collision resolution (pure, testable) ---------------------------
+
+// Circle-vs-rect overlap for the ball against a single brick.
+function circleRect(cx, cy, r, brick) {
+  return (
+    cx + r > brick.x &&
+    cx - r < brick.x + brick.w &&
+    cy + r > brick.y &&
+    cy - r < brick.y + brick.h
+  );
+}
+
+// Which face of a single brick the ball struck, judged from where it came
+// from (the position it occupied before the collision). Returns:
+//   'vertical'   -> the ball hit a top/bottom face (flip vy),
+//   'horizontal' -> the ball hit a left/right face (flip vx),
+//   'corner'     -> the ball hit a corner (flip both),
+//   null         -> the ball was already overlapping before this step.
+function entryFace(from, ball, brick) {
+  const above = from.y + ball.r <= brick.y;
+  const below = from.y - ball.r >= brick.y + brick.h;
+  const left = from.x + ball.r <= brick.x;
+  const right = from.x - ball.r >= brick.x + brick.w;
+  const vertical = above || below;
+  const horizontal = left || right;
+  if (vertical && horizontal) return 'corner';
+  if (vertical) return 'vertical';
+  if (horizontal) return 'horizontal';
+  return null;
+}
+
+// Aggregates the faces hit across a *group* of bricks. When the ball grazes a
+// seam it overlaps several bricks in the same pass; combining them here is
+// what makes the ball bounce exactly once instead of cancelling its own
+// bounce (`vy = -vy` twice would put it straight back through).
+function hitFace(from, ball, bricks) {
+  let hasVertical = false;
+  let hasHorizontal = false;
+  let hasCorner = false;
+  let allNull = true;
+  for (const brick of bricks) {
+    const face = entryFace(from, ball, brick);
+    if (face === 'corner') hasCorner = true;
+    else if (face === 'vertical') hasVertical = true;
+    else if (face === 'horizontal') hasHorizontal = true;
+    allNull = allNull && face === null;
+  }
+  if (hasCorner) return 'corner';
+  if (hasVertical && hasHorizontal) return 'corner';
+  if (hasVertical) return 'vertical';
+  if (hasHorizontal) return 'horizontal';
+  // Fallback: the ball started out overlapping (e.g. right after a relaunch).
+  return Math.abs(ball.vx) >= Math.abs(ball.vy) ? 'horizontal' : 'vertical';
+}
+
+// Repositions the ball just outside the bricks it hit, along the faces that
+// were resolved, so it cannot still overlap them on the next frame (no sticky
+// bounce). The direction follows the already-flipped velocity: the ball is
+// placed so it is moving away.
+function applyPushOut(ball, bricks, face) {
+  let minLeft = Infinity;
+  let maxRight = -Infinity;
+  let minTop = Infinity;
+  let maxBottom = -Infinity;
+  for (const brick of bricks) {
+    minLeft = Math.min(minLeft, brick.x);
+    maxRight = Math.max(maxRight, brick.x + brick.w);
+    minTop = Math.min(minTop, brick.y);
+    maxBottom = Math.max(maxBottom, brick.y + brick.h);
+  }
+  if (face === 'vertical' || face === 'corner') {
+    ball.y = ball.vy >= 0 ? maxBottom + ball.r : minTop - ball.r;
+  }
+  if (face === 'horizontal' || face === 'corner') {
+    ball.x = ball.vx >= 0 ? maxRight + ball.r : minLeft - ball.r;
+  }
+}
+
+// Resolves the ball against the bricks for one frame (the fix for #1).
+//
+//   - per face: the axis the ball came from flips (top/bottom -> vy, side
+//     -> vx), and the other component is left exactly as it was;
+//   - corner:   a diagonal entry flips both components;
+//   - push out: the ball is moved back outside the bricks it touched;
+//   - seam:     a single bounce is emitted even when the ball overlaps two
+//     bricks in the same pass;
+//   - tunnelling: the path from `prev` to the ball's current position is
+//     swept in substeps, so a fast ball cannot jump clean over a brick.
+//
+// Mutates `ball` and destroys every brick it hits. Returns the array of
+// bricks destroyed (empty if the ball hit nothing this frame).
+export function brickHit(ball, bricks, prev) {
+  const startX = prev ? prev.x : ball.prevX ?? ball.x;
+  const startY = prev ? prev.y : ball.prevY ?? ball.y;
+  const from = { x: startX, y: startY };
+  const dx = ball.x - startX;
+  const dy = ball.y - startY;
+  const dist = Math.hypot(dx, dy);
+
+  const substeps = Math.max(1, Math.ceil(dist / Math.max(ball.r * 0.5, 1)));
+  for (let i = 1; i <= substeps; i++) {
+    const t = i / substeps;
+    const probeX = startX + dx * t;
+    const probeY = startY + dy * t;
+
+    const hit = bricks.filter(
+      (brick) => brick.alive && circleRect(probeX, probeY, ball.r, brick)
+    );
+    if (hit.length === 0) continue;
+
+    const face = hitFace(from, ball, hit);
+    if (face === 'horizontal') {
+      ball.vx = -ball.vx;
+    } else if (face === 'vertical') {
+      ball.vy = -ball.vy;
+    } else {
+      ball.vx = -ball.vx;
+      ball.vy = -ball.vy;
+    }
+
+    applyPushOut(ball, hit, face);
+
+    for (const brick of hit) brick.alive = false;
+
+    // Only the first contact is resolved this frame; the ball has bounced.
+    return hit;
+  }
+  return [];
+}
