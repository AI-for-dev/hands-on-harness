+// --- Brick bounce (#1) ----------------------------------------------------
+
+const brick = { x: 100, y: 100, w: 40, h: 20, alive: true };
+
+function ballNear(x, y, vx, vy) {
+  return { x, y, r: 7, vx, vy };
+}
+
+test('bounceBall: top-face hit flips vy and pushes the ball out above', () => {
+  const b = ballNear(120, 112, 40, 260); // overlaps the top face (penetration Y small)
+  bounceBall(b, brick);
+  assert.equal(b.vy, -260, 'vy should flip on a top/bottom hit');
+  assert.equal(b.vx, 40, 'vx must be left untouched');
+  assert.ok(b.y + b.r <= brick.y, 'ball pushed out above the brick');
+});
+
+// Clone of the brick (const above is shared): bounces mutate only the ball,
+// never the brick, so reuse is fine.
+test('bounceBall: side-face hit flips vx and pushes the ball out to the side', () => {
+  const b = ballNear(106, 110, 300, 0); // overlaps the LEFT face, centered vertically
+  bounceBall(b, brick);
+  assert.equal(b.vx, -300, 'vx should flip on a side hit');
+  assert.equal(b.vy, 0, 'vy must be left untouched');
+  assert.equal(collides(b, brick), false, 'ball pushed out of the brick');
+});
+
+test('bounceBall: equal penetration is a corner — flips both components', () => {
+  const b = ballNear(106, 106, -60, -80); // equally deep in X and Y at the corner
+  bounceBall(b, brick);
+  assert.equal(b.vx, 60, 'vx should flip on a corner hit');
+  assert.equal(b.vy, 80, 'vy should flip on a corner hit');
+  assert.equal(collides(b, brick), false, 'ball pushed out of the brick');
+});
+
+test('bounceBall: never leaves the ball overlapping (push-out works)', () => {
+  const b = ballNear(120, 112, 40, 260);
+  bounceBall(b, brick);
+  assert.equal(
+    collides(b, brick),
+    false,
+    'after a bounce the ball must no longer overlap the brick (no sticky bounce)',
+  );
+});
