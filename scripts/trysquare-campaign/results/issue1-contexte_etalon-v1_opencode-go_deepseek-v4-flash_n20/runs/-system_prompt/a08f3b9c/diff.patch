+// --- Brick bounce (pure, tested) -----------------------------------------
+
+// The axis with the SMALLER penetration is the face that was hit (#1):
+//   - smaller penetration on X => side hit     => flip vx, push back horizontally
+//   - smaller penetration on Y => top / bottom => flip vy, push back vertically
+//   - equal penetrations (corner / diagonal)   => flip both components
+// The untouched component keeps its exact value, as the spec demands.
+// The ball is also pushed back out of the brick so it no longer overlaps on the
+// next frame (otherwise the flip would re-trigger forever — sticky bounce).
+export function bounceBall(ball, brick) {
+  const overlapX = Math.min(
+    ball.x + ball.r - brick.x,
+    brick.x + brick.w - (ball.x - ball.r),
+  );
+  const overlapY = Math.min(
+    ball.y + ball.r - brick.y,
+    brick.y + brick.h - (ball.y - ball.r),
+  );
+
+  if (Math.abs(overlapX - overlapY) < 0.001) {
+    // Diagonal / corner hit — flip both components.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    // Push out along the retreating axis (the deeper one).
+    if (overlapX > overlapY) {
+      if (ball.vx > 0) ball.x = brick.x + brick.w + ball.r;
+      else ball.x = brick.x - ball.r;
+    } else {
+      if (ball.vy > 0) ball.y = brick.y + brick.h + ball.r;
+      else ball.y = brick.y - ball.r;
+    }
+  } else if (overlapX < overlapY) {
+    // Side hit.
+    ball.vx = -ball.vx;
+    if (ball.vx > 0) ball.x = brick.x + brick.w + ball.r;
+    else ball.x = brick.x - ball.r;
+  } else {
+    // Top / bottom hit.
+    ball.vy = -ball.vy;
+    if (ball.vy > 0) ball.y = brick.y + brick.h + ball.r;
+    else ball.y = brick.y - ball.r;
+  }
+}
