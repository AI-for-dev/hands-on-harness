+// Resolves a brick hit: deflects the ball off the face that was struck and
+// pushes it back OUT of the brick so it cannot re-collide on the next frame
+// (a "sticky") bounce that would otherwise re-flip the velocity forever).
+//
+// Which face was hit is decided by comparing the penetration on each axis: the
+// axis with the SMALLER overlap is the one carrying the collision, because the
+// ball only barely overhung that edge. When both penetrations are equal the
+// ball came in on a diagonal, so both components flip. The component that was
+// NOT the struck face is left exactly as it was.
+//
+// The ball does not bounce more than once per pass: `frame()` calls this only
+// for the first brick it touches in a given step, so bricks sharing a seam of
+// the same pass cannot double-flip `vy` back to its original direction.
+export function bounceBall(ball, brick) {
+  const left = brick.x - ball.r;
+  const right = brick.x + brick.w + ball.r;
+  const top = brick.y - ball.r;
+  const bottom = brick.y + brick.h + ball.r;
+
+  // Penetration depth along each axis (>= 0 while overlapping).
+  const overX = Math.min(ball.x + ball.r, brick.x + brick.w) - Math.max(ball.x - ball.r, brick.x);
+  const overY = Math.min(ball.y + ball.r, brick.y + brick.h) - Math.max(ball.y - ball.r, brick.y);
+
+  if (overX < overY) {
+    // Side hit: flip horizontal velocity, push out left or right.
+    ball.vx = -ball.vx;
+    ball.x = ball.x < brick.x + brick.w / 2 ? left : right;
+  } else if (overY < overX) {
+    // Top/bottom hit: flip vertical velocity, push out up or down.
+    ball.vy = -ball.vy;
+    ball.y = ball.y < brick.y + brick.h / 2 ? top : bottom;
+  } else {
+    // Corner (diagonal hit): flip both, push out along the shorter travel.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x = ball.x < brick.x + brick.w / 2 ? left : right;
+    ball.y = ball.y < brick.y + brick.h / 2 ? top : bottom;
+  }
+}
