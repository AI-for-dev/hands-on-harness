+// --- brickHit (ISSUES.md #1) -----------------------------------------------
+// A helper that builds a single live brick at a known location and a ball
+// nudged so its leading face kisses the target face of the brick.
+function oneBrick() {
+  return { x: 100, y: 100, w: 72, h: 20, alive: true, points: 10 };
+}
+function ballAt(x, y, vx, vy, r = 7) {
+  return { x, y, r, vx, vy };
+}
+
+function topBrick() {
+  return oneBrick();
+}
+
+const r = 7;
+const topPenetration = 3; // ball overlaps the brick top face by 3px
+const sidePenetration = 2; // ball overlaps the brick left face by 2px
+
+// 1. Top-face hit: entering from above, vy must flip, vx must stay as is and
+//    the ball is pushed out above the brick.
+test('brickHit: top-face hit flips vy and pushes the ball out above', () => {
+  const brick = topBrick();
+  // Ball centre just below the brick top edge, overlapping it by 3px.
+  const ball = ballAt(120, brick.y + topPenetration, 40, 250);
+  const broken = brickHit(ball, [brick]);
+  assert.equal(broken.length, 1);
+  assert.equal(brick.alive, false, 'hit brick must be destroyed');
+  assert.equal(ball.vy, -250, 'vertical component must flip');
+  assert.equal(ball.vx, 40, 'horizontal component must stay unchanged');
+  assert.ok(ball.y + ball.r <= brick.y, 'ball pushed out above the brick');
+});
+
+// 2. Side-face hit: entering from the left, vx must flip, vy stays, and the
+//    ball is pushed out to the left of the brick.
+test('brickHit: side-face hit flips vx and pushes the ball out to the side', () => {
+  const brick = topBrick();
+  // Ball centre just inside the brick's left face, mid-height (well clear of
+  // the top/bottom faces so horizontal penetration is the smaller one).
+  const ball = ballAt(brick.x + sidePenetration, brick.y + brick.h / 2, 250, -40);
+  const broken = brickHit(ball, [brick]);
+  assert.equal(broken.length, 1);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vx, -250, 'horizontal component must flip');
+  assert.equal(ball.vy, -40, 'vertical component must stay unchanged');
+  assert.ok(ball.x + ball.r <= brick.x, 'ball pushed out to the left');
+});
+
+// 3. Bottom-face hit: entering from below, vy must flip and the ball is pushed
+//    out below the brick.
+test('brickHit: bottom-face hit flips vy and pushes the ball out below', () => {
+  const brick = topBrick();
+  // Ball centre just above the brick bottom edge.
+  const ball = ballAt(120, brick.y + brick.h - 3, 40, -250);
+  const broken = brickHit(ball, [brick]);
+  assert.equal(broken.length, 1);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vy, -(-250), 'vertical component must flip');
+  assert.ok(ball.y - ball.r >= brick.y + brick.h, 'ball pushed out below the brick');
+});
+
+// 4. Corner hit: equal penetration on both axes flips both components.
+test('brickHit: corner hit flips both components', () => {
+  const brick = topBrick();
+  // Ball centre sits exactly on the brick top-left corner.
+  const ball = ballAt(brick.x - 1, brick.y - 1, 200, 200);
+  const broken = brickHit(ball, [brick]);
+  assert.equal(broken.length, 1);
+  assert.equal(brick.alive, false);
+  assert.equal(ball.vx, -200);
+  assert.equal(ball.vy, -200);
+});
+
+// 5. Neighbours: the ball spans a seam and overlaps two bricks in the same
+//    pass. The deflection must be applied exactly once (never negated twice,
+//    which would cancel out and let the ball plow through), and the push-out
+//    has to clear the ball of the pair so it cannot stick on the next frame.
+test('brickHit: two overlapping bricks deflect the ball exactly once', () => {
+  // Two adjacent bricks sharing an x-seam at 172, top faces at y=100.
+  const left = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  const right = { x: 172, y: 100, w: 72, h: 20, alive: true };
+  // Ball descending straight onto the seam, overlapping both bricks.
+  const ball = ballAt(172, 95, 0, 250);
+  const broken = brickHit(ball, [left, right]);
+  assert.ok(broken.length >= 1, 'the seam bricks are hit');
+  // The sinking vy flips exactly once — it must NOT be negated a second time.
+  assert.equal(ball.vy, -250, 'vy must flip once, not cancel back to +250');
+  // The push-out clears the ball of the pair (no sticky re-collision).
+  assert.ok(ball.y + ball.r <= left.y, 'ball pushed clear above the bricks');
+});
+
+// 6. No overlap: the ball flies past without destroying anything or moving.
+test('brickHit: no overlap leaves bricks and velocity untouched', () => {
+  const brick = topBrick();
+  const ball = ballAt(300, 300, -100, -100);
+  const before = { x: ball.x, y: ball.y, vx: ball.vx, vy: ball.vy };
+  const broken = brickHit(ball, [brick]);
+  assert.equal(broken.length, 0);
+  assert.equal(brick.alive, true);
+  assert.deepEqual(
+    { x: ball.x, y: ball.y, vx: ball.vx, vy: ball.vy },
+    before,
+    'ball must not move or change velocity',
+  );
+});
+
