+// Deflects the ball off the face of a brick it currently overlaps.
+//
+// The axis with the *smaller* penetration is the face that was hit: flip `vy`
+// on a top/bottom hit, `vx` on a side hit, and leave the other component
+// untouched. Equal penetration on both axes means a corner hit, in which case
+// both components flip. The ball is then pushed out of the brick so it does not
+// still overlap on the next frame (a sticky double-flip that would send it
+// straight through, see ISSUES.md #1).
+function bounceBall(ball, brick) {
+  const overlapLeft = ball.x + ball.r - brick.x;
+  const overlapRight = brick.x + brick.w - (ball.x - ball.r);
+  const overlapTop = ball.y + ball.r - brick.y;
+  const overlapBottom = brick.y + brick.h - (ball.y - ball.r);
+
+  const minX = Math.min(overlapLeft, overlapRight);
+  const minY = Math.min(overlapTop, overlapBottom);
+
+  if (minX < minY) {
+    // Hit a left/right face: flip horizontal velocity, push out sideways.
+    ball.vx = -ball.vx;
+    ball.x = overlapLeft < overlapRight ? brick.x - ball.r : brick.x + brick.w + ball.r;
+  } else if (minY < minX) {
+    // Hit a top/bottom face: flip vertical velocity, push out vertically.
+    ball.vy = -ball.vy;
+    ball.y = overlapTop < overlapBottom ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  } else {
+    // Corner: flip both components and push out on both axes.
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x = overlapLeft < overlapRight ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    ball.y = overlapTop < overlapBottom ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  }
+}
+
+// Resolves collisions between the ball and every live brick.
+//
+// Returns the list of bricks that were destroyed so the caller can award
+// points/combos. The ball is deflected off the first brick it touches and
+// pushed out; any other brick the seam overlaps in the same pass is destroyed
+// without flipping the velocity again (two flips would cancel out and let the
+// ball through, see ISSUES.md #1, "neighbours").
+export function brickHit(ball, bricks) {
+  let bounced = false;
+  const broken = [];
+  for (const brick of bricks) {
+    if (!brick.alive || !collides(ball, brick)) continue;
+    brick.alive = false;
+    broken.push(brick);
+    if (!bounced) {
+      bounceBall(ball, brick);
+      bounced = true;
+    }
+  }
+  return broken;
+}
