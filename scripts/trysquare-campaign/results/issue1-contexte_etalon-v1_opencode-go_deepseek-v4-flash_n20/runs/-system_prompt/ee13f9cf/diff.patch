+// Resolves the ball against every brick it currently overlaps (fixes #1): the
+// colliding bricks are marked dead and the ball receives a single per-face
+// bounce. Returns the list of bricks that were hit.
+//
+// Face detection: the axis with the SMALLER penetration is the face that was
+// struck. A top/bottom hit flips `vy`, a side hit flips `vx`, and a corner hit
+// (equal penetrations) flips both. The other component is left exactly as it
+// was. After the flip the ball is pushed back out of the brick so it cannot
+// re-collide on the next frame (no sticky bounce).
+//
+// The velocity is deflected exactly ONCE. Because the ball (14 px wide) is
+// wider than the 8 px grid gap, it can overlap two bricks in a seam during the
+// same pass; resolving each brick independently would flip the same axis twice
+// and the flips would cancel, letting the ball sail back through. We therefore
+// collect every overlapping brick (against the ball's ORIGINAL position) and
+// bounce only off the first one as the representative.
+export function brickHit(ball, bricks) {
+  // Collect every brick overlapping the ball before any repositioning.
+  const hit = [];
+  for (const brick of bricks) {
+    if (brick.alive && collides(ball, brick)) {
+      brick.alive = false;
+      hit.push(brick);
+    }
+  }
+  if (hit.length === 0) return hit;
+
+  const brick = hit[0];
+
+  // Overlap past each face of the brick.
+  const overlapLeft = ball.x + ball.r - brick.x;
+  const overlapRight = brick.x + brick.w - (ball.x - ball.r);
+  const overlapTop = ball.y + ball.r - brick.y;
+  const overlapBottom = brick.y + brick.h - (ball.y - ball.r);
+
+  const minX = Math.min(overlapLeft, overlapRight);
+  const minY = Math.min(overlapTop, overlapBottom);
+
+  const fromLeft = overlapLeft <= overlapRight;
+  const fromTop = overlapTop <= overlapBottom;
+
+  if (minX < minY) {
+    // Side hit: flip vx only, push the ball out to the side.
+    if (fromLeft) {
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+    }
+    ball.vx = fromLeft ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+  } else if (minY < minX) {
+    // Top/bottom hit: flip vy only, push the ball out above/below.
+    if (fromTop) {
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+    }
+    ball.vy = fromTop ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+  } else {
+    // Corner hit: equal penetrations -> flip both axes, push out both ways.
+    if (fromLeft) {
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+    }
+    ball.vx = fromLeft ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+
+    if (fromTop) {
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+    }
+    ball.vy = fromTop ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+  }
+
+  return hit;
+}
