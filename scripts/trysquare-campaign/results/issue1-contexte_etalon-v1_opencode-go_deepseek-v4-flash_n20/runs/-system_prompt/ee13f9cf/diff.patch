+test('brickHit: head-on from below flips vy and pushes the ball out', () => {
+  const brick = { x: 100, y: 100, w: 40, h: 20, alive: true };
+  // Ball moving UP (vy < 0) into the brick's bottom face.
+  const ball = { x: 120, y: 123, r: 7, vx: 0, vy: -300 };
+  const hit = brickHit(ball, [brick]);
+  assert.equal(hit.length, 1);
+  assert.equal(brick.alive, false);
+  assert.ok(ball.vy > 0, 'vy should flip from UP to DOWN');
+  assert.equal(ball.vx, 0, 'vx is untouched by a top/bottom hit');
+  // Pushed back below the brick: no sticky overlap.
+  assert.equal(ball.y, brick.y + brick.h + ball.r);
+  assert.equal(collides(ball, brick), false);
+});
+
+test('brickHit: side hit flips vx and leaves vy alone', () => {
+  const brick = { x: 100, y: 100, w: 40, h: 20, alive: true };
+  // Ball moving LEFT (vx < 0) into the brick's right face.
+  const ball = { x: 146, y: 110, r: 7, vx: -300, vy: 40 };
+  const hit = brickHit(ball, [brick]);
+  assert.equal(hit.length, 1);
+  assert.ok(ball.vx > 0, 'vx should flip from LEFT to RIGHT');
+  assert.equal(ball.vy, 40, 'vy is untouched by a side hit');
+  assert.equal(ball.x, brick.x + brick.w + ball.r);
+  assert.equal(collides(ball, brick), false);
+});
+
+test('brickHit: corner hit (equal penetrations) flips both axes', () => {
+  const brick = { x: 100, y: 100, w: 40, h: 20, alive: true };
+  // Ball arriving at the bottom-right corner: equal X and Y penetration.
+  const ball = { x: 145, y: 125, r: 7, vx: -300, vy: -300 };
+  const hit = brickHit(ball, [brick]);
+  assert.equal(hit.length, 1);
+  assert.ok(ball.vx > 0, 'corner: vx should flip');
+  assert.ok(ball.vy > 0, 'corner: vy should flip');
+});
+
+test('brickHit: a seam over two bricks still bounces exactly once', () => {
+  const a = { x: 100, y: 100, w: 40, h: 20, alive: true };
+  const b = { x: 148, y: 100, w: 40, h: 20, alive: true };
+  // Ball spans the 8px gap (14px wide) and enters the row's bottom face.
+  const ball = { x: 144, y: 126, r: 7, vx: 0, vy: -300 };
+  const hit = brickHit(ball, [a, b]);
+  assert.equal(hit.length, 2, 'both seam bricks are struck in one pass');
+  assert.equal(a.alive, false);
+  assert.equal(b.alive, false);
+  // Single deflection: vy flips once to DOWN; vx must NOT have been flipped
+  // twice (which would cancel and let the ball sail through).
+  assert.ok(ball.vy > 0, 'vy should bounce DOWN exactly once');
+  assert.equal(ball.vx, 0, 'vx unchanged for the head-on bottom entry');
+});
