diff --git a/game/neon.js b/game/neon.js
index 6b4a133..59d4f2a 100644
--- a/game/neon.js
+++ b/game/neon.js
@@ -223,11 +223,32 @@ export function frame(ctx, state) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      // Calculate which side was hit to deflect the ball
+      const ballMidX = state.ball.x;
+      const ballMidY = state.ball.y;
+      const brickMidX = brick.x + brick.w / 2;
+      const brickMidY = brick.y + brick.h / 2;
+
+      const dx = ballMidX - brickMidX;
+      const dy = ballMidY - brickMidY;
+
+      const contactX = Math.abs(dx);
+      const contactY = Math.abs(dy);
+
+      // Use the relative overlap to decide the bounce direction
+      // Since it's a rectangle, we compare the distance to the edges
+      if (contactX > contactY) {
+        // Hit left or right side
+        state.ball.vx = -state.ball.vx;
+        // Push ball out of brick to prevent sticking
+        state.ball.x += (dx > 0 ? 1 : -1) * (brick.w / 2 + state.ball.r - contactX);
+      } else {
+        // Hit top or bottom side
+        state.ball.vy = -state.ball.vy;
+        // Push ball out of brick to prevent sticking
+        state.ball.y += (dy > 0 ? 1 : -1) * (brick.h / 2 + state.ball.r - contactY);
+      }
     }

     ctx.fillStyle = brickColor(brick.row);
