+// Resolves ball-brick collisions using a sweep-test to prevent tunnelling.
+// Handles per-face and corner bounces and pushes the ball out to avoid sticking.
+export function resolveBrickCollisions(state, dt) {
+  const { ball, bricks } = state;
+  const prevX = ball.x - ball.vx * dt;
+  const prevY = ball.y - ball.vy * dt;
+
+  let firstCollision = null;
+  let minT = 1.1;
+
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+
+    const eb = { x: brick.x - ball.r, y: brick.y - ball.r, w: brick.w + 2 * ball.r, h: brick.h + 2 * ball.r };
+    const dx = ball.vx * dt;
+    const dy = ball.vy * dt;
+
+    let txMin = dx === 0 ? (prevX >= eb.x && prevX <= eb.x + eb.w ? -Infinity : Infinity) : (eb.x - prevX) / dx;
+    let txMax = dx === 0 ? (prevX >= eb.x && prevX <= eb.x + eb.w ? Infinity : -Infinity) : (eb.x + eb.w - prevX) / dx;
+    if (txMin > txMax) [txMin, txMax] = [txMax, txMin];
+
+    let tyMin = dy === 0 ? (prevY >= eb.y && prevY <= eb.y + eb.h ? -Infinity : Infinity) : (eb.y - prevY) / dy;
+    let tyMax = dy === 0 ? (prevY >= eb.y && prevY <= eb.y + eb.h ? Infinity : -Infinity) : (eb.y + eb.h - prevY) / dy;
+    if (tyMin > tyMax) [tyMin, tyMax] = [tyMax, tyMin];
+
+    const tEnter = Math.max(txMin, tyMin);
+    const tExit = Math.min(txMax, tyMax);
+
+    if (tEnter < tExit && txMax >= 0 && txMin <= 1 && tyMax >= 0 && tyMin <= 1) {
+      const t = Math.max(0, tEnter);
+      if (t < minT) {
+        minT = t;
+        let normal = { x: 0, y: 0 };
+        if (Math.abs(txMin - tyMin) < 0.0001) {
+          normal = { x: dx > 0 ? -1 : 1, y: dy > 0 ? -1 : 1 };
+        } else if (txMin > tyMin) {
+          normal = { x: dx > 0 ? -1 : 1, y: 0 };
+        } else {
+          normal = { x: 0, y: dy > 0 ? -1 : 1 };
+        }
+        firstCollision = { brick, t, normal };
+      }
+    }
+  }
+
+  if (firstCollision) {
+    const { brick, t, normal } = firstCollision;
+    
+    let finalNormal = normal;
+    if (t === 0) {
+      const overlapX = Math.min(ball.x + ball.r - brick.x, brick.x + brick.w - (ball.x - ball.r));
+      const overlapY = Math.min(ball.y + ball.r - brick.y, brick.y + brick.h - (ball.y - ball.r));
+      
+      if (overlapX < overlapY) {
+        finalNormal = { x: ball.x < brick.x + brick.w / 2 ? -1 : 1, y: 0 };
+      } else if (overlapY < overlapX) {
+        finalNormal = { x: 0, y: ball.y < brick.y + brick.h / 2 ? -1 : 1 };
+      } else {
+        finalNormal = { x: ball.x < brick.x + brick.w / 2 ? -1 : 1, y: ball.y < brick.y + brick.h / 2 ? -1 : 1 };
+      }
+    }
+
+    ball.x = prevX + (ball.vx * dt) * t + finalNormal.x * 0.1;
+    ball.y = prevY + (ball.vy * dt) * t + finalNormal.y * 0.1;
+    if (finalNormal.x !== 0) ball.vx *= -1;
+    if (finalNormal.y !== 0) ball.vy *= -1;
+    brick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(brick, state.combo);
+  }
+}
