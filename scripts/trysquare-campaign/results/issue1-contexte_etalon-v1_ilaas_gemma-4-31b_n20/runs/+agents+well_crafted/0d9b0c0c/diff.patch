+  state.ball = { x: 125, y: 120 + BALL_R + 1, r: BALL_R, vx: 0, vy: -100 };
+  step(state, 0.02);
+  assert.ok(state.ball.vy > 0, 'should bounce down');
+  assert.ok(state.ball.y >= 120 + BALL_R, 'should be pushed out');
+});
+
