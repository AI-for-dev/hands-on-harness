+// --- Brick Collision Tests (#1) ---
+
+test('step: bounce off brick top face', () => {
+  const state = createState(1);
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true };
+  state.bricks = [brick];
+  // Ball moving down, hitting the top of the brick
+  state.ball = { x: 125, y: 100 - BALL_R - 1, r: BALL_R, vx: 0, vy: 100 };
+  step(state, 0.02); // should move it into the brick
+  assert.ok(state.ball.vy < 0, 'should bounce up');
+  assert.ok(state.ball.y <= 100 - BALL_R, 'should be pushed out');
+});
+
+test('step: bounce off brick bottom face', () => {
+  const state = createState(1);
