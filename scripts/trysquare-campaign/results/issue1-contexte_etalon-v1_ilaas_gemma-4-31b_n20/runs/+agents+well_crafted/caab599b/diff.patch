+test('resolveBrickCollision: top hit flips vy and pushes up', () => {
+  const ball = { x: 100, y: 95, r: 7, vx: 0, vy: 100 };
+  const brick = { x: 80, y: 100, w: 40, h: 20 };
+  // Ball bottom is 102, brick top is 100. Overlap = 2.
+  // Ball is mostly above the brick, so it should be a top hit.
+  const hit = resolveBrickCollision(ball, brick);
+  assert.equal(hit, true);
+  assert.equal(ball.vy, -100);
+  assert.equal(ball.y, 100 - 7);
+});
