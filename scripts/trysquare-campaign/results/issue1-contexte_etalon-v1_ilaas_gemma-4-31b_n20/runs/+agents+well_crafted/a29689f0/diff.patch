+// Resolves the collision between the ball and a brick, updating the ball's
+// position and velocity to handle the bounce and push-out.
+// Returns true if a collision occurred.
+export function resolveBrickCollision(ball, brick, prevX, prevY) {
+  const { x, y, r, vx, vy } = ball;
+  const { x: bx, y: by, w: bw, h: bh } = brick;
+
+  let isOverlap = collides(ball, brick);
+  let hit = isOverlap;
+  if (!isOverlap) {
+    const withinX = x >= bx - r && x <= bx + bw + r && prevX >= bx - r && prevX <= bx + bw + r;
+    const crossedY = (prevY - r <= by && y + r >= by) || (prevY + r >= by + bh && y - r <= by + bh);
+    const withinY = y >= by - r && y <= by + bh + r && prevY >= by - r && prevY <= by + bh + r;
+    const crossedX = (prevX - r <= bx && x + r >= bx) || (prevX + r >= bx + bw && x - r <= bx + bw);
+    if ((withinX && crossedY) || (withinY && crossedX)) hit = true;
+  }
+
+  if (!hit) return false;
+
+  let isLeft = false, isRight = false, isTop = false, isBottom = false;
+  if (isOverlap) {
+    const distLeft = (x + r) - bx;
+    const distRight = (bx + bw) - (x - r);
+    const distTop = (y + r) - by;
+    const distBottom = (by + bh) - (y - r);
+    const minDist = Math.min(distLeft, distRight, distTop, distBottom);
+    isLeft = (minDist === distLeft);
+    isRight = (minDist === distRight);
+    isTop = (minDist === distTop);
+    isBottom = (minDist === distBottom);
+  } else {
+    if (prevY - r <= by && y + r >= by) isTop = true;
+    else if (prevY + r >= by + bh && y - r <= by + bh) isBottom = true;
+    else if (prevX - r <= bx && x + r >= bx) isLeft = true;
+    else if (prevX + r >= bx + bw && x - r <= bx + bw) isRight = true;
+  }
+
+  const hitX = isLeft || isRight;
+  const hitY = isTop || isBottom;
+
+  if (hitX && hitY) {
+    if (vx > 0 && isLeft) ball.vx = -vx; else if (vx < 0 && isRight) ball.vx = -vx;
+    if (vy > 0 && isTop) ball.vy = -vy; else if (vy < 0 && isBottom) ball.vy = -vy;
+    if (isLeft) ball.x = bx - r; else if (isRight) ball.x = bx + bw + r;
+    if (isTop) ball.y = by - r; else if (isBottom) ball.y = by + bh + r;
+  } else if (hitX) {
+    if (isLeft && vx > 0) { ball.vx = -vx; ball.x = bx - r; }
+    else if (isRight && vx < 0) { ball.vx = -vx; ball.x = bx + bw + r; }
+  } else if (hitY) {
+    if (isTop && vy > 0) { ball.vy = -vy; ball.y = by - r; }
+    else if (isBottom && vy < 0) { ball.vy = -vy; ball.y = by + bh + r; }
+  }
+
+  return true;
+}
