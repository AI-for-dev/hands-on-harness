+// --- Collision resolution ------------------------------------------------
+
+// Resolves collisions between the ball and all alive bricks.
+// Updates ball velocity, position, and brick status.
+export function resolveBricks(state) {
+  const { ball } = state;
+  let collision = null;
+  let minOverlap = Infinity;
+
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+
+    // Tunnelling detection: check if the ball's movement path overlaps the brick.
+    if (!collides(ball, brick)) {
+      const minX = Math.min(ball.prevX - ball.r, ball.x - ball.r);
+      const maxX = Math.max(ball.prevX + ball.r, ball.x + ball.r);
+      const minY = Math.min(ball.prevY - ball.r, ball.y - ball.r);
+      const maxY = Math.max(ball.prevY + ball.r, ball.y + ball.r);
+
+      if (maxX > brick.x && minX < brick.x + brick.w && maxY > brick.y && minY < brick.y + brick.h) {
+        // Tunnelled! Resolve as a simple bounce based on velocity direction.
+        brick.alive = false;
+        state.combo += 1;
+        state.score += scoreForBrick(brick, state.combo);
+        if (Math.abs(ball.vx) > Math.abs(ball.vy) * (brick.w / brick.h)) {
+          ball.vx = ball.vx > 0 ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+          ball.x = ball.vx > 0 ? brick.x - ball.r : brick.x + brick.w + ball.r;
+        } else {
+          ball.vy = ball.vy > 0 ? Math.abs(ball.vy) : -Math.abs(ball.vy);
+          ball.y = ball.vy > 0 ? brick.y - ball.r : brick.y + brick.h + ball.r;
+        }
+        return; // Resolve one tunnel per frame to avoid double-bounce
+      }
+      continue;
+    }
+
+    // Standard AABB collision: find the face with the smallest penetration.
+    const overlapX = Math.min(ball.x + ball.r - brick.x, brick.x + brick.w - (ball.x - ball.r));
+    const overlapY = Math.min(ball.y + ball.r - brick.y, brick.y + brick.h - (ball.y - ball.r));
+    const overlap = Math.min(overlapX, overlapY);
+
+    if (overlap < minOverlap) {
+      minOverlap = overlap;
+      collision = { brick, overlapX, overlapY };
+    }
+  }
+
+  if (collision) {
+    const { brick, overlapX, overlapY } = collision;
+    brick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(brick, state.combo);
+
+    if (overlapX === overlapY) {
+      // Corner hit: flip both and push out diagonally.
+      ball.vx = ball.vx > 0 ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+      ball.vy = ball.vy > 0 ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+      ball.x = ball.vx > 0 ? brick.x - ball.r : brick.x + brick.w + ball.r;
+      ball.y = ball.vy > 0 ? brick.y - ball.r : brick.y + brick.h + ball.r;
+    } else if (overlapX < overlapY) {
+      // Side hit: flip vx and push out.
+      if (ball.vx > 0) {
+        ball.vx = -Math.abs(ball.vx);
+        ball.x = brick.x - ball.r;
+      } else {
+        ball.vx = Math.abs(ball.vx);
+        ball.x = brick.x + brick.w + ball.r;
+      }
+    } else {
+      // Top/Bottom hit: flip vy and push out.
+      if (ball.vy > 0) {
+        ball.vy = -Math.abs(ball.vy);
+        ball.y = brick.y - ball.r;
+      } else {
+        ball.vy = Math.abs(ball.vy);
+        ball.y = brick.y + brick.h + ball.r;
+      }
+    }
+  }
+}

