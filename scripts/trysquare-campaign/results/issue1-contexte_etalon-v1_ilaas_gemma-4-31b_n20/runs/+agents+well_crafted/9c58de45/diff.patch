+test('resolveBricks: bounce off top face', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 80, r: 7, vx: 0, vy: -100 }; // Moving UP
+  state.bricks = [{ x: 80, y: 70, w: 40, h: 20, alive: true }];
+  resolveBricks(state);
+  assert.ok(state.ball.vy > 0, 'vy should be flipped to DOWN');
+});
+
+test('resolveBricks: bounce off bottom face', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 110, r: 7, vx: 0, vy: 100 }; // Moving DOWN
+  state.bricks = [{ x: 80, y: 90, w: 40, h: 20, alive: true }];
+  resolveBricks(state);
+  assert.ok(state.ball.vy < 0, 'vy should be flipped to UP');
+});
+
+test('resolveBricks: bounce off left face', () => {
+  const state = createState(1);
+  state.ball = { x: 75, y: 100, r: 7, vx: 100, vy: 0 }; // overlapping by 2px
+  state.bricks = [{ x: 80, y: 90, w: 40, h: 20, alive: true }];
+  resolveBricks(state);
+  assert.ok(state.ball.vx < 0, 'vx should be flipped to LEFT');
+});
+
+test('resolveBricks: bounce off right face', () => {
+  const state = createState(1);
+  state.ball = { x: 125, y: 100, r: 7, vx: -100, vy: 0 }; // overlapping by 2px
+  state.bricks = [{ x: 80, y: 90, w: 40, h: 20, alive: true }];
+  resolveBricks(state);
+  assert.ok(state.ball.vx > 0, 'vx should be flipped to RIGHT');
+});
+
+test('resolveBricks: corner hit flips both', () => {
+  const state = createState(1);
+  state.ball = { x: 75, y: 75, r: 7, vx: 100, vy: -100 }; // overlapping corner
+  state.bricks = [{ x: 80, y: 80, w: 40, h: 20, alive: true }];
+  resolveBricks(state);
+  assert.ok(state.ball.vx < 0 && state.ball.vy > 0, 'both vx and vy should flip');
+});
+
+test('resolveBricks: push-out prevents sticking', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 75, r: 7, vx: 0, vy: -100 };
+  state.bricks = [{ x: 80, y: 70, w: 40, h: 20, alive: true }];
+  resolveBricks(state);
+  assert.ok(state.ball.y - state.ball.r >= 90 || state.ball.y + state.ball.r <= 70, 'ball should be outside brick');
+});
+
+test('resolveBricks: tunnelling prevention', () => {
+  const state = createState(1);
+  // Ball speed is so high it would skip the brick in one step
+  state.ball = { x: 100, y: 60, r: 7, vx: 0, vy: -1000 };
