+// Resolves a collision between the ball and a brick.
+// Flips the velocity based on the face hit and pushes the ball out of the brick.
+export function resolveBrickCollision(ball, brick) {
+  const distLeft = (ball.x + ball.r) - brick.x;
+  const distRight = (brick.x + brick.w) - (ball.x - ball.r);
+  const distTop = (ball.y + ball.r) - brick.y;
+  const distBottom = (brick.y + brick.h) - (ball.y - ball.r);
+
+  if (distLeft < 0 || distRight < 0 || distTop < 0 || distBottom < 0) return false;
+
+  const minX = Math.min(distLeft, distRight);
+  const minY = Math.min(distTop, distBottom);
+
+  if (minX < minY) {
+    ball.vx = -ball.vx;
+    if (distLeft < distRight) ball.x = brick.x - ball.r; else ball.x = brick.x + brick.w + ball.r;
+  } else if (minY < minX) {
+    ball.vy = -ball.vy;
+    if (distTop < distBottom) ball.y = brick.y - ball.r; else ball.y = brick.y + brick.h + ball.r;
+  } else {
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    if (distLeft < distRight) ball.x = brick.x - ball.r; else ball.x = brick.x + brick.w + ball.r;
+    if (distTop < distBottom) ball.y = brick.y - ball.r; else ball.y = brick.y + brick.h + ball.r;
+  }
+  return true;
+}
+
+// Returns the earliest time of impact [0, 1] between the ball moving from
+// (x1, y1) to (x2, y2) and the brick.
+function getSweepCollisionPoint(ball, brick, x1, y1, x2, y2) {
+  const bMinX = brick.x - ball.r;
+  const bMaxX = brick.x + brick.w + ball.r;
+  const bMinY = brick.y - ball.r;
+  const bMaxY = brick.y + brick.h + ball.r;
+
+  const dx = x2 - x1;
+  const dy = y2 - y1;
+
+  let tMin = -Infinity;
+  let tMax = Infinity;
+
+  if (Math.abs(dx) < 1e-6) {
+    if (x1 < bMinX || x1 > bMaxX) return null;
+  } else {
+    const tx1 = (bMinX - x1) / dx;
+    const tx2 = (bMaxX - x1) / dx;
+    tMin = Math.max(tMin, Math.min(tx1, tx2));
+    tMax = Math.min(tMax, Math.max(tx1, tx2));
+  }
+
+  if (Math.abs(dy) < 1e-6) {
+    if (y1 < bMinY || y1 > bMaxY) return null;
+  } else {
+    const ty1 = (bMinY - y1) / dy;
+    const ty2 = (bMaxY - y1) / dy;
+    tMin = Math.max(tMin, Math.min(ty1, ty2));
+    tMax = Math.min(tMax, Math.max(ty1, ty2));
+  }
+
+  if (tMax >= tMin && tMax >= 0 && tMin <= 1) {
+    const t = Math.max(0, tMin);
+    if (t === 0) {
+      // Ball is overlapping. Only resolve if moving towards the brick.
+      // Moving towards if:
+      // - (ball is to the left AND vx > 0) OR (ball is to the right AND vx < 0)
+      // - (ball is above AND vy > 0) OR (ball is below AND vy < 0)
+      const movingX = (x1 < brick.x + brick.w / 2) ? dx > 0 : dx < 0;
+      const movingY = (y1 < brick.y + brick.h / 2) ? dy > 0 : dy < 0;
+      
+      // This is a simplification. A better check:
+      // If we are moving away from the brick on all axes, ignore.
+      // Since we are overlapping, we are "moving towards" if the velocity
+      // points into the expanded AABB.
+      if (!movingX && !movingY) return null;
+    }
+    return t;
+  }
+  return null;
+}
