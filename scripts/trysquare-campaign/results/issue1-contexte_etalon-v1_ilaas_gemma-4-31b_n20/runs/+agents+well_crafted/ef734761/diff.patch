diff --git a/game/neon.test.js b/game/neon.test.js
index 250d6a9..9f4b37b 100644
--- a/game/neon.test.js
+++ b/game/neon.test.js
@@ -67,3 +67,83 @@ function belowField() {
 
 // TODO (#5): test comboMultiplier / scoreForBrick.
 // TODO      : test level progression and loadBest/saveBest persistence.
+
+import { resolveBrickCollision } from './neon.js';
+
+test('resolveBrickCollision: flip vx on side hit (left)', () => {
+  const ball = { x: 85, y: 100, r: 8, vx: 100, vy: 0 };
+  const brick = { x: 90, y: 90, w: 40, h: 20 };
+  resolveBrickCollision(ball, brick);
+  assert.equal(ball.vx, -100);
+  assert.equal(ball.vy, 0);
+});
+
+test('resolveBrickCollision: push out avoids sticky bounce', () => {
+  const ball = { x: 85, y: 100, r: 8, vx: 100, vy: 0 };
+  const brick = { x: 90, y: 90, w: 40, h: 20 };
+  resolveBrickCollision(ball, brick);
+  assert.equal(ball.x, 90 - 8);
+});
+
+test('resolveBrickCollision: flip vx on side hit (right)', () => {
+  const ball = { x: 135, y: 100, r: 8, vx: -100, vy: 0 };
+  const brick = { x: 90, y: 90, w: 40, h: 20 };
+  resolveBrickCollision(ball, brick);
+  assert.equal(ball.vx, 100);
+  assert.equal(ball.x, 130 + 8);
+});
+
+test('resolveBrickCollision: flip vy on top hit', () => {
+  const ball = { x: 110, y: 85, r: 8, vx: 0, vy: 100 };
+  const brick = { x: 90, y: 90, w: 40, h: 20 };
+  resolveBrickCollision(ball, brick);
+  assert.equal(ball.vy, -100);
+  assert.equal(ball.y, 90 - 8);
+});
+
+test('resolveBrickCollision: flip vy on bottom hit', () => {
+  const ball = { x: 110, y: 115, r: 8, vx: 0, vy: -100 };
+  const brick = { x: 90, y: 90, w: 40, h: 20 };
+  resolveBrickCollision(ball, brick);
+  assert.equal(ball.vy, 100);
+  assert.equal(ball.y, 110 + 8);
+});
+
+test('resolveBrickCollision: flip both on corner hit', () => {
+  const ball = { x: 85, y: 85, r: 8, vx: 100, vy: 100 };
+  const brick = { x: 90, y: 90, w: 40, h: 20 };
+  resolveBrickCollision(ball, brick);
+  assert.equal(ball.vx, -100);
+  assert.equal(ball.vy, -100);
+});
+
+test('step: prevents tunneling through brick', () => {
+  const state = createState(1);
+  // Ball moving very fast, would jump over a 20px brick in one step
+  state.ball = { x: 110, y: 80, r: 8, vx: 0, vy: 1000 };
+  const brick = { x: 90, y: 90, w: 40, h: 20, alive: true };
+  state.bricks = [brick];
+  
+  // dt = 0.05s => move = 50px. Brick is at y=90, height 20.
+  // Ball start: y=80. Ball end: y=130.
+  // It should hit the brick.
+  step(state, 0.05);
+  
+  assert.equal(brick.alive, false, 'Brick should be destroyed');
+  assert.ok(state.ball.vy < 0, 'Ball should have bounced back');
+});
+
+test('step: handles neighboring bricks correctly', () => {
+  const state = createState(1);
+  // Ball hitting the seam between two bricks
+  state.ball = { x: 100, y: 80, r: 8, vx: 0, vy: 100 };
+  const brick1 = { x: 80, y: 90, w: 20, h: 20, alive: true };
+  const brick2 = { x: 100, y: 90, w: 20, h: 20, alive: true };
+  state.bricks = [brick1, brick2];
+  
+  step(state, 0.01);
+  
+  // It should hit at least one brick and bounce.
+  // If it hits both and flips vy twice, it will continue downward.
+  assert.ok(state.ball.vy < 0, 'Ball should bounce once, not twice');
+});
