+test('step: ball bounces off top of brick', () => {
+  const state = createState(1);
+  // Ball moving DOWN, about to hit the top of a brick
+  state.ball = { x: 110, y: 70, r: 7, vx: 0, vy: 200 };
+  const brick = state.bricks[0]; // Top-left brick
+  brick.x = 90; brick.y = 80; brick.w = 40; brick.h = 20;
+
+  step(state, 1 / 60);
+
+  assert.ok(state.ball.vy < 0, 'Ball should bounce UP after hitting the top of a brick');
+  assert.equal(brick.alive, false, 'Brick should be destroyed');
+});
+
+test('step: ball bounces off bottom of brick', () => {
+  const state = createState(1);
+  // Ball moving UP, about to hit the bottom of a brick
+  state.ball = { x: 110, y: 110, r: 7, vx: 0, vy: -200 };
+  const brick = state.bricks[0];
+  brick.x = 90; brick.y = 80; brick.w = 40; brick.h = 20;
+
+  step(state, 1 / 60);
+
+  assert.ok(state.ball.vy > 0, 'Ball should bounce DOWN after hitting the bottom of a brick');
+  assert.equal(brick.alive, false, 'Brick should be destroyed');
+});
+
