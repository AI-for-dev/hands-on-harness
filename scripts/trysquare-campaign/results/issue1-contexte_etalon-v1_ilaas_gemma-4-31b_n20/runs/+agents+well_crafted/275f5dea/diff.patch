+// Finds the time t in [0, 1] when the ball first hits the brick during its movement.
+function getCollisionTime(ball, brick, oldX, oldY, dt) {
+  const vx = ball.vx * dt;
+  const vy = ball.vy * dt;
+
+  const b_min_x = oldX - ball.r;
+  const b_max_x = oldX + ball.r;
+  const b_min_y = oldY - ball.r;
+  const b_max_y = oldY + ball.r;
+
+  let t_near_x = -Infinity;
+  let t_far_x = Infinity;
+  if (vx !== 0) {
+    t_near_x = (brick.x - b_max_x) / vx;
+    t_far_x = (brick.x + brick.w - b_min_x) / vx;
+    if (t_near_x > t_far_x) [t_near_x, t_far_x] = [t_far_x, t_near_x];
+  } else if (b_max_x < brick.x || b_min_x > brick.x + brick.w) {
+    return null;
+  }
+
+  let t_near_y = -Infinity;
+  let t_far_y = Infinity;
+  if (vy !== 0) {
+    t_near_y = (brick.y - b_max_y) / vy;
+    t_far_y = (brick.y + brick.h - b_min_y) / vy;
+    if (t_near_y > t_far_y) [t_near_y, t_far_y] = [t_far_y, t_near_y];
+  } else if (b_max_y < brick.y || b_min_y > brick.y + brick.h) {
+    return null;
+  }
+
+  const t_entry = Math.max(t_near_x, t_near_y);
+  const t_exit = Math.min(t_far_x, t_far_y);
+
+  if (t_entry > t_exit || t_exit < 0 || t_entry > 1) return null;
+  return t_entry < 0 ? 0 : t_entry;
+}
+
+// Resolves the collision by flipping velocity and pushing the ball out of the brick.
+function resolveBrickCollision(ball, brick) {
+  const dx1 = (ball.x + ball.r) - brick.x;
+  const dx2 = (brick.x + brick.w) - (ball.x - ball.r);
+  const dy1 = (ball.y + ball.r) - brick.y;
+  const dy2 = (brick.y + brick.h) - (ball.y - ball.r);
+
+  if (dx1 < 0 || dx2 < 0 || dy1 < 0 || dy2 < 0) return false;
+
+  const overlapX = Math.min(dx1, dx2);
+  const overlapY = Math.min(dy1, dy2);
+
+  if (overlapX < overlapY) {
+    if (dx1 < dx2) {
+      ball.vx = -Math.abs(ball.vx); // Bounce LEFT
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.vx = Math.abs(ball.vx); // Bounce RIGHT
+      ball.x = brick.x + brick.w + ball.r;
+    }
+  } else if (overlapY < overlapX) {
+    if (dy1 < dy2) {
+      ball.vy = -Math.abs(ball.vy); // Bounce UP
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.vy = Math.abs(ball.vy); // Bounce DOWN
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  } else {
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    if (dx1 < dy1) {
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.y = brick.y - ball.r;
+    }
+  }
+  return true;
+}
+
+// Handles all brick collisions for the current frame.
+export function handleBrickCollisions(state, dt) {
+  const { ball } = state;
+  const oldX = ball.x - ball.vx * dt;
+  const oldY = ball.y - ball.vy * dt;
+
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+
+    const t = getCollisionTime(ball, brick, oldX, oldY, dt);
+    if (t !== null) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+      resolveBrickCollision(ball, brick);
+      break;
+    }
+  }
+}
