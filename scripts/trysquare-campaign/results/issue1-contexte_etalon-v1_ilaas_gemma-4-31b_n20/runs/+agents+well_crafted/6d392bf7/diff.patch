-    ball: { x: WIDTH / 2, y: PADDLE_Y - BALL_R - 2, r: BALL_R, vx: speed * 0.5, vy: -speed },
+    ball: { x: WIDTH / 2, y: PADDLE_Y - BALL_R - 2, r: BALL_R, vx: speed * 0.5, vy: -speed, prevX: WIDTH / 2, prevY: PADDLE_Y - BALL_R - 2 },
     bricks: makeBricks(level),
   };
 }
@@ -165,6 +165,9 @@ export function saveBest(storage, score) {
 export function step(state, dt) {
   const { ball, paddle } = state;

+  ball.prevX = ball.x;
+  ball.prevY = ball.y;
+
   ball.x += ball.vx * dt;
   ball.y += ball.vy * dt;

@@ -216,18 +219,64 @@ export function frame(ctx, state) {
   ctx.fillRect(0, 0, WIDTH, HEIGHT);

   // Bricks: collision + bounce + score + drawing, all in one place.
+  const { ball } = state;
+  let bouncedX = false;
+  let bouncedY = false;
+
   for (const brick of state.bricks) {
     if (!brick.alive) continue;

-    if (collides(state.ball, brick)) {
+    let hit = collides(ball, brick);
+    if (!hit && ball.prevX !== undefined) {
+      const minX = Math.min(ball.prevX, ball.x) - ball.r;
+      const maxX = Math.max(ball.prevX, ball.x) + ball.r;
+      const minY = Math.min(ball.prevY, ball.y) - ball.r;
+      const maxY = Math.max(ball.prevY, ball.y) + ball.r;
+      if (maxX > brick.x && minX < brick.x + brick.w && maxY > brick.y && minY < brick.y + brick.h) {
+        hit = true;
+      }
+    }
+
+    if (hit) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      const dxL = (ball.x + ball.r) - brick.x;
+      const dxR = (brick.x + brick.w) - (ball.x - ball.r);
+      const dyT = (ball.y + ball.r) - brick.y;
+      const dyB = (brick.y + brick.h) - (ball.y - ball.r);
+
+      const minXPen = Math.min(dxL, dxR);
+      const minYPen = Math.min(dyT, dyB);
+
+      if (minXPen < minYPen) {
+        // Side hit
+        if (!bouncedX) {
+          ball.vx = (dxL < dxR) ? Math.abs(ball.vx) : -Math.abs(ball.vx);
+          ball.x = (dxL < dxR) ? brick.x - ball.r : brick.x + brick.w + ball.r;
+          bouncedX = true;
+        }
+      } else if (minYPen < minXPen) {
+        // Top/Bottom hit
+        if (!bouncedY) {
+          ball.vy = (dyT < dyB) ? Math.abs(ball.vy) : -Math.abs(ball.vy);
+          ball.y = (dyT < dyB) ? brick.y - ball.r : brick.y + brick.h + ball.r;
+          bouncedY = true;
+        }
+      } else {
+        // Corner hit: flip both
+        if (!bouncedX) {
+          ball.vx = (dxL < dxR) ? Math.abs(ball.vx) : -Math.abs(ball.vx);
+          ball.x = (dxL < dxR) ? brick.x - ball.r : brick.x + brick.w + ball.r;
+          bouncedX = true;
+        }
+        if (!bouncedY) {
+          ball.vy = (dyT < dyB) ? Math.abs(ball.vy) : -Math.abs(ball.vy);
+          ball.y = (dyT < dyB) ? brick.y - ball.r : brick.y + brick.h + ball.r;
+          bouncedY = true;
+        }
+      }
     }

     ctx.fillStyle = brickColor(brick.row);
diff --git a/game/neon.test.js b/game/neon.test.js
index 250d6a9..963f459 100644
--- a/game/neon.test.js
+++ b/game/neon.test.js
@@ -18,8 +18,20 @@ import {
   BRICK_ROWS,
   BRICK_COLS,
   WIDTH,
+  frame,
 } from './neon.js';

+function mockCtx() {
+  return {
+    fillStyle: '',
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+  };
+}
+
 test('collides: clear overlap detected', () => {
   const ball = { x: 100, y: 100, r: 8 };
   const brick = { x: 90, y: 90, w: 40, h: 20 };
@@ -67,3 +79,65 @@ function belowField() {

 // TODO (#5): test comboMultiplier / scoreForBrick.
 // TODO      : test level progression and loadBest/saveBest persistence.
+
+test('brick collision: ball bounces off top', () => {
+  const state = createState(1);
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true, points: 10 };
+  state.bricks = [brick];
+  state.ball = { x: 125, y: 100 - 5, r: 7, vx: 0, vy: -100 };
+  frame(mockCtx(), state);
+  assert.equal(brick.alive, false);
+  assert.equal(state.ball.vy, 100, 'vy should be flipped to DOWN');
+  assert.equal(state.ball.y, 100 - 7, 'ball should be pushed out to top');
+});
+
+test('brick collision: ball bounces off side', () => {
+  const state = createState(1);
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true, points: 10 };
+  state.bricks = [brick];
+  state.ball = { x: 100 - 5, y: 110, r: 7, vx: -100, vy: 0 };
+  frame(mockCtx(), state);
+  assert.equal(brick.alive, false);
+  assert.equal(state.ball.vx, 100, 'vx should be flipped to RIGHT');
+  assert.equal(state.ball.x, 100 - 7, 'ball should be pushed out to left');
+});
+
+test('brick collision: ball bounces off corner', () => {
+  const state = createState(1);
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true, points: 10 };
+  state.bricks = [brick];
+  // Corner hit: equal penetration on x and y
+  // Ball at (100-5, 100-5) with r=7.
+  // x-penetration: (100-5)+7 - 100 = 2
+  // y-penetration: (100-5)+7 - 100 = 2
+  state.ball = { x: 95, y: 95, r: 7, vx: 100, vy: 100 };
+  frame(mockCtx(), state);
+  assert.equal(brick.alive, false);
+  assert.equal(state.ball.vx, -100, 'vx should flip');
+  assert.equal(state.ball.vy, -100, 'vy should flip');
+});
+
+test('brick collision: tunnelling is detected', () => {
+  const state = createState(1);
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true, points: 10 };
+  state.bricks = [brick];
+  // Ball is moving very fast and jumps over the brick in one frame
+  // Previous position was above the brick, current is below
+  state.ball = { x: 125, y: 150, r: 7, vx: 0, vy: 500 };
+  state.ball.prevX = 125;
+  state.ball.prevY = 50;
+  frame(mockCtx(), state);
+  assert.equal(brick.alive, false, 'brick should be destroyed even if ball jumped over it');
+});
+
+test('brick collision: no double bounce on neighbours', () => {
+  const state = createState(1);
+  const b1 = { x: 100, y: 100, w: 50, h: 20, alive: true, points: 10 };
+  const b2 = { x: 158, y: 100, w: 50, h: 20, alive: true, points: 10 }; // Gap = 8, 100+50+8 = 158
+  state.bricks = [b1, b2];
+  // Ball is at the seam between b1 and b2
+  state.ball = { x: 154, y: 110, r: 7, vx: 100, vy: 0 };
+  frame(mockCtx(), state);
+  // If we flip vx twice, it will be 100 again. If we flip once, it will be -100.
+  assert.equal(state.ball.vx, -100, 'vx should flip only once');
+});
