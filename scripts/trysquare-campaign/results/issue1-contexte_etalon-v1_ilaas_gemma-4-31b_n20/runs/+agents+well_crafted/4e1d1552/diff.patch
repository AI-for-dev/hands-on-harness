+// --- Collision resolution -------------------------------------------------
+
+// Resolves collisions between the ball and bricks.
+// Implements per-face bounce, corner bounce, push-out, and basic tunnelling
+// prevention via a simple sweep approximation.
+export function resolveBrickCollisions(state) {
+  const { ball, bricks } = state;
+  let hasBounced = false;
+
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+
+    const minX = Math.min(ball.prevX, ball.x) - ball.r;
+    const maxX = Math.max(ball.prevX, ball.x) + ball.r;
+    const minY = Math.min(ball.prevY, ball.y) - ball.r;
+    const maxY = Math.max(ball.prevY, ball.y) + ball.r;
+
+    if (maxX < brick.x || minX > brick.x + brick.w || maxY < brick.y || minY > brick.y + brick.h) {
+      continue;
+    }
+
+    const isColliding = collides(ball, brick);
+    const crossedX = Math.max(minX, brick.x) <= Math.min(maxX, brick.x + brick.w);
+    const crossedY = Math.max(minY, brick.y) <= Math.min(maxY, brick.y + brick.h);
+
+    if (isColliding || (crossedX && crossedY)) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+
+      let px, py;
+      if (isColliding) {
+        const dx1 = ball.x + ball.r - brick.x;
+        const dx2 = brick.x + brick.w - (ball.x - ball.r);
+        const dy1 = ball.y + ball.r - brick.y;
+        const dy2 = brick.y + brick.h - (ball.y - ball.r);
+        px = Math.min(dx1, dx2);
+        py = Math.min(dy1, dy2);
+      } else {
+        px = Math.abs(ball.vx) < Math.abs(ball.vy) ? 100 : 0;
+        py = Math.abs(ball.vx) < Math.abs(ball.vy) ? 0 : 100;
+      }
+
+      if (px < py) {
+        if (!hasBounced) ball.vx *= -1;
+        ball.x = (ball.vx < 0) ? brick.x + brick.w + ball.r : brick.x - ball.r;
+      } else if (py < px) {
+        if (!hasBounced) ball.vy *= -1;
+        ball.y = (ball.vy < 0) ? brick.y + brick.h + ball.r : brick.y - ball.r;
+      } else {
+        if (!hasBounced) {
+          ball.vx *= -1;
+          ball.vy *= -1;
+        }
+        ball.x = (ball.vx < 0) ? brick.x + brick.w + ball.r : brick.x - ball.r;
+        ball.y = (ball.vy < 0) ? brick.y + brick.h + ball.r : brick.y - ball.r;
+      }
+      hasBounced = true;
+    }
+  }
+}
