+// Simple AABB bounce resolution: flips velocity and pushes ball out of the brick.
+function resolveBrickCollision(ball, brick) {
+  const dx = (ball.x + ball.r) - brick.x;
+  const dw = (brick.x + brick.w) - (ball.x - ball.r);
+  const dy = (ball.y + ball.r) - brick.y;
+  const dh = (brick.y + brick.h) - (ball.y - ball.r);
+
+  const minX = Math.min(dx, dw);
+  const minY = Math.min(dy, dh);
+
+  if (minX < minY) {
+    if (dx < dw) {
+      ball.vx = -Math.abs(ball.vx); // Hit left face -> bounce LEFT
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.vx = Math.abs(ball.vx); // Hit right face -> bounce RIGHT
+      ball.x = brick.x + brick.w + ball.r;
+    }
+  } else if (minX > minY) {
+    if (dy < dh) {
+      ball.vy = -Math.abs(ball.vy); // Hit top face -> bounce UP
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.vy = Math.abs(ball.vy); // Hit bottom face -> bounce DOWN
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  } else {
+    ball.vx *= -1;
+    ball.vy *= -1;
+    if (dx < dw) ball.x = brick.x - ball.r; else ball.x = brick.x + brick.w + ball.r;
+    if (dy < dh) ball.y = brick.y - ball.r; else ball.y = brick.y + brick.h + ball.r;
+  }
+}
