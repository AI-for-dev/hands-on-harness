+  const minY = brick.y - ball.r;
+  const maxY = brick.y + brick.h + ball.r;
+
+  if (ball.prevX < minX && ball.x < minX) return false;
+  if (ball.prevX > maxX && ball.x > maxX) return false;
+  if (ball.prevY < minY && ball.y < minY) return false;
+  if (ball.prevY > maxY && ball.y > maxY) return false;
