+test('step: bounce off the top of a brick', () => {
+  const state = createState(1);
+  // Place ball just above a brick, moving down
+  const brick = state.bricks[0]; // Top-left brick
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y - brick.h / 2, r: 7, vx: 0, vy: 200 };
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy < 0, 'ball should bounce UP after hitting the top of a brick');
+});
+
+test('step: bounce off the bottom of a brick', () => {
+  const state = createState(1);
+  // Place ball just below a brick, moving up
+  const brick = state.bricks[0];
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y + brick.h + 5, r: 7, vx: 0, vy: -200 };
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy > 0, 'ball should bounce DOWN after hitting the bottom of a brick');
+});
+
+test('step: bounce off the left side of a brick', () => {
+  const state = createState(1);
+  // Place ball to the left of a brick, moving right
+  const brick = state.bricks[0];
+  state.ball = { x: brick.x + 5, y: brick.y + brick.h / 2, r: 7, vx: 200, vy: 0 };
+  // We want the ball to be at the left edge. Let's put it slightly inside.
+  state.ball.x = brick.x - 2;
+  step(state, 1 / 60);
+  assert.ok(state.ball.vx < 0, 'ball should bounce LEFT after hitting the left side of a brick');
+});
+
+test('step: bounce off the right side of a brick', () => {
+  const state = createState(1);
+  // Place ball to the right of a brick, moving left
+  const brick = state.bricks[0];
+  state.ball = { x: brick.x + brick.w + 5, y: brick.y + brick.h / 2, r: 7, vx: -200, vy: 0 };
+  state.ball.x = brick.x + brick.w + 2;
+  step(state, 1 / 60);
+  assert.ok(state.ball.vx > 0, 'ball should bounce RIGHT after hitting the right side of a brick');
+});
+
+test('step: bounce off a corner (diagonal)', () => {
+  const state = createState(1);
+  // Hit the top-left corner of a brick
+  const brick = state.bricks[0];
+  state.ball = { x: brick.x + 2, y: brick.y + 2, r: 7, vx: -200, vy: -200 };
+  step(state, 1 / 60);
+  assert.ok(state.ball.vx > 0 && state.ball.vy > 0, 'ball should bounce both ways when hitting a corner');
+});
+
+test('step: no sticky bounce (push out)', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  // Ball is deeply embedded in the brick
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y + 2, r: 7, vx: 0, vy: 200 };
+  step(state, 1 / 60);
+  // It should have bounced and been moved outside the brick
+  assert.ok(state.ball.y < brick.y || state.ball.y > brick.y + brick.h + 2 * state.ball.r, 'ball should be pushed out of the brick');
+});
+
+test('step: tunnelling prevention (high speed)', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  // Ball is moving so fast it would jump over the brick in one step
+  // Ball size 14, Brick height 20. Total 34.
+  // Speed 1000 px/s, dt 0.05s => 50px movement.
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y - 10, r: 7, vx: 0, vy: 1000 };
+  step(state, 0.05);
+  assert.ok(state.ball.vy < 0, 'ball should have collided with the brick even at high speed');
+});
