+function resolveBricks(state, prevX, prevY) {
+  const { ball, bricks } = state;
+  let hasBounced = false;
+
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+
+    const isColliding = collides(ball, brick);
+    const tunneled = (
+      (ball.x + ball.r > brick.x && ball.x - ball.r < brick.x + brick.w) &&
+      ((prevY + ball.r < brick.y && ball.y - ball.r > brick.y + brick.h) ||
+       (prevY - ball.r > brick.y + brick.h && ball.y + ball.r < brick.y))
+    ) || (
+      (ball.y + ball.r > brick.y && ball.y - ball.r < brick.y + brick.h) &&
+      ((prevX + ball.r < brick.x && ball.x - ball.r > brick.x + brick.w) ||
+       (prevX - ball.r > brick.x + brick.w && ball.x + ball.r < brick.x))
+    );
+
+    if (isColliding || tunneled) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+
+      if (!hasBounced) {
+        if (tunneled && !isColliding) {
+          // Simple tunneling bounce: flip the primary axis of movement
+          if (Math.abs(ball.vx) > Math.abs(ball.vy)) {
+            ball.vx = -Math.sign(ball.vx) * Math.abs(ball.vx);
+          } else {
+            ball.vy = -Math.sign(ball.vy) * Math.abs(ball.vy);
+          }
+        } else {
+          // Per-face bounce
+          const overlapX = Math.min(
+            (ball.x + ball.r) - brick.x,
+            (brick.x + brick.w) - (ball.x - ball.r)
+          );
+          const overlapY = Math.min(
+            (ball.y + ball.r) - brick.y,
+            (brick.y + brick.h) - (ball.y - ball.r)
+          );
+
+          if (overlapX < overlapY) {
+            ball.vx = -Math.sign(ball.vx) * Math.abs(ball.vx);
+            ball.x = ball.x < brick.x + brick.w / 2 ? brick.x - ball.r : brick.x + brick.w + ball.r;
+          } else if (overlapY < overlapX) {
+            ball.vy = -Math.sign(ball.vy) * Math.abs(ball.vy);
+            ball.y = ball.y < brick.y + brick.h / 2 ? brick.y - ball.r : brick.y + brick.h + ball.r;
+          } else {
+            ball.vx = -Math.sign(ball.vx) * Math.abs(ball.vx);
+            ball.vy = -Math.sign(ball.vy) * Math.abs(ball.vy);
+          }
+        }
+        hasBounced = true;
+      }
+    }
+  }
+}
