+test('resolveBrickCollisions: horizontal hit flips vx', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 100, r: 7, vx: 300, vy: 0 };
+  state.bricks = [{ x: 110, y: 80, w: 72, h: 20, alive: true, points: 10 }];
+  resolveBrickCollisions(state, 1/60);
+  assert.ok(state.ball.vx < 0, 'vx should flip to negative');
+});
+
+test('resolveBrickCollisions: vertical hit flips vy', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 100, r: 7, vx: 0, vy: -300 };
+  state.bricks = [{ x: 80, y: 110, w: 72, h: 20, alive: true, points: 10 }];
+  resolveBrickCollisions(state, 1/60);
+  assert.ok(state.ball.vy > 0, 'vy should flip to positive');
+});
+
+test('resolveBrickCollisions: corner hit flips both', () => {
+  const state = createState(1);
+  // tEntryX = (100 - 95) / 300 = 5/300
+  // tEntryY = (120 - 125) / -300 = 5/300
+  state.ball = { x: 100, y: 120, r: 7, vx: 300, vy: -300 };
+  state.bricks = [{ x: 107, y: 93, w: 72, h: 20, alive: true, points: 10 }];
+  resolveBrickCollisions(state, 1/60);
+  assert.ok(state.ball.vx < 0 && state.ball.vy > 0, 'both vx and vy should flip');
+});
+
+test('resolveBrickCollisions: push-out prevents sticky bounce', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 100, r: 7, vx: 300, vy: 0 };
+  state.bricks = [{ x: 105, y: 80, w: 72, h: 20, alive: true, points: 10 }];
+  resolveBrickCollisions(state, 1/60);
+  assert.ok(state.ball.x <= 98, 'ball should be pushed out of the brick');
+});
+
+test('resolveBrickCollisions: tunnelling detected (sweep)', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 80, r: 7, vx: 0, vy: -700 };
+  state.bricks = [{ x: 80, y: 60, w: 100, h: 20, alive: true, points: 10 }];
+  resolveBrickCollisions(state, 0.05);
+  assert.ok(state.ball.vy > 0, 'vy should flip even if ball tunneled');
