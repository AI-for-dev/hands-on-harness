-// --- Score & combo (NOT covered by tests — debt #5) ------------------------
+// --- Brick Collision Resolution ------------------------------------------
+
+// Handles brick collisions, including per-face bounce, push-out, and tunnelling.
+// This was extracted from frame() to resolve BUG #1 and facilitate testing.
+export function resolveBrickCollisions(state, dt) {
+  const { ball } = state;
+  const prevX = ball.x - ball.vx * dt;
+  const prevY = ball.y - ball.vy * dt;
+
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+
+    const minX = brick.x - ball.r;
+    const maxX = brick.x + brick.w + ball.r;
+    const minY = brick.y - ball.r;
+    const maxY = brick.y + brick.h + ball.r;
+
+    let tEntryX, tExitX;
+    if (ball.vx !== 0) {
+      tEntryX = ball.vx > 0 ? (minX - prevX) / ball.vx : (maxX - prevX) / ball.vx;
+      tExitX = ball.vx > 0 ? (maxX - prevX) / ball.vx : (minX - prevX) / ball.vx;
+    } else if (prevX < minX || prevX > maxX) {
+      continue;
+    } else {
+      tEntryX = -Infinity;
+      tExitX = Infinity;
+    }
+
+    let tEntryY, tExitY;
+    if (ball.vy !== 0) {
+      tEntryY = ball.vy > 0 ? (minY - prevY) / ball.vy : (maxY - prevY) / ball.vy;
+      tExitY = ball.vy > 0 ? (maxY - prevY) / ball.vy : (minY - prevY) / ball.vy;
+    } else if (prevY < minY || prevY > maxY) {
+      continue;
+    } else {
+      tEntryY = -Infinity;
+      tExitY = Infinity;
+    }
+
+    const tMin = Math.max(0, Math.max(tEntryX, tEntryY));
+    const tMax = Math.min(1, Math.min(tExitX, tExitY));
+
+    if (tMin <= tMax) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+
+      const epsilon = 1e-7;
+      if (Math.abs(tEntryX - tEntryY) < epsilon) {
+        ball.vx = -ball.vx;
+        ball.vy = -ball.vy;
+        ball.x = (ball.vx > 0) ? maxX : minX;
+        ball.y = (ball.vy > 0) ? maxY : minY;
+      } else if (tEntryX > tEntryY) {
+        ball.vx = -ball.vx;
+        ball.x = (ball.vx > 0) ? maxX : minX;
+      } else {
+        ball.vy = -ball.vy;
+        ball.y = (ball.vy > 0) ? maxY : minY;
+      }
+    }
+  }
+}
 
