diff --git a/game/neon.js b/game/neon.js
index 6b4a133..3e0e390 100644
--- a/game/neon.js
+++ b/game/neon.js
@@ -223,11 +223,29 @@ export function frame(ctx, state) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      // Deflect the ball based on the hit face.
+      // We calculate the intersection depths on each axis to find the smallest overlap.
+      const overlapX = Math.min(
+        (state.ball.x + state.ball.r) - brick.x, // right edge of ball vs left edge of brick
+        (brick.x + brick.w) - (state.ball.x - state.ball.r) // right edge of brick vs left edge of ball
+      );
+      const overlapY = Math.min(
+        (state.ball.y + state.ball.r) - brick.y, // bottom edge of ball vs top edge of brick
+        (brick.y + brick.h) - (state.ball.y - state.ball.r) // bottom edge of brick vs top edge of ball
+      );
+
+      if (overlapX < overlapY) {
+        // Side hit: reverse horizontal velocity
+        state.ball.vx *= -1;
+        // Push ball out of the brick to prevent sticking
+        state.ball.x += (state.ball.vx > 0 ? overlapX : -overlapX);
+      } else {
+        // Top/Bottom hit: reverse vertical velocity
+        state.ball.vy *= -1;
+        // Push ball out of the brick to prevent sticking
+        state.ball.y += (state.ball.vy > 0 ? overlapY : -overlapY);
+      }
     }

     ctx.fillStyle = brickColor(brick.row);
