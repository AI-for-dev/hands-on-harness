diff --git a/game/neon.js b/game/neon.js
index 6b4a133..faf4388 100644
--- a/game/neon.js
+++ b/game/neon.js
@@ -223,11 +223,34 @@ export function frame(ctx, state) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      // Calculate intersection to determine which face was hit
+      const ball = state.ball;
+      const bLeft = brick.x;
+      const bRight = brick.x + brick.w;
+      const bTop = brick.y;
+      const bBottom = brick.y + brick.h;
+
+      const overlapLeft = (ball.x + ball.r) - bLeft;
+      const overlapRight = bRight - (ball.x - ball.r);
+      const overlapTop = (ball.y + ball.r) - bTop;
+      const overlapBottom = bBottom - (ball.y - ball.r);
+
+      const minOverlap = Math.min(overlapLeft, overlapRight, overlapTop, overlapBottom);
+
+      if (minOverlap === overlapTop) {
+        ball.y = bTop - ball.r;
+        ball.vy = Math.abs(ball.vy); // Bounce DOWN
+      } else if (minOverlap === overlapBottom) {
+        ball.y = bBottom + ball.r;
+        ball.vy = -Math.abs(ball.vy); // Bounce UP
+      } else if (minOverlap === overlapLeft) {
+        ball.x = bLeft - ball.r;
+        ball.vx = Math.abs(ball.vx); // Bounce RIGHT
+      } else {
+        ball.x = bRight + ball.r;
+        ball.vx = -Math.abs(ball.vx); // Bounce LEFT
+      }
     }
 
     ctx.fillStyle = brickColor(brick.row);
