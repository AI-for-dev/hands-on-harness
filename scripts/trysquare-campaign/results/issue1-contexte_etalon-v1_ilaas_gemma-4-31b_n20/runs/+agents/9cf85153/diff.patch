@@ -223,11 +223,31 @@ export function frame(ctx, state) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      // Bounce logic: determine which side was hit
+      const ball = state.ball;
+      const bX = ball.x - brick.x;
+      const bY = ball.y - brick.y;
+      const bW = brick.w;
+      const bH = brick.h;
+
+      // Find the distance to each edge
+      const distLeft = ball.x - (brick.x + ball.r);
+      const distRight = (brick.x + brick.w) - (ball.x + ball.r);
+      const distTop = ball.y - (brick.y + ball.r);
+      const distBottom = (brick.y + brick.h) - (ball.y + ball.r);
+
+      const minDist = Math.min(Math.abs(distLeft), Math.abs(distRight), Math.abs(distTop), Math.abs(distBottom));
+
+      if (minDist === Math.abs(distLeft) || minDist === Math.abs(distRight)) {
+        ball.vx = -ball.vx;
+        if (minDist === Math.abs(distLeft)) ball.x = brick.x - ball.r;
+        else ball.x = brick.x + brick.w + ball.r;
+      } else {
+        ball.vy = -ball.vy;
+        if (minDist === Math.abs(distTop)) ball.y = brick.y - ball.r;
+        else ball.y = brick.y + brick.h + ball.r;
+      }
     }

     ctx.fillStyle = brickColor(brick.row);
