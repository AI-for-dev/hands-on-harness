diff --git a/game/neon.js b/game/neon.js
index 6b4a133..a0a784c 100644
--- a/game/neon.js
+++ b/game/neon.js
@@ -223,11 +223,26 @@ export function frame(ctx, state) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      const ballLeft = state.ball.x - state.ball.r;
+      const ballRight = state.ball.x + state.ball.r;
+      const ballTop = state.ball.y - state.ball.r;
+      const ballBottom = state.ball.y + state.ball.r;
+      const brickLeft = brick.x;
+      const brickRight = brick.x + brick.w;
+      const brickTop = brick.y;
+      const brickBottom = brick.y + brick.h;
+
+      const overlapX = Math.min(ballRight, brickRight) - Math.max(ballLeft, brickLeft);
+      const overlapY = Math.min(ballBottom, brickBottom) - Math.max(ballTop, brickTop);
+
+      if (overlapX < overlapY) {
+        state.ball.vx = -state.ball.vx;
+        state.ball.x = state.ball.x < brick.x + brick.w / 2 ? brickLeft - state.ball.r : brickRight + state.ball.r;
+      } else {
+        state.ball.vy = -state.ball.vy;
+        state.ball.y = state.ball.y < brick.y + brick.h / 2 ? brickTop - state.ball.r : brickBottom + state.ball.r;
+      }
     }

     ctx.fillStyle = brickColor(brick.row);
