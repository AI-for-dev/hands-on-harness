+test('step: bounce off brick top', () => {
+  const state = createState(1);
+  state.bricks = [{ x: 100, y: 100, w: 50, h: 20, alive: true }];
+  state.ball = { x: 125, y: 90, r: 7, vx: 0, vy: 300 }; // Moving down
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy < 0, 'vertical velocity should flip to UP');
+  assert.equal(state.bricks[0].alive, false, 'brick should be destroyed');
+});
