   BRICK_ROWS,
   BRICK_COLS,
   WIDTH,
@@ -65,5 +66,50 @@ function belowField() {
   return 500;
 }

-// TODO (#5): test comboMultiplier / scoreForBrick.
-// TODO      : test level progression and loadBest/saveBest persistence.
+test('frame: ball bounces off the top of a brick', () => {
+  const state = createState(1);
+  state.bricks = []; // Clear other bricks
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true, row: 0 };
+  state.bricks.push(brick);
+  // Ball is moving DOWN and hitting the top of the brick
+  state.ball = { x: 125, y: 95, r: 7, vx: 0, vy: 200 };
+
+  const ctx = {
+    fillStyle: '',
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+  };
+
+  frame(ctx, state);
+
+  assert.equal(brick.alive, false, 'brick should be destroyed');
+  assert.ok(state.ball.vy < 0, 'ball should bounce UP');
+  assert.equal(state.ball.y, 93, 'ball should be pushed out to y=93');
+});
+
+test('frame: ball bounces off the side of a brick', () => {
+  const state = createState(1);
+  state.bricks = []; // Clear other bricks
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true, row: 0 };
+  state.bricks.push(brick);
+  // Ball is moving RIGHT and hitting the left side of the brick
+  state.ball = { x: 95, y: 110, r: 7, vx: 200, vy: 0 };
+
+  const ctx = {
+    fillStyle: '',
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+  };
+
+  frame(ctx, state);
+
+  assert.equal(brick.alive, false, 'brick should be destroyed');
+  assert.ok(state.ball.vx < 0, 'ball should bounce LEFT');
+  assert.equal(state.ball.x, 93, 'ball should be pushed out to x=93');
+});
