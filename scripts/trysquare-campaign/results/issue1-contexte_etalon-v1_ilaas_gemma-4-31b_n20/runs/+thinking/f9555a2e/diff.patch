-// TODO (#5): test comboMultiplier / scoreForBrick.
-// TODO      : test level progression and loadBest/saveBest persistence.
+test('step: bounce off a brick (top)', () => {
+  const state = createState(1);
+  // Position ball just above a brick and moving UP (actually it's moving DOWN in my test setup to hit the top? No, it must be moving UP to hit the top of a brick if bricks are at the top).
+  // Wait, bricks are at the TOP. Y increases DOWNWARD.
+  // Brick Y is BRICK_TOP (48).
+  // Ball Y moving UP means vy < 0.
+  // To hit the TOP of the brick, the ball must be moving UP (vy < 0) and then it should bounce DOWN (vy > 0).
+  state.ball = { x: 100, y: 60, r: 7, vx: 0, vy: -300 };
+  state.bricks = [{ x: 90, y: 50, w: 40, h: 20, alive: true }];
+  
+  // Step a bit to cause collision
+  step(state, 1 / 60);
+  
+  assert.ok(state.ball.vy > 0, 'ball should bounce DOWN after hitting the top of a brick');
+  assert.equal(state.bricks[0].alive, false, 'brick should be destroyed');
+});
+
+test('step: bounce off a brick (left)', () => {
+  const state = createState(1);
+  // Ball moving RIGHT (vx > 0) and hits the left side of a brick.
+  state.ball = { x: 80, y: 100, r: 7, vx: 300, vy: 0 };
+  state.bricks = [{ x: 90, y: 90, w: 40, h: 20, alive: true }];
+  
+  step(state, 1 / 60);
+  
+  assert.ok(state.ball.vx < 0, 'ball should bounce LEFT after hitting the left side of a brick');
+  assert.equal(state.bricks[0].alive, false, 'brick should be destroyed');
+});
