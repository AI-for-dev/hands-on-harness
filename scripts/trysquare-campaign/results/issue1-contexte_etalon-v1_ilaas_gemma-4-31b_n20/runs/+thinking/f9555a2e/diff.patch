+      const distTop = ball.y + ball.r - brick.y;
+      const distBottom = brick.y + brick.h - (ball.y - ball.r);
+      const minDist = Math.min(distLeft, distRight, distTop, distBottom);
+
+      if (minDist === distLeft) {
+        ball.vx = -Math.abs(ball.vx);
+        ball.x = brick.x - ball.r;
+      } else if (minDist === distRight) {
+        ball.vx = Math.abs(ball.vx);
+        ball.x = brick.x + brick.w + ball.r;
+      } else if (minDist === distTop) {
+        ball.vy = Math.abs(ball.vy);
+        ball.y = brick.y - ball.r;
+      } else if (minDist === distBottom) {
+        ball.vy = -Math.abs(ball.vy);
+        ball.y = brick.y + brick.h + ball.r;
+      }
+      break; // Only one brick per step to avoid weirdness
+    }
+  }
