@@ -0,0 +1,34 @@
+import { test } from 'node:test';
+import assert from 'node:assert';
+import { createState, frame } from '../game/neon.js';
+
+test('ball should bounce off the top of a brick', () => {
+  const state = createState(1);
+  const ctx = {
+    fillStyle: '',
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+  };
+
+  const brick = state.bricks[0]; // top-left brick
+  const ball = state.ball;
+
+  // Position ball just above the brick, moving DOWN
+  ball.x = brick.x + brick.w / 2;
+  ball.y = brick.y - ball.r - 1;
+  ball.vy = 100; // DOWN
+  ball.vx = 0;
+
+  // One frame of collision
+  // In reality, we should call step() then frame()
+  // But frame() is where the collision logic is.
+  // We need to simulate the ball entering the brick.
+  ball.y += ball.vy * 0.01; // move into the brick
+
+  frame(ctx, state);
+
+  assert.strictEqual(ball.vy < 0, true, 'Ball should be moving UP after hitting the top of a brick');
+});
