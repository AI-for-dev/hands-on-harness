+import assert from 'node:assert';
+import { test } from 'node:test';
+import { createState, frame, collides, UP, DOWN, LEFT, RIGHT } from '../game/neon.js';
+
+const mockCtx = {
+  fillRect: () => {},
+  arc: () => {},
+  fill: () => {},
+  beginPath: () => {},
+  fillText: () => {},
+};
+
+test('D1: No deflection - Ball plows through brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + brick.h + 2;
+  state.ball.vy = UP;
+  frame(mockCtx, state);
+  assert.strictEqual(state.ball.vy, DOWN, 'Ball should bounce DOWN');
+});
+
+test('D2: Incorrect axis - Side hit should flip vx, not vy', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x - 2;
+  state.ball.y = brick.y + brick.h / 2;
+  state.ball.vx = RIGHT;
+  state.ball.vy = 0;
+  frame(mockCtx, state);
+  assert.strictEqual(state.ball.vx, LEFT, 'Ball should bounce LEFT');
+  assert.strictEqual(state.ball.vy, 0, 'Ball vy should remain 0');
+});
+
+test('D3: Stickiness - Ball should not vibrate inside brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + brick.h / 2;
+  state.ball.vy = UP;
+  frame(mockCtx, state);
+  assert.strictEqual(state.ball.vy, DOWN, 'First bounce should be DOWN');
+  assert.ok(state.ball.y - state.ball.r >= brick.y + brick.h || state.ball.y + state.ball.r <= brick.y, 'Ball should be pushed out of brick');
+  state.ball.y += state.ball.vy * 0.01;
+  frame(mockCtx, state);
+  assert.strictEqual(state.ball.vy, DOWN, 'Ball should not flip back to UP while moving away');
+});
+
+test('D4: Tunneling - Ball should not skip brick at high speed', () => {
+  const state = createState(6);
+  const brick = state.bricks[0];
+  brick.alive = true;
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - state.ball.r - 1;
+  state.ball.vy = DOWN;
+  state.ball.vx = 0;
+  state.ball.y += state.ball.vy * 0.05;
+  console.log(`D4 Debug - Ball y: ${state.ball.y}, r: ${state.ball.r}, brick.y+h: ${brick.y + brick.h}, collides: ${collides(state.ball, brick)}`);
+  frame(mockCtx, state);
+  assert.strictEqual(brick.alive, false, 'Brick should have been broken even if ball jumped over it');
+});
