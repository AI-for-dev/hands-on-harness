+import assert from 'node:assert';
+import { test } from 'node:test';
+import { createState, frame, UP, DOWN } from '../game/neon.js';
+
+test('Ball should bounce off a brick (top face)', () => {
+  const state = createState(1);
+  const brick = state.bricks[0]; // top-left brick
+
+  // Position ball so it's about to hit the bottom of the brick
+  // Brick: { x: offsetX, y: BRICK_TOP, w: BRICK_W, h: BRICK_H }
+  // Ball: moving UP, hitting the bottom face (y + r > brick.y + brick.h)
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + brick.h + 2; // just below the brick
+  state.ball.vy = UP; // moving up
+  state.ball.vx = 0;
+
+  // Mock ctx
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    beginPath: () => {},
+    fillText: () => {},
+  };
+
+  // The frame function should handle the collision
+  frame(ctx, state);
+
+  assert.strictEqual(state.ball.vy, DOWN, `Ball should have bounced DOWN after hitting the bottom of the brick, but was ${state.ball.vy}`);
+});
