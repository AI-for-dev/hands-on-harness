+test('D5: Ghost collision - Double inversion on seam', () => {
+  const state = createState(1);
+  const b1 = state.bricks[0];
+  const b2 = state.bricks[1]; // Next brick in the row
+
+  // Ball hitting the seam between two bricks
+  state.ball.x = b1.x + b1.w; // Exactly on the edge
