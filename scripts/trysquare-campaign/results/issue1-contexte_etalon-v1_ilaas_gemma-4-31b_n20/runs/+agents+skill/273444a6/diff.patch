+import assert from 'node:assert';
+import { test } from 'node:test';
+import { createState, frame } from '../game/neon.js';
+
+test('Ball should bounce off brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0]; // Row 0, Col 0
+  
+  // Position ball so it's about to hit the bottom of the brick from above (vy > 0)
+  // Actually, let's hit the top face (ball coming from below, vy < 0)
+  // Brick 0 is at y: BRICK_TOP (48), h: 20. Top is 48, Bottom is 68.
+  // Ball: r=7. Bottom of ball is y+7.
+  // To hit the bottom face: ball is at y=70, vy = -100. Next frame it's at y=65.
+  
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + brick.h + 2; // Just below the brick
+  state.ball.vy = -100; // Moving UP
+  state.ball.vx = 0;
+  
+  const mockCtx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    beginPath: () => {},
+    fillText: () => {},
+    fillStyle: '',
+  };
+
+  // One frame of collision
+  frame(mockCtx, state);
+
+  assert.strictEqual(state.ball.vy, 100, 'Ball should have bounced (vy flipped)');
+});
