+import assert from 'node:assert';
+import { test } from 'node:test';
+import { createState, step } from '../game/neon.js';
+
+function setupBall(state, x, y, vx, vy) {
+  state.ball.x = x;
+  state.ball.y = y;
+  state.ball.vx = vx;
+  state.ball.vy = vy;
+}
+
+test('D1: No bounce - Bottom hit', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  setupBall(state, brick.x + brick.w / 2, brick.y + brick.h + 2, 0, -100);
+  step(state, 0.01); // Use a small dt
+  assert.strictEqual(state.ball.vy, 100, 'Ball should have bounced (vy flipped)');
+});
+
+test('D3: Wrong axis - Side hit', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  setupBall(state, brick.x - 2, brick.y + brick.h / 2, 100, 0);
+  step(state, 0.01);
+  assert.strictEqual(state.ball.vx, -100, 'Ball should have bounced (vx flipped)');
+});
+
+test('D2: Sticky - Overlap resolution', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  setupBall(state, brick.x + brick.w / 2, brick.y + 2, 0, 100);
+  step(state, 0.01);
+  assert.ok(state.ball.y + state.ball.r <= brick.y, 'Ball should be pushed out of the brick');
+});
+
+test('D4: Double inversion - Seam', () => {
+  const state = createState(1);
+  const b0 = state.bricks[0];
+  const b1 = state.bricks[1];
+  state.ball.x = b0.x + b0.w + 4; 
+  state.ball.y = b0.y + b0.h + 2; 
+  state.ball.vy = -100;
+  state.ball.vx = 0;
+  step(state, 0.01);
+  assert.strictEqual(state.ball.vy, 100, 'Ball should have bounced once, not twice');
+});
+
+test('D5: Tunneling - High speed', () => {
+  const state = createState(6);
+  const brick = state.bricks[0];
+  // Ball moving fast: vy = 710. In 0.05s it moves 35.5px.
+  // We position it so it would jump over the brick in one big step.
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 8; // bottom = -1.
+  state.ball.vy = 710;
+  state.ball.vx = 0;
+  
+  step(state, 0.05);
+  
+  // With sub-stepping, it should have been caught.
+  assert.ok(state.ball.vy < 0, 'Ball should have rebounded from top of brick');
+});
