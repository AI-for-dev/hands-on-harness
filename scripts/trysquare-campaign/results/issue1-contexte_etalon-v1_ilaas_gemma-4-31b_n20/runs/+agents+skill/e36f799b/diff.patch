+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, frame, step } from '../game/neon.js';
+
+test('D1 - No bounce on brick hit', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + 2; 
+  state.ball.vy = 10; 
+  const initialVy = state.ball.vy;
+  step(state, 0.01); 
+  assert.notStrictEqual(state.ball.vy, initialVy, 'Ball should have bounced');
+});
+
+test('D2 - Tunneling at high speed', () => {
+  const state = createState(5);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 10;
+  state.ball.vy = 1000; 
+  step(state, 0.05); 
+  assert.strictEqual(brick.alive, false, 'Brick should have been broken even if tunneled');
+});
+
+test('D3 - Sticky overlap', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + 5; 
+  state.ball.vy = 10; 
+  step(state, 0.01);
+  
+  const coll = (function collides(ball, brick) {
+    return (
+      ball.x + ball.r > brick.x &&
+      ball.x - ball.r < brick.x + brick.w &&
+      ball.y + ball.r > brick.y &&
+      ball.y - ball.r < brick.y + brick.h
+    );
+  })(state.ball, brick);
+  assert.strictEqual(coll, false, 'Ball should be repositioned outside the brick');
+});
+
+test('D4 - Corner bounce', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + 1;
+  state.ball.y = brick.y + 1;
+  state.ball.vx = 100;
+  state.ball.vy = 100;
+  
+  step(state, 0.01);
+  assert.strictEqual(state.ball.vx, -100, 'vx should be inverted');
+  assert.strictEqual(state.ball.vy, -100, 'vy should be inverted');
+});
