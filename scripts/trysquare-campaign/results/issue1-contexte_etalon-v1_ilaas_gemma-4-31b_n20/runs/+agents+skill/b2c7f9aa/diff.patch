@@ -0,0 +1,34 @@
+import assert from 'node:assert';
+import { test } from 'node:test';
+import { createState, collides, step, frame } from './game/neon.js';
+// Mock canvas context
+const mockCtx = {
+  fillRect: () => {},
+  arc: () => {},
+  fill: () => {},
+  fillText: () => {},
+  beginPath: () => {},
+  stroke: () => {},
+};
+
+test('D1 - Missing bounce: ball should deflect when hitting a brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  // Position ball to hit the top of the first brick
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - ball_r - 1; // Just above
+  state.ball.vy = 100; // Moving down
+
+  // This is a bit tricky because collisions are in frame().
+  // We need to simulate the loop.
+  const dt = 0.01;
+  // Manually advance ball to be colliding
+  state.ball.y = brick.y - 1;
+
+  const initialVy = state.ball.vy;
+  frame(mockCtx, state);
+
+  if (state.ball.vy === initialVy) {
+    throw new Error(`Ball did not bounce! vy: ${state.ball.vy}`);
+  }
+});
