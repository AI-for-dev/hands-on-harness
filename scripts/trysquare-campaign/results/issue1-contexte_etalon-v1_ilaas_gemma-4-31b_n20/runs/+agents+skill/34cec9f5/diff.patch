+// Resolves collisions between the ball and live bricks.
+// Handles bounce deflection and repositioning to prevent sticking.
+export function resolveBrickCollisions(state) {
+  const { ball } = state;
+
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+
+    if (collides(ball, brick)) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+
+      // Calculate overlaps to determine the hit face.
+      const dx1 = ball.x + ball.r - brick.x;
+      const dx2 = brick.x + brick.w - (ball.x - ball.r);
+      const dy1 = ball.y + ball.r - brick.y;
+      const dy2 = brick.y + brick.h - (ball.y - ball.r);
+
+      const overlapX = Math.min(dx1, dx2);
+      const overlapY = Math.min(dy1, dy2);
+
+      if (overlapX < overlapY) {
+        ball.vx = -ball.vx;
+        ball.x += (dx1 < dx2) ? -overlapX : overlapX;
+      } else {
+        ball.vy = -ball.vy;
+        ball.y += (dy1 < dy2) ? -overlapY : overlapY;
+      }
+
+      // Prevent ghost collisions: only one brick is resolved per frame.
+      break;
+    }
+  }
