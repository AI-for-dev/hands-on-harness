+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createState, frame } from '../game/neon.js';
+
+test('ball should bounce on both axes when hitting a corner', () => {
+  const state = createState(1);
+  // Position ball at the bottom-right corner of a brick
+  // Brick: x: offsetX + col * (BRICK_W + BRICK_GAP), y: BRICK_TOP + row * (BRICK_H + BRICK_GAP)
+  // Let's use a brick from makeBricks(1)
+  const brick = state.bricks[0]; // top-left brick
+  
+  // Ball moving towards the bottom-right corner of this brick
+  // Brick bottom: brick.y + brick.h, Brick right: brick.x + brick.w
+  state.ball = { 
+    x: brick.x + brick.w + 2, 
+    y: brick.y + brick.h + 2, 
+    r: 7, 
+    vx: -200, 
+    vy: -200 
+  };
+  
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    beginPath: () => {},
+    fill: () => {},
+    fillText: () => {},
+    fillStyle: '',
+  };
+  
+  frame(ctx, state);
+  
+  assert.ok(state.ball.vx > 0, 'Ball should bounce right');
+  assert.ok(state.ball.vy > 0, 'Ball should bounce down');
+});
