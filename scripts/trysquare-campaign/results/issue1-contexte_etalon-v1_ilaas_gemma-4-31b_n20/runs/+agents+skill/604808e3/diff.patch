@@ -0,0 +1,42 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createState, frame, ballSpeed } from '../game/neon.js';
+
+test('ball should not tunnel through brick at high speed', () => {
+  const level = 6;
+  const state = createState(level);
+  const speed = ballSpeed(level);
+  
+  // Position ball just below the brick in one frame
+  // Brick bottom is at 68.
+  // Ball r = 7. Bottom of ball is at y+7. Top is at y-7.
+  // We want ball.y - 7 > 68 (no collision)
+  // And in next frame, ball.y + 7 < 68 (no collision)
+  
+  state.ball = { x: 100, y: 68 + 7 + 1, r: 7, vx: 0, vy: -speed };
+  
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    beginPath: () => {},
+    fill: () => {},
+    fillText: () => {},
+    fillStyle: '',
+  };
+
+  // Simulate one physics step (we need to implement step's effect on y)
+  // ball.y += ball.vy * dt;
+  const dt = 0.05;
+  state.ball.y += state.ball.vy * dt;
+  
+  // Check if it's now above the brick
+  // Brick top is at 48. Bottom is 68.
+  // Ball's bottom is state.ball.y + 7.
+  // If ball.y + 7 < 48, it has tunneled through.
+  
+  frame(ctx, state);
+  
+  // If the brick is still alive, it tunneled.
+  const brick = state.bricks.find(b => b.x <= 100 && b.x + b.w >= 100 && b.y <= 48 && b.y + b.h >= 68);
+  assert.ok(!brick.alive, 'Brick should be broken even if ball tunneled through');
+});
