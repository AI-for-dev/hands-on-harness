+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createState, frame, collides } from '../game/neon.js';
+
+test('ball should be pushed out of brick after collision', () => {
+  const state = createState(1);
+  // Ball is overlapping the brick
+  state.ball = { x: 100, y: 70, r: 7, vx: 0, vy: -200 }; 
+  
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    beginPath: () => {},
+    fill: () => {},
+    fillText: () => {},
+    fillStyle: '',
+  };
+  
+  frame(ctx, state);
+  
+  // The ball should no longer collide with the broken brick (or any brick)
+  // This is a bit tricky because the brick is now dead.
+  // Let's check if it still overlaps the area where the brick was.
+  const brickArea = { x: 0, y: 48, w: 640, h: 20 }; // Simplified
+  // Actually, let's just check if it's still within the brick's original bounds.
+  // If the ball is at y=70 and the brick bottom is 68, and it's moving UP,
+  // it should be pushed DOWN to y=68+7=75.
+  
+  assert.ok(state.ball.y - state.ball.r >= 68 || state.ball.y + state.ball.r <= 48, 
+    'Ball should be positioned outside the brick bounds after collision');
+});
