@@ -0,0 +1,26 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createState, frame } from '../game/neon.js';
+
+test('ball should bounce off brick', () => {
+  const state = createState(1);
+  // Position ball so it's about to hit the bottom of the first brick
+  // BRICK_TOP = 48, BRICK_H = 20. Bottom is 68.
+  // Ball r = 7.
+  state.ball = { x: 100, y: 70, r: 7, vx: 0, vy: -200 }; 
+  // It's already overlapping: 70-7 = 63 < 68.
+  
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    beginPath: () => {},
+    fill: () => {},
+    fillText: () => {},
+    fillStyle: '',
+  };
+  
+  frame(ctx, state);
+  
+  // In a correct implementation, vy should have flipped to positive
+  assert.ok(state.ball.vy > 0, 'Ball should bounce back down');
+});
