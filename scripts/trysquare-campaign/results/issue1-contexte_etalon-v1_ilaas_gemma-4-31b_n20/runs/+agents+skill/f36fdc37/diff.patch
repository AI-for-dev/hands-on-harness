+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { collides } from '../game/neon.js';
+
+test('collides test', () => {
+  const ball = { x: 79, y: 58, r: 7 };
+  const brick = { x: 4, y: 48, w: 72, h: 20 };
+  console.log('Collides:', collides(ball, brick));
+  assert.ok(collides(ball, brick));
+});
