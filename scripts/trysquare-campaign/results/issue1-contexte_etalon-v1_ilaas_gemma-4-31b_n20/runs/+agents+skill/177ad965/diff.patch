+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, step, collides } from '../game/neon.js';
+
+// Helper to simulate a brick bounce (since it's currently in frame())
+function resolveBrickCollision(state, brick) {
+  if (collides(state.ball, brick)) {
+    brick.alive = false;
+    // CURRENT IMPLEMENTATION: does nothing to ball.vy/vx
+  }
+}
+
+test('D1 - No bounce: Ball plows through brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 2; 
+  state.ball.vy = 100; 
+  state.ball.vx = 0;
+
+  const dt = 0.016;
+  step(state, dt); 
+  resolveBrickCollision(state, brick);
+
+  assert.strictEqual(state.ball.vy, -100, 'Ball should have bounced UP');
+});
+
+test('D2 - Sticking: Ball remains inside brick after bounce', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 2; 
+  state.ball.vy = 100; 
+  state.ball.vx = 0;
+
+  const dt = 0.016;
+  step(state, dt); 
+  
+  // Simulate a "naive fix" that only flips vy
+  if (collides(state.ball, brick)) {
+    state.ball.vy = -state.ball.vy;
+    brick.alive = false;
+  }
+
+  assert.strictEqual(collides(state.ball, brick), false, 'Ball should be pushed out of the brick to prevent sticking');
+});
+
+test('D3 - Side hit: Ball bounces vertically instead of horizontally', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball.x = brick.x - 5;
+  state.ball.y = brick.y + brick.h / 2;
+  state.ball.vx = 100;
+  state.ball.vy = 0;
+
+  const dt = 0.016;
+  step(state, dt); 
+  
+  // Simulate a "naive fix" that only flips vy
+  if (collides(state.ball, brick)) {
+    state.ball.vy = -state.ball.vy;
+    brick.alive = false;
+  }
+
+  assert.strictEqual(state.ball.vx, -100, 'Ball should have bounced LEFT');
+  assert.strictEqual(state.ball.vy, 0, 'Ball vy should remain 0');
+});
+
+test('D4 - Tunneling: Ball passes through brick at high speed', () => {
+  const state = createState(6); // Speed = 710
+  const brick = state.bricks[0];
+  const speed = 710;
+  const dt = 0.05; // Max dt
+  const distancePerFrame = speed * dt; // 35.5 pixels
+  
+  // Brick is 20px high. Ball radius 7.
+  // Position ball just above the brick
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 2; // ball.y + ball.r = 5. Just above.
+  state.ball.vy = speed;
+  state.ball.vx = 0;
+
+  step(state, dt); // y = brick.y - 2 + 35.5 = brick.y + 33.5.
+  // Ball.y = brick.y + 33.5. 
+  // Ball.y - ball.r = brick.y + 33.5 - 7 = brick.y + 26.5.
+  // Brick bounds: [brick.y, brick.y + 20].
+  // Ball is entirely BELOW the brick now. No overlap.
+  
+  assert.strictEqual(collides(state.ball, brick), true, 'Ball should have collided with brick despite high speed (tunneling)');
+});
