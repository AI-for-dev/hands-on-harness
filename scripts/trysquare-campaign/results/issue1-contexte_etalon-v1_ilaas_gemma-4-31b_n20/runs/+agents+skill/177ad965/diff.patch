@@ -158,9 +158,55 @@ export function saveBest(storage, score) {
 
 // --- Physics (movement + wall/paddle bounces) ------------------------------
 
+// Handles collisions between the ball and all live bricks.
+// Returns true if any brick was destroyed.
+export function resolveBricks(state) {
+  const { ball, bricks } = state;
+  let changed = false;
+
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+
+    // 1. Find the closest point on the brick to the ball center
+    const closestX = Math.max(brick.x, Math.min(ball.x, brick.x + brick.w));
+    const closestY = Math.max(brick.y, Math.min(ball.y, brick.y + brick.h));
+
+    // 2. Calculate distance from ball center to this closest point
+    const dx = ball.x - closestX;
+    const dy = ball.y - closestY;
+    const distanceSq = dx * dx + dy * dy;
+
+    if (distanceSq < ball.r * ball.r) {
+      console.log(`COLLISION: dx=${dx}, dy=${dy}, distSq=${distanceSq}, vx=${ball.vx}`);
+      // Collision detected!
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+      changed = true;
+
+      // 3. Collision Normal
+      const distance = Math.sqrt(distanceSq);
+      
+      // Avoid division by zero if ball center is exactly on the closest point
+      const nx = distance === 0 ? 0 : dx / distance;
+      const ny = distance === 0 ? -1 : dy / distance; // default to UP if centered
+
+      // 4. Reflect velocity: v = v - 2 * (v . n) * n
+      const dot = ball.vx * nx + ball.vy * ny;
+      ball.vx -= 2 * dot * nx;
+      ball.vy -= 2 * dot * ny;
+
+      // 5. Resolve penetration (push ball out)
+      const overlap = ball.r - distance;
+      ball.x += nx * overlap;
+      ball.y += ny * overlap;
+    }
+  }
+  return changed;
+}
