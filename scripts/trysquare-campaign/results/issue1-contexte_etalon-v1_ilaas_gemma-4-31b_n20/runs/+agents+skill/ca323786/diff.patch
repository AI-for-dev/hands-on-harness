+import assert from 'node:assert';
+import { test } from 'node:test';
+import { createState, frame, collides } from '../game/neon.js';
+
+const mockCtx = {
+  fillRect: () => {},
+  beginPath: () => {},
+  arc: () => {},
+  fill: () => {},
+  fillText: () => {},
+};
+
+test('D5: Ball should not tunnel through bricks at high speed', () => {
+  const state = createState(10); // Level 10: speed = 1070
+  const brick = state.bricks[0];
+  
+  // Position ball just above the brick, but moving fast enough to jump over it in one frame
+  // brick.y = 48, brick.h = 20.
+  // ball.r = 7.
+  // Ball is at y = 48 - 7 - 1 = 40.
+  // vy = 1070.
+  // In one step (dt=0.05), ball moves 53.5 px.
+  // New y = 40 + 53.5 = 93.5.
+  // Brick bottom = 48 + 20 = 68.
+  // Ball was at 40 (above) and is now at 93.5 (below).
+  // It completely jumped over the brick.
+  
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - state.ball.r - 1;
+  state.ball.vy = 1070; // speed at level 10
+  state.ball.vx = 0;
+
+  // Use a manual step since frame() just calls collides()
+  // In the actual game, step() is called before frame().
+  // We simulate one frame's movement and then the collision check.
+  const dt = 0.05;
+  state.ball.y += state.ball.vy * dt;
+
+  // Now check if it collided. With discrete detection, it won't.
+  const hit = collides(state.ball, brick);
+  
+  assert.strictEqual(hit, true, `Ball should have collided with brick despite high speed, but collides() returned ${hit}`);
+});
