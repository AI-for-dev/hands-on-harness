+import assert from 'node:assert';
+import { test } from 'node:test';
+import { createState, frame, collides } from '../game/neon.js';
+
+// Mock Canvas 2D context
+const mockCtx = {
+  fillRect: () => {},
+  beginPath: () => {},
+  arc: () => {},
+  fill: () => {},
+  fillText: () => {},
+};
+
+test('D1: Bricks should deflect the ball', () => {
+  const state = createState(1);
+  // Position ball so it's colliding with the first brick
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + brick.h / 2;
+  state.ball.vx = -100; // Moving left
+  state.ball.vy = 0;
+
+  assert.strictEqual(collides(state.ball, brick), true, 'Ball should collide with brick');
+
+  // Execute one frame
+  frame(mockCtx, state);
+
+  // The brick should be dead
+  assert.strictEqual(brick.alive, false, 'Brick should be destroyed');
+
+  // The ball should have bounced (vx should be positive)
+  assert.ok(state.ball.vx > 0, `Ball should bounce back (vx > 0), but got ${state.ball.vx}`);
+});
