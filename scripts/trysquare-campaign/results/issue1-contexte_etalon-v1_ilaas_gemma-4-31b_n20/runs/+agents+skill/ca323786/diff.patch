+import assert from 'node:assert';
+import { test } from 'node:test';
+import { createState, collides } from '../game/neon.js';
+
+test('D3: Ball should not double-invert velocity when overlapping two bricks', () => {
+  const state = createState(1);
+  const brick1 = state.bricks[0];
+  const brick2 = state.bricks[1];
+
+  // Position ball so it overlaps both bricks horizontally.
+  // Brick 0: x=offsetX, w=72. Brick 1: x=offsetX+80, w=72.
+  // Ball r=7. If ball.x = offsetX + 72 + 4 = offsetX + 76.
+  // Ball left = 76 - 7 = 69. (Overlaps Brick 0: 69 < 72+offsetX)
+  // Ball right = 76 + 7 = 83. (Overlaps Brick 1: 83 > 80+offsetX)
+  
+  state.ball.x = (state.bricks[0].x + state.bricks[0].w) + 4;
+  state.ball.y = state.bricks[0].y + state.bricks[0].h / 2;
+  state.ball.vx = -100;
+
+  // Simulate what a naïve loop would do:
+  let vx = state.ball.vx;
+  for (const brick of state.bricks) {
+    if (collides(state.ball, brick)) {
+      vx = -vx;
+    }
+  }
+
+  assert.ok(vx > 0, `Ball should have ended up moving RIGHT, but got ${vx}`);
+  // Wait, if it flipped twice, it would be -100 -> 100 -> -100.
+  // So vx would be -100.
+});
