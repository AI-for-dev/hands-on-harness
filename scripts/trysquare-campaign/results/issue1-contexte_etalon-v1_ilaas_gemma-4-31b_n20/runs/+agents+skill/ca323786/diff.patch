 }
 
+export function sweptCollides(ball, brick) {
+  const prevX = ball.prevX;
+  const prevY = ball.prevY;
+  const currX = ball.x;
+  const currY = ball.y;
+
+  const minX = Math.min(prevX - ball.r, currX - ball.r);
+  const maxX = Math.max(prevX + ball.r, currX + ball.r);
+  const minY = Math.min(prevY - ball.r, currY - ball.r);
+  const maxY = Math.max(prevY + ball.r, currY + ball.r);
+
+  return (
+    maxX > brick.x &&
+    minX < brick.x + brick.w &&
+    maxY > brick.y &&
+    minY < brick.y + brick.h
+  );
+}
