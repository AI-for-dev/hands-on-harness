+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, frame, WIDTH, HEIGHT } from '../game/neon.js';
+
+test('ball should bounce off brick', (t) => {
+  const state = createState(1);
+  // Position ball so it's about to hit a brick from above
+  // Brick 0 is at BRICK_TOP = 48, BRICK_H = 20. Top is 48, bottom is 68.
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 1; // Just above the brick
+  state.ball.vy = 100; // Moving DOWN
+
+  // Mock canvas context
+  const ctx = {
+    fillStyle: '',
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {}
+  };
+
+  // This should trigger collision in frame()
+  frame(ctx, state);
+
+  // In a correct implementation, vy should now be negative (UP)
+  assert.strictEqual(Math.sign(state.ball.vy), -1, 'Ball should have bounced UP after hitting brick top');
+});
