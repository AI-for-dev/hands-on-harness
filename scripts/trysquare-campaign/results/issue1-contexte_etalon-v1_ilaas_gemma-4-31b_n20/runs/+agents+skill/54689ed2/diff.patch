+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, frame, step } from '../game/neon.js';
+
+test('ball should not tunnel through brick at high speed', (t) => {
+  const state = createState(6);
+  // Remove all bricks except the first one
+  state.bricks = [state.bricks[0]];
+  const brick = state.bricks[0];
+
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = 40;
+  state.ball.vy = 710;
+
+  const dt = 0.05;
+  const ctx = {
+    fillStyle: '',
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {}
+  };
+
+  step(state, dt);
+  frame(ctx, state);
+
+  assert.notStrictEqual(state.ball.vy, 710, 'Ball should have bounced and changed vy');
+});
