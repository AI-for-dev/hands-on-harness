+// Resolves collisions between the ball and all live bricks.
+function resolveBricks(state, dt) {
+  const { ball } = state;
+  const prevX = ball.x - ball.vx * dt;
+  const prevY = ball.y - ball.vy * dt;
+
+  let flippedX = false;
+  let flippedY = false;
+
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+
+    const isOverlapping = collides(ball, brick);
+    const wasAbove = prevY + ball.r < brick.y;
+    const isBelow = ball.y - ball.r > brick.y + brick.h;
+    const tunnelY = wasAbove && isBelow && 
+                   ball.x + ball.r > brick.x && ball.x - ball.r < brick.x + brick.w;
+
+    const wasLeft = prevX + ball.r < brick.x;
+    const isRight = ball.x - ball.r > brick.x + brick.w;
+    const tunnelX = wasLeft && isRight && 
+                   ball.y + ball.r > brick.y && ball.y - ball.r < brick.y + brick.h;
+
+    if (isOverlapping || tunnelY || tunnelX) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+
+      if (tunnelY) {
+        if (!flippedY) {
+          ball.vy = -Math.abs(ball.vy);
+          ball.y = brick.y - ball.r;
+          flippedY = true;
+        }
+      } else if (tunnelX) {
+        if (!flippedX) {
+          ball.vx = Math.abs(ball.vx);
+          ball.x = brick.x + brick.w + ball.r;
+          flippedX = true;
+        }
+      } else {
+        const dx1 = (ball.x + ball.r) - brick.x;
+        const dx2 = (brick.x + brick.w) - (ball.x - ball.r);
+        const dy1 = (ball.y + ball.r) - brick.y;
+        const dy2 = (brick.y + brick.h) - (ball.y - ball.r);
+        
+        const minX = Math.min(dx1, dx2);
+        const minY = Math.min(dy1, dy2);
+
+        if (minX < minY) {
+          if (!flippedX) {
+            if (ball.vx > 0) {
+              ball.vx = -Math.abs(ball.vx);
+              ball.x = brick.x - ball.r;
+            } else {
+              ball.vx = Math.abs(ball.vx);
+              ball.x = brick.x + brick.w + ball.r;
+            }
+            flippedX = true;
+          }
+        } else {
+          if (!flippedY) {
+            if (ball.vy > 0) {
+              ball.vy = -Math.abs(ball.vy);
+              ball.y = brick.y - ball.r;
+            } else {
+              ball.vy = Math.abs(ball.vy);
+              ball.y = brick.y + brick.h + ball.r;
+            }
+            flippedY = true;
+          }
+        }
+      }
+    }
+  }
+}
