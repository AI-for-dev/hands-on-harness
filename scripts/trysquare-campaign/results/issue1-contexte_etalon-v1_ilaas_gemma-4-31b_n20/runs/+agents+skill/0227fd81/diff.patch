+import assert from 'node:assert';
+import { test } from 'node:test';
+import { createState, frame } from '../game/neon.js';
+
+test('D2 - Ball sticks to brick when resolution is missing', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  
+  // Position ball so it's already overlapping the brick
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + 2; 
+  state.ball.vy = 100;
+  state.ball.vx = 0;
+
+  const ctx = {
+    fillRect: () => {}, arc: () => {}, fill: () => {},
+    fillText: () => {}, beginPath: () => {},
+  };
+
+  // First frame: collision detected, vy flipped to -100
+  frame(ctx, state);
+  
+  // Simulate a small time step manually as if in the loop
+  // Normally step() is called first, then frame().
+  // But if we only change vy in frame(), let's see.
+  
+  // This test is more about how we CORRECT it. 
+  // If the fix is just vy = -vy, the ball might stay inside.
+  // For now, we just want to see that the current code doesn't resolve position.
+  
+  assert.notStrictEqual(state.ball.y, brick.y - state.ball.r, 'Ball should be pushed out of the brick');
+});
