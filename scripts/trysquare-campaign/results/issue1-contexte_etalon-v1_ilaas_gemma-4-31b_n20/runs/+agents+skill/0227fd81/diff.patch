+
+test('D1 - Ball does not bounce off bricks', () => {
+  const state = createState(1);
+  // Position ball to hit the top face of the first brick
+  // First brick: x: offsetX, y: BRICK_TOP, w: BRICK_W, h: BRICK_H
+  // state.bricks[0]
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 2; // Just above
+  state.ball.vy = 100; // Moving DOWN
+  state.ball.vx = 0;
+
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+    beginPath: () => {},
+  };
+
+  frame(ctx, state);
+
+  // It should have bounced UP (vy < 0)
+  assert.strictEqual(state.ball.vy, -100, 'Ball should bounce UP after hitting top face');
+});
