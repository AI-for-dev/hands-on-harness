+// Handles the collision between the ball and a single brick.
+// Returns true if a collision occurred.
+export function handleBrickCollision(state, brick) {
+  if (!collides(state.ball, brick)) return false;
+
+  brick.alive = false;
+  state.combo += 1;
+  state.score += scoreForBrick(brick, state.combo);
+
+  const centerX = brick.x + brick.w / 2;
+  const centerY = brick.y + brick.h / 2;
+  const dx = Math.abs(state.ball.x - centerX);
+  const dy = Math.abs(state.ball.y - centerY);
+
+  if (dx > brick.w / 2 && dy > brick.h / 2) {
+    state.ball.vx = -state.ball.vx;
+    state.ball.vy = -state.ball.vy;
+  } else if (dx < brick.w / 2) {
+    state.ball.vy = -state.ball.vy;
+  } else {
+    state.ball.vx = -state.ball.vx;
+  }
+
+  return true;
+}
+
