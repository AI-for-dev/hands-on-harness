+export function step(state, dt) {
+  const { ball, paddle, bricks } = state;
+
+  const speed = Math.sqrt(ball.vx ** 2 + ball.vy ** 2);
+  const numSteps = Math.ceil((speed * dt) / (BRICK_H / 2)) || 1;
+  const sdt = dt / numSteps;
+
+  for (let s = 0; s < numSteps; s++) {
+    ball.x += ball.vx * sdt;
+    ball.y += ball.vy * sdt;
+
+    if (ball.x - ball.r < 0) {
+      ball.x = ball.r;
+      ball.vx = Math.abs(ball.vx);
+    } else if (ball.x + ball.r > WIDTH) {
+      ball.x = WIDTH - ball.r;
+      ball.vx = -Math.abs(ball.vx);
+    }
+
+    if (ball.y - ball.r < 0) {
+      ball.y = ball.r;
+      ball.vy = Math.abs(ball.vy);
+    }
+
+    for (const brick of bricks) {
+      if (!brick.alive) continue;
+
+      if (collides(ball, brick)) {
+        const overlapX = Math.min(ball.x + ball.r - brick.x, brick.x + brick.w - (ball.x - ball.r));
+        const overlapY = Math.min(ball.y + ball.r - brick.y, brick.y + brick.h - (ball.y - ball.r));
+
+        if (overlapX < overlapY) {
+          const hitLeft = ball.x + ball.r - brick.x < brick.x + brick.w - (ball.x - ball.r);
+          if (hitLeft ? ball.vx > 0 : ball.vx < 0) {
+            ball.vx = -ball.vx;
+          }
+          ball.x += hitLeft ? -(ball.x + ball.r - brick.x) : (brick.x + brick.w - (ball.x - ball.r));
+        } else {
+          const hitTop = ball.y + ball.r - brick.y < brick.y + brick.h - (ball.y - ball.r);
+          if (hitTop ? ball.vy > 0 : ball.vy < 0) {
+            ball.vy = -ball.vy;
+          }
+          ball.y += hitTop ? -(ball.y + ball.r - brick.y) : (brick.y + brick.h - (ball.y - ball.r));
+        }
+
+        brick.alive = false;
+        state.combo += 1;
+        state.score += scoreForBrick(brick, state.combo);
+      }
+    }
+
+    if (
+      ball.vy > 0 &&
+      ball.y + ball.r >= paddle.y &&
+      ball.y + ball.r <= paddle.y + paddle.h &&
+      ball.x >= paddle.x &&
+      ball.x <= paddle.x + paddle.w
+    ) {
+      ball.y = paddle.y - ball.r;
+      ball.vy = -Math.abs(ball.vy);
+      const hit = (ball.x - (paddle.x + paddle.w / 2)) / (paddle.w / 2);
+      ball.vx = ballSpeed(state.level) * 0.6 * hit;
+      state.combo = 0;
+    }
+
+    if (ball.y - ball.r > HEIGHT) {
+      return true;
+    }
+  }
+  return false;
+}
