-      // side hit) plus pushing the ball back out of the brick.
+
+      // Resolve collision face and bounce
+      const ball = state.ball;
+      const bLeft = brick.x;
+      const bRight = brick.x + brick.w;
+      const bTop = brick.y;
+      const bBottom = brick.y + brick.h;
+
+      const overlapLeft = ball.x + ball.r - bLeft;
+      const overlapRight = bRight - (ball.x - ball.r);
+      const overlapTop = ball.y + ball.r - bTop;
+      const overlapBottom = bBottom - (ball.y - ball.r);
+
+      const minOverlap = Math.min(overlapLeft, overlapRight, overlapTop, overlapBottom);
+
+      if (minOverlap === overlapLeft && minOverlap === overlapTop) {
+        ball.vx = -Math.abs(ball.vx);
+        ball.vy = Math.abs(ball.vy);
+        ball.x = bLeft - ball.r;
+        ball.y = bTop - ball.r;
+      } else if (minOverlap === overlapRight && minOverlap === overlapTop) {
+        ball.vx = Math.abs(ball.vx);
+        ball.vy = Math.abs(ball.vy);
+        ball.x = bRight + ball.r;
+        ball.y = bTop - ball.r;
+      } else if (minOverlap === overlapLeft && minOverlap === overlapBottom) {
+        ball.vx = -Math.abs(ball.vx);
+        ball.vy = -Math.abs(ball.vy);
+        ball.x = bLeft - ball.r;
+        ball.y = bBottom + ball.r;
+      } else if (minOverlap === overlapRight && minOverlap === overlapBottom) {
+        ball.vx = Math.abs(ball.vx);
+        ball.vy = -Math.abs(ball.vy);
+        ball.x = bRight + ball.r;
+        ball.y = bBottom + ball.r;
+      } else if (minOverlap === overlapLeft) {
+        ball.vx = -Math.abs(ball.vx);
+        ball.x = bLeft - ball.r;
+      } else if (minOverlap === overlapRight) {
+        ball.vx = Math.abs(ball.vx);
+        ball.x = bRight + ball.r;
+      } else if (minOverlap === overlapTop) {
+        ball.vy = Math.abs(ball.vy);
+        ball.y = bTop - ball.r;
+      } else if (minOverlap === overlapBottom) {
+        ball.vy = -Math.abs(ball.vy);
+        ball.y = bBottom + ball.r;
+      }
     }

