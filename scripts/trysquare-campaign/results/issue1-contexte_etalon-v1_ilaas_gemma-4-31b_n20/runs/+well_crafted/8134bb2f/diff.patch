+      const by = brick.y;
+      const bw = brick.w;
+      const bh = brick.h;
+      const ball = state.ball;
+
+      // Simple sweep: if ball was on one side and is now on the other, it's a hit
+      // We approximate by checking if the line segment (prev, current) intersects the brick box
+      // For a brick breaker, usually checking if the center crossed the boundaries is enough
+      // but let's do a more robust AABB sweep approximation.
+      const minX = Math.min(ball.prevX - ball.r, ball.x - ball.r);
+      const maxX = Math.max(ball.prevX + ball.r, ball.x + ball.r);
+      const minY = Math.min(ball.prevY - ball.r, ball.y + ball.r);
+      const maxY = Math.max(ball.prevY + ball.r, ball.y + ball.r);
+
+      if (maxX > bx && minX < bx + bw && maxY > by && minY < by + bh) {
+        hit = true;
+      }
+    }
