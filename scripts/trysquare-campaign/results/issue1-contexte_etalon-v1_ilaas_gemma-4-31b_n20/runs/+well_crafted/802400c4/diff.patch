+test('brick hit: tunneling prevention (sweep)', () => {
+  const state = createState(1);
+  const brick = { x: 100, y: 100, w: 100, h: 20, alive: true, points: 10 };
+  state.bricks = [brick];
+  
+  // Ball speed at level 6 is 710 px/s. dt = 50ms -> 35.5px.
+  // Ball is at y = 90, r = 7. Next pos y = 90 + 35.5 = 125.5.
+  // Brick is at y = 100, h = 20. 
+  // The ball jumps from 90 to 125.5, skipping the brick entirely if discrete.
+  state.ball = { x: 150, y: 90, r: 7, vx: 0, vy: 710 };
+  
+  // We need to simulate the a frame where tunneling might occur.
+  // Since collision is currently in frame(), and frame doesn't take dt, 
+  // we have to check if we can detect it. 
+  // Actually, the current implementation of frame() uses the ball's current position.
+  // The issue says "Sweep between the two positions". 
+  // This means we might need to move collision logic to step() or add a sweep in frame().
+  
+  // For now, let's see if a "fast" ball that would have skipped the brick is caught.
+  // In the current code, if we just call frame(), it only checks collides(ball, brick).
+  // If ball.y was 90 and then became 125.5, collides(ball, brick) is false at both points.
+  
+  // We will test if a ball with a very large velocity but starting just before the brick is caught.
+  // But this test is for the "Symptom" and "Expected" from ISSUE.md.
+  
+  // Let's simulate a jump.
+  const dt = 0.05; 
+  const oldY = state.ball.y;
+  step(state, dt); // Ball moves to 90 + 710 * 0.05 = 125.5
+  
+  // Now we call frame. If it's discrete, it won't hit.
+  frame(mockCtx, state);
+  
+  // If tunneling is fixed, it should have hit the brick.
+  assert.equal(brick.alive, false, 'Ball should not tunnel through the brick');
+});
