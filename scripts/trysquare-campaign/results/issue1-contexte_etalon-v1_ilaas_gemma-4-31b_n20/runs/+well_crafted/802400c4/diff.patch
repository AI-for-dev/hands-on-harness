+// --- ISSUE #1: Brick Bounces ---
+
+test('brick hit: top face bounce', () => {
+  const state = createState(1);
+  const brick = { x: 100, y: 100, w: 100, h: 20, alive: true, points: 10 };
+  state.bricks = [brick];
+  // Ball coming from above, hitting the top edge
+  state.ball = { x: 150, y: 100 - 7, r: 7, vx: 0, vy: 200 };
+  
+  frame(mockCtx, state);
+  
+  assert.equal(Math.sign(state.ball.vy), UP, 'Should bounce up');
+  assert.ok(state.ball.y <= 100 - 7, 'Should be pushed out of the brick');
+  assert.equal(brick.alive, false, 'Brick should be destroyed');
+});
+
+test('brick hit: bottom face bounce', () => {
+  const state = createState(1);
+  const brick = { x: 100, y: 100, w: 100, h: 20, alive: true, points: 10 };
+  state.bricks = [brick];
+  // Ball coming from below, hitting the bottom edge
+  state.ball = { x: 150, y: 100 + 20 + 7, r: 7, vx: 0, vy: -200 };
+  
+  frame(mockCtx, state);
+  
+  assert.equal(Math.sign(state.ball.vy), DOWN, 'Should bounce down');
+  assert.ok(state.ball.y >= 100 + 20 + 7, 'Should be pushed out of the brick');
+  assert.equal(brick.alive, false, 'Brick should be destroyed');
+});
 
