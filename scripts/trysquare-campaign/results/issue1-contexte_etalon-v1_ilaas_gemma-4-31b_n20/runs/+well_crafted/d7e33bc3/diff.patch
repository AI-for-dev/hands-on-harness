+// Handles brick collisions for the current frame.
+// Implements per-face bounce, sticky bounce prevention, and tunneling (sweep) detection.
+function resolveBrickCollisions(state, oldBall) {
+  const { ball, bricks } = state;
+
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+
+    // Tunnelling check (sweep): if ball was above and is now below (or vice versa)
+    // while being within the brick's X bounds, it might have jumped through.
+    const wasAbove = oldBall && oldBall.y + oldBall.r <= brick.y;
+    const isBelow = ball.y - ball.r >= brick.y + brick.h;
+    const wasBelow = oldBall && oldBall.y - oldBall.r >= brick.y + brick.h;
+    const isAbove = ball.y + ball.r <= brick.y;
+
+    const tunneledY = (wasAbove && isBelow) || (wasBelow && isAbove);
+    const withinX = ball.x + ball.r > brick.x && ball.x - ball.r < brick.x + brick.w;
+
+    if (collides(ball, brick) || (tunneledY && withinX)) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+
+      if (!tunneledY) {
+        // Per-face bounce logic
+        const dx1 = (ball.x + ball.r) - brick.x; // distance to left
+        const dx2 = (brick.x + brick.w) - (ball.x - ball.r); // distance to right
+        const dy1 = (ball.y + ball.r) - brick.y; // distance to top
+        const dy2 = (brick.y + brick.h) - (ball.y - ball.r); // distance to bottom
+
+        const minX = Math.min(dx1, dx2);
+        const minY = Math.min(dy1, dy2);
+
+        if (minX < minY) {
+          // Side hit
+          if (dx1 < dx2) {
+            // Ball was mostly to the left, so it hit the left face
+            if (ball.vx > 0) ball.vx = -Math.abs(ball.vx);
+          } else {
+            // Ball was mostly to the right, so it hit the right face
+            if (ball.vx < 0) ball.vx = Math.abs(ball.vx);
+          }
+          // Push out
+          if (dx1 < dx2) ball.x = brick.x - ball.r;
+          else ball.x = brick.x + brick.w + ball.r;
+        } else {
+          // Top/Bottom hit
+          if (dy1 < dy2) {
+            // Ball was mostly above, so it hit the top face
+            if (ball.vy > 0) ball.vy = -Math.abs(ball.vy);
+          } else {
+            // Ball was mostly below, so it hit the bottom face
+            if (ball.vy < 0) ball.vy = Math.abs(ball.vy);
+          }
+          // Push out
+          if (dy1 < dy2) ball.y = brick.y - ball.r;
+          else ball.y = brick.y + brick.h + ball.r;
+        }
+      }
+    }
+  }
+}
