+/**
+ * Resolves collision between a ball and a brick.
+ * Handles bounce logic: axis flip and push-out to prevent sticky collisions.
+ * Returns true if a collision occurred.
+ */
+export function resolveBrickCollision(ball, brick) {
+  if (!collides(ball, brick)) return false;
+
+  // Penetration depths
+  const dx1 = (ball.x + ball.r) - brick.x; // Right side of ball vs left of brick
+  const dx2 = (brick.x + brick.w) - (ball.x - ball.r); // Right side of brick vs left of ball
+  const dy1 = (ball.y + ball.r) - brick.y; // Bottom side of ball vs top of brick
+  const dy2 = (brick.y + brick.h) - (ball.y - ball.r); // Bottom side of brick vs top of ball
+
+  const overlapX = Math.min(dx1, dx2);
+  const overlapY = Math.min(dy1, dy2);
+
+  if (overlapX < overlapY) {
+    // Side hit: flip vx
+    ball.vx = -ball.vx;
+    // Push out to prevent sticking
+    if (dx1 < dx2) ball.x -= overlapX; else ball.x += overlapX;
+  } else if (overlapY < overlapX) {
+    // Top/Bottom hit: flip vy
+    ball.vy = -ball.vy;
+    // Push out to prevent sticking
+    if (dy1 < dy2) ball.y -= overlapY; else ball.y += overlapY;
+  } else {
+    // Corner hit: flip both
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    if (dx1 < dx2) ball.x -= overlapX; else ball.x += overlapX;
+    if (dy1 < dy2) ball.y -= overlapY; else ball.y += overlapY;
+  }
+
+  return true;
+}
