+// Handles collision between the ball and a brick: flips velocity and repositions the ball.
+function resolveBrickCollision(ball, brick) {
+  const overlapX = Math.min(
+    (ball.x + ball.r) - brick.x,
+    (brick.x + brick.w) - (ball.x - ball.r)
+  );
+  const overlapY = Math.min(
+    (ball.y + ball.r) - brick.y,
+    (brick.y + brick.h) - (ball.y - ball.r)
+  );
+
+  if (overlapX < overlapY) {
+    // Side hit
+    ball.vx *= -1;
+    if (ball.x < brick.x + brick.w / 2) {
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+    }
+  } else if (overlapY < overlapX) {
+    // Top/Bottom hit
+    ball.vy *= -1;
+    if (ball.y + ball.r < brick.y + brick.h / 2) {
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  } else {
+    // Corner hit (equal penetration)
+    ball.vx *= -1;
+    ball.vy *= -1;
+    // Repositioning for corner: push out to the nearest corner point
+    if (ball.x < brick.x + brick.w / 2) {
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+    }
+    if (ball.y < brick.y + brick.h / 2) {
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  }
+}
