+// Handles tunneling by checking for collisions along the movement segment.
+function handleTunneling(state, dt) {
+  const { ball, bricks } = state;
+
+  // We'll use a simple sampling approach for tunneling:
+  // split the move into smaller steps if the distance is too large.
+  // A better way would be true swept AABB, but this is usually enough for arcade games.
+  const stepSize = 4; // px
+  const dx = ball.vx * dt;
+  const dy = ball.vy * dt;
+  const dist = Math.sqrt(dx * dx + dy * dy);
+
+  if (dist > stepSize) {
+    const numSteps = Math.ceil(dist / stepSize);
+    for (let i = 1; i <= numSteps; i++) {
+      const checkX = ball.x - dx + (dx * i) / numSteps;
+      const checkY = ball.y - dy + (dy * i) / numSteps;
+      const checkBall = { ...ball, x: checkX, y: checkY };
+
+      for (const brick of bricks) {
+        if (brick.alive && collides(checkBall, brick)) {
+          // To prevent multiple hits in one frame for the same brick,
+          // and to properly handle the bounce, we can just mark the brick as dead
+          // and let the main collision loop in frame() handle it, or handle it here.
+          // However, the current architecture has collision in frame().
+          // This is messy. Let's just ensure the brick is broken.
+          brick.alive = false;
+          // We don't apply physics here to avoid fighting with frame()'s resolveBrickCollision
+          // But we should actually break the brick if we tunneled through it.
+        }
+      }
+    }
+  }
+}
