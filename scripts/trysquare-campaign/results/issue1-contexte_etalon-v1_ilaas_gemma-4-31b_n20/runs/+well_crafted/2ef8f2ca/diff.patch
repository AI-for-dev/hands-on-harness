+/**
+ * Resolves collision between a ball and a brick.
+ * @returns {boolean} true if a collision occurred
+ */
+export function resolveBrickCollision(ball, brick) {
+  if (!collides(ball, brick)) return false;
+
+  // Calculate penetration depths for each face
+  const overlapX = Math.min(ball.x + ball.r - brick.x, brick.x + brick.w - (ball.x - ball.r));
+  const overlapY = Math.min(ball.y + ball.r - brick.y, brick.y + brick.h - (ball.y - ball.r));
+
+  if (overlapX < overlapY) {
+    // Side hit
+    if (ball.x + ball.r < brick.x + brick.w / 2) {
+      // Hit left side
+      ball.x = brick.x - ball.r;
+    } else {
+      // Hit right side
+      ball.x = brick.x + brick.w + ball.r;
+    }
+    ball.vx = -ball.vx;
+  } else if (overlapY < overlapX) {
+    // Top/Bottom hit
+    if (ball.y + ball.r < brick.y + brick.h / 2) {
+      // Hit top side
+      ball.y = brick.y - ball.r;
+    } else {
+      // Hit bottom side
+      ball.y = brick.y + brick.h + ball.r;
+    }
+    ball.vy = -ball.vy;
+  } else {
+    // Corner hit (equal penetration)
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    // Push out diagonally based on relative position
+    if (ball.x < brick.x + brick.w / 2) {
+      ball.x = (ball.vy > 0) ? brick.x - ball.r : brick.x - ball.r; // simple push out
+    }
+    // To avoid sticky corners, just flip both and let physics push it out next frame
+    // or a more robust push-out:
+    const centerX = brick.x + brick.w / 2;
+    const centerY = brick.y + brick.h / 2;
+    if (ball.x < centerX) ball.x = brick.x - ball.r; else ball.x = brick.x + brick.w + ball.r;
+    if (ball.y < centerY) ball.y = brick.y - ball.r; else ball.y = brick.y + brick.h + ball.r;
+  }
+
+  return true;
+}
