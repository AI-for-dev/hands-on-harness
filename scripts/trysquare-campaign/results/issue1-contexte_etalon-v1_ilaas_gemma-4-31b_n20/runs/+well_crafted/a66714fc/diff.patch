+// Handles the interaction between the ball and a brick.
+// Returns true if a collision occurred and was resolved.
+export function resolveBrickCollision(state, brick) {
+  const { ball } = state;
+
+  if (!collides(ball, brick)) return false;
+
+  // 1. Per-face collision resolution (AABB vs Circle approximation)
+  // Calculate overlaps on each side
+  const overlapLeft = (ball.x + ball.r) - brick.x;
+  const overlapRight = (brick.x + brick.w) - (ball.x - ball.r);
+  const overlapTop = (ball.y + ball.r) - brick.y;
+  const overlapBottom = (brick.y + brick.h) - (ball.y - ball.r);
+
+  const minX = Math.min(overlapLeft, overlapRight);
+  const minY = Math.min(overlapTop, overlapBottom);
+
+  if (minX < minY) {
+    // Horizontal hit
+    ball.vx *= -1;
+    if (overlapLeft < overlapRight) ball.x -= overlapLeft;
+    else ball.x += overlapRight;
+  } else if (minY < minX) {
+    // Vertical hit
+    ball.vy *= -1;
+    if (overlapTop < overlapBottom) ball.y -= overlapTop;
+    else ball.y += overlapBottom;
+  } else {
+    // Corner hit (equal overlap)
+    ball.vx *= -1;
+    ball.vy *= -1;
+    if (overlapLeft < overlapRight && overlapTop < overlapBottom) {
+      ball.x -= overlapLeft;
+      ball.y -= overlapTop;
+    } else if (overlapLeft < overlapRight) {
+      ball.x -= overlapLeft;
+      ball.y += overlapBottom;
+    } else if (overlapTop < overlapBottom) {
+      ball.x += overlapRight;
+      ball.y -= overlapTop;
+    } else {
+      ball.x += overlapRight;
+      ball.y += overlapBottom;
+    }
+  }
+
+  brick.alive = false;
+  state.combo += 1;
+  state.score += scoreForBrick(brick, state.combo);
+  return true;
+}
