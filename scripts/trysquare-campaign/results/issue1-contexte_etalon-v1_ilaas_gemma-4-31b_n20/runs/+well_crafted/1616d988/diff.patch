+test('brick bounce: top hit => flip vy', () => {
+  const state = createState(1);
+  const brick = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  state.bricks = [brick];
+  state.ball = { x: 136, y: 100 - 5, r: 7, vx: 0, vy: 200 };
+
+  brickHit(state, state.bricks);
+
+  assert.equal(state.ball.vy, -200, 'vy should flip to UP');
+  assert.equal(state.ball.y, 100 - 7, 'ball should be pushed back to the top');
+});
+
