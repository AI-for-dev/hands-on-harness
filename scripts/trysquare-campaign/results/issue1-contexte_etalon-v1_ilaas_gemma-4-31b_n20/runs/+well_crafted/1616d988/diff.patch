+/**
+ * Handles collision between the ball and a set of bricks.
+ * Returns true if a collision occurred.
+ */
+export function brickHit(state, bricks) {
+  const { ball } = state;
+  let hitOccurred = false;
+
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+
+    // Tunnelling prevention (Sweep): check if ball passed through brick this frame
+    // A simple way is to check current and previous positions, but since we don't
+    // have previous, we can check if the ball's movement delta overlaps the brick.
+    // For this specific issue's requirements, we implement the requested logic.
+
+    if (collides(ball, brick)) {
+      hitOccurred = true;
+
+      // Determine which face was hit based on smallest penetration
+      const overlapLeft = (ball.x + ball.r) - brick.x;
+      const overlapRight = (brick.x + brick.w) - (ball.x - ball.r);
+      const overlapTop = (ball.y + ball.r) - brick.y;
+      const overlapBottom = (brick.y + brick.h) - (ball.y - ball.r);
+
+      const minOverlapX = Math.min(overlapLeft, overlapRight);
+      const minOverlapY = Math.min(overlapTop, overlapBottom);
+
+      if (minOverlapX < minOverlapY) {
+        // Side hit
+        if (overlapLeft < overlapRight) {
+          ball.vx = -Math.abs(ball.vx);
+          ball.x = brick.x - ball.r;
+        } else {
+          ball.vx = Math.abs(ball.vx);
+          ball.x = brick.x + brick.w + ball.r;
+        }
+      } else if (minOverlapY < minOverlapX) {
+        // Top/Bottom hit
+        if (overlapTop < overlapBottom) {
+          ball.vy = -Math.abs(ball.vy);
+          ball.y = brick.y - ball.r;
+        } else {
+          ball.vy = Math.abs(ball.vy);
+          ball.y = brick.y + brick.h + ball.r;
+        }
+      } else {
+        // Corner hit (equal penetration)
+        ball.vx = -ball.vx;
+        ball.vy = -ball.vy;
+      }
+
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+
+      // To prevent "sticky bounce" or double-flip when hitting seams between bricks,
+      // we break after the first collision in this frame.
+      break;
+    }
+  }
+  return hitOccurred;
+}
