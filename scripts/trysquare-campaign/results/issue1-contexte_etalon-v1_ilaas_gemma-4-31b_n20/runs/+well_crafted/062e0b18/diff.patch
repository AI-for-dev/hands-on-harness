   for (const brick of state.bricks) {
     if (!brick.alive) continue;
 
-    if (collides(state.ball, brick)) {
+    // Sweep collision: check if the ball's path since last frame intersects the brick.
+    const prevX = state.ball.prevX ?? state.ball.x;
+    const prevY = state.ball.prevY ?? state.ball.y;
+    
+    const tunneled = (
+      (prevY + state.ball.r <= brick.y + brick.h && state.ball.y - state.ball.r >= brick.y) ||
+      (prevY - state.ball.r >= brick.y && state.ball.y + state.ball.r <= brick.y + brick.h)
+    ) && (
+      state.ball.x + state.ball.r >= brick.x &&
+      state.ball.x - state.ball.r <= brick.x + brick.w
+    );
+
+    if (collides(state.ball, brick) || tunneled) {
+      // Collision resolution
+      const overlapX = Math.min(state.ball.x + state.ball.r - brick.x, brick.x + brick.w - (state.ball.x - state.ball.r));
+      const overlapY = Math.min(state.ball.y + state.ball.r - brick.y, brick.y + brick.h - (state.ball.y - state.ball.r));
+
+      let hitFace = '';
+      if (overlapX < overlapY) {
+        hitFace = state.ball.vx > 0 ? 'left' : 'right';
+        state.ball.vx = -state.ball.vx;
+      } else if (overlapY < overlapX) {
+        hitFace = state.ball.vy > 0 ? 'top' : 'bottom';
+        state.ball.vy = -state.ball.vy;
+      } else {
+        // Corner
+        state.ball.vx = -state.ball.vx;
+        state.ball.vy = -state.ball.vy;
+      }
+
+      // Push out
+      if (hitFace === 'left') state.ball.x = brick.x - state.ball.r;
+      else if (hitFace === 'right') state.ball.x = brick.x + brick.w + state.ball.r;
+      else if (hitFace === 'top') state.ball.y = brick.y - state.ball.r;
+      else if (hitFace === 'bottom') state.ball.y = brick.y + brick.h + state.ball.r;
+      else if (hitFace === '') {
+        // Corner push out: nudge the ball slightly based on velocity
+        if (state.ball.vx > 0) state.ball.x = brick.x - state.ball.r;
+        else state.ball.x = brick.x + brick.w + state.ball.r;
+      }
+
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
     }
 
     ctx.fillStyle = brickColor(brick.row);
