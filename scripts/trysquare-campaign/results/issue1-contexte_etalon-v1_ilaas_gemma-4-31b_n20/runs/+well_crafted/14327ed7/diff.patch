+/**
+ * Resolves collision between ball and brick.
+ * Implements the physics required by ISSUE.md #1.
+ */
+export function resolveBrickCollision(ball, brick) {
+  // 1. Calculate overlap on each axis
+  const overlapX = Math.min(
+    (ball.x + ball.r) - brick.x,      // right edge of ball - left edge of brick
+    (brick.x + brick.w) - (ball.x - ball.r) // right edge of brick - left edge of ball
+  );
+  const overlapY = Math.min(
+    (ball.y + ball.r) - brick.y,      // bottom edge of ball - top edge of brick
+    (brick.y + brick.h) - (ball.y - ball.r) // bottom edge of brick - top edge of ball
+  );
+
+  // 2. Determine which face was hit (smaller penetration = hit face)
+  if (overlapX < overlapY) {
+    // Side hit
+    ball.vx = -ball.vx;
+    // Push out
+    if (ball.x + ball.r <= brick.x + brick.w / 2) {
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+    }
+  } else if (overlapY < overlapX) {
+    // Top/Bottom hit
+    ball.vy = -ball.vy;
+    // Push out
+    if (ball.y + ball.r <= brick.y + brick.h / 2) {
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  } else {
+    // Corner hit (equal penetration)
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    // Push out diagonally (approximate)
+    const dx = ball.x - (brick.x + brick.w / 2);
+    const dy = ball.y - (brick.y + brick.h / 2);
+    ball.x += (dx > 0 ? ball.r : -ball.r);
+    ball.y += (dy > 0 ? ball.r : -ball.r);
+  }
+}
