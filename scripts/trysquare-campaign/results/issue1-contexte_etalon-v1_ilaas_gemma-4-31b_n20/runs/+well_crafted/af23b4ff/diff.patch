 // --- Collision (tested primitive) ------------------------------------------

+// Resolves a collision between the ball and a brick.
+// Handles bouncing and repositioning to prevent "sticky" collisions.
+export function resolveBrickCollision(ball, brick) {
+  if (!collides(ball, brick)) return false;
+
+  // Calculate overlap on each axis
+  const ballLeft = ball.x - ball.r;
+  const ballRight = ball.x + ball.r;
+  const ballTop = ball.y - ball.r;
+  const ballBottom = ball.y + ball.r;
+
+  const brickLeft = brick.x;
+  const brickRight = brick.x + brick.w;
+  const brickTop = brick.y;
+  const brickBottom = brick.y + brick.h;
+
+  const overlapX = Math.min(ballRight - brickLeft, brickRight - ballLeft);
+  const overlapY = Math.min(ballBottom - brickTop, brickBottom - ballTop);
+
+  if (overlapX < overlapY) {
+    // Hit side face
+    ball.vx = -ball.vx;
+    if (ball.x < brick.x + brick.w / 2) {
+      ball.x = brickLeft - ball.r;
+    } else {
+      ball.x = brickRight + ball.r;
+    }
+  } else if (overlapY < overlapX) {
+    // Hit top/bottom face
+    ball.vy = -ball.vy;
+    if (ball.y < brick.y + brick.h / 2) {
+      ball.y = brickTop - ball.r;
+    } else {
+      ball.y = brickBottom + ball.r;
+    }
+  } else {
+    // Corner hit (diagonal)
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    // Simple repositioning to avoid getting stuck
+    if (ball.x < brick.x + brick.w / 2) ball.x = brickLeft - ball.r;
+    else ball.x = brickRight + ball.r;
+    if (ball.y < brick.y + brick.h / 2) ball.y = brickTop - ball.r;
+    else ball.y = brickBottom + ball.r;
+  }
+
+  return true;
+}
+
 // True if the ball (circle approximated by its box) overlaps the brick.
 // Simple AABB test: it only says WHETHER the ball and the brick overlap, not
 // WHICH face was hit. The missing bounce in frame() is what lets the ball plow
 // straight through bricks (see #1).
 export function collides(ball, brick) {
+
   return (
     ball.x + ball.r > brick.x &&
     ball.x - ball.r < brick.x + brick.w &&
@@ -219,15 +269,10 @@ export function frame(ctx, state) {
   for (const brick of state.bricks) {
     if (!brick.alive) continue;

-    if (collides(state.ball, brick)) {
+    if (resolveBrickCollision(state.ball, brick)) {
