+test('brick bounce: top face hit flips vy', () => {
+  const ball = { x: 100, y: 85, r: 7, vx: 100, vy: -100 }; // moving UP
+  const brick = { x: 80, y: 90, w: 40, h: 20, alive: true };
+
+  const hit = resolveBrickCollision(ball, brick);
+
+  assert.equal(hit, true);
+  assert.equal(ball.vy, 100, 'vy should be flipped to positive (DOWN)');
+  assert.equal(ball.vx, 100, 'vx should remain unchanged');
+  assert.equal(ball.y, 90 - 7, 'ball should be pushed to the top edge of the brick');
+});
+
+test('brick bounce: left face hit flips vx', () => {
+  const ball = { x: 75, y: 100, r: 7, vx: 100, vy: 0 }; // moving RIGHT
