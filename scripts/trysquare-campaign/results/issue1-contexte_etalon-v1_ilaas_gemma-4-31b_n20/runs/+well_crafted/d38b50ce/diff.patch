+/**
+ * Resolves collision between ball and brick.
+ * Returns true if a collision occurred and was handled.
+ */
+export function resolveBrickCollision(ball, brick) {
+  if (!collides(ball, brick)) return false;
+
+  // Calculate overlap on each axis
+  const overlapX = Math.min(ball.x + ball.r - brick.x, brick.x + brick.w - (ball.x - ball.r));
+  const overlapY = Math.min(ball.y + ball.r - brick.y, brick.y + brick.h - (ball.y - ball.r));
+
+  if (overlapX < overlapY) {
+    // Side hit
+    ball.vx = -ball.vx;
+    if (ball.x < brick.x + brick.w / 2) {
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+    }
+  } else if (overlapY < overlapX) {
+    // Top/Bottom hit
+    ball.vy = -ball.vy;
+    if (ball.y < brick.y + brick.h / 2) {
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  } else {
+    // Corner hit (exact overlap)
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    // Push out diagonally (approximate)
+    const dx = ball.x - (brick.x + brick.w / 2);
+    const dy = ball.y - (brick.y + brick.h / 2);
+    ball.x += Math.sign(dx) * (brick.w / 2 + ball.r);
+    ball.y += Math.sign(dy) * (brick.h / 2 + ball.r);
+  }
+
+  return true;
+}
