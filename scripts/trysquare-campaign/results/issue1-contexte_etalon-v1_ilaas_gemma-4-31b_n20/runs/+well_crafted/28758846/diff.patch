+/**
+ * Resolves collision between a ball and a brick.
+ * Updates ball velocity and position to prevent sticking.
+ * Returns true if a collision occurred.
+ */
+export function resolveBrickCollision(ball, brick) {
+  if (!collides(ball, brick)) return false;
+
+  // Find penetration on each axis
+  const overlapX = Math.min(
+    (ball.x + ball.r) - brick.x, // Right edge of ball vs Left edge of brick
+    (brick.x + brick.w) - (ball.x - ball.r) // Right edge of brick vs Left edge of ball
+  );
+  const overlapY = Math.min(
+    (ball.y + ball.r) - brick.y, // Bottom edge of ball vs Top edge of brick
+    (brick.y + brick.h) - (ball.y - ball.r) // Bottom edge of brick vs Top edge of ball
+  );
+
+  if (overlapX < overlapY) {
+    // Hit side face
+    ball.vx = -ball.vx;
+    // Push out
+    if (ball.x < brick.x + brick.w / 2) {
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.x = brick.x + brick.w + ball.r;
+    }
+  } else if (overlapY < overlapX) {
+    // Hit top/bottom face
+    ball.vy = -ball.vy;
+    // Push out
+    if (ball.y < brick.y + brick.h / 2) {
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  } else {
+    // Corner hit (equal penetration)
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    // Push out diagonally (simplified)
+    if (ball.x < brick.x + brick.w / 2) {
+      ball.x = ball.x < brick.x ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    }
+    if (ball.y < brick.y + brick.h / 2) {
+      ball.y = ball.y < brick.y ? brick.y - ball.r : brick.y + brick.h + ball.r;
+    }
+  }
+
+  return true;
+}
