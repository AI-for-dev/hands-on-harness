+function resolveBrickCollision(state, brick, prevBall) {
+  const { ball } = state;
+
+  let hit = collides(ball, brick);
+  if (!hit && prevBall) {
+    const minX = Math.min(prevBall.x, ball.x) - ball.r;
+    const maxX = Math.max(prevBall.x, ball.x) + ball.r;
+    const minY = Math.min(prevBall.y, ball.y) - ball.r;
+    const maxY = Math.max(prevBall.y, ball.y) + ball.r;
+
+    if (maxX > brick.x && minX < brick.x + brick.w && maxY > brick.y && minY < brick.y + brick.h) {
+      hit = true;
+    }
+  }
+
+  if (!hit) return false;
+
+  const overlapLeft = (ball.x + ball.r) - brick.x;
+  const overlapRight = (brick.x + brick.w) - (ball.x - ball.r);
+  const overlapTop = (ball.y + ball.r) - brick.y;
+  const overlapBottom = (brick.y + brick.h) - (ball.y - ball.r);
+
+  const minOverlapX = Math.min(overlapLeft, overlapRight);
+  const minOverlapY = Math.min(overlapTop, overlapBottom);
+
+  if (minOverlapX < minOverlapY) {
+    ball.vx = -Math.sign(ball.vx) * Math.abs(ball.vx);
+    if (overlapLeft < overlapRight) ball.x = brick.x - ball.r;
+    else ball.x = brick.x + brick.w + ball.r;
+  } else if (minOverlapY < minOverlapX) {
+    ball.vy = -Math.sign(ball.vy) * Math.abs(ball.vy);
+    if (overlapTop < overlapBottom) ball.y = brick.y - ball.r;
+    else ball.y = brick.y + brick.h + ball.r;
+  } else {
+    // Corner hit (equal overlaps)
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    if (overlapLeft < overlapRight) ball.x = brick.x - ball.r; else ball.x = brick.x + brick.w + ball.r;
+    if (overlapTop < overlapBottom) ball.y = brick.y - ball.r; else ball.y = brick.y + brick.h + ball.r;
+  }
+
+  return true;
+}
