+test('step: bounce off top of brick (flip vy)', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  brick.x = 100; brick.y = 100; brick.w = 50; brick.h = 20;
+  // Ball moving UP, hits bottom of brick
+  state.ball = { x: 125, y: 122, r: 7, vx: 0, vy: -100 };
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy > 0, 'vy should flip to DOWN');
+  assert.ok(brick.alive === false, 'brick should be destroyed');
+});
+
+test('step: bounce off side of brick (flip vx)', () => {
+  const state = createState(1);
