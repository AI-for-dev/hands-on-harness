+function swept(x1, y1, x2, y2, r, brick) {
+  const bX1 = brick.x - r;
+  const bX2 = brick.x + brick.w + r;
+  const bY1 = brick.y - r;
+  const bY2 = brick.y + brick.h + r;
+
+  let tMin = -Infinity;
+  let tMax = Infinity;
+
+  const dx = x2 - x1;
+  const dy = y2 - y1;
+
+  if (Math.abs(dx) < 1e-7) {
+    if (x1 < bX1 || x1 > bX2) return false;
+  } else {
+    let t1 = (bX1 - x1) / dx;
+    let t2 = (bX2 - x1) / dx;
+    tMin = Math.max(tMin, Math.min(t1, t2));
+    tMax = Math.min(tMax, Math.max(t1, t2));
+  }
+
+  if (Math.abs(dy) < 1e-7) {
+    if (y1 < bY1 || y1 > bY2) return false;
+  } else {
+    let t1 = (bY1 - y1) / dy;
+    let t2 = (bY2 - y1) / dy;
+    tMin = Math.max(tMin, Math.min(t1, t2));
+    tMax = Math.min(tMax, Math.max(t1, t2));
+  }
+
+  return tMax >= tMin && tMax >= 0 && tMin <= 1;
+}
+
+function resolveBrickCollision(ball, brick) {
+  const dLeft = ball.x + ball.r - brick.x;
+  const dRight = brick.x + brick.w - (ball.x - ball.r);
+  const dTop = ball.y + ball.r - brick.y;
+  const dBottom = brick.y + brick.h - (ball.y - ball.r);
+
+  const minX = Math.min(dLeft, dRight);
+  const minY = Math.min(dTop, dBottom);
+
+  if (minX < minY) {
+    if (dLeft < dRight) {
+      ball.vx = -Math.abs(ball.vx);
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.vx = Math.abs(ball.vx);
+      ball.x = brick.x + brick.w + ball.r;
+    }
+  } else if (minY < minX) {
+    if (dTop < dBottom) {
+      ball.vy = -Math.abs(ball.vy);
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.vy = Math.abs(ball.vy);
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  } else {
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    if (dLeft < dRight) ball.x = brick.x - ball.r; else ball.x = brick.x + brick.w + ball.r;
+    if (dTop < dBottom) ball.y = brick.y - ball.r; else ball.y = brick.y + brick.h + ball.r;
+  }
+}
