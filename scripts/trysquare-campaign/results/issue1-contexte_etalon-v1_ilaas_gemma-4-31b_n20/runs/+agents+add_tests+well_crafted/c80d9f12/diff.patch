+// Checks if the line segment from (px, py) to (x, y) intersects the AABB [bx, by, bw, bh].
+function lineRectIntersect(px, py, x, y, bx, by, bw, bh) {
+  const left = bx;
+  const right = bx + bw;
+  const top = by;
+  const bottom = by + bh;
+
+  if (px >= left && px <= right && py >= top && py <= bottom) return true;
+  if (x >= left && x <= right && y >= top && y <= bottom) return true;
+
+  const dx = x - px;
+  const dy = y - py;
+
+  // Intersect with vertical edges
+  for (const edgeX of [left, right]) {
+    if (dx === 0) continue;
+    const t = (edgeX - px) / dx;
+    if (t >= 0 && t <= 1) {
+      const intersectY = py + t * dy;
+      if (intersectY >= top && intersectY <= bottom) return true;
+    }
+  }
+
+  // Intersect with horizontal edges
+  for (const edgeY of [top, bottom]) {
+    if (dy === 0) continue;
+    const t = (edgeY - py) / dy;
+    if (t >= 0 && t <= 1) {
+      const intersectX = px + t * dx;
+      if (intersectX >= left && intersectX <= right) return true;
+    }
+  }
+
+  return false;
+}
