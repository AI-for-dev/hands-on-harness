+    if (!hit && !bounced) {
+      // Tunnelling check: sweep between positions with an expanded brick box.
+      const { ball } = state;
+      if (lineRectIntersect(ball.prevX, ball.prevY, ball.x, ball.y, brick.x - ball.r, brick.y - ball.r, brick.w + 2 * ball.r, brick.h + 2 * ball.r)) {
+        hit = true;
+      }
+    }
+
+    if (hit && !bounced) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      const { ball } = state;
+      const penL = ball.x + ball.r - brick.x;
+      const penR = brick.x + brick.w - (ball.x - ball.r);
+      const penT = ball.y + ball.r - brick.y;
+      const penB = brick.y + brick.h - (ball.y - ball.r);
+
+      const minX = Math.min(penL, penR);
+      const minY = Math.min(penT, penB);
+
+      if (Math.abs(minX - minY) < 0.001) {
+        // Corner hit
+        ball.vx = -ball.vx;
+        ball.vy = -ball.vy;
+        // Push out: move ball to the nearest corner
+        ball.x = (ball.x < brick.x + brick.w / 2) ? brick.x - ball.r : brick.x + brick.w + ball.r;
+        ball.y = (ball.y < brick.y + brick.h / 2) ? brick.y - ball.r : brick.y + brick.h + ball.r;
+      } else if (minX < minY) {
