+  assert.ok(state.ball.y - state.ball.r >= brick.y + brick.h, 'should be pushed out to bottom');
+});
+
+test('brick collision: bounce off top face', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  brick.alive = true;
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y - 2, prevX: brick.x + brick.w / 2, prevY: brick.y - 2, r: 7, vx: 0, vy: 1 };
