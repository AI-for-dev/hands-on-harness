+// Continuous collision detection to prevent tunnelling.
+function sweptCollides(ball, brick) {
+  const x1 = ball.prevX ?? ball.x;
+  const y1 = ball.prevY ?? ball.y;
+  const x2 = ball.x;
+  const y2 = ball.y;
+  const r = ball.r;
+
+  const minX = brick.x - r;
+  const maxX = brick.x + brick.w + r;
+  const minY = brick.y - r;
+  const maxY = brick.y + brick.h + r;
+
+  let tmin = -Infinity, tmax = Infinity;
+
+  if (x1 !== x2) {
+    const t1 = (minX - x1) / (x2 - x1);
+    const t2 = (maxX - x1) / (x2 - x1);
+    tmin = Math.max(tmin, Math.min(t1, t2));
+    tmax = Math.min(tmax, Math.max(t1, t2));
+  } else if (x1 < minX || x1 > maxX) {
+    return null;
+  }
+
+  if (y1 !== y2) {
+    const t1 = (minY - y1) / (y2 - y1);
+    const t2 = (maxY - y1) / (y2 - y1);
+    tmin = Math.max(tmin, Math.min(t1, t2));
+    tmax = Math.min(tmax, Math.max(t1, t2));
+  } else if (y1 < minY || y1 > maxY) {
+    return null;
+  }
+
+  return (tmax >= tmin && tmax > 0 && tmin < 1) ? tmin : null;
+}
+
+// Resolves ball bounce off a brick and pushes ball out.
+function resolveBrickCollision(ball, brick) {
+  const dx1 = ball.x + ball.r - brick.x;
+  const dx2 = brick.x + brick.w - (ball.x - ball.r);
+  const dy1 = ball.y + ball.r - brick.y;
+  const dy2 = brick.y + brick.h - (ball.y - ball.r);
+
+  const penX = Math.min(dx1, dx2);
+  const penY = Math.min(dy1, dy2);
+
+  if (penX < penY) {
+    if (dx1 < dx2 && ball.vx > 0) {
+      ball.vx = -Math.abs(ball.vx);
+      ball.x = brick.x - ball.r;
+    } else if (dx2 < dx1 && ball.vx < 0) {
+      ball.vx = Math.abs(ball.vx);
+      ball.x = brick.x + brick.w + ball.r;
+    }
+  } else if (penY < penX) {
+    if (dy1 < dy2 && ball.vy > 0) {
+      ball.vy = -Math.abs(ball.vy);
+      ball.y = brick.y - ball.r;
+    } else if (dy2 < dy1 && ball.vy < 0) {
+      ball.vy = Math.abs(ball.vy);
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  } else {
+    // Corner hit: flip both if moving towards the brick
+    if ((dx1 < dx2 && ball.vx > 0) || (dx2 < dx1 && ball.vx < 0)) {
+      ball.vx = -ball.vx;
+    }
+    if ((dy1 < dy2 && ball.vy > 0) || (dy2 < dy1 && ball.vy < 0)) {
+      ball.vy = -ball.vy;
+    }
+    if (dx1 < dx2) ball.x = brick.x - ball.r; else ball.x = brick.x + brick.w + ball.r;
+    if (dy1 < dy2) ball.y = brick.y - ball.r; else ball.y = brick.y + brick.h + ball.r;
+  }
+}
