+  assert.ok(state.ball.y + state.ball.r <= brick.y, 'should be pushed out to top');
+});
+
+test('brick collision: bounce off left face', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  brick.alive = true;
+  state.ball = { x: brick.x - 2, y: brick.y + brick.h / 2, prevX: brick.x - 2, prevY: brick.y + brick.h / 2, r: 7, vx: 100, vy: 0 };
+  state.ball.x += 4;
