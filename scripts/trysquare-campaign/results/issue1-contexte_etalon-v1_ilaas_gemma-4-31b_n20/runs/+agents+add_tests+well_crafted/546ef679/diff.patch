+
+test('brick collision: bounce off bottom face', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  brick.alive = true;
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y + brick.h + 2, prevX: brick.x + brick.w / 2, prevY: brick.y + brick.h + 2, r: 7, vx: 0, vy: -1 };
