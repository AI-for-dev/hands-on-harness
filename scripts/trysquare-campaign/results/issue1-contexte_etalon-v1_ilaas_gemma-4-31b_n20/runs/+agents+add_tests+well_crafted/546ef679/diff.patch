+test('brick collision: tunnelling (high speed)', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  brick.alive = true;
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y + 30, prevX: brick.x + brick.w / 2, prevY: brick.y - 10, r: 7, vx: 0, vy: 700 };
