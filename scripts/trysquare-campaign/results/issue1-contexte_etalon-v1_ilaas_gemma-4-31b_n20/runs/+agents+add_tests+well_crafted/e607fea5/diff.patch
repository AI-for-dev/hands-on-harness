+  const r = ball.r;
+  const overlapL = (ball.x + r) - brick.x;
+  const overlapR = (brick.x + brick.w) - (ball.x - r);
+  const overlapT = (ball.y + r) - brick.y;
+  const overlapB = (brick.y + brick.h) - (ball.y - r);
