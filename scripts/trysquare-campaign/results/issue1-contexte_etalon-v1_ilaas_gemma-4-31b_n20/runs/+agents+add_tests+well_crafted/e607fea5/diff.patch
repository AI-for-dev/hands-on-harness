+  if (minOverlap === overlapL) nx = LEFT;
+  else if (minOverlap === overlapR) nx = RIGHT;
+  
+  if (minOverlap === overlapT) ny = UP;
+  else if (minOverlap === overlapB) ny = DOWN;
+
+  return { nx, ny };
