+function checkTunnelling(ball, brick) {
+  const r = ball.r;
+  const b = { x: brick.x - r, y: brick.y - r, w: brick.w + 2 * r, h: brick.h + 2 * r };
+  const dx = ball.x - ball.prevX;
+  const dy = ball.y - ball.prevY;
+  let tmin = -Infinity, tmax = Infinity;
+  const p = [-dx, dx, -dy, dy];
+  const q = [ball.prevX - b.x, b.x + b.w - ball.prevX, ball.prevY - b.y, b.y + b.h - ball.prevY];
+  for (let i = 0; i < 4; i++) {
+    if (p[i] === 0) {
+      if (q[i] < 0) return false;
+    } else {
+      const t = q[i] / p[i];
+      if (p[i] < 0) {
+        if (t > tmax) return false;
+        if (t > tmin) tmin = t;
+      } else {
+        if (t < tmin) return false;
+        if (t < tmax) tmax = t;
+      }
+    }
+  }
+  return tmax >= 0 && tmin <= 1 && tmax >= tmin;
+}
