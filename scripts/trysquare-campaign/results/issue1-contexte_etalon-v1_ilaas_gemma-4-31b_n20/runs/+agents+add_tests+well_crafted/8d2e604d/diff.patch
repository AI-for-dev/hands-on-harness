@@ -216,20 +243,86 @@ export function frame(ctx, state) {
   ctx.fillRect(0, 0, WIDTH, HEIGHT);

   // Bricks: collision + bounce + score + drawing, all in one place.
+  let firstBrick = null;
+  let minT = Infinity;
+
   for (const brick of state.bricks) {
     if (!brick.alive) continue;
+    const isColliding = collides(state.ball, brick);
+    const isTunnelling = checkTunnelling(state.ball, brick);
+
+    if (isColliding || isTunnelling) {
+      let tEntry = 0;
+      if (!isColliding) {
+        const r = state.ball.r;
+        const b = { x: brick.x - r, y: brick.y - r, w: brick.w + 2 * r, h: brick.h + 2 * r };
+        const dx = state.ball.x - state.ball.prevX;
+        const dy = state.ball.y - state.ball.prevY;
+        let tmin = -Infinity, tmax = Infinity;
+        const p = [-dx, dx, -dy, dy];
+        const q = [state.ball.prevX - b.x, b.x + b.w - state.ball.prevX, state.ball.prevY - b.y, b.y + b.h - state.ball.prevY];
+        for (let i = 0; i < 4; i++) {
+          if (p[i] === 0) {
+            if (q[i] < 0) { tmin = Infinity; break; }
+          } else {
+            const t = q[i] / p[i];
+            if (p[i] < 0) { if (t > tmin) tmin = t; } else { if (t < tmax) tmax = t; }
+          }
+        }
+        tEntry = tmin;
+      }
+      if (tEntry < minT) {
+        minT = tEntry;
+        firstBrick = brick;
+      }
+    }
+  }

-    if (collides(state.ball, brick)) {
-      brick.alive = false;
-      state.combo += 1;
-      state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+  if (firstBrick) {
+    const brick = firstBrick;
+    brick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(brick, state.combo);
+
+    const ball = state.ball;
+    const penLeft = ball.x + ball.r - brick.x;
+    const penRight = brick.x + brick.w - (ball.x - ball.r);
+    const penTop = ball.y + ball.r - brick.y;
+    const penBottom = brick.y + brick.h - (ball.y - ball.r);
+
+    const minPen = Math.min(
+      Math.max(0, penLeft),
+      Math.max(0, penRight),
+      Math.max(0, penTop),
+      Math.max(0, penBottom)
+    );
+
+    if (minPen > 0) {
+      const hits = [];
+      if (penLeft === minPen && ball.vx > 0) hits.push({ axis: 'x', flip: LEFT, pos: brick.x - ball.r });
+      if (penRight === minPen && ball.vx < 0) hits.push({ axis: 'x', flip: RIGHT, pos: brick.x + brick.w + ball.r });
+      if (penTop === minPen && ball.vy > 0) hits.push({ axis: 'y', flip: UP, pos: brick.y - ball.r });
+      if (penBottom === minPen && ball.vy < 0) hits.push({ axis: 'y', flip: DOWN, pos: brick.y + brick.h + ball.r });
+
+      for (const hit of hits) {
+        if (hit.axis === 'x') ball.vx = hit.flip * Math.abs(ball.vx);
+        if (hit.axis === 'y') ball.vy = hit.flip * Math.abs(ball.vy);
+        if (hit.axis === 'x') ball.x = hit.pos;
+        if (hit.axis === 'y') ball.y = hit.pos;
+      }
+    } else {
+      if (Math.abs(ball.vx) > Math.abs(ball.vy)) {
+        ball.vx = ball.vx < 0 ? RIGHT : LEFT;
+        ball.x = ball.vx === RIGHT ? brick.x + brick.w + ball.r : brick.x - ball.r;
+      } else {
+        ball.vy = ball.vy < 0 ? DOWN : UP;
+        ball.y = ball.vy === DOWN ? brick.y + brick.h + ball.r : brick.y - ball.r;
+      }
     }
+  }

+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
     ctx.fillStyle = brickColor(brick.row);
     ctx.fillRect(brick.x, brick.y, brick.w, brick.h);
   }
