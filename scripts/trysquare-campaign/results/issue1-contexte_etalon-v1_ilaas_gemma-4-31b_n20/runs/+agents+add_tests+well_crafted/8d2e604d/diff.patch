+// --- Brick Bounce Tests (#1) --------------------------------------------
+
+test('brick: top hit flips vy (UP -> DOWN)', () => {
+  const state = createState(1);
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true };
+  state.bricks = [brick];
+  state.ball = { x: 125, y: 120, r: 7, vx: 0, vy: UP }; // ball is moving UP, bottom of brick at 120
+  // ball is already overlapping by 7px (y + r = 127, brick.y = 100, brick.y + h = 120)
+  // wait, if ball.y is 120 and ball.r is 7, then ball.y - r = 113, ball.y + r = 127.
+  // brick.y = 100, brick.h = 20, so brick.bottom = 120.
+  // the ball is overlapping the brick from below.
+  frame(mockCtx, state);
+  assert.equal(state.ball.vy, DOWN);
+  assert.equal(state.ball.vx, 0);
+  assert.ok(state.ball.y - state.ball.r >= brick.y + brick.h, 'ball should be pushed out');
+});
+
+test('brick: bottom hit flips vy (DOWN -> UP)', () => {
+  const state = createState(1);
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true };
+  state.bricks = [brick];
+  state.ball = { x: 125, y: 95, r: 7, vx: 0, vy: DOWN };
+  frame(mockCtx, state);
+  assert.equal(state.ball.vy, UP);
+  assert.equal(state.ball.vx, 0);
+  assert.ok(state.ball.y + state.ball.r <= brick.y, 'ball should be pushed out');
+});
+
+test('brick: left hit flips vx (LEFT -> RIGHT)', () => {
+  const state = createState(1);
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true };
+  state.bricks = [brick];
+  state.ball = { x: 107, y: 110, r: 7, vx: LEFT, vy: 0 }; // Ball moving left, right edge of brick at 150
+  // wait, x=107, r=7. ball.left = 100. brick.x = 100.
+  // if vx is LEFT, it's hitting the left side of the brick? No, if ball.x is 107 and brick.x is 100, it's on the right side of the brick moving left.
+  // brick.x + brick.w = 150.
+  state.ball = { x: 157, y: 110, r: 7, vx: LEFT, vy: 0 };
+  frame(mockCtx, state);
+  assert.equal(state.ball.vx, RIGHT);
+  assert.equal(state.ball.vy, 0);
+  assert.ok(state.ball.x - state.ball.r >= brick.x + brick.w, 'ball should be pushed out');
+});
+
+test('brick: right hit flips vx (RIGHT -> LEFT)', () => {
+  const state = createState(1);
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true };
+  state.bricks = [brick];
+  state.ball = { x: 93, y: 110, r: 7, vx: RIGHT, vy: 0 };
+  frame(mockCtx, state);
+  assert.equal(state.ball.vx, LEFT);
+  assert.equal(state.ball.vy, 0);
+  assert.ok(state.ball.x + state.ball.r <= brick.x, 'ball should be pushed out');
+});
+
+test('brick: corner hit flips both vx and vy', () => {
+  const state = createState(1);
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true };
+  state.bricks = [brick];
+  // Hit top-left corner: ball moving DOWN-RIGHT, enters from top-left
+  state.ball = { x: 98, y: 98, r: 7, vx: RIGHT, vy: DOWN };
+  // Penetration:
+  // x: ball.x + r = 105, brick.x = 100. pen_x = 5.
+  // y: ball.y + r = 105, brick.y = 100. pen_y = 5.
+  // Equal penetration -> corner hit.
+  frame(mockCtx, state);
+  assert.equal(state.ball.vx, LEFT);
+  assert.equal(state.ball.vy, UP);
+});
+
+test('brick: tunnelling detection', () => {
+  const state = createState(1);
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true };
+  state.bricks = [brick];
+  // Ball is far above the brick, and moving very fast DOWN
+  state.ball = { x: 125, y: 50, r: 7, vx: 0, vy: 2000 };
+  // In a normal frame, it would jump from y=50 to y=50 + 2000 * 0.016 = 82 (approx)
+  // But let's assume the frame is longer or the speed is higher.
+  // The issue says at level 6, speed is 710 px/s. 50ms frame = 35.5 px.
+  // Brick H + diameter = 20 + 14 = 34.
+  // So it can jump over.
+
+  // Since frame() doesn't take dt, it only checks collides(state.ball, brick).
+  // Wait, frame() doesn't move the ball, step() does.
+  // The tunnelling happens because step() moves the ball and THEN frame() checks for collision.
+  // If step() moves the ball from y=80 to y=130, and the brick is at y=100-120,
+  // then collides(ball, brick) will be false at both times.
+
+  // To test this, we need to simulate a step and a frame.
+  const dt = 0.05; // 50ms
+  state.ball = { x: 125, y: 70, r: 7, vx: 0, vy: 2000 };
+  step(state, dt); // ball.y becomes 70 + 2000 * 0.05 = 170.
+  // Brick is at 100-120. Ball jumped over it.
+  frame(mockCtx, state);
+
+  // If tunnelling is fixed, the brick should be dead.
+  assert.equal(brick.alive, false, 'brick should be hit even if ball jumped over it');
+});
