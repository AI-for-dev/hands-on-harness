diff --git a/game/neon.test.js b/game/neon.test.js
index 250d6a9..8781ff6 100644
--- a/game/neon.test.js
+++ b/game/neon.test.js
@@ -67,3 +67,97 @@ function belowField() {

 // TODO (#5): test comboMultiplier / scoreForBrick.
 // TODO      : test level progression and loadBest/saveBest persistence.
+
+test('step: bounce off top of brick', () => {
+  const state = createState(1);
+  // Ball moving DOWN, positioned just above the top edge of the brick
+  state.ball = { x: 320, y: 75, r: 7, vx: 0, vy: 200 };
+  state.bricks = [{ x: 300, y: 80, w: 40, h: 20, alive: true }];
+
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy < 0, 'Ball should bounce UP after hitting the top of a brick');
+});
+
+test('step: bounce off bottom of brick', () => {
+  const state = createState(1);
+  // Ball moving UP, positioned just below the bottom edge of the brick
+  state.ball = { x: 320, y: 105, r: 7, vx: 0, vy: -200 };
+  state.bricks = [{ x: 300, y: 80, w: 40, h: 20, alive: true }];
+
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy > 0, 'Ball should bounce DOWN after hitting the bottom of a brick');
+});
+
+test('step: bounce off left of brick', () => {
+  const state = createState(1);
+  // Ball moving RIGHT, positioned just to the left of the left edge of the brick
+  state.ball = { x: 290, y: 90, r: 7, vx: 200, vy: 0 };
+  state.bricks = [{ x: 300, y: 80, w: 40, h: 20, alive: true }];
+
+  step(state, 1 / 60);
+  assert.ok(state.ball.vx < 0, 'Ball should bounce LEFT after hitting the left side of a brick');
+});
+
+test('step: bounce off right of brick', () => {
+  const state = createState(1);
+  // Ball moving LEFT, positioned just to the right of the right edge of the brick
+  state.ball = { x: 345, y: 90, r: 7, vx: -200, vy: 0 };
+  state.bricks = [{ x: 300, y: 80, w: 40, h: 20, alive: true }];
+
+  step(state, 1 / 60);
+  assert.ok(state.ball.vx > 0, 'Ball should bounce RIGHT after hitting the right side of a brick');
+});
+
+test('step: corner hit flips both vx and vy', () => {
+  const state = createState(1);
+  // Position the ball exactly such that overlapX == overlapY (2px each)
+  state.ball = { x: 295, y: 75, r: 7, vx: 200, vy: -200 };
+  state.bricks = [{ x: 300, y: 80, w: 40, h: 20, alive: true }];
+
+  step(state, 0);
+  assert.ok(state.ball.vx < 0 && state.ball.vy > 0, 'Ball should flip both vx and vy on corner hit');
+});
+
+test('step: push out to prevent sticky bounce', () => {
+  const state = createState(1);
+  // Ball deep inside the brick
+  state.ball = { x: 320, y: 90, r: 7, vx: 0, vy: -200 };
+  state.bricks = [{ x: 300, y: 80, w: 40, h: 20, alive: true }];
+
+  step(state, 1 / 60);
+  // The ball should be repositioned so it's not overlapping anymore
+  const brick = state.bricks[0];
+  const overlapping = (
+    state.ball.x + state.ball.r > brick.x &&
+    state.ball.x - state.ball.r < brick.x + brick.w &&
+    state.ball.y + state.ball.r > brick.y &&
+    state.ball.y - state.ball.r < brick.y + brick.h
+  );
+  assert.equal(overlapping, false, 'Ball should be pushed out of the brick');
+});
+
+test('step: no double bounce on neighbours', () => {
+  const state = createState(1);
+  // Ball hitting the seam between two bricks
+  state.ball = { x: 300 + 72/2, y: 80, r: 7, vx: 0, vy: -200 };
+  state.bricks = [
+    { x: 300, y: 80, w: 72, h: 20, alive: true },
+    { x: 300 + 72 + 8, y: 80, w: 72, h: 20, alive: true }
+  ];
+
+  step(state, 1 / 60);
+  // vy should be flipped exactly once (positive)
+  assert.ok(state.ball.vy > 0, 'Ball should bounce once even if overlapping multiple bricks');
+});
+
+test('step: tunnelling detection (sweep)', () => {
+  const state = createState(1);
+  // Ball moving very fast, jumping over the brick in one frame
+  // Brick is at y=80, h=20 (bottom at 100)
+  // Ball is at y=110, moves to y=110 - (700 * 0.05) = 75
+  state.ball = { x: 320, y: 110, r: 7, vx: 0, vy: -700 };
+  state.bricks = [{ x: 300, y: 80, w: 40, h: 20, alive: true }];
+
+  step(state, 0.05); // max dt
+  assert.ok(state.ball.vy > 0, 'Ball should not tunnel through bricks at high speed');
+});
