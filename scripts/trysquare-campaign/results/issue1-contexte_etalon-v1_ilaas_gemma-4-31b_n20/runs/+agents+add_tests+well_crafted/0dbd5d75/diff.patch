+// Resolve collisions between the ball and bricks.
+// This handles bounces, scores, and prevents tunnelling using sweep collision detection.
+export function resolveBrickCollisions(state, dt) {
+  const { ball, bricks } = state;
+
+  let timeRemaining = 1.0;
+  let currentX = ball.x - ball.vx * dt;
+  let currentY = ball.y - ball.vy * dt;
+  let currentVX = ball.vx;
+  let currentVY = ball.vy;
+
+  let collisionsThisFrame = 0;
+  while (timeRemaining > 0 && collisionsThisFrame < 4) {
+    let firstBrick = null;
+    let minT = 1.1;
+
+    for (const brick of bricks) {
+      if (!brick.alive) continue;
+
+      const ex = brick.x - ball.r;
+      const ey = brick.y - ball.r;
+      const ew = brick.w + 2 * ball.r;
+      const eh = brick.h + 2 * ball.r;
+
+      const dx = currentVX * dt * timeRemaining;
+      const dy = currentVY * dt * timeRemaining;
+
+      let tmin = -Infinity, tmax = Infinity;
+      if (dx !== 0) {
+        const tx1 = (ex - currentX) / dx;
+        const tx2 = (ex + ew - currentX) / dx;
+        tmin = Math.max(tmin, Math.min(tx1, tx2));
+        tmax = Math.min(tmax, Math.max(tx1, tx2));
+      } else if (currentX < ex || currentX > ex + ew) {
+        tmin = 2;
+      }
+
+      if (dy !== 0) {
+        const ty1 = (ey - currentY) / dy;
+        const ty2 = (ey + eh - currentY) / dy;
+        tmin = Math.max(tmin, Math.min(ty1, ty2));
+        tmax = Math.min(tmax, Math.max(ty1, ty2));
+      } else if (currentY < ey || currentY > ey + eh) {
+        tmin = 2;
+      }
+
+      let t = (tmax >= tmin && tmax >= 0) ? Math.max(0, tmin) : 2;
+      if (t <= 1 && t < minT) {
+        minT = t;
+        firstBrick = brick;
+      }
+    }
+
+    if (!firstBrick) {
+      currentX += currentVX * dt * timeRemaining;
+      currentY += currentVY * dt * timeRemaining;
+      break;
+    }
+
+    const brick = firstBrick;
+    brick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(brick, state.combo);
+
+    currentX += currentVX * dt * timeRemaining * minT;
+    currentY += currentVY * dt * timeRemaining * minT;
+    timeRemaining -= minT;
+
+    const ex = brick.x - ball.r;
+    const ey = brick.y - ball.r;
+    const ew = brick.w + 2 * ball.r;
+    const eh = brick.h + 2 * ball.r;
+    const penX = Math.min(currentX - ex, ex + ew - currentX);
+    const penY = Math.min(currentY - ey, ey + eh - currentY);
+
+    if (Math.abs(penX - penY) < 1e-5) {
+      currentVX *= -1;
+      currentVY *= -1;
+    } else if (penX < penY) {
+      if (currentVX * (currentX - (brick.x + brick.w / 2)) < 0) {
+        currentVX *= -1;
+      }
+    } else {
+      if (currentVY * (currentY - (brick.y + brick.h / 2)) < 0) {
+        currentVY *= -1;
+      }
+    }
+
+    collisionsThisFrame++;
+  }
+
+  ball.x = currentX;
+  ball.y = currentY;
+  ball.vx = currentVX;
+  ball.vy = currentVY;
+}
