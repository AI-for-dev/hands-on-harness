 // TODO (#5): test comboMultiplier / scoreForBrick.
 // TODO      : test level progression and loadBest/saveBest persistence.
+
+test('resolveBrickCollisions: bottom hit flip vy', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 107, r: 7, vx: 0, vy: -300 }; // hits bottom at 100
+  state.bricks = [{ x: 80, y: 80, w: 40, h: 20, alive: true }];
+  resolveBrickCollisions(state, 1 / 60);
+  assert.ok(state.ball.vy > 0, 'vy should flip to DOWN');
+});
+
+test('resolveBrickCollisions: top hit flip vy', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 73, r: 7, vx: 0, vy: 300 }; // hits top at 80
+  state.bricks = [{ x: 80, y: 80, w: 40, h: 20, alive: true }];
+  resolveBrickCollisions(state, 1 / 60);
+  assert.ok(state.ball.vy < 0, 'vy should flip to UP');
+});
+
+test('resolveBrickCollisions: left hit flip vx', () => {
+  const state = createState(1);
+  state.ball = { x: 73, y: 90, r: 7, vx: 300, vy: 0 }; // hits left at 80
+  state.bricks = [{ x: 80, y: 80, w: 40, h: 20, alive: true }];
+  resolveBrickCollisions(state, 1 / 60);
+  assert.ok(state.ball.vx < 0, 'vx should flip to LEFT');
+});
+
+test('resolveBrickCollisions: right hit flip vx', () => {
+  const state = createState(1);
+  state.ball = { x: 127, y: 90, r: 7, vx: -300, vy: 0 }; // hits right at 120
+  state.bricks = [{ x: 80, y: 80, w: 40, h: 20, alive: true }];
+  resolveBrickCollisions(state, 1 / 60);
+  assert.ok(state.ball.vx > 0, 'vx should flip to RIGHT');
+});
+
+test('resolveBrickCollisions: corner hit flip both', () => {
+  const state = createState(1);
+  state.ball = { x: 75, y: 75, r: 7, vx: 300, vy: 300 }; // hits top-left corner
+  state.bricks = [{ x: 80, y: 80, w: 40, h: 20, alive: true }];
+  resolveBrickCollisions(state, 1 / 60);
+  assert.ok(state.ball.vx < 0 && state.ball.vy < 0, 'both vx and vy should flip');
+});
+
+test('resolveBrickCollisions: push-out prevents sticking', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 107, r: 7, vx: 0, vy: -300 };
+  state.bricks = [{ x: 80, y: 80, w: 40, h: 20, alive: true }];
+  resolveBrickCollisions(state, 1 / 60);
+  assert.ok(!collides(state.ball, state.bricks[0]), 'ball should be pushed out of the brick');
+});
+
+test('resolveBrickCollisions: tunnelling detection', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 76, r: 7, vx: 0, vy: -2000 }; // moving fast UP, ends at 76, started at 109.33
+  state.bricks = [{ x: 80, y: 80, w: 40, h: 20, alive: true }];
+  // In one frame (1/60s), ball moves ~33px, jumping over the 20px brick
+  resolveBrickCollisions(state, 1 / 60);
+  assert.ok(state.ball.vy > 0, 'ball should have hit and bounced back despite tunnelling');
+});
