+// Mock Canvas context
+const mockCtx = {
+  fillRect: () => {},
+  arc: () => {},
+  fill: () => {},
+  fillText: () => {},
+  beginPath: () => {},
+};
+
+test('frame: bounce off brick bottom (vy flips to DOWN)', () => {
+  const state = createState(1);
+  // Position ball so it's just entering the bottom of the first brick from below
+  const brick = state.bricks[0];
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y + brick.h + 2, r: 7, vx: 0, vy: UP };
+
+  // Ensure collision is detected
+  assert.ok(collides(state.ball, brick), 'Ball should overlap brick');
+
+  frame(mockCtx, state);
+  assert.equal(Math.sign(state.ball.vy), DOWN, 'vy should flip to DOWN');
+});
+
+test('frame: bounce off brick side (vx flips)', () => {
+  const state = createState(1);
+  // Position ball so it's entering from the left
+  const brick = state.bricks[0];
+  state.ball = { x: brick.x - 5, y: brick.y + brick.h / 2, r: 7, vx: RIGHT, vy: 0 };
+
+  assert.ok(collides(state.ball, brick), 'Ball should overlap brick');
+
+  frame(mockCtx, state);
+  assert.equal(Math.sign(state.ball.vx), LEFT, 'vx should flip to LEFT');
+});
+
+test('frame: corner hit flips both vx and vy', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  // Hit bottom-left corner
+  state.ball = { x: brick.x - 2, y: brick.y + brick.h + 2, r: 7, vx: RIGHT, vy: UP };
+
+  frame(mockCtx, state);
+  assert.equal(Math.sign(state.ball.vx), LEFT, 'vx should flip');
+  assert.equal(Math.sign(state.ball.vy), DOWN, 'vy should flip');
+});
+
+test('frame: push out prevents sticky bounce', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y + brick.h - 2, r: 7, vx: 0, vy: UP };
+
+  frame(mockCtx, state);
+
+  // If we call frame again immediately, it should no longer collide
+  assert.equal(collides(state.ball, brick), false, 'Ball should be pushed out of the brick');
+});
+
+test('frame: neighbours — bounce once even if overlapping two bricks', () => {
+  const state = createState(1);
+  // Position ball at the seam between brick 0 and brick 1
+  const b0 = state.bricks[0];
+  const b1 = state.bricks[1];
+  state.ball = { x: b0.x + 76, y: b0.y + b0.h / 2, r: 7, vx: RIGHT, vy: 0 };
+
+  // Ball overlaps both b0 and b1
+  assert.ok(collides(state.ball, b0));
+  assert.ok(collides(state.ball, b1));
+
+  frame(mockCtx, state);
+
+  // vx should be LEFT, and should NOT have been flipped back to RIGHT by the second brick
+  assert.equal(Math.sign(state.ball.vx), LEFT, 'vx should only flip once');
+});
+
