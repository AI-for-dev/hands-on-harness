--- a/game/neon.js
+++ b/game/neon.js
@@ -165,6 +165,8 @@ export function saveBest(storage, score) {
 export function step(state, dt) {
   const { ball, paddle } = state;

+  ball.prevX = ball.x;
+  ball.prevY = ball.y;
   ball.x += ball.vx * dt;
   ball.y += ball.vy * dt;

@@ -215,25 +217,63 @@ export function frame(ctx, state) {
   ctx.fillStyle = palette.background;
   ctx.fillRect(0, 0, WIDTH, HEIGHT);

-  // Bricks: collision + bounce + score + drawing, all in one place.
+  let bounced = false;
+  let bounceBrick = null;
+
   for (const brick of state.bricks) {
     if (!brick.alive) continue;

-    if (collides(state.ball, brick)) {
+    let collided = collides(state.ball, brick);
+    if (!collided && state.ball.prevX !== undefined) {
+      for (let i = 1; i < 5; i++) {
+        const tx = state.ball.prevX + (state.ball.x - state.ball.prevX) * (i / 5);
+        const ty = state.ball.prevY + (state.ball.y - state.ball.prevY) * (i / 5);
+        if (collides({ x: tx, y: ty, r: state.ball.r }, brick)) {
+          collided = true;
+          break;
+        }
+      }
+    }
+
+    if (collided) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+      if (!bounced) {
+        bounced = true;
+        bounceBrick = brick;
+      }
     }

     ctx.fillStyle = brickColor(brick.row);
     ctx.fillRect(brick.x, brick.y, brick.w, brick.h);
   }

+  if (bounced && bounceBrick) {
+    const ball = state.ball;
+    const b = bounceBrick;
+    const pLeft = (ball.x + ball.r) - b.x;
+    const pRight = (b.x + b.w) - (ball.x - ball.r);
+    const pTop = (ball.y + ball.r) - b.y;
+    const pBottom = (b.y + b.h) - (ball.y - ball.r);
+
+    const minX = Math.min(pLeft, pRight);
+    const minY = Math.min(pTop, pBottom);
+
+    if (minX < minY) {
+      ball.vx *= -1;
+      ball.x += (pLeft < pRight) ? -pLeft : pRight;
+    } else if (minY < minX) {
+      ball.vy *= -1;
+      ball.y += (pTop < pBottom) ? -pTop : pBottom;
+    } else {
+      ball.vx *= -1;
+      ball.vy *= -1;
+      ball.x += (pLeft < pRight) ? -pLeft : pRight;
+      ball.y += (pTop < pBottom) ? -pTop : pBottom;
+    }
+  }
+
   // Paddle — color hard-coded instead of using the palette (inconsistency #6).
   ctx.fillStyle = '#00e5ff';
   ctx.fillRect(state.paddle.x, state.paddle.y, state.paddle.w, state.paddle.h);
