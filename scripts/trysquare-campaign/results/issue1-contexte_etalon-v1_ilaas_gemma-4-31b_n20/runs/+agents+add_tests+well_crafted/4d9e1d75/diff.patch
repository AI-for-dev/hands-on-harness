diff --git a/game/neon.test.js b/game/neon.test.js
index 250d6a9..bdb6911 100644
--- a/game/neon.test.js
+++ b/game/neon.test.js
@@ -65,5 +65,91 @@ function belowField() {
   return 500;
 }

+
+test('step: bounce off brick top face', () => {
+  const state = createState(1);
+  state.bricks = [];
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true };
+  state.bricks.push(brick);
+  state.ball = { x: 125, y: 85, r: 7, vx: 100, vy: 100 }; // Moving down, about to hit top
+  step(state, 0.1); // dt = 0.1, vy*dt = 10, ball.y becomes 95, penetrates top face
+  assert.equal(state.ball.vy, -100, 'vy should flip to UP');
+  assert.equal(state.ball.vx, 100, 'vx should remain unchanged');
+  assert.ok(state.ball.y <= 100 - 7, 'ball should be pushed out of the brick');
+});
+
+test('step: bounce off brick bottom face', () => {
+  const state = createState(1);
+  state.bricks = [];
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true };
+  state.bricks.push(brick);
+  state.ball = { x: 125, y: 135, r: 7, vx: 100, vy: -100 }; // Moving up, about to hit bottom
+  step(state, 0.1); // dt = 0.1, vy*dt = -10, ball.y becomes 125, penetrates bottom face
+  assert.equal(state.ball.vy, 100, 'vy should flip to DOWN');
+  assert.equal(state.ball.vx, 100, 'vx should remain unchanged');
+  assert.ok(state.ball.y >= 120 + 7, 'ball should be pushed out of the brick');
+});
+
+test('step: bounce off brick left face', () => {
+  const state = createState(1);
+  state.bricks = [];
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true };
+  state.bricks.push(brick);
+  state.ball = { x: 85, y: 110, r: 7, vx: 100, vy: 100 }; // Moving right, about to hit left
+  step(state, 0.1); // dt = 0.1, vx*dt = 10, ball.x becomes 95, penetrates left face
+  assert.equal(state.ball.vx, -100, 'vx should flip to LEFT');
+  assert.equal(state.ball.vy, 100, 'vy should remain unchanged');
+  assert.ok(state.ball.x <= 100 - 7, 'ball should be pushed out of the brick');
+});
+
+test('step: bounce off brick right face', () => {
+  const state = createState(1);
+  state.bricks = [];
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true };
+  state.bricks.push(brick);
+  state.ball = { x: 165, y: 110, r: 7, vx: -100, vy: 100 }; // Moving left, about to hit right
+  step(state, 0.1); // dt = 0.1, vx*dt = -10, ball.x becomes 155, penetrates right face
+  assert.equal(state.ball.vx, 100, 'vx should flip to RIGHT');
+  assert.equal(state.ball.vy, 100, 'vy should remain unchanged');
+  assert.ok(state.ball.x >= 150 + 7, 'ball should be pushed out of the brick');
+});
+
+test('step: bounce off brick corner', () => {
+  const state = createState(1);
+  state.bricks = [];
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true };
+  state.bricks.push(brick);
+  state.ball = { x: 93, y: 93, r: 7, vx: 100, vy: 100 }; // Moving down-right, hit top-left corner
+  step(state, 0.1);
+  assert.equal(state.ball.vx, -100, 'vx should flip');
+  assert.equal(state.ball.vy, -100, 'vy should flip');
+});
+
+test('step: prevent tunnelling', () => {
+  const state = createState(1);
+  state.bricks = [];
+  const brick = { x: 100, y: 100, w: 50, h: 20, alive: true };
+  state.bricks.push(brick);
+  // Ball is moving so fast it skips the brick in one frame
+  state.ball = { x: 125, y: 150, r: 7, vx: 0, vy: -1000 };
+  step(state, 0.05); // dy = -50. Ball.y becomes 100.
+  // In one step it went from 150 to 100. Brick is 100-120. It should have hit it.
+  assert.ok(!brick.alive, 'brick should be destroyed even if ball jumped over it');
+  assert.equal(state.ball.vy, 1000, 'ball should have bounced');
+});
+
+test('step: handle neighbours (no double bounce)', () => {
+  const state = createState(1);
+  // Two bricks side by side
+  state.bricks = [
+    { x: 100, y: 100, w: 50, h: 20, alive: true },
+    { x: 150, y: 100, w: 50, h: 20, alive: true },
+  ];
+  state.ball = { x: 150, y: 85, r: 7, vx: 0, vy: 100 }; // Hits the seam exactly
+  step(state, 0.1);
+  // If it bounces twice, vy will be -100 again.
+  assert.equal(state.ball.vy, -100, 'should bounce only once');
+});
