+// Resolve collisions between the ball and all live bricks.
+function resolveBrickCollisions(state) {
+  const { ball } = state;
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+
+    if (collides(ball, brick)) {
+      const penL = (ball.x + ball.r) - brick.x;
+      const penR = (brick.x + brick.w) - (ball.x - ball.r);
+      const penT = (ball.y + ball.r) - brick.y;
+      const penB = (brick.y + brick.h) - (ball.y - ball.r);
+
+      const minPen = Math.min(penL, penR, penT, penB);
+
+      const hitT = penT === minPen;
+      const hitB = penB === minPen;
+      const hitL = penL === minPen;
+      const hitR = penR === minPen;
+
+      if (hitT) ball.vy = -Math.abs(ball.vy);
+      if (hitB) ball.vy = Math.abs(ball.vy);
+      if (hitL) ball.vx = -Math.abs(ball.vx);
+      if (hitR) ball.vx = Math.abs(ball.vx);
+
+      if (hitT) ball.y = brick.y - ball.r;
+      if (hitB) ball.y = brick.y + brick.h + ball.r;
+      if (hitL) ball.x = brick.x - ball.r;
+      if (hitR) ball.x = brick.x + brick.w + ball.r;
+
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+    }
+  }
+}
