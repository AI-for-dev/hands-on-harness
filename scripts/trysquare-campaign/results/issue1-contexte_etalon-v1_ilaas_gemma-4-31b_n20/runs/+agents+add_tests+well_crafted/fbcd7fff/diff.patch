-// TODO (#5): test comboMultiplier / scoreForBrick.
-// TODO      : test level progression and loadBest/saveBest persistence.
+// Helper to create a state with a ball at a specific position/velocity
+function createTestState(x, y, vx, vy, level = 1) {
+  const state = createState(level);
+  state.ball = { x, y, r: 7, vx, vy };
+  return state;
+}
+
+test('step: bounce off brick top face', () => {
+  const state = createTestState(100, 90, 0, 200);
+  state.bricks = [{ x: 80, y: 95, w: 40, h: 20, alive: true }];
+  // At t=0: ball.bottom = 97, brick.top = 95. Overlap = 2.
+  // Smaller penetration should be top face.
+  step(state, 0);
+  assert.ok(state.ball.vy < 0, 'should bounce UP');
+  assert.equal(state.ball.vx, 0, 'vx should remain 0');
+  assert.ok(!collides(state.ball, state.bricks[0]), 'should be pushed out');
+});
+
+test('step: bounce off brick bottom face', () => {
+  const state = createTestState(100, 115, 0, -200);
+  state.bricks = [{ x: 80, y: 95, w: 40, h: 20, alive: true }];
+  // Ball top = 115-7 = 108. Brick bottom = 95+20 = 115.
+  // Penetration = 115 - 108 = 7.
+  step(state, 0);
+  assert.ok(state.ball.vy > 0, 'should bounce DOWN');
+  assert.ok(!collides(state.ball, state.bricks[0]), 'should be pushed out');
+});
+
+test('step: bounce off brick left face', () => {
+  const state = createTestState(85, 100, 200, 0);
+  state.bricks = [{ x: 90, y: 90, w: 40, h: 20, alive: true }];
+  // Ball right = 85+7 = 92. Brick left = 90.
+  // Penetration = 92 - 90 = 2.
+  step(state, 0);
+  assert.ok(state.ball.vx < 0, 'should bounce LEFT');
+  assert.ok(!collides(state.ball, state.bricks[0]), 'should be pushed out');
+});
+
+test('step: bounce off brick right face', () => {
+  const state = createTestState(135, 100, -200, 0);
+  state.bricks = [{ x: 90, y: 90, w: 40, h: 20, alive: true }];
+  // Ball left = 135-7 = 128. Brick right = 90+40 = 130.
+  // Penetration = 130 - 128 = 2.
+  step(state, 0);
+  assert.ok(state.ball.vx > 0, 'should bounce RIGHT');
+  assert.ok(!collides(state.ball, state.bricks[0]), 'should be pushed out');
+});
+
+test('step: bounce off brick corner', () => {
+  const state = createTestState(87, 92, 200, 200);
+  state.bricks = [{ x: 90, y: 95, w: 40, h: 20, alive: true }];
+  // Ball right = 87+7 = 94. Brick left = 90. Pen X = 4.
+  // Ball bottom = 92+7 = 99. Brick top = 95. Pen Y = 4.
+  step(state, 0);
+  assert.ok(state.ball.vx < 0, 'vx should flip');
+  assert.ok(state.ball.vy < 0, 'vy should flip');
+});
+
+test('step: fast ball does not tunnel through brick', () => {
+  const state = createTestState(100, 80, 0, 1000); // Very fast
+  state.bricks = [{ x: 80, y: 95, w: 40, h: 20, alive: true }];
+  // dt = 0.05. movement = 1000 * 0.05 = 50px.
+  // Ball starts at y=80. Moves to y=130.
+  // Brick is from y=95 to y=115.
+  step(state, 0.05);
+  assert.ok(!state.bricks[0].alive, 'brick should be destroyed even if ball tunnels');
+  assert.ok(state.ball.vy < 0, 'should have bounced');
+});
