+/**
+ * Resolves a collision between a ball and a brick.
+ * Handles face detection, bouncing, and pushing the ball out to avoid sticky bounces.
+ * Returns true if a collision occurred.
+ */
+export function resolveBrickCollision(ball, oldX, oldY, brick) {
+  const overlapLeft = (ball.x + ball.r) - brick.x;
+  const overlapRight = (brick.x + brick.w) - (ball.x - ball.r);
+  const overlapTop = (ball.y + ball.r) - brick.y;
+  const overlapBottom = (brick.y + brick.h) - (ball.y - ball.r);
+
+  const hasOverlap = overlapLeft > 0 && overlapRight > 0 && overlapTop > 0 && overlapBottom > 0;
+
+  // Tunnelling check
+  let tunneled = false;
+  if (oldX !== undefined && oldY !== undefined) {
+    const x1 = oldX, y1 = oldY, x2 = ball.x, y2 = ball.y;
+    const rx = brick.x - ball.r, ry = brick.y - ball.r, rw = brick.w + 2 * ball.r, rh = brick.h + 2 * ball.r;
+
+    let tmin = -Infinity, tmax = Infinity;
+    const dx = x2 - x1, dy = y2 - y1;
+
+    if (dx !== 0) {
+      const tx1 = (rx - x1) / dx, tx2 = (rx + rw - x1) / dx;
+      tmin = Math.max(tmin, Math.min(tx1, tx2));
+      tmax = Math.min(tmax, Math.max(tx1, tx2));
+    } else if (x1 < rx || x1 > rx + rw) {
+      tmin = Infinity;
+    }
+
+    if (dy !== 0) {
+      const ty1 = (ry - y1) / dy, ty2 = (ry + rh - y1) / dy;
+      tmin = Math.max(tmin, Math.min(ty1, ty2));
+      tmax = Math.min(tmax, Math.max(ty1, ty2));
+    } else if (y1 < ry || y1 > ry + rh) {
+      tmin = Infinity;
+    }
+
+    if (tmax >= tmin && tmax >= 0 && tmin <= 1) {
+      tunneled = true;
+    }
+  }
+
+  if (!hasOverlap && !tunneled) return false;
+
+  if (hasOverlap) {
+    const penX = Math.min(overlapLeft, overlapRight);
+    const penY = Math.min(overlapTop, overlapBottom);
+
+    if (Math.abs(penX - penY) < 1e-9) {
+      // Corner hit
+      ball.vx = -ball.vx;
+      ball.vy = -ball.vy;
+      if (overlapLeft < overlapRight) ball.x = brick.x - ball.r; else ball.x = brick.x + brick.w + ball.r;
+      if (overlapTop < overlapBottom) ball.y = brick.y - ball.r; else ball.y = brick.y + brick.h + ball.r;
+    } else if (penX < penY) {
+      // Side hit
+      ball.vx = -ball.vx;
+      if (overlapLeft < overlapRight) {
+        ball.x = brick.x - ball.r;
+      } else {
+        ball.x = brick.x + brick.w + ball.r;
+      }
+    } else {
+      // Top/bottom hit
+      ball.vy = -ball.vy;
+      if (overlapTop < overlapBottom) {
+        ball.y = brick.y - ball.r;
+      } else {
+        ball.y = brick.y + brick.h + ball.r;
+      }
+    }
+    return true;
+  }
+
+  if (tunneled) {
+    // For tunnelling, we just flip the primary velocity component
+    if (Math.abs(ball.vx) > Math.abs(ball.vy)) {
+      ball.vx = -ball.vx;
+    } else {
+      ball.vy = -ball.vy;
+    }
+    return true;
+  }
+
+  return false;
+}
