+test('resolveBrickCollision: top hit flip vy and push out', () => {
+// ...
+  const ball = { x: 100, y: 85, r: 7, vx: 0, vy: -100 };
+  const oldX = 100, oldY = 90;
+  const brick = { x: 80, y: 90, w: 40, h: 20 }; // Top edge at 90
+  const hit = resolveBrickCollision(ball, oldX, oldY, brick);
+  assert.ok(hit, 'should detect collision');
+  assert.equal(ball.vy, 100, 'vy should be flipped');
+  assert.ok(ball.y + ball.r <= brick.y, 'ball should be pushed out of the brick');
+});
+
+test('resolveBrickCollision: bottom hit flip vy and push out', () => {
+  const ball = { x: 100, y: 115, r: 7, vx: 0, vy: 100 };
+  const oldX = 100, oldY = 110;
+  const brick = { x: 80, y: 90, w: 40, h: 20 }; // Bottom edge at 110
+  const hit = resolveBrickCollision(ball, oldX, oldY, brick);
+  assert.ok(hit, 'should detect collision');
+  assert.equal(ball.vy, -100, 'vy should be flipped');
+  assert.ok(ball.y - ball.r >= brick.y + brick.h, 'ball should be pushed out of the brick');
+});
+
+test('resolveBrickCollision: left hit flip vx and push out', () => {
+  const ball = { x: 75, y: 100, r: 7, vx: 100, vy: 0 };
+  const oldX = 70, oldY = 100;
+  const brick = { x: 80, y: 90, w: 40, h: 20 }; // Left edge at 80
+  const hit = resolveBrickCollision(ball, oldX, oldY, brick);
+  assert.ok(hit, 'should detect collision');
+  assert.equal(ball.vx, -100, 'vx should be flipped');
+  assert.ok(ball.x + ball.r <= brick.x, 'ball should be pushed out of the brick');
+});
+
+test('resolveBrickCollision: right hit flip vx and push out', () => {
+  const ball = { x: 125, y: 100, r: 7, vx: -100, vy: 0 };
+  const oldX = 130, oldY = 100;
+  const brick = { x: 80, y: 90, w: 40, h: 20 }; // Right edge at 120
+  const hit = resolveBrickCollision(ball, oldX, oldY, brick);
+  assert.ok(hit, 'should detect collision');
+  assert.equal(ball.vx, 100, 'vx should be flipped');
+  assert.ok(ball.x - ball.r >= brick.x + brick.w, 'ball should be pushed out of the brick');
+});
+
+test('resolveBrickCollision: corner hit flip both and push out', () => {
+  // Hitting the top-left corner
+  const ball = { x: 75, y: 85, r: 7, vx: 100, vy: -100 };
+  const oldX = 70, oldY = 90;
+  const brick = { x: 80, y: 90, w: 40, h: 20 };
+  const hit = resolveBrickCollision(ball, oldX, oldY, brick);
+  assert.ok(hit, 'should detect collision');
+  assert.equal(ball.vx, -100, 'vx should be flipped');
+  assert.equal(ball.vy, 100, 'vy should be flipped');
+});
+
+test('resolveBrickCollision: tunnelling detection', () => {
+  // Ball is moving so fast it jumps over the brick
+  const ball = { x: 100, y: 110, r: 7, vx: 0, vy: -1000 }; // New pos:’y’ is 110 (below brick)
+  const oldX = 100, oldY = 60; // Old pos:’y’ is 60 (above brick)
+  // Brick is at y=90, h=20. Ball just jumped from 60 to 110, skipping the brick [90, 110].
+  const brick = { x: 80, y: 90, w: 40, h: 20 };
+  const hit = resolveBrickCollision(ball, oldX, oldY, brick);
+  assert.ok(hit, 'should detect collision even when tunnelling');
+});
