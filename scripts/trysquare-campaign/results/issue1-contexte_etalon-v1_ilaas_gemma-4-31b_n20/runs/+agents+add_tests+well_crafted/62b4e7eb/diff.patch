+test('brick bounce: bottom face hit (ball moving UP)', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 65, r: 7, vx: 0, vy: -100 }; // Bottom of ball is 72, top is 58
+  const brick = { x: 80, y: 48, w: 72, h: 20, alive: true }; // Brick bottom is 68, top is 48
+  state.bricks = [brick];
+  resolveBrickCollisions(state); // Should bounce off bottom face
+  assert.ok(state.ball.vy > 0, 'should bounce DOWN');
+  assert.ok(state.ball.y >= 68 + 7, 'should be pushed out');
+});
+
+test('brick bounce: top face hit (ball moving DOWN)', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 55, r: 7, vx: 0, vy: 100 };
+  const brick = { x: 80, y: 48, w: 72, h: 20, alive: true };
+  state.bricks = [brick];
+  resolveBrickCollisions(state);
+  assert.ok(state.ball.vy < 0, 'should bounce UP');
+  assert.ok(state.ball.y <= 48 - 7, 'should be pushed out');
+});
+
+test('brick bounce: left face hit (ball moving RIGHT)', () => {
+  const state = createState(1);
+  state.ball = { x: 75, y: 60, r: 7, vx: 100, vy: 0 };
