+test('handleBrickCollision: top face hit flips vy', () => {
+  const ball = { x: 100, y: 89, r: 10, vx: 0, vy: 100 };
+  const brick = { x: 90, y: 90, w: 20, h: 20 };
+  // Ball is at 89, radius 10 -> bottom is at 99. Overlaps by 9 px.
+  handleBrickCollision(ball, brick);
+  assert.equal(ball.vy, -100, 'vy should be flipped');
+  assert.equal(ball.y, 80, 'ball should be pushed out to top of brick'); 
+});
+
+test('handleBrickCollision: side face hit flips vx', () => {
+  const ball = { x: 89, y: 100, r: 10, vx: 100, vy: 0 };
+  const brick = { x: 90, y: 90, w: 20, h: 20 };
+  // Ball is at 89, radius 10 -> right edge is at 99. Overlaps by 9 px.
+  handleBrickCollision(ball, brick);
+  assert.equal(ball.vx, -100, 'vx should be flipped');
+});
+
+test('handleBrickCollision: corner hit flips both', () => {
+  const ball = { x: 85, y: 85, r: 10, vx: 100, vy: 100 };
+  const brick = { x: 90, y: 90, w: 20, h: 20 };
+  // Overlap on both axes.
+  handleBrickCollision(ball, brick);
+  assert.equal(ball.vx, -100);
+  assert.equal(ball.vy, -100);
+});
+
+test('handleBrickCollision: push-out prevents stickiness', () => {
