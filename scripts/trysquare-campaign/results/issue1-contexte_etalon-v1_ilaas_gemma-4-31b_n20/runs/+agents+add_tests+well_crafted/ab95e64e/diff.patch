 // --- Collision (tested primitive) ------------------------------------------
 
+// Resolves a collision between the ball and a brick.
+// Returns true if a collision occurred and the ball was deflected.
+export function handleBrickCollision(ball, brick, force = false) {
+  if (!force && !collides(ball, brick)) return false;
+
+  const overlapX = Math.min(ball.x + ball.r, brick.x + brick.w) - Math.max(ball.x - ball.r, brick.x);
+  const overlapY = Math.min(ball.y + ball.r, brick.y + brick.h) - Math.max(ball.y - ball.r, brick.y);
+
+  const hitLeft = ball.x < brick.x + brick.w / 2;
+  const hitTop = ball.y < brick.y + brick.h / 2;
+
+  if (force) {
+    if (Math.abs(ball.vx) > Math.abs(ball.vy)) {
+      ball.vx = ball.vx > 0 ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+      ball.x = ball.vx < 0 ? brick.x + brick.w + ball.r : brick.x - ball.r;
+    } else {
+      ball.vy = ball.vy > 0 ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+      ball.y = ball.vy < 0 ? brick.y + brick.h + ball.r : brick.y - ball.r;
+    }
+  } else if (overlapX < overlapY) {
+    ball.vx = hitLeft ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+    ball.x = hitLeft ? brick.x - ball.r : brick.x + brick.w + ball.r;
+  } else if (overlapY < overlapX) {
+    ball.vy = hitTop ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+    ball.y = hitTop ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  } else {
+    ball.vx = hitLeft ? -Math.abs(ball.vx) : Math.abs(ball.vx);
+    ball.vy = hitTop ? -Math.abs(ball.vy) : Math.abs(ball.vy);
+    ball.x = hitLeft ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    ball.y = hitTop ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  }
+  return true;
+}
