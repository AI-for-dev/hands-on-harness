+test('resolveBrickCollision: bottom hit flips vy and pushes out', () => {
+  const ball = { x: 100, y: 88, r: 7, vx: 0, vy: DOWN };
+  const brick = { x: 80, y: 90, w: 40, h: 20 };
+  // Ball top edge at 81, bottom at 95. Brick top edge at 90.
+  resolveBrickCollision(ball, brick);
