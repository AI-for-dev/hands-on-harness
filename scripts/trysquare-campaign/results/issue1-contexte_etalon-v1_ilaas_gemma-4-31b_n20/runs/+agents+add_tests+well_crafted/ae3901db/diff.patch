+test('resolveBrickCollision: top hit flips vy and pushes out', () => {
+  const ball = { x: 100, y: 100, r: 7, vx: 0, vy: UP };
+  const brick = { x: 80, y: 90, w: 40, h: 20 };
+  // Ball is overlapping the bottom of the brick (ball.y + r = 107, brick.y = 90... wait)
+  // If ball is at 100, r=7, then bottom is 107. Brick is at 90, h=20, bottom is 110.
+  // So ball is inside the brick.
+  // We want a top hit: ball hits the bottom edge of the brick.
+  // Brick: y=90, h=20. Bottom edge is y=110.
+  // Ball: y=112, r=7. Top edge is y=105. Overlap is 5px.
+  const ballTop = { x: 100, y: 112, r: 7, vx: 0, vy: UP };
+  resolveBrickCollision(ballTop, brick);
+  assert.equal(ballTop.vy, DOWN);
+  assert.ok(ballTop.y >= 110 + 7, 'ball should be pushed below the brick');
+});
