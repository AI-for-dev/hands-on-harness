+// Resolves the collision between the ball and a brick.
+// Handles bounce direction (per-face), push-out, and avoids double-bounces.
+export function resolveBrickCollision(ball, brick) {
+  const dx = ball.x - (brick.x + brick.w / 2);
+  const dy = ball.y - (brick.y + brick.h / 2);
+  const overlapX = brick.w / 2 + ball.r - Math.abs(dx);
+  const overlapY = brick.h / 2 + ball.r - Math.abs(dy);
+
+  if (overlapX < overlapY) {
+    // Side hit
+    if ((dx < 0 && ball.vx > 0) || (dx > 0 && ball.vx < 0)) {
+      ball.vx = -Math.sign(ball.vx) * Math.abs(ball.vx);
+    }
+    ball.x = dx > 0 ? brick.x + brick.w + ball.r : brick.x - ball.r;
+  } else if (overlapY < overlapX) {
+    // Top/Bottom hit
+    if ((dy < 0 && ball.vy > 0) || (dy > 0 && ball.vy < 0)) {
+      ball.vy = -Math.sign(ball.vy) * Math.abs(ball.vy);
+    }
+    ball.y = dy > 0 ? brick.y + brick.h + ball.r : brick.y - ball.r;
+  } else {
+    // Corner hit: flip both if moving towards the corner
+    if ((dx < 0 && ball.vx > 0) || (dx > 0 && ball.vx < 0)) {
+      ball.vx = -Math.sign(ball.vx) * Math.abs(ball.vx);
+    }
+    if ((dy < 0 && ball.vy > 0) || (dy > 0 && ball.vy < 0)) {
+      ball.vy = -Math.sign(ball.vy) * Math.abs(ball.vy);
+    }
+    ball.x = dx > 0 ? brick.x + brick.w + ball.r : brick.x - ball.r;
+    ball.y = dy > 0 ? brick.y + brick.h + ball.r : brick.y - ball.r;
+  }
+}
