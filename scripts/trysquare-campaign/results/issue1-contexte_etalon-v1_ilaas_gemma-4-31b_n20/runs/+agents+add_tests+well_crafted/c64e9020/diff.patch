diff --git a/game/neon.test.js b/game/neon.test.js
index 250d6a9..cb626c4 100644
--- a/game/neon.test.js
+++ b/game/neon.test.js
@@ -65,5 +65,63 @@ function belowField() {
   return 500;
 }
 
-// TODO (#5): test comboMultiplier / scoreForBrick.
-// TODO      : test level progression and loadBest/saveBest persistence.
+test('step: bounce off the top of a brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0]; // top-left brick
+  state.ball = { x: brick.x + brick.w / 2, y: brick.y - 2, r: 7, vx: 0, vy: -100 };
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy > 0, 'velocity should flip to DOWN');
+  assert.equal(state.ball.y, brick.y - 7, 'ball should be pushed out above the brick');
+});
+
+test('step: bounce off the bottom of a brick', () => {
+  const state = createState(1);
+  const customBrick = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  state.bricks = [customBrick];
+  state.ball = { x: 136, y: 122, r: 7, vx: 0, vy: -100 }; // moving UP into the bottom of the brick
+  step(state, 1 / 60);
+  assert.ok(state.ball.vy > 0, 'velocity should flip to DOWN');
+});
+
+test('step: bounce off the side of a brick', () => {
+  const state = createState(1);
+  const customBrick = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  state.bricks = [customBrick];
+  state.ball = { x: 95, y: 110, r: 7, vx: 100, vy: 0 }; // moving RIGHT into the brick
+  step(state, 1 / 60);
+  assert.ok(state.ball.vx < 0, 'velocity should flip to LEFT');
+});
+
+test('step: corner hit flips both velocities', () => {
+  const state = createState(1);
+  const customBrick = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  state.bricks = [customBrick];
+  // Position ball at the corner
+  state.ball = { x: 95, y: 95, r: 7, vx: 100, vy: 100 }; 
+  step(state, 1 / 60);
+  assert.ok(state.ball.vx < 0 && state.ball.vy < 0, 'both velocities should flip');
+});
+
+test('step: tunnelling prevention (fast ball)', () => {
+  const state = createState(1);
+  const customBrick = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  state.bricks = [customBrick];
+  // Ball is moving very fast, jumps over the brick in one step
+  state.ball = { x: 50, y: 110, r: 7, vx: 10000, vy: 0 }; 
+  step(state, 1 / 60); // dt = 0.016, dx = 166px, so it jumps from 50 to 216, skipping the brick at 100-172.
+  assert.equal(customBrick.alive, false, 'brick should be destroyed even if ball tunnels through');
+  assert.ok(state.ball.vx < 0, 'ball should still bounce');
+});
+
+test('step: neighbour overlap bounces only once', () => {
+  const state = createState(1);
+  // Two bricks side by side with no gap (gap = 0 for this test)
+  const b1 = { x: 100, y: 100, w: 72, h: 20, alive: true };
+  const b2 = { x: 172, y: 100, w: 72, h: 20, alive: true };
+  state.bricks = [b1, b2];
+  // Ball hits exactly at the seam
+  state.ball = { x: 172, y: 110, r: 7, vx: 100, vy: 0 };
+  step(state, 1 / 60);
+  // If it bounces twice, vx will be positive again.
+  assert.ok(state.ball.vx < 0, 'ball should only bounce once despite hitting two bricks');
+});
