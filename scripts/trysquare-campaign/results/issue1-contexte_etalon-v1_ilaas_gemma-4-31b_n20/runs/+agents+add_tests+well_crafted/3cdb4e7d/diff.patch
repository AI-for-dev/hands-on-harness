+function resolveBrickCollision(ball, brick) {
+  const pxL = (ball.x + ball.r) - brick.x;
+  const pxR = (brick.x + brick.w) - (ball.x - ball.r);
+  const pyT = (ball.y + ball.r) - brick.y;
+  const pyB = (brick.y + brick.h) - (ball.y - ball.r);
+
+  const minX = Math.min(pxL, pxR);
+  const minY = Math.min(pyT, pyB);
+
+  if (minX < minY) {
+    if (pxL < pxR) {
+      ball.vx = -Math.abs(ball.vx);
+      ball.x = brick.x - ball.r;
+    } else {
+      ball.vx = Math.abs(ball.vx);
+      ball.x = brick.x + brick.w + ball.r;
+    }
+  } else if (minY < minX) {
+    if (pyT < pyB) {
+      ball.vy = -Math.abs(ball.vy);
+      ball.y = brick.y - ball.r;
+    } else {
+      ball.vy = Math.abs(ball.vy);
+      ball.y = brick.y + brick.h + ball.r;
+    }
+  } else {
+    ball.vx = ball.vx < 0 ? Math.abs(ball.vx) : -Math.abs(ball.vx);
+    ball.vy = ball.vy < 0 ? Math.abs(ball.vy) : -Math.abs(ball.vy);
+    if (pxL < pxR) ball.x = brick.x - ball.r; else ball.x = brick.x + brick.w + ball.r;
+    if (pyT < pyB) ball.y = brick.y - ball.r; else ball.y = brick.y + brick.h + ball.r;
+  }
+  return true;
+}
