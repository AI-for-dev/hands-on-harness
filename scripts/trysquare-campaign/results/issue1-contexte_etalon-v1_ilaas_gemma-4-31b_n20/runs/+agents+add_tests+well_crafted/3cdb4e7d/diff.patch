+    if (collides(ball, brick)) {
+      const pxL = (ball.x + ball.r) - brick.x;
+      const pxR = (brick.x + brick.w) - (ball.x - ball.r);
+      const pyT = (ball.y + ball.r) - brick.y;
+      const pyB = (brick.y + brick.h) - (ball.y - ball.r);
+      const pen = Math.min(pxL, pxR, pyT, pyB);
+      if (pen < minPen) {
+        minPen = pen;
+        bestBrick = brick;
+      }
+    }
+  }
+
+  if (bestBrick) {
+    resolveBrickCollision(ball, bestBrick);
+    bestBrick.alive = false;
+    state.combo += 1;
+    state.score += scoreForBrick(bestBrick, state.combo);
+    return true;
+  }
+  return false;
+}
