diff --git a/game/neon.js b/game/neon.js
index 6b4a133..778773b 100644
--- a/game/neon.js
+++ b/game/neon.js
@@ -223,11 +223,29 @@ export function frame(ctx, state) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      // Fix (#1): Deflect the ball based on the hit face.
+      const ball = state.ball;
+      const bLeft = brick.x;
+      const bRight = brick.x + brick.w;
+      const bTop = brick.y;
+      const bBottom = brick.y + brick.h;
+
+      // Find the closest edge to the ball's center to determine the bounce axis.
+      const dxLeft = Math.abs(ball.x - bLeft);
+      const dxRight = Math.abs(ball.x - bRight);
+      const dyTop = Math.abs(ball.y - bTop);
+      const dyBottom = Math.abs(ball.y - bBottom);
+
+      const min = Math.min(dxLeft, dxRight, dyTop, dyBottom);
+
+      if (min === dyTop || min === dyBottom) {
+        ball.vy = -ball.vy;
+        ball.y += ball.vy * (1 / 60); // Small nudge to prevent sticking
+      } else {
+        ball.vx = -ball.vx;
+        ball.x += ball.vx * (1 / 60); // Small nudge to prevent sticking
+      }
     }
 
     ctx.fillStyle = brickColor(brick.row);
