diff --git a/game/neon.js b/game/neon.js
index 6b4a133..900bb24 100644
--- a/game/neon.js
+++ b/game/neon.js
@@ -223,11 +223,30 @@ export function frame(ctx, state) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      // Calculate overlap on each axis to determine which side was hit
+      const ballCenterX = state.ball.x;
+      const ballCenterY = state.ball.y;
+      const brickCenterX = brick.x + brick.w / 2;
+      const brickCenterY = brick.y + brick.h / 2;
+
+      const dx = ballCenterX - brickCenterX;
+      const dy = ballCenterY - brickCenterY;
+      const combinedHalfW = (brick.w / 2) + state.ball.r;
+      const combinedHalfH = (brick.h / 2) + state.ball.r;
+
+      const overlapX = combinedHalfW - Math.abs(dx);
+      const overlapY = combinedHalfH - Math.abs(dy);
+
+      if (overlapX < overlapY) {
+        // Side hit
+        state.ball.vx = -Math.sign(dx) * Math.abs(state.ball.vx);
+        state.ball.x += Math.sign(dx) * overlapX;
+      } else {
+        // Top/Bottom hit
+        state.ball.vy = -Math.sign(dy) * Math.abs(state.ball.vy);
+        state.ball.y += Math.sign(dy) * overlapY;
+      }
     }
 
     ctx.fillStyle = brickColor(brick.row);
