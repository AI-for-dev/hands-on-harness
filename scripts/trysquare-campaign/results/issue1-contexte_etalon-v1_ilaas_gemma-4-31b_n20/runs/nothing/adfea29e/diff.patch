diff --git a/game/neon.js b/game/neon.js
index 6b4a133..9460851 100644
--- a/game/neon.js
+++ b/game/neon.js
@@ -223,11 +223,30 @@ export function frame(ctx, state) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      // Resolve collision by determining which side was hit
+      const ballCenterX = state.ball.x;
+      const ballCenterY = state.ball.y;
+      const brickCenterX = brick.x + brick.w / 2;
+      const brickCenterY = brick.y + brick.h / 2;
+
+      const dx = Math.abs(ballCenterX - brickCenterX);
+      const dy = Math.abs(ballCenterY - brickCenterY);
+
+      // The side with the smaller penetration determines the bounce axis
+      // Using the overlap distance to decide whether to flip vx or vy
+      const overlapX = (brick.w / 2 + state.ball.r) - dx;
+      const overlapY = (brick.h / 2 + state.ball.r) - dy;
+
+      if (overlapX < overlapY) {
+        state.ball.vx = -Math.sign(state.ball.vx) * Math.abs(state.ball.vx);
+        // Push ball out of brick
+        state.ball.x = brickCenterX + Math.sign(ballCenterX - brickCenterX) * (brick.w / 2 + state.ball.r);
+      } else {
+        state.ball.vy = -Math.sign(state.ball.vy) * Math.abs(state.ball.vy);
+        // Push ball out of brick
+        state.ball.y = brickCenterY + Math.sign(ballCenterY - brickCenterY) * (brick.h / 2 + state.ball.r);
+      }
     }
 
     ctx.fillStyle = brickColor(brick.row);
