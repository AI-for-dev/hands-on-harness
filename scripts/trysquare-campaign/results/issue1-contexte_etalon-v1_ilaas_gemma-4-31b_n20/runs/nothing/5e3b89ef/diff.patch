diff --git a/game/neon.js b/game/neon.js
index 6b4a133..44d365b 100644
--- a/game/neon.js
+++ b/game/neon.js
@@ -223,11 +223,30 @@ export function frame(ctx, state) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      // Determine which side was hit by calculating the distance from the ball's center
+      // to the nearest edge of the brick.
+      const dx = state.ball.x - (brick.x + brick.w / 2);
+      const dy = state.ball.y - (brick.y + brick.h / 2);
+      const nx = dx / (brick.w / 2); // Normalized x distance from center (-1 to 1)
+      const ny = dy / (brick.h / 2); // Normalized y distance from center (-1 to 1)
+
+      // The side with the smaller absolute "over-penetration" is usually the hitting face.
+      // Since it's a circle vs rectangle, we check which axis has the smaller overlap.
+      const overlapX = (brick.w / 2 + state.ball.r) - Math.abs(dx);
+      const overlapY = (brick.h / 2 + state.ball.r) - Math.abs(dy);
+
+      if (overlapX < overlapY) {
+        // Hit from the side
+        state.ball.vx *= -1;
+        // Snap ball to the edge to prevent getting stuck inside the brick
+        state.ball.x = dx > 0 ? brick.x + brick.w + state.ball.r : brick.x - state.ball.r;
+      } else {
+        // Hit from top or bottom
+        state.ball.vy *= -1;
+        // Snap ball to the edge
+        state.ball.y = dy > 0 ? brick.y + brick.h + state.ball.r : brick.y - state.ball.r;
+      }
     }

     ctx.fillStyle = brickColor(brick.row);
