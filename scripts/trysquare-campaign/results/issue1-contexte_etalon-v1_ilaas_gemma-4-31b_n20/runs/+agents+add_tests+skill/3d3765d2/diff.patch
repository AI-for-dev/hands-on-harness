+export function sweptCollides(ball, brick) {
+  if (collides(ball, brick)) return true;
+  if (ball.prevX === undefined || (ball.prevX === ball.x && ball.prevY === ball.y)) return false;
+
+  const minX = Math.min(ball.prevX, ball.x) - ball.r;
+  const maxX = Math.max(ball.prevX, ball.x) + ball.r;
+  const minY = Math.min(ball.prevY, ball.y) - ball.r;
+  const maxY = Math.max(ball.prevY, ball.y) + ball.r;
+
+  if (maxX < brick.x || minX > brick.x + brick.w || maxY < brick.y || minY > brick.y + brick.h) {
+    return false;
+  }
+
+  const prevX_in = ball.prevX + ball.r > brick.x && ball.prevX - ball.r < brick.x + brick.w;
+  const nextX_in = ball.x + ball.r > brick.x && ball.x - ball.r < brick.x + brick.w;
+  if (prevX_in && nextX_in) return true;
+
+  const prevY_in = ball.prevY + ball.r > brick.y && ball.prevY - ball.r < brick.y + brick.h;
+  const nextY_in = ball.y + ball.r > brick.y && ball.y - ball.r < brick.y + brick.h;
+  if (prevY_in && nextY_in) return true;
+
+  return true; // If we are in the swept box and not purely axial, assume intersection.
+}
+
+export function resolveCollision(state, brick) {
+  const { ball } = state;
+  const overlapX = Math.min(
+    ball.x + ball.r - brick.x,
+    brick.x + brick.w - (ball.x - ball.r)
+  );
+  const overlapY = Math.min(
+    ball.y + ball.r - brick.y,
+    brick.y + brick.h - (ball.y - ball.r)
+  );
+
+  if (Math.abs(overlapX - overlapY) < 0.1) {
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    const pushX = ball.x < brick.x + brick.w / 2 ? -overlapX : overlapX;
+    const pushY = ball.y < brick.y + brick.h / 2 ? -overlapY : overlapY;
+    ball.x += pushX;
+    ball.y += pushY;
+    return;
+  }
+
+  if (overlapX < overlapY) {
+    ball.vx = -ball.vx;
+    const pushX = ball.x < brick.x + brick.w / 2 ? -overlapX : overlapX;
+    ball.x += pushX;
+  } else {
+    ball.vy = -ball.vy;
+    const pushY = ball.y < brick.y + brick.h / 2 ? -overlapY : overlapY;
+    ball.y += pushY;
+  }
+}
