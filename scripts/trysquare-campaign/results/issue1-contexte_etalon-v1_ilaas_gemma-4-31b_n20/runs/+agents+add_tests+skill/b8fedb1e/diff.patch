+import { test } from 'node:test';
+import assert from 'node:assert';
+import { createState, frame, step } from '../game/neon.js';
+
+test('Ball should bounce off the top of a brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  brick.x = 100;
+  brick.y = 100;
+  brick.w = 50;
+  brick.h = 20;
+  brick.alive = true;
+
+  state.ball.x = 125;
+  state.ball.y = 95; // ball.y + r = 102, already overlapping
+  state.ball.r = 7;
+  state.ball.vx = 0;
+  state.ball.vy = 100; // Moving down
+
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    beginPath: () => {},
+    fillText: () => {},
+  };
+
+  frame(ctx, state);
+
+  assert.strictEqual(state.ball.vy, -100, 'Balle doit rebondir vers le haut');
+});
+
+test('Ball should bounce off the left side of a brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  brick.x = 100;
+  brick.y = 100;
+  brick.w = 50;
+  brick.h = 20;
+  brick.alive = true;
+
+  state.ball.x = 95; // ball.x + r = 102, already overlapping
+  state.ball.y = 110;
+  state.ball.r = 7;
+  state.ball.vx = 100; // Moving right
+  state.ball.vy = 0;
+
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    beginPath: () => {},
+    fillText: () => {},
+  };
+
+  frame(ctx, state);
+
+  assert.strictEqual(state.ball.vx, -100, 'Balle doit rebondir vers la gauche');
+});
+
+test('Ball should not tunnel through a brick at high speed', () => {
+  const state = createState(10); // Speed = 1070
+  const brick = state.bricks[0];
+  brick.x = 100;
+  brick.y = 100;
+  brick.w = 50;
+  brick.h = 20;
+  brick.alive = true;
+
+  state.ball.x = 125;
+  state.ball.y = 80; // Above the brick
+  state.ball.r = 7;
+  state.ball.vx = 0;
+  state.ball.vy = 1070;
+
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    beginPath: () => {},
+    fillText: () => {},
+  };
+
+  // Simulate one frame: step then frame
+  step(state, 0.05); // Ball moves 1070 * 0.05 = 53.5 px -> y = 133.5
+  frame(ctx, state);
+
+  assert.strictEqual(brick.alive, false, 'Brique doit être détruite même en cas de tunneling');
+  assert.ok(state.ball.vy < 0, 'Balle doit avoir rebondi');
+});
