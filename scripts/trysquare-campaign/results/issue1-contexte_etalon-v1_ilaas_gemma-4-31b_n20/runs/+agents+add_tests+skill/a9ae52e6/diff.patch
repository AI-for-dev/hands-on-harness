+import { createState, frame, collides } from '../game/neon.js';
+import assert from 'node:assert';
+import { test } from 'node:test';
+
+test('D1: Ball should bounce off brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0]; // Row 0, Col 0
+  
+  // Position ball so it's about to hit the top of the brick
+  // Brick 0: y = BRICK_TOP = 48, h = 20. Top is 48, bottom is 68.
+  // Ball: r = 7. To hit top, ball.y + 7 should be > 48 and ball.y - 7 should be < 68.
+  // Let's place it at y = 40, vy = 200 (DOWN).
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = 48 - 8; // y = 40. y + r = 47. Not yet colliding.
+  state.ball.vx = 0;
+  state.ball.vy = 200;
+
+  // Mock canvas context
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    beginPath: () => {},
+    fillText: () => {},
+  };
+
+  // Simulate one frame where collision happens
+  // In the real game, step() happens then frame().
+  // Let's manually move the ball into the brick.
+  state.ball.y = 45; // 45 + 7 = 52 > 48. Collision!
+  
+  frame(ctx, state);
+  
+  assert.strictEqual(state.ball.vy, -200, 'Ball vy should be inverted after hitting the top of a brick');
+});
