+import { createState, frame } from '../game/neon.js';
+import assert from 'node:assert';
+import { test } from 'node:test';
+
+test('D3: Ball should not double-invert at brick seams', () => {
+  const state = createState(1);
+  const brick1 = state.bricks[0];
+  const brick2 = state.bricks[1]; // Next brick in the same row
+  
+  // Position ball so it overlaps both bricks
+  // Brick 0: x = offsetX, w = 72.
+  // Brick 1: x = offsetX + 72 + 8.
+  // Ball: r = 7.
+  // Center ball at the gap: x = (brick0.x + brick0.w + brick1.x) / 2
+  state.ball.x = (brick1.x + (brick1.x - brick1.w)) / 2; // Wait,’s wrong.
+  // Let's just put it exactly on the boundary.
+  state.ball.x = brick1.x - 2; // Overlaps brick 0 and brick 1
+  state.ball.y = brick1.y + 10; // In the middle of bricks
+  state.ball.vx = 0;
+  state.ball.vy = 200;
+
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    beginPath: () => {},
+    fillText: () => {},
+  };
+
+  frame(ctx, state);
+  
+  // If it hit two bricks and flipped vy twice, it will be 200.
+  // It should be -200.
+  assert.strictEqual(state.ball.vy, -200, 'Ball should only bounce once per frame per axis even if multiple bricks are hit');
+});
