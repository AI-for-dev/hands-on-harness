+import { createState, frame } from '../game/neon.js';
+import assert from 'node:assert';
+import { test } from 'node:test';
+
+test('D2: Ball should not get stuck inside brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0]; 
+  
+  // Position ball so it's overlapping the top
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 2; // r = 7, so it penetrates 5 pixels
+  state.ball.vx = 0;
+  state.ball.vy = 200;
+
+  const ctx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    beginPath: () => {},
+    fillText: () => {},
+  };
+
+  // First frame: collision and bounce
+  frame(ctx, state);
+  
+  // After first frame, it should have bounced (vy = -200)
+  assert.strictEqual(state.ball.vy, -200);
+  
+  // Now, imagine the next frame. In the real game, step() happens.
+  // If we didn't reposition, and step() is small, ball.y might still be inside the brick.
+  // The current implementation of step() doesn't handle bricks.
+  // Let's see if frame() would flip it back.
+  
+  // We simulate the ball still being in the brick
+  state.ball.y = brick.y - 2; 
+  frame(ctx, state);
+  
+  // If it's still colliding, it will flip vy back to 200!
+  assert.strictEqual(state.ball.vy, -200, 'Ball should not flip vy back if it is still overlapping after the first bounce');
+});
