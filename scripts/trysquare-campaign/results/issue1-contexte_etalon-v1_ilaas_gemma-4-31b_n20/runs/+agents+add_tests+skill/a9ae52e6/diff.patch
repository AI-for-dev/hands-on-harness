+  const brick = state.bricks[0]; 
+  
+  // Brick 0: x = offsetX, y = 48, w = 72, h = 20.
+  // Ball: r = 7.
+  // To hit left side, ball.x + 7 > brick.x and ball.x - 7 < brick.x + 72.
+  // Let's place ball to the left: x = brick.x - 5. x + 7 = brick.x + 2. Collision!
+  // Set y to be in the middle of the brick: y = 48 + 10 = 58.
+  state.ball.x = brick.x - 5;
