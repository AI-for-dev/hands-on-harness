+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createState, frame, BRICK_H, BRICK_W, BALL_R } from '../game/neon.js';
+
+const mockCtx = {
+  fillRect: () => {},
+  arc: () => {},
+  fill: () => {},
+  fillText: () => {},
+  beginPath: () => {},
+};
+
+test('D2: Sticking - Ball should be repositioned after collision', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  // Ball is deep inside the brick
+  state.ball = {
+    x: brick.x + brick.w / 2,
+    y: brick.y + 2, 
+    r: BALL_R,
+    vx: 0,
+    vy: 200,
+  };
+
+  frame(mockCtx, state);
+
+  // It should be pushed out of the brick. 
+  // Since it hit the top (vy > 0), it should be at y = brick.y - BALL_R
+  assert.ok(state.ball.y - BALL_R <= brick.y, 'Ball should be repositioned to be outside the brick');
+});
+
+test('D3: Tunneling - Ball should not pass through brick at high speed', () => {
+  const state = createState(10); // High speed
+  const brick = state.bricks[0];
+  
+  // Ball is above the brick, moving fast enough to skip it in one frame
+  // ballSpeed(10) = 1070. dt = 0.05. step = 53.5.
+  state.ball = {
+    x: brick.x + brick.w / 2,
+    y: brick.y - 10, 
+    r: BALL_R,
+    vx: 0,
+    vy: 1070,
+  };
+
+  // In the current implementation, frame() is called AFTER step().
+  // But the "tunneling" happens in step(). 
+  // Actually, the bug is that we use discrete collision in frame().
+  
+  // Simulate one step of movement
+  const dt = 0.05;
+  state.ball.y += state.ball.vy * dt; // y becomes brick.y - 10 + 53.5 = brick.y + 43.5
+  // The ball has now passed the brick (h=20).
+  
+  frame(mockCtx, state);
+  
+  // If it tunneled, the brick is still alive.
+  assert.equal(brick.alive, false, 'Brick should be destroyed even if ball tunneled through it');
+});
+
+test('D4: Double Inversion - Ball should not pass through seam of two bricks', () => {
+  const state = createState(1);
+  const brick1 = state.bricks[0];
+  const brick2 = state.bricks[1];
+  
+  // Position ball so it overlaps both bricks on the same axis
+  state.ball = {
+    x: brick1.x + brick1.w - 2, // Overlapping right edge of brick 1 and left edge of brick 2
+    y: brick1.y + brick1.h / 2,
+    r: BALL_R,
+    vx: 200,
+    vy: 0,
+  };
+
+  frame(mockCtx, state);
+  
+  // If it flips vx twice, vx will be 200 again.
+  assert.equal(state.ball.vx, -200, 'Ball should have vx inverted exactly once');
+});
+
+test('Face vs Coin: Corner hit should flip both axes', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  
+  // Ball hits the top-left corner
+  state.ball = {
+    x: brick.x + 2,
+    y: brick.y + 2,
+    r: BALL_R,
+    vx: -100,
+    vy: -100,
+  };
+
+  frame(mockCtx, state);
+
+  assert.equal(state.ball.vx, 100, 'vx should flip');
+  assert.equal(state.ball.vy, 100, 'vy should flip');
+});
