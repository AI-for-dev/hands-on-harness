+// Resolves collision between the ball and all active bricks.
+// This implements a precise circle-vs-AABB resolution to avoid tunneling,
+// sticking, and ghost collisions.
+export function handleBrickCollisions(state) {
+  const { ball } = state;
+
+  for (const brick of state.bricks) {
+    if (!brick.alive) continue;
+
+    // 1. Find the closest point on the brick to the ball center
+    const closestX = Math.max(brick.x, Math.min(ball.x, brick.x + brick.w));
+    const closestY = Math.max(brick.y, Math.min(ball.y, brick.y + brick.h));
+
+    const dx = ball.x - closestX;
+    const dy = ball.y - closestY;
+    const distanceSq = dx * dx + dy * dy;
+
+    if (distanceSq < ball.r * ball.r) {
+      console.log(`Collision! brick: ${brick.row}, distSq: ${distanceSq}, nx: ${nx}, ny: ${ny}, dot: ${dot}`);
+      const distance = Math.sqrt(distanceSq);
+      
+      // Normal vector from closest point to ball center
+      const nx = distance === 0 ? 0 : dx / distance;
+      const ny = distance === 0 ? -1 : dy / distance;
+
+      // 2. Reposition ball to the surface of the brick (resolves sticking)
+      const overlap = ball.r - distance;
+      ball.x += nx * overlap;
+      ball.y += ny * overlap;
+
+      // 3. Reflect velocity along the normal (resolves face vs corner)
+      const dot = ball.vx * nx + ball.vy * ny;
+      if (dot < 0) {
+        ball.vx -= 2 * dot * nx;
+        ball.vy -= 2 * dot * ny;
+      }
+
+      // 4. Handle game logic
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+      
+      // After a brick is broken, we stop checking others for this sub-step
+      // to avoid the "double inversion" on seams.
+      break; 
+    }
+  }
+}
