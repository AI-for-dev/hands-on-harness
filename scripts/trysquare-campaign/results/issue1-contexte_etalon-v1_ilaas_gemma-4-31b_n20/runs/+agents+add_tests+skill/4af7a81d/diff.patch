+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, frame } from '../game/neon.js';
+
+test('D4: Ball should not suffer from ghost collision at brick seams', (t) => {
+  const state = createState(1);
+  const brick1 = state.bricks[0];
+  const brick2 = state.bricks[1];
+  
+  // Position ball so it overlaps both bricks (on the seam)
+  state.ball.x = brick1.x + brick1.w - 1; // 1px before end of brick 1
+  state.ball.y = brick1.y + 5; 
+  state.ball.vy = -100;
+  
+  const ctx = {
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+  };
+
+  frame(ctx, state);
+  
+  // If it hit both and flipped twice, vy is still -100.
+  // If it worked, vy should be 100 (or at least different from -100).
+  assert.strictEqual(state.ball.vy, 100, 'Ball should have bounced once, not twice');
+});
