+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, step, frame } from '../game/neon.js';
+
+test('D3: Ball should not vibrate in brick (sticky collision)', (t) => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+  
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + 2; 
+  state.ball.vy = -100; 
+  state.ball.vx = 0;
+
+  const ctx = {
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+  };
+
+  // Frame 1: Collision detected, vy flipped to +100.
+  frame(ctx, state);
+  
+  // Frame 2: Ball moves slightly, but might still be in the brick.
+  step(state, 0.001);
+  
+  // If it's still colliding, it'll flip again.
+  frame(ctx, state);
+  
+  // It should NOT have flipped back to -100.
+  assert.strictEqual(state.ball.vy, 100, 'Ball should keep moving away from brick');
+});
