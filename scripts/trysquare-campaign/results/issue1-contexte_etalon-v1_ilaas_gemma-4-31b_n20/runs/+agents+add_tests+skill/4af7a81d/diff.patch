@@ -0,0 +1,31 @@
+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, step, frame, WIDTH, HEIGHT } from '../game/neon.js';
+
+test('D2: Ball should not tunnel through brick at high speed', (t) => {
+  const state = createState(10); // Very high level
+  const brick = state.bricks[0];
+  
+  // Position ball so it's just above the brick, moving DOWN
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y - 10; 
+  state.ball.vy = 1000; // Very fast
+  state.ball.vx = 0;
+
+  const ctx = {
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+  };
+
+  // In one step, the ball should move 1000 * 0.05 = 50 pixels.
+  // Brick height is 20. It will definitely jump over it.
+  step(state, 0.05);
+  frame(ctx, state);
+
+  // If it tunneled, it's now below the brick and still moving DOWN
+  const tunneled = state.ball.y > brick.y + brick.h && state.ball.vy > 0;
+  assert.strictEqual(tunneled, false, 'Ball should not tunnel through brick');
+});
