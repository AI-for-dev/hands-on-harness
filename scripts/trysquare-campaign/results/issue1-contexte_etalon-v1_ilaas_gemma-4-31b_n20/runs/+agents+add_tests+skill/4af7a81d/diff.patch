+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, step, frame, collides, WIDTH, HEIGHT } from '../game/neon.js';
+
+test('D1: Ball should bounce off a brick', (t) => {
+  const state = createState(1);
+  // Position ball so it's about to hit a brick from below (moving UP)
+  // Brick 0 is at (offsetX, BRICK_TOP)
+  const brick = state.bricks[0];
+  state.ball.x = brick.x + brick.w / 2;
+  state.ball.y = brick.y + brick.h + 2; // Just below the brick
+  state.ball.vx = 0;
+  state.ball.vy = -100; // Moving UP
+
+  // We need to simulate the frame loop because collision is in frame()
+  // Mocking ctx
+  const ctx = {
+    fillRect: () => {},
+    beginPath: () => {},
+    arc: () => {},
+    fill: () => {},
+    fillText: () => {},
+  };
+
+  // Step moves the ball
+  step(state, 0.01); // Move slightly up
+  // Now ball.y should be around brick.y + brick.h + 2 - 1 = brick.y + brick.h + 1
+  // Wait, let's make sure it's actually colliding.
+  state.ball.y = brick.y + brick.h - 2; // Inside the brick's bottom area
+  
+  const vyBefore = state.ball.vy;
+  frame(ctx, state);
+  
+  assert.strictEqual(state.ball.vy * vyBefore, -1, 'Ball should have reversed direction');
+});
