+// Resolves a collision between a ball and a brick.
+// Returns true if a collision occurred.
+export function resolveBrickCollision(ball, brick) {
+  if (!collides(ball, brick)) return false;
+
+  const overlapX = Math.min(ball.x + ball.r - brick.x, brick.x + brick.w - (ball.x - ball.r));
+  const overlapY = Math.min(ball.y + ball.r - brick.y, brick.y + brick.h - (ball.y - ball.r));
+
+  if (overlapX < overlapY) {
+    ball.vx = -ball.vx;
+    ball.x += (ball.vx > 0 ? overlapX : -overlapX);
+  } else if (overlapX > overlapY) {
+    ball.vy = -ball.vy;
+    ball.y += (ball.vy > 0 ? overlapY : -overlapY);
+  } else {
+    // Corner: both flip
+    ball.vx = -ball.vx;
+    ball.vy = -ball.vy;
+    ball.x += (ball.vx > 0 ? overlapX : -overlapX);
+    ball.y += (ball.vy > 0 ? overlapY : -overlapY);
+  }
+  return true;
+}
