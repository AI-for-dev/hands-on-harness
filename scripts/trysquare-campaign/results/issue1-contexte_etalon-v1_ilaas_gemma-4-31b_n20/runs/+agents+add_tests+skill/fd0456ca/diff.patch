+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createState, step, collides, BALL_R, BRICK_H } from './neon.js';
+
+const mockCtx = {
+  fillRect: () => {},
+  fillText: () => {},
+  beginPath: () => {},
+  arc: () => {},
+  fill: () => {},
+};
+
+test('D1: Ball should bounce off the top of a brick', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 54, r: BALL_R, vx: 0, vy: 100 };
+  state.bricks = [{ x: 80, y: 60, w: 72, h: BRICK_H, alive: true }];
+
+  step(state, 0);
+
+  assert.ok(state.ball.vy < 0, 'Ball should have bounced upward');
+});
+
+test('D2: Ball should not stick to the brick (re-collision on next frame)', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 65, r: BALL_R, vx: 0, vy: 100 };
+  state.bricks = [{ x: 80, y: 60, w: 72, h: BRICK_H, alive: true }];
+
+  step(state, 0);
+  const vyAfterFirstHit = state.ball.vy;
+  assert.ok(vyAfterFirstHit < 0, 'First bounce failed');
+
+  step(state, 0);
+  assert.ok(state.ball.vy < 0, 'Ball should not have re-inverted its velocity (stuck)');
+});
+
+test('D4: Ball should bounce off the side of a brick', () => {
+  const state = createState(1);
+  state.ball = { x: 75, y: 65, r: BALL_R, vx: 100, vy: 0 };
+  state.bricks = [{ x: 80, y: 60, w: 72, h: BRICK_H, alive: true }];
+
+  step(state, 0);
+
+  assert.ok(state.ball.vx < 0, 'Ball should have bounced leftward');
+});
+
+test('D3: Ball should not double-invert when hitting two bricks at once', () => {
+  const state = createState(1);
+  state.ball = { x: 100, y: 54, r: BALL_R, vx: 0, vy: 100 };
+
+  state.bricks = [
+    { x: 80, y: 60, w: 72, h: BRICK_H, alive: true },
+    { x: 80, y: 60, w: 72, h: BRICK_H, alive: true },
+  ];
+
+  step(state, 0);
+
+  assert.ok(state.ball.vy < 0, 'Ball should have bounced upward once');
+});
