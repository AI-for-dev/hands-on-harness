diff --git a/game/neon.js b/game/neon.js
index 6b4a133..48d7f21 100644
--- a/game/neon.js
+++ b/game/neon.js
@@ -223,11 +223,29 @@ export function frame(ctx, state) {
       brick.alive = false;
       state.combo += 1;
       state.score += scoreForBrick(brick, state.combo);
-      // BUG (#1): the ball is NOT deflected here. Only the walls and the paddle
-      // bounce (in step()); bricks were never given a bounce. So the ball plows
-      // straight through a column head-on AND straight through the side of a
-      // row. Fix = a real per-face bounce (flip vy on a top/bottom hit, vx on a
-      // side hit) plus pushing the ball back out of the brick.
+
+      // Resolve collision: find the smallest overlap to determine the hit face
+      const overlapX = Math.min(state.ball.x + state.ball.r - brick.x, brick.x + brick.w - (state.ball.x - state.ball.r));
+      const overlapY = Math.min(state.ball.y + state.ball.r - brick.y, brick.y + brick.h - (state.ball.y - state.ball.r));
+
+      const isCorner = Math.abs(overlapX - overlapY) < 1;
+
+      if (isCorner) {
+        state.ball.vx *= -1;
+        state.ball.vy *= -1;
+        if (overlapX < overlapY) {
+          state.ball.x = state.ball.x + state.ball.r < brick.x + brick.w / 2 ? brick.x - state.ball.r : brick.x + brick.w + state.ball.r;
+        } else {
+          state.ball.y = state.ball.y + state.ball.r < brick.y + brick.h / 2 ? brick.y - state.ball.r : brick.y + brick.h + state.ball.r;
+        }
+      } else if (overlapX < overlapY) {
+        state.ball.vx *= -1;
+        state.ball.x = state.ball.x + state.ball.r < brick.x + brick.w / 2 ? brick.x - state.ball.r : brick.x + brick.w + state.ball.r;
+      } else {
+        state.ball.vy *= -1;
+        state.ball.y = state.ball.y + state.ball.r < brick.y + brick.h / 2 ? brick.y - state.ball.r : brick.y + brick.h + state.ball.r;
+      }
+      break;
     }

     ctx.fillStyle = brickColor(brick.row);
