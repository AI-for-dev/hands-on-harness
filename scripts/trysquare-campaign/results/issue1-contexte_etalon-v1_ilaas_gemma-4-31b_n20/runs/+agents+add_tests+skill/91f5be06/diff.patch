+function resolveBrickCollision(ball, brick) {
+  // 1. Tunneling check
+  const jumpedOver = (ball.prevY - ball.r <= brick.y && ball.y + ball.r >= brick.y + brick.h) ||
+                    (ball.prevY + ball.r >= brick.y + brick.h && ball.y - ball.r <= brick.y);
+  const xOverlap = ball.x + ball.r > brick.x && ball.x - ball.r < brick.x + brick.w;
+
+  if (jumpedOver && xOverlap) {
+    if (ball.vy < 0) { // Jumped from bottom to top
+      ball.vy = -ball.vy;
+      ball.y = brick.y + brick.h + ball.r;
+    } else if (ball.vy > 0) { // Jumped from top to bottom
+      ball.vy = -ball.vy;
+      ball.y = brick.y - ball.r;
+    }
+    return true;
+  }
+
+  if (!collides(ball, brick)) return false;
+
+  // 2. Discrete resolution
+  const overlapX = Math.min(ball.x + ball.r - brick.x, brick.x + brick.w - (ball.x - ball.r));
+  const overlapY = Math.min(ball.y + ball.r - brick.y, brick.y + brick.h - (ball.y - ball.r));
+
+  if (overlapX < overlapY) {
+    // X-axis hit: only flip if moving towards the brick
+    if ((ball.vx > 0 && ball.x + ball.r > brick.x && ball.x - ball.r < brick.x) ||
+        (ball.vx < 0 && ball.x - ball.r < brick.x + brick.w && ball.x + ball.r > brick.x + brick.w)) {
+        ball.vx = -ball.vx;
+        ball.x = ball.x < brick.x + brick.w / 2 ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    }
+  } else if (overlapY < overlapX) {
+    // Y-axis hit: only flip if moving towards the brick
+    if ((ball.vy > 0 && ball.y + ball.r > brick.y && ball.y - ball.r < brick.y) ||
+        (ball.vy < 0 && ball.y - ball.r < brick.y + brick.h && ball.y + ball.r > brick.y + brick.h)) {
+        ball.vy = -ball.vy;
+        ball.y = ball.y < brick.y + brick.h / 2 ? brick.y - ball.r : brick.y + brick.h + ball.r;
+    }
+  } else {
+    // Corner hit: flip both, but only if moving towards the brick
+    const vxTowards = (ball.vx > 0 && ball.x + ball.r > brick.x && ball.x - ball.r < brick.x) ||
+                       (ball.vx < 0 && ball.x - ball.r < brick.x + brick.w && ball.x + ball.r > brick.x + brick.w);
+    const vyTowards = (ball.vy > 0 && ball.y + ball.r > brick.y && ball.y - ball.r < brick.y) ||
+                       (ball.vy < 0 && ball.y - ball.r < brick.y + brick.h && ball.y + ball.r > brick.y + brick.h);
+    if (vxTowards) ball.vx = -ball.vx;
+    if (vyTowards) ball.vy = -ball.vy;
+    ball.x = ball.x < brick.x + brick.w / 2 ? brick.x - ball.r : brick.x + brick.w + ball.r;
+    ball.y = ball.y < brick.y + brick.h / 2 ? brick.y - ball.r : brick.y + brick.h + ball.r;
+  }
+  return true;
+}
