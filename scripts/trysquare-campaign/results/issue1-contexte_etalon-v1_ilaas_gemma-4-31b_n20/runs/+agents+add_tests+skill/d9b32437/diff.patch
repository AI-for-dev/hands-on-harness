+
+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, frame } from '../game/neon.js';
+
+test('D1: Ball should bounce off brick', () => {
+  const state = createState(1);
+  // Position ball to collide with first brick (0, 0)
+  // BRICK_TOP = 48, BRICK_H = 20, BALL_R = 7
+  // First brick: x=offsetX, y=48, w=72, h=20
+  // Ball: y=48, vy= -260 (UP)
+  state.ball.x = state.bricks[0].x + 10;
+  state.ball.y = 48;
+  state.ball.vy = -260;
+
+  const mockCtx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    beginPath: () => {},
+    fillText: () => {},
+  };
+
+  frame(mockCtx, state);
+
+  assert.strictEqual(state.ball.vy > 0, true, 'Ball should be moving DOWN after bounce');
+});
