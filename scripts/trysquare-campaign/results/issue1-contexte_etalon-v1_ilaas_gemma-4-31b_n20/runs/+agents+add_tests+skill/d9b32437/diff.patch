+  const brick8 = state.bricks[8];
+
+  // Position ball between row 0 and row 1
+  state.ball.x = brick0.x + brick0.w / 2;
+  state.ball.y = 72; // Mid-gap
+  state.ball.vy = -260; // Moving UP
+
+  const mockCtx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    beginPath: () => {},
+    fillText: () => {},
+  };
+
+  frame(mockCtx, state);
+
+  assert.strictEqual(state.ball.vy > 0, true, 'Ball should have bounced ONCE, not twice');
+});
