+
+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, frame, step, ballSpeed } from '../game/neon.js';
+
+test('D2: Ball should not tunnel through brick at high speed', () => {
+  const state = createState(10); // High speed level
+  state.ball.x = state.bricks[0].x + 10;
+  // Position ball just below the brick
+  state.ball.y = state.bricks[0].y + state.bricks[0].h + state.ball.r + 1;
+  state.ball.vy = -ballSpeed(10); // Moving UP fast
+
+  const mockCtx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    beginPath: () => {},
+    fillText: () => {},
+  };
+
+  // Simulate one frame
+  const dt = 0.05;
+  step(state, dt);
+  frame(mockCtx, state);
+
+  assert.strictEqual(state.ball.vy > 0, true, 'Ball should have bounced despite high speed');
+});
