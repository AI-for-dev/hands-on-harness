+
+import test from 'node:test';
+import assert from 'node:assert';
+import { createState, frame } from '../game/neon.js';
+
+test('D3: Ball should not stick to brick', () => {
+  const state = createState(1);
+  const brick = state.bricks[0];
+
+  // Position ball deeply inside the brick
+  state.ball.x = brick.x + 10;
+  state.ball.y = brick.y + 10;
+  state.ball.vy = -260;
+
+  const mockCtx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    beginPath: () => {},
+    fillText: () => {},
+  };
+
+  frame(mockCtx, state);
+
+  console.log('Ball pos after frame:', { x: state.ball.x, y: state.ball.y, r: state.ball.r });
+  console.log('Brick pos:', { x: brick.x, y: brick.y, w: brick.w, h: brick.h });
+
+  // After frame, the ball should be pushed out of the brick
+  const collides = (ball, brick) => (
+    ball.x + ball.r > brick.x &&
+    ball.x - ball.r < brick.x + brick.w &&
+    ball.y + ball.r > brick.y &&
+    ball.y - ball.r < brick.y + brick.h
+  );
+
+  assert.strictEqual(collides(state.ball, brick), false, 'Ball should be pushed out of the brick');
+});
