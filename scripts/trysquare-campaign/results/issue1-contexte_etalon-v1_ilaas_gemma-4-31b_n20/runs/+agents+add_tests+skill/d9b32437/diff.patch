+  state.ball.y = brick.y + brick.h - 2;
+  state.ball.vx = -260;
+  state.ball.vy = -260;
+
+  const mockCtx = {
+    fillRect: () => {},
+    arc: () => {},
+    fill: () => {},
+    beginPath: () => {},
+    fillText: () => {},
+  };
+
+  frame(mockCtx, state);
+
+  assert.strictEqual(state.ball.vx > 0, true, 'Ball vx should have flipped');
+  assert.strictEqual(state.ball.vy > 0, true, 'Ball vy should have flipped');
+});
diff --git a/.scratch/to_fix.md b/.scratch/to_fix.md
