+// Collision response: reflects the ball and pushes it out of the brick.
+function resolveBrickCollision(state, brick) {
+  const { ball } = state;
+  const overlapX = Math.min(ball.x + ball.r - brick.x, brick.x + brick.w - (ball.x - ball.r));
+  const overlapY = Math.min(ball.y + ball.r - brick.y, brick.y + brick.h - (ball.y - ball.r));
+
+  brick.alive = false;
+  state.combo += 1;
+  state.score += scoreForBrick(brick, state.combo);
+
+  if (Math.abs(overlapX - overlapY) < 0.1) {
+    ball.vx *= -1;
+    ball.vy *= -1;
+    ball.x += ball.vx > 0 ? overlapX : -overlapX;
+    ball.y += ball.vy > 0 ? overlapY : -overlapY;
+  } else if (overlapX < overlapY) {
+    ball.vx *= -1;
+    ball.x += ball.vx > 0 ? overlapX : -overlapX;
+  } else {
+    ball.vy *= -1;
+    ball.y += ball.vy > 0 ? overlapY : -overlapY;
+  }
+}
