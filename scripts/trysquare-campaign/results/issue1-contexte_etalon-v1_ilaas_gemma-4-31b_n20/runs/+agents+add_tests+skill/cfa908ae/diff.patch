+// Resolves collisions between the ball and the bricks.
+export function resolveBrickCollisions(state) {
+  const { ball, bricks } = state;
+
+  for (const brick of bricks) {
+    if (!brick.alive) continue;
+
+    // Discrete collision check
+    let hit = collides(ball, brick);
+
+    // Tunneling check: if ball moved too far, check if it passed through the brick.
+    if (!hit && ball.oldX !== undefined && ball.oldY !== undefined) {
+      const minX = Math.min(ball.oldX, ball.x) - ball.r;
+      const maxX = Math.max(ball.oldX, ball.x) + ball.r;
+      const minY = Math.min(ball.oldY, ball.y) - ball.r;
+      const maxY = Math.max(ball.oldY, ball.y) + ball.r;
+
+      if (maxX > brick.x && minX < brick.x + brick.w && maxY > brick.y && minY < brick.y + brick.h) {
+        hit = true;
+      }
+    }
+
+    if (hit) {
+      brick.alive = false;
+      state.combo += 1;
+      state.score += scoreForBrick(brick, state.combo);
+
+      const overlapX = Math.min(ball.x + ball.r, brick.x + brick.w) - Math.max(ball.x - ball.r, brick.x);
+      const overlapY = Math.min(ball.y + ball.r, brick.y + brick.h) - Math.max(ball.y - ball.r, brick.y);
+
+      if (overlapX < overlapY) {
+        const hitLeft = ball.vx > 0;
+        ball.vx = -ball.vx;
+        ball.x = hitLeft ? brick.x - ball.r : brick.x + brick.w + ball.r;
+      } else if (overlapY < overlapX) {
+        const hitTop = ball.vy > 0;
+        ball.vy = -ball.vy;
+        ball.y = hitTop ? brick.y - ball.r : brick.y + brick.h + ball.r;
+      } else {
+        const hitLeft = ball.vx > 0;
+        const hitTop = ball.vy > 0;
+        ball.vx = -ball.vx;
+        ball.vy = -ball.vy;
+        ball.x = hitLeft ? brick.x - ball.r : brick.x + brick.w + ball.r;
+        ball.y = hitTop ? brick.y - ball.r : brick.y + brick.h + ball.r;
+      }
+      break;
+    }
+  }
+}
