+// Pure resolution of the ball against the brick grid: returns the live bricks
+// the ball currently overlaps, without touching the state. Extracted from
+// frame() (#2) so the logic is testable without a canvas.
+export function brickHit(ball, bricks) {
+  const hits = [];
+  for (const brick of bricks) {
+    if (brick.alive && collides(ball, brick)) hits.push(brick);
+  }
+  return hits;
+}
