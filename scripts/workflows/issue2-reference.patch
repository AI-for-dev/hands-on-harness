+test('brickHit: returns exactly the live bricks the ball overlaps', () => {
+  const bricks = makeBricks(1);
+  const target = bricks[0];
+  const ball = { x: target.x + target.w / 2, y: target.y + target.h / 2, r: 7 };
+  const hits = brickHit(ball, bricks);
+  assert.deepEqual(hits, [target]);
+});
+
+test('brickHit: a dead brick is never hit, and the state is untouched', () => {
+  const bricks = makeBricks(1);
+  const target = bricks[0];
+  target.alive = false;
+  const ball = { x: target.x + target.w / 2, y: target.y + target.h / 2, r: 7 };
+  assert.deepEqual(brickHit(ball, bricks), []);
+  assert.equal(target.alive, false, 'brickHit must not resurrect or kill bricks');
+});
+
+test('frame: every live brick the ball overlaps dies in the same frame', () => {
+  // Characterization: this is what frame() does before the extraction, and the
+  // move must not change it. A ball sitting in the gap overlaps both bricks.
+  const ctx = { fillStyle: '', font: '', fillRect() {}, beginPath() {}, arc() {}, fill() {}, fillText() {} };
+  const state = createState(1);
+  const [a, b] = state.bricks;
+  state.ball = { x: a.x + a.w + BRICK_GAP / 2, y: a.y + a.h / 2, r: 7, vx: 0, vy: 0 };
+  frame(ctx, state);
+  assert.equal(a.alive, false);
+  assert.equal(b.alive, false);
+  assert.equal(state.combo, 2, 'one combo increment per brick, as before the extraction');
+});
